	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
    ЖурналДокументовВходящиеДокументы.Ссылка КАК Ссылка,
    ЖурналДокументовВходящиеДокументы.Дата КАК Дата,
    ЖурналДокументовВходящиеДокументы.ПометкаУдаления КАК ПометкаУдаления,
    ЖурналДокументовВходящиеДокументы.Номер КАК Номер,
    ЖурналДокументовВходящиеДокументы.Проведен КАК Проведен,
    ЖурналДокументовВходящиеДокументы.ПредставлениеНомера КАК ПредставлениеНомера,
    ВЫБОР
        КОГДА ТИПЗНАЧЕНИЯ(ЖурналДокументовВходящиеДокументы.Ссылка) = ТИП(Документ.ЗапросКоммерческогоПредложенияОтКлиента)
            ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.ЗапросКоммерческогоПредложенияОтКлиента)
        КОГДА ТИПЗНАЧЕНИЯ(ЖурналДокументовВходящиеДокументы.Ссылка) = ТИП(Документ.КоммерческоеПредложениеПоставщика)
            ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.КоммерческоеПредложениеПоставщика)
        ИНАЧЕ ЖурналДокументовВходящиеДокументы.ВидДокумента
    КОНЕЦ КАК ВидДокумента,
    ЖурналДокументовВходящиеДокументы.ВидОперации КАК ВидОперации,
    ЖурналДокументовВходящиеДокументы.Контрагент КАК Контрагент,
    ЖурналДокументовВходящиеДокументы.Организация КАК Организация,
    ЖурналДокументовВходящиеДокументы.Сумма КАК Сумма,
    СостоянияЭД.СостояниеЭДО КАК СостояниеЭДО,
    СостоянияЭД.ПредставлениеСостояния КАК ПредставлениеСостояния,
    ВЫБОР
        КОГДА ДокументыСОшибкамиПроверкиКонтрагентов.Документ ЕСТЬ NULL
            ТОГДА ЛОЖЬ
        ИНАЧЕ ИСТИНА
    КОНЕЦ КАК СодержитНекорректныхКонтрагентов,
    ВЫБОР
        КОГДА ТИПЗНАЧЕНИЯ(ЖурналДокументовВходящиеДокументы.Ссылка) = ТИП(Документ.ЗапросКоммерческогоПредложенияОтКлиента)
            ТОГДА ИСТИНА
        ИНАЧЕ ЛОЖЬ
    КОНЕЦ КАК ЭтоЗапросКоммерческихПредложений
ИЗ
    ЖурналДокументов.ВходящиеДокументы КАК ЖурналДокументовВходящиеДокументы
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияЭД
        ПО (СостоянияЭД.СсылкаНаОбъект = ЖурналДокументовВходящиеДокументы.Ссылка)
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыСОшибкамиПроверкиКонтрагентов КАК ДокументыСОшибкамиПроверкиКонтрагентов
        ПО ЖурналДокументовВходящиеДокументы.Ссылка = ДокументыСОшибкамиПроверкиКонтрагентов.Документ
            И (&amp;ИспользованиеПроверкиВозможно)</QueryText>
				<MainTable>DocumentJournal.ВходящиеДокументы</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
