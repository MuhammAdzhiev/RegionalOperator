#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКопировании(ОбъектКопирования)
	
	Если Не ЭтоГруппа Тогда
		НаборСвойств = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства
	Если Не ЭтоГруппа Тогда
		ИменаПредопределенныхНаборов = УправлениеСвойствамиКЭДО.ИменаПредопределенныхНаборов();
		УправлениеСвойствами.ПередЗаписьюВидаОбъекта(ЭтотОбъект, ИменаПредопределенныхНаборов.Справочник_Номенклатура);
		УправлениеСвойствами.ПередЗаписьюВидаОбъекта(ЭтотОбъект,
			ИменаПредопределенныхНаборов.Справочник_ХарактеристикиНоменклатуры, "НаборСвойствХарактеристик");
	КонецЕсли;	
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьЗначениеОпцииИспользоватьХарактеристикиНоменклатуры();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЗначениеОпцииИспользоватьХарактеристикиНоменклатуры()
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры")
		И ХарактеристикиИспользуются() Тогда
		УстановитьПривилегированныйРежим(Истина);
		Константы.ИспользоватьХарактеристикиНоменклатуры.Установить(Истина);
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры
Функция ХарактеристикиИспользуются()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВидыНоменклатуры.ИспользоватьХарактеристики КАК ИспользоватьХарактеристики
		|ИЗ
		|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|ГДЕ
		|	ВидыНоменклатуры.ИспользоватьХарактеристики";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции // ХарактеристикиИспользуются()

#КонецОбласти

#КонецЕсли
