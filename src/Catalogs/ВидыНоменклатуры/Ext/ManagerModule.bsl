// Создает виды номенклатуры Товар, Услуга, Работа, Право.
Процедура СоздатьЭлементыПоУмолчанию() Экспорт
	
	ВидНоменклатуры = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
	ВидНоменклатуры.Наименование = НСтр("ru = 'Товар'");
	ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
	ВидНоменклатуры.Записать();
	
	ВидНоменклатуры = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
	ВидНоменклатуры.Наименование = НСтр("ru = 'Услуга'");
	ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга;
	ВидНоменклатуры.Записать();
	
	ВидНоменклатуры = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
	ВидНоменклатуры.Наименование = НСтр("ru = 'Работа'");
	ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа;
	ВидНоменклатуры.Записать();
	
	ВидНоменклатуры = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
	ВидНоменклатуры.Наименование = НСтр("ru = 'Право'");
	ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Право;
	ВидНоменклатуры.Записать();
	
КонецПроцедуры

// Возвращает список реквизитов, которые запрещается редактировать
// с помощью обработки группового изменения объектов.
//
// Возвращаемое значение:
//  Массив - список имен реквизитов объекта.
//
Функция РеквизитыНеРедактируемыеВГрупповойОбработке() Экспорт
	
	НеРедактируемыеРеквизиты = Новый Массив;
	НеРедактируемыеРеквизиты.Добавить("НаборСвойств");
	
	Возврат НеРедактируемыеРеквизиты;
	
КонецФункции

// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов

// См. ЗапретРедактированияРеквизитовОбъектовПереопределяемый.ПриОпределенииОбъектовСЗаблокированнымиРеквизитами.
Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	
	Результат.Добавить("ТипНоменклатуры");
	Результат.Добавить("Характеристики");
	Результат.Добавить("СтавкаНДС");
	
	Возврат Результат;
	
КонецФункции

