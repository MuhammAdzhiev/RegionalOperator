
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	Если НЕ Объект.ИспользоватьХарактеристики Тогда 
		 Характеристики = 0;
	Иначе 
		 Если Объект.ИндивидуальныеХарактеристикиНоменклатуры Тогда 
			 Характеристики = 1;
		 Иначе 
			 Характеристики = 2;
		 КонецЕсли;
	КонецЕсли;
	
	Элементы.СписокХарактеристик.Доступность= Объект.ИспользоватьХарактеристики И НЕ Объект.ИндивидуальныеХарактеристикиНоменклатуры;
	
	ПриСозданииЧтенииНаСервере();
	
	ЗаполнитьСпискиДопРеквизитовСведений();
	
	// ЭлектронноеВзаимодействие.РаботаСНоменклатурой
	РаботаСНоменклатурой.ПриСозданииНаСервереФормаВидаНоменклатуры(ЭтотОбъект, Объект.Ссылка, Элементы.ГруппаРаботаСНоменклатурой);
	// Конец ЭлектронноеВзаимодействие.РаботаСНоменклатурой
	
	// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов	
		
	Элементы.Характеристики.ТолькоПросмотр = ТолькоПросмотр;
	
	Элементы.ТоварнаяГруппа.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьСервисРаботаСНоменклатурой");
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаписатьДопРеквизитыСведенияНабора(Отказ, ТекущийОбъект, "ДопРеквизит", "Номенклатура");
	ЗаписатьДопРеквизитыСведенияНабора(Отказ, ТекущийОбъект, "ДопРеквизит", "ХарактеристикиНоменклатуры");
	ЗаписатьДопРеквизитыСведенияНабора(Отказ, ТекущийОбъект, "ДопСведение", "Номенклатура");
	ЗаписатьДопРеквизитыСведенияНабора(Отказ, ТекущийОбъект, "ДопСведение", "ХарактеристикиНоменклатуры");

	// ЭлектронноеВзаимодействие.РаботаСНоменклатурой
	РаботаСНоменклатурой.ПриЗаписиНаСервереФормаВидаНоменклатуры(ЭтотОбъект, ТекущийОбъект, Отказ);
	// Конец ЭлектронноеВзаимодействие.РаботаСНоменклатурой
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ПараметрыЗаписи.Вставить("ИспользоватьХарактеристикиНоменклатурыПередЗаписью", 
		ИспользоватьХарактеристикиНоменклатуры);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
		
	ИспользоватьХарактеристикиНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	ПараметрыЗаписи.Вставить("ИспользоватьХарактеристикиНоменклатурыПослеЗаписи", ИспользоватьХарактеристикиНоменклатуры);
	
	Прочитать();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Перем ИспользоватьХарактеристикиНоменклатурыПередЗаписью, ИспользоватьХарактеристикиНоменклатурыПослеЗаписи;
	
	Если ПараметрыЗаписи.Свойство("ИспользоватьХарактеристикиНоменклатурыПередЗаписью", ИспользоватьХарактеристикиНоменклатурыПередЗаписью)
		И ПараметрыЗаписи.Свойство("ИспользоватьХарактеристикиНоменклатурыПослеЗаписи", ИспользоватьХарактеристикиНоменклатурыПослеЗаписи) Тогда
		
		Если ИспользоватьХарактеристикиНоменклатурыПередЗаписью <> ИспользоватьХарактеристикиНоменклатурыПослеЗаписи Тогда
			ОбновитьИнтерфейс();
			ОбновитьВидимостьХарактеристик(ЭтотОбъект);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
		
	ПриСозданииЧтенииНаСервере();
	
	ЗаполнитьСпискиДопРеквизитовСведений();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_НаборКонстант" И Источник = "ИспользоватьДополнительныеРеквизитыИСведения" Тогда
		ПриСозданииЧтенииНаСервере();
	КонецЕсли;
	
	// ЭлектронноеВзаимодействие.РаботаСНоменклатурой
	Если ИмяСобытия = РаботаСНоменклатуройКлиент.ОписаниеОповещенийПодсистемы().ЗагрузкаКатегорий Тогда
		Если Не Модифицированность Тогда
			ПерезаполнитьИдентификаторыКатегорий();
		КонецЕсли;
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.РаботаСНоменклатурой	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ХарактеристикиПриИзменении(Элемент)
	
	Если Характеристики = 0 Тогда 
		Объект.ИспользоватьХарактеристики = Ложь;
	Иначе
		
		Объект.ИспользоватьХарактеристики = Истина;
		Объект.ИндивидуальныеХарактеристикиНоменклатуры = Характеристики = 1;
		
	КонецЕсли;
	
	ОбновитьВидимостьХарактеристик(ЭтотОбъект);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокХарактеристикНажатие(Элемент)
	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("Отбор", Новый Структура("Владелец", Объект.Ссылка));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗакрытияФормыХарактеристик", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.ХарактеристикиНоменклатуры.ФормаСписка",
		ПараметрыОткрытия,
		ЭтотОбъект.УникальныйИдентификатор,
		,,,ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаДопРеквизитовНоменклатуры

