#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КодНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НастройкиРежима = ОблачныеКлассификаторыКлиент.ПараметрыВызоваФормыОКПД2();
	НастройкиРежима.АльтернативныйСпособПодбора = 
		Новый ОписаниеОповещения("ОткрытьВводЗначения", ЭтотОбъект);
	НастройкиРежима.ОбработчикЗавершения = 
		Новый ОписаниеОповещения("КодОКПД2НачалоВыбораЗавершение", ЭтотОбъект);
	НастройкиРежима.КодВыбранногоЭлемента = СокрЛП(Объект.Код);
	НастройкиРежима.ЗагружатьСИерархией = Истина;
	НастройкиРежима.РежимВыбораЭлемента = Истина;
	
	ОблачныеКлассификаторыКлиент.ПодобратьИзСервисаЭлементыОКПД2(НастройкиРежима);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте 
Процедура ОткрытьВводЗначения(Результат, ДополнительныеПараметры) Экспорт

	ПродолжениеВыбора = Новый ОписаниеОповещения("КодОКПД2НачалоВыбораЗавершение", ЭтотОбъект);
	
	ПоказатьВводСтроки(ПродолжениеВыбора, Объект.Код, НСтр("ru='Введите код'"), 12, Ложь);

КонецПроцедуры
	
&НаКлиенте
Процедура КодОКПД2НачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Строка") Тогда
		Объект.Код = СокрЛП(Результат);
	ИначеЕсли ТипЗнч(Результат) = Тип("Структура") Тогда 	
		Объект.Код = Результат.Код;
		Объект.НаименованиеПолное = Результат.Наименование;   
	КонецЕсли;	
	
КонецПроцедуры	

#КонецОбласти
