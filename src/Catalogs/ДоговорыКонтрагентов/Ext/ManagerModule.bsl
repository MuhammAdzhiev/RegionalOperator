#Область ПрограммныйИнтерфейс

// Параметры:
//  СсылкаНаОбъект - СправочникСсылка.ДоговорыКонтрагентов
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса
//  * НомерДоговора - см. Справочник.ДоговорыКонтрагентов.НомерДоговора
//  * ДатаДоговора - см. Справочник.ДоговорыКонтрагентов.ДатаДоговора
//  * Сумма - см. Справочник.ДоговорыКонтрагентов.Сумма
//  * СуммаВключаетНДС - см. Справочник.ДоговорыКонтрагентов.СуммаВключаетНДС
//  * СтавкаНДС - см. Справочник.ДоговорыКонтрагентов.СтавкаНДС
//  * СуммаНДС - см. Справочник.ДоговорыКонтрагентов.СуммаНДС
//  * ДатаНачалаДействия - см. Справочник.ДоговорыКонтрагентов.ДатаНачалаДействия
//  * ДатаОкончанияДействия - см. Справочник.ДоговорыКонтрагентов.ДатаОкончанияДействия
//  * НаличиеПролонгации - см. Справочник.ДоговорыКонтрагентов.НаличиеПролонгации
//  * ПредметДоговора - см. Справочник.ДоговорыКонтрагентов.ПредметДоговора
//  * Наименование - см. Справочник.ДоговорыКонтрагентов.Наименование
//  * ВидДоговора - см. Справочник.ДоговорыКонтрагентов.ВидДоговора
//  * Организация - см. Справочник.ДоговорыКонтрагентов.Организация
//  * Организация_ЮрФизЛицо - ПеречислениеСсылка.ЮрФизЛицо
//  * Организация_БанковскийСчет_БИК - Строка
//  * Организация_БанковскийСчет_НаименованиеБанка - Строка
//  * Организация_БанковскийСчет_НомерСчета - Строка
//  * Организация_БанковскийСчет_КоррСчет - Строка
//  * Организация_БанковскийСчет_ИНН - Строка
//  * Контрагент - СправочникСсылка.Контрагенты
//  * Контрагент_ЮрФизЛицо - ПеречислениеСсылка.ЮрФизЛицо
//  * Контрагент_ИдентификаторЮридическогоЛица - Строка
//  * Контрагент_БанковскийСчет_БИК - Строка
//  * Контрагент_БанковскийСчет_НаименованиеБанка - Строка
//  * Контрагент_БанковскийСчет_НомерСчета - Строка
//  * Контрагент_БанковскийСчет_КоррСчет - Строка
//  * Контрагент_БанковскийСчет_ИНН - Строка
//  * Валюта_Код - Строка
//  * Валюта_Наименование - Строка
//
Функция ПолучитьДанныеДляЭД(СсылкаНаОбъект) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ДоговорыКонтрагентов.НомерДоговора КАК НомерДоговора,
	|	ДоговорыКонтрагентов.ДатаДоговора КАК ДатаДоговора,
	|	ДоговорыКонтрагентов.Сумма КАК Сумма,
	|	ДоговорыКонтрагентов.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ДоговорыКонтрагентов.СтавкаНДС КАК СтавкаНДС,
	|	ДоговорыКонтрагентов.СуммаНДС КАК СуммаНДС,
	|	ДоговорыКонтрагентов.ВалютаРасчетов.Код КАК Валюта_Код,
	|	ДоговорыКонтрагентов.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	ДоговорыКонтрагентов.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	ДоговорыКонтрагентов.НаличиеПролонгации КАК НаличиеПролонгации,
	|	ДоговорыКонтрагентов.ПредметДоговора КАК ПредметДоговора,
	|	ДоговорыКонтрагентов.Наименование КАК Наименование,
	|	ДоговорыКонтрагентов.ВидДоговора КАК ВидДоговора,
	|	ДоговорыКонтрагентов.Организация КАК Организация,
	|	ДоговорыКонтрагентов.Организация.ЮрФизЛицо КАК Организация_ЮрФизЛицо,
	|	ДоговорыКонтрагентов.Организация.ОсновнойБанковскийСчет.Банк.Код КАК Организация_БанковскийСчет_БИК,
	|	ДоговорыКонтрагентов.Организация.ОсновнойБанковскийСчет.Банк.Наименование КАК Организация_БанковскийСчет_НаименованиеБанка,
	|	ДоговорыКонтрагентов.Организация.ОсновнойБанковскийСчет.НомерСчета КАК Организация_БанковскийСчет_НомерСчета,
	|	ДоговорыКонтрагентов.Организация.ОсновнойБанковскийСчет.Банк.КоррСчет КАК Организация_БанковскийСчет_КоррСчет,
	|	ДоговорыКонтрагентов.Организация.ОсновнойБанковскийСчет.Банк.ИНН КАК Организация_БанковскийСчет_ИНН,
	|	ДоговорыКонтрагентов.Владелец КАК Контрагент,
	|	ДоговорыКонтрагентов.Владелец.ЮрФизЛицо КАК Контрагент_ЮрФизЛицо,
	|	ДоговорыКонтрагентов.Владелец.ИдентификаторЮридическогоЛица КАК Контрагент_ИдентификаторЮридическогоЛица,
	|	ДоговорыКонтрагентов.Владелец.ОсновнойБанковскийСчет.Банк.Код КАК Контрагент_БанковскийСчет_БИК,
	|	ДоговорыКонтрагентов.Владелец.ОсновнойБанковскийСчет.Банк.Наименование КАК Контрагент_БанковскийСчет_НаименованиеБанка,
	|	ДоговорыКонтрагентов.Владелец.ОсновнойБанковскийСчет.НомерСчета КАК Контрагент_БанковскийСчет_НомерСчета,
	|	ДоговорыКонтрагентов.Владелец.ОсновнойБанковскийСчет.Банк.КоррСчет КАК Контрагент_БанковскийСчет_КоррСчет,
	|	ДоговорыКонтрагентов.Владелец.ОсновнойБанковскийСчет.Банк.ИНН КАК Контрагент_БанковскийСчет_ИНН,
	|	ДоговорыКонтрагентов.ВалютаРасчетов.Наименование КАК Валюта_Наименование
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

#Область ДляВызоваИзДругихПодсистем

