&НаКлиенте
Процедура УстановитьОтборПоШтрихкодуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат Тогда
		Элементы.ПоискПоШтрихкоду.Пометка = Истина;
		Элементы.СписокКонтекстноеМенюПоискПоШтрихкоду.Пометка = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаСервере
Процедура ЗаполнитьДеревоИерархии()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Значение,
	|	Номенклатура.Наименование КАК Представление,
	|	Номенклатура.ПометкаУдаления КАК ПометкаУдаления,
	|	ВЫБОР
	|		КОГДА Номенклатура.ПометкаУдаления
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Картинка,
	|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура.Наименование ИЕРАРХИЯ";
	
	Дерево = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	СтрокаНетГруппы = Дерево.Строки.Вставить(0);
	СтрокаНетГруппы.Значение	  = Неопределено;
	СтрокаНетГруппы.Представление = НСтр("ru = '<Все группы>'");
	СтрокаНетГруппы.Картинка      = 12;
	
	СтрокаНетГруппы = Дерево.Строки.Добавить();
	СтрокаНетГруппы.Значение	  = Справочники.Номенклатура.ПустаяСсылка();
	СтрокаНетГруппы.Представление = НСтр("ru = '<Нет группы>'");
	СтрокаНетГруппы.Картинка      = 3;

	
	ЗначениеВРеквизитФормы(Дерево, "ОтборИерархия");
	
КонецПроцедуры

&НаСервере
Процедура ДеревоВидовНоменклатуры() 
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыНоменклатуры.Ссылка КАК Значение,
	|	ВидыНоменклатуры.Наименование КАК Представление,
	|	ВЫБОР
	|		КОГДА НЕ ВидыНоменклатуры.ЭтоГруппа
	|			ТОГДА 3
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ВидыНоменклатуры.ПометкаУдаления
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|	КОНЕЦ КАК Картинка
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыНоменклатуры.Наименование ИЕРАРХИЯ";
	
	Дерево = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		
		СтрокаНетКатегории = Дерево.Строки.Вставить(0);
		СтрокаНетКатегории.Картинка = 12;
		СтрокаНетКатегории.Значение = Справочники.Номенклатура.ПустаяСсылка();
		СтрокаНетКатегории.Представление = НСтр("ru='<Все виды номенклатур>'");
	
	ЗначениеВРеквизитФормы(Дерево, "ОтборВидовНоменклатуры");
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьГруппуЗавершение(Результат, ДопПараметры) Экспорт 
	
	ЗаполнитьДеревоИерархии();
	
	Модифицированность = Ложь;
	
КонецПроцедуры // СоздатьГруппуЗавершение()

&НаКлиенте
Процедура ИерархияЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт 
	
	ТекущиеДанные = Элементы.ОтборИерархия.ТекущиеДанные;
	ТекущиеДанные.Представление = Строка(ТекущиеДанные.Значение);
	
	Модифицированность = Ложь;
	
КонецПроцедуры // ИерархияЗавершение()

&НаСервереБезКонтекста
Функция ПометитьГруппуНаУдаление(Группа)

	Группа.ПолучитьОбъект().УстановитьПометкуУдаления(НЕ Группа.ПометкаУдаления);
	Возврат Группа.ПометкаУдаления;
	
КонецФункции // ПометитьГруппуНаУдаление()

#КонецОбласти

