#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		ОтборКатегорииИерархияПереключатель                    = Истина;
		Элементы.ОтборКатегорииИерархияПереключатель.Видимость = Ложь;
		Элементы.ОтборВидовНоменклатуры.АвтоМаксимальнаяШирина = Истина;
		Элементы.СтраницыФильтра.ТекущаяСтраница = Элементы.СтраницаВидыНоменклатуры;
	Иначе
		// ЭлектронноеВзаимодействие.РаботаСНоменклатурой
		РаботаСНоменклатурой.ПриСозданииНаСервереФормаСпискаНоменклатуры(
			ЭтотОбъект,
			Элементы.ПодключаемыеКоманды,
			Элементы.Список,
			Истина);
		// Конец ЭлектронноеВзаимодействие.РаботаСНоменклатурой
	КонецЕсли;
	
	ЗаполнитьДеревоИерархии();
	ДеревоВидовНоменклатуры();
	
	ТолькоПросмотр = Не ПравоДоступа("Изменение", Метаданные.Справочники.Номенклатура);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Не КлиентЭДОКлиентПовтИсп.ИспользуетсяГосИС() Тогда
		// ЭлектронноеВзаимодействие.РаботаСНоменклатурой
		Если ИмяСобытия = РаботаСНоменклатуройКлиент.ОписаниеОповещенийПодсистемы().ЗагрузкаНоменклатуры Тогда
			Если Параметр.СозданныеОбъекты.Количество() > 0 Тогда
				Элементы.Список.ТекущаяСтрока = Параметр.СозданныеОбъекты[0].Номенклатура;
			КонецЕсли;
		ИначеЕсли ИмяСобытия = РаботаСНоменклатуройКлиент.ОписаниеОповещенийПодсистемы().СопоставлениеНоменклатуры Тогда	
			Элементы.Список.Обновить();	
		КонецЕсли;
		// Конец ЭлектронноеВзаимодействие.РаботаСНоменклатурой
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоказыватьВложенныеПриИзменении(Элемент)
	
	ОтборИерархияПриАктивизацииСтроки(Неопределено)
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;   
КонецПроцедуры

&НаКлиенте
Процедура ОтборИерархияПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	Если Строка = Неопределено Или ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
		
	ТекущаяСтрока = ОтборИерархия.НайтиПоИдентификатору(Строка);
	
	Если ТекущаяСтрока.Значение = Неопределено Или ТолькоПросмотр Тогда
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
	Иначе
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Перемещение;
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборИерархияПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	ТекущаяГруппа = ОтборИерархия.НайтиПоИдентификатору(Строка).Значение;
	МассивСтрок = ПараметрыПеретаскивания.Значение;

	СменитьРодителяПриПеретаскивании(ТекущаяГруппа, МассивСтрок, ОтборИерархия);
	
	ТекстСообщения = СтрШаблон(НСтр("ru = 'Перенос в группу %1 выполнен успешно'"), ТекущаяГруппа);
	ПоказатьОповещениеПользователя(ТекстСообщения,,,БиблиотекаКартинок.Успешно32);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СменитьРодителяПриПеретаскивании(Знач ТекущаяГруппа, МассивСтрок, Знач ОтборИерархия)

	Для Каждого СтрокаМассива Из МассивСтрок Цикл 
		
		Если ТипЗнч(СтрокаМассива) = Тип("Число") Тогда 
			
			 ОбъектНоменклатура = ОтборИерархия.НайтиПоИдентификатору(СтрокаМассива).Значение.ПолучитьОбъект();
			 
		 ИначеЕсли ТипЗнч(СтрокаМассива) = Тип("СправочникСсылка.Номенклатура") Тогда 
			 
			   ОбъектНоменклатура = СтрокаМассива.ПолучитьОбъект();
			   
		Иначе 
			
			Продолжить;
			
		КонецЕсли;
		
		ОбъектНоменклатура.Родитель = ТекущаяГруппа;
		ОбъектНоменклатура.Записать();
		
	КонецЦикла;

КонецПроцедуры 

&НаКлиенте
Процедура ОтборИерархияНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	Для Каждого ЭлементПеретаскивания Из ПараметрыПеретаскивания.Значение Цикл 
		
		Если  НЕ ЗначениеЗаполнено(ОтборИерархия.НайтиПоИдентификатору(ЭлементПеретаскивания).Значение) Тогда 
			Выполнение = Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборИерархияОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	ЗаполнитьДеревоИерархии();
КонецПроцедуры

&НаКлиенте
Процедура СписокОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	Элементы.Список.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ОтборИерархияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ОтборИерархия.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Значение) Тогда 
		
		ПараметрыОткрытия = Новый Структура();
		ПараметрыОткрытия.Вставить("Ключ", ТекущиеДанные.Значение);
		
		ОткрытьФорму("Справочник.Номенклатура.ФормаГруппы",
			ПараметрыОткрытия,
			,,,,
			Новый ОписаниеОповещения("ИерархияЗавершение",ЭтотОбъект));
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоискПоШтрихкоду(Команда)
	
	Если Элементы.ПоискПоШтрихкоду.Пометка Тогда
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список, "Ссылка");
		Элементы.ПоискПоШтрихкоду.Пометка = Ложь;
		Элементы.СписокКонтекстноеМенюПоискПоШтрихкоду.Пометка = Ложь;
	Иначе
		Оповещение = Новый ОписаниеОповещения("УстановитьОтборПоШтрихкодуЗавершение", ЭтотОбъект);
		КлиентЭДОКлиент.УстановитьОтборПоШтрихкоду(Оповещение, Список);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборКатегорииИерархияПереключательПриИзменении(Элемент)
	
	Список.Отбор.Элементы.Очистить();
	
	Если ОтборКатегорииИерархияПереключатель Тогда
		Элементы.СтраницыФильтра.ТекущаяСтраница = Элементы.СтраницаВидыНоменклатуры;
	Иначе
		Элементы.СтраницыФильтра.ТекущаяСтраница = Элементы.СтраницаИерархия;
	КонецЕсли;
	
	Элементы.ОтборВидовНоменклатуры.ТекущаяСтрока = 0;
	Элементы.ОтборИерархия.ТекущаяСтрока          = 0;
	Элементы.ПоискПоШтрихкоду.Пометка             = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборВидовНоменклатурыПриАктивизацииСтроки(Элемент)
	Если НЕ ОтборКатегорииИерархияПереключатель Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ОтборВидовНоменклатуры.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОтборВидНоменклатурыТекущая = Элементы.ОтборВидовНоменклатуры.ТекущиеДанные.Значение Тогда
		Возврат;
	КонецЕсли;
	
	ОтборВидНоменклатурыТекущая = Элементы.ОтборВидовНоменклатуры.ТекущиеДанные.Значение;
	
	ГруппаОтборПоКатегории = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
	Список.Отбор.Элементы,
	"ОтборПоВидуНоменклатуры",
	ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
	ГруппаОтборПоКатегории,
	"ВидНоменклатуры",
	ВидСравненияКомпоновкиДанных.Равно,
	ОтборВидНоменклатурыТекущая,
	"ОтборПоВидуНоменклатуры",
	ЗначениеЗаполнено(ОтборВидНоменклатурыТекущая));
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
	ГруппаОтборПоКатегории,
	"ВидНоменклатуры",
	ВидСравненияКомпоновкиДанных.ВИерархии,
	ОтборВидНоменклатурыТекущая,
	"ОтборПоВидуНоменклатурыВИерархии",
	ЗначениеЗаполнено(ОтборВидНоменклатурыТекущая));
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборИерархияПриАктивизацииСтроки(Элемент)
	
	Если ОтборКатегорииИерархияПереключатель Тогда
		Возврат;
	КонецЕсли;

	Если Элементы.ОтборИерархия.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	
	ОтборПоГруппеТекущая = Элементы.ОтборИерархия.ТекущиеДанные.Значение;
	
	ПравоеЗначение	= Неопределено;
	Сравнение		= ВидСравненияКомпоновкиДанных.Равно;
	Использование	= Истина;
	
	Если  Элементы.ОтборИерархия.ТекущиеДанные.ЭтоГруппа Тогда
		
		Если ПоказыватьВложенные Тогда 
			Сравнение = ВидСравненияКомпоновкиДанных.ВИерархии;
		Иначе 
			Сравнение = ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли; 
		
		ПравоеЗначение = Элементы.ОтборИерархия.ТекущиеДанные.Значение;
		
	ИначеЕсли Элементы.ОтборИерархия.ТекущиеДанные.Значение = Неопределено Тогда
		
			Использование = Ложь;
		
	Иначе 
		   	Сравнение = ВидСравненияКомпоновкиДанных.Равно;
			ПравоеЗначение = Элементы.ОтборИерархия.ТекущиеДанные.Значение;
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"Родитель",
		ПравоеЗначение,
		Сравнение,
		,
		Использование);
	

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьГруппу(Команда)
	ТекущиеДанные = Элементы.ОтборИерархия.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Значение) Тогда 
		
		ПараметрыОткрытия = Новый Структура();
		ПараметрыОткрытия.Вставить("Ключ", ТекущиеДанные.Значение);
		
		ОткрытьФорму("Справочник.Номенклатура.ФормаГруппы",
			ПараметрыОткрытия,
			,,,,
			Новый ОписаниеОповещения("ИерархияЗавершение",ЭтотОбъект));
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УдалитьГруппу(Команда)
	ТекущиеДанные = Элементы.ОтборИерархия.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Значение) Тогда 
		
		ТекущиеДанные.Картинка = ПометитьГруппуНаУдаление(ТекущиеДанные.Значение);
		
	КонецЕсли;

	Модифицированность = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьГруппу(Команда)
	
	ПараметрыФормы = Новый Структура("ЭтоГруппа", Истина);
	
	ОткрытьФорму("Справочник.Номенклатура.ФормаГруппы",
		ПараметрыФормы
		,ЭтотОбъект.УникальныйИдентификатор
		,,,
		,Новый ОписаниеОповещения("СоздатьГруппуЗавершение",ЭтотОбъект));
КонецПроцедуры

