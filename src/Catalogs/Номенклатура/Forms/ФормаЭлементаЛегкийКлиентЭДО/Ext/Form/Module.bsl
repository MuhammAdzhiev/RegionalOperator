&НаКлиенте
Процедура ЗаполнитьУпаковкуЧастичногоВыбытия(Команда)
	
	ПараметрыЗапроса = ИнтерфейсИСМПОбщегоНазначенияКлиент.ПараметрыЗапросаДанных();
	ПараметрыЗапроса.Параметры = Новый Структура();
	ПараметрыЗапроса.Параметры.Вставить("Номенклатура", Объект.Ссылка);
	
	ПараметрыЗавершения = Новый Структура();
	ПараметрыЗавершения.Вставить("Форма",                   ЭтотОбъект);
	ПараметрыЗавершения.Вставить("ПотребительскаяУпаковка", ПотребительскаяУпаковка);
	ПараметрыЗавершения.Вставить("Номенклатура",            Объект.Ссылка);
	
	ПараметрыЗапроса.ОповещениеОЗавершении = Новый ОписаниеОповещения(
		"Подключемый_ЗаполнитьУпаковкуЧастичногоВыбытияИСЗавершение",
		ЭтотОбъект,
		ПараметрыЗавершения);
	
	ИнтерфейсИСМПОбщегоНазначенияКлиент.ЕмкостьУпаковкиПоGTIN(ПараметрыЗапроса);
	
КонецПроцедуры

