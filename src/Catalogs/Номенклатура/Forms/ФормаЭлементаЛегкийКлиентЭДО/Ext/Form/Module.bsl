#Область БГосИС

&НаСервере
Процедура ЗаписатьДанныеНоменклатуры(ДанныеЗаписи, Отказ)
	
	Блокировка       = Новый БлокировкаДанных();
	ДанныеНастройки  = ДанныеНастройкиНоменклатуры(ДанныеЗаписи);
	ИсточникОписания = ДанныеЗаписи.Ссылка;
	
	Если Не ЗначениеЗаполнено(ДанныеНастройки.КлючВидовПродукции)
		И Не ЗначениеЗаполнено(ДанныеНастройки.ПотребительскаяУпаковка)
		И Не ЗначениеЗаполнено(ДанныеНастройки.УпаковкаЧастичногоВыбытия) Тогда
		Если Не ЗначениеЗаполнено(ДанныеЗаписи.КлючВидовПродукции)
			И ((Не ЗначениеЗаполнено(ДанныеЗаписи.ПотребительскаяУпаковка)
				И Не ЗначениеЗаполнено(ДанныеЗаписи.УпаковкаЧастичногоВыбытия))
				Или (ДанныеЗаписи.ПотребительскаяУпаковка = ДанныеЗаписи.ЕдиницаИзмерения
					И Не ДанныеЗаписи.ЧастичноеВыбытиеИспользуется)) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ВариантИспользованияЕдиницыХранения = ДанныеНастройки.ВариантИспользованияЕдиницыХранения;
	Если Не ЗначениеЗаполнено(ВариантИспользованияЕдиницыХранения) Тогда
		ВариантИспользованияЕдиницыХранения = Перечисления.ВариантыИспользованияЕдиницыХраненияИС.ЗаданУпаковками;
	КонецЕсли;
	
	Если ДанныеНастройки.МернаяЕдиница Тогда
		Если ЗначениеЗаполнено(ДанныеЗаписи.ПотребительскаяУпаковка) Тогда
			ВариантИспользованияЕдиницыХранения = Перечисления.ВариантыИспользованияЕдиницыХраненияИС.ЧастьПотребительскойУпаковки;
		Иначе
			ВариантИспользованияЕдиницыХранения = Перечисления.ВариантыИспользованияЕдиницыХраненияИС.МернаяПродукцияТребуетУказанияЗначения;
		КонецЕсли
	Иначе
		ВариантИспользованияЕдиницыХранения = Перечисления.ВариантыИспользованияЕдиницыХраненияИС.ПотребительскаяУпаковка;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ОписаниеНоменклатурыИС");
		ЭлементБлокировки.УстановитьЗначение("Номенклатура", ИсточникОписания);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.НастройкиЧастичногоВыбытияПродукцииИС");
		ЭлементБлокировки.УстановитьЗначение("Номенклатура", ИсточникОписания);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		
		Если ДанныеЗаписи.GTIN <> Неопределено Тогда
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ОписаниеGTINИС");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		КонецЕсли;
		
		Если ДанныеЗаписи.ЗаписатьШтрихкоды Тогда
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.Штрихкоды");
			ЭлементБлокировки.УстановитьЗначение("Номенклатура", ИсточникОписания);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		КонецЕсли;
		
		Блокировка.Заблокировать();
		
		ДанныеОписания = ОбщегоНазначенияИС.ИнициализироватьДанныеОписанияНоменклатуры();
		
		ДанныеОписания.ПотребительскаяУпаковка             = ДанныеЗаписи.ПотребительскаяУпаковка;
		ДанныеОписания.УпаковкаЧастичногоВыбытия           = ДанныеЗаписи.УпаковкаЧастичногоВыбытия;
		ДанныеОписания.ВариантИспользованияЕдиницыХранения = ВариантИспользованияЕдиницыХранения;
		
		КоэффициентыПоВидамУпаковок = КоэффициентыПоВидамУпаковок(ДанныеЗаписи);
		Если ЗначениеЗаполнено(ДанныеЗаписи.ПотребительскаяУпаковка) Тогда
			ДанныеОписания.КоличествоВПотребительскойУпаковке = КоэффициентыПоВидамУпаковок.КоэффициентПотребительскойУпаковки;
		Иначе
			ДанныеОписания.КоличествоВПотребительскойУпаковке = 0;
		КонецЕсли;
		
		Если ДанныеЗаписи.ЧастичноеВыбытиеИспользуется Тогда
			ДанныеОписания.ВариантЧастичногоВыбытия = Перечисления.ВариантыУчетаЧастичногоВыбытияИС.ТекущаяНоменклатура;
			Если КоэффициентыПоВидамУпаковок.КоэффициентУпаковкиЧастичногоВыбытия <> 0 Тогда
				ДанныеОписания.ЕмкостьПотребительскойУпаковки = Окр(ДанныеОписания.КоличествоВПотребительскойУпаковке / КоэффициентыПоВидамУпаковок.КоэффициентУпаковкиЧастичногоВыбытия, 0);
			Иначе
				ВызватьИсключение НСтр("ru = 'Коэффициент упаковки частичного выбытия не может быть равен нулю.'")
			КонецЕсли;
		Иначе
			ДанныеОписания.ВариантЧастичногоВыбытия = Перечисления.ВариантыУчетаЧастичногоВыбытияИС.ПустаяСсылка();
		КонецЕсли;
			
		ДанныеОписания.Номенклатура       = ИсточникОписания;
		ДанныеОписания.КлючВидовПродукции = ДанныеЗаписи.КлючВидовПродукции;
		
		РегистрыСведений.ОписаниеНоменклатурыИС.УстановитьОписание(ДанныеОписания);
		
		Если ДанныеЗаписи.GTIN <> Неопределено Тогда
			
			МассивGTIN = Новый Массив;
			Если ЗначениеЗаполнено(ДанныеЗаписи.GTIN) Тогда
				МассивGTIN.Добавить(ДанныеЗаписи.GTIN);
			КонецЕсли;
			Если ЗначениеЗаполнено(ДанныеЗаписи.GTINДоИзменения) Тогда
				МассивGTIN.Добавить(ДанныеЗаписи.GTINДоИзменения);
			КонецЕсли;
			
			ОписанияGTIN = РегистрыСведений.ОписаниеGTINИС.ПолучитьОписание(МассивGTIN);
			
			Если ЗначениеЗаполнено(ДанныеЗаписи.GTIN) Тогда
				ТекущееОписаниеGTIN = РегистрыСведений.ОписаниеGTINИС.ИнициализироватьДанныеОписания();
				ТекущееОписаниеGTIN.GTIN = ДанныеЗаписи.GTIN;
				Если ОписанияGTIN[ДанныеЗаписи.GTIN] <> Неопределено Тогда
					ЗаполнитьЗначенияСвойств(ТекущееОписаниеGTIN, ОписанияGTIN[ДанныеЗаписи.GTIN]);
				КонецЕсли;
				ТекущееОписаниеGTIN.ВидУпаковки = Перечисления.ВидыУпаковокИС.Потребительская;
				ТекущееОписаниеGTIN.КоличествоПотребительскихУпаковок = 1;
				РегистрыСведений.ОписаниеGTINИС.УстановитьОписание(ТекущееОписаниеGTIN);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДанныеЗаписи.GTINДоИзменения) Тогда
				ТекущееОписаниеGTIN = РегистрыСведений.ОписаниеGTINИС.ИнициализироватьДанныеОписания();
				ТекущееОписаниеGTIN.GTIN = ДанныеЗаписи.GTINДоИзменения;
				Если ОписанияGTIN[ДанныеЗаписи.GTINДоИзменения] <> Неопределено Тогда
					ЗаполнитьЗначенияСвойств(ТекущееОписаниеGTIN, ОписанияGTIN[ДанныеЗаписи.GTINДоИзменения]);
				КонецЕсли;
				Если ТекущееОписаниеGTIN <> Неопределено Тогда
					ТекущееОписаниеGTIN.ВидУпаковки = Перечисления.ВидыУпаковокИС.ПустаяСсылка();
					ТекущееОписаниеGTIN.КоличествоПотребительскихУпаковок = Неопределено;
					РегистрыСведений.ОписаниеGTINИС.УстановитьОписание(ТекущееОписаниеGTIN);
				КонецЕсли;
			КонецЕсли;
			
			Если ДанныеЗаписи.ЗаписатьШтрихкоды Тогда
				МенеджерРегистра = РегистрыСведений.Штрихкоды.СоздатьМенеджерЗаписи();
				МенеджерРегистра.Штрихкод         = РазборКодаМаркировкиИССлужебныйКлиентСерверПовтИсп.ШтрихкодEANИзGTIN(ДанныеЗаписи.GTIN);
				МенеджерРегистра.Номенклатура     = ИсточникОписания;
				МенеджерРегистра.ЕдиницаИзмерения = ДанныеЗаписи.ЕдиницаИзмерения;
				МенеджерРегистра.Записать();
			КонецЕсли;
			
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.НастройкиЧастичногоВыбытияПродукцииИС.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Номенклатура.Установить(ИсточникОписания);
		Для Каждого Строка Из ДанныеНастройки.НастройкиЧастичногоВыбытияПродукцииИС Цикл
			Запись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, Строка);
			Запись.Номенклатура = ИсточникОписания;
		КонецЦикла;
		НаборЗаписей.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Произошла ошибка при записи данных настройки номенклатуры ИС:
			           |%1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Отказ = Истина;
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция КоэффициентыПоВидамУпаковок(ДанныеЗаписи)
	
	ВозвращаемоеЗначение = Новый Структура();
	ВозвращаемоеЗначение.Вставить("КоэффициентПотребительскойУпаковки",   1);
	ВозвращаемоеЗначение.Вставить("КоэффициентУпаковкиЧастичногоВыбытия", 1);
	
	МассивУпаковок = Новый Массив();
	Если ЗначениеЗаполнено(ДанныеЗаписи.ПотребительскаяУпаковка) Тогда
		МассивУпаковок.Добавить(ДанныеЗаписи.ПотребительскаяУпаковка);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеЗаписи.УпаковкаЧастичногоВыбытия) Тогда
		МассивУпаковок.Добавить(ДанныеЗаписи.УпаковкаЧастичногоВыбытия);
	КонецЕсли;
	
	Если МассивУпаковок.Количество() > 0 Тогда
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивУпаковок, "ТипИзмеряемойВеличины, Коэффициент");
		
		Если ЗначениеЗаполнено(ДанныеЗаписи.ПотребительскаяУпаковка)
			И ДанныеЗаписи.ПотребительскаяУпаковка <> ДанныеЗаписи.ЕдиницаИзмерения Тогда
			РеквизитыПотребительской = ЗначенияРеквизитов.Получить(ДанныеЗаписи.ПотребительскаяУпаковка);
			ВозвращаемоеЗначение.КоэффициентПотребительскойУпаковки = РеквизитыПотребительской.Коэффициент;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеЗаписи.УпаковкаЧастичногоВыбытия)
			И ДанныеЗаписи.УпаковкаЧастичногоВыбытия <> ДанныеЗаписи.ЕдиницаИзмерения Тогда
			РеквизитыЧастичногоВыбытия = ЗначенияРеквизитов.Получить(ДанныеЗаписи.УпаковкаЧастичногоВыбытия);
			Если ЗначениеЗаполнено(ДанныеЗаписи.УпаковкаЧастичногоВыбытия) Тогда
				ВозвращаемоеЗначение.КоэффициентУпаковкиЧастичногоВыбытия = РеквизитыЧастичногоВыбытия.Коэффициент;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_РазрешитьРедактированиеРеквизитовОбъектаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Ложь Тогда
		
		ОбновитьСвязанныеЭлементыЕдиницыИзмерения(ЭтотОбъект, Истина);
		ПользовательРазрешилРедактирование = ПользовательРазрешилРедактированиеРеквизита();
		НастроитьЭлементыФормыИС(ЭтотОбъект, ПользовательРазрешилРедактирование);
		Если ЗначениеЗаполнено(ВидПродукцииЕГАИС)
			И ТребуетсяЗаполнениеРеквизитовЕГАИС(ЭтотОбъект) Тогда
			ЗаполнитьСопоставлениеСПродукциейПодсистем();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключемый_ЗаполнитьУпаковкуЧастичногоВыбытияИСЗавершение(ДанныеРезультата, ПараметрыЗавершения) Экспорт
	
	Если ДанныеРезультата.ЕстьОшибки Тогда
		ПоказатьПредупреждение(, ДанныеРезультата.ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ЕмкостиУпаковки = Новый Соответствие();
	Для Каждого КлючИЗначение Из ДанныеРезультата.Результат Цикл
		Если ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
			ЕмкостиУпаковки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ЕмкостьУпаковки = Неопределено;
	Если ЕмкостиУпаковки.Количество() > 1 Тогда
		Тексты = Новый Массив();
		Для Каждого КлючИЗначение Из ЕмкостиУпаковки Цикл
			Тексты.Добавить(СтрШаблон("%1: %2", КлючИЗначение.Ключ, КлючИЗначение.Значение));
		КонецЦикла;
		ПоказатьПредупреждение(, СтрШаблон(
			НСтр("ru = 'В ГИС МТ по GTIN найдено более одной емкости потребительской упаковки:
				       |%1'"),
			СтрСоединить(Тексты, Символы.ПС)));
		Возврат;
	ИначеЕсли ЕмкостиУпаковки.Количество() = 1 Тогда
		Для Каждого КлючИЗначение Из ЕмкостиУпаковки Цикл
			ЕмкостьУпаковки = КлючИЗначение.Значение;
		КонецЦикла;
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'В ГИС МТ по GTIN не найдено ни одного значения емкости потребительской упаковки.'"));
		Возврат;
	КонецЕсли;
	
	Номенклатура   = ПараметрыЗавершения.Номенклатура;
	Форма          = ПараметрыЗавершения.Форма;
	ДанныеУпаковки = ДанныеУпаковкиНоменклатурыЧастичногоВыбытия(
		Номенклатура,
		ПараметрыЗавершения.ПотребительскаяУпаковка,
		ЕмкостьУпаковки);
	
	Если ДанныеУпаковки.Упаковка <> Неопределено Тогда
		Форма.УпаковкаЧастичногоВыбытия = ДанныеУпаковки.Упаковка;
		Форма.Модифицированность        = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДанныеНастройкиНоменклатуры(ДанныеНоменклатуры)
	
	ДанныеНастройкиНоменклатуры = Новый Структура;
	ДанныеНастройкиНоменклатуры.Вставить("ЕдиницаХранения",              ДанныеНоменклатуры.ЕдиницаИзмерения);
	ДанныеНастройкиНоменклатуры.Вставить("МернаяЕдиница",                Справочники.ЕдиницыИзмерения.ЭтоМернаяЕдиница(ДанныеНоменклатуры.ЕдиницаИзмерения));
	ДанныеНастройкиНоменклатуры.Вставить("ПотребительскаяУпаковка",      Неопределено);
	ДанныеНастройкиНоменклатуры.Вставить("УпаковкаЧастичногоВыбытия",    Неопределено);
	ДанныеНастройкиНоменклатуры.Вставить("ЧастичноеВыбытиеИспользуется", Ложь);
	ДанныеНастройкиНоменклатуры.Вставить("КлючВидовПродукции",           Справочники.КлючиВидовПродукцииИС.ПустаяСсылка());
	ДанныеНастройкиНоменклатуры.Вставить("ВариантИспользованияЕдиницыХранения", Неопределено);
	ДанныеНастройкиНоменклатуры.Вставить("АдресДанныхНастроекПараметровНоменклатурыИС", ДанныеНоменклатуры.АдресДанныхНастроекПараметровНоменклатурыИС);
	
	Если ЭтоАдресВременногоХранилища(ДанныеНастройкиНоменклатуры.АдресДанныхНастроекПараметровНоменклатурыИС) Тогда
		ДанныеНастроек = ПолучитьИзВременногоХранилища(ДанныеНастройкиНоменклатуры.АдресДанныхНастроекПараметровНоменклатурыИС);
		ИнициализироватьНастройки = Ложь;
	Иначе
		ДанныеНастроек = ИнтеграцияИС.ДанныеНастроекПараметровНоменклатуры(ДанныеНоменклатуры.Ссылка);
		ИнициализироватьНастройки = Истина;
	КонецЕсли;
	
	ДанныеНастройкиНоменклатуры.Вставить("ОписаниеНоменклатурыИС", ДанныеНастроек.ОписаниеНоменклатурыИС);
	ДанныеНастройкиНоменклатуры.Вставить("НастройкиЧастичногоВыбытияПродукцииИС", ДанныеНастроек.НастройкиЧастичногоВыбытияПродукцииИС);
	
	Если ЗначениеЗаполнено(ДанныеНоменклатуры.Ссылка) Тогда
		ДанныеОписания = ДанныеНастроек.ОписаниеНоменклатурыИС;
		ДанныеНастройкиНоменклатуры.ПотребительскаяУпаковка      = ДанныеОписания.ПотребительскаяУпаковка;
		ДанныеНастройкиНоменклатуры.УпаковкаЧастичногоВыбытия    = ДанныеОписания.УпаковкаЧастичногоВыбытия;
		ДанныеНастройкиНоменклатуры.ЧастичноеВыбытиеИспользуется = ЗначениеЗаполнено(ДанныеОписания.ВариантЧастичногоВыбытия);
		ДанныеНастройкиНоменклатуры.ВариантИспользованияЕдиницыХранения = ДанныеОписания.ВариантИспользованияЕдиницыХранения;
		Если ЗначениеЗаполнено(ДанныеНоменклатуры.КлючВидовПродукции) Тогда
			ДанныеНастройкиНоменклатуры.КлючВидовПродукции = ДанныеНоменклатуры.КлючВидовПродукции;
		Иначе
			ДанныеНастройкиНоменклатуры.КлючВидовПродукции = ДанныеОписания.КлючВидовПродукции;
		КонецЕсли;
	КонецЕсли;
	
	Если ИнициализироватьНастройки Тогда
		ДанныеНастройкиНоменклатуры.АдресДанныхНастроекПараметровНоменклатурыИС =
			ПоместитьВоВременноеХранилище(ДанныеНастроек, Новый УникальныйИдентификатор);
	КонецЕсли;
	
	Возврат ДанныеНастройкиНоменклатуры;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеУпаковкиНоменклатурыЧастичногоВыбытия(Номенклатура, ПотребительскаяУпаковка, КоэффициентУпаковкиИСМП)
	
	ВозвращаемоеЗначение = Новый Структура();
	ВозвращаемоеЗначение.Вставить("Упаковка",           Неопределено);
	ВозвращаемоеЗначение.Вставить("Числитель",          1);
	ВозвращаемоеЗначение.Вставить("Знаменатель",        КоэффициентУпаковкиИСМП);
	ВозвращаемоеЗначение.Вставить("КоличествоУпаковок", 0);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Номенклатура);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица.Ссылка                    КАК Ссылка,
	|	&ТекстЗапросаКоэффициентаУпаковки КАК КоэффициентУпаковки
	|ИЗ
	|	Справочник.ЕдиницыИзмерения КАК Таблица
	|ГДЕ
	|	Таблица.НоменклатураВладелец = &Владелец";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстЗапросаКоэффициентаУпаковки",
		Справочники.ЕдиницыИзмерения.ТекстЗапросаКоэффициентУпаковки("Таблица.Ссылка"));
	
	ЕдиницаХранения = Справочники.ЕдиницыИзмерения.ЕдиницаХраненияНоменклатуры(Номенклатура);
	
	Если ЗначениеЗаполнено(ПотребительскаяУпаковка)
		И ПотребительскаяУпаковка <> ЕдиницаХранения Тогда
		КоэффициентПотребительской              = Справочники.ЕдиницыИзмерения.КоэффициентУпаковки(ПотребительскаяУпаковка, Номенклатура);
		ВозвращаемоеЗначение.Знаменатель        = 1;
		ВозвращаемоеЗначение.Числитель          = КоэффициентУпаковкиИСМП * КоэффициентПотребительской;
		ВозвращаемоеЗначение.КоличествоУпаковок = КоэффициентПотребительской;
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ВозвращаемоеЗначение.Упаковка = Выборка.Ссылка;
		Прервать;
		
	КонецЦикла;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

&НаСервере
Процедура ПрименитьУсловноеОформлениеКПолям()
	
	ОбщегоНазначенияИС.ПрименитьУсловноеОформлениеКПолю(ЭтотОбъект, "ПотребительскаяУпаковка");
	ОбщегоНазначенияИС.ПрименитьУсловноеОформлениеКПолю(ЭтотОбъект, "ПотребительскаяУпаковкаЕГАИС");
	
КонецПроцедуры

&НаСервере
Процедура ПотребительскаяУпаковкаПриИзмененииНаСервере()
	ПрименитьУсловноеОформлениеКПолям();
КонецПроцедуры

&НаСервере
Процедура ПотребительскаяУпаковкаЕГАИСПриИзмененииНаСервере()
	ПрименитьУсловноеОформлениеКПолям();
КонецПроцедуры

&НаСервере
Процедура УпаковкаЧастичногоВыбытияПриИзмененииНаСервере()
	ПрименитьУсловноеОформлениеКПолям();
КонецПроцедуры

&НаСервере
Процедура УпаковкаЧастичногоВыбытияЕГАИСПриИзмененииНаСервере()
	ПрименитьУсловноеОформлениеКПолям();
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТребуетсяЗаполнениеРеквизитовЕГАИС(Форма)
	
	Объект = Форма.Объект;
	
	Возврат ЗначениеЗаполнено(Объект.Ссылка)
		И (Не ЗначениеЗаполнено(Объект.Крепость)
			Или Не ЗначениеЗаполнено(Объект.Производитель)
			Или Не ЗначениеЗаполнено(Объект.ВидАлкогольнойПродукции));
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьЭлементыФормыИС(Форма, ПользовательРазрешилРедактированиеЕдиницыИзмерения = Ложь)

	Объект            = Форма.Объект;
	Элементы          = Форма.Элементы;
	
	ИспользуетсяГИСМТ = ЗначениеЗаполнено(Форма.ВидПродукцииГИСМТ) И Форма.ИспользуетсяПодсистемаГИСМТ;
	ИспользуетсяВЕТИС = ЗначениеЗаполнено(Форма.ВидПродукцииВЕТИС) И Форма.ИспользуетсяПодсистемаВЕТИС;
	ИспользуетсяЕГАИС = ЗначениеЗаполнено(Форма.ВидПродукцииЕГАИС) И Форма.ИспользуетсяПодсистемаЕГАИС;
	
	ПоддерживаетсяЧастичноеВыбытие = Ложь;
	Суффиксы = СуффиксыВидовПродукцииСПредставлением();
	Для Каждого Суффикс Из Суффиксы Цикл
		ВидПродукции = Форма["ВидПродукции"+Суффикс.Значение];
		Если ЗначениеЗаполнено(Форма["ВидПродукции"+Суффикс.Значение])
			И ОбщегоНазначенияИСКлиентСерверПовтИсп.ПоддерживаетсяЧастичноеВыбытие(ВидПродукции) Тогда
			ПоддерживаетсяЧастичноеВыбытие = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ПоддерживаетсяЧастичноеВыбытие Тогда
		ЗаголовокЧастичногоВыбытия = ИнтеграцияИСКлиентСервер.ПредставлениеЧастичногоВыбытияПоВидуПродукции(ВидПродукции);
		ЗаголовокЧастичногоВыбытия = ВРег(Лев(ЗаголовокЧастичногоВыбытия, 1)) + Сред(ЗаголовокЧастичногоВыбытия, 2);
		Элементы.УпаковкаЧастичногоВыбытия.Заголовок      = ЗаголовокЧастичногоВыбытия;
		Элементы.УпаковкаЧастичногоВыбытияЕГАИС.Заголовок = ЗаголовокЧастичногоВыбытия;
	КонецЕсли;
	
	Элементы.ПотребительскаяУпаковка.Видимость              = ИспользуетсяГИСМТ;
	Элементы.ПотребительскаяУпаковкаЕГАИС.Видимость         = (ИспользуетсяЕГАИС И Не ИспользуетсяГИСМТ);
	Элементы.УпаковкаЧастичногоВыбытия.Видимость            = (ПоддерживаетсяЧастичноеВыбытие И ИспользуетсяГИСМТ);
	Элементы.ЗаполнитьУпаковкуЧастичногоВыбытия.Видимость   = Элементы.УпаковкаЧастичногоВыбытия.Видимость;
	Элементы.УпаковкаЧастичногоВыбытияЕГАИС.Видимость       = (ПоддерживаетсяЧастичноеВыбытие И ИспользуетсяЕГАИС И Не ИспользуетсяГИСМТ);
	Элементы.ПотребительскаяУпаковка.ТолькоПросмотр         = Не ПользовательРазрешилРедактированиеЕдиницыИзмерения Или Объект.Ссылка.Пустая();
	Элементы.ПотребительскаяУпаковкаЕГАИС.ТолькоПросмотр    = Не ПользовательРазрешилРедактированиеЕдиницыИзмерения;
	Элементы.УпаковкаЧастичногоВыбытия.ТолькоПросмотр       = Не ПользовательРазрешилРедактированиеЕдиницыИзмерения;
	Элементы.УпаковкаЧастичногоВыбытияЕГАИС.ТолькоПросмотр  = Не ПользовательРазрешилРедактированиеЕдиницыИзмерения;
	Элементы.ЗаполнитьУпаковкуЧастичногоВыбытия.Доступность = ПользовательРазрешилРедактированиеЕдиницыИзмерения;
	Элементы.GTIN.Видимость                                 = ИспользуетсяГИСМТ;
	Элементы.GTINВЕТИС.Видимость                            = ИспользуетсяВЕТИС И Не ИспользуетсяГИСМТ;
	Элементы.ВидАлкогольнойПродукции.Видимость              = ИспользуетсяЕГАИС;
	Элементы.Производитель.Видимость                        = ИспользуетсяЕГАИС;
	Элементы.Крепость.Видимость                             = ИспользуетсяЕГАИС;
	Элементы.GTIN.ТолькоПросмотр                            = Не ПользовательРазрешилРедактированиеЕдиницыИзмерения;
	Элементы.GTINВЕТИС.ТолькоПросмотр                       = Не ПользовательРазрешилРедактированиеЕдиницыИзмерения;
	Элементы.ОКПД2.КнопкаВыбора                             = Форма.ИспользуетсяПодсистемаГИСМТ И ПользовательРазрешилРедактированиеЕдиницыИзмерения;
	
	Элементы.СопоставленоВЕТИС.Видимость  = ИспользуетсяВЕТИС  И ЗначениеЗаполнено(Форма.СопоставленоВЕТИС);
	Элементы.СопоставленоЕГАИС.Видимость  = ИспользуетсяЕГАИС  И ЗначениеЗаполнено(Форма.СопоставленоЕГАИС);
	
	Если Форма.ТипИзмеряемойВеличины = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Вес")
		Или Форма.ТипИзмеряемойВеличины = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Объем") Тогда
		Элементы.ПотребительскаяУпаковка.ПодсказкаВвода      = НСтр("ru = 'Взвешивается'");
		Элементы.ПотребительскаяУпаковкаЕГАИС.ПодсказкаВвода = "";
	Иначе
		Элементы.ПотребительскаяУпаковка.ПодсказкаВвода      = Строка(Объект.ЕдиницаИзмерения);
		Элементы.ПотребительскаяУпаковкаЕГАИС.ПодсказкаВвода = Строка(Объект.ЕдиницаИзмерения);
	КонецЕсли;
	
	Для Каждого Суффикс Из СуффиксыВидовПродукцииСПредставлением() Цикл
		Форма.Элементы["ГруппаПродукция"+Суффикс.Значение].Видимость = ЗначениеЗаполнено(Форма["ВидПродукции"+Суффикс.Значение]);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПользовательРазрешилРедактированиеРеквизита(ИмяРеквизита = "ЕдиницаИзмерения")
	
	ЗаблокированныеРеквизиты           = ЗапретРедактированияРеквизитовОбъектовКлиент.Реквизиты(ЭтотОбъект, Истина);
	ПользовательРазрешилРедактирование = (ЗаблокированныеРеквизиты.Найти(ИмяРеквизита) = Неопределено);
	
	Возврат ПользовательРазрешилРедактирование;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьТипИзмеряемойВеличины(Форма)
	
	Если ЗначениеЗаполнено(Форма.Объект.ЕдиницаИзмерения) Тогда
		Форма.ТипИзмеряемойВеличины = ТипИзмеряемойВеличины(Форма.Объект.ЕдиницаИзмерения);
	Иначе
		Форма.ТипИзмеряемойВеличины = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТипИзмеряемойВеличины(ЕдиницаИзмерения)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаИзмерения, "ТипИзмеряемойВеличины");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ТипИзмеряемойВеличиныПриИзменении(Форма)
	
	Если Форма.ТипИзмеряемойВеличины = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Вес") Тогда
		Форма.Объект.ВесИспользовать = Истина;
		Форма.Объект.ВесКоэффициент = 1;
	ИначеЕсли Форма.ТипИзмеряемойВеличины = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Объем") Тогда
		Форма.Объект.ОбъемИспользовать = Истина;
		Форма.Объект.ОбъемКоэффициент = 1;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьСвязанныеЭлементыЕдиницыИзмерения(Форма, ЭтоИнтерактивноеИзменение = Ложь)
		
	ЭтоВес   = Форма.ТипИзмеряемойВеличины = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Вес");
	ЭтоОбъем = Форма.ТипИзмеряемойВеличины = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Объем");
	
	Форма.Элементы.ВесИспользовать.Доступность   = Не ЭтоВес;
	Форма.Элементы.ВесКоэффициент.Видимость      = Не ЭтоВес И Форма.Объект.ВесИспользовать;
	Форма.Элементы.ВесЕдиницаИзмеренияПредставление.Видимость = Не ЭтоВес И Форма.Объект.ВесИспользовать;
	Если ЭтоИнтерактивноеИзменение Тогда
		Форма.Элементы.ВесКоэффициент.ТолькоПросмотр = Ложь;
		Форма.Элементы.ОбъемКоэффициент.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	Форма.Элементы.ОбъемИспользовать.Доступность = Истина;
	Если ЭтоОбъем Или ЗначениеЗаполнено(Форма.ВидПродукцииЕГАИС) Тогда
		Форма.Элементы.ОбъемИспользовать.Доступность = Ложь;
	КонецЕсли;
	
	Если ЭтоИнтерактивноеИзменение И ЗначениеЗаполнено(Форма.ВидПродукцииЕГАИС) Тогда
		Форма.Объект.ОбъемИспользовать     = Истина;
		Форма.Объект.ОбъемЕдиницаИзмерения = ЕдиницаИзмеренияПоУмолчанию("Объем");
	КонецЕсли;
	
	Форма.Элементы.ОбъемКоэффициент.Видимость      = Не ЭтоОбъем И Форма.Объект.ОбъемИспользовать;
	Форма.Элементы.ОбъемЕдиницаИзмеренияПредставление.Видимость = Не ЭтоОбъем И Форма.Объект.ОбъемИспользовать;
	
	ОбновитьПредставлениеЕдиницыИзмерения(Форма, "Вес");
	ОбновитьПредставлениеЕдиницыИзмерения(Форма, "Объем");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПредставлениеЕдиницыИзмерения(Форма, ИмяМеры)
	
	ИмяПоля = ИмяМеры + "ЕдиницаИзмерения";
	ИмяПоляПредставления = ИмяПоля + "Представление";
	
	Если Форма.Элементы[ИмяПоляПредставления].Видимость Тогда
		Если ЗначениеЗаполнено(Форма.Объект[ИмяПоля]) Тогда 
			Форма[ИмяПоляПредставления] = Строка(Форма.Объект[ИмяПоля]);
		Иначе
			Форма[ИмяПоляПредставления] = НСтр("ru = 'выбрать'");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕдиницаИзмеренияПоУмолчанию(Мера)
	
	Результат = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
	
	Если Мера = "Вес" Тогда
		Результат = Справочники.ЕдиницыИзмерения.ЕдиницаИзмеренияПоКоду("166");
	ИначеЕсли Мера = "Объем" Тогда
		Результат = Справочники.ЕдиницыИзмерения.ЕдиницаИзмеренияПоКоду("112");
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Результат = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеGTINПотребительскойУпаковки()
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	GTIN = Неопределено;
	GTINДоИзменения = Неопределено;
	
	Элементы.GTIN.СписокВыбора.Очистить();
	
	ПараметрыДанныхУточнения = Новый Структура("ЭтоНастройкаКарточкиНоменклатуры", Истина);
	ДанныеПоискаGTIN         = Новый Массив;
	ДанныеПоискаGTIN.Добавить(Новый Структура("Номенклатура", Объект.Ссылка));
	ТаблицаGTIN = ИнтеграцияИСМП.ДанныеДляУточненияКоэффициентовУпаковок(ДанныеПоискаGTIN, Ложь, ПараметрыДанныхУточнения);
	Для Каждого СтрокаТаблицы Из ТаблицаGTIN Цикл
		
		Если (СтрокаТаблицы.ВидУпаковки = Перечисления.ВидыУпаковокИС.Потребительская
			Или Не ЗначениеЗаполнено(СтрокаТаблицы.ВидУпаковки))
			Или ЗначениеЗаполнено(ВидПродукцииВЕТИС) И Не ЗначениеЗаполнено(ВидПродукцииГИСМТ) Тогда
			GTIN            = СтрокаТаблицы.GTIN;
			GTINДоИзменения = СтрокаТаблицы.GTIN;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ВидУпаковки)
			Или СтрокаТаблицы.ВидУпаковки = Перечисления.ВидыУпаковокИС.Потребительская Тогда
			Элементы.GTIN.СписокВыбора.Добавить(СтрокаТаблицы.GTIN);
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.GTIN.КнопкаВыпадающегоСписка = (Элементы.GTIN.СписокВыбора.Количество() > 1
		Или Элементы.GTIN.СписокВыбора.Количество() > 0 И Не ЗначениеЗаполнено(GTIN));
	
КонецПроцедуры
	
&НаСервере
Процедура ЗаполнитьПоПараметрам()
	
	Объект.Наименование = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Наименование", "");
	Штрихкод            = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Штрихкод", "");
	
	Если Не ЗначениеЗаполнено(Объект.СтавкаНДС) Тогда
		Если Перечисления.СтавкиНДС.ДействуетСтавкаНДС22(ТекущаяДатаСеанса()) Тогда
			Объект.СтавкаНДС = Перечисления.СтавкиНДС.НДС22;
		Иначе
			Объект.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияЗаполнения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ЗначенияЗаполнения", Неопределено);
	Если ЗначенияЗаполнения <> Неопределено Тогда
		
		Если ЗначенияЗаполнения.Свойство("ВидыПродукцииИС")
			И ЗначениеЗаполнено(ЗначенияЗаполнения.ВидыПродукцииИС) Тогда
			
			Для Каждого ВидПродукции Из ЗначенияЗаполнения.ВидыПродукцииИС Цикл
				Если КонструкторИСОбщегоНазначенияКлиентСервер.ЭтоМаркируемаяПродукцияЕГАИС(ВидПродукции) Тогда
					ВидПродукцииЕГАИС = ВидПродукции;
				КонецЕсли;
				Если КонструкторИСОбщегоНазначенияКлиентСервер.ЭтоПродукцияИСМП(ВидПродукции, Истина) Тогда
					ВидПродукцииГИСМТ = ВидПродукции;
				ИначеЕсли КонструкторИСОбщегоНазначенияКлиентСервер.ЭтоПродукцияВЕТИС(ВидПродукции) Тогда
					ВидПродукцииВЕТИС = ВидПродукции;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		Если ЗначенияЗаполнения.Свойство("ВидПродукцииЕГАИС") Тогда
			ВидПродукцииЕГАИС = ЗначенияЗаполнения.ВидПродукцииЕГАИС;
		КонецЕсли;
		Если ЗначенияЗаполнения.Свойство("ВидПродукцииВЕТИС") Тогда
			ВидПродукцииВЕТИС = ЗначенияЗаполнения.ВидПродукцииВЕТИС;
		КонецЕсли;
		Если ЗначенияЗаполнения.Свойство("ВидПродукцииГИСМТ") Тогда
			ВидПродукцииГИСМТ = ЗначенияЗаполнения.ВидПродукцииГИСМТ;
		КонецЕсли;
		Если ЗначениеЗаполнено(ВидПродукцииВЕТИС)
			И Параметры.Свойство("ДополнительныеПараметры")
			И ТипЗнч(Параметры.ДополнительныеПараметры) = Тип("Структура")
			И Параметры.ДополнительныеПараметры.Свойство("НаименованиеВЕТИС") Тогда
				
			Объект.Наименование       = Параметры.ДополнительныеПараметры.НаименованиеВЕТИС;
			Объект.НаименованиеПолное = Параметры.ДополнительныеПараметры.НаименованиеВЕТИС;
			Объект.ЕдиницаИзмерения   = Параметры.ДополнительныеПараметры.ЕдиницаИзмеренияВЕТИС;
			
			ШтрихкодВЕТИС = Параметры.ДополнительныеПараметры.Штрихкод;
			Если ЗначениеЗаполнено(ШтрихкодВЕТИС) Тогда
				GTIN = ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.GTINПоШтрихкодуEAN(ШтрихкодВЕТИС);
			КонецЕсли;
			
			ПродукцияВЕТИССопоставление = Параметры.ДополнительныеПараметры.ПродукцияВЕТИС;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВидПродукцииЕГАИС) Тогда
			
			Объект.ОбъемИспользовать     = Истина;
			Объект.ОбъемЕдиницаИзмерения = ЕдиницаИзмеренияПоУмолчанию("Объем");
			
			Если Параметры.Свойство("ДополнительныеПараметры")
				И ТипЗнч(Параметры.ДополнительныеПараметры) = Тип("Структура")
				И Параметры.ДополнительныеПараметры.Свойство("ВидАлкогольнойПродукцииЕГАИС", Объект.ВидАлкогольнойПродукции) Тогда
				
				ПроизводительЕГАИС = Неопределено;
				Параметры.ДополнительныеПараметры.Свойство("КрепостьЕГАИС",                 Объект.Крепость);
				Параметры.ДополнительныеПараметры.Свойство("ОбъемЕГАИС",                    Объект.ОбъемДАЛ);
				Параметры.ДополнительныеПараметры.Свойство("НаименованиеНоменклатурыЕГАИС", Объект.Наименование);
				Параметры.ДополнительныеПараметры.Свойство("НаименованиеНоменклатурыЕГАИС", Объект.НаименованиеПолное);
				Параметры.ДополнительныеПараметры.Свойство("АлкогольнаяПродукцияЕГАИС",     АлкогольнаяПродукцияСопоставление);
				Параметры.ДополнительныеПараметры.Свойство("ПроизводительЕГАИС",            ПроизводительЕГАИС);
				
				Если ЗначениеЗаполнено(Объект.ОбъемДАЛ) Тогда
					Объект.ОбъемКоэффициент = Объект.ОбъемДАЛ * 10;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ПроизводительЕГАИС) Тогда
					
					РеквизитыПроизводителя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПроизводительЕГАИС, "ИНН,Контрагент");
					Объект.Производитель = РеквизитыПроизводителя.Контрагент;
					Если Не ЗначениеЗаполнено(Объект.Производитель) И ЗначениеЗаполнено(РеквизитыПроизводителя.ИНН) Тогда
						Объект.Производитель = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", РеквизитыПроизводителя.ИНН);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если ОбщегоНазначенияИСКлиентСерверПовтИсп.ПоддерживаетсяЧастичноеВыбытие(ВидПродукцииЕГАИС) Тогда
				Объект.ЕдиницаИзмерения = Объект.ОбъемЕдиницаИзмерения; // л. (Пиво в кегах)
			Иначе
				// шт. (ПивоВПотребительскихУпаковках, Алкогольная продукция)
				Объект.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.ЕдиницаИзмеренияПоКоду("796");
			КонецЕсли;
			
		КонецЕсли;
		
		ПоляКлюча = Новый Структура(СтрСоединить(КонструкторИСОбщегоНазначенияКлиентСервер.ИменаПолейКлючаВидовПродукции(), ","));
		ЗаполнитьЗначенияСвойств(ПоляКлюча, ЭтотОбъект);
		
		ЕстьПоляКлюча = Ложь;
		Для Каждого КлючИЗначение Из ПоляКлюча Цикл
			Если ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
				ЕстьПоляКлюча = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ЕстьПоляКлюча Тогда
			Возврат;
		КонецЕсли;
		
		КлючВидовПродукции = ИнтеграцияИСВызовСервера.ПолучитьКлючВидовПродукции(ПоляКлюча);
		Объект.ВидНоменклатуры = РаботаСНоменклатуройКЭДО.ВидНоменклатурыПоКлючуВидовПродукции(
			КлючВидовПродукции, Перечисления.ТипыНоменклатуры.Товар);
		
		ИнтеграцияИС.ЗаполнитьДанныеПоКлючуВидовПродукции(ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСопоставлениеСПродукциейПодсистем()
	
	//@skip-check new-font
	Штрифт = Новый Шрифт(,,,, Истина);
	
	СписокЗапросов = Новый СписокЗначений();
	
	СписокЗапросов.Добавить(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СоответствиеНоменклатурыВЕТИС.Продукция                КАК Продукция,
		|	ПРЕДСТАВЛЕНИЕ(СоответствиеНоменклатурыВЕТИС.Продукция) КАК ПродукцияПредставление
		|ИЗ
		|	РегистрСведений.СоответствиеНоменклатурыВЕТИС КАК СоответствиеНоменклатурыВЕТИС
		|ГДЕ
		|	СоответствиеНоменклатурыВЕТИС.Номенклатура = &Номенклатура
		|	И СоответствиеНоменклатурыВЕТИС.Номенклатура <> &ПустаяНоменклатура",
		"СоответствиеНоменклатурыВЕТИС");
	
	СписокЗапросов.Добавить(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция                КАК Продукция,
		|	ПРЕДСТАВЛЕНИЕ(СоответствиеНоменклатурыЕГАИС.АлкогольнаяПродукция) КАК ПродукцияПредставление
		|ИЗ
		|	РегистрСведений.СоответствиеНоменклатурыЕГАИС КАК СоответствиеНоменклатурыЕГАИС
		|ГДЕ
		|	СоответствиеНоменклатурыЕГАИС.Номенклатура = &Номенклатура
		|	И СоответствиеНоменклатурыЕГАИС.Номенклатура <> &ПустаяНоменклатура",
		"СоответствиеНоменклатурыЕГАИС");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПустаяНоменклатура", Справочники.Номенклатура.ПустаяСсылка());
	Запрос.УстановитьПараметр("Номенклатура",       Объект.Ссылка);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = ОбщегоНазначенияИС.ВыполнитьПакетЗапросов(Запрос, СписокЗапросов);
	
	СуффиксыПодсистем = Новый Массив();
	СуффиксыПодсистем.Добавить("ВЕТИС");
	СуффиксыПодсистем.Добавить("ЕГАИС");
	
	Для Каждого Суффикс Из СуффиксыПодсистем Цикл
		
		Выборка = РезультатЗапроса["СоответствиеНоменклатуры" + Суффикс].Выбрать();
		
		ИмяРеквизита = "Сопоставлено" + Суффикс;
		ИмяРеквизитаПродукция = "Продукция" + Суффикс + "Сопоставление";
		
		КоличествоЭлементов = Выборка.Количество();
		Если КоличествоЭлементов = 1 Тогда
		
			Выборка.Следующий();
			ЭтотОбъект[ИмяРеквизита] = Новый ФорматированнаяСтрока(
				Выборка.ПродукцияПредставление,
				Штрифт,
				ЦветаСтиля.ЦветГиперссылкиГосИС,,
				"КЭДООткрытьСоответствиеНоменклатуры" + Суффикс);
			
		ИначеЕсли КоличествоЭлементов > 1 Тогда
			
			Выборка.Следующий();
			ЭтотОбъект[ИмяРеквизита] = Новый ФорматированнаяСтрока(
				СтрШаблон(НСтр("ru = '%1 ( + еще %2...)'"), Выборка.ПродукцияПредставление, КоличествоЭлементов - 1),
				Штрифт,
				ЦветаСтиля.ЦветГиперссылкиГосИС,,
				"КЭДООткрытьСоответствиеНоменклатуры" + Суффикс);
			
		ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект[ИмяРеквизитаПродукция]) Тогда
			
			ЭтотОбъект[ИмяРеквизита] = Новый ФорматированнаяСтрока(
				Строка(ЭтотОбъект[ИмяРеквизитаПродукция]),,,,
				ПолучитьНавигационнуюСсылку(ЭтотОбъект[ИмяРеквизитаПродукция]));
		
		Иначе
			
			ЭтотОбъект[ИмяРеквизита] = Новый ФорматированнаяСтрока(
				НСтр("ru = '<Не сопоставлено>'"),
				Штрифт,
				ЦветаСтиля.ЦветГиперссылкиГосИС,,
				"КЭДОВыбратьСоответствиеПродукции" + Суффикс);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииТНВЭДиОКПД2()
	
	Если Не КлиентЭДОКлиентПовтИсп.ИспользуетсяГосИС() Тогда
		Возврат;
	КонецЕсли;
	
	УказанТНВЭД = ЗначениеЗаполнено(Объект.КодТНВЭД);
	УказанОКПД2 = ЗначениеЗаполнено(Объект.ОКПД2);
	
	Если УказанТНВЭД Или УказанОКПД2 Тогда
		ДоступныеВидыПродукции = ВидыПродукцииПоТНВЭДиОКПД2(Объект.КодТНВЭД, Объект.ОКПД2);
		Если ДоступныеВидыПродукции.Количество() = 1 Тогда
			Если Не ЗначениеЗаполнено(ВидПродукцииГИСМТ) Тогда
				ВидПродукцииГИСМТ = ДоступныеВидыПродукции[0];
				ИнтеграцияИСКлиент.ВидПродукцииГИСМТПриИзменении(ЭтотОбъект);
				НастроитьЭлементыФормыИС(ЭтотОбъект, Истина);
				ЗаполнитьСопоставлениеСПродукциейПодсистем();
			ИначеЕсли ДоступныеВидыПродукции[0] <> ВидПродукцииГИСМТ Тогда
				Если УказанТНВЭД И УказанОКПД2 Тогда
					НачалоВопроса = СтрШаблон(
						НСтр("ru='Указанным ТН ВЭД %1 и ОКПД2 %2'"),
						Строка(Объект.КодТНВЭД),
						Строка(Объект.ОКПД2));
				ИначеЕсли УказанТНВЭД Тогда
					НачалоВопроса = СтрШаблон(
						НСтр("ru='Указанному ТН ВЭД %1'"),
						Объект.КодТНВЭД);
				Иначе
					НачалоВопроса = СтрШаблон(
						НСтр("ru='Указанному ОКПД2 %1'"),
						Объект.ОКПД2);
				КонецЕсли;
				ДополнительныеПараметры = Новый Структура;
				ДополнительныеПараметры.Вставить("ВидПродукции", ДоступныеВидыПродукции[0]);
				ПоказатьВопрос(
					Новый ОписаниеОповещения("ВопросИзменитьВидПродукцииЗавершение",
						ЭтотОбъект,
						ДополнительныеПараметры),
					СтрШаблон(
						НСтр("ru='%1 соответствует вид продукции %2.
							|Изменить текущий вид продукции %3 на %2'"),
						НачалоВопроса,
						ДоступныеВидыПродукции[0],
						ВидПродукцииГИСМТ),
					РежимДиалогаВопрос.ДаНет);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВидыПродукцииПоТНВЭДиОКПД2(ТНВЭД, ОКПД2)
	
	ДанныеДляУточнения = ОбщегоНазначенияИСМПКлиентСервер.ДанныеДляУточненияВидовПродукцииПоТНВЭДиОКПД2();
	Если ЗначениеЗаполнено(ТНВЭД) Тогда
		ДанныеДляУточнения.ТНВЭД = ТНВЭД;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОКПД2) Тогда
		ДанныеДляУточнения.ОКПД2 = ОКПД2;
	КонецЕсли;
	
	Возврат ИнтерфейсИСМПОбщегоНазначенияВызовСервера.ВидыПродукцииПоТНВЭДиОКПД2(ДанныеДляУточнения);
	
КонецФункции

&НаКлиенте
Процедура ВопросИзменитьВидПродукцииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ВидПродукцииГИСМТ = ДополнительныеПараметры.ВидПродукции;
		ИнтеграцияИСКлиент.ВидПродукцииГИСМТПриИзменении(ЭтотОбъект);
		НастроитьЭлементыФормыИС(ЭтотОбъект, Истина);
		ЗаполнитьСопоставлениеСПродукциейПодсистем();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовкиГруппПродукцииИС(Форма)
	
	Для Каждого Суффикс Из СуффиксыВидовПродукцииСПредставлением() Цикл
		Форма.Элементы["ГруппаПродукция"+Суффикс.Значение].Заголовок = Суффикс.Представление;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СуффиксыВидовПродукцииСПредставлением()

	СуффиксыПодсистем = Новый СписокЗначений;
	
	Для Каждого Суффикс Из КонструкторИСОбщегоНазначенияКлиентСервер.СуффиксыВидовПродукцииСПредставлением() Цикл
		Если Суффикс.Значение = "САТУРН"
			Или Суффикс.Значение = "ЗЕРНО" Тогда
			Продолжить;
		КонецЕсли;
		СуффиксыПодсистем.Добавить(Суффикс.Значение, Суффикс.Представление);
	КонецЦикла;

	Возврат СуффиксыПодсистем;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьЗначениеПолейНоменклатуры()
	
	ДанныеНоменклатуры = ДанныеЗаписиНоменклатуры();
	ЗаполнитьЗначенияСвойств(ДанныеНоменклатуры, Объект);
	ДанныеНоменклатуры.АдресДанныхНастроекПараметровНоменклатурыИС = АдресДанныхНастроекПараметровНоменклатурыИС;
	
	ДанныеНастройкиНоменклатуры = ДанныеНастройкиНоменклатуры(ДанныеНоменклатуры);
	
	ПотребительскаяУпаковка      = ДанныеНастройкиНоменклатуры.ПотребительскаяУпаковка;
	УпаковкаЧастичногоВыбытия    = ДанныеНастройкиНоменклатуры.УпаковкаЧастичногоВыбытия;
	ЧастичноеВыбытиеИспользуется = ДанныеНастройкиНоменклатуры.ЧастичноеВыбытиеИспользуется;
	КлючВидовПродукции           = ДанныеНастройкиНоменклатуры.КлючВидовПродукции;
	АдресДанныхНастроекПараметровНоменклатурыИС = ДанныеНастройкиНоменклатуры.АдресДанныхНастроекПараметровНоменклатурыИС;
	
	Если Не ЗначениеЗаполнено(ПотребительскаяУпаковка)
		И Не ДанныеНастройкиНоменклатуры.МернаяЕдиница Тогда
		ПотребительскаяУпаковка = Объект.ЕдиницаИзмерения;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДанныеЗаписиНоменклатуры()
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ПотребительскаяУпаковка",      Неопределено);
	ВозвращаемоеЗначение.Вставить("УпаковкаЧастичногоВыбытия",    Неопределено);
	ВозвращаемоеЗначение.Вставить("ЕдиницаИзмерения",             Неопределено);
	ВозвращаемоеЗначение.Вставить("Ссылка",                       Неопределено);
	ВозвращаемоеЗначение.Вставить("ЧастичноеВыбытиеИспользуется", Ложь);
	ВозвращаемоеЗначение.Вставить("КлючВидовПродукции",           Неопределено);
	ВозвращаемоеЗначение.Вставить("GTIN",                         Неопределено);
	ВозвращаемоеЗначение.Вставить("GTINДоИзменения",              Неопределено);
	ВозвращаемоеЗначение.Вставить("ЗаписатьШтрихкоды",            Ложь);
	ВозвращаемоеЗначение.Вставить("АдресДанныхНастроекПараметровНоменклатурыИС", "");
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПризнакВидАлкогольнойПродукцииМаркируемый()
	
	Если ЗначениеЗаполнено(Объект.ВидАлкогольнойПродукции) Тогда
		ВидАлкогольнойПродукцииМаркируемый = ИнтеграцияИСВызовСервера.ЗначениеРеквизитаОбъекта(
			Объект.ВидАлкогольнойПродукции, "Маркируемый");
	Иначе
		ВидАлкогольнойПродукцииМаркируемый = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКлючаВидовПродукции(ПользовательРазрешилРедактированиеЕдиницыИзмерения)
	
	ИнтеграцияИС.ЗаполнитьДанныеПоКлючуВидовПродукции(ЭтотОбъект);
	
	НастроитьЭлементыФормыИС(ЭтотОбъект, ПользовательРазрешилРедактированиеЕдиницыИзмерения);
	ЗаполнитьСопоставлениеСПродукциейПодсистем();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьДанныеНастроекПараметровНоменклатурыИС(Форма)
	
	Если ЭтоАдресВременногоХранилища(Форма.АдресДанныхНастроекПараметровНоменклатурыИС) Тогда
		УдалитьИзВременногоХранилища(Форма.АдресДанныхНастроекПараметровНоменклатурыИС);
		Форма.АдресДанныхНастроекПараметровНоменклатурыИС = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаИнтеграцииСФГИСЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		КлючВидовПродукции = Результат.КлючВидовПродукции;
		ПриИзмененииКлючаВидовПродукции(ПользовательРазрешилРедактированиеРеквизита("ЕдиницаИзмерения"));
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСоответствиеПродукцииЗавершение(Значение, ДополнительныеПараметры) Экспорт
	
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбратьСоответствиеПродукцииНаСервере(Значение, ДополнительныеПараметры.Суффикс);
	
КонецПроцедуры

&НаСервере
Процедура ВыбратьСоответствиеПродукцииНаСервере(Значение, Суффикс)
	
	Если Суффикс = ИнтеграцияЕГАИСКлиентСервер.ИмяПодсистемы() Тогда
		
		ИнтеграцияИСКЭДО.ЗаписатьСоответствиеПродукцииЕГАИС(Значение, Объект.Ссылка);
		
		Если ТребуетсяЗаполнениеРеквизитовЕГАИС(ЭтотОбъект) Тогда
			
			Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
				Значение, "Крепость,Объем,ВидПродукции,Производитель.Контрагент");
			
			Если ЗначениеЗаполнено(Реквизиты.Крепость) Тогда
				Объект.Крепость = Реквизиты.Крепость;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Реквизиты.Объем) Тогда
				Объект.ОбъемКоэффициент = Реквизиты.Объем;
				Объект.ОбъемЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.ЕдиницаИзмеренияПоКоду("112");
				Объект.ОбъемДАЛ = Объект.ОбъемКоэффициент / 10;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Реквизиты.ВидПродукции) Тогда
				Объект.ВидАлкогольнойПродукции = Реквизиты.ВидПродукции;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Реквизиты.ПроизводительКонтрагент)
				И ТипЗнч(Реквизиты.ПроизводительКонтрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
				Объект.Производитель = Реквизиты.ПроизводительКонтрагент;
			КонецЕсли;
		
		КонецЕсли;
		
	ИначеЕсли Суффикс = ИнтеграцияВЕТИСКлиентСервер.ИмяПодсистемы() Тогда
		
		ИнтеграцияИСКЭДО.ЗаписатьСоответствиеПродукцииВЕТИС(Значение, Объект.Ссылка);
		
	КонецЕсли;
	
	ЗаполнитьСопоставлениеСПродукциейПодсистем();
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти