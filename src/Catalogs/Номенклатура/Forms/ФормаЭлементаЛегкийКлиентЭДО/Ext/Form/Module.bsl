	Если КлиентЭДОКлиентПовтИсп.ИспользуетсяГосИС()
		И ОбщегоНазначенияИСМПКлиентСерверПовтИсп.УчитываемыеВидыМаркируемойПродукции().Найти(ВидПродукцииГИСМТ) <> Неопределено Тогда
		
		СтандартнаяОбработка = Ложь;
			
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТекущаяСтрока",                           Объект.КодТНВЭД);
		ПараметрыФормы.Вставить("ВидПродукцииТоварнаяГруппа",              ВидПродукцииГИСМТ);
		ПараметрыФормы.Вставить("РежимВыбора",                             Истина);
		ПараметрыФормы.Вставить("ВозвращатьСсылкуНаЭлементКлассификатора", Ложь);
		
		ОткрытьФорму(
			"РегистрСведений.КодыТНВЭДИСМП.Форма.ФормаСписка",
			ПараметрыФормы,
			Элемент,,,,,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		НастройкиРежима = Новый Структура;
		НастройкиРежима.Вставить("РежимВыбораЭлемента", Истина);
		НастройкиРежима.Вставить("ОбработчикЗавершения", Новый ОписаниеОповещения("ЗаполнитьКодТНВЭДПослеВыбораИзСервиса", ЭтотОбъект));
		ОблачныеКлассификаторыКлиент.ПодобратьИзСервисаЭлементыТНВЭД(НастройкиРежима);
		
	КонецЕсли;
	
