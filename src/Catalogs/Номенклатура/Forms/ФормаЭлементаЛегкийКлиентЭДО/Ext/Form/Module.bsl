	ДобавитьИзображениеНаКлиентеЗавершение();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзображениеНаКлиентеЗавершение()
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ИдентификаторФайла = Новый УникальныйИдентификатор;
		Фильтр = КлиентЭДОКлиент.ФильтрФайловИзображений();
		РаботаСФайламиКлиент.ДобавитьФайлы(Объект.Ссылка, ИдентификаторФайла, Фильтр);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НавигационнаяСсылкаКартинки(ФайлКартинки, ИдентификаторФормы)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыДанныхФайла = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПараметрыДанныхФайла.ИдентификаторФормы = ИдентификаторФормы;
	ПараметрыДанныхФайла.ВызыватьИсключение = Ложь;
	
	ДанныеФайла = РаботаСФайлами.ДанныеФайла(ФайлКартинки, ПараметрыДанныхФайла);
	Если ДанныеФайла <> Неопределено Тогда
		АдресКартинки = ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;
	Иначе
		АдресКартинки = "";
	КонецЕсли;
	
	Возврат АдресКартинки;
	
КонецФункции

&НаСервере
Процедура ОбновитьЭлементыХарактеристикиНоменклатуры()
	
	ИспользоватьХарактеристики =
	    ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ВидНоменклатуры, "ИспользоватьХарактеристики");
	
	Элементы.ГруппаХарактеристикиНоменклатуры.Видимость = Истина;
	Если Объект.ВидНоменклатуры.Пустая() ИЛИ ИспользоватьХарактеристики <> Истина Тогда
	    Элементы.ГруппаХарактеристикиНоменклатуры.Видимость = Ложь;
	    Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	
	ИндивидуальныеХарактеристикиНоменклатуры =
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ВидНоменклатуры, "ИндивидуальныеХарактеристикиНоменклатуры");
		
	Если ИндивидуальныеХарактеристикиНоменклатуры Тогда 
		ИспользованиеХарактеристик = НСтр("ru = 'Индивидуальные для номенклатуры'");
		ВладелецХарактеристик      = Объект.Ссылка;
	Иначе
		ИспользованиеХарактеристик = НСтр("ru = 'Общие для вида номенклатуры'");
		ВладелецХарактеристик      = Объект.ВидНоменклатуры;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВладелецХарактеристик", ВладелецХарактеристик);
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(*) КАК КоличествоХарактеристик
	               |ИЗ
	               |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	               |ГДЕ
	               |	ХарактеристикиНоменклатуры.Владелец = &ВладелецХарактеристик";
	
	ЗаголовокГиперссылки = НСтр("ru = 'Список (%1)'");
	Элементы.ГиперссылкаПерейтиХарактеристикиНоменклатуры.Заголовок = СтрШаблон(ЗаголовокГиперссылки,
		Запрос.Выполнить().Выгрузить()[0].КоличествоХарактеристик);
		
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыУпаковкиНоменклатуры()
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаголовокГиперссылки = НСтр("ru = 'Список (%1)'");
	Элементы.ГиперссылкаПерейтиУпаковкиНоменклатуры.Заголовок = СтрШаблон(ЗаголовокГиперссылки,
		Справочники.ЕдиницыИзмерения.КоличествоУпаковокНоменклатуры(Объект.Ссылка));
		
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыПереходаПоГиперссылке(ИмяЭлемента, Гиперссылка = "")
	
	Если ИмяЭлемента = "ГиперссылкаПерейтиХарактеристикиНоменклатуры" Тогда
		
		Если ИндивидуальныеХарактеристикиНоменклатуры Тогда 
			ВладелецХарактеристик = Объект.Ссылка;
		Иначе
			ВладелецХарактеристик = Объект.ВидНоменклатуры;
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Владелец", ВладелецХарактеристик);
		ПараметрыФормы = Новый Структура("Отбор", Отбор);
		
		ПараметрыПереходаПоГиперссылке = Новый Структура;
		ПараметрыПереходаПоГиперссылке.Вставить("ИмяФормы", "Справочник.ХарактеристикиНоменклатуры.ФормаСписка");
		ПараметрыПереходаПоГиперссылке.Вставить("ПараметрыФормы", ПараметрыФормы);
		
	ИначеЕсли ИмяЭлемента = "ГиперссылкаПерейтиУпаковкиНоменклатуры" Тогда
		
		ВладелецУпаковок = Объект.Ссылка;
		
		ПараметрыФормы = Новый Структура(
			"НоменклатураВладелец, ОтображатьБазовуюЕдиницуВСпискеУпаковок",
			ВладелецУпаковок, Ложь);
		
		ПараметрыПереходаПоГиперссылке = Новый Структура;
		ПараметрыПереходаПоГиперссылке.Вставить("ИмяФормы", "Справочник.ЕдиницыИзмерения.ФормаСписка");
		ПараметрыПереходаПоГиперссылке.Вставить("ПараметрыФормы", ПараметрыФормы);
		ПараметрыПереходаПоГиперссылке.Вставить("РежимОткрытияОкнаФормы",
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ПараметрыПереходаПоГиперссылке.Вставить("Оповещение",
			Новый ОписаниеОповещения("РедактированиеУпаковокЗавершение", ЭтотОбъект));
	
	ИначеЕсли ИмяЭлемента = "ВидыПродукцииФГИС" Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("КлючВидовПродукции", КлючВидовПродукции);
		ПараметрыФормы.Вставить("ТолькоПросмотр",
			Не ПользовательРазрешилРедактированиеРеквизита("КлючВидовПродукции"));
		
		ПараметрыПереходаПоГиперссылке = Новый Структура;
		ПараметрыПереходаПоГиперссылке.Вставить("ИмяФормы", "ОбщаяФорма.НастройкаИнтеграцииИС");
		ПараметрыПереходаПоГиперссылке.Вставить("ПараметрыФормы", ПараметрыФормы);
		ПараметрыПереходаПоГиперссылке.Вставить("РежимОткрытияОкнаФормы",
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ПараметрыПереходаПоГиперссылке.Вставить("Оповещение",
			Новый ОписаниеОповещения("НастройкаИнтеграцииСФГИСЗавершение", ЭтотОбъект));
	
	ИначеЕсли СтрНачинаетсяС(ИмяЭлемента, "КЭДООткрытьСоответствиеНоменклатуры") Тогда
		
		СтруктураОтбора      = Новый Структура("Номенклатура", Объект.Ссылка);
		ПараметрыФормы       = Новый Структура;
		ПараметрыФормы.Вставить("Отбор", СтруктураОтбора);
		
		Суффикс               = СтрЗаменить(ИмяЭлемента, "КЭДООткрытьСоответствиеНоменклатуры", "");
		ИмяФормыСопоставления = "РегистрСведений.СоответствиеНоменклатуры" + Суффикс + ".Форма.ФормаСписка";
		
		ПараметрыПереходаПоГиперссылке = Новый Структура;
		ПараметрыПереходаПоГиперссылке.Вставить("ИмяФормы",               ИмяФормыСопоставления);
		ПараметрыПереходаПоГиперссылке.Вставить("ПараметрыФормы",         ПараметрыФормы);
		ПараметрыПереходаПоГиперссылке.Вставить("РежимОткрытияОкнаФормы", РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли СтрНачинаетсяС(ИмяЭлемента, "КЭДОВыбратьСоответствиеПродукции") Тогда
		
		Суффикс = СтрЗаменить(ИмяЭлемента, "КЭДОВыбратьСоответствиеПродукции", "");
		
		Если Суффикс = ИнтеграцияЕГАИСКлиентСервер.ИмяПодсистемы() Тогда
			ИмяФормыСопоставления = "Справочник.КлассификаторАлкогольнойПродукцииЕГАИС.Форма.ФормаВыбора";
		ИначеЕсли Суффикс = ИнтеграцияВЕТИСКлиентСервер.ИмяПодсистемы() Тогда
			ИмяФормыСопоставления = "Справочник.ПродукцияВЕТИС.Форма.ФормаВыбора";
		КонецЕсли;
		
		ПараметрыОповещения = Новый Структура();
		ПараметрыОповещения.Вставить("Суффикс", Суффикс);
		
		ОповещениеСопоставления = Новый ОписаниеОповещения(
			"ВыбратьСоответствиеПродукцииЗавершение",
			ЭтотОбъект,
			ПараметрыОповещения);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыПереходаПоГиперссылке = Новый Структура;
		ПараметрыПереходаПоГиперссылке.Вставить("ИмяФормы",               ИмяФормыСопоставления);
		ПараметрыПереходаПоГиперссылке.Вставить("ПараметрыФормы",         ПараметрыФормы);
		ПараметрыПереходаПоГиперссылке.Вставить("Оповещение",             ОповещениеСопоставления);
		ПараметрыПереходаПоГиперссылке.Вставить("РежимОткрытияОкнаФормы", РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
	Если Не ПараметрыПереходаПоГиперссылке.Свойство("РежимОткрытияОкнаФормы") Тогда
		ПараметрыПереходаПоГиперссылке.Вставить("РежимОткрытияОкнаФормы", РежимОткрытияОкнаФормы.Независимый);
	КонецЕсли;
	
	Если Не ПараметрыПереходаПоГиперссылке.Свойство("Оповещение") Тогда
		ПараметрыПереходаПоГиперссылке.Вставить("Оповещение");
	КонецЕсли;
	
	ПараметрыПереходаПоГиперссылке.Вставить("ИмяЭлемента", ИмяЭлемента);
	ПараметрыПереходаПоГиперссылке.Вставить("Гиперссылка", Гиперссылка);
	
	Возврат ПараметрыПереходаПоГиперссылке;
	
КонецФункции

&НаКлиенте
Процедура РедактированиеУпаковокЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ОбновитьЭлементыУпаковкиНоменклатуры();
	
КонецПроцедуры

&НаКлиенте
Процедура ГиперссылкаПерейтиСформироватьПараметрыИВопрос(ПараметрыПереходаПоГиперссылке)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ТекстВопроса = Нстр("ru = 'Данные еще не записаны.
		|Переход к дополнительной информации возможен только после записи элемента.
		|Записать элемент?'");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ГиперссылкаПерейтиВопросЗавершение", ЭтотОбъект, ПараметрыПереходаПоГиперссылке), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;
	
	ГиперссылкаПерейти(ПараметрыПереходаПоГиперссылке);
КонецПроцедуры

&НаКлиенте
Процедура ГиперссылкаПерейтиВопросЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЭлементЗаписан = Записать();
	Исключение
		Возврат;
	КонецПопытки;
	
	Если Не ЭлементЗаписан Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПереходаПоГиперссылке = ПараметрыПереходаПоГиперссылке(ДополнительныеПараметры.ИмяЭлемента,
																		ДополнительныеПараметры.Гиперссылка);
	ГиперссылкаПерейти(ПараметрыПереходаПоГиперссылке);
КонецПроцедуры

&НаКлиенте
Процедура ГиперссылкаПерейти(ПараметрыПереходаПоГиперссылке)
	
	Если ПараметрыПереходаПоГиперссылке.Свойство("ИмяФормы") Тогда
		Если ПараметрыПереходаПоГиперссылке.ИмяФормы = "Справочник.Номенклатура.Форма.ФормаСписка" Тогда
			Оповестить("ФильтрПоАналогичнымСвойствам_Номенклатура", Объект.Ссылка, Объект.Ссылка);
		КонецЕсли;
		
		ОткрытьФорму(ПараметрыПереходаПоГиперссылке.ИмяФормы,
			ПараметрыПереходаПоГиперссылке.ПараметрыФормы, , УникальныйИдентификатор,,,
			ПараметрыПереходаПоГиперссылке.Оповещение,
			ПараметрыПереходаПоГиперссылке.РежимОткрытияОкнаФормы);
	ИначеЕсли ПараметрыПереходаПоГиперссылке.Свойство("НавигационнаяСсылка") Тогда
		ПерейтиПоНавигационнойСсылке(ПараметрыПереходаПоГиперссылке.НавигационнаяСсылка);
	Иначе
		ТекстИсключения = НСтр("ru = 'Не определено действие по гиперссылке.'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
КонецПроцедуры

