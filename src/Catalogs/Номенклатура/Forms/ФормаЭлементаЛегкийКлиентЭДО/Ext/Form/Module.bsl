#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Объект.Ссылка.Пустая() Тогда
		ПриСозданииЧтенииНаСервере();
		ЗаполнитьПоПараметрам();
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	// ЭлектронноеВзаимодействие.ТорговыеПредложения
	ТорговыеПредложения.ПриСозданииПодсказокФормы(ЭтотОбъект, Элементы.ПодсказкиБизнесСеть);
	// Конец ЭлектронноеВзаимодействие.ТорговыеПредложения
	
	Если КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		Элементы.Родитель.Видимость = Ложь;
	Иначе
		// ЭлектронноеВзаимодействие.РаботаСНоменклатурой
		РаботаСНоменклатурой.ПриСозданииНаСервереФормаНоменклатуры(ЭтотОбъект, Объект.Ссылка, Элементы.ГруппаРаботаСНоменклатурой);
		// Конец ЭлектронноеВзаимодействие.РаботаСНоменклатурой
	КонецЕсли;
	
	// ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	СопоставлениеНоменклатурыКонтрагентов.ПриСозданииФормыНоменклатуры(ЭтотОбъект);
	// Конец ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	
	// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	
	КоличествоДополнительныхХарактеристик = ПолучитьКоличествоДополнительныхХарактеристик(ЭтотОбъект);
	
	// _Демо начало примера
	ГруппаСрокГодности = Элементы.Вставить("ГруппаСрокГодности", Тип("ГруппаФормы"), Элементы.ГруппаРеквизиты, Элементы.ГруппаХарактеристикиНоменклатуры);
	ГруппаСрокГодности.Вид                 = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСрокГодности.Отображение         = ОтображениеОбычнойГруппы.Нет;
	ГруппаСрокГодности.Группировка         = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	ГруппаСрокГодности.ОтображатьЗаголовок = Ложь;
	СрокГодности = Элементы.Добавить("СрокГодности", Тип("ПолеФормы"), ГруппаСрокГодности);
	СрокГодности.ПутьКДанным = "Объект._ДемоСрокГодности";
	СрокГодности.Вид         = ВидПоляФормы.ПолеВвода;
	СрокГодностиЕдиницаИзмерения = Элементы.Добавить("СрокГодностиЕдиницаИзмерения", Тип("ДекорацияФормы"), ГруппаСрокГодности);
	СрокГодностиЕдиницаИзмерения.Вид       = ВидДекорацииФормы.Надпись;
	СрокГодностиЕдиницаИзмерения.Заголовок = НСтр("ru = 'суток'");
	
	МаркетплейсЗаполнитьИзПараметров();
	// _Демо конец примера
	
	СобытияФормИС.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка, Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	ПриСозданииЧтенииНаСервере();
	
	СобытияФормИС.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// ЭлектронноеВзаимодействие.ТорговыеПредложения
	ТорговыеПредложенияКлиент.ОбновитьПодсказкуФормы(ЭтотОбъект);
	// Конец ЭлектронноеВзаимодействие.ТорговыеПредложения
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_Файл" И Параметр.Свойство("ВладелецФайла")
		И Параметр.ВладелецФайла = Объект.Ссылка Тогда
		
		Модифицированность = Истина;
		
		СсылкаНаФайл = ?(ТипЗнч(Источник) = Тип("Массив"), Источник[0], Источник);
		Объект.ФайлКартинки = СсылкаНаФайл;
		АдресКартинки = НавигационнаяСсылкаКартинки(Объект.ФайлКартинки, УникальныйИдентификатор);
		
	ИначеЕсли ИмяСобытия = "Запись_ХарактеристикиНоменклатуры"  
		И Параметр.Свойство("НоваяХарактеристика") И Параметр.НоваяХарактеристика
		И Параметр.Свойство("Владелец")
		И (Параметр.Владелец = Объект.ВидНоменклатуры ИЛИ Параметр.Владелец = Объект.Ссылка) Тогда
		
		ОбновитьЭлементыХарактеристикиНоменклатуры();
		
	ИначеЕсли ИмяСобытия = "Запись_РегистрСведенийШтрихкоды"
		И Параметр = Объект.Ссылка
		И КлиентЭДОКлиентПовтИсп.ИспользуетсяГосИС() Тогда
		
		ЗаполнитьДанныеGTINПотребительскойУпаковки();
	
	ИначеЕсли (ИмяСобытия = "Запись_СоответствиеНоменклатурыВЕТИС" Или ИмяСобытия = "Запись_СоответствиеНоменклатурыЕГАИС")
		И (Параметр = Объект.Ссылка Или Не ЗначениеЗаполнено(Параметр))
		И КлиентЭДОКлиентПовтИсп.ИспользуетсяГосИС() Тогда
		
		ЗаполнитьСопоставлениеСПродукциейПодсистем();
		НастроитьЭлементыФормыИС(ЭтотОбъект, ПользовательРазрешилРедактированиеРеквизита("ЕдиницаИзмерения"));
		
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	Если Не КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		// ЭлектронноеВзаимодействие.РаботаСНоменклатурой
		Если ИмяСобытия = РаботаСНоменклатуройКлиент.ОписаниеОповещенийПодсистемы().ЗагрузкаНоменклатуры
			ИЛИ ИмяСобытия = РаботаСНоменклатуройКлиент.ОписаниеОповещенийПодсистемы().СопоставлениеНоменклатуры Тогда
			
			ПриСозданииЧтенииНаСервере();
		КонецЕсли;
		// Конец ЭлектронноеВзаимодействие.РаботаСНоменклатурой	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
	Если Не КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		Возврат;
	КонецЕсли;
	
	ТекстШаблона = НСтр("ru = 'Не заполнено поле ""%1""'");
	
	ИспользуетсяЕГАИС = ЗначениеЗаполнено(ВидПродукцииЕГАИС);
	
	РеквизитыПроверкиЗаполнения = Новый Соответствие();
	РеквизитыПроверкиЗаполнения.Вставить("ВидАлкогольнойПродукции", ИспользуетсяЕГАИС);
	РеквизитыПроверкиЗаполнения.Вставить("Производитель",           ИспользуетсяЕГАИС);
	РеквизитыПроверкиЗаполнения.Вставить("Крепость",                ИспользуетсяЕГАИС);
	РеквизитыПроверкиЗаполнения.Вставить("ОбъемДАЛ",                ИспользуетсяЕГАИС);
	
	Для Каждого КлючИЗначение Из РеквизитыПроверкиЗаполнения Цикл
		Если КлючИЗначение.Значение
			И Не ЗначениеЗаполнено(Объект[КлючИЗначение.Ключ]) Тогда
			
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(
					ТекстШаблона,
					Метаданные.Справочники.Номенклатура.Реквизиты[КлючИЗначение.Ключ].Синоним),,
				"Объект." + КлючИЗначение.Ключ, , Отказ);
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(GTIN)
		И Не МенеджерОборудованияКлиентСервер.ПроверитьКорректностьGTIN(GTIN) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Ошибка проверки контрольного символа'"),,
			"GTIN",, Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПотребительскаяУпаковка)
		И ЗначениеЗаполнено(УпаковкаЧастичногоВыбытия)
		И Справочники.ЕдиницыИзмерения.МерныеТипыЕдиницИзмерений().Найти(ТипИзмеряемойВеличины) <> Неопределено Тогда
		
		Если ЗначениеЗаполнено(ВидПродукцииГИСМТ) Тогда
			ИмяПоляПотребительскаяУпаковка = "ПотребительскаяУпаковка";
		Иначе
			ИмяПоляПотребительскаяУпаковка = "ПотребительскаяУпаковкаЕГАИС";
		КонецЕсли;
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Для мертных единиц измерения при частичном выбытии необходимо заполнить потребительскую упаковку'"),,
			ИмяПоляПотребительскаяУпаковка,, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	УстановитьШтрихкод(ТекущийОбъект);
	
	// _Демо начало примера
	МаркетплейсПередЗаписьюНаСервере(ТекущийОбъект);
	// _Демо конец примера
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Не КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		// ЭлектронноеВзаимодействие.РаботаСНоменклатурой
		РаботаСНоменклатурой.ПриЗаписиНаСервереФормаНоменклатуры(ЭтотОбъект, ТекущийОбъект, Отказ);
		// Конец ЭлектронноеВзаимодействие.РаботаСНоменклатурой
	КонецЕсли;
	
	ДанныеЗаписиНоменклатуры = ДанныеЗаписиНоменклатуры();
	ЗаполнитьЗначенияСвойств(ДанныеЗаписиНоменклатуры, ТекущийОбъект);
	ЗаполнитьЗначенияСвойств(ДанныеЗаписиНоменклатуры, ЭтотОбъект,, "GTIN,GTINДоИзменения");
	Если (GTIN <> GTINДоИзменения) Тогда
		ДанныеЗаписиНоменклатуры.GTIN            = GTIN;
		ДанныеЗаписиНоменклатуры.GTINДоИзменения = GTINДоИзменения;
	КонецЕсли;
	Если ЗначениеЗаполнено(GTIN) Тогда
		ШтрихкодыEAN = Новый Массив;
		ШтрихкодыEAN.Добавить(GTIN);
		ДанныеПоШтрихкодамРезультат = ШтрихкодированиеОбщегоНазначенияИС.ДанныеПоШтрихкодамEAN(ШтрихкодыEAN);
		Если ДанныеПоШтрихкодамРезультат.ДанныеПоШтрихкодамEAN.Количество() = 0 Тогда
			ДанныеЗаписиНоменклатуры.ЗаписатьШтрихкоды = Истина;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДанныеЗаписиНоменклатуры.ПотребительскаяУпаковка)
		И Не Справочники.ЕдиницыИзмерения.ЭтоМернаяЕдиница(ТекущийОбъект.ЕдиницаИзмерения) Тогда
		ДанныеЗаписиНоменклатуры.ПотребительскаяУпаковка = ТекущийОбъект.ЕдиницаИзмерения;
	КонецЕсли;
	ДанныеЗаписиНоменклатуры.АдресДанныхНастроекПараметровНоменклатурыИС = АдресДанныхНастроекПараметровНоменклатурыИС;
	
	ЗаписатьДанныеНоменклатуры(ДанныеЗаписиНоменклатуры, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если Не КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		// ЭлектронноеВзаимодействие.РаботаСНоменклатурой
		РаботаСНоменклатуройКлиент.ПослеЗаписиФормаНоменклатуры(ЭтотОбъект);
		// Конец ЭлектронноеВзаимодействие.РаботаСНоменклатурой
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если КлиентЭДОКлиентПовтИсп.ИспользуетсяГосИС() Тогда
		ОчиститьДанныеНастроекПараметровНоменклатурыИС(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	
	Если КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		
		ОчиститьДанныеНастроекПараметровНоменклатурыИС(ЭтотОбъект);
		ЗаполнитьДанныеGTINПотребительскойУпаковки();
		ЗаполнитьЗначениеПолейНоменклатуры();
		ИнтеграцияИС.ЗаполнитьДанныеПоКлючуВидовПродукции(ЭтотОбъект);
		НастроитьЭлементыФормыИС(ЭтотОбъект);
		ЗаполнитьСопоставлениеСПродукциейПодсистем();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СобытияФормИСКлиент.ОбработкаНавигационнойСсылки(ЭтотОбъект, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
	
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "ОткрытьСоответствиеНоменклатурыАлкогольнойПродукции" Тогда
		
		СтандартнаяОбработка = Ложь;
		ПараметрыПереходаПоГиперссылке = ПараметрыПереходаПоГиперссылке(НавигационнаяСсылкаФорматированнойСтроки);
		ГиперссылкаПерейтиСформироватьПараметрыИВопрос(ПараметрыПереходаПоГиперссылке);
		
	ИначеЕсли СтрНачинаетсяС(НавигационнаяСсылкаФорматированнойСтроки, "КЭДООткрытьСоответствиеНоменклатуры")
		Или СтрНачинаетсяС(НавигационнаяСсылкаФорматированнойСтроки, "КЭДОВыбратьСоответствиеПродукции")
		Или НавигационнаяСсылкаФорматированнойСтроки = "ВидыПродукцииФГИС" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыПереходаПоГиперссылке = ПараметрыПереходаПоГиперссылке(НавигационнаяСсылкаФорматированнойСтроки);
