&НаСервере
Процедура ПриСозданииЧтенииНаСервере()
	
	Если Не КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		// ЭлектронноеВзаимодействие.РаботаСНоменклатурой
		РаботаСНоменклатурой.ПерезаполнитьВстроенныеРеквизиты(ЭтотОбъект);
		// Конец ЭлектронноеВзаимодействие.РаботаСНоменклатурой
	КонецЕсли;
	
	ЗаполнитьТипНоменклатуры();
	ЗаполнитьТипИзмеряемойВеличины(ЭтотОбъект);
	ЗаполнитьЗначениеПолейНоменклатуры();
	УстановитьЗаголовкиГруппПродукцииИС(ЭтотОбъект);
	ИнтеграцияИС.ИнициализироватьНастройкиФормыДляУстановкиКлючаВидовПродукции(ЭтотОбъект);
	ИнтеграцияИС.ЗаполнитьДанныеПоКлючуВидовПродукции(ЭтотОбъект);
	
	Если ЗначениеЗаполнено(Объект.ФайлКартинки) Тогда
		АдресКартинки = НавигационнаяСсылкаКартинки(Объект.ФайлКартинки, УникальныйИдентификатор);
	КонецЕсли;
	
	ФормироватьНаименованиеПолноеАвтоматически = ПустаяСтрока(Объект.НаименованиеПолное)
		Или Объект.НаименованиеПолное = Объект.Наименование;
	
	ОбновитьЭлементыХарактеристикиНоменклатуры();
	ОбновитьЭлементыУпаковкиНоменклатуры();
	ЗаполнитьДанныеGTINПотребительскойУпаковки();
	ЗаполнитьПризнакВидАлкогольнойПродукцииМаркируемый();
	ОбновитьСвязанныеЭлементыЕдиницыИзмерения(ЭтотОбъект);
	ЗаполнитьСопоставлениеСПродукциейПодсистем();
	НастроитьЭлементыФормыИС(ЭтотОбъект, Объект.Ссылка.Пустая());
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзображениеНаКлиенте()
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТекстВопроса = НСтр("ru='Для выбора изображения необходимо записать объект. Записать?'");
		Оповещение = Новый ОписаниеОповещения("ДобавитьИзображениеНаКлиентеПослеВопроса", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ДобавитьИзображениеНаКлиентеЗавершение();
	КонецЕсли;
	
КонецПроцедуры

