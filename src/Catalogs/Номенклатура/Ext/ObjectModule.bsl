#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		
		Если ЭтоГруппа Тогда
			Возврат;
		КонецЕсли;
		
		ТипИзмеряемойВеличины = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаИзмерения, "ТипИзмеряемойВеличины");
		Если ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Вес Тогда
			ВесЕдиницаИзмерения = ЕдиницаИзмерения;
			ВесКоэффициент = 1;
		ИначеЕсли ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Объем Тогда
			ОбъемЕдиницаИзмерения = ЕдиницаИзмерения;
			ОбъемКоэффициент = 1;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьШтрихкод();
	// _Демо начало примера
	ЗаписатьКодМагазина();
	// _Демо конец примера
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидНоменклатуры, "ТипНоменклатуры");
	ТипыНоменклатурыБезПроверки = КлиентЭДО.ТипыНоменклатурыБезПроверкиКоличестваИЕдиницыИзмерения();
	Если ТипыНоменклатурыБезПроверки.Найти(ТипНоменклатуры) <> Неопределено Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ЕдиницаИзмерения");
	КонецЕсли;
	
	Если КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		Если Не ВесИспользовать Тогда
			МассивНепроверяемыхРеквизитов.Добавить("ВесКоэффициент");
		КонецЕсли;
		Если Не ОбъемИспользовать Тогда
			МассивНепроверяемыхРеквизитов.Добавить("ОбъемКоэффициент");
		КонецЕсли;
		МассивНепроверяемыхРеквизитов.Добавить("ВидАлкогольнойПродукции");
		МассивНепроверяемыхРеквизитов.Добавить("Производитель");
		МассивНепроверяемыхРеквизитов.Добавить("Крепость");
		МассивНепроверяемыхРеквизитов.Добавить("ОбъемДАЛ");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МассивНепроверяемыхРеквизитов) Тогда
		ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьШтрихкод()
	Перем Штрихкод;
	
	Если Не ДополнительныеСвойства.Свойство("Штрихкод", Штрихкод) Или ПустаяСтрока(Штрихкод) Тогда
		Возврат;
	КонецЕсли;
	
	Штрихкод = СокрЛП(Штрихкод);
	
	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	
	Попытка
		
		БлокировкаДанных = Новый БлокировкаДанных;
		
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.Штрихкоды");
		ЭлементБлокировки.УстановитьЗначение("Штрихкод"         , Штрихкод);
		ЭлементБлокировки.УстановитьЗначение("Номенклатура"     , Ссылка);
		ЭлементБлокировки.УстановитьЗначение("Характеристика"   , Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
		ЭлементБлокировки.УстановитьЗначение("ЕдиницаИзмерения" , ЕдиницаИзмерения);
		
		БлокировкаДанных.Заблокировать();
		
		МенеджерЗаписи                  = РегистрыСведений.Штрихкоды.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Штрихкод         = Штрихкод;
		МенеджерЗаписи.Номенклатура     = Ссылка;
		МенеджерЗаписи.ЕдиницаИзмерения = ЕдиницаИзмерения;
		МенеджерЗаписи.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ВызватьИсключение(НСтр("ru = 'Не удалось записать штрихкод номенклатуры'"));
		
	КонецПопытки;
	
КонецПроцедуры

// _Демо начало примера

Процедура ЗаписатьКодМагазина()
	
	КодМагазина = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеСвойства, "КодМагазина", "");
	Маркетплейс = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеСвойства, "Маркетплейс",
		Перечисления._ДемоВидыМаркетплейсов.ПустаяСсылка());
	
	РегистрыСведений._ДемоНоменклатураМаркетплейсов.ЗаписатьИдентификаторМаркетплейса(Ссылка, Маркетплейс, КодМагазина);
	
КонецПроцедуры

// _Демо конец примера

#КонецОбласти

#Иначе
	
	ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
	
#КонецЕсли