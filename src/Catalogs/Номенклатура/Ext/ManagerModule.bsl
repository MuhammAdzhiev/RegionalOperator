#Область ПрограммныйИнтерфейс

// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов

// См. ЗапретРедактированияРеквизитовОбъектовПереопределяемый.ПриОпределенииОбъектовСЗаблокированнымиРеквизитами.
Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	
	Результат.Добавить("ЕдиницаИзмерения");
	Результат.Добавить("СтавкаНДС");
	Результат.Добавить("ВидНоменклатуры");
	
	Если КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		Результат.Добавить("ВидАлкогольнойПродукции");
		Результат.Добавить("ВесИспользовать");
		Результат.Добавить("ОбъемИспользовать");
		Результат.Добавить("ОбъемДАЛ");
		Результат.Добавить("ВесКоэффициент");
		Результат.Добавить("ОбъемКоэффициент");
		Результат.Добавить("ИспользоватьМаркировку");
		Результат.Добавить("ИспользоватьВетИС");
		Результат.Добавить("ИспользоватьЕГАИС");
		Результат.Добавить("Производитель");
		Результат.Добавить("Крепость");
		Результат.Добавить("GTIN");
		Результат.Добавить("ПризнакПредметаРасчета");
		Результат.Добавить("КодТНВЭД");
		Результат.Добавить("ОКПД2");
		Реквизит = ЗапретРедактированияРеквизитовОбъектов.НовыйБлокируемыйРеквизит();
		Реквизит.Имя = "ВидыПродукцииФГИС";
		Реквизит.ЭлементыФормы.Добавить("ВидПродукцииГИСМТ");
		Реквизит.ЭлементыФормы.Добавить("ФлагФГИС");
		Реквизит.ЭлементыФормы.Добавить("ВидПродукцииФГИС");
		Реквизит.ЭлементыФормы.Добавить("ВидыПродукцииФГИС");
		Реквизит.ПредставлениеГруппы = НСтр("ru = 'Интеграция с ФГИС'");
		Результат.Добавить(Реквизит);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ОбновлениеВерсииИБ

// Регистрирует данные для обработчика обновления
// 
// Параметры:
//  Параметры - Структура - параметры.
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	
	Данные = ДанныеКОбработке_ЗаполнитьСтавкуНДС20();
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные, ДополнительныеПараметры);
	
КонецПроцедуры

// Обработчик обновления.
// 
// Параметры:
//  Параметры - Структура - параметры.
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	МетаданныеОбъекта = Метаданные.Справочники.Номенклатура;
	ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
	ПараметрыОтметкиВыполнения = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ОбработанныхОбъектов = 0;
	ПроблемныхОбъектов = 0;
	
	ПараметрыВыборки = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта, ПараметрыВыборки);
	Если Параметры.ПрогрессВыполнения.ВсегоОбъектов = 0 Тогда
		Параметры.ПрогрессВыполнения.ВсегоОбъектов = Выборка.Количество();
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		СсылкаНаОбъект = Выборка.Ссылка;
		
		НачатьТранзакцию();
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.УстановитьЗначение("Ссылка", СсылкаНаОбъект);
			Блокировка.Заблокировать();
			
			Записать = Ложь;
			
			Объект = СсылкаНаОбъект.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				ОбработатьДанные_ЗаполнитьСтавкуНДС20(Объект, Записать);
			КонецЕсли;
			
			Если Записать Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(СсылкаНаОбъект, ПараметрыОтметкиВыполнения);
			КонецЕсли;
			
			ОбработанныхОбъектов = ОбработанныхОбъектов + 1;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			ШаблонСообщения = НСтр("ru = 'Не удалось обработать номенклатуру: %1 по причине:'");
			ТекстСообщения = СтрШаблон(ШаблонСообщения, СсылкаНаОбъект) + Символы.ПС + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Предупреждение,
				МетаданныеОбъекта, СсылкаНаОбъект, ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Если ОбработанныхОбъектов = 0 И ПроблемныхОбъектов <> 0 Тогда
		ШаблонСообщения = НСтр("ru = 'Не удалось обработать некоторую номенклатуру (пропущены): %1'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ПроблемныхОбъектов);
		ВызватьИсключение ТекстСообщения;
	Иначе
		ШаблонСообщения = НСтр("ru = 'Обработана очередная порция номенклатуры: %1'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ОбработанныхОбъектов);
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Информация,
			МетаданныеОбъекта,, ТекстСообщения);
	КонецЕсли;
	
	Параметры.ПрогрессВыполнения.ОбработаноОбъектов  = Параметры.ПрогрессВыполнения.ОбработаноОбъектов  + ОбработанныхОбъектов;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(
		Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ОбновлениеВерсииИБ

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	ИскатьВСервисе = (Параметры.Отбор.Свойство("ИскатьВСервисе")
		И КлиентЭДОПовтИсп.Сервис1СНоменклатураДоступен());
	УстановитьОтборПоВидуПродукции = (Параметры.Отбор.Свойство("ВидПродукцииИС")
		И КлиентЭДОВызовСервера.ИспользуетсяГосИС());
	
	Если Не ИскатьВСервисе И Не УстановитьОтборПоВидуПродукции Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеВыбора = Новый СписокЗначений;
	
	УникальныеЗначения = Новый Соответствие;
	
	ДополнитьДаннымиИзСправочника(ДанныеВыбора, Параметры.СтрокаПоиска, Параметры.Отбор, УникальныеЗначения);
	
	Если ИскатьВСервисе Тогда
		ДополнитьДаннымиИзСервиса(ДанныеВыбора, Параметры.СтрокаПоиска, УникальныеЗначения);
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  ВидФормы - Строка
//  Параметры - Структура
//  ВыбраннаяФорма - Строка
//  ДополнительнаяИнформация - Структура
//  СтандартнаяОбработка - Булево
Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если Не НастройкиКлиентЭДО.ИспользуетсяЛегкийКлиентЭДО()
		Или ВидФормы <> "ФормаОбъекта" Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ВыбраннаяФорма = "ФормаЭлементаЛегкийКлиентЭДО";
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДополнитьДаннымиИзСправочника(ДанныеВыбора, СтрокаПоиска, Отбор, УникальныеЗначения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 10
		|	СправочникНоменклатура.Ссылка КАК Ссылка,
		|	СправочникНоменклатура.Наименование КАК НайденноеЗначение,
		|	NULL КАК Наименование,
		|	0 КАК ТипРезультата
		|ИЗ
		|	Справочник.Номенклатура КАК СправочникНоменклатура
		|	&ИсточникОписанияНоменклатуры
		|ГДЕ
		|	СправочникНоменклатура.Наименование ПОДОБНО &СтрокаПоиска
		|	И &УсловиеОтбораНоменклатуры
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 10
		|	СправочникНоменклатура.Ссылка,
		|	СправочникНоменклатура.Код,
		|	СправочникНоменклатура.Наименование,
		|	1
		|ИЗ
		|	Справочник.Номенклатура КАК СправочникНоменклатура
		|	&ИсточникОписанияНоменклатуры
		|ГДЕ
		|	СправочникНоменклатура.Код ПОДОБНО &СтрокаПоиска
		|	И &УсловиеОтбораНоменклатуры
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 10
		|	СправочникНоменклатура.Ссылка,
		|	СправочникНоменклатура.Артикул,
		|	СправочникНоменклатура.Наименование,
		|	2
		|ИЗ
		|	Справочник.Номенклатура КАК СправочникНоменклатура
		|	&ИсточникОписанияНоменклатуры
		|ГДЕ
		|	СправочникНоменклатура.Артикул ПОДОБНО &СтрокаПоиска
		|	И &УсловиеОтбораНоменклатуры";
	
	СтрокаПоискаДляЗапроса = СтрокаПоиска;
	
	Если СтрНайти(СтрокаПоискаДляЗапроса, "%") Тогда
		СтрокаПоискаДляЗапроса = СтрЗаменить(СтрокаПоискаДляЗапроса, "%", "[%]");
	КонецЕсли;
	
	Если СтрНайти(СтрокаПоискаДляЗапроса, "_") Тогда
		СтрокаПоискаДляЗапроса = СтрЗаменить(СтрокаПоискаДляЗапроса, "_", "[_]");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("СтрокаПоиска", СтрокаПоискаДляЗапроса + "%");
	
	УстановитьОтборПоВидуПродукции = (Отбор.Свойство("ВидПродукцииИС")
		И КлиентЭДОВызовСервера.ИспользуетсяГосИС());
	Если УстановитьОтборПоВидуПродукции Тогда
		
		// ГосИС
		ОбщегоНазначенияИС.ОбновитьТекстЗапросаСРегистромОписаниеНоменклатурыИС(
			Запрос.Текст, "ОписаниеНоменклатурыИС", "СправочникНоменклатура.Ссылка");
		ОбщегоНазначенияИС.ОбновитьТекстЗапросаОписанияНоменклатурыУсловиемВидаПродукции(
			Запрос.Текст,
			"&УсловиеОтбораНоменклатуры",
			"&ВидыПродукцииИС");
			
		Запрос.УстановитьПараметр("ВидыПродукцииИС", Отбор.ВидПродукцииИС);
		// Конец ГосИС
		
	Иначе
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИсточникОписанияНоменклатуры", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбораНоменклатуры",   "ИСТИНА");
		
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	МассивПодстрок = Новый Массив(5);
	МассивПодстрок[0] = БиблиотекаКартинок.Справочник;
	МассивПодстрок[1] = " ";
	
	КоличествоСтрокВыбора = 0;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.СледующийПоЗначениюПоля("Ссылка")
		И КоличествоСтрокВыбора < 10 Цикл
		
		МассивПодстрок[2] = Новый ФорматированнаяСтрока(Лев(Выборка.НайденноеЗначение, СтрДлина(СтрокаПоиска)),
			ШрифтыСтиля.ЖирныйШрифтБЭД, ЦветаСтиля.РезультатУспехЦвет);
		Если Выборка.НайденноеЗначение <> СтрокаПоиска Тогда
			МассивПодстрок[3] = Сред(Выборка.НайденноеЗначение, СтрДлина(СтрокаПоиска) + 1);
		Иначе
			МассивПодстрок[3] = "";
		КонецЕсли;
		
		Если Выборка.ТипРезультата Тогда
			МассивПодстрок[4] = СтрШаблон(" (%1)", Выборка.Наименование);
			УникальныеЗначения.Вставить(Выборка.Наименование, Истина);
		Иначе
			МассивПодстрок[4] = "";
			УникальныеЗначения.Вставить(Выборка.НайденноеЗначение, Истина);
		КонецЕсли;
		
		ПредставлениеСтрокиВыбора = Новый ФорматированнаяСтрока(МассивПодстрок);
		ДанныеВыбора.Добавить(Выборка.Ссылка, ПредставлениеСтрокиВыбора);
		
		КоличествоСтрокВыбора = КоличествоСтрокВыбора + 1;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьДаннымиИзСервиса(ДанныеВыбора, СтрокаПоиска, УникальныеЗначения)
	
	КоличествоДанныхВыбора = ДанныеВыбора.Количество();
	Если КоличествоДанныхВыбора >= 10 Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	ПараметрыЗапроса = РаботаСНоменклатуройСлужебный.ОписаниеПараметровЗапросаНоменклатура();
	ПараметрыЗапроса.НаборПолей = РаботаСНоменклатуройСлужебный.НаборПолейСтандартный();
	ПараметрыЗапроса.КоличествоЗаписей = 10 - КоличествоДанныхВыбора;
	ПараметрыЗапроса.СтрокаПоиска = СтрокаПоиска;
	
	ПараметрыКоманды = РаботаСНоменклатуройСлужебный.ПараметрыЗапросаНоменклатура(ПараметрыЗапроса);
	НайденнаяНоменклатура = РаботаСНоменклатуройСлужебный.ВыполнитьКомандуСервиса(ПараметрыКоманды, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаПодстрокПоиска = Новый ТаблицаЗначений;
	ТаблицаПодстрокПоиска.Колонки.Добавить("Позиция");
	ТаблицаПодстрокПоиска.Колонки.Добавить("Длина");
	
	Для Каждого ДанныеНоменклатуры Из НайденнаяНоменклатура Цикл
		Наименование = ДанныеНоменклатуры.Наименование;
		Если ПустаяСтрока(Наименование)
			ИЛИ УникальныеЗначения[Наименование] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НаименованиеНРег = НРег(Наименование);
		ДлинаНаименования = СтрДлина(Наименование);
		
		МассивПодстрокПоиска = СтрРазделить(НРег(СтрокаПоиска), " ", Ложь);
		Для Каждого ПодстрокаПоиска Из МассивПодстрокПоиска Цикл
			Позиция = 1;
			ДлинаПодстроки = СтрДлина(ПодстрокаПоиска);
			Пока Истина Цикл
				Позиция = СтрНайти(НаименованиеНРег, ПодстрокаПоиска,, Позиция);
				Если Позиция = 0 Тогда
					Прервать;
				КонецЕсли;
				
				НоваяСтрока = ТаблицаПодстрокПоиска.Добавить();
				НоваяСтрока.Позиция = Позиция;
				НоваяСтрока.Длина   = ДлинаПодстроки;
				
				Позиция = Позиция + ДлинаПодстроки;
				Если Позиция >= ДлинаНаименования Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		МассивПодстрок = Новый Массив;
		МассивПодстрок.Добавить(БиблиотекаКартинок.ИконкаБелыйФонРаботаСНоменклатурой);
		МассивПодстрок.Добавить(" ");
		
		Если ТаблицаПодстрокПоиска.Количество() = 0 Тогда
			МассивПодстрок.Добавить(Наименование);
		Иначе
			ТаблицаПодстрокПоиска.Сортировать("Позиция");
			
			Позиция = 1;
			Для Каждого ПараметрыПодстроки Из ТаблицаПодстрокПоиска Цикл
				
				Если Позиция < ПараметрыПодстроки.Позиция Тогда
					МассивПодстрок.Добавить(Сред(Наименование, Позиция, ПараметрыПодстроки.Позиция - Позиция));
				КонецЕсли;
				
				МассивПодстрок.Добавить(Новый ФорматированнаяСтрока(
					Сред(Наименование, ПараметрыПодстроки.Позиция, ПараметрыПодстроки.Длина),
					ШрифтыСтиля.ЖирныйШрифтБЭД, ЦветаСтиля.РезультатУспехЦвет));
				
				Позиция = ПараметрыПодстроки.Позиция + ПараметрыПодстроки.Длина;
			КонецЦикла;
			
			ОстатокСимволов = ДлинаНаименования - Позиция + 1;
			Если ОстатокСимволов > 0 Тогда
				МассивПодстрок.Добавить(Прав(Наименование, ОстатокСимволов));
			КонецЕсли;
		КонецЕсли;
		
		ЗначениеВыбора = Новый Структура;
		ЗначениеВыбора.Вставить("Идентификатор", ДанныеНоменклатуры.Идентификатор);
		ЗначениеВыбора.Вставить("Наименование" , ДанныеНоменклатуры.Наименование);
		ПредставлениеСтрокиВыбора = Новый ФорматированнаяСтрока(МассивПодстрок);
		ДанныеВыбора.Добавить(ЗначениеВыбора, ПредставлениеСтрокиВыбора);
		
		ТаблицаПодстрокПоиска.Очистить();
	КонецЦикла;
	
КонецПроцедуры

Функция ДанныеКОбработке_ЗаполнитьСтавкуНДС20() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.СтавкаНДС В(&СтавкиНДС18)";
	
	СтавкиНДС18 = Новый Массив;
	СтавкиНДС18.Добавить(Перечисления.СтавкиНДС.НДС18);
	СтавкиНДС18.Добавить(Перечисления.СтавкиНДС.НДС18_118);
	
	Запрос.Параметры.Вставить("СтавкиНДС18", СтавкиНДС18);
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьДанные_ЗаполнитьСтавкуНДС20(Объект, Записать) 
	
	Если Объект.СтавкаНДС = Перечисления.СтавкиНДС.НДС18 Тогда
		Объект.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
		Записать = Истина;
	ИначеЕсли Объект.СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
		Объект.СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120;
		Записать = Истина;
	КонецЕсли;
	
КонецПроцедуры

