// Количество упаковок номенклатуры.
// 
// Параметры:
//  Номенклатура - ОпределяемыйТип.Номенклатура - Номенклатура
// 
// Возвращаемое значение:
//  Число - Количество упаковок номенклатуры
Функция КоличествоУпаковокНоменклатуры(Знач Номенклатура) Экспорт
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НоменклатураВладелец", Номенклатура);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ЕдиницыИзмерения.Ссылка) КАК КоличествоУпаковок
	|ИЗ
	|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|ГДЕ
	|	ЕдиницыИзмерения.НоменклатураВладелец = &НоменклатураВладелец";

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Возврат 0;
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить()[0].КоличествоУпаковок;
	
КонецФункции

// Коэффициент упаковки.
// 
// Параметры:
//  Упаковка - СправочникСсылка.ЕдиницыИзмерения
//  Номенклатура - ОпределяемыйТип.Номенклатура - Номенклатура
// 
// Возвращаемое значение:
//  Число - Коэффициент упаковки
Функция КоэффициентУпаковки(Упаковка, Номенклатура = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Упаковка) Тогда
		Возврат 1;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Упаковка", Упаковка);
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	%1 КАК Коэффициент
		|ИЗ
		|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
		|ГДЕ
		|	ЕдиницыИзмерения.Ссылка = &Упаковка";
		ИсточникНоменклатуры = Неопределено;
	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	%1 КАК Коэффициент
		|ИЗ
		|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО Номенклатура.Ссылка = &Номенклатура
		|			И ЕдиницыИзмерения.Ссылка = &Упаковка";
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		ИсточникНоменклатуры =  "Номенклатура";
	КонецЕсли;
	
	Запрос.Текст = СтрШаблон(Запрос.Текст, ТекстЗапросаКоэффициентУпаковки("ЕдиницыИзмерения", ИсточникНоменклатуры));
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат 1;
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить()[0].Коэффициент;
	
КонецФункции

// Количество базовых единиц в упаковке.
// 
// Параметры:
//  Упаковка - СправочникСсылка.ЕдиницыИзмерения
// 
// Возвращаемое значение:
//  Число - Количество базовых единиц в упаковке
Функция КоличествоБазовыхЕдиницВУпаковке(Знач Упаковка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Упаковка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	%1 КАК Коэффициент
	|ИЗ
	|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|ГДЕ
	|	ЕдиницыИзмерения.Ссылка = &Ссылка";
	
	Запрос.Текст = СтрШаблон(Запрос.Текст, ТекстЗапросаКоэффициентУпаковки("ЕдиницыИзмерения"));
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат 1;
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить()[0].Коэффициент;
	
КонецФункции

Процедура НастроитьФормуСписка(Форма) Экспорт
	
	НоменклатураВладелец = Справочники.Номенклатура.ПустаяСсылка();
	Если Форма.Параметры.Свойство("НоменклатураВладелец") Тогда
		НоменклатураВладелец = Форма.Параметры.НоменклатураВладелец;
	КонецЕсли;
	
	Форма.НоменклатураВладелец = НоменклатураВладелец;
	УстановитьЗаголовокФормыСписка(Форма);
	
	Если Форма.Параметры.Свойство("ОтображатьБазовуюЕдиницуВСпискеУпаковок")
		И Форма.Параметры.ОтображатьБазовуюЕдиницуВСпискеУпаковок = Истина Тогда
		Форма.Список.ТекстЗапроса = ТекстЗапросаСпискаУпаковокНоменклатуры();
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Форма.Список, "НоменклатураВладелец", НоменклатураВладелец,
		ВидСравненияКомпоновкиДанных.Равно,,Истина);
	
КонецПроцедуры

// Возвращает массив мерных типов единиц измеряемых величин
// 
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.ТипыИзмеряемыхВеличин
//
Функция МерныеТипыЕдиницИзмерений() Экспорт
	
	МерныеТипы = Новый Массив;
	МерныеТипы.Добавить(Перечисления.ТипыИзмеряемыхВеличин.Вес);
	МерныеТипы.Добавить(Перечисления.ТипыИзмеряемыхВеличин.Объем);
	
	Возврат МерныеТипы;
	
КонецФункции

// Это мерная единица.
// 
// Параметры:
//  ЕдиницаИзмерения - СправочникСсылка.ЕдиницыИзмерения -
//  ВозвращаемыйПараметрТипИзмеряемойВеличины - Строка - Возвращаемый параметр тип измеряемой величины
// 
// Возвращаемое значение:
//  Булево - Это мерная единица
Функция ЭтоМернаяЕдиница(ЕдиницаИзмерения, ВозвращаемыйПараметрТипИзмеряемойВеличины = "") Экспорт 
	
	Если Не ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
		ТипЕдиницыЗначение = Неопределено;
	Иначе
		ТипЕдиницыЗначение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаИзмерения, "ТипИзмеряемойВеличины");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипЕдиницыЗначение) Тогда
		ВозвращаемыйПараметрТипИзмеряемойВеличины = ОбщегоНазначения.ИмяЗначенияПеречисления(ТипЕдиницыЗначение);
	Иначе
		ВозвращаемыйПараметрТипИзмеряемойВеличины = "";
	КонецЕсли;
	
	Если ВозвращаемыйПараметрТипИзмеряемойВеличины = "Вес"
		Или ВозвращаемыйПараметрТипИзмеряемойВеличины = "Объем"
		Или ВозвращаемыйПараметрТипИзмеряемойВеличины = "Площадь"
		Или ВозвращаемыйПараметрТипИзмеряемойВеличины = "Длина" Тогда
		
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает единицу измерения по умолчанию.
// 
// Возвращаемое значение:
//  см. ЕдиницаИзмеренияПоКоду
Функция ПолучитьЕдиницуИзмеренияПоУмолчанию() Экспорт
	
	Возврат ЕдиницаИзмеренияПоКоду("796");
	
КонецФункции

#КонецОбласти

#КонецЕсли

#Область ОбработчикиСобытий

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
		
	Если Не Параметры.Отбор.Свойство("НоменклатураВладелец") Тогда
		Возврат;
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
	ДанныеВыбора = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НоменклатураВладелец", Параметры.Отбор.НоменклатураВладелец);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	1 КАК Метрика,
	|	УпаковкиНоменклатуры.Ссылка КАК Ссылка,
	|	УпаковкиНоменклатуры.Коэффициент КАК Коэффициент,
	|	Номенклатура.ЕдиницаИзмерения.Наименование КАК БазоваяЕдиница,
	|	УпаковкиНоменклатуры.Наименование КАК Наименование,
	|	УпаковкиНоменклатуры.НоменклатураВладелец КАК НоменклатураВладелец
	|ИЗ
	|	Справочник.ЕдиницыИзмерения КАК УпаковкиНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО УпаковкиНоменклатуры.НоменклатураВладелец = Номенклатура.Ссылка
	|ГДЕ
	|	УпаковкиНоменклатуры.НоменклатураВладелец = &НоменклатураВладелец
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	0,
	|	Номенклатура.ЕдиницаИзмерения,
	|	1,
	|	"""",
	|	ЕдиницыИзмерения.Наименование,
	|	ЕдиницыИзмерения.НоменклатураВладелец
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ПО Номенклатура.ЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
	|ГДЕ
	|	Номенклатура.Ссылка = &НоменклатураВладелец
	|
	|УПОРЯДОЧИТЬ ПО
	|	Метрика,
	|	Коэффициент";
	Для Каждого ЭлементВыборки Из Запрос.Выполнить().Выгрузить() Цикл
		Если ЭтоУпаковка(ЭлементВыборки) Тогда
			ДанныеВыбора.Добавить(
				ЭлементВыборки.Ссылка,
				ПредставлениеУпаковки(
					ЭлементВыборки.Наименование,
					ЭлементВыборки.Коэффициент,
					ЭлементВыборки.БазоваяЕдиница));
		Иначе
			ДанныеВыбора.Добавить(
				ЭлементВыборки.Ссылка,
				Новый ФорматированнаяСтрока(
					СтрШаблон(НСтр("ru = '%1 (базовая ед.)'"), ЭлементВыборки.Наименование), Новый Шрифт(,,Истина)));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если ВидФормы = "ФормаОбъекта" Тогда
		Если Параметры.Свойство("Ключ") 
			И ЭтоУпаковка(ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.Ключ, "НоменклатураВладелец")) Тогда
			ВыбраннаяФорма = "ФормаЭлементаУпаковки";
			
			СтандартнаяОбработка = Ложь;
			
			Возврат;
		КонецЕсли;
		
		Если Параметры.Свойство("ПараметрыВыбора")
			И Параметры.ПараметрыВыбора.Свойство("НоменклатураВладелец") 
			И ЭтоУпаковка(Параметры.ПараметрыВыбора) Тогда
		
			ВыбраннаяФорма = "ФормаЭлементаУпаковки";
			
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	ИначеЕсли ВидФормы = "ФормаВыбора" Тогда
		НоменклатураВладелец = Неопределено;
		Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("НоменклатураВладелец") Тогда
			НоменклатураВладелец = Параметры.Отбор.НоменклатураВладелец;
		КонецЕсли;
		
		СтандартнаяОбработка = Ложь;
		
		ВыбраннаяФорма = "ФормаВыбора";
		Если ЗначениеЗаполнено(НоменклатураВладелец) Тогда
			Параметры.Вставить("НоменклатураВладелец", НоменклатураВладелец);
		КонецЕсли;
		
		Если Параметры.Свойство("НоменклатураВладелец")
			И ЗначениеЗаполнено(Параметры.НоменклатураВладелец)
			И Не Параметры.Свойство("ОтображатьБазовуюЕдиницуВСпискеУпаковок") Тогда
			
			Параметры.Вставить("ОтображатьБазовуюЕдиницуВСпискеУпаковок", Истина);
		КонецЕсли;
	ИначеЕсли ВидФормы = "ФормаСписка" Тогда
		НоменклатураВладелец = Неопределено;
		Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("НоменклатураВладелец") Тогда
			НоменклатураВладелец = Параметры.Отбор.НоменклатураВладелец;
		ИначеЕсли Параметры.Свойство("ТекущаяСтрока") Тогда
			НоменклатураВладелец = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ТекущаяСтрока, "НоменклатураВладелец");
		КонецЕсли;
		
		СтандартнаяОбработка = Ложь;
		
		ВыбраннаяФорма = "ФормаСписка";
		Если ЗначениеЗаполнено(НоменклатураВладелец) Тогда
			Параметры.Вставить("НоменклатураВладелец", НоменклатураВладелец);
		КонецЕсли;
		
		Если Параметры.Свойство("НоменклатураВладелец")
			И ЗначениеЗаполнено(Параметры.НоменклатураВладелец)
			И Не Параметры.Свойство("ОтображатьБазовуюЕдиницуВСпискеУпаковок") Тогда
			
			Параметры.Вставить("ОтображатьБазовуюЕдиницуВСпискеУпаковок", Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Поля.Добавить("Наименование");
	Поля.Добавить("Ссылка");
	Поля.Добавить("НоменклатураВладелец");
	Поля.Добавить("Коэффициент");
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
	Если Не ЭтоУпаковка(Данные) Тогда
		Возврат;
	КонецЕсли;
	
	НоменклатураВладелецЕдиницаИзмеренияНаименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		Данные.НоменклатураВладелец, "ЕдиницаИзмерения.Наименование");
	
	СтандартнаяОбработка = Ложь;
	
	Представление = ПредставлениеУпаковки(
		Данные.Наименование,
		XMLСтрока(Данные.Коэффициент),
		НоменклатураВладелецЕдиницаИзмеренияНаименование);

	#КонецЕсли
		
КонецПроцедуры

#КонецОбласти

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

Функция ЭтоУпаковка(Знач ДанныеЕдиницыИзмеренияУпаковки)
	
	Возврат ЗначениеЗаполнено(ДанныеЕдиницыИзмеренияУпаковки.НоменклатураВладелец)
		И Не ДанныеЕдиницыИзмеренияУпаковки.НоменклатураВладелец.Пустая()
	
КонецФункции

Функция ПредставлениеУпаковки(Знач Наименование, Знач Коэффициент, Знач НаименованиеБазовойЕдиницы)
	
	Возврат СтрШаблон("%1 (%2 %3)",
		Наименование,
		XMLСтрока(Коэффициент),
		НаименованиеБазовойЕдиницы);
	
КонецФункции

Процедура УстановитьЗаголовокФормыСписка(Форма)
	
	НоменклатураВладелец = Неопределено;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "НоменклатураВладелец") Тогда
		НоменклатураВладелец = Форма.НоменклатураВладелец;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоменклатураВладелец) Тогда
		Форма.Заголовок = СтрШаблон(НСтр("ru = 'Упаковки товара %1'"), НоменклатураВладелец);
	Иначе
		Форма.Заголовок = НСтр("ru = 'Классификатор единиц измерения'");
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстЗапросаДанныеУпаковки(Знач ПутьКУпаковкеВЗапросе,
	Знач ПрефиксОтношения = "Упаковка", Подробно = Ложь)
	
	ТекстЗапроса = ТекстЗапросаКоэффициентУпаковки(ПутьКУпаковкеВЗапросе) + " КАК %2Коэффициент,
	|	ВЫБОР КОГДА %1.НоменклатураВладелец = Значение(Справочник.Номенклатура.) ТОГДА
	|		%1.Код ИНАЧЕ ЕСТЬNULL(%1.ЕдиницаИзмерения.Код, """")
	|	КОНЕЦ КАК %2Код,
	|	ВЫБОР КОГДА %1.НоменклатураВладелец = Значение(Справочник.Номенклатура.) ТОГДА
	|		%1.Наименование ИНАЧЕ  ЕСТЬNULL(%1.ЕдиницаИзмерения.Наименование, """")
	|	КОНЕЦ КАК %2Наименование";
	
	Если Подробно Тогда
		ТекстЗапроса = ТекстЗапроса + ",
		|	ВЫБОР КОГДА %1.НоменклатураВладелец = Значение(Справочник.Номенклатура.) ТОГДА
		|		%1.НаименованиеПолное ИНАЧЕ  ЕСТЬNULL(%1.ЕдиницаИзмерения.НаименованиеПолное, """")
		|	КОНЕЦ КАК %2НаименованиеПолное,
		|	ВЫБОР КОГДА %1.НоменклатураВладелец = Значение(Справочник.Номенклатура.) ТОГДА
		|		%1.МеждународноеСокращение ИНАЧЕ  ЕСТЬNULL(%1.ЕдиницаИзмерения.МеждународноеСокращение, """")
		|	КОНЕЦ КАК %2МеждународноеСокращение";
	КонецЕсли;
	
	Возврат СтрШаблон(ТекстЗапроса, ПутьКУпаковкеВЗапросе, ПрефиксОтношения);
	
КонецФункции

Функция ТекстЗапросаСпискаУпаковокНоменклатуры()
	
	Возврат
	"ВЫБРАТЬ
	|	СправочникЕдиницыИзмерения.Ссылка КАК Ссылка,
	|	СправочникЕдиницыИзмерения.Наименование КАК Наименование,
	|	ВЫБОР
	|		КОГДА СправочникЕдиницыИзмерения.НоменклатураВладелец = ЗНАЧЕНИЕ(Справочник.Номенклатура.)
	|			ТОГДА 1
	|		ИНАЧЕ СправочникЕдиницыИзмерения.Коэффициент
	|	КОНЕЦ КАК Коэффициент,
	|	Номенклатура.Ссылка КАК НоменклатураВладелец,
	|	СправочникЕдиницыИзмерения.Код КАК Код,
	|	СправочникЕдиницыИзмерения.МеждународноеСокращение КАК МеждународноеСокращение,
	|	СправочникЕдиницыИзмерения.НаименованиеПолное КАК НаименованиеПолное
	|ИЗ
	|	Справочник.ЕдиницыИзмерения КАК СправочникЕдиницыИзмерения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО (Номенклатура.Ссылка = СправочникЕдиницыИзмерения.НоменклатураВладелец
	|				ИЛИ Номенклатура.ЕдиницаИзмерения = СправочникЕдиницыИзмерения.Ссылка)
	|";
	
КонецФункции

#КонецОбласти

#КонецЕсли
