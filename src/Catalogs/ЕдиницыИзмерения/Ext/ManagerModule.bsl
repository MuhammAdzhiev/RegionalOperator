#Область ПрограммныйИнтерфейс

// Выполняет поиск единицы измерения в справочнике "КлассификаторЕдиницИзмерения"
// если элемент в справочнике не найден, осуществляется попытка добавления элемента из ОКЕИ,
// если в ОКЕИ элемент не найден, то он создается с переданным кодом и наименованием
// Если Наименование не задано то добавление элемента в справочник произведено не будет!
//
// Параметры:
//  КодПоОКЕИ - Строка - код единицы измерения по ОКЕИ (Обязательный).
//  Наименование - Строка - Наименование единицы измерения (Необязательный).
//  НаименованиеПолное - Строка - Полное наименование единицы измерения (Необязательный).
//
// Возвращаемое значение:
//  Неопределено, СправочникСсылка.ЕдиницыИзмерения - Неопределено, если поиск или добавление успешны.
//      Ссылка на элемент справочника, если поиск и попытка добавления элемента не дали результатов.
// 
Функция ЕдиницаИзмеренияПоКоду(КодПоОКЕИ, Наименование = "", НаименованиеПолное = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(КодПоОКЕИ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Сначала попытаемся найти единицу среди уже существующих в справочнике
	ЕдиницаИзмерения = НайтиПоКоду(КодПоОКЕИ);
	Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда 
		Возврат ЕдиницаИзмерения;
	КонецЕсли;
	
	// Если единицы нет в справочнике, поищем ее в классификаторе
	// Классификатор хранится в макете "КлассификаторЕдиницИзмерения"
	// Загружаем макет
	Макет = ПолучитьМакет("КлассификаторЕдиницИзмерения");
	
	// Запомним параметры макета которые будем использовать дальше
	ОбластьКодЧисловойЛево              = Макет.Области.КодЧисловой.Лево;
	ОбластьКодЧисловойПраво             = Макет.Области.КодЧисловой.Право;
	ОбластьНаименованиеКраткоеЛево      = Макет.Области.НаименованиеКраткое.Лево;
	ОбластьНаименованиеКраткоеПраво     = Макет.Области.НаименованиеКраткое.Право;
	ОбластьНаименованиеПолноеЛево       = Макет.Области.НаименованиеПолное.Лево;
	ОбластьНаименованиеПолноеПраво      = Макет.Области.НаименованиеПолное.Право;
	ОбластьМеждународноеСокращениеЛево  = Макет.Области.МеждународноеСокращение.Лево;
	ОбластьМеждународноеСокращениеПраво = Макет.Области.МеждународноеСокращение.Право;
	
	// Загружаем табличный документ
	Классификатор = Новый ТабличныйДокумент;
	Классификатор.Вывести(Макет);
	
	// Поищем КодПоОКЕИ в таблице классификатора
	НайденнаяОбласть = Классификатор.НайтиТекст(КодПоОКЕИ,, Классификатор.Области.КодЧисловой,,,, Истина);
	
	// Инициализируем временную структуру для реквизитов единицы измерения
	ЗначенияЗаполнения = Новый Структура("Код, Наименование, НаименованиеПолное, МеждународноеСокращение, ТипИзмеряемойВеличины");
	
	// Если единица найдена, заполняем нашу структуру из классификатора
	Если НайденнаяОбласть <> Неопределено Тогда
		
		ЗначенияЗаполнения.Вставить("Код", Классификатор.Область(НайденнаяОбласть.Верх, ОбластьКодЧисловойЛево,
			НайденнаяОбласть.Низ, ОбластьКодЧисловойПраво).Текст);
		
		НаименованиеДляЗаполнения = Классификатор.Область(НайденнаяОбласть.Верх, ОбластьНаименованиеКраткоеЛево,
			НайденнаяОбласть.Низ, ОбластьНаименованиеКраткоеПраво).Текст;
		
		ЗначенияЗаполнения.Вставить("Наименование", СтрПолучитьСтроку(НаименованиеДляЗаполнения, 1));
		
		НаименованиеПолное = Классификатор.Область(НайденнаяОбласть.Верх, ОбластьНаименованиеПолноеЛево,
			НайденнаяОбласть.Низ, ОбластьНаименованиеПолноеПраво).Текст;
		
		ЗначенияЗаполнения.Вставить("НаименованиеПолное", СтрПолучитьСтроку(НаименованиеПолное, 1));
		
		МеждународноеСокращение = Классификатор.Область(НайденнаяОбласть.Верх, ОбластьМеждународноеСокращениеЛево,
			НайденнаяОбласть.Низ, ОбластьМеждународноеСокращениеПраво).Текст;
		
		ЗначенияЗаполнения.Вставить("МеждународноеСокращение",  СтрПолучитьСтроку(МеждународноеСокращение, 1));
		
	// Если в классификаторе нет подходящей единицы, но у нас есть данные для заполнения справочника
	// то добавляем новую единицу по этим данным
	ИначеЕсли ЗначениеЗаполнено(Наименование) Тогда
		
		ЗначенияЗаполнения.Вставить("Код", КодПоОКЕИ);
		
		ЗначенияЗаполнения.Вставить("Наименование", Наименование);
		
		ЗначенияЗаполнения.Вставить("НаименованиеПолное", ?(ЗначениеЗаполнено(НаименованиеПолное), НаименованиеПолное, Наименование));
		
	// Если единицы нет в классификаторе и ничего кроме кода о ней не известно
	// возвращаем неопределено
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ЗначенияЗаполнения.ТипИзмеряемойВеличины = ТипИзмеряемойВеличиныПоКодуКлассификатора(ЗначенияЗаполнения.Код);
	
	// Создаем единицу измерения в справочнике
	НоваяЕдиницаИзмерения = СоздатьЭлемент();
	
	ЗаполнитьЗначенияСвойств(НоваяЕдиницаИзмерения, ЗначенияЗаполнения);
	
	НоваяЕдиницаИзмерения.Записать();
	
	ЕдиницаИзмерения = НоваяЕдиницаИзмерения.Ссылка;
	
	Возврат ЕдиницаИзмерения;
	
КонецФункции

// Создает единицу измерения по коду 796.
Процедура СоздатьЭлементыПоУмолчанию() Экспорт
	
	ЕдиницаИзмеренияПоКоду("796");
	
КонецПроцедуры

// Упаковка номенклатуры по коэффициенту.
// 
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура
//  Коэффициент - Число - коэффициент упаковки
// 
// Возвращаемое значение:
//  СправочникСсылка.ЕдиницыИзмерения - Упаковка номенклатуры по коэффициенту
Функция УпаковкаНоменклатурыПоКоэффициенту(Номенклатура, Коэффициент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕСТЬNULL(ЕдиницыИзмерения.Ссылка, НЕОПРЕДЕЛЕНО) КАК Упаковка,
	|	ПРЕДСТАВЛЕНИЕ(Номенклатура.ЕдиницаИзмерения)    КАК БазоваяЕдиницаИзмеренияПредставление
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ПО Номенклатура.Ссылка = ЕдиницыИзмерения.НоменклатураВладелец
	|		И НЕ ЕдиницыИзмерения.ПометкаУдаления
	|		И ЕдиницыИзмерения.Коэффициент = &Коэффициент
	|ГДЕ
	|	Номенклатура.Ссылка = &НоменклатураВладелец";
	
	Запрос.УстановитьПараметр("НоменклатураВладелец", Номенклатура);
	Запрос.УстановитьПараметр("Коэффициент",          Коэффициент);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если Не РезультатЗапроса.Следующий() Тогда
		Возврат ПустаяСсылка();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РезультатЗапроса.Упаковка) Тогда
		Возврат РезультатЗапроса.Упаковка;
	Иначе
		
		ЕдиницыИзмеренияОбъект = СоздатьЭлемент();
		ЕдиницыИзмеренияОбъект.НоменклатураВладелец = Номенклатура;
		ЕдиницыИзмеренияОбъект.Коэффициент          = Коэффициент;
		ЕдиницыИзмеренияОбъект.ЕдиницаИзмерения     = ЕдиницаИзмеренияПоКоду("796");
		ЕдиницыИзмеренияОбъект.Наименование = СтрШаблон(
			"%1 (%2 %3)",
			ЕдиницыИзмеренияОбъект.ЕдиницаИзмерения,
			ЕдиницыИзмеренияОбъект.Коэффициент,
			РезультатЗапроса.БазоваяЕдиницаИзмеренияПредставление);
		
		ЕдиницыИзмеренияОбъект.Записать();
		
		Возврат ЕдиницыИзмеренияОбъект.Ссылка;
		
	КонецЕсли;
	
КонецФункции

// Возвращает единицу хранения номенклатуры.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - ссылка номенклатуры.
//
// Возвращаемое значение:
//  СправочникСсылка.УпаковкиЕдиницыИзмерения - единица хранения номенклатуры.
//
Функция ЕдиницаХраненияНоменклатуры(Знач Номенклатура) Экспорт
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ЕдиницаИзмерения");
	
КонецФункции

// Тип измеряемой величины по коду классификатора.
// 
// Параметры:
//  КодКлассификатора - Строка - код классификатора
// 
// Возвращаемое значение:
//  Неопределено, ПеречислениеСсылка.ТипыИзмеряемыхВеличин - Тип измеряемой величины по коду классификатора
Функция ТипИзмеряемойВеличиныПоКодуКлассификатора(КодКлассификатора) Экспорт
	
	ТипИзмеряемойВеличиныСтрокой = ИнтеграцияИС.ТипИзмеряемойВеличиныПоКодуКлассификатора(КодКлассификатора);
	Если ТипИзмеряемойВеличиныСтрокой = "Вес" Тогда
		Возврат Перечисления.ТипыИзмеряемыхВеличин.Вес;
	ИначеЕсли ТипИзмеряемойВеличиныСтрокой = "Объем" Тогда
		Возврат Перечисления.ТипыИзмеряемыхВеличин.Объем;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ДанныеЕдиницыИзмеренияПоКодуОКЕИ(Знач КодОКЕИ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕдиницыИзмерения.Наименование КАК Наименование,
	|	ЕдиницыИзмерения.НаименованиеПолное КАК НаименованиеПолное,
	|	ЕдиницыИзмерения.МеждународноеСокращение КАК МеждународноеСокращение,
	|	ЕдиницыИзмерения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|ГДЕ
	|	ЕдиницыИзмерения.Код = &Код
	|	И ЕдиницыИзмерения.НоменклатураВладелец = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И НЕ ЕдиницыИзмерения.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Код", КодОКЕИ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(РезультатЗапроса.Выгрузить()[0]);
	
КонецФункции

Функция УпаковкаНоменклатуры(Знач Номенклатура, Знач КодОКЕИ,
	Знач Наименование = "", Знач Коэффициент = 1, Знач НаименованиеПолное = "") Экспорт

	Результат = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЕдиницаИзмерения = ЕдиницаИзмеренияПоКоду(КодОКЕИ, Наименование, НаименованиеПолное);
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.ЕдиницыИзмерения");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("НоменклатураВладелец", Номенклатура);
		Блокировка.Заблокировать();
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("НоменклатураВладелец", Номенклатура);
		Запрос.УстановитьПараметр("ЕдиницаИзмерения", ЕдиницаИзмерения);
		Запрос.УстановитьПараметр("Коэффициент", Коэффициент);
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Подзапрос.Ссылка КАК Ссылка
		|ИЗ
		|	(ВЫБРАТЬ ПЕРВЫЕ 1
		|		Номенклатура.ЕдиницаИзмерения КАК Ссылка,
		|		0 КАК Метрика
		|	ИЗ
		|		Справочник.Номенклатура КАК Номенклатура
		|	ГДЕ
		|		Номенклатура.Ссылка = &НоменклатураВладелец
		|		И Номенклатура.ЕдиницаИзмерения = &ЕдиницаИзмерения
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ ПЕРВЫЕ 1
		|		ЕдиницыИзмерения.Ссылка,
		|		1
		|	ИЗ
		|		Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
		|	ГДЕ
		|		ЕдиницыИзмерения.НоменклатураВладелец = &НоменклатураВладелец
		|		И ЕдиницыИзмерения.ЕдиницаИзмерения = &ЕдиницаИзмерения
		|		И ЕдиницыИзмерения.Коэффициент = &Коэффициент
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ ПЕРВЫЕ 1
		|		ЕдиницыИзмерения.Ссылка,
		|		2
		|	ИЗ
		|		Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
		|	ГДЕ
		|		ЕдиницыИзмерения.НоменклатураВладелец = &НоменклатураВладелец
		|		И ЕдиницыИзмерения.ЕдиницаИзмерения = &ЕдиницаИзмерения) КАК Подзапрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	Метрика";
		
		РезультатПоиска = Запрос.Выполнить();
		Если РезультатПоиска.Пустой() Тогда
			НоваяУпаковка = СоздатьЭлемент();
			НоваяУпаковка.НоменклатураВладелец = Номенклатура;
			НоваяУпаковка.Коэффициент = Коэффициент;
			НоваяУпаковка.ЕдиницаИзмерения = ЕдиницаИзмерения;
			НоваяУпаковка.Наименование = ?(ПустаяСтрока(Наименование),
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаИзмерения, "Наименование"),
				Наименование);
		
			НоваяУпаковка.Записать();
			
			Результат = НоваяУпаковка.Ссылка;
		Иначе
			Результат = РезультатПоиска.Выгрузить()[0].Ссылка;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ВызватьИсключение ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ВладелецУпаковки(Знач Упаковка) Экспорт
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Упаковка, "НоменклатураВладелец");
	
КонецФункции

Процедура ДополнитьЗапросДаннымиЕдиницыИзмеренияУпаковки(ТекстЗапроса, Знач ПлейсхолдерДанныхУпаковки,
	Знач ПутьКУпаковкеВЗапросе, Знач ПрефиксОтношения, Подробно = Ложь) Экспорт
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ПлейсхолдерДанныхУпаковки,
		ТекстЗапросаДанныеУпаковки(ПутьКУпаковкеВЗапросе, ПрефиксОтношения, Подробно));
	
КонецПроцедуры

Функция ТекстЗапросаКоэффициентУпаковки(Знач ПутьКУпаковкеВЗапросе, Знач ИсточникНоменклатуры = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ИсточникНоменклатуры) Тогда
		ТекстЗапроса = 
		"	ВЫБОР
		|	КОГДА %1.НоменклатураВладелец = Значение(Справочник.Номенклатура.ПустаяСсылка) ТОГДА
		|		1 
		|	ИНАЧЕ
		|		ЕСТЬNULL(%1.Коэффициент, 1)
		|	КОНЕЦ";
		ТекстЗапроса = СтрШаблон(ТекстЗапроса, ПутьКУпаковкеВЗапросе);
	Иначе
		ТекстЗапроса = 
		"	ВЫБОР
		|	КОГДА %1.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Вес)
		|			И %2.ВесИспользовать
		|			И ЕСТЬNULL(%1.Коэффициент, 0) <> 0
		|			И ЕСТЬNULL(%2.ВесЕдиницаИзмерения.Коэффициент, 0) <> 0
		|			И ЕСТЬNULL(%2.ВесКоэффициент, 0) <> 0
		|	ТОГДА ВЫРАЗИТЬ(%1.Коэффициент / %2.ВесЕдиницаИзмерения.Коэффициент / %2.ВесКоэффициент КАК ЧИСЛО(17, 7))
		|	КОГДА %1.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Объем)
		|			И %2.ОбъемИспользовать
		|			И ЕСТЬNULL(%1.Коэффициент, 0) <> 0
		|			И ЕСТЬNULL(%2.ОбъемЕдиницаИзмерения.Коэффициент, 0) <> 0
		|			И ЕСТЬNULL(%2.ОбъемКоэффициент, 0) <> 0
		|	ТОГДА ВЫРАЗИТЬ(%1.Коэффициент / %2.ОбъемЕдиницаИзмерения.Коэффициент / %2.ОбъемКоэффициент КАК ЧИСЛО(17, 7))
		|	ИНАЧЕ
		|		ЕСТЬNULL(%1.Коэффициент, 1)
		|	КОНЕЦ";
		ТекстЗапроса = СтрШаблон(ТекстЗапроса, ПутьКУпаковкеВЗапросе, ИсточникНоменклатуры);
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Функция - Текст запроса веса упаковки
//
// Параметры:
//  ИсточникУпаковки	 - Строка	 - Таблица с упаковкой. Например, "ВЫРАЗИТЬ(&Упаковка КАК Справочник.УпаковкаЕдиницаИзмерения)"
//  ИсточникНоменклатуры - Строка	 - Таблица с номенклатурой. Если этот параметр не заполнен, то ИсточникУпаковки
//  	должен гарантированно ссылаться на упаковку / единицу измерения типа "Упаковка".
//  	Например, "ТаблицаТовары.Номенклатура"
// 
// Возвращаемое значение:
//  Строка - строка текста запроса, которая вернет вес в единицах измерения веса.
//
Функция ТекстЗапросаВесУпаковки(ИсточникУпаковки, ИсточникНоменклатуры) Экспорт
	
	Если ИсточникНоменклатуры = Неопределено Тогда
		
		ТекстЗапроса =
		"ВЫБОР
		|	КОГДА ТаблицаТовары.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Вес)
		|			И ЕСТЬNULL(ТаблицаТовары.Упаковка.Коэффициент, 0) <> 0
		|		ТОГДА ВЫРАЗИТЬ(ТаблицаТовары.Упаковка.Коэффициент КАК ЧИСЛО(18, 6))
		|	ИНАЧЕ 0
		|КОНЕЦ";
		
	Иначе
		
		ТекстЗапроса =
		"ВЫБОР
		|	КОГДА ТаблицаТовары.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Вес)
		|			И ТаблицаТовары.Номенклатура.ВесИспользовать
		|			И ЕСТЬNULL(ТаблицаТовары.Упаковка.Коэффициент, 0) <> 0
		|		ТОГДА ВЫРАЗИТЬ(ТаблицаТовары.Упаковка.Коэффициент КАК ЧИСЛО(18, 6))
		|	КОГДА ТаблицаТовары.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Объем)
		|			И ТаблицаТовары.Номенклатура.ВесИспользовать
		|			И ЕСТЬNULL(ТаблицаТовары.Упаковка.Коэффициент, 0) <> 0
		|			И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ОбъемЕдиницаИзмерения.Коэффициент, 0) <> 0
		|			И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ОбъемКоэффициент, 0) <> 0
		|			И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Коэффициент, 0) <> 0
		|			И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ВесКоэффициент, 0) <> 0
		|		ТОГДА ВЫРАЗИТЬ(
		|			ТаблицаТовары.Упаковка.Коэффициент /
		|			 ТаблицаТовары.Номенклатура.ОбъемЕдиницаИзмерения.Коэффициент /
		|			 ТаблицаТовары.Номенклатура.ОбъемКоэффициент *
		|			 ТаблицаТовары.Номенклатура.ВесКоэффициент *
		|			 ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Коэффициент КАК ЧИСЛО(18, 6))
		|	КОГДА (ТаблицаТовары.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.КоличествоШтук)
		|			ИЛИ ТаблицаТовары.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.ПустаяСсылка)
		|			ИЛИ ЕСТЬNULL(ТаблицаТовары.Упаковка.Ссылка, ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка))
		|			И ТаблицаТовары.Номенклатура.ВесИспользовать
		|			И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ВесКоэффициент, 0) <> 0
		|			И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Коэффициент, 0) <> 0
		|		ТОГДА ВЫРАЗИТЬ(
		|			ТаблицаТовары.Номенклатура.ВесКоэффициент *
		|			 ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Коэффициент КАК ЧИСЛО(18, 6))
		|	ИНАЧЕ 0
		|КОНЕЦ";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаТовары.Номенклатура", ИсточникНоменклатуры);
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаТовары.Упаковка", ИсточникУпаковки);
	
	Возврат ТекстЗапроса;
	
КонецФункции

