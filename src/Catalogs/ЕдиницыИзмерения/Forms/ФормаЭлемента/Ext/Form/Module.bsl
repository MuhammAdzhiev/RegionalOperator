
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Объект.Код) Тогда
		ТипИзмеряемойВеличины = Справочники.ЕдиницыИзмерения.ТипИзмеряемойВеличиныПоКодуКлассификатора(Объект.Код);
		Объект.ТипИзмеряемойВеличины = ТипИзмеряемойВеличины;
	КонецЕсли;
	
	НастроитьФорму(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	НастроитьФорму(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ТипИзмеряемойВеличиныПриИзменении(Элемент)
	НастроитьФорму(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьФорму(Форма)
	
	Если Форма.Объект.ТипИзмеряемойВеличины = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Вес")
		Или Форма.Объект.ТипИзмеряемойВеличины = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Объем") Тогда
		Форма.Элементы.ГруппаКоэффициент.Видимость = Истина;
		Если ЗначениеЗаполнено(Форма.Объект.Наименование) Тогда
			Форма.Элементы.Коэффициент.Заголовок = СтрШаблон(НСтр("ru = '1 %1 состоит из'"), Форма.Объект.Наименование);
		Иначе
			Форма.Элементы.Коэффициент.Заголовок = НСтр("ru = '1 <ед. изм. по классиф.> состоит из'");
		КонецЕсли;
		Если Форма.Объект.ТипИзмеряемойВеличины = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Вес") Тогда
			Форма.ПредставлениеБазовойЕдиницыИзмерения = НСтр("ru = 'кг'");
		ИначеЕсли Форма.Объект.ТипИзмеряемойВеличины = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Объем") Тогда
			Форма.ПредставлениеБазовойЕдиницыИзмерения = НСтр("ru = 'л (дм3)'");
		КонецЕсли;
	Иначе
		Форма.Элементы.ГруппаКоэффициент.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти