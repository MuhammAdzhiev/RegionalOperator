
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Справочники.ЕдиницыИзмерения.НастроитьФормуСписка(ЭтотОбъект);
	
	УстановитьВидимостьДоступность();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодобратьИзКлассификатора(Команда)
	
	СтрокаПоиска = "";
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		СтрокаПоиска = ТекущиеДанные.Код;
	КонецЕсли;
	
	ПараметрыПодбора = ОблачныеКлассификаторыКлиент.ПараметрыПодбораЭлементовОКЕИ();
	ПараметрыПодбора.Владелец                    = ЭтотОбъект;
	ПараметрыПодбора.ОповещениеОЗавершении       = Новый ОписаниеОповещения("ПодобратьИзКлассификатораЗавершение", ЭтотОбъект);
	ПараметрыПодбора.АльтернативныйСпособПодбора = Новый ОписаниеОповещения("ОткрытьВстроенныйПодбор", ЭтотОбъект);
	ПараметрыПодбора.РежимВыбораЭлемента         = Истина;
	ПараметрыПодбора.КодВыбранногоЭлемента       = СтрокаПоиска;
	
	ОблачныеКлассификаторыКлиент.ПодобратьИзСервисаЭлементыОКЕИ(ПараметрыПодбора);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПодобратьИзКлассификатораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Свойство("КоличествоНовыхЭлементов") Тогда
		Элементы.Список.Обновить();
		
	Иначе
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("Код",                     Результат.Код);
		ЗначенияЗаполнения.Вставить("Наименование",            Результат.УсловноеОбозначениеНациональное);
		ЗначенияЗаполнения.Вставить("НаименованиеПолное",      Результат.Наименование);
		ЗначенияЗаполнения.Вставить("МеждународноеСокращение", Результат.КодовоеБуквенноеОбозначениеМеждународное);
		
		ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
		
		Если ЗначениеЗаполнено(Результат.Ссылка) Тогда
			ПараметрыФормы.Вставить("Ключ", Результат.Ссылка);
		КонецЕсли;
		
		ОткрытьФорму("Справочник.ЕдиницыИзмерения.Форма.ФормаЭлемента",
			ПараметрыФормы, 
			ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВстроенныйПодбор(Результат, ДополнительныеПараметры) Экспорт
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ПодобратьИзКлассификатораЗавершение", ЭтотОбъект, Неопределено);
	Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	
	ОткрытьФорму("Справочник.ЕдиницыИзмерения.Форма.ФормаВыбораИзКлассификатора",,,,,, 
		ОбработчикОповещения, 
		Режим);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДоступность()
	
	ЭтоСписокУпаковок = ЗначениеЗаполнено(НоменклатураВладелец);
	
	Элементы.ФормаПодобратьИзКлассификатора.Видимость = Не ЭтоСписокУпаковок;
	Элементы.ГруппаЕдиницыИзмерения.Видимость = Не ЭтоСписокУпаковок;
	Элементы.ГруппаУпаковки.Видимость = ЭтоСписокУпаковок;
	
КонецПроцедуры

#КонецОбласти
