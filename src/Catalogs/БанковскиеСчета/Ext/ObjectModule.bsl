#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

// Формирует уникальное наименование объекта.
//
Процедура СформироватьНаименование() Экспорт
	
	Наименование = КлиентЭДОКлиентСервер.НаименованиеБанковскогоСчетаПоУмолчанию(
		НомерСчета,
		Строка(Банк),
		Строка(ВалютаДенежныхСредств),
		Валютный);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		Если ДанныеЗаполнения.Свойство("Владелец") Тогда
			
			Владелец = ДанныеЗаполнения.Владелец;
			
		КонецЕсли;
		
		ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
		
		Если ДанныеЗаполнения.Свойство("ВалютаДенежныхСредств") Тогда
			Если ДанныеЗаполнения.ВалютаДенежныхСредств <> ВалютаРегламентированногоУчета Тогда
				ДанныеЗаполнения.Вставить("Валютный", Истина);
			КонецЕсли;
		Иначе
			ДанныеЗаполнения.Вставить("ВалютаДенежныхСредств", ВалютаРегламентированногоУчета);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	Валютный = ВалютаРегламентированногоУчета <> ВалютаДенежныхСредств;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЭтоНовый() Тогда
		Если ВалютаДенежныхСредств <> ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ВалютаДенежныхСредств")
			И ЕстьСсылкиНаОбъект() Тогда
			ТекстСообщения = НСтр("ru = 'Существуют документы, в которых выбран банковский счет %1. Реквизит ""Валюта счета"" не может быть изменен.'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, СокрЛП(Наименование));
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(, "Корректность",
				НСтр("ru = 'Валюта счета'"),,, ТекстСообщения);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка,
				"ВалютаДенежныхСредств", "Объект", Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕстьСсылкиНаОбъект()
	
	МассивСсылок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка);
	
	ВключитьОбъекты = Новый Массив;
	Для Каждого МетаданныеДокумента Из Метаданные.Документы Цикл
		ВключитьОбъекты.Добавить(МетаданныеДокумента);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаСсылок = НайтиПоСсылкам(МассивСсылок, Новый Массив, ВключитьОбъекты);
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТаблицаСсылок.Количество() > 0;
	
КонецФункции

#КонецОбласти

#КонецЕсли