#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДатаОкончанияДействия", "Доступность",
		Не Объект.Бессрочный);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Статус", "Видимость",
		ЗначениеЗаполнено(Объект.Статус));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Гиперссылка", "Видимость",
		ЗначениеЗаполнено(Объект.Гиперссылка));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПроверитьСертификат", "Видимость",
		ЗначениеЗаполнено(Объект.Гиперссылка));
	НоменклатураСертификата.Загрузить(РегистрыСведений.СертификатыНоменклатуры.НоменклатураСертификата(Объект.Ссылка));
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	РегистрыСведений.СертификатыНоменклатуры.ЗаписатьНоменклатуруСертификата(Объект.Ссылка, 
		НоменклатураСертификата.Выгрузить(), Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура БессрочныйПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДатаОкончанияДействия", "Доступность",
		Не Объект.Бессрочный);
	
КонецПроцедуры

&НаКлиенте
Процедура ГиперссылкаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(Объект.Гиперссылка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНоменклатураСертификата

&НаКлиенте
Процедура НоменклатураСертификатаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Отказ = Истина;
		
		ТекстВопроса = Нстр("ru = 'Данные еще не записаны.
		|Добавление номенклатуры возможно только после записи элемента.
		|Записать элемент?'");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ДобавитьНоменклатуруЗавершение", ЭтотОбъект), ТекстВопроса,
			РежимДиалогаВопрос.ДаНет);
			
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьСертификат(Команда)
	
	Если Не ДанныеСертификатаЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	
	ДатаОкончанияДействия = ?(Объект.Бессрочный, Неопределено, Объект.ДатаОкончанияДействия);
	НомерСертификата      = СокрЛП(Объект.Наименование);
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеПолученияДанныхСертификата", ЭтотОбъект);
	
	Если ЭтоСертификат() Тогда
		РаботаСНоменклатуройКлиент.ПолучитьДанныеСертификатаСоответствияИзСервиса(НомерСертификата, 
			Объект.ДатаРегистрации, ДатаОкончанияДействия, ЭтотОбъект, ОповещениеОЗавершении);
	ИначеЕсли ЭтоДекларация() Тогда
		РаботаСНоменклатуройКлиент.ПолучитьДанныеДекларацииСоответствияИзСервиса(НомерСертификата, 
			Объект.ДатаРегистрации, ДатаОкончанияДействия, ЭтотОбъект, ОповещениеОЗавершении);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ЭтоСертификат()
	
	Возврат 
		Объект.ТипСертификата = ПредопределенноеЗначение("Перечисление.ТипыСертификатовНоменклатуры.СертификатСоответствия");
	
КонецФункции

&НаКлиенте
Функция ЭтоДекларация()
	
	Возврат 
		Объект.ТипСертификата = ПредопределенноеЗначение("Перечисление.ТипыСертификатовНоменклатуры.ДекларацияСоответствия");
	
КонецФункции

&НаКлиенте
Функция ДанныеСертификатаЗаполнены()
	
	Отказ = Ложь;
	
	ОчиститьСообщения();
	
	Если Объект.ТипСертификата.Пустая() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбран тип сертификата'"),, "ТипСертификата",
			"Объект.ТипСертификата", Отказ);
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.Наименование) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не указан номер сертификата'"),, "Наименование",
			"Объект.Наименование", Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДатаРегистрации) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не указана дата регистрации'"),, "ДатаРегистрации",
			"Объект.ДатаРегистрации", Отказ);
	КонецЕсли;
	
	Если Не Объект.Бессрочный И Не ЗначениеЗаполнено(Объект.ДатаОкончанияДействия) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не указана дата окончания действия'"),,
			"ДатаОкончанияДействия", "Объект.ДатаОкончанияДействия", Отказ);
	КонецЕсли;
	
	Возврат Не Отказ;
	
КонецФункции 

&НаКлиенте
Процедура ПослеПолученияДанныхСертификата(ДанныеСертификата, ДополнительныеПараметры) Экспорт
	
	ПроверитьОчиститьДанные = Истина;
	
	Если ДанныеСертификата.Статус = "ПринятоВОбработку" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Запрос принят в обработку. Попробуйте повторить попытку проверки сертификата позже.'"));
	ИначеЕсли ДанныеСертификата.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Ошибка, подробности см. в журнале регистрации.'"));
	ИначеЕсли ДанныеСертификата.Статус = "НеНайдено" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'По указанным параметрам документ в сервисе не найден.'"));
	ИначеЕсли ДанныеСертификата.Статус = "Выполнено" Тогда 
		ПроверитьЗаполнитьОбъект(ДанныеСертификата.Данные);
		ПроверитьОчиститьДанные = Ложь;
	ИначеЕсли ДанныеСертификата.Статус = "СервисНеДоступен" Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Сервис временно недоступен. Попробуйте повторить попытку проверки сертификата позже.'"));
	КонецЕсли;
	
	Если ПроверитьОчиститьДанные 
		И (Не ПустаяСтрока(Объект.Статус) Или Не ПустаяСтрока(Объект.Гиперссылка)) Тогда
		Объект.Статус = "";
		Объект.Гиперссылка = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнитьОбъект(ДанныеСервиса)
	
	ЕстьИзменения = Ложь;
	Если Объект.Статус <> ДанныеСервиса.Статус Тогда
		Объект.Статус = ДанныеСервиса.Статус;
		ЕстьИзменения = Истина;
	КонецЕсли;
	
	Если Объект.Гиперссылка <> ДанныеСервиса.Гиперссылка Тогда
		Объект.Гиперссылка = ДанныеСервиса.Гиперссылка;
		ЕстьИзменения = Истина;
	КонецЕсли;
	
	Если ЕстьИзменения Тогда
		Модифицированность = Истина;
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Данные успешно получены, изменений нет.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНоменклатуруЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Записать();
	
КонецПроцедуры

#КонецОбласти
