
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РежимОтображения = Неопределено;
	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
			"Активность", Истина, ВидСравненияКомпоновкиДанных.Равно,, Истина, РежимОтображения);
	
	ИмяМетода           = "Справочники.ТоварныеГруппы.СоздатьОбновитьТоварныеГруппы";
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Создать/обновить товарные группы'");
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, ИмяМетода);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ТипЗнч(ДлительнаяОперация) = Тип("Структура")
		И ДлительнаяОперация.Свойство("Статус") Тогда
		Если ДлительнаяОперация.Статус = "Выполнено" Тогда
			СоздатьОбновитьТоварныеГруппыЗавершение(ДлительнаяОперация, Неопределено);
		Иначе 
			ОповещениеОЗавершении = Новый ОписаниеОповещения("СоздатьОбновитьТоварныеГруппыЗавершение", ЭтотОбъект);
			ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
			ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
			ПараметрыОжидания.ВыводитьПрогрессВыполнения = Ложь;
			ПараметрыОжидания.ВыводитьСообщения = Ложь;
			ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИнформацияНадписьОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСписок;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СоздатьОбновитьТоварныеГруппыЗавершение(Результат, ДополнительныеПараметры) Экспорт 
	
	СтатусЗадания = Неопределено;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда 
		Результат.Свойство("Статус", СтатусЗадания);
	КонецЕсли;
	
	Если СтатусЗадания = "Выполнено" 
		И Результат.Свойство("АдресРезультата")
		И ТипЗнч(Результат.АдресРезультата) = Тип("Строка") 
		И ЭтоАдресВременногоХранилища(Результат.АдресРезультата) Тогда 
		
		ГруппыОбновлены = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		Если ГруппыОбновлены = "НетДанных" Тогда
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаОшибка;
		ИначеЕсли ГруппыОбновлены = "ЕстьДанные" Тогда
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаИнформация;
		Иначе 
			Элементы.Список.Обновить();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти