
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Элементы.Отредактировать.Видимость = Пользователи.ЭтоПолноправныйПользователь();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НастроитьВидимостьЭлементов();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отредактировать(Команда)
	РежимРедактирования = НЕ РежимРедактирования;
	НастроитьВидимостьЭлементов();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура НастроитьВидимостьЭлементов()
	Элементы.СтандартныеКоманды.Видимость = РежимРедактирования;
	Если РежимРедактирования Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаРедактирование;
	Иначе 
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПросмотр;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти