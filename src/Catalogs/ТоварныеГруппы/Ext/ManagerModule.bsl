#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

Функция СоздатьОбновитьТоварныеГруппы() Экспорт 
	
	// Определим доступны ли текущему пользователю товарные группы
	Доступность = ПравоДоступа("Чтение", Метаданные.Справочники.ТоварныеГруппы);
	
	Если НЕ Доступность Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ГруппыОбновлены       = "ОК";
	ТоварныеГруппыСервиса = РаботаСНоменклатурой.ТоварныеГруппыСервиса();
	Если НЕ ЗначениеЗаполнено(ТоварныеГруппыСервиса) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК Поле1
		|ИЗ
		|	Справочник.ТоварныеГруппы КАК ТоварныеГруппы
		|ГДЕ
		|	ТоварныеГруппы.Активность";
		Если Запрос.Выполнить().Пустой() Тогда
			ГруппыОбновлены = "НетДанных";
		Иначе 
			ГруппыОбновлены = "ЕстьДанные";
		КонецЕсли;
		Возврат ГруппыОбновлены;
	КонецЕсли;
	
	ТаблицаГруппы         = Новый ТаблицаЗначений;
	ТаблицаГруппы.Колонки.Добавить("Псевдоним", ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТаблицаГруппы.Колонки.Добавить("Наименование", ОбщегоНазначения.ОписаниеТипаСтрока(150));
	ТаблицаГруппы.Колонки.Добавить("Описание", ОбщегоНазначения.ОписаниеТипаСтрока(250));
	
	Для каждого ТоварнаяГруппа Из ТоварныеГруппыСервиса Цикл
		НоваяСтрока = ТаблицаГруппы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТоварнаяГруппа.Значение);
		НоваяСтрока.Псевдоним = ТоварнаяГруппа.Ключ;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ТоварныеГруппы.Псевдоним КАК Псевдоним,
	|	ТоварныеГруппы.Наименование КАК Наименование,
	|	ТоварныеГруппы.Описание КАК Описание
	|ПОМЕСТИТЬ втТоварныеГруппы
	|ИЗ
	|	&ТоварныеГруппы КАК ТоварныеГруппы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СправочникТоварныеГруппы.Ссылка, ЗНАЧЕНИЕ(Справочник.ТоварныеГруппы.ПустаяСсылка)) КАК Ссылка,
	|	ЕСТЬNULL(ТоварныеГруппы.Псевдоним, СправочникТоварныеГруппы.Псевдоним) КАК Псевдоним,
	|	ЕСТЬNULL(ТоварныеГруппы.Наименование, СправочникТоварныеГруппы.Наименование) КАК Наименование,
	|	ЕСТЬNULL(ТоварныеГруппы.Описание, СправочникТоварныеГруппы.Описание) КАК Описание,
	|	ТоварныеГруппы.Псевдоним ЕСТЬ НЕ NULL КАК Активность
	|ИЗ
	|	втТоварныеГруппы КАК ТоварныеГруппы
	|		ПОЛНОЕ СОЕДИНЕНИЕ Справочник.ТоварныеГруппы КАК СправочникТоварныеГруппы
	|		ПО ТоварныеГруппы.Псевдоним = СправочникТоварныеГруппы.Псевдоним";
	
	Запрос.УстановитьПараметр("ТоварныеГруппы", ТаблицаГруппы);
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Объект = Выборка.Ссылка.ПолучитьОбъект();
		Иначе 
			Объект = Справочники.ТоварныеГруппы.СоздатьЭлемент();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Объект, Выборка,, "Ссылка");
		Объект.Записать();
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#КонецЕсли