
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОтборПоВладельцу = Неопределено;
	Если (Параметры.Свойство("Номенклатура", ОтборПоВладельцу)
		ИЛИ Параметры.Отбор.Свойство("Владелец", ОтборПоВладельцу))
			И ЗначениеЗаполнено(ОтборПоВладельцу) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВидыНоменклатуры.Ссылка КАК ВидНоменклатуры,
			|	ВидыНоменклатуры.ИспользоватьХарактеристики КАК ИспользоватьХарактеристики,
			|	ВидыНоменклатуры.ИндивидуальныеХарактеристикиНоменклатуры КАК ИндивидуальныеХарактеристикиНоменклатуры
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
			|		ПО Номенклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка
			|			И (Номенклатура.Ссылка = &Ссылка)";
		Запрос.УстановитьПараметр("Ссылка", ОтборПоВладельцу);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если НЕ Выборка.ИспользоватьХарактеристики Тогда
				ТекстИсключения = НСтр("ru = 'Для данной номенклатуры отключено использование характеристик.'");
				ВызватьИсключение ТекстИсключения;
			ИначеЕсли НЕ Выборка.ИндивидуальныеХарактеристикиНоменклатуры Тогда
				ОтборПоВладельцу = Выборка.ВидНоменклатуры;
			КонецЕсли;
		КонецЕсли;
		
		Параметры.Отбор.Вставить("Владелец", ОтборПоВладельцу);
		
	КонецЕсли;
	
	Если ОтборПоВладельцу <> Неопределено Тогда 
		Заголовок = НСтр("ru = 'Характеристики:'");
		ТипВладельца = ТипЗнч(ОтборПоВладельцу);
		Если ТипВладельца = Тип("СправочникСсылка.ВидыНоменклатуры") Тогда 
			Заголовок = НСтр("ru = 'Общие характеристики вида номенклатуры:'");
		ИначеЕсли ТипВладельца = Тип("СправочникСсылка.Номенклатура") Тогда 
			Заголовок = НСтр("ru = 'Характеристики номенклатуры:'");
		КонецЕсли;
		Заголовок = СтрШаблон("%1 %2", Заголовок, ОтборПоВладельцу)
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
