// Назначение модуля: Поддержание нормализованного номера лицевого счета и защита от дублирования при записи.
// Перед записью формирует поисковый ключ из кода лицевого счета и проверяет его уникальность. 
//Управляемая блокировка защищает от одновременного создания эквивалентных номеров.
Процедура ПередЗаписью(Отказ)
	
	НомерЛСДляПоиска = РОТКО_Биллинг.НормализоватьНомерЛС(Код);
	
	// При обмене с признаком Загрузка сохраняем вычисленный ключ, но проверки дублирования выполняем после загрузки отдельно.
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(НомерЛСДляПоиска) Тогда
		Возврат;
	КонецЕсли;
	
	// Простой безопасный вариант: сериализовать изменение справочника.
	// Цена: одновременные записи разных лицевых счетов будут ожидать.
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.ЛицевыеСчета");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЛС.Ссылка КАК ЛицевойСчет
	|ИЗ
	|	Справочник.ЛицевыеСчета КАК ЛС
	|ГДЕ
	|	ЛС.НомерЛСДляПоиска = &Номер
	|	И ЛС.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Номер", НомерЛСДляПоиска);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		Отказ = Истина;
		Сообщить("Лицевой счет с эквивалентным номером уже существует: " + НомерЛСДляПоиска);
	КонецЕсли;
	
КонецПроцедуры
