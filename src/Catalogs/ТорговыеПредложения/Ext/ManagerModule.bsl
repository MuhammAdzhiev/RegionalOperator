#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Обработчик обновления.
// 
// Параметры:
//  Параметры - Структура - параметры.
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолучитьКоличествоВыборки(Параметры);
	
	ПроблемныхОбъектов = 0;
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	ОбъектовОбработано = 0;
	ОбъектовУжеОбработано = Параметры.ПрогрессВыполнения.ОбработаноОбъектов;
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ДополнительныеИсточникиДанных.Вставить("УдалитьТовары.Номенклатура");
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(
	        Параметры.Очередь, "Справочник.ТорговыеПредложения", ДополнительныеПараметры);
			
	
	Пока Выборка.Следующий() Цикл
		
		СсылкаТорговоеПредложение = Выборка.Ссылка;
		
		Попытка
			
			ЗаполнитьРегистрТоварыТорговыхПредложений(СсылкаТорговоеПредложение);
			
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(СсылкаТорговоеПредложение);
			
		Исключение
			
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не удалось обработать заказ покупателя: %1 по причине:
						|%2'"), СсылкаТорговоеПредложение, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Предупреждение,
					Метаданные.Справочники.ТорговыеПредложения, СсылкаТорговоеПредложение, ТекстСообщения);
		КонецПопытки;
		
		ОбъектовОбработано = ОбъектовОбработано + 1;
		
	КонецЦикла;
	
	Параметры.ПрогрессВыполнения.ОбработаноОбъектов = ОбъектовОбработано + ОбъектовУжеОбработано;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(
	        Параметры.Очередь, "Справочник.ТорговыеПредложения");
	
	Если ОбъектовОбработано = 0 И НЕ Параметры.ОбработкаЗавершена Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		    НСтр("ru = 'Процедуре ОбработатьДанныеДляПереходаНаНовуюВерсию не удалось обработать некоторые торговые предложения (пропущены): %1'"),
		        ПроблемныхОбъектов);
		
		ВызватьИсключение ТекстСообщения;
		
	КонецЕсли;
	
КонецПроцедуры

// Регистрирует данные для обработчика обновления
// 
// Параметры:
//  Параметры - Структура - параметры.
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаОбновления();
	
	Результат = Запрос.Выполнить().Выгрузить();
	МассивСсылок = Результат.ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, МассивСсылок);
	
КонецПроцедуры

// См. ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы.
Функция ДанныеОбновленыНаНовуюВерсиюПрограммы(МетаданныеИОтбор) Экспорт
	
	МетаданныеИОтборТорговыеПредложения = Неопределено;
	Результат = Истина;
	
	Если МетаданныеИОтбор.ПолноеИмя = "Справочник.ТорговыеПредложения" Тогда
		
		МетаданныеИОтборТорговыеПредложения = МетаданныеИОтбор;
		
	ИначеЕсли МетаданныеИОтбор.ПолноеИмя = "РегистрСведений.ТоварыТорговыхПредложений" Тогда
		
		Если МетаданныеИОтбор.Отбор.Свойство("ТорговоеПредложение") Тогда
			МетаданныеИОтборТорговыеПредложения = ОбновлениеИнформационнойБазы.МетаданныеИОтборПоДанным(
				МетаданныеИОтбор.Отбор.ТорговоеПредложение);
		КонецЕсли;
		
	КонецЕсли;
	
	Если МетаданныеИОтборТорговыеПредложения <> Неопределено Тогда
		Результат = ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы(МетаданныеИОтборТорговыеПредложения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет данные из табличной части документа в Регистр сведений
// 
// Параметры:
//  СсылкаТорговоеПредложение - Ссылка на объект "Торговое предложение".
Процедура ЗаполнитьРегистрТоварыТорговыхПредложений(СсылкаТорговоеПредложение)
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		
		ЭлементБлокировки = Блокировка.Добавить("Справочник.ТорговыеПредложения");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", СсылкаТорговоеПредложение);
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ТоварыТорговыхПредложений");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("ТорговоеПредложение", СсылкаТорговоеПредложение);
		
		Блокировка.Заблокировать();
		
		НаборЗаписи = РегистрыСведений.ТоварыТорговыхПредложений.СоздатьНаборЗаписей();
		НаборЗаписи.Отбор.ТорговоеПредложение.Установить(СсылкаТорговоеПредложение);
		НаборЗаписи.Прочитать();
		
		// Если объект был обработан другими сеансами, пропускаем его.
		Если НаборЗаписи.Количество() > 0 Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТорговыеПредложенияУдалитьТовары.Ссылка КАК ТорговоеПредложение,
		|	ТорговыеПредложенияУдалитьТовары.Номенклатура КАК Номенклатура,
		|	ТорговыеПредложенияУдалитьТовары.Характеристика КАК Характеристика,
		|	ТорговыеПредложенияУдалитьТовары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ЛОЖЬ КАК НетВПрайсе,
		|	0 КАК Количество,
		|	0 КАК Оценка,
		|	МАКСИМУМ(ТорговыеПредложенияУдалитьТовары.Цена) КАК Цена
		|ИЗ
		|	Справочник.ТорговыеПредложения.УдалитьТовары КАК ТорговыеПредложенияУдалитьТовары
		|ГДЕ
		|	ТорговыеПредложенияУдалитьТовары.Ссылка = &СсылкаТорговоеПредложение
		|
		|СГРУППИРОВАТЬ ПО
		|	ТорговыеПредложенияУдалитьТовары.Номенклатура,
		|	ТорговыеПредложенияУдалитьТовары.Ссылка,
		|	ТорговыеПредложенияУдалитьТовары.Характеристика,
		|	ТорговыеПредложенияУдалитьТовары.Номенклатура.ЕдиницаИзмерения";
		
		Запрос.УстановитьПараметр("СсылкаТорговоеПредложение", СсылкаТорговоеПредложение);
		НаборЗаписи.Загрузить(Запрос.Выполнить().Выгрузить());
		
		Если НаборЗаписи.Количество() Тогда
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписи);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		
		ОтменитьТранзакцию();
		
		ВызватьИсключение ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

// Регистрирует Количество ссылок для обработчика обновления
// 
// Параметры:
//  Параметры - Структура - параметры.
Процедура ПолучитьКоличествоВыборки(Параметры)
	
	Если Параметры.ПрогрессВыполнения.ВсегоОбъектов = 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапросаОбновления();
		
		Параметры.ПрогрессВыполнения.ВсегоОбъектов = Запрос.Выполнить().Выгрузить().Количество();
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает текст запроса регистрации данных для обновления
Функция ТекстЗапросаОбновления()

	Возврат "ВЫБРАТЬ
			|	ТорговыеПредложения.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ТорговыеПредложения КАК ТорговыеПредложения
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТоварыТорговыхПредложений КАК ТоварыТорговыхПредложений
			|		ПО ТорговыеПредложения.Ссылка = ТоварыТорговыхПредложений.ТорговоеПредложение
			|ГДЕ
			|	ТоварыТорговыхПредложений.ТорговоеПредложение ЕСТЬ NULL";

КонецФункции

#КонецОбласти

#КонецЕсли