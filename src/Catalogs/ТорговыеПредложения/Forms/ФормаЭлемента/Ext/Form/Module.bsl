&НаСервере
Процедура НастроитьФормуПослеИзмененияНастроекПубликации(Параметр)
	
	ЦеныПубликуются = Параметр.ПубликоватьЦены;
	
	ВариантыПубликацииКоличества = Новый Массив;
	
	ВариантыПубликацииКоличества.Добавить(Перечисления.ВариантыПубликацииОстатковТорговыеПредложения.Количество);
	ВариантыПубликацииКоличества.Добавить(Перечисления.ВариантыПубликацииОстатковТорговыеПредложения.КоличествоИНаличие);
	
	ВариантыПубликацииОценки = Новый Массив;
	
	ВариантыПубликацииОценки.Добавить(Перечисления.ВариантыПубликацииОстатковТорговыеПредложения.Наличие);
	ВариантыПубликацииОценки.Добавить(Перечисления.ВариантыПубликацииОстатковТорговыеПредложения.КоличествоИНаличие);
	ВариантыПубликацииОценки.Добавить(Перечисления.ВариантыПубликацииОстатковТорговыеПредложения.ПустаяСсылка());
	
	Элементы.ТоварыКоличество.Видимость = 
		(Параметр.ПубликоватьОстатки
			И ВариантыПубликацииКоличества.Найти(Параметр.ВариантПубликацииОстатков) <> Неопределено);
			
	Элементы.ТоварыОценка.Видимость =
		(Параметр.ПубликоватьОстатки 
			И ВариантыПубликацииОценки.Найти(Параметр.ВариантПубликацииОстатков) <> Неопределено);
			
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПредставлениеМинимальнойСуммыЗаказа()
	
	Если ЗначениеЗаполнено(Объект.МинимальнаяСуммаЗаказа) Тогда
		МинимальнаяСуммаЗаказаПредставление = СтрШаблон("%1 %2", Формат(Объект.МинимальнаяСуммаЗаказа, "ЧДЦ=2"), Валюта);
	Иначе
		МинимальнаяСуммаЗаказаПредставление = НСтр("ru = 'Любая'");
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВалютуНДС()
	
	Ответ = ПолучитьРеквизитыВидаЦен(Объект.ВидЦены);
	
	Если Ответ = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Валюта = Ответ.Валюта;
	ЦенаВключаетНДС = Ответ.ЦенаВключаетНДС;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыВидаЦен(ВидЦены)
	
	Если НЕ ЗначениеЗаполнено(ВидЦены) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Ответ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидЦены, "Валюта, ЦенаВключаетНДС");
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Ответ;
	
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьСправкиЦеныИНаличие()
	
	Если Объект.ОбновлятьОстаткиИЦены Тогда
		
		Элементы.ОбновлятьОстаткиИЦены.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
		
	Иначе
		
		Элементы.ОбновлятьОстаткиИЦены.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчетНомераСтрок(Форма)

	НомерСтроки = 0;
	
	Для Каждого Товар Из Форма.Товары Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		Товар.НомерСтроки = НомерСтроки
		
	КонецЦикла;


КонецПроцедуры // ПересчетНомераСтрок()

&НаКлиенте
Процедура ДобавитьПоШтрихкодуПослеПоиска(Результат, Контекст) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		Штрихкоды = Результат;
	Иначе
		Штрихкоды = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Результат);
	КонецЕсли;
	
	Для каждого ТекущийШтрихкод Из Штрихкоды Цикл
		
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущийШтрихкод);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, РеквизитыНоменклатуры(НоваяСтрока.Номенклатура, "ЕдиницаИзмерения"));
		НоваяСтрока.НомерСтроки = Товары.Количество();
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗагрузитьИзВнешнегоФайла_Завершение(Результат, Параметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		Товары.Очистить();
		
		НомерСтроки = 0;
		Для Каждого СтрокаРезультата Из Результат Цикл
			
			НомерСтроки = НомерСтроки + 1;
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультата);
			НоваяСтрока.НомерСтроки = НомерСтроки;
		
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	КлиентЭДО.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект, ,"Товары.ХарактеристикиИспользуются");
	
	// Оценка не заполнена.
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", "");
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыОценка.Имя);
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.Оценка");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = -1;
	
	// Нет на складе
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Нет на складе'"));
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыОценка.Имя);
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.Оценка");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 0;
	
	// Мало
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Мало'"));
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыОценка.Имя);
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.Оценка");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 1;
	
	// Достаточно
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Достаточно'"));
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыОценка.Имя);
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.Оценка");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 2;
	
	// Много
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Много'"));
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыОценка.Имя);
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.Оценка");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 3;
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Отображать", Ложь);

	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыКоличество.Имя);
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыОценка.Имя);
	
	ОтборГруппа = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ОтборГруппа.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ОтборЭлемента = ОтборГруппа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.НетВПрайсе");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

	ОтборЭлемента = ОтборГруппа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОбновлятьОстаткиИЦены");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<Не публикуется по данным прайс-листа>'"));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Синий);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ГоризонтальноеПоложение", ГоризонтальноеПоложение.Лево);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыЦена.Имя);
	
	ОтборГруппа = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ОтборГруппа.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ОтборЭлемента = ОтборГруппа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.НетВПрайсе");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ОтборЭлемента = ОтборГруппа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОбновлятьОстаткиИЦены");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьПоУсловию_Завершение(РезультатВопроса,ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса=КодВозвратаДиалога.Да Тогда 
		ОткрытьФорму("Справочник.ТорговыеПредложения.Форма.ФормаВыбораНоменклатуры",
			Новый Структура("Настройки",КомпоновщикНастроек.Настройки),
			ЭтотОбъект.УникальныйИдентификатор,
			,,,
			Новый ОписаниеОповещения("ПриЗакрытииФормыВыбранныхОбъектов",ЭтотОбъект));
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьПоУсловию_Завершение()

&НаКлиенте
Процедура ПриЗакрытииФормыВыбранныхОбъектов(Настройки, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Настройки) = Тип("НастройкиКомпоновкиДанных") Тогда
		
		КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
		ЗаполнитьТоварыОтбора();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыОтбора()

	Товары.Очистить();
	СхемаКомпоновки = РеквизитФормыВЗначение("Объект").ПолучитьМакет("СхемаВыгрузки");
	
	ТаблицаДанныеПакетаПредложений = Новый ТаблицаЗначений;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	СхемаКомпоновкиДанных = Новый СхемаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, КомпоновщикНастроек.Настройки,,,
	           Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"), Ложь);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,,,);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	ПроцессорВывода.УстановитьОбъект(ТаблицаДанныеПакетаПредложений);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	Товары.Загрузить(ТаблицаДанныеПакетаПредложений);
	
	НомерСтроки = 0;
	
	Для Каждого Товар Из Товары Цикл
		
		НомерСтроки = НомерСтроки + 1;
		Товар.НомерСтроки = НомерСтроки;
		
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьТоварыОтбора()

&НаКлиенте
Процедура ОбновитьЗавершить(ВыделенныеСтроки)
	
	ДлительнаяОперация = ОбновитьПоДаннымПрайсЛистаНаСервере(ВыделенныеСтроки);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	
	ПараметрыОжидания.Интервал = 2;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
	        ДлительнаяОперация,
	        Новый ОписаниеОповещения("ОбновитьПоДаннымПрайсЛистаНаСервереВыполнено", ЭтотОбъект),
	        ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоДаннымПрайсЛистаНаСервереВыполнено(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
		
	ИначеЕсли Результат.Статус = "Выполнено" Тогда
		
		ПрочитатьТоварыТорговогоПредложения();
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОбновитьПоДаннымПрайсЛистаНаСервере(ВыделенныеСтроки)
	
	СписокТоваров = Новый ТаблицаЗначений;
	
	СписокТоваров.Колонки.Добавить("Номенклатура"	 , Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	СписокТоваров.Колонки.Добавить("Характеристика"	 , Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	СписокТоваров.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.ЕдиницыИзмерения"));
	СписокТоваров.Колонки.Добавить("Организация"	 , Новый ОписаниеТипов("СправочникСсылка.Организации"));
	
	СписокТоваров.Очистить();
	
	Для Каждого Индекс Из ВыделенныеСтроки Цикл
		
		СтрокаТаблицы = Товары.Получить(Индекс);
		НоваяСтрока = СписокТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.Организация = Объект.Организация;
		
	КонецЦикла;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СписокТоваров", СписокТоваров);
	СтруктураПараметров.Вставить("ТорговоеПредложение", Объект.Ссылка);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Обновление товаров торгового предложения'");
	
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(
	        "РегистрыСведений.ПрайсЛист.ОбновитьТоварыТорговыхПредложений",
	        СтруктураПараметров,
	        ПараметрыВыполнения);
	
	Возврат ДлительнаяОперация;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьЦенуНаПроцент_Завершение(РезультатВыполнения,ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(РезультатВыполнения) Тогда
		
		Для Каждого Индекс Из Элементы.Товары.ВыделенныеСтроки Цикл
			
			СтрокаТаблицы = Элементы.Товары.ДанныеСтроки(Индекс);
			
			СуммаПроцента = РезультатВыполнения.Процент * СтрокаТаблицы.Цена/100;
					
			Если РезультатВыполнения.Уменьшить Тогда
				СтрокаТаблицы.Цена = СтрокаТаблицы.Цена - СуммаПроцента;
			Иначе 
				СтрокаТаблицы.Цена = СтрокаТаблицы.Цена + СуммаПроцента;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ИзменитьЦенуНаПроцент_Завершение()

&НаКлиенте
Процедура УстановкаОценки_Завершение(Значение,ДополнительныеПараметры) Экспорт
	
	Если Значение<>Неопределено Тогда
		
		Для Каждого Индекс Из Элементы.Товары.ВыделенныеСтроки	Цикл 
			Элементы.Товары.ДанныеСтроки(Индекс).Оценка=Значение.Значение;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ВыборВидаОценки_Завершение()

&НаКлиенте
Процедура СформироватьЗаголовокСрокПоставки()

	Если Объект.СрокПоставки = 0 Тогда
		
		СрокПоставки = НСтр("ru = 'В наличии'");
		
	Иначе
		
		СрокПоставки = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		        НСтр("ru = ';%1 день;;%1 дня;%1 дней;%1 дня'"),
		        Объект.СрокПоставки);
	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗаголовокВидыЦен()
	
	Элементы.ДекорацияВидЦены.Заголовок = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
		НСтр("ru = '%1 (%2) • %3'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()), 
		?(ЗначениеЗаполнено(Объект.ВидЦены), 
			Строка(Объект.ВидЦены), 
			НСтр("ru = '<span style=""color: ПоясняющийОшибкуТекст"">Вид цены не выбран</span>'", 
				ОбщегоНазначенияКлиент.КодОсновногоЯзыка())), 
		?(Не ПустаяСтрока(Валюта), 
			Строка(Валюта), 
			НСтр("ru = '<span style=""color: ПоясняющийОшибкуТекст"">Валюта не выбрана</span>'", 
				ОбщегоНазначенияКлиент.КодОсновногоЯзыка())), 
		?(ЦенаВключаетНДС, НСтр("ru = 'НДС в сумме'"), НСтр("ru = 'НДС сверху'")));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборВидаЦен_Завершение(Результат, ДопПараметры) Экспорт 
	
	Если Результат<>Неопределено Тогда
		
		Ответ = ПолучитьРеквизитыВидаЦен(Результат);
		
		Если Ответ = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		Объект.ВидЦены = Результат;
		Валюта = Ответ.Валюта;
		ЦенаВключаетНДС = Ответ.ЦенаВключаетНДС;
		
		СформироватьЗаголовокВидыЦен();
		СформироватьПредставлениеМинимальнойСуммыЗаказа();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьТоварыТорговогоПредложения()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыТорговыхПредложений.Номенклатура КАК Номенклатура,
		|	ТоварыТорговыхПредложений.Характеристика КАК Характеристика,
		|	ТоварыТорговыхПредложений.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ТоварыТорговыхПредложений.НетВПрайсе КАК НетВПрайсе,
		|	ТоварыТорговыхПредложений.Количество КАК Количество,
		|	ТоварыТорговыхПредложений.Оценка КАК Оценка,
		|	ТоварыТорговыхПредложений.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ТоварыТорговыхПредложений КАК ТоварыТорговыхПредложений
		|ГДЕ
		|	ТоварыТорговыхПредложений.ТорговоеПредложение = &ТорговоеПредложение";
	
	Если ЗначениеЗаполнено(Объект.ТорговоеПредложениеРодитель) Тогда 
			Запрос.УстановитьПараметр("ТорговоеПредложение", Объект.ТорговоеПредложениеРодитель);
	Иначе 	
			Запрос.УстановитьПараметр("ТорговоеПредложение", Объект.Ссылка);
	КонецЕсли;
	
	
	Товары.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ПересчетНомераСтрок(ЭтотОбъект);
	
	КлиентЭДО.ЗаполнитьПризнакИспользованияХарактеристик(Товары);
	
КонецПроцедуры 

&НаСервере
Процедура ПрочитатьНастройкиПубликации(ТорговоеПредложение)
	
	НастройкиПубликации = ТорговыеПредложения.НастройкиПубликации(ТорговоеПредложение);
	
	Если НастройкиПубликации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НастроитьФормуПослеИзмененияНастроекПубликации(НастройкиПубликации);
	
КонецПроцедуры

// ЭлектронноеВзаимодействие.ТорговыеПредложения
&НаСервере
Процедура ОбновитьДанныеПубликацииТорговыхПредложений()
	
	ТорговыеПредложения.ИнициализацияЭлементовФормы(ЭтотОбъект, Элементы.ГруппаУправленияТорговымиПредложениями);
	
КонецПроцедуры
// Конец ЭлектронноеВзаимодействие.ТорговыеПредложения

&НаКлиенте
Процедура СрокПоставкиЗавершение(Число,ДополнительныеПараметры) Экспорт
	
	Если Число <> Неопределено Тогда 
			Объект.СрокПоставки = Число;
	КонецЕсли;
	
	СформироватьЗаголовокСрокПоставки();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьГруппыТовары()
	
	Элементы.СтраницаТовары.Видимость = Не Объект.ПоВсемТоварам;
	
КонецПроцедуры // УстановитьВидимостьГруппыТовары()

&НаКлиенте
Процедура УстановитьВидимостьГруппыКонтрагенты()
	
	Элементы.СтраницаКонтрагенты.Видимость = НЕ ПоВсемКонтрагентам;
	
КонецПроцедуры // УстановитьВидимостьГруппыКонтрагенты()

&НаСервереБезКонтекста
Функция РеквизитыНоменклатуры(Знач СсылкаНаОбъект, Знач Реквизиты);
	
	Возврат КлиентЭДО.РеквизитыНоменклатурыПриИзменении(СсылкаНаОбъект, Реквизиты);
	
КонецФункции

&НаКлиенте
Процедура МинимальнаяСуммаЗаказаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.МинимальнаяСуммаЗаказа = Результат;
	
	СформироватьПредставлениеМинимальнойСуммыЗаказа();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЦеныПоДаннымПрайсЛиста(ОбновитьВсеСтроки = Ложь)
	
	ОчиститьСообщения();
	
	ВыделенныеСтроки = Новый Массив;
	Если ОбновитьВсеСтроки Тогда
		Для Каждого СтрокаТаблицы Из Товары Цикл
			ВыделенныеСтроки.Добавить(Товары.Индекс(СтрокаТаблицы));
		КонецЦикла;
	Иначе
		Для Каждого Индекс Из Элементы.Товары.ВыделенныеСтроки Цикл
			СтрокаТаблицы = Товары.НайтиПоИдентификатору(Индекс);
			ВыделенныеСтроки.Добавить(Товары.Индекс(СтрокаТаблицы));
		КонецЦикла;
	КонецЕсли;
	
	Если Модифицированность Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);
		
		Оповещение = Новый ОписаниеОповещения("ПоказатьВопросЗаписиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ТекстВопроса = НСтр("ru = 'Данные были изменены. Для продолжения необходимо записать изменения.'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, , КодВозвратаДиалога.Ок);
		
	Иначе
		ОбновитьЗавершить(ВыделенныеСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросЗаписиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.ОК Тогда
		
		Если НЕ Записать() Тогда
			
			ШаблонСообщения = НСтр("ru = 'Не удалось записать объект %1 ! %2'");
			ТекстСообщения = СтрШаблон(
				ШаблонСообщения, Объект.Ссылка, ОбработкаОшибок.КраткоеПредставлениеОшибки (ОписаниеОшибки()));
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			Возврат;
			
		КонецЕсли;
		
		ОбновитьЗавершить(ДополнительныеПараметры.ВыделенныеСтроки);
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
