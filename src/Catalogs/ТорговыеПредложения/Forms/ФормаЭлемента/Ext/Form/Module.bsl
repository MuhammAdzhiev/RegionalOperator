
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.ДатаНачалаДействия = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ЗаполнитьВалютуНДС();
	
	ИспользуетсяНесколькоОрганизацийЭД = Справочники.Организации.ИспользуетсяНесколькоОрганизаций();
	
	Если ЗначениеЗаполнено(Объект.Организация) И Не ИспользуетсяНесколькоОрганизацийЭД Тогда
		
		Элементы.Организация.Видимость = Ложь;
		
	КонецЕсли;
	
	// ЭлектронноеВзаимодействие.ТорговыеПредложения
	ОбновитьДанныеПубликацииТорговыхПредложений();
	// Конец ЭлектронноеВзаимодействие.ТорговыеПредложения
	
	ПрочитатьТоварыТорговогоПредложения();
	КлиентЭДО.ЗаполнитьПризнакИспользованияХарактеристик(Товары);
	
	ПрочитатьНастройкиПубликации(Объект.Ссылка);
	
	ПоВсемКонтрагентам = Объект.Контрагенты.Количество() = 0;
	
	ИспользоватьХарактеристикиНоменклатуры  = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	Элементы.ТоварыХарактеристика.Видимость = ИспользоватьХарактеристикиНоменклатуры;
	
	СхемаВыгрузкиДанных = РеквизитФормыВЗначение("Объект").ПолучитьМакет("СхемаВыгрузки");
	
	АдресСхемы = ПоместитьВоВременноеХранилище(СхемаВыгрузкиДанных, УникальныйИдентификатор);
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы)); 
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаВыгрузкиДанных.НастройкиПоУмолчанию);
	
	Элементы.ОграничениеПоКонтрагентам.Доступность = НЕ ТолькоПросмотр;
	Элементы.СрокПоставки.Доступность              = НЕ ТолькоПросмотр;
	Элементы.ДекорацияВидЦены.Доступность          = НЕ ТолькоПросмотр;
	Элементы.ТоварыКнопкаОбновить.Доступность      = НЕ ТолькоПросмотр;
	Элементы.МинимальнаяСуммаЗаказа.Доступность    = НЕ ТолькоПросмотр;
		
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ЭтоНовый", ТекущийОбъект.Ссылка.Пустая());
	
	ПроверкаНаДубли = ЭтотОбъект.Товары.Выгрузить(,"Характеристика, Номенклатура, ЕдиницаИзмерения");
	ПроверкаНаДубли.Колонки.Добавить("Количество");
	ПроверкаНаДубли.ЗаполнитьЗначения(1,"Количество");
	ПроверкаНаДубли.Свернуть("Характеристика, Номенклатура, ЕдиницаИзмерения","Количество");
	
	Шаблон = НСтр("ru = 'По товару %1 в табличной части найдено %2'");
	
	Для Каждого СтрокаПроверки Из ПроверкаНаДубли Цикл
		
		Если СтрокаПроверки.Количество > 1 Тогда
			Отказ = Истина;
			
			Строк = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru = ';%1 строка;;%1 строки;%1 строк;%1 строки'"),
			СтрокаПроверки.Количество);
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = СтрШаблон(Шаблон, СтрокаПроверки.Номенклатура, Строк);
			Сообщение.Поле = "Товары";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТекущийОбъект.ТорговоеПредложениеРодитель = Справочники.ТорговыеПредложения.ПустаяСсылка();
	
	// ЭлектронноеВзаимодействие.ТорговыеПредложения
	ТорговыеПредложения.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, Объект.Организация, Элементы.ГруппаУправленияТорговымиПредложениями, Отказ);
	// Конец ЭлектронноеВзаимодействие.ТорговыеПредложения

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// ЭлектронноеВзаимодействие.ТорговыеПредложения
	ТорговыеПредложения.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, Объект.Организация, Элементы.ГруппаУправленияТорговымиПредложениями);
	// Конец ЭлектронноеВзаимодействие.ТорговыеПредложения
	
	КлиентЭДО.ВосстановитьПризнакИспользованияХарактеристик(Товары, ПараметрыЗаписи);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СформироватьЗаголовокВидыЦен();
	СформироватьЗаголовокСрокПоставки();
	СформироватьПредставлениеМинимальнойСуммыЗаказа();
	УстановитьВидимостьГруппыТовары();
	УстановитьВидимостьГруппыКонтрагенты();
	УстановитьВидимостьСправкиЦеныИНаличие();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// ЭлектронноеВзаимодействие.ТорговыеПредложения
	ТорговыеПредложенияКлиент.ПослеЗаписи(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ТорговыеПредложения
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЭтотОбъект.Модифицированность ИЛИ ТекущийОбъект.ДополнительныеСвойства.ЭтоНовый Тогда
		
		НачатьТранзакцию();
		Попытка
			
			БлокировкаДанных = Новый БлокировкаДанных;
			ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ТоварыТорговыхПредложений");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.УстановитьЗначение("ТорговоеПредложение", ТекущийОбъект.Ссылка);
			БлокировкаДанных.Заблокировать();
			
			НаборТоваров = РегистрыСведений.ТоварыТорговыхПредложений.СоздатьНаборЗаписей();
			НаборТоваров.Отбор.ТорговоеПредложение.Установить(ТекущийОбъект.Ссылка);
			
			ТаблицаТоваров = ЭтотОбъект.Товары.Выгрузить();
			ТаблицаТоваров.Колонки.Добавить("ТорговоеПредложение");
			ТаблицаТоваров.ЗаполнитьЗначения(ТекущийОбъект.Ссылка, "ТорговоеПредложение");
			
			Если НЕ Объект.ОбновлятьОстаткиИЦены Тогда
				ТаблицаТоваров.ЗаполнитьЗначения(Ложь, "НетВПрайсе");
				ЭтотОбъект.Товары.Загрузить(ТаблицаТоваров);
			КонецЕсли;
			
			НаборТоваров.Загрузить(ТаблицаТоваров);
			НаборТоваров.Записать();
			
			ЗафиксироватьТранзакцию();
		Исключение
			
			ОтменитьТранзакцию();
			
			ВидОперации = НСтр("ru = 'Сохранение торгового предложения'");
			ТекстСообщения = НСтр("ru = 'Не удалось сохранить торговое предложение'");
			ПодробныйТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			ЭлектронноеВзаимодействие.ОбработатьОшибку(
				ВидОперации,
				ПодробныйТекстОшибки, 
				ТекстСообщения, 
				"ТорговыеПредложения",
				ТекущийОбъект.Ссылка);
				
		КонецПопытки;
			
	КонецЕсли;
	
	КлиентЭДО.КэшироватьПризнакИспользованияХарактеристик(Товары, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// ЭлектронноеВзаимодействие.ТорговыеПредложения
	Если ИмяСобытия = "ТорговыеПредложения_ИзменениеСинхронизации"
		И (Параметр = Неопределено ИЛИ Параметр = Объект.Ссылка) Тогда
		ОбновитьДанныеПубликацииТорговыхПредложений();
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ТорговыеПредложения
	
	Если ИмяСобытия = "ТорговыеПредложения_ЗаписьДополнительныеНастройки"
	        И Параметр.ТорговоеПредложение = Объект.Ссылка Тогда
			
		НастроитьФормуПослеИзмененияНастроекПубликации(Параметр);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СрокПоставкиНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("СрокПоставкиЗавершение",ЭтотОбъект);
	
	ПоказатьВводЧисла(Оповещение, Объект.СрокПоставки,
	    НСтр("ru = 'Введите срок поставки'"),
	    3,
	    0);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ПоВсемКонтрагентам Тогда
		Объект.Контрагенты.Очистить();
	КонецЕсли;
	
	Если Объект.ПоВсемТоварам Тогда
		Объект.ОбновлятьОстаткиИЦены = Истина;
		Товары.Очистить();
	КонецЕсли;

	Для Каждого Товар Из Товары Цикл
		
		Если ЦеныПубликуются
			И Товар.Цена = 0
			И Не (Объект.ОбновлятьОстаткиИЦены И Товар.НетВПрайсе) Тогда
			
			Отказ = Истина;
			
			ШаблонСтроки = НСтр("ru = 'Для номенклатуры ""%1"" не заполнена цена'");
			ТекстОшибки = СтрШаблон(ШаблонСтроки, Товар.Номенклатура);
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = ТекстОшибки;
			Сообщение.Поле = СтрШаблон("Товары[%1].Цена", Товары.Индекс(Товар));
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Товар.Номенклатура) Тогда
			
			Отказ = Истина;
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = СтрШаблон(НСтр("ru = 'В строке %1 не задана номенклатура.'"), Товары.Индекс(Товар)+1);
			Сообщение.Поле = "Товары["+Товары.Индекс(Товар)+"].Номенклатура";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Товар.ЕдиницаИзмерения) Тогда
			
			Отказ = Истина;
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = СтрШаблон(НСтр("ru = 'В строке %1 не задана единица измерения.'"), Товары.Индекс(Товар)+1);
			Сообщение.Поле = "Товары["+Товары.Индекс(Товар)+"].ЕдиницаИзмерения";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			
		КонецЕсли;
		
		Если Товар. ХарактеристикиИспользуются 
			И Не ЗначениеЗаполнено(Товар.Характеристика) Тогда
			
			Отказ = Истина;
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = СтрШаблон(НСтр("ru = 'В строке %1 не задана характеристика для товара.'"), Товары.Индекс(Товар)+1);
			Сообщение.Поле = "Товары["+Товары.Индекс(Товар)+"].Характеристика";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Объект.ВидЦены) Тогда
		
		Отказ = Истина;
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru = 'Вид цены не выбран'");
		Сообщение.Поле = "ДекорацияВидЦены";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДатаОкончанияДействия) Тогда
		
		Если Объект.ДатаОкончанияДействия < Объект.ДатаНачалаДействия Тогда
			
			Отказ = Истина;
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				НСтр("ru = 'Дата окончание периода не может быть меньше даты начала'"),
				Объект.Ссылка, "ДатаОкончанияДействия", "Объект");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДекорацияПЛОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФорму("РегистрСведений.ПрайсЛист.Форма.ФормаПрайсЛиста");
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияВидЦеныНажатие(Элемент)
	
	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("Ключ" , Объект.ВидЦены);
	ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе" , Истина);
	
	ОткрытьФорму("Справочник.ВидыЦен.ФормаВыбора",
	    ПараметрыОткрытия,
	    УникальныйИдентификатор,
	    ,,,
	    Новый ОписаниеОповещения("ВыборВидаЦен_Завершение",ЭтотОбъект),
	    РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыИзСпискаПриИзменении(Элемент)
	
	УстановитьВидимостьГруппыТовары();
	
КонецПроцедуры

&НаКлиенте
Процедура ОграничениеПоКонтрагентамПриИзменении(Элемент)
	
	УстановитьВидимостьГруппыКонтрагенты();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияДействияПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.ДатаОкончанияДействия) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ДатаОкончанияДействия < Объект.ДатаНачалаДействия Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Дата окончание периода не может быть меньше даты начала'"),
			Объект.Ссылка, "ДатаОкончанияДействия", "Объект");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаДействияПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.ДатаОкончанияДействия) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ДатаОкончанияДействия < Объект.ДатаНачалаДействия Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Дата окончание периода не может быть меньше даты начала'"),
			Объект.Ссылка, "ДатаНачалаДействия", "Объект");
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновлятьОстаткиИЦеныПриИзменении(Элемент)
	Если Объект.ОбновлятьОстаткиИЦены Тогда
		ОбновитьЦеныПоДаннымПрайсЛиста(Истина);
	КонецЕсли;
	УстановитьВидимостьСправкиЦеныИНаличие();
КонецПроцедуры

&НаКлиенте
Процедура МинимальнаяСуммаЗаказаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("МинимальнаяСуммаЗаказаЗавершение", ЭтотОбъект);
	
	ПоказатьВводЧисла(Оповещение, Объект.МинимальнаяСуммаЗаказа,
		НСтр("ru = 'Введите минимальную суму заказа'"), 15, 2);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	ПересчетНомераСтрок(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)
	
	ПересчетНомераСтрок(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, РеквизитыНоменклатуры(ТекущиеДанные.Номенклатура, "ЕдиницаИзмерения"));
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
