#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ИНН = &ИНН
	|	И Организации.КПП = &КПП
	|	И Организации.ПометкаУдаления = ЛОЖЬ
	|	И Организации.Ссылка <> &Ссылка");
	
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Не РезультатЗапроса.Пустой() И Не ПометкаУдаления Тогда
		ТекстСообщения = НСтр("ru = 'Уже есть организация с таким ИНН и КПП.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
	КонецЕсли;
	
	Если (ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо
		ИЛИ ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент) Тогда
		СвидетельствоСерияНомер = "";
		СвидетельствоДатаВыдачи = Дата("00010101");
	Иначе
		КПП = "";
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьЗначениеОпцииИспользоватьНесколькоОрганизаций();
	
	ЗаполнитьСведенияОбОтветственныхЛицахПоУмолчанию();
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ОсновнойБанковскийСчет = Неопределено;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЗначениеОпцииИспользоватьНесколькоОрганизаций()
	
	Если НЕ Справочники.Организации.ИспользуетсяНесколькоОрганизаций()
		И Справочники.Организации.КоличествоОрганизаций() > 1 Тогда
		
		Справочники.Организации.ВключитьИспользованиеНесколькихОрганизаций();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОбОтветственныхЛицахПоУмолчанию()
	
	ОснованияПолномочийПоУмолчанию = Новый ТаблицаЗначений;
	ОснованияПолномочийПоУмолчанию.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ОснованияПолномочийПоУмолчанию.Колонки.Добавить("ФизическоеЛицо", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
	ОснованияПолномочийПоУмолчанию.Колонки.Добавить("Должность", Новый ОписаниеТипов("СправочникСсылка.Должности"));
	
	КвалификаторСтроки150 = Новый КвалификаторыСтроки(150);
	ОснованияПолномочийПоУмолчанию.Колонки.Добавить("ОснованиеПолномочий", Новый ОписаниеТипов("Строка",, КвалификаторСтроки150));
	
	Если ЗначениеЗаполнено(Руководитель) Тогда
		ДобавитьСтрокуОснованийПолномочий(ОснованияПолномочийПоУмолчанию, Ссылка, Руководитель,
			Справочники.Должности.ГенеральныйДиректор, "Устав");
		
	КонецЕсли;
	Если ЗначениеЗаполнено(ГлавныйБухгалтер) Тогда
		ДобавитьСтрокуОснованийПолномочий(ОснованияПолномочийПоУмолчанию, Ссылка, ГлавныйБухгалтер,
			Справочники.Должности.ГлавныйБухгалтер, "Доверенность");
		
	КонецЕсли;
	
	Если Не ОснованияПолномочийПоУмолчанию.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОснованияПолномочийПоУмолчанию.Организация КАК Организация,
	|	ОснованияПолномочийПоУмолчанию.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ОснованияПолномочийПоУмолчанию.Должность КАК Должность,
	|	ОснованияПолномочийПоУмолчанию.ОснованиеПолномочий КАК ОснованиеПолномочий
	|ПОМЕСТИТЬ ВТ_ПоУмолчанию
	|ИЗ
	|	&ОснованияПолномочийПоУмолчанию КАК ОснованияПолномочийПоУмолчанию
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	Должность
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПоУмолчанию.Организация КАК Организация,
	|	ВТ_ПоУмолчанию.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВТ_ПоУмолчанию.Должность КАК Должность,
	|	ВТ_ПоУмолчанию.ОснованиеПолномочий КАК ОснованиеПолномочий
	|ИЗ
	|	ВТ_ПоУмолчанию КАК ВТ_ПоУмолчанию
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОснованияПолномочийОтветственныхЛиц КАК ОснованияПолномочийОтветственныхЛиц
	|		ПО ВТ_ПоУмолчанию.Организация = ОснованияПолномочийОтветственныхЛиц.Организация
	|			И ВТ_ПоУмолчанию.Должность = ОснованияПолномочийОтветственныхЛиц.Должность
	|ГДЕ
	|	ОснованияПолномочийОтветственныхЛиц.ФизическоеЛицо ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ОснованияПолномочийПоУмолчанию", ОснованияПолномочийПоУмолчанию);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.ОснованияПолномочийОтветственныхЛиц.ЗаполнитьПоУмолчанию(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

Процедура ДобавитьСтрокуОснованийПолномочий(ОснованияПолномочийПоУмолчанию, Организация, ФизическоеЛицо, Должность, ОснованиеПолномочий)
	
	НоваяСтрока = ОснованияПолномочийПоУмолчанию.Добавить();
	НоваяСтрока.Организация = Организация;
	НоваяСтрока.ФизическоеЛицо = ФизическоеЛицо;
	НоваяСтрока.Должность = Должность;
	НоваяСтрока.ОснованиеПолномочий = ОснованиеПолномочий;
	
КонецПроцедуры


#КонецОбласти

#КонецЕсли
