// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПредставлениеОтветственныхЛицОрганизации(Форма) 
	
	ТекстЗаголовка = Форма.Элементы.ГруппаПодписи.Заголовок;
	
	ДанныеПодписей = Новый Массив;
	Если ЗначениеЗаполнено(Форма.Объект.Руководитель) Тогда
		ДанныеПодписей.Добавить(СтрШаблон(НСтр("ru = '%1 (Руководитель)'"), Форма.Объект.Руководитель));
	КонецЕсли;
	Если ЗначениеЗаполнено(Форма.Объект.ГлавныйБухгалтер) Тогда
		ДанныеПодписей.Добавить(СтрШаблон(НСтр("ru = '%1 (Главный бухгалтер)'"), Форма.Объект.ГлавныйБухгалтер));
	КонецЕсли;
	Если ДанныеПодписей.Количество() Тогда
		ПредставлениеОтветственныхЛиц = СтрСоединить(ДанныеПодписей, ", ");
		ТекстЗаголовка = СтрШаблон(НСтр("ru = '%1: %2'"), ТекстЗаголовка, ПредставлениеОтветственныхЛиц);
	КонецЕсли;
	
	Форма.Элементы.ГруппаПодписи.ЗаголовокСвернутогоОтображения = ТекстЗаголовка;

КонецПроцедуры

&НаКлиенте
Процедура РуководительПриИзменении(Элемент)
	
	ОбновитьПредставлениеОтветственныхЛицОрганизации(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ГлавныйБухгалтерПриИзменении(Элемент)
	
	ОбновитьПредставлениеОтветственныхЛицОрганизации(ЭтотОбъект);
	
КонецПроцедуры

