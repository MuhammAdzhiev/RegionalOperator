	ОписатьДокумент(Справочники.ВидыДокументовФизическихЛиц.ДипломатическийПаспорт,
		"", "09", НСтр("ru='ДИППАСПОРТ РФ'"), ПроблемныхОбъектов);
	ОписатьДокумент(Справочники.ВидыДокументовФизическихЛиц.ИностранныйПаспорт,
		НСтр("ru='Иностранный паспорт'"), "10", НСтр("ru='ИНПАСПОРТ'"), ПроблемныхОбъектов);
	ОписатьДокумент(Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОРегистрацииХодатайстваИммигрантаОПризнанииЕгоБеженцем,
		НСтр("ru='Свидетельство о регистрации ходатайства иммигранта о признании его беженцем'"), "11", НСтр("ru='СВИД БЕЖЕНЦА'"), ПроблемныхОбъектов);
