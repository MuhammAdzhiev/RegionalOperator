		НСтр("ru='Вид на жительство'"), "12", НСтр("ru='ВИД НА ЖИТЕЛЬ'"), ПроблемныхОбъектов);
	ОписатьДокумент(Справочники.ВидыДокументовФизическихЛиц.УдостоверениеБеженца,
		НСтр("ru='Удостоверение беженца'"), "13", НСтр("ru='УДОСТ БЕЖЕНЦА'"), ПроблемныхОбъектов);
	ОписатьДокумент(Справочники.ВидыДокументовФизическихЛиц.ВременноеУдостоверениеЛичностиГражданинаРФ,
		НСтр("ru='Временное удостоверение личности гражданина РФ'"), "14", НСтр("ru='ВРЕМ УДОСТ'"), ПроблемныхОбъектов);
