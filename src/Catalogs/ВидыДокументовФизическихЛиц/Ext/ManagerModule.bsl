	ОписатьДокумент(Справочники.ВидыДокументовФизическихЛиц.ИныеДокументыВыдаваемыеОрганамиМВД,
		НСтр("ru='Иные документы, выдаваемые органами МВД'"), "91", НСтр("ru='ПРОЧЕЕ'"), ПроблемныхОбъектов);
		
	Если ПроблемныхОбъектов = 0 Тогда
		Параметры.ОбработкаЗавершена = Истина;
	КонецЕсли;
		
