Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПроблемныхОбъектов = 0;
	
	ОписатьДокумент(Справочники.ВидыДокументовФизическихЛиц.ПаспортСССР,
		"", "01", НСтр("ru='ПАСПОРТ'"), ПроблемныхОбъектов);
	ОписатьДокумент(Справочники.ВидыДокументовФизическихЛиц.ЗагранпаспортСССР,
		"", "02", НСтр("ru='ЗГПАСПОРТ'"), ПроблемныхОбъектов);
	ОписатьДокумент(Справочники.ВидыДокументовФизическихЛиц.СвидетельствоОРождении,
		"", "03", НСтр("ru='СВИД О РОЖД'"), ПроблемныхОбъектов);
	ОписатьДокумент(Справочники.ВидыДокументовФизическихЛиц.УдостоверениеОфицера,
		"", "04", НСтр("ru='УДОСТ ОФИЦЕРА'"), ПроблемныхОбъектов);
	ОписатьДокумент(Справочники.ВидыДокументовФизическихЛиц.СправкаОбОсвобождении,
		НСтр("ru='Справка об освобождении'"), "05", НСтр("ru='СПРАВКА ОБ ОСВ'"), ПроблемныхОбъектов);
	ОписатьДокумент(Справочники.ВидыДокументовФизическихЛиц.ПаспортМинморфлота,
		"", "06", НСтр("ru='ПАСПОРТ МОРФЛТ'"), ПроблемныхОбъектов);
	ОписатьДокумент(Справочники.ВидыДокументовФизическихЛиц.ВоенныйБилет,
		НСтр("ru='Военный билет солдата (матроса, сержанта, старшины)'"), "07", НСтр("ru='ВОЕННЫЙ БИЛЕТ'"), ПроблемныхОбъектов);
	ОписатьДокумент(Справочники.ВидыДокументовФизическихЛиц.ВременноеУдостоверениеВыданноеВзаменВоенногоБилета,
