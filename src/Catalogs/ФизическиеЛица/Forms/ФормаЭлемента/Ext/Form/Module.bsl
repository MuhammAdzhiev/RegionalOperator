
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// СтандартныеПодсистемы.КонтактнаяИнформация
	ДополнительныеПараметры = УправлениеКонтактнойИнформацией.ПараметрыКонтактнойИнформации();
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаКонтактнаяИнформация");
	РазмещеныНаФорме = Новый Соответствие;
	РазмещеныНаФорме.Вставить(Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента, Истина);
	ДополнительныеПараметры.РазмещеныНаФорме = РазмещеныНаФорме;
	УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтотОбъект, Объект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	Если Параметры.Ключ.Пустая() Тогда
		ДокументыФизическихЛицНоваяЗапись = Истина;
		МенеджерЗаписи = РегистрыСведений.ДокументыФизическихЛиц.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Физлицо = Объект.Ссылка;
		
		ЗначениеВРеквизитФормы(МенеджерЗаписи, "ДокументыФизическихЛиц");
		
		МетаданныеРегистра = Метаданные.РегистрыСведений.ДокументыФизическихЛиц;
		ЗаписьКакСтруктура = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(МенеджерЗаписи, МетаданныеРегистра);
		ДокументыФизическихЛицПрежняя = Новый ФиксированнаяСтруктура(ЗаписьКакСтруктура);
		
	КонецЕсли;
	
	Если Не ПравоДоступа("Редактирование", Метаданные.Справочники.ФизическиеЛица) Тогда
		Элементы.ИзменитьЧастиФИО.Видимость = Ложь;
	КонецЕсли;
	
	ОбновитьЗаголовокУдостоверенияЛичности(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	Если Параметры.Ключ.Пустая() Тогда
		ДокументыФизическихЛицНоваяЗапись = Истина;
		МенеджерЗаписи = РегистрыСведений.ДокументыФизическихЛиц.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Физлицо = Объект.Ссылка;
		
		ЗначениеВРеквизитФормы(МенеджерЗаписи, "ДокументыФизическихЛиц");
		
		МетаданныеРегистра = Метаданные.РегистрыСведений.ДокументыФизическихЛиц;
		ЗаписьКакСтруктура = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(МенеджерЗаписи, МетаданныеРегистра);
		ДокументыФизическихЛицПрежняя = Новый ФиксированнаяСтруктура(ЗаписьКакСтруктура);
		
	Иначе
		ДокументыФизическихЛицНоваяЗапись = Ложь;
		МенеджерЗаписи = МенеджерПоследнейЗаписиДокументовФизическихЛиц(Объект.Ссылка);
		ЗначениеВРеквизитФормы(МенеджерЗаписи, "ДокументыФизическихЛиц");
		
		МетаданныеРегистра = Метаданные.РегистрыСведений.ДокументыФизическихЛиц;
		ЗаписьКакСтруктура = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(МенеджерЗаписи, МетаданныеРегистра);
		ДокументыФизическихЛицПрежняя = Новый ФиксированнаяСтруктура(ЗаписьКакСтруктура);
			
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ОписаниеОшибки = "";
	Если Не СохранитьДанныеУдостоверенияЛичности(ТекущийОбъект, ОписаниеОшибки) Тогда
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки,, "ДокументыФизическихЛиц", "ДокументыФизическихЛиц", Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ОбработкаПроверкиЗаполненияНаСервере(ЭтотОбъект, Объект, Отказ);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ФИОПриИзменении(Элемент)
	
	Объект.ФИО = СокрЛП(Объект.ФИО);
	Пока СтрНайти(Объект.ФИО, "  ") > 0 Цикл
		Объект.ФИО = СтрЗаменить(Объект.ФИО, "  ", " ");
	КонецЦикла;
	
	СтруктураФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(Объект.ФИО);
	ЗаполнитьЧастиФИО(СтруктураФИО);
	
	СформироватьПредставлениеФизическогоЛица(СтруктураФИО,, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументУдостоверяющийЛичностьНажатие(Элемент)
	
	ДанныеУдостоверенияЛичность = Новый Структура;
	ДанныеУдостоверенияЛичность.Вставить("ВидДокумента", ДокументыФизическихЛиц.ВидДокумента);
	ДанныеУдостоверенияЛичность.Вставить("ДатаВыдачи", ДокументыФизическихЛиц.ДатаВыдачи);
	ДанныеУдостоверенияЛичность.Вставить("КемВыдан", ДокументыФизическихЛиц.КемВыдан);
	ДанныеУдостоверенияЛичность.Вставить("КодПодразделения", ДокументыФизическихЛиц.КодПодразделения);
	ДанныеУдостоверенияЛичность.Вставить("Номер", ДокументыФизическихЛиц.Номер);
	ДанныеУдостоверенияЛичность.Вставить("Период", ДокументыФизическихЛиц.Период);
	ДанныеУдостоверенияЛичность.Вставить("Серия", ДокументыФизическихЛиц.Серия);
	ДанныеУдостоверенияЛичность.Вставить("СрокДействия", ДокументыФизическихЛиц.СрокДействия);
	ДанныеУдостоверенияЛичность.Вставить("СтранаВыдачи", ДокументыФизическихЛиц.СтранаВыдачи);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДанныеУдостоверенияЛичность", ДанныеУдостоверенияЛичность);
	
	Оповещение = Новый ОписаниеОповещения("ПослеИзмененияДокументаУдостоверяющегоЛичность", ЭтотОбъект);
	ОткрытьФорму("Справочник.ФизическиеЛица.Форма.ФормаРедактированияДокументаУдостоверяющегоЛичность",
		ПараметрыФормы, ЭтотОбъект,,,, Оповещение);
	
КонецПроцедуры

#КонецОбласти

