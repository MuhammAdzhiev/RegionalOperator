#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИзменитьЧастиФИО(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СписокСвойств", "Фамилия,Имя,Отчество");
	ПараметрыФормы.Вставить("Фамилия", Объект.Фамилия);
	ПараметрыФормы.Вставить("Имя", Объект.Имя);
	ПараметрыФормы.Вставить("Отчество", Объект.Отчество);
	
	Оповещение = Новый ОписаниеОповещения("ПослеИзмененияЧастейФИО", ЭтотОбъект);
	ОткрытьФорму("Справочник.ФизическиеЛица.Форма.ФормаРедактированияФИО", ПараметрыФормы, ЭтотОбъект,,,, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВсеДокументыЭтогоЧеловека(Команда)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Физлицо", Объект.Ссылка);
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Отбор", Отбор);
	
	ОткрытьФорму("РегистрСведений.ДокументыФизическихЛиц.ФормаСписка", ПараметрыОткрытия, ЭтотОбъект,,,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

