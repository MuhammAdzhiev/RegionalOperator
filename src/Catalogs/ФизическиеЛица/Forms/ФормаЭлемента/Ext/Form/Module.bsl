#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеИзмененияЧастейФИО(СтруктураФИО, ДополнительныеПараметры) Экспорт
	
	Если СтруктураФИО = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьПредставлениеФизическогоЛица(СтруктураФИО, Истина, Истина);
	ЗаполнитьЧастиФИО(СтруктураФИО);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЧастиФИО(СтруктураФИО) 
	
	Объект.Фамилия = СтруктураФИО.Фамилия;
	Объект.Имя = СтруктураФИО.Имя;
	Объект.Отчество = СтруктураФИО.Отчество;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПредставлениеФизическогоЛица(СтруктураФИО, ЗаполнитьФИО = Ложь, ЗаполнитьНаименование = Ложь)
	
	ЧастиНаименования = Новый Массив;
	
	Если ЗначениеЗаполнено(СтруктураФИО.Фамилия) Тогда
		ЧастиНаименования.Добавить(СтруктураФИО.Фамилия);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураФИО.Имя) Тогда
		ЧастиНаименования.Добавить(СтруктураФИО.Имя);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураФИО.Отчество) Тогда
		ЧастиНаименования.Добавить(СтруктураФИО.Отчество);
	КонецЕсли;
	
	ПредставлениеФизическогоЛица = СокрЛП(СтрСоединить(ЧастиНаименования, " "));
	Если ЗаполнитьФИО Тогда
		Объект.ФИО = ПредставлениеФизическогоЛица;
	КонецЕсли;
	Если ЗаполнитьНаименование Тогда
		Объект.Наименование = ПредставлениеФизическогоЛица;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияДокументаУдостоверяющегоЛичность(ДанныеУдостоверенияЛичность, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ДанныеУдостоверенияЛичность) Тогда
		ЗаполнитьЗначенияСвойств(ДокументыФизическихЛиц, ДанныеУдостоверенияЛичность);
		ОбновитьЗаголовокУдостоверенияЛичности(ЭтотОбъект);
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция МенеджерПоследнейЗаписиДокументовФизическихЛиц(ВедущийОбъект)
	
	МетаданныеРегистра = Метаданные.РегистрыСведений.ДокументыФизическихЛиц;
	МенеджерЗаписи = РегистрыСведений.ДокументыФизическихЛиц.СоздатьМенеджерЗаписи();
	
	// Ищем последнюю запись
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	РегистрСведений.Период,
	|	РегистрСведений.Физлицо,
	|	РегистрСведений.ВидДокумента
	|ИЗ
	|	РегистрСведений.ДокументыФизическихЛиц КАК РегистрСведений
	|ГДЕ
	|	РегистрСведений.Физлицо = &ВедущийОбъект
	|	И РегистрСведений.ЯвляетсяДокументомУдостоверяющимЛичность
	|
	|УПОРЯДОЧИТЬ ПО
	|	РегистрСведений.Период УБЫВ";
	Запрос.УстановитьПараметр("ВедущийОбъект", ВедущийОбъект);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
		МенеджерЗаписи.Прочитать();
		
	КонецЕсли;
	
	Возврат МенеджерЗаписи;
	
КонецФункции

&НаСервере
Функция СохранитьДанныеУдостоверенияЛичности(ТекущийОбъект, ОписаниеОшибки)
	
	Успех = Истина;
	МетаданныеРегистра = Метаданные.РегистрыСведений.ДокументыФизическихЛиц;
	
	ИзменилисьДанные = ДокументыФизическихЛиц.Период <> ДокументыФизическихЛицПрежняя.Период;
	Если Не ИзменилисьДанные Тогда
		ИзменилисьДанные = ИзменилисьДанные
		Или ФизическоеЛицоСсылка <> ДокументыФизическихЛицПрежняя.Физлицо
		И ЗначениеЗаполнено(ДокументыФизическихЛицПрежняя.Физлицо);
		
	КонецЕсли;
	Если Не ИзменилисьДанные Тогда
		Для Каждого Поле Из МетаданныеРегистра.Измерения Цикл
			Если Поле.Имя = "Физлицо" Тогда
				Продолжить;
			КонецЕсли; 
			
			ИзменилисьДанные = ИзменилисьДанные
			Или (ДокументыФизическихЛиц[Поле.Имя] <> ДокументыФизическихЛицПрежняя[Поле.Имя]);
			
		КонецЦикла;
	КонецЕсли;
	Если Не ИзменилисьДанные Тогда
		Для Каждого Поле Из МетаданныеРегистра.Ресурсы Цикл
			ИзменилисьДанные = ИзменилисьДанные
			Или (ДокументыФизическихЛиц[Поле.Имя] <> ДокументыФизическихЛицПрежняя[Поле.Имя]);
			
		КонецЦикла;
	КонецЕсли;
	Если Не ИзменилисьДанные Тогда
		Для Каждого Поле Из МетаданныеРегистра.Реквизиты Цикл
			ИзменилисьДанные = ИзменилисьДанные
			Или (ДокументыФизическихЛиц[Поле.Имя] <> ДокументыФизическихЛицПрежняя[Поле.Имя]);
			
		КонецЦикла;
	КонецЕсли;
	
	Если ИзменилисьДанные Тогда
		Если Не ДокументыФизическихЛицНоваяЗапись Тогда
			РегистрыСведений.ДокументыФизическихЛиц.УдалитьДанныеУдостоверенияЛичности(ТекущийОбъект.Ссылка,
				ДокументыФизическихЛиц);
			
		КонецЕсли;
		
		Успех = РегистрыСведений.ДокументыФизическихЛиц.СохранитьДанныеУдостоверенияЛичности(ТекущийОбъект.Ссылка,
			ДокументыФизическихЛиц, Истина, ОписаниеОшибки);
			
	КонецЕсли;
	
	Возврат Успех;
	
КонецФункции

&НаКлиенте
Процедура ЗаписатьНаКлиенте(ЗакрытьПослеЗаписи)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ЗакрытьПослеЗаписи", ЗакрытьПослеЗаписи);
	
	ЗапроситьРежимИзмененияРегистра(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНаКлиентеЗавершение(Отказ, ДополнительныеПараметры)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Записать() Тогда
		Модифицированность = Ложь;
		Если ДополнительныеПараметры.ЗакрытьПослеЗаписи Тогда 
			Закрыть();
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьРежимИзмененияРегистра(ДополнительныеПараметры)
	ТекстКнопкиДа = НСтр("ru = 'Изменился документ, удостоверяющий личность'");
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru =  'При редактировании изменены сведения о документе, удостоверяющем личность. 
						|Если исправлена прежняя запись о документе (она была ошибочной), нажмите ""Исправлена ошибка"".
						|Если у сотрудника изменилось гражданство с %1, нажмите ""%2""'"), 
			Формат(ДокументыФизическихЛиц.Период, "ДЛФ=D"),
			ТекстКнопкиДа);
			
	Отказ = Ложь;
			
	// Требуется запрашивать пользователя об изменении только если еще не принято решение, что запись - новая.
	Если ДокументыФизическихЛицНоваяЗапись = Истина Тогда
		ЗаписатьНаКлиентеЗавершение(Отказ, ДополнительныеПараметры);
		
		Возврат;
	КонецЕсли;
	
	// Требуется запрашивать пользователя об изменении только если периодические данные
	Если Не ДокументыФизическихЛиц.Свойство("Период") Тогда
		ЗаписатьНаКлиентеЗавершение(Отказ, ДополнительныеПараметры);
		
		Возврат;
	КонецЕсли;
	
	// Требуется запрашивать пользователя об изменении только если задана дата записи.
	Если Не ЗначениеЗаполнено(ДокументыФизическихЛиц.Период) Тогда
		ЗаписатьНаКлиентеЗавершение(Отказ, ДополнительныеПараметры);
		
		Возврат;
	КонецЕсли;
	
	// Требуется запрашивать пользователя об изменении только если была считана прежняя запись.
	Если Не ЗначениеЗаполнено(ДокументыФизическихЛицПрежняя.Период) Тогда
		ЗаписатьНаКлиентеЗавершение(Отказ, ДополнительныеПараметры);
		
		Возврат;
	КонецЕсли;
	
	ИзменилсяПериод = (ДокументыФизическихЛиц.Период <> ДокументыФизическихЛицПрежняя.Период);
	ИзменилисьДанные = Ложь;
	Для Каждого Поле Из ДокументыФизическихЛицПрежняя Цикл
		Если Поле.Ключ = "Период" Тогда
			Продолжить;
		КонецЕсли;
		ИзменилисьДанные = ДокументыФизическихЛиц[Поле.Ключ] <> Поле.Значение;
		Если ИзменилисьДанные Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Требуется запрашивать пользователя об изменении - изменили и текущие данные, и дату записи.
	Если ИзменилисьДанные И ИзменилсяПериод Тогда
		
		Кнопки = Новый СписокЗначений();
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Исправлена ошибка'"));
		Кнопки.Добавить(КодВозвратаДиалога.Да, ТекстКнопкиДа);
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
		
		Оповещение = Новый ОписаниеОповещения("ЗапроситьРежимИзмененияРегистраЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки,, КодВозвратаДиалога.Отмена);
		
	Иначе
		ЗаписатьНаКлиентеЗавершение(Отказ, ДополнительныеПараметры);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьРежимИзмененияРегистраЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Отказ = Ложь;
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Отказ = Истина;
		
	ИначеЕсли Ответ = КодВозвратаДиалога.Да Тогда
		ДокументыФизическихЛицНоваяЗапись = Истина;
		
	КонецЕсли;
	
	ЗаписатьНаКлиентеЗавершение(Отказ, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЗаголовокУдостоверенияЛичности(Форма) 
	
	ДанныеУдостоверения = Новый Массив;
	ДанныеУдостоверения.Добавить(Форма.ДокументыФизическихЛиц.ВидДокумента);
	
	СерияНомер = Новый Массив;
	Если ЗначениеЗаполнено(Форма.ДокументыФизическихЛиц.Серия) Тогда
		СерияНомер.Добавить(Форма.ДокументыФизическихЛиц.Серия);
	КонецЕсли;
	Если ЗначениеЗаполнено(Форма.ДокументыФизическихЛиц.Номер) Тогда
		СерияНомер.Добавить(Форма.ДокументыФизическихЛиц.Номер);
	КонецЕсли;
	ДанныеУдостоверения.Добавить(СокрЛП(СтрСоединить(СерияНомер, " ")));
	
	ДанныеУдостоверения.Добавить(СтрШаблон(НСтр("ru = 'действует до: %1'"), Формат(Форма.ДокументыФизическихЛиц.СрокДействия, "ДЛФ=D")));
	
	Форма.Элементы.ДокументУдостоверяющийЛичность.Заголовок = СтрСоединить(ДанныеУдостоверения, ", ");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

#КонецОбласти


