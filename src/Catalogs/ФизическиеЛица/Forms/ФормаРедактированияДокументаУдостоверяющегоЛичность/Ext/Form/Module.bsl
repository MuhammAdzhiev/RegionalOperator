
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры.ДанныеУдостоверенияЛичность);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("ВыбратьИЗакрыть", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗакрытьБезСохранения(Команда)
	
	ВозвращаемоеЗначение = Неопределено;
	Модифицированность = Ложь;
	Закрыть(ВозвращаемоеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьССохранением(Команда)
	
	Если ЭтотОбъект.ПроверитьЗаполнение() Тогда
		ВыбратьИЗакрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыбратьИЗакрыть(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ВидДокумента", ВидДокумента);
	ВозвращаемоеЗначение.Вставить("ДатаВыдачи", ДатаВыдачи);
	ВозвращаемоеЗначение.Вставить("КемВыдан", КемВыдан);
	ВозвращаемоеЗначение.Вставить("КодПодразделения", КодПодразделения);
	ВозвращаемоеЗначение.Вставить("Номер", Номер);
	ВозвращаемоеЗначение.Вставить("Период", Период);
	ВозвращаемоеЗначение.Вставить("Серия", Серия);
	ВозвращаемоеЗначение.Вставить("СрокДействия", СрокДействия);
	ВозвращаемоеЗначение.Вставить("СтранаВыдачи", СтранаВыдачи);
	
	Модифицированность = Ложь;
	Закрыть(ВозвращаемоеЗначение);
	
КонецПроцедуры

#КонецОбласти
