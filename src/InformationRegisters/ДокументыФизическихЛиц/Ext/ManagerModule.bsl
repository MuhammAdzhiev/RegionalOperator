// Возвращает результат успеха сохранения данных документа, удостоверяющего личность.
//
// Параметры:
//  Физлицо  - СправочникСсылка.ФизическиеЛица - физическое лицо, для которого выполняется обновление.
//  ДанныеФизлица  - ДанныеФормыСтруктура - данные физического лица.
//  ЭтоУдостоверениеЛичности  - Булево - признак того что данные из документа удостоверяющего личность.
//  ОписаниеОшибки  - Строка - краткое представление ошибки.
//
// Возвращаемое значение:
//   Булево   - признак успеха сохранения.
//
Функция СохранитьДанныеУдостоверенияЛичности(Физлицо, ДанныеФизлица, ЭтоУдостоверениеЛичности, ОписаниеОшибки) Экспорт
	
	Результат = Ложь;
	
	Набор = РегистрыСведений.ДокументыФизическихЛиц.СоздатьНаборЗаписей();
	Набор.Отбор.Период.Установить(ДанныеФизлица.Период);
	Набор.Отбор.Физлицо.Установить(Физлицо);
	Набор.Отбор.ВидДокумента.Установить(ДанныеФизлица.ВидДокумента);
	
	НоваяЗапись = Набор.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяЗапись, ДанныеФизлица);
	НоваяЗапись.Физлицо = Физлицо;
	НоваяЗапись.ЯвляетсяДокументомУдостоверяющимЛичность = ЭтоУдостоверениеЛичности;
	
	Попытка
		Набор.Записать();
		Результат = Истина;
		
	Исключение
		ОписаниеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ИнфоОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия(), УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегистрыСведений.ДокументыФизическихЛиц,, ИнфоОшибки);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Возвращает результат успеха удаления данных документа, удостоверяющего личность.
//
// Параметры:
//  Физлицо  - СправочникСсылка.ФизическиеЛица - физическое лицо, для которого выполняется удаление.
//  ДанныеФизлица  - ДанныеФормыСтруктура - данные физического лица.
//
// Возвращаемое значение:
//   Булево   - признак успеха удаления.
//
Функция УдалитьДанныеУдостоверенияЛичности(Физлицо, ДанныеФизлица) Экспорт
	
	Результат = Ложь;
	
	Набор = РегистрыСведений.ДокументыФизическихЛиц.СоздатьНаборЗаписей();
	Набор.Отбор.Период.Установить(ДанныеФизлица.Период);
	Набор.Отбор.Физлицо.Установить(Физлицо);
	Набор.Отбор.ВидДокумента.Установить(ДанныеФизлица.ВидДокумента);
	Набор.Записать();
	
	Попытка
		Набор.Записать();
		Результат = Истина;
		
	Исключение
		ИнфоОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия(), УровеньЖурналаРегистрации.Ошибка, Метаданные.РегистрыСведений.ДокументыФизическихЛиц,, ИнфоОшибки);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает описания события записи журнала регистрации.
//
Функция ИмяСобытия() 
	
	Результат = НСтр("ru = 'Работа с документами удостоверяющими личность физлица'");
	Возврат Результат;
	
КонецФункции

