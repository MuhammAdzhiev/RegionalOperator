#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция НоменклатураСертификата(Сертификат) Экспорт
	
	Запрос = Новый Запрос(ТекстЗапросаНоменклатураСертификата());
	Запрос.УстановитьПараметр("Сертификат", Сертификат);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗаписатьНоменклатуруСертификата(Сертификат, НоменклатураСертификата, Отказ) Экспорт
	
	Набор = СоздатьНаборЗаписей();
	
	Набор.Отбор.Сертификат.Установить(Сертификат);
	
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Набор.Метаданные().ПолноеИмя());
	Элемент.УстановитьЗначение("Сертификат", Сертификат);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	
	Для Каждого Элемент Из НоменклатураСертификата Цикл
		Если Элемент.Номенклатура.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		Запись = Набор.Добавить();
		Запись.Сертификат = Сертификат;
		Запись.Номенклатура = Элемент.Номенклатура;
	КонецЦикла;
	
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		Набор.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		Отказ = Истина;
		ОтменитьТранзакцию();
		Комментарий = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 
		ВызватьИсключение Комментарий;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстЗапросаНоменклатураСертификата()
	
	Возврат "ВЫБРАТЬ
	|	СертификатыНоменклатуры.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.СертификатыНоменклатуры КАК СертификатыНоменклатуры
	|ГДЕ
	|	СертификатыНоменклатуры.Сертификат = &Сертификат";
	
КонецФункции

#КонецОбласти

#КонецЕсли
