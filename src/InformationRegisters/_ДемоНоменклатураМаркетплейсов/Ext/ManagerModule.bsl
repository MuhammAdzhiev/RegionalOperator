#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

// Записывает идентификатор маркетплейса
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура
//  Маркетплейс - ПеречислениеСсылка._ДемоВидыМаркетплейсов
//  ИдентификаторТовара - Строка
// 
Процедура ЗаписатьИдентификаторМаркетплейса(Знач Номенклатура, Знач Маркетплейс, Знач ИдентификаторТовара) Экспорт
	
	Если ТипЗнч(ИдентификаторТовара) <> Тип("Строка")
		Или ТипЗнч(Маркетплейс) <> Тип("ПеречислениеСсылка._ДемоВидыМаркетплейсов")
		Или	ПустаяСтрока(ИдентификаторТовара) 
		Или Маркетплейс.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Набор = СоздатьНаборЗаписей();
	Набор.Отбор.Маркетплейс.Установить(Маркетплейс);
	Набор.Отбор.ИдентификаторТовара.Установить(ИдентификаторТовара);
	
	Запись = Набор.Добавить();
	Запись.Маркетплейс = Маркетплейс;
	Запись.ИдентификаторТовара = ИдентификаторТовара;
	Запись.Номенклатура = Номенклатура;
	
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(Набор.Метаданные().ПолноеИмя());
	Элемент.УстановитьЗначение("Маркетплейс", Маркетплейс);
	Элемент.УстановитьЗначение("ИдентификаторТовара", ИдентификаторТовара);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		Набор.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение(НСтр("ru = 'Не удалось записать номенклатуру маркетплейса'"));
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти
	
#КонецЕсли