#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область СлужебныеПроцедурыИФункции

// Перезаполняет регистр ТоварыТорговыхПредложений данными из прайс листа
//
// Параметры:
//	СтруктураПараметров 	- Список товаров по которым нужно обновить торговые предложения.
//							И товарное предложение для которого нужно обновить
//							Если неопределено, то по всем товарам торговых предложений
//
//	АдресРезультата			- Адрес куда выгрузить результат
//							Если неопределено, то все обновляемые торговые предложения
//
Процедура ОбновитьТоварыТорговыхПредложений(СтруктураПараметров, АдресРезультата) Экспорт
	
	СписокТоваров       = СтруктураПараметров.СписокТоваров;
	ТорговоеПредложение = СтруктураПараметров.ТорговоеПредложение;
	ПоТоварам = Истина;
	
	Если СписокТоваров = Неопределено Тогда
		
		ПоТоварам = Ложь;
		СписокТоваров = Новый ТаблицаЗначений;
		СписокТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		СписокТоваров.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
		СписокТоваров.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.ЕдиницыИзмерения"));
		
	КонецЕсли;
	
	ЗапросТовары = Новый Запрос;
	ЗапросТовары.Текст = 
	"ВЫБРАТЬ
	|	СписокТоваров.Номенклатура КАК Номенклатура,
	|	СписокТоваров.Характеристика КАК Характеристика,
	|	СписокТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ СписокТоваров
	|ИЗ
	|	&СписокТоваров КАК СписокТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыТорговыхПредложений.ТорговоеПредложение КАК ТорговоеПредложение,
	|	ТоварыТорговыхПредложений.Номенклатура КАК Номенклатура,
	|	ТоварыТорговыхПредложений.Характеристика КАК Характеристика,
	|	ТоварыТорговыхПредложений.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА ПрайсЛист.Номенклатура ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НетВПрайсе,
	|	СУММА(ВЫБОР
	|			КОГДА &ПоТоварам
	|					И СписокТоваров.Номенклатура ЕСТЬ NULL
	|				ТОГДА ЕСТЬNULL(ТоварыТорговыхПредложений.Количество, 0)
	|			ИНАЧЕ ЕСТЬNULL(ПрайсЛист.Количество, 0)
	|		КОНЕЦ) КАК Количество,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА &ПоТоварам
	|					И СписокТоваров.Номенклатура ЕСТЬ NULL
	|				ТОГДА ЕСТЬNULL(ТоварыТорговыхПредложений.Оценка, 0)
	|			ИНАЧЕ ЕСТЬNULL(ПрайсЛист.Оценка, 0)
	|		КОНЕЦ) КАК Оценка,
	|	ВЫБОР
	|		КОГДА &ПоТоварам
	|				И СписокТоваров.Номенклатура ЕСТЬ NULL
	|			ТОГДА ЕСТЬNULL(ТоварыТорговыхПредложений.Цена, 0)
	|		ИНАЧЕ ЕСТЬNULL(ПрайсЛист.Цена, 0)
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	РегистрСведений.ТоварыТорговыхПредложений КАК ТоварыТорговыхПредложений
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрайсЛист КАК ПрайсЛист
	|		ПО (ТоварыТорговыхПредложений.Номенклатура = ПрайсЛист.Номенклатура)
	|			И (ТоварыТорговыхПредложений.Характеристика = ПрайсЛист.Характеристика)
	|			И (ТоварыТорговыхПредложений.ЕдиницаИзмерения = ПрайсЛист.ЕдиницаИзмерения)
	|			И (ТоварыТорговыхПредложений.ТорговоеПредложение.Организация = ПрайсЛист.Организация
	|				ИЛИ ПрайсЛист.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|			И (ТоварыТорговыхПредложений.ТорговоеПредложение.ВидЦены = ПрайсЛист.ВидЦены)
	|		ЛЕВОЕ СОЕДИНЕНИЕ СписокТоваров КАК СписокТоваров
	|		ПО (ТоварыТорговыхПредложений.Номенклатура = СписокТоваров.Номенклатура)
	|			И (ТоварыТорговыхПредложений.Характеристика = СписокТоваров.Характеристика)
	|			И (ТоварыТорговыхПредложений.ЕдиницаИзмерения = СписокТоваров.ЕдиницаИзмерения)
	|ГДЕ
	|	ТоварыТорговыхПредложений.ТорговоеПредложение = &ТорговоеПредложение
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыТорговыхПредложений.ТорговоеПредложение,
	|	ТоварыТорговыхПредложений.Номенклатура,
	|	ТоварыТорговыхПредложений.Характеристика,
	|	ТоварыТорговыхПредложений.ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА ПрайсЛист.Номенклатура ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &ПоТоварам
	|				И СписокТоваров.Номенклатура ЕСТЬ NULL
	|			ТОГДА ЕСТЬNULL(ТоварыТорговыхПредложений.Цена, 0)
	|		ИНАЧЕ ЕСТЬNULL(ПрайсЛист.Цена, 0)
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	ЕдиницаИзмерения";
	
	ЗапросТорговыеПредложение = Новый Запрос;
	ЗапросТорговыеПредложение.Текст =
	"ВЫБРАТЬ
	|	ТорговыеПредложения.Ссылка КАК ТорговоеПредложения
	|ИЗ
	|	Справочник.ТорговыеПредложения КАК ТорговыеПредложения
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ТорговыеПредложения = НЕОПРЕДЕЛЕНО
	|				ТОГДА ТорговыеПредложения.ОбновлятьОстаткиИЦены
	|			ИНАЧЕ ТорговыеПредложения.Ссылка = &ТорговыеПредложения
	|		КОНЕЦ";
	
	ЗапросТорговыеПредложение.УстановитьПараметр("ТорговыеПредложения", ТорговоеПредложение);
	
	ВыборкаДетальныеЗаписи = ЗапросТорговыеПредложение.Выполнить().Выбрать();
	
	// &ЗамерПроизводительности
	ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации("РегистрСведений.ПрайсЛист.МодульМенеджера.ОбновитьТоварыТорговыхПредложений");
	
	Обработано = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
		Номенклатура     = Справочники.Номенклатура.ПустаяСсылка();
		Характеристика   = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		
		НаборЗаписей = РегистрыСведений.ТоварыТорговыхПредложений.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ТорговоеПредложение.Установить(ВыборкаДетальныеЗаписи.ТорговоеПредложения);
		
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ТоварыТорговыхПредложений");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.УстановитьЗначение("ТорговоеПредложение", ВыборкаДетальныеЗаписи.ТорговоеПредложения);
			
			Блокировка.Заблокировать();
			
			ЗапросТовары.УстановитьПараметр("ТорговоеПредложение", ВыборкаДетальныеЗаписи.ТорговоеПредложения);
			ЗапросТовары.УстановитьПараметр("СписокТоваров"      , СписокТоваров);
			ЗапросТовары.УстановитьПараметр("ПоТоварам"          , ПоТоварам);
			
			НаборЗаписей.Загрузить(ЗапросТовары.Выполнить().Выгрузить());
			
			Если НаборЗаписей.Количество() > 0 Тогда
				Обработано = Обработано + НаборЗаписей.Количество();
				НаборЗаписей.Записать();
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			
			ТекстОшибки = ОписаниеОшибки();
			
			ВызватьИсключение ТекстОшибки;
		КонецПопытки;
	КонецЦикла;
	
	// &ЗамерПроизводительности
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ОписаниеЗамера, Обработано/1000); // Пакет по 1000 записей.
	
КонецПроцедуры // ОбновитьТоварыТорговыхПредложений()

// Сохраняет прайс-лист в регистр
//
// Параметры:
//	СтруктураПараметров 	- Список товаров по которым нужно обновить торговые предложения. 
//							И товарное предложение для которого нужно обновить
//
//	АдресРезультата			- Адрес куда выгрузить результат обновления
//							Если неопределено, то все обновляемые торговые предложения
//
Процедура СохранитьИзмененныйПрайсЛист(СтруктураПараметров, АдресРезультата) Экспорт
	
	ТаблицаПрайсЛист = СтруктураПараметров.ТаблицаПрайсЛист;
	ВидыЦен          = СтруктураПараметров.ВидыЦен;
	
	СтрокиТаблицы = ТаблицаПрайсЛист.НайтиСтроки(Новый Структура("Модифицирован", Истина));
	
	Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		
		НаборЗаписей = РегистрыСведений.ПрайсЛист.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Номенклатура.Установить(СтрокаТаблицы.НоменклатураДо);
		НаборЗаписей.Отбор.Характеристика.Установить(СтрокаТаблицы.ХарактеристикаДо);
		НаборЗаписей.Отбор.ЕдиницаИзмерения.Установить(СтрокаТаблицы.ЕдиницаИзмеренияДо);
		НаборЗаписей.Отбор.Организация.Установить(СтрокаТаблицы.ОрганизацияДо);
		НаборЗаписей.Записать();
		
		Если СтрокаТаблицы.Удален Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		НаборЗаписей.Отбор.Номенклатура.Установить(СтрокаТаблицы.Номенклатура);
		НаборЗаписей.Отбор.Характеристика.Установить(СтрокаТаблицы.Характеристика);
		НаборЗаписей.Отбор.ЕдиницаИзмерения.Установить(СтрокаТаблицы.ЕдиницаИзмерения);
		НаборЗаписей.Отбор.Организация.Установить(СтрокаТаблицы.Организация);
		
		Для Каждого ВидЦены Из ВидыЦен Цикл
			
			НаборЗаписей.Отбор.ВидЦены.Установить(ВидЦены.Ссылка);
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество()=0 Тогда
				
				СтрокаНабораЗаписей = НаборЗаписей.Добавить();
				СтрокаНабораЗаписей.Номенклатура = СтрокаТаблицы.Номенклатура;
				СтрокаНабораЗаписей.Характеристика = СтрокаТаблицы.Характеристика;
				СтрокаНабораЗаписей.ЕдиницаИзмерения = СтрокаТаблицы.ЕдиницаИзмерения;
				СтрокаНабораЗаписей.Организация = СтрокаТаблицы.Организация;
				СтрокаНабораЗаписей.ВидЦены = ВидЦены.Ссылка;
				
			Иначе
				
				СтрокаНабораЗаписей = НаборЗаписей[0];
				
			КонецЕсли;
			
			СтрокаНабораЗаписей.Цена       =  СтрокаТаблицы[ВидЦены.УникальноеИмя];
			СтрокаНабораЗаписей.Оценка     =  СтрокаТаблицы.Наличие;
			СтрокаНабораЗаписей.Количество =  СтрокаТаблицы.Количество;
			
			НаборЗаписей.Записать();
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаПрайсЛист.Свернуть("Номенклатура, Характеристика, ЕдиницаИзмерения, Организация");
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("СписокТоваров", ТаблицаПрайсЛист);
	СтруктураПараметров.Вставить("ТорговоеПредложение", Неопределено);
	
	ОбновитьТоварыТорговыхПредложений(СтруктураПараметров,Неопределено);
	
	
КонецПроцедуры // СохранитьИзмененныйПрайсЛист()
	
#КонецОбласти
	
#КонецЕсли