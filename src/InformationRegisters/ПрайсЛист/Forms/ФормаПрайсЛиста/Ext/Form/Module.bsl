
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьУсловноеОформление();
	
	Параметры.Свойство("Номенклатура", ВыбраннаяНоменклатура);
	
	ИспользоватьСинхронизациюДанных = ПолучитьФункциональнуюОпцию("ИспользоватьСинхронизациюДанныхВЛокальномРежиме")
	                                    Или Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ПрайсЛист);
	
	ИспользоватьХарактеристики = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	Элементы.СписокХарактеристика.Видимость = ИспользоватьХарактеристики;
	
	УстановитьВидимостьПрайсЛиста();
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЭлементыОтображатьНажатие(Элемент)
	
	РежимСопоставления = 0;
	
	УстановитьРежимСопоставления();
	
	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список,"Цена");
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСЦенамиНажатие(Элемент)
	
	РежимСопоставления = 1;
	
	УстановитьРежимСопоставления();
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
	        "Цена",
	        0,
	        ВидСравненияКомпоновкиДанных.Больше,
	        "Цена",
	        Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаБезЦенНажатие(Элемент)
	
	РежимСопоставления = 2;
	
	УстановитьРежимСопоставления();
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
	        "Цена",
	        0,
	        ВидСравненияКомпоновкиДанных.Равно,
	        "Цена",
	        Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если НЕ ИспользоватьСинхронизациюДанных Тогда
		Адрес = ПоместитьВХранилищеСписокВыбранныхТоваров();
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("РедактированиеПрайсЛистаЗавершение", ЭтотОбъект);
		
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Изменение", Истина);
		ПараметрыОткрытия.Вставить("РежимРедактирования", Истина);
		ПараметрыОткрытия.Вставить("Адрес", Адрес);
		ПараметрыОткрытия.Вставить("ИмяКолонки", СтрЗаменить(Элементы.Список.ТекущийЭлемент.Имя,"Список",""));
		ПараметрыОткрытия.Вставить("Номенклатура", ВыбраннаяНоменклатура);
		
		ОткрытьФорму("РегистрСведений.ПрайсЛист.Форма.РедактированияПрайсЛиста", ПараметрыОткрытия,
		ЭтотОбъект.УникальныйИдентификатор,,,,ОповещениеОЗакрытии);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьИзВнешнегоФайла(Команда)
	
	Модифицированность=Ложь;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ЗагружатьЦеныПоВидамЦен"   , Истина);
	ПараметрыФормы.Вставить("ЗагружатьКоличество"       , Истина);
	ПараметрыФормы.Вставить("ЗагружатьОценку"           , Истина);
	ПараметрыФормы.Вставить("ЗагружатьЕдиницыИзмерения" , Истина);
	
	Описание = Новый ОписаниеОповещения("ЗагрузитьИзВнешнегоФайла_Завершение",ЭтотОбъект);
	
	ОткрытьФорму("Обработка.ЗагрузкаДанныхИзВнешнихФайлов.Форма.Форма",
	    ПараметрыФормы,
	    ,,,,
	    Описание);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОценку(Команда)
	
	 Модифицированность=Ложь;
	 
	СписокВариантов = Новый СписокЗначений;
	СписокВариантов.Добавить("Нет на складе");
	СписокВариантов.Добавить("Мало");
	СписокВариантов.Добавить("Достаточно");
	СписокВариантов.Добавить("Много");
	
	Описание = Новый ОписаниеОповещения("УстановкаОценки_Завершение",ЭтотОбъект);
	
	СписокВариантов.ПоказатьВыборЭлемента(Описание, НСтр("ru = 'Выберите оценку остатка'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьЦенуНаПроцент(Команда)
	
	Модифицированность=Ложь;
	
	ПараметрыФормы = Новый Структура("ВидыЦен",ПолучитьВидыЦен(ВидыЦен));
	
	Оповещение = Новый ОписаниеОповещения("ИзменитьЦенуНаПроцент_Завершение",ЭтотОбъект);
	
	ОткрытьФорму("ОбщаяФорма.ФормаВыбораПроцента", 
	    ПараметрыФормы,
	    ЭтотОбъект.УникальныйИдентификатор,
	    ,,,
	    Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСписок(Команда)
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("РедактированиеПрайсЛистаЗавершение", ЭтотОбъект);
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Добавление", Истина);
	ПараметрыОткрытия.Вставить("Номенклатура", ВыбраннаяНоменклатура);
	
	ОткрытьФорму("РегистрСведений.ПрайсЛист.Форма.РедактированияПрайсЛиста", ПараметрыОткрытия,
	        ЭтотОбъект.УникальныйИдентификатор,,,,ОповещениеОЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура Скопировать(Команда)
	
	Модифицированность=Ложь;
	
	Если Элементы.Список.ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Адрес = ПоместитьВХранилищеСписокВыбранныхТоваров();
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("РедактированиеПрайсЛистаЗавершение", ЭтотОбъект);
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Копирование", Истина);
	ПараметрыОткрытия.Вставить("Адрес", Адрес);
	ПараметрыОткрытия.Вставить("Номенклатура", ВыбраннаяНоменклатура);
	
	ОткрытьФорму("РегистрСведений.ПрайсЛист.Форма.РедактированияПрайсЛиста", ПараметрыОткрытия,
	        ЭтотОбъект.УникальныйИдентификатор,,,,ОповещениеОЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура Изменить(Команда)
	
	
	Модифицированность=Ложь;
	
	Если Элементы.Список.ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	Адрес = ПоместитьВХранилищеСписокВыбранныхТоваров();
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("РедактированиеПрайсЛистаЗавершение", ЭтотОбъект);
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Адрес", Адрес);
	ПараметрыОткрытия.Вставить("Изменение", Истина);

	
	ОткрытьФорму("РегистрСведений.ПрайсЛист.Форма.РедактированияПрайсЛиста", ПараметрыОткрытия,
	        ЭтотОбъект.УникальныйИдентификатор,,,,ОповещениеОЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)
	
	Модифицированность=Ложь;
	
	Если Элементы.Список.ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
		СписокВыбранныхТоваров = Новый Массив;
		СписокНазваний = Новый Массив;
		
		Для Каждого Индекс Из Элементы.Список.ВыделенныеСтроки Цикл
			
			СтрокаТаблицы = Элементы.Список.ДанныеСтроки(Индекс);
			
			СтруктураТовара = Новый Структура;
			СтруктураТовара.Вставить("Номенклатура"              , СтрокаТаблицы.Номенклатура);
			СтруктураТовара.Вставить("Характеристика"            , СтрокаТаблицы.Характеристика);
			СтруктураТовара.Вставить("ЕдиницаИзмерения"          , СтрокаТаблицы.ЕдиницаИзмерения);
			СтруктураТовара.Вставить("Организация"               , СтрокаТаблицы.Организация);
			СписокВыбранныхТоваров.Добавить(СтруктураТовара);
			
			СписокНазваний.Добавить(Строка(СтрокаТаблицы.Номенклатура));
		КонецЦикла;
	
	
	Оповещение = Новый ОписаниеОповещения("ВопросПередУдалениеЗавершение", ЭтотОбъект, СписокВыбранныхТоваров);
	ПоказатьВопрос(Оповещение, СтрШаблон(НСтр("ru = 'Удалить %1 из прайс-листа?'"), СтрСоединить(СписокНазваний, ", ")),РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СлужебныеОбработчикиСобытий

&НаКлиенте
Процедура ВопросПередУдалениеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		Если УдалитьТоварИзПрайсЛиста(ДополнительныеПараметры) Тогда
			Элементы.Список.Обновить();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ВопросПередУдалениеЗавершение()

&НаСервереБезКонтекста
Функция УдалитьТоварИзПрайсЛиста(СписокВыбранныхТоваров)
	
	СписокТоваров = Новый ТаблицаЗначений;
	СписокТоваров.Колонки.Добавить("Организация"     , Новый ОписаниеТипов("СправочникСсылка.Организации"));
	СписокТоваров.Колонки.Добавить("Номенклатура"    , Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	СписокТоваров.Колонки.Добавить("Характеристика"  , Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	СписокТоваров.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.ЕдиницыИзмерения"));
	
	НаборЗаписей = РегистрыСведений.ПрайсЛист.СоздатьНаборЗаписей();
	
	НачатьТранзакцию();
	Попытка
		
		Для Каждого СтрокаМассива Из СписокВыбранныхТоваров Цикл
			
			НаборЗаписей.Отбор.Организация.Установить(СтрокаМассива.Организация);
			НаборЗаписей.Отбор.Номенклатура.Установить(СтрокаМассива.Номенклатура);
			НаборЗаписей.Отбор.ЕдиницаИзмерения.Установить(СтрокаМассива.ЕдиницаИзмерения);
			НаборЗаписей.Отбор.Характеристика.Установить(СтрокаМассива.Характеристика);
			НаборЗаписей.Записать();
			
			НоваяСтрока = СписокТоваров.Добавить();
			НоваяСтрока.Организация     = СтрокаМассива.Организация;
			НоваяСтрока.Номенклатура     = СтрокаМассива.Номенклатура;
			НоваяСтрока.ЕдиницаИзмерения = СтрокаМассива.ЕдиницаИзмерения;
			НоваяСтрока.Характеристика   = СтрокаМассива.Характеристика;

		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		Ошибка = ОписаниеОшибки();
		ОбщегоНазначения.СообщитьПользователю(Ошибка);
		
		Возврат Ложь;
	КонецПопытки;
	ПараметрыПроцедуры = Новый Структура("СписокТоваров,ТорговоеПредложение", СписокТоваров, Неопределено);
	АдресОтвета = Неопределено;
	
	РегистрыСведений.ПрайсЛист.ОбновитьТоварыТорговыхПредложений(ПараметрыПроцедуры, АдресОтвета);
	Возврат Истина;
	
КонецФункции// УдалитьТоварИзПрайсЛиста()

&НаСервере
Процедура УстановитьВидимостьПрайсЛиста()

	Если ЗаполнитьВидыЦен() Тогда 
		
		Если ЗначениеЗаполнено(ВыбраннаяНоменклатура) Тогда
			
			ЭтотОбъект.Заголовок = НСтр("ru = 'Остатки и цены'");
			
			Элементы.ТоварыЗагрузитьИзВнешнегоФайла.Видимость = Ложь;
			Элементы.СписокНоменклатура.Видимость = Ложь;
			
		Иначе
			
			ЭтотОбъект.Заголовок = НСтр("ru = 'Просмотр прайс-листа'");
			
		КонецЕсли;
		
		НастроитьДинСписок();
		ДобавитьКолонкиВидовЦен();
		УстановитьВидимостьЭлементовУправления();
		Элементы.СтраницыВидыЦен.ТекущаяСтраница = Элементы.ЕстьЦены;
		УстановитьРежимСопоставления();
		
	Иначе
		
		ЭтотОбъект.Заголовок = "";
		Элементы.СтраницыВидыЦен.ТекущаяСтраница = Элементы.НетЦен;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзВнешнегоФайла_Завершение(Результат, Параметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		Адрес = ПоместитьВоВременноеХранилищеБезКонтекста(Результат);
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("РедактированиеПрайсЛистаЗавершение", ЭтотОбъект);
		
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Адрес", Адрес);
		ПараметрыОткрытия.Вставить("Изменение", Истина);
		ПараметрыОткрытия.Вставить("Модифицирован", Истина);
		
		
		ОткрытьФорму("РегистрСведений.ПрайсЛист.Форма.РедактированияПрайсЛиста", ПараметрыОткрытия,
		    ЭтотОбъект.УникальныйИдентификатор,,,,ОповещениеОЗакрытии);
		
		
	КонецЕсли;
	
	
КонецПроцедуры // ЗагрузитьИзВнешнегоФайла_Завершение()

&НаКлиенте
Процедура ИзменитьЦенуНаПроцент_Завершение(РезультатВыполнения,ДопПараметры) Экспорт 
	
	Если ЗначениеЗаполнено(РезультатВыполнения) Тогда
		
		ПараметрыОткрытия = Новый Структура("РезультатВыполнения", РезультатВыполнения);
		Адрес = ПоместитьВХранилищеСписокВыбранныхТоваров(ПараметрыОткрытия);
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("РедактированиеПрайсЛистаЗавершение", ЭтотОбъект);
		
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Адрес", Адрес);
		ПараметрыОткрытия.Вставить("Изменение", Истина);
		ПараметрыОткрытия.Вставить("Модифицирован", Истина);
		
		
		ОткрытьФорму("РегистрСведений.ПрайсЛист.Форма.РедактированияПрайсЛиста", ПараметрыОткрытия,
		    ЭтотОбъект.УникальныйИдентификатор,,,,ОповещениеОЗакрытии);
		
		
	КонецЕсли;
	
КонецПроцедуры // ИзменитьЦенуНаПроцент_Завершение()

&НаКлиенте
Процедура УстановкаОценки_Завершение(Значение,ДополнительныеПараметры) Экспорт 
	
	Если Значение <> Неопределено Тогда
		
		ПараметрыОткрытия = Новый Структура("Наличие", Значение.Значение);
		Адрес = ПоместитьВХранилищеСписокВыбранныхТоваров(ПараметрыОткрытия);
		
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("РедактированиеПрайсЛистаЗавершение", ЭтотОбъект);
		
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Адрес"        , Адрес);
		ПараметрыОткрытия.Вставить("Изменение"    , Истина);
		ПараметрыОткрытия.Вставить("Модифицирован", Истина);
		
		
		ОткрытьФорму("РегистрСведений.ПрайсЛист.Форма.РедактированияПрайсЛиста", ПараметрыОткрытия,
		    ЭтотОбъект.УникальныйИдентификатор,,,,ОповещениеОЗакрытии);
		
		КонецЕсли;
	
КонецПроцедуры // ВыборВидаОценки_Завершение()

#КонецОбласти

&НаКлиенте
Процедура ВыполнитьПроцедуруВыполнено(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		
		Возврат;
		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
		
	ИначеЕсли Результат.Статус = "Выполнено" Тогда
		
		ЭтотОбъект.Модифицированность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовУправления()

	ТолькоПросмотр = ИспользоватьСинхронизациюДанных;
	
	Если ЗначениеЗаполнено(ВыбраннаяНоменклатура) Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
		    "Номенклатура",
		    ВыбраннаяНоменклатура,
		    ВидСравненияКомпоновкиДанных.Равно,
		    "Номенклатура",
		    Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРежимСопоставления()
	
	Элементы.ГруппаВсе.ЦветФона         = ?(РежимСопоставления = 0, ЦветаСтиля.ЦветФонаШапкиТаблицы, Новый Цвет());
	Элементы.ГруппаСЦенами.ЦветФона     = ?(РежимСопоставления = 1, ЦветаСтиля.ЦветФонаШапкиТаблицы, Новый Цвет());
	Элементы.ГруппаБезЦен.ЦветФона      = ?(РежимСопоставления = 2, ЦветаСтиля.ЦветФонаШапкиТаблицы, Новый Цвет());
	
	Элементы.Все.Гиперссылка      = ?(РежимСопоставления <> 0, Истина, Ложь);
	Элементы.СЦенами.Гиперссылка  = ?(РежимСопоставления <> 1, Истина, Ложь);
	Элементы.БезЦен.Гиперссылка   = ?(РежимСопоставления <> 2, Истина, Ложь);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьВидыЦен()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыЦен.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ВидыЦен.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА ВидыЦен.Наименование
	|		ИНАЧЕ ВидыЦен.Наименование + "", "" + ВидыЦен.Валюта.Наименование
	|	КОНЕЦ КАК Имя,
	|	ВидыЦен.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ВидыЦен КАК ВидыЦен
	|ГДЕ
	|	НЕ ВидыЦен.ПометкаУдаления";
	
	ВидыЦен.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Если ВидыЦен.Количество() > 0 Тогда
		Элементы.ТоварыЗаполнитьЦену.Доступность = Истина;
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции // ЗаполнитьВидыЦен()

&НаСервере
Процедура ДобавитьКолонкиВидовЦен()
	
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой));
	МассивРеквизитов = Новый Массив;
	
	Для Каждого ВидЦены Из ВидыЦен Цикл
		ВидЦены.УникальноеИмя = "ВидЦены_" + СтрЗаменить(ВРег(Строка(ВидЦены.Ссылка.УникальныйИдентификатор())), "-", "x");
		МассивРеквизитов.Добавить(Новый РеквизитФормы(ВидЦены.УникальноеИмя,ОписаниеТиповЧисло,,ВидЦены.Имя));
		
	КонецЦикла;
	
	ИзменитьРеквизиты(МассивРеквизитов);
	
	Для Каждого ВидЦены Из ВидыЦен Цикл
		ВидЦены.Отображать = Истина;
		НовыйЭлемент = Элементы.Добавить("Список" + ВидЦены.УникальноеИмя, Тип("ПолеФормы"), Элементы.СписокЦены);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеНадписи;
		НовыйЭлемент.Заголовок = ВидЦены.Имя;
		НовыйЭлемент.ПутьКДанным = "Список." + ВидЦены.УникальноеИмя;
	КонецЦикла;
	
КонецПроцедуры // ДобавитьКолонкиВидовЦен()

&НаСервереБезКонтекста
Функция ПолучитьВидыЦен(Знач СправочникВидыЦен)
	
	МассивОтвет = Новый Массив;
	
	МассивВидовЦен = СправочникВидыЦен.НайтиСтроки(Новый Структура("Отображать", Истина));
	
	Для Каждого ВидЦены Из МассивВидовЦен Цикл 
		
		СтруктураВидЦены = Новый Структура();
		СтруктураВидЦены.Вставить("УникальноеИмя", ВидЦены.УникальноеИмя);
		СтруктураВидЦены.Вставить("Наименование" , ВидЦены.Наименование );
		СтруктураВидЦены.Вставить("Отображать"   , Истина               );
		
		МассивОтвет.Добавить(СтруктураВидЦены);
		
	КонецЦикла;
	
	Возврат МассивОтвет;
	
КонецФункции // ПолучитьТаблицуВидыЦен()

&НаСервере
Процедура НастроитьДинСписок()

	СтрокаИменОбъявление = Новый Массив;
	СтрокаИмен = Новый Массив;
	СтрокаИменГруппировка = Новый Массив;
	
	МассивСтрокИз = Новый Массив;
	МассивСтрокИз.Добавить("ПО ПрайсЛист.Номенклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка");
	
	МассивПараметров = Новый СписокЗначений;
	
	Для Каждого Колонка Из  ВидыЦен Цикл 
		
		Колонка.УникальноеИмя =  "ВидЦены_" + СтрЗаменить(ВРег(Строка(Колонка.Ссылка.УникальныйИдентификатор())), "-", "x");
		
		
		СтрокаИменОбъявление.Добавить(" ЕСТЬNULL(ПрайсЛист" + Колонка.УникальноеИмя + ".Цена, 0)  КАК " + Колонка.УникальноеИмя + ","+Символы.ПС);
		СтрокаИмен.Добавить(Колонка.УникальноеИмя + ","+Символы.ПС);
		СтрокаИменГруппировка.Добавить(" ЕСТЬNULL(ПрайсЛист" + Колонка.УникальноеИмя + ".Цена, 0),"+Символы.ПС);
		
		МассивСтрокИз.Добавить(Символы.ПС +
			"ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрайсЛист КАК ПрайсЛист" + Колонка.УникальноеИмя + Символы.ПС +
			"ПО ПрайсЛист.Организация 			= ПрайсЛист" + Колонка.УникальноеИмя + ".Организация
			|	И ПрайсЛист.Номенклатура 		= ПрайсЛист" + Колонка.УникальноеИмя + ".Номенклатура
			|	И ПрайсЛист.Характеристика 	= ПрайсЛист" + Колонка.УникальноеИмя + ".Характеристика
			|	И ПрайсЛист.ЕдиницаИзмерения 	= ПрайсЛист" + Колонка.УникальноеИмя + ".ЕдиницаИзмерения
			|	И ПрайсЛист.Склад 	= ПрайсЛист" + Колонка.УникальноеИмя + ".Склад
			|	И (ПрайсЛист" + Колонка.УникальноеИмя + ".ВидЦены = " + "&Ссылка"+Колонка.УникальноеИмя + ")");
			
			МассивПараметров.Добавить(Колонка.Ссылка, "Ссылка"+Колонка.УникальноеИмя);

	КонецЦикла;
	
	
	ОсновнойЗапрос =
			"ВЫБРАТЬ
			|	ПрайсЛист.Номенклатура КАК Номенклатура,
			|	ПрайсЛист.Характеристика КАК Характеристика,
			|	ПрайсЛист.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ПрайсЛист.Организация КАК Организация,
			|	ПрайсЛист.Склад КАК Склад,
			|	МАКСИМУМ(ЕСТЬNULL(ПрайсЛист.Цена, 0)) КАК Цена,
			|	МАКСИМУМ(ПрайсЛист.Оценка) КАК Наличие,
			|	ВЫБОР
			|		КОГДА ПрайсЛист.Оценка = 0
			|			ТОГДА ВЫРАЗИТЬ(&ПоЗапросу КАК СТРОКА(15))
			|		КОГДА ПрайсЛист.Оценка = 1
			|			ТОГДА ВЫРАЗИТЬ(&Мало КАК СТРОКА(15))
			|		КОГДА ПрайсЛист.Оценка = 2
			|			ТОГДА ВЫРАЗИТЬ(&Достаточно КАК СТРОКА(15))
			|		КОГДА ПрайсЛист.Оценка = 3
			|			ТОГДА ВЫРАЗИТЬ(&Много КАК СТРОКА(15))
			|		ИНАЧЕ """"
			|	КОНЕЦ КАК НаличиеСтрокой,
			|	МАКСИМУМ(ЕСТЬNULL(ПрайсЛист.Количество, 0)) КАК Количество,
			|	&XCVXCV КАК XCVXCV,
			|	ЕСТЬNULL(ВидыНоменклатуры.ИспользоватьХарактеристики, ЛОЖЬ) КАК ХарактеристикиИспользуются
			|ПОМЕСТИТЬ Выборка
			|ИЗ
			|	РегистрСведений.ПрайсЛист КАК ПрайсЛист
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
			|		ПО ПрайсЛист.Номенклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|	ПрайсЛист.Номенклатура,
			|	ПрайсЛист.Характеристика,
			|	ПрайсЛист.ЕдиницаИзмерения,
			|	ПрайсЛист.Организация,
			|	ПрайсЛист.Склад,
			|	&XCVXCV,
			|	ЕСТЬNULL(ВидыНоменклатуры.ИспользоватьХарактеристики, ЛОЖЬ),
			|	ВЫБОР
			|		КОГДА ПрайсЛист.Оценка = 0
			|			ТОГДА ВЫРАЗИТЬ(&ПоЗапросу КАК СТРОКА(15))
			|		КОГДА ПрайсЛист.Оценка = 1
			|			ТОГДА ВЫРАЗИТЬ(&Мало КАК СТРОКА(15))
			|		КОГДА ПрайсЛист.Оценка = 2
			|			ТОГДА ВЫРАЗИТЬ(&Достаточно КАК СТРОКА(15))
			|		КОГДА ПрайсЛист.Оценка = 3
			|			ТОГДА ВЫРАЗИТЬ(&Много КАК СТРОКА(15))
			|		ИНАЧЕ """"
			|	КОНЕЦ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ПрайсЛист.Номенклатура КАК Номенклатура,
			|	ПрайсЛист.Характеристика КАК Характеристика,
			|	ПрайсЛист.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ПрайсЛист.Организация КАК Организация,
			|	МАКСИМУМ(ПрайсЛист.Склад) КАК Склад,
			|	МАКСИМУМ(ПрайсЛист.Цена) КАК Цена,
			|	МАКСИМУМ(ПрайсЛист.Наличие) КАК Наличие,
			|	МАКСИМУМ(ПрайсЛист.НаличиеСтрокой) КАК НаличиеСтрокой,
			|	СУММА(ЕСТЬNULL(ПрайсЛист.Количество, 0)) КАК Количество,
			|	&XCVXCVN,
			|	ПрайсЛист.ХарактеристикиИспользуются КАК ХарактеристикиИспользуются
			|ИЗ
			|	Выборка КАК ПрайсЛист
			|
			|СГРУППИРОВАТЬ ПО
			|	ПрайсЛист.Номенклатура,
			|	ПрайсЛист.Характеристика,
			|	ПрайсЛист.ЕдиницаИзмерения,
			|	ПрайсЛист.Организация,
			|	&XCVXCVN,
			|	ПрайсЛист.ХарактеристикиИспользуются";
	
	ОсновнойЗапрос = СтрЗаменить(ОсновнойЗапрос, "&XCVXCV КАК XCVXCV,", СтрСоединить(СтрокаИменОбъявление));
	ОсновнойЗапрос = СтрЗаменить(ОсновнойЗапрос, "&XCVXCVN,", СтрСоединить(СтрокаИмен));
	ОсновнойЗапрос = СтрЗаменить(ОсновнойЗапрос, "&XCVXCV,", СтрСоединить(СтрокаИменГруппировка));

	Свойства = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	Свойства["ТекстЗапроса"] = СтрЗаменить(ОсновнойЗапрос, "ПО ПрайсЛист.Номенклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка", СтрСоединить(МассивСтрокИз));
	
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.Список, Свойства);
	
	Для Каждого ПараметрЗапроса Из МассивПараметров Цикл 
		Список.Параметры.УстановитьЗначениеПараметра(ПараметрЗапроса.Представление, ПараметрЗапроса.Значение);
	КонецЦикла;
	
	Список.Параметры.УстановитьЗначениеПараметра("ПоЗапросу"  , НСтр("ru = 'Нет на складе'"));
	Список.Параметры.УстановитьЗначениеПараметра("Мало"       , НСтр("ru = 'Мало'"));
	Список.Параметры.УстановитьЗначениеПараметра("Достаточно" , НСтр("ru = 'Достаточно'"));
	Список.Параметры.УстановитьЗначениеПараметра("Много"      , НСтр("ru = 'Много'"));

КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНетЦенОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФорму("Справочник.ВидыЦен.ФормаСписка",,,,,
	    ,Новый ОписаниеОповещения("ПроверитьВидыЦен",ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВидыЦен(Результат, ДопПараметры) Экспорт
	
	УстановитьВидимостьПрайсЛиста();
	
КонецПроцедуры // ПроверитьВидыЦен()

&НаКлиенте
Функция ПоместитьВХранилищеСписокВыбранныхТоваров(ПараметрыЗаполнения = Неопределено)
	
	Если ПараметрыЗаполнения <> Неопределено
		И ПараметрыЗаполнения.Свойство("Наличие") Тогда
		
		НовоеНаличие = ПараметрыЗаполнения.Наличие;
		
		Если НовоеНаличие = "Нет на складе" Тогда
			НовоеНаличиеЧисло = 0;
		ИначеЕсли НовоеНаличие = "Мало" Тогда
			НовоеНаличиеЧисло = 1;
		ИначеЕсли НовоеНаличие = "Достаточно" Тогда
			НовоеНаличиеЧисло = 2;
		ИначеЕсли НовоеНаличие = "Много" Тогда
			НовоеНаличиеЧисло = 3;
		КонецЕсли;
	
	
	Иначе
		НовоеНаличие = Неопределено;
	КонецЕсли;
	
	Если ПараметрыЗаполнения <> Неопределено
		И ПараметрыЗаполнения.Свойство("РезультатВыполнения") Тогда
		РезультатВыполнения = ПараметрыЗаполнения.РезультатВыполнения;
	Иначе
		РезультатВыполнения = Неопределено;
	КонецЕсли;
	
	СписокВыбранныхТоваров = Новый Массив;
	Для Каждого Индекс Из Элементы.Список.ВыделенныеСтроки Цикл
		
		СтрокаТаблицы = Элементы.Список.ДанныеСтроки(Индекс);
		
		СтруктураТовара = Новый Структура;
		СтруктураТовара.Вставить("Номенклатура"              , СтрокаТаблицы.Номенклатура);
		СтруктураТовара.Вставить("Характеристика"            , СтрокаТаблицы.Характеристика);
		СтруктураТовара.Вставить("ЕдиницаИзмерения"          , СтрокаТаблицы.ЕдиницаИзмерения);
		СтруктураТовара.Вставить("Организация"               , СтрокаТаблицы.Организация);
		СтруктураТовара.Вставить("Количество"                , СтрокаТаблицы.Количество);
		СтруктураТовара.Вставить("ХарактеристикиИспользуются", СтрокаТаблицы.ХарактеристикиИспользуются);
		СтруктураТовара.Вставить("Модифицирован", Истина);

		
		Если НовоеНаличие = Неопределено Тогда
			СтруктураТовара.Вставить("Наличие"                   , СтрокаТаблицы.Наличие);
			СтруктураТовара.Вставить("НаличиеСтрокой"            , СтрокаТаблицы.НаличиеСтрокой);
		Иначе
			СтруктураТовара.Вставить("Наличие"                   , НовоеНаличиеЧисло);
			СтруктураТовара.Вставить("НаличиеСтрокой"            , НовоеНаличие);
			СтруктураТовара.Вставить("Модифицирован"             , Истина);
		КонецЕсли;
		
		Для Каждого ВидЦены Из ВидыЦен Цикл
			
			СтруктураТовара.Вставить(ВидЦены.УникальноеИмя, СтрокаТаблицы[ВидЦены.УникальноеИмя]);
			
		КонецЦикла;
		
		Если РезультатВыполнения <> Неопределено Тогда
		Для Каждого ВидЦены Из РезультатВыполнения.ВидыЦен Цикл
				
				Если ВидЦены.Пометка Тогда 
					
					СуммаПроцента = РезультатВыполнения.Процент * СтруктураТовара[ВидЦены.Значение]/100;
					
					Если РезультатВыполнения.Уменьшить Тогда 
						СтруктураТовара[ВидЦены.Значение] = СтруктураТовара[ВидЦены.Значение] - СуммаПроцента;
					Иначе 
						СтруктураТовара[ВидЦены.Значение] = СтруктураТовара[ВидЦены.Значение] + СуммаПроцента;
					КонецЕсли;
					
					СтруктураТовара.Вставить("Модифицирован"             , Истина);
					
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
		СписокВыбранныхТоваров.Добавить(СтруктураТовара);
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилищеБезКонтекста(СписокВыбранныхТоваров);
КонецФункции // ПолучитьСписокВыбранныхТоваров()

&НаСервереБезКонтекста
Функция ПоместитьВоВременноеХранилищеБезКонтекста(СписокВыбранныхТоваров)
	
	Возврат ПоместитьВоВременноеХранилище(СписокВыбранныхТоваров);
	
КонецФункции // ПоместитьВоВременноеХранилище()

&НаКлиенте
Процедура РедактированиеПрайсЛистаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Истина Тогда
		Элементы.Список.Обновить();
	КонецЕсли;
	
	Модифицированность = Ложь;
КонецПроцедуры // РедактированиеПрайсЛистаЗавершение()

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокХарактеристика.Имя);
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.ХарактеристикиИспользуются");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<характеристики не используются>'"));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры

#КонецОбласти

