
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	ЗаполнитьВидыЦен();
	ДобавитьКолонкиВидовЦен();
	
	Параметры.Свойство("РежимРедактирования", РежимРедактирования);
	
	Если Параметры.Свойство("Добавление") Тогда
		Добавление = Истина;
		АвтоЗаголовок = Ложь;
		Заголовок = НСтр("ru = 'Добавление товаров в прайс-лист'");
	КонецЕсли;
	
	Если Параметры.Свойство("Изменение") Тогда
		Изменение = Истина;
		Элементы.ТаблицаПрайсЛистГруппаКоманды.Видимость = Ложь;
		Элементы.ТаблицаПрайсЛистСкопировать.Видимость   = Ложь;
	КонецЕсли;

	Если Параметры.Свойство("Копирование") Тогда
		РежимРедактирования = Истина;
		Копирование = Истина;
		АвтоЗаголовок = Ложь;
		Заголовок = НСтр("ru = 'Добавление товаров в прайс-лист'");
	КонецЕсли;
	
	Параметры.Свойство("Номенклатура", Номенклатура);
	
	Если НЕ Номенклатура.Пустая() Тогда
		ИспользуютсяХарактеристики = ПолучитьИспользованиеХарактеристик(Номенклатура);
		Элементы.ТаблицаПрайсЛистНоменклатура.ТолькоПросмотр  = Истина;
		Элементы.ТаблицаПрайсЛистНоменклатура.Видимость       = Ложь;
		Элементы.ТаблицаПрайсЛистГруппаКоманды.Видимость = Ложь;
		Элементы.ТаблицаПрайсЛистДобавитьКнопка.Видимость = Истина;
	КонецЕсли;
	
	Если Параметры.Свойство("ИмяКолонки") Тогда
		Элементы.ТаблицаПрайсЛист.ТекущийЭлемент = Элементы["ТаблицаПрайсЛист" + Параметры.ИмяКолонки];
	Иначе
		Элементы.ТаблицаПрайсЛист.ТекущийЭлемент = Элементы.ТаблицаПрайсЛистНоменклатура;
	КонецЕсли;
	
	Адрес = Неопределено;
	Если Параметры.Свойство("Адрес", Адрес) Тогда
		
		МассивТоваров = ПолучитьИзВременногоХранилища(Адрес);
		
		Для Каждого Товар Из МассивТоваров Цикл
			
			НоваяСтрока = ТаблицаПрайсЛист.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Товар);
			
			НоваяСтрока.ОрганизацияДо = Товар.Организация;
			НоваяСтрока.НоменклатураДо = Товар.Номенклатура;
			НоваяСтрока.ХарактеристикаДо = Товар.Характеристика;
			НоваяСтрока.ЕдиницаИзмеренияДо = Товар.ЕдиницаИзмерения;
			
			Если Элементы.ТаблицаПрайсЛист.ТекущаяСтрока = Неопределено Тогда
				Элементы.ТаблицаПрайсЛист.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	СхемаВыгрузкиДанных = Справочники.ТорговыеПредложения.ПолучитьМакет("СхемаВыгрузки");
	
	АдресСхемы = ПоместитьВоВременноеХранилище(СхемаВыгрузкиДанных, УникальныйИдентификатор);
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы)); 
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаВыгрузкиДанных.НастройкиПоУмолчанию);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("ВойтиВРежимРедактирование", 0.1, Истина);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаПрайсЛист

&НаКлиенте
Процедура ТаблицаПрайсЛистНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаПрайсЛист.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, РеквизитыНоменклатуры(ТекущиеДанные.Номенклатура));
	
	Если Не ТекущиеДанные.ХарактеристикиИспользуются Тогда
		ТекущиеДанные.ХарактеристикаДо = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");
		ТекущиеДанные.Характеристика   = ТекущиеДанные.ХарактеристикаДо;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПрайсЛистНаличиеСтрокойПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ТаблицаПрайсЛист.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.НаличиеСтрокой = "Нет на складе" Тогда
		 ТекущиеДанные.Наличие = 0;
	ИначеЕсли ТекущиеДанные.НаличиеСтрокой = "Мало" Тогда
		 ТекущиеДанные.Наличие = 1;
	ИначеЕсли ТекущиеДанные.НаличиеСтрокой = "Достаточно" Тогда
		 ТекущиеДанные.Наличие = 2;
	ИначеЕсли ТекущиеДанные.НаличиеСтрокой = "Много" Тогда
		 ТекущиеДанные.Наличие = 3;
	 КонецЕсли;
	 
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПрайсЛистПередУдалением(Элемент, Отказ)
	
	Если НЕ Изменение Тогда
		Возврат
	КонецЕсли;
	
	Отказ = Истина;
	
	ТекущиеДанные = Элементы.ТаблицаПрайсЛист.ТекущиеДанные;
	
	ТекущиеДанные.Удален        = Истина;
	ТекущиеДанные.Модифицирован = Истина;
	
	Для Каждого ВидЦены Из ВидыЦен Цикл
		
	ТекущиеДанные[ВидЦены.УникальноеИмя] = 0;
	
	КонецЦикла;
	
	ТекущиеДанные.Количество = 0;
	ТекущиеДанные.Наличие    = -1;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Удален", Ложь);
	
	Элементы.ТаблицаПрайсЛист.ОтборСтрок = Новый ФиксированнаяСтруктура(ПараметрыОтбора);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПрайсЛистПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Изменение Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПрайсЛистПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элементы.ТаблицаПрайсЛист.ТекущиеДанные;
		ТекущиеДанные.Номенклатура = Номенклатура;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПрайсЛистПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаПрайсЛист.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		ТекущиеДанные.Модифицирован = Истина;
		
		Если НЕ Изменение Тогда
			
			ТекущиеДанные.ОрганизацияДо      = ТекущиеДанные.Организация;
			ТекущиеДанные.НоменклатураДо     = ТекущиеДанные.Номенклатура;
			ТекущиеДанные.ХарактеристикаДо   = ТекущиеДанные.Характеристика;
			ТекущиеДанные.ЕдиницаИзмеренияДо = ТекущиеДанные.ЕдиницаИзмерения;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	
	ОчиститьСообщения();
	
	Для Каждого СтрокаТаблицы Из ТаблицаПрайсЛист Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = НСтр("ru = 'Не заполнено поле Номенклатура'");
			Сообщение.Поле = СтрШаблон(НСтр("ru = 'ТаблицаПрайсЛист[%1].Номенклатура'"), ТаблицаПрайсЛист.Индекс(СтрокаТаблицы));
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Возврат;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = НСтр("ru = 'Не заполнено поле Единица измерения'");
			Сообщение.Поле = СтрШаблон(НСтр("ru = 'ТаблицаПрайсЛист[%1].ЕдиницаИзмерения'"), ТаблицаПрайсЛист.Индекс(СтрокаТаблицы));
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Возврат;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Характеристика) И СтрокаТаблицы.ХарактеристикиИспользуются Тогда
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = НСтр("ru = 'Не заполнено поле Характеристика'");
			Сообщение.Поле = СтрШаблон(НСтр("ru = 'ТаблицаПрайсЛист[%1].Характеристика'"), ТаблицаПрайсЛист.Индекс(СтрокаТаблицы));
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПроверкаНаДубли() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ДлительнаяОперация = СохранитьНаСервере();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	
	ПараметрыОжидания.Интервал = 2;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация,
			Новый ОписаниеОповещения("ВыполнитьПроцедуруВыполнено", ЭтотОбъект),
			ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоУсловию(Команда)
	
	
	ОткрытьФорму("Справочник.ТорговыеПредложения.Форма.ФормаВыбораНоменклатуры",
	         Новый Структура("Настройки",КомпоновщикНастроек.Настройки),
	         ЭтотОбъект.УникальныйИдентификатор,
	         ,,,
	         Новый ОписаниеОповещения("ПриЗакрытииФормыВыбранныхОбъектов",ЭтотОбъект));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТаблицаПрайсЛистХарактеристика.Имя);
	
	ГруппаИ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЭлементУсловногоОформления.Отбор.Элементы
					,"Характеристики", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
					
	ОтборЭлемента = ГруппаИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаПрайсЛист.ХарактеристикиИспользуются");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ОтборЭлемента = ГруппаИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ИспользуютсяХарактеристики");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<характеристики не используются>'"));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры

&НаСервере
Функция ПроверкаНаДубли()

	Если Изменение Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Таблица = ТаблицаПрайсЛист.Выгрузить(,"Характеристика, Номенклатура, ЕдиницаИзмерения, Организация");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Товары.Организация КАК Организация,
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Характеристика КАК Характеристика,
		|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения
		|ПОМЕСТИТЬ Товары
		|ИЗ
		|	&Товары КАК Товары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.Организация КАК Организация,
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Характеристика КАК Характеристика,
		|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения
		|ИЗ
		|	Товары КАК Товары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПрайсЛист КАК ПрайсЛист
		|		ПО Товары.Организация = ПрайсЛист.Организация
		|			И Товары.Номенклатура = ПрайсЛист.Номенклатура
		|			И Товары.Характеристика = ПрайсЛист.Характеристика
		|			И Товары.ЕдиницаИзмерения = ПрайсЛист.ЕдиницаИзмерения
		|
		|СГРУППИРОВАТЬ ПО
		|	Товары.Организация,
		|	Товары.Характеристика,
		|	Товары.ЕдиницаИзмерения,
		|	Товары.Номенклатура";
		
		Запрос.УстановитьПараметр("Товары", Таблица);
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Ответ = НЕ РезультатЗапроса.Пустой();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Отбор = Новый Структура;
			Отбор.Вставить("Организация"     , ВыборкаДетальныеЗаписи.Организация);
			Отбор.Вставить("Номенклатура"    , ВыборкаДетальныеЗаписи.Номенклатура);
			Отбор.Вставить("Характеристика"  , ВыборкаДетальныеЗаписи.Характеристика);
			Отбор.Вставить("ЕдиницаИзмерения", ВыборкаДетальныеЗаписи.ЕдиницаИзмерения);
			
			МассивСтрок = ТаблицаПрайсЛист.НайтиСтроки(Отбор);
			Для Каждого СтрокаМассива Из МассивСтрок Цикл
				
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = НСтр("ru = 'В прайс-листе уже есть товар с такими свойствами'");
				Сообщение.Поле = СтрШаблон(НСтр("ru = 'ТаблицаПрайсЛист[%1].Номенклатура'"), ТаблицаПрайсЛист.Индекс(СтрокаМассива));
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();
				
			КонецЦикла;
			
		КонецЦикла;
	
	Возврат Ответ;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьВидыЦен()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыЦен.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ВидыЦен.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА ВидыЦен.Наименование
	|		ИНАЧЕ ВидыЦен.Наименование + "", "" + ВидыЦен.Валюта.Наименование
	|	КОНЕЦ КАК Имя,
	|	ВидыЦен.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ВидыЦен КАК ВидыЦен
	|ГДЕ
	|	НЕ ВидыЦен.ПометкаУдаления";
	
	ВидыЦен.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКолонкиВидовЦен()
	
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой));
	МассивРеквизитов = Новый Массив;
	
	Для Каждого ВидЦены Из ВидыЦен Цикл
		ВидЦены.УникальноеИмя = "ВидЦены_" + СтрЗаменить(ВРег(Строка(ВидЦены.Ссылка.УникальныйИдентификатор())), "-", "x");
		МассивРеквизитов.Добавить(Новый РеквизитФормы(ВидЦены.УникальноеИмя,ОписаниеТиповЧисло, "ТаблицаПрайсЛист", ВидЦены.Имя));
		
	КонецЦикла;
	
	ИзменитьРеквизиты(МассивРеквизитов);
	
	Для Каждого ВидЦены Из ВидыЦен Цикл
		
		ВидЦены.Отображать = Истина;
		
		НовыйЭлемент = Элементы.Добавить("ТаблицаПрайсЛист" + ВидЦены.УникальноеИмя, Тип("ПолеФормы"), Элементы.ТаблицаПрайсЛистЦены);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.Заголовок = ВидЦены.Имя;
		НовыйЭлемент.ПутьКДанным = "ТаблицаПрайсЛист." + ВидЦены.УникальноеИмя;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВойтиВРежимРедактирование()

	Если Добавление Тогда
		Элементы.ТаблицаПрайсЛист.ДобавитьСтроку();
	КонецЕсли;
	
	Если РежимРедактирования И ТаблицаПрайсЛист.Количество() > 0 Тогда
		Элементы.ТаблицаПрайсЛист.ИзменитьСтроку();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СохранитьНаСервере()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ТаблицаПрайсЛист", ТаблицаПрайсЛист.Выгрузить());
	СтруктураПараметров.Вставить("ВидыЦен", ВидыЦен.Выгрузить());
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Сохранение прайс-листа'");
	
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(
	         "РегистрыСведений.ПрайсЛист.СохранитьИзмененныйПрайсЛист",
	         СтруктураПараметров,
	         ПараметрыВыполнения);
	
	Возврат ДлительнаяОперация;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПроцедуруВыполнено(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		
		Возврат;
		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
		
	ИначеЕсли Результат.Статус = "Выполнено" Тогда
		
		Закрыть(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыНоменклатуры(Номенклатура)
	
	Ответ = Новый Структура;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ЕСТЬNULL(ВидыНоменклатуры.ИспользоватьХарактеристики, ЛОЖЬ) КАК ХарактеристикиИспользуются
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|		ПО Номенклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка
		|ГДЕ
		|	Номенклатура.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Номенклатура);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		Ответ.Вставить("ЕдиницаИзмерения", Результат.ЕдиницаИзмерения);
		Ответ.Вставить("ХарактеристикиИспользуются", Результат.ХарактеристикиИспользуются);
		
	КонецЦикла;
	
	Возврат Ответ;
КонецФункции

&НаКлиенте
Процедура ПриЗакрытииФормыВыбранныхОбъектов(Настройки, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Настройки) = Тип("НастройкиКомпоновкиДанных") Тогда
		
		КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
		ЗаполнитьТоварыОтбора();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыОтбора()

	ТаблицаПрайсЛист.Очистить();
	СхемаКомпоновки = Справочники.ТорговыеПредложения.ПолучитьМакет("СхемаВыгрузки");
	
	ТаблицаДанныеПакетаПредложений = Новый ТаблицаЗначений;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, КомпоновщикНастроек.Настройки,,,
	         Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"), Ложь);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,,,);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	ПроцессорВывода.УстановитьОбъект(ТаблицаДанныеПакетаПредложений);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	ТаблицаПрайсЛист.Загрузить(ТаблицаДанныеПакетаПредложений);
	
	Для Каждого Товар Из ТаблицаПрайсЛист Цикл
		
		ЗаполнитьЗначенияСвойств(Товар, РеквизитыНоменклатуры(Товар.Номенклатура));
		
		Товар.НаличиеСтрокой = НСтр("ru = 'Нет на складе'");
		Товар.Наличие = 0;
		
		Товар.Модифицирован = Истина;
		
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьТоварыОтбора()

&НаСервереБезКонтекста
Функция ПолучитьИспользованиеХарактеристик(Номенклатура)
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВидыНоменклатуры.ИспользоватьХарактеристики КАК ИспользоватьХарактеристики
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|		ПО Номенклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка
		|ГДЕ
		|	Номенклатура.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Результат = ВыборкаДетальныеЗаписи.ИспользоватьХарактеристики;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
