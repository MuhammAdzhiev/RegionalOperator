
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
	Если Не ЗначениеЗаполнено(Запись.ИсходныйКлючЗаписи.Штрихкод) Тогда
		ЗаполнитьПараметрыШтрихкодаИС();
	КонецЕсли;
	
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЗаполнитьПараметрыШтрихкодаИС();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаписатьПараметрыШтрихкодаИС(Отказ);
	ЗаполнитьПараметрыШтрихкодаИС();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	Если Не КлиентЭДОВызовСервера.ИспользуетсяГосИС()
		Или Не ОбщегоНазначенияИСПовтИсп.ЭтоПродукцияИСМП(КлючВидовПродукцииИС)
		Или Не ЗначениеЗаполнено(ВидУпаковкиИС) Тогда
		МассивНепроверяемыхРеквизитов.Добавить("КоличествоПотребительскихУпаковокИС");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("Запись_РегистрСведенийШтрихкоды", Запись.Номенклатура, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидУпаковкиИСПриИзменении(Элемент)
	
	Если ВидУпаковкиИС = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Потребительская") Тогда
		КоличествоПотребительскихУпаковокИС = 1;
	ИначеЕсли Не ЗначениеЗаполнено(ВидУпаковкиИС) Тогда
		КоличествоПотребительскихУпаковокИС = 0;
	КонецЕсли;
	
	ВидУпаковкиИСПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ШтрихкодПриИзменении(Элемент)
	ШтрихкодПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	НоменклатураПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВидУпаковкиИСПриИзмененииНаСервере()
	
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаСервере
Процедура ШтрихкодПриИзмененииНаСервере()
	
	ЗаполнитьПараметрыШтрихкодаИС();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПараметрыШтрихкодаИС(Отказ)
	
	GTIN = ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.GTINПоШтрихкодуEAN(Запись.Штрихкод);
	
	ДанныеОписания = РегистрыСведений.ОписаниеGTINИС.ИнициализироватьДанныеОписания();
	ДанныеОписания.GTIN = GTIN;
	ДанныеОписания.ВидУпаковки = ВидУпаковкиИС;
	ДанныеОписания.КоличествоПотребительскихУпаковок = КоличествоПотребительскихУпаковокИС;
	
	НачатьТранзакцию();
	
	Попытка
		РегистрыСведений.ОписаниеGTINИС.УстановитьОписание(ДанныеОписания);
		ЗафиксироватьТранзакцию();
	Исключение
		
		ОтменитьТранзакцию();
		Отказ = Истина;
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Ошибка записи описания GTIN'"),
			УровеньЖурналаРегистрации.Ошибка,,,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон(
				НСтр("ru = 'Ошибка записи описания GTIN по причине: %1'"),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыШтрихкодаИС()
	
	Если Не КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		Возврат;
	КонецЕсли;
	
	КлючВидовПродукцииИС = ОбщегоНазначенияИС.ОписаниеНоменклатуры(Запись.Номенклатура)[Запись.Номенклатура].КлючВидовПродукции;
	
	GTIN = ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.GTINПоШтрихкодуEAN(Запись.Штрихкод);
	
	ОписаниеGTIN = РегистрыСведений.ОписаниеGTINИС.ПолучитьОписание(GTIN)[GTIN];
	Если ОписаниеGTIN <> Неопределено Тогда
		ВидУпаковкиИС                       = ОписаниеGTIN.ВидУпаковки;
		КоличествоПотребительскихУпаковокИС = ОписаниеGTIN.КоличествоПотребительскихУпаковок;
	КонецЕсли;
	
	ПредставлениеВидовУпаковок = Новый Соответствие;
	
	ВидПродукцииИС = Неопределено;
	
	Если ЗначениеЗаполнено(КлючВидовПродукцииИС) Тогда
		ВидПродукцииИС = КонструкторИСОбщегоНазначенияКлиентСервер.ВидПродукцииКлючаПоПодсистеме(КлючВидовПродукцииИС, "ГИСМТ");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидПродукцииИС) Тогда
		ПредставлениеВидовУпаковок.Вставить(
			Перечисления.ВидыУпаковокИС.Потребительская,
			КонструкторИСМПОбщегоНазначенияКлиентСервер.ПредставлениеВидаУпаковкиПоВидуПродукции(ВидПродукцииИС, Перечисления.ВидыУпаковокИС.Потребительская));
		ПредставлениеВидовУпаковок.Вставить(
			Перечисления.ВидыУпаковокИС.Групповая,
			КонструкторИСМПОбщегоНазначенияКлиентСервер.ПредставлениеВидаУпаковкиПоВидуПродукции(ВидПродукцииИС, Перечисления.ВидыУпаковокИС.Групповая));
		ПредставлениеВидовУпаковок.Вставить(
			Перечисления.ВидыУпаковокИС.Набор,
			КонструкторИСМПОбщегоНазначенияКлиентСервер.ПредставлениеВидаУпаковкиПоВидуПродукции(ВидПродукцииИС, Перечисления.ВидыУпаковокИС.Набор));
		ПредставлениеВидовУпаковок.Вставить(
			Перечисления.ВидыУпаковокИС.Логистическая,
			КонструкторИСМПОбщегоНазначенияКлиентСервер.ПредставлениеВидаУпаковкиПоВидуПродукции(ВидПродукцииИС, Перечисления.ВидыУпаковокИС.Логистическая));
	КонецЕсли;
	
	ИспользуютсяНаборы            = КонструкторИСОбщегоНазначенияКлиентСервер.ВидПродукцииИспользуетНаборы(КлючВидовПродукцииИС);
	ИспользуютсяГрупповыеУпаковки = КонструкторИСОбщегоНазначенияКлиентСервер.ВидПродукцииИспользуетГрупповыеУпаковки(КлючВидовПродукцииИС);
	ВидУпаковкиСписокВыбора.Очистить();
	ВидУпаковкиСписокВыбора.Добавить(
		Перечисления.ВидыУпаковокИС.Потребительская,
		ПредставлениеВидовУпаковок[Перечисления.ВидыУпаковокИС.Потребительская]);
	Если ИспользуютсяГрупповыеУпаковки Тогда
		ВидУпаковкиСписокВыбора.Добавить(
			Перечисления.ВидыУпаковокИС.Групповая,
			ПредставлениеВидовУпаковок[Перечисления.ВидыУпаковокИС.Групповая]);
	КонецЕсли;
	Если ИспользуютсяНаборы Тогда
		ВидУпаковкиСписокВыбора.Добавить(
			Перечисления.ВидыУпаковокИС.Набор,
			ПредставлениеВидовУпаковок[Перечисления.ВидыУпаковокИС.Набор]);
	КонецЕсли;
	
	ВидУпаковкиСписокВыбора.Добавить(
		Перечисления.ВидыУпаковокИС.Логистическая,
		ПредставлениеВидовУпаковок[Перечисления.ВидыУпаковокИС.Логистическая]);
	
	Элементы.ВидУпаковкиИС.СписокВыбора.Очистить();
	Для Каждого ЭлементСписка Из ВидУпаковкиСписокВыбора Цикл
		Элементы.ВидУпаковкиИС.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы()
	
	Если Не (ОбщегоНазначенияИСПовтИсп.ЭтоПродукцияИСМП(КлючВидовПродукцииИС, Истина)
		Или ОбщегоНазначенияИСПовтИсп.ЭтоПродукцияИСМП(КлючВидовПродукцииИС, Истина)) Тогда
		Элементы.КоличествоПотребительскихУпаковокИС.Видимость = Ложь;
		Элементы.ВидУпаковкиИС.Видимость                       = Ложь;
		Элементы.КоличествоПотребительскихУпаковокИС.Подсказка = "";
		Элементы.КоличествоПотребительскихУпаковокИС.ОтображениеПодсказки = ОтображениеПодсказки.Авто;
	Иначе
		Элементы.КоличествоПотребительскихУпаковокИС.Видимость = Истина;
		Элементы.ВидУпаковкиИС.Видимость                       = Истина;
		Если ВидУпаковкиИС = Перечисления.ВидыУпаковокИС.Набор
			И КоличествоПотребительскихУпаковокИС = 0 Тогда
			Элементы.КоличествоПотребительскихУпаковокИС.Подсказка            = НСтр("ru = 'Варианты комплектации не поддерживаются'");
			Элементы.КоличествоПотребительскихУпаковокИС.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСправа;
		Иначе
			Элементы.КоличествоПотребительскихУпаковокИС.Подсказка            = "";
			Элементы.КоличествоПотребительскихУпаковокИС.ОтображениеПодсказки = ОтображениеПодсказки.Авто;
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначенияИС.ПрименитьУсловноеОформлениеКПолю(ЭтотОбъект, "КоличествоПотребительскихУпаковокИС");
	
КонецПроцедуры

&НаСервере
Процедура НоменклатураПриИзмененииНаСервере()
	ЗаполнитьПараметрыШтрихкодаИС();
	НастроитьЭлементыФормы();
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	//
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("КоличествоПотребительскихУпаковокИС");
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидУпаковкиИС");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ОтборЭлемента.ПравоеЗначение = Новый СписокЗначений();
	ОтборЭлемента.ПравоеЗначение.Добавить(Перечисления.ВидыУпаковокИС.Потребительская);
	ОтборЭлемента.ПравоеЗначение.Добавить(Перечисления.ВидыУпаковокИС.ПустаяСсылка());
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	//
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("КоличествоПотребительскихУпаковокИС");
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидУпаковкиИС");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.ВидыУпаковокИС.Набор;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
КонецПроцедуры

#КонецОбласти