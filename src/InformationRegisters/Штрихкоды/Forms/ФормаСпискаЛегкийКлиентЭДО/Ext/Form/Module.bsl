
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Отбор.Свойство("Номенклатура") Тогда
		НоменктатураОтбор = Параметры.Отбор.Номенклатура;
	КонецЕсли;
	
	Элементы.Характеристика.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	
	НастроитьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()
	
	НастроитьЭлементыФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Если Не КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		Возврат;
	КонецЕсли;
	
	МассивGTIN = Новый Массив;
	
	Для Каждого СтрокаДанных Из Строки Цикл
		ДанныеСтроки = СтрокаДанных.Значение.Данные;
		GTIN = ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.GTINПоШтрихкодуEAN(ДанныеСтроки.Штрихкод);
		МассивGTIN.Добавить(GTIN);
	КонецЦикла;
	
	Если МассивGTIN.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОписанияGTIN = РегистрыСведений.ОписаниеGTINИС.ПолучитьОписание(МассивGTIN);
	
	Для Каждого СтрокаДанных Из Строки Цикл
		ДанныеСтроки = СтрокаДанных.Значение.Данные;
		GTIN = ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.GTINПоШтрихкодуEAN(ДанныеСтроки.Штрихкод);
		ОписаниеGTIN = ОписанияGTIN[GTIN];
		Если ОписаниеGTIN = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДанныеСтроки.ВидУпаковкиИС = ОписаниеGTIN.ВидУпаковки;
		ДанныеСтроки.КоличествоПотребительскихУпаковокИС = ОписаниеGTIN.КоличествоПотребительскихУпаковок;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НастроитьЭлементыФормы()
	
	ИспользуетсяГосИС = КлиентЭДОВызовСервера.ИспользуетсяГосИС();
	
	Элементы.ВидУпаковкиИС.Видимость                       = ИспользуетсяГосИС;
	Элементы.КоличествоПотребительскихУпаковокИС.Видимость = ИспользуетсяГосИС;
	Элементы.КлючВидовПродукции.Видимость                  = ИспользуетсяГосИС;
	
	Если Не ИспользуетсяГосИС Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоменктатураОтбор) Тогда
		ВидПродукцииИС = ОбщегоНазначенияИС.ОписаниеНоменклатуры(НоменктатураОтбор)[НоменктатураОтбор].КлючВидовПродукции;
		ВидимостьВидаУпаковки = ОбщегоНазначенияИСПовтИсп.ЭтоПродукцияИСМП(ВидПродукцииИС, Истина);
		Элементы.ВидУпаковкиИС.Видимость                       = ВидимостьВидаУпаковки;
		Элементы.КоличествоПотребительскихУпаковокИС.Видимость = ВидимостьВидаУпаковки;
		Элементы.КлючВидовПродукции.Видимость = ВидимостьВидаУпаковки
			Или КонструкторИСОбщегоНазначенияКлиентСервер.ЭтоМаркируемаяПродукцияЕГАИС(ВидПродукцииИС);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ДоступныеВидыПродукции = КонструкторИСМПОбщегоНазначенияКлиентСервер.ДоступныеВидыПродукции();
	
	ВидыУпаковок = Новый Массив;
	ВидыУпаковок.Добавить(Перечисления.ВидыУпаковокИС.Потребительская);
	ВидыУпаковок.Добавить(Перечисления.ВидыУпаковокИС.Групповая);
	
	Для Каждого ВидПродукции Из ДоступныеВидыПродукции Цикл
		
		Для Каждого ВидУпаковки Из ВидыУпаковок Цикл
			
			ПредставлениеВидаУпаковки = КонструкторИСМПОбщегоНазначенияКлиентСервер.ПредставлениеВидаУпаковкиПоВидуПродукции(
				ВидПродукции, ВидУпаковки);
			
			Если Не ЗначениеЗаполнено(ПредставлениеВидаУпаковки) Тогда
				Продолжить;
			КонецЕсли;
			
			Элемент = УсловноеОформление.Элементы.Добавить();
			
			ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
			ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ВидУпаковкиИС.Имя);
			
			ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(Элементы.ВидУпаковкиИС.ПутьКДанным);
			ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
			ОтборЭлемента.ПравоеЗначение = ВидУпаковки;
			
			ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.ВидПродукцииГИСМТ");
			ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
			ОтборЭлемента.ПравоеЗначение = ВидПродукции;
		
			Элемент.Оформление.УстановитьЗначениеПараметра("Текст", ПредставлениеВидаУпаковки);
		
		КонецЦикла;
		
	КонецЦикла;
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.КоличествоПотребительскихУпаковокИС.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(Элементы.ВидУпаковкиИС.ПутьКДанным);
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.ВидыУпаковокИС.Набор;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(Элементы.КоличествоПотребительскихУпаковокИС.ПутьКДанным);
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 0;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст",                   НСтр("ru = 'Определяется вариантом комплектации'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста",              ЦветаСтиля.ЦветТекстаНеТребуетВниманияГосИС);
	Элемент.Оформление.УстановитьЗначениеПараметра("ГоризонтальноеПоложение", ГоризонтальноеПоложение.Лево);
	
КонецПроцедуры

#КонецОбласти
