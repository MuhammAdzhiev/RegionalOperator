// Выполняет поиск номенклатуры по идентификатору сервиса 1С:Номенклатура.
// 
// Параметры:
//  ИдентификаторНоменклатуры - Строка - идентификатор в сервисе 1С:Номенклатура.
//  ИдентификаторФормы - Строка - уникальный идентификатор формы.
//
// Возвращаемое значение:
//  Структура - Данные номенклатуры.
//
Функция ДанныеНоменклатурыСервиса(Знач ИдентификаторНоменклатуры, Знач ИдентификаторФормы) Экспорт

	ДанныеНоменклатуры = Новый Структура;

	НоменклатураИХарактеристика = Новый Структура;
	НоменклатураИХарактеристика.Вставить("ИдентификаторНоменклатуры", ИдентификаторНоменклатуры);
	НоменклатураИХарактеристика.Вставить("ИдентификаторХарактеристики");

	Идентификаторы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НоменклатураИХарактеристика);
	ТаблицаНоменклатуры = РаботаСНоменклатурой.НоменклатураИХарактеристикиПоИдентификаторам(
		Идентификаторы);
	Если ЗначениеЗаполнено(ТаблицаНоменклатуры) Тогда
		ДанныеНоменклатуры.Вставить("Загружена", Истина);
		ДанныеНоменклатуры.Вставить("Ссылка", ТаблицаНоменклатуры[0].Номенклатура);
		Возврат ДанныеНоменклатуры;
	КонецЕсли;

	ПараметрыОперации = Новый Структура("Идентификаторы, АктуализироватьВспомогательныеДанные, ПолучатьТолькоОсновныеДанные",
		ИдентификаторНоменклатуры, Ложь, Истина);

	ДлительнаяОперация = РаботаСНоменклатуройСлужебныйВызовСервера.ПолучитьДанныеНоменклатурыСервиса(
		ПараметрыОперации, ИдентификаторФормы, Неопределено);

	ДанныеНоменклатуры.Вставить("Загружена", Ложь);
	ДанныеНоменклатуры.Вставить("ДлительнаяОперация", ДлительнаяОперация);

	Возврат ДанныеНоменклатуры;

КонецФункции

