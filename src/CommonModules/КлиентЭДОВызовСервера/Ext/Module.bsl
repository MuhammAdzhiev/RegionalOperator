// Обновляет реквизиты организации по переданным данным
//
// Параметры:
//  Организация - ОпределяемыйТип.Организация
//  РеквизитыОрганизации - см. ОбменСКонтрагентамиКлиентСервер.НовыйДанныеОрганизации
//
Процедура ОбновитьРеквизитыОрганизации(Организация, РеквизитыОрганизации) Экспорт
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		ОрганизацияОбъект = ОбщегоНазначенияБЭД.ОбъектПоСсылкеДляИзменения(Организация);
		ОрганизацияОбъект.ИНН = РеквизитыОрганизации.ИНН;
		ОрганизацияОбъект.КПП = РеквизитыОрганизации.КПП;
		ОрганизацияОбъект.ОГРН = РеквизитыОрганизации.ОГРН;
		ОрганизацияОбъект.НаименованиеСокращенное = РеквизитыОрганизации.НаименованиеСокращенное;
		ОрганизацияОбъект.ЮрФизЛицо =
			?(СтрДлина(РеквизитыОрганизации.ИНН) = 10,
			Перечисления.ЮрФизЛицо.ЮрЛицо,
			Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель);
		
		СтруктураНаименования = КлиентЭДОКлиентСервер.РазложитьСтрокуНаименованияОрганизации(
			ОрганизацияОбъект.НаименованиеСокращенное, ОрганизацияОбъект.ЮрФизЛицо);
		ОрганизацияОбъект.НаименованиеПолное =
			КлиентЭДОКлиентСервер.СформироватьНаименованиеПолное(ОрганизацияОбъект.ЮрФизЛицо, СтруктураНаименования);
		ОрганизацияОбъект.Наименование = КлиентЭДОКлиентСервер.СформироватьНаименование(СтруктураНаименования);
		
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ОрганизацияОбъект,
			РеквизитыОрганизации.ЮридическийАдрес, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		
		ОрганизацияОбъект.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
	КонецПопытки;
	
КонецПроцедуры

