#Область СозданиеНовогоКонтрагентаПриВводе

// Формирует строку "Создать" при отсутствии данных выбора.
//
// Параметры:
//  Параметры			 - Структура - смотри одноименный параметр события "АвтоПодбор"/"ОкончаниеВводаТекста".
//  ОкончаниеВводаТекста - Булево - признак обработки события "ОкончаниеВводаТекста".
// 
// Возвращаемое значение:
//  СписокЗначений - список данных выбора при вводе по строке, автоподборе текста и быстром выборе.
//
Функция ДанныеВыбораКонтрагента(Параметры, ОкончаниеВводаТекста = Ложь) Экспорт

	ДанныеВыбора = Справочники.Контрагенты.ПолучитьДанныеВыбора(Параметры);
	Если ДанныеВыбора.Количество() = 0 Тогда
		СтрокаПоиска = СокрЛП(Параметры.СтрокаПоиска);
		ДлинаСтроки  = СтрДлина(СтрокаПоиска);
		ЭтоСтрокаИНН = СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(СтрокаПоиска);
		Если ЭтоСтрокаИНН Тогда
			МассивПодстрок = Новый Массив;
			МассивПодстрок.Добавить(НСтр("ru='Создать: ИНН'"));
			МассивПодстрок.Добавить(" ");
			ИНН = Лев(СтрокаПоиска, 12);
			ЭтоКорректныйИНН = (ДлинаСтроки = 10
				И РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(ИНН, Истина, ""))
				Или (ДлинаСтроки = 12
				И РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(ИНН, Ложь, ""));
			Если ЭтоКорректныйИНН Тогда
				МассивПодстрок.Добавить(
					Новый ФорматированнаяСтрока(ИНН, ШрифтыСтиля.ЖирныйШрифтБЭД,
					ЦветаСтиля.РезультатУспехЦвет));
			Иначе
				МассивПодстрок.Добавить(ИНН);
			КонецЕсли;
			СколькоВопросов = ?(ЭтоКорректныйИНН Или ДлинаСтроки >= 12, 0, ?(ДлинаСтроки < 10, 10
				- ДлинаСтроки, 12 - ДлинаСтроки));
			ЗнакиВопроса = Лев("????????????", СколькоВопросов);
			ЛишниеЦифры  = Сред(СтрокаПоиска, 13);
			МассивПодстрок.Добавить(
				Новый ФорматированнаяСтрока(ЗнакиВопроса + ЛишниеЦифры, ,
				ЦветаСтиля.ЦветТекстаНекорректногоКонтрагента));
			ПредставлениеНового = Новый ФорматированнаяСтрока(МассивПодстрок);
		Иначе
			ПредставлениеНового = СтрШаблон(НСтр("ru='Создать: %1'"), СтрокаПоиска);
		КонецЕсли;
		ДанныеВыбора.Добавить(СтрокаПоиска, ПредставлениеНового);
		Если ОкончаниеВводаТекста Тогда
			// Добавляем вторую строку, чтобы в этом режиме не срабатывал автовыбор единственной строки.
			ДанныеВыбора.Добавить("");
		КонецЕсли;
	КонецЕсли;

	Возврат ДанныеВыбора;

КонецФункции

#КонецОбласти

// Настраивает интерфейс приложения
//
// Параметры:
//  ПоказыватьСтартовыйПомощникКЭДО - Булево - если Истина, то нужно запустить помощник
//  ТребуетсяОбновлениеИнтерфейса - Булево - признак необходимости вызвать функцию ОбновитьИнтерфейс().
//  ТребуетсяОткрытьФормуПервогоПодключения - Булево - признак необходимости открытия формы первого подключения
Процедура НастроитьИнтерфейс(Знач ПоказыватьСтартовыйПомощникКЭДО, ТребуетсяОбновлениеИнтерфейса, ТребуетсяОткрытьФормуПервогоПодключения = Ложь) Экспорт

	ЭтоМобильныйКлиент = ОбщегоНазначения.ЭтоМобильныйКлиент();
	Если Не ЭтоМобильныйКлиент Тогда
		ПоказатьСкрытьСодержимоеПанелей(ТребуетсяОбновлениеИнтерфейса);
	КонецЕсли;

	Если НастройкиЭДО.ИспользуетсяОбменЭлектроннымиДокументами()
		И Не ПоказыватьСтартовыйПомощникКЭДО Тогда
		
		Если ИспользуетсяГосИС() Тогда
			УстановитьИнтерфейсГосИС(ТребуетсяОбновлениеИнтерфейса);
			ТребуетсяОткрытьФормуПервогоПодключения = РегистрыСведений.УчетныеЗаписиЭДО.УчетныеЗаписиОтсутствуют();
		Иначе
			УстановитьИнтерфейсТекущиеДелаЭДО(ТребуетсяОбновлениеИнтерфейса);
		КонецЕсли;
		
		Если ТребуетсяОбновлениеИнтерфейса Тогда
			УстановитьСтандартныйИнтерфейс();
		КонецЕсли;
		
	КонецЕсли;

	Если ПоказыватьСтартовыйПомощникКЭДО Тогда
		Если УстановитьИнтерфейсСтартовыйПомощникКЭДО() Тогда
			ТребуетсяОбновлениеИнтерфейса = Истина;
		КонецЕсли;
	Иначе
		Если КлиентЭДО.ВосстановитьСистемныеНастройки() Тогда
			ТребуетсяОбновлениеИнтерфейса = Истина;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Устанавливает форму текущих дел (функциональная/легкая) как начальный интерфейс клиентского приложения.
// 
// Параметры:
//  ТребуетсяОбновлениеИнтерфейса - Булево
Процедура УстановитьИнтерфейсТекущиеДелаЭДО(ТребуетсяОбновлениеИнтерфейса) Экспорт

	ФормаТекущихДел = КлиентЭДО.ФормаОбменСКонтрагентамиТекущиеДелаПоЭДО();
	
	КлиентЭДО.УстановитьФормуНачальнойСтраницейПриложения(ФормаТекущихДел, ТребуетсяОбновлениеИнтерфейса);

КонецПроцедуры

// Устанавливает форму как начальный интерфейс клиентского приложения.
// 
// Параметры:
//  ТребуетсяОбновлениеИнтерфейса - Булево
Процедура УстановитьИнтерфейсГосИС(ТребуетсяОбновлениеИнтерфейса) Экспорт

