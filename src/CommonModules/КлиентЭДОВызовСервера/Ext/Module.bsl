// Устанавливает стартовый помощник ЭДО как начальный интерфейс клиентского приложения.
//
// Возвращаемое значение:
//  Булево - признак установления интерфейса стартовый помощник ЭДО.
//
Функция УстановитьИнтерфейсСтартовыйПомощникКЭДО()

	Форма = КлиентЭДО.ФормаСтартовыйПомощникКЭДО();

	ТребуетсяОбновлениеИнтерфейса = Ложь;
	КлиентЭДО.УстановитьФормуНачальнойСтраницейПриложения(Форма, ТребуетсяОбновлениеИнтерфейса);
	Если ТребуетсяОбновлениеИнтерфейса Тогда
		КлиентЭДО.СброситьНастройкиИнтерфейсаПриложения();
	КонецЕсли;
	
	Возврат ТребуетсяОбновлениеИнтерфейса;

КонецФункции

Функция НачатьОбновлениеИнформацииПоПриглашениямВ1СЭДО(КлючиСинхронизации, УникальныйИдентификатор) Экспорт

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр(
		"ru = 'Обновление информации о приглашениях в сервисе 1С:ЭДО'");

	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"СинхронизацияЭДО.ПолучитьПриглашения", КлючиСинхронизации, Неопределено);

КонецФункции

// Параметры:
//  ТребуетсяОбновлениеИнтерфейса - Булево
Процедура ПоказатьСкрытьСодержимоеПанелей(ТребуетсяОбновлениеИнтерфейса)
	
	УстановитьПривилегированныйРежим(Истина);
	СравнениеЗначений = Новый СравнениеЗначений;
	
	ТекущиеНастройкиПанелиРазделов = ХранилищеСистемныхНастроек.Загрузить(
		"Общее/ПанельРазделов/НастройкиКомандногоИнтерфейса");
	
	ТекущиеНастройкиПанелиНавигации = ХранилищеСистемныхНастроек.Загрузить(
		"ОсновнойРаздел/ПанельНавигации/НастройкиКомандногоИнтерфейса");
	
	ТекущиеНастройкиПанелиДействий = ХранилищеСистемныхНастроек.Загрузить(
		"ОсновнойРаздел/ПанельДействий/НастройкиКомандногоИнтерфейса");
	
	Настройки = ХранилищеСистемныхНастроек.Загрузить("ПанельРазделовКЭДО");
	Если СравнениеЗначений.Сравнить(Настройки, ТекущиеНастройкиПанелиРазделов) <> 0 Тогда
		ТребуетсяОбновлениеИнтерфейса = Истина;
	КонецЕсли;
	ХранилищеСистемныхНастроек.Сохранить("Общее/ПанельРазделов/НастройкиКомандногоИнтерфейса", ,
		Настройки);
	
	Настройки = ХранилищеСистемныхНастроек.Загрузить("ПанельНавигацииКЭДО");
	Если СравнениеЗначений.Сравнить(Настройки, ТекущиеНастройкиПанелиНавигации) <> 0 Тогда
		ТребуетсяОбновлениеИнтерфейса = Истина;
	КонецЕсли;
	
	ХранилищеСистемныхНастроек.Сохранить(
		"ОсновнойРаздел/ПанельНавигации/НастройкиКомандногоИнтерфейса", , Настройки);
	
	Настройки = ХранилищеСистемныхНастроек.Загрузить("ПанельДействийКЭДО");
	Если СравнениеЗначений.Сравнить(Настройки, ТекущиеНастройкиПанелиДействий) <> 0 Тогда
		ТребуетсяОбновлениеИнтерфейса = Истина;
	КонецЕсли;
	
	ХранилищеСистемныхНастроек.Сохранить(
		"ОсновнойРаздел/ПанельДействий/НастройкиКомандногоИнтерфейса", , Настройки);

КонецПроцедуры

