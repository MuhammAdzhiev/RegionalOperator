// Сопоставленная продукция ВЕТИС.
// 
// Параметры:
//  Реквизиты Реквизиты
// 
// Возвращаемое значение:
//  Структура - Сопоставленная продукция ВЕТИС:
// * Продукция - СправочникСсылка.ПродукцияВЕТИС
// * ЕдиницаИзмеренияВЕТИС - СправочникСсылка.ЕдиницыИзмеренияВЕТИС
// * Коэффициент - Число - 
Функция СопоставленнаяПродукцияВЕТИС(Реквизиты) Экспорт 
	
	Результат = Новый Структура;
	Результат.Вставить("Продукция");
	Результат.Вставить("ЕдиницаИзмеренияВЕТИС");
	Результат.Вставить("Коэффициент", 1);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Реквизиты.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Реквизиты.Характеристика);
	Запрос.УстановитьПараметр("Серия", Реквизиты.Серия);
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СоответствиеНоменклатурыВЕТИС.Продукция КАК Продукция,
	|	СоответствиеНоменклатурыВЕТИС.Продукция.ФасовкаЕдиницаИзмерения КАК ЕдиницаИзмеренияВЕТИС
	|ИЗ
	|	РегистрСведений.СоответствиеНоменклатурыВЕТИС КАК СоответствиеНоменклатурыВЕТИС
	|ГДЕ
	|	СоответствиеНоменклатурыВЕТИС.Номенклатура = &Номенклатура
	|	И СоответствиеНоменклатурыВЕТИС.Характеристика = &Характеристика
	|	И СоответствиеНоменклатурыВЕТИС.Серия = &Серия";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		Реквизиты.Вставить("ЕдиницаИзмеренияВЕТИС", Выборка.ЕдиницаИзмеренияВЕТИС);
		МассивЭлементов = Новый Массив;
		МассивЭлементов.Добавить(Реквизиты);
		Результат.Коэффициент = КлиентЭДО.КоэффициентыЕдиницИзмеренияПоВЕТИС(МассивЭлементов).Получить(Реквизиты.Номенклатура).Получить(Реквизиты.ЕдиницаИзмеренияВЕТИС).Коэффициент;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Коэффициент пересчета ВЕТИС.
// 
// Параметры:
//  Реквизиты Реквизиты
// 
// Возвращаемое значение:
//  Структура - Коэффициент пересчета ВЕТИС:
// * Коэффициент - Число
Функция КоэффициентПересчетаВЕТИС(Реквизиты) Экспорт 
	
	Результат = Новый Структура;
	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить(Реквизиты);
	Результат.Вставить("Коэффициент", КлиентЭДО.КоэффициентыЕдиницИзмеренияПоВЕТИС(МассивЭлементов).Получить(Реквизиты.Номенклатура).Получить(Реквизиты.ЕдиницаИзмеренияВЕТИС).Коэффициент);
	Если Не ЗначениеЗаполнено(Результат.Коэффициент) Тогда 
		Результат.Коэффициент = 1;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Результат проверки на соответствие требованиям ГИСМТ.
// 
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка.РеализацияТоваровУслуг
// 
// Возвращаемое значение:
//  Структура - Результат проверки на соответствие требованиям ГИСМТ:
// * ТекстВопроса - Строка
// * ТребуетсяВопросПользователю - Булево - 
Функция РезультатПроверкиНаСоответствиеТребованиямГИСМТ(СсылкаНаОбъект) Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ТекстВопроса",                "");
	ВозвращаемоеЗначение.Вставить("ТребуетсяВопросПользователю", Ложь);
	
	Источник          = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаНаОбъект);
	Результаты        = СоответствиеТребованиямГИСМТ.РезультатПроверкиПоМассивуДокументов(Источник);
	РезультатПроверки = Результаты[СсылкаНаОбъект];
	
	Если РезультатПроверки = Неопределено Тогда
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	Если РезультатПроверки.Статус = Перечисления.СтатусыОбработкиДокументовИСМП.НеВыполнялось
		Или РезультатПроверки.Статус = Перечисления.СтатусыОбработкиДокументовИСМП.ЗавершеноСОшибкойСервиса
		Или РезультатПроверки.Статус = Перечисления.СтатусыОбработкиДокументовИСМП.ЗавершеноСОшибкойТаймаута Тогда
		
		ВозвращаемоеЗначение.ТребуетсяВопросПользователю = Истина;
		ВозвращаемоеЗначение.ТекстВопроса = СтрШаблон(
			НСтр("ru = '%1. Отправить без проверки?'"),
			РезультатПроверки.Состояние);
		
	ИначеЕсли РезультатПроверки.Статус = Перечисления.СтатусыОбработкиДокументовИСМП.ЗавершеноСОшибкой Тогда
		
		ВозвращаемоеЗначение.ТребуетсяВопросПользователю = Истина;
		ВозвращаемоеЗначение.ТекстВопроса = СтрШаблон(
			НСтр("ru = '%1. Отправить документ?'"),
			РезультатПроверки.Состояние);
		
	ИначеЕсли РезультатПроверки.Статус = Перечисления.СтатусыОбработкиДокументовИСМП.ЗавершеноСПредупреждением Тогда
		
		ВозвращаемоеЗначение.ТребуетсяВопросПользователю = Истина;
		ВозвращаемоеЗначение.ТекстВопроса = НСтр("ru = 'Имеются предупреждения про проверке документа в ГИС МТ. Отправить документ?'");
		
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

