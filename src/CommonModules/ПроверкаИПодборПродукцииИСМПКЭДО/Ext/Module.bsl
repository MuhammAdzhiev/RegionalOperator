#Область ПрограммныйИнтерфейс

// Заполняет в табличной части служебные реквизиты, например: признак использования характеристик номенклатуры.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма.
//  ТабличнаяЧасть - ДанныеФормыКоллекция, ТаблицаЗначений - таблица для заполнения.
//
Процедура ЗаполнитьСлужебныеРеквизитыВКоллекции(Форма, ТабличнаяЧасть) Экспорт
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	
	Если ТабличнаяЧасть.Количество() > 0 Тогда
		ПерваяСтрокаКоллекции = ТабличнаяЧасть[0];
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрокаКоллекции, "ХарактеристикиИспользуются") Тогда
			ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
				Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
		КонецЕсли;
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрокаКоллекции, "ТребуетВзвешивания") Тогда
			ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТребуетВзвешивания",
				Новый Структура("Номенклатура", "ТребуетВзвешивания"));
		КонецЕсли;
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрокаКоллекции, "ПроизвольнаяЕдиницаУчета") Тогда
			ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакПроизвольнаяЕдиницаУчета",
				Новый Структура("Номенклатура", "ПроизвольнаяЕдиницаУчета"));
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПараметрыЗаполненияРеквизитов.Количество() > 0 Тогда
		ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(
			ТабличнаяЧасть, ПараметрыЗаполненияРеквизитов);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ЕстьМаркируемаяПродукцияВКоллекции(Коллекция, ВидМаркируемойПродукции, ЕстьМаркируемаяПродукция) Экспорт
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ТаблицаТовары.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ
	|	ВремТаблТовары
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТовары
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьМаркируемаяПродукция
	|ИЗ
	|	ВремТаблТовары КАК ТаблицаТовары
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|	ПО ТаблицаТовары.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
	|	И ОписаниеНоменклатурыИС.КлючВидовПродукции.ВидПродукцииГИСМТ <> ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка)
	|";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаТовары", Коллекция.Выгрузить(, "Номенклатура"));
	Результат = Запрос.Выполнить();
	
	ЕстьМаркируемаяПродукция = НЕ Результат.Пустой();
	
КонецПроцедуры

// Заполняет переданную таблицу товарами переданного документа.
//   Если таблица заполнена - дополняет ее значениями GTIN.
// 
// Параметры:
//  Контекст - ДанныеФормыСтруктура, ФормаКлиентскогоПриложения, ДокументСсылка - документ, маркируемую продукцию которого необходимо получить.
//  Сценарий - Число - номер сценария проверки/подбора в документе.
//  ТаблицаПродукции - ТаблицаЗначений - таблица продукции документа. (См. ПроверкаИПодборПродукцииИС.ТаблицаПродукцииДокумента())
//
Процедура ЗаполнитьПродукциюДокумента(Контекст, Сценарий, ТаблицаПродукции) Экспорт
	
	Если ТаблицаПродукции.Количество() > 0 Тогда
		РезультатЗапроса = ЗапросGTINпоТаблицеМаркируемойПродукции(ТаблицаПродукции);
		ТаблицаПродукции.Очистить();
	ИначеЕсли ТипЗнч(Контекст) = Тип("ДанныеФормыСтруктура") Тогда
			РезультатЗапроса = ЗапросПродукцииДанныеФормыСтруктура(Контекст, Сценарий);
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.ПоступлениеТоваровУслуг") Тогда
		РезультатЗапроса = ЗапросПродукцииПриобретениеТоваровУслуг(Контекст, Сценарий);
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.РеализацияТоваровУслуг") Тогда
		РезультатЗапроса = ЗапросПродукцииРеализацияТоваровУслуг(Контекст);
	ИначеЕсли ИнтеграцияИСМП.ЭтоВходящийЭлектронныйДокумент(Контекст) Тогда
		ЗаполнитьМаркируемуюПродукциюЭлектронногоДокумента(Контекст, ТаблицаПродукции);
		Возврат;
	Иначе
		Возврат;
	КонецЕсли;
	
	ВыборкаНоменклатура = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаНоменклатура.Следующий() Цикл
		ВыборкаХарактеристика = ВыборкаНоменклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаХарактеристика.Следующий() Цикл
			ПродукцияПоGTIN = ТаблицаПродукции.СкопироватьКолонки();
			СписокКодовGTIN = Новый Массив;
			
			ВыборкаGTIN = ВыборкаХарактеристика.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаGTIN.Следующий() Цикл
				
				Если Не ЗначениеЗаполнено(ВыборкаНоменклатура.Номенклатура) Тогда
					// Соответственно тут должен быть остаточный GTIN
					Выборка = ВыборкаGTIN.Выбрать();
					Пока Выборка.Следующий() Цикл
						ЗаполнитьЗначенияСвойств(ТаблицаПродукции.Добавить(), Выборка);
					КонецЦикла;
					Продолжить;
				КонецЕсли;
				
				Если ПродукцияПоGTIN.Количество() = 0 Тогда
					Выборка = ВыборкаGTIN.Выбрать();
					Пока Выборка.Следующий() Цикл
						ЗаполнитьЗначенияСвойств(ПродукцияПоGTIN.Добавить(), Выборка,, "GTIN");
					КонецЦикла;
				КонецЕсли;
				
				Если МенеджерОборудованияКлиентСервер.ПроверитьКорректностьGTIN(ВыборкаGTIN.GTIN) Тогда
					GTIN = ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.GTINПоШтрихкодуEAN(ВыборкаGTIN.GTIN);
					СписокКодовGTIN.Добавить(GTIN);
				КонецЕсли;
			КонецЦикла;
			
			СписокКодовGTIN = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СписокКодовGTIN);
			
			Для Каждого СтрокаПродукцииПоGTIN Из ПродукцияПоGTIN Цикл
				ЗаполнитьЗначенияСвойств(ТаблицаПродукции.Добавить(), СтрокаПродукцииПоGTIN);
				СтрокаПродукцииПоGTIN.КодыGTIN.ЗагрузитьЗначения(СписокКодовGTIN);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Контрагент не резидент.
// 
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - Контрагент
// 
// Возвращаемое значение:
//  Булево - Контрагент не резидент
Функция КонтрагентНеРезидент(Контрагент) Экспорт
	
	ЮрФизЛицоКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "ЮрФизЛицо");
	
	Возврат ЮрФизЛицоКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент;
	
КонецФункции

// Настройки источника кеша реализации.
// 
// Возвращаемое значение:
//  Структура - Настройки источника кеша реализации:
// * Объект - Строка - 
// * ВсеМаркируемые - Булево - 
// * ИспользоватьОСУ - Булево - 
// * Сценарий - Число - 
// * Штрихкоды - Строка - 
// * ШтрихкодУпаковки - Строка - 
// * Товары - Строка - 
// * Серии - Строка - 
// * Количество - Строка - 
// * ЧастичноеВыбытие - Булево - 
// * ВключаяКомплектующие - Булево - 
Функция НастройкиИсточникаКешаРеализации() Экспорт
	
	Результат = ПроверкаИПодборПродукцииИС.НастройкиИсточникаКешаШтрихкодовУпаковок();
	
	Результат.Штрихкоды =        "ШтрихкодыУпаковок";
	Результат.ШтрихкодУпаковки = "ШтрихкодУпаковки";
	Результат.Серии            = "";
	Результат.ЧастичноеВыбытие = Истина;
	Результат.ИспользоватьОСУ  = Истина;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьМаркируемуюПродукциюЭлектронногоДокумента(ЭлектронныйДокумент, ТаблицаМаркируемойПродукции)
	
	РезультатПроверкиПоДокументу = СоответствиеТребованиямГИСМТ.РезультатПроверкиПоДокументу(ЭлектронныйДокумент);
	
	Если РезультатПроверкиПоДокументу = Неопределено Тогда
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлектронныйДокумент, "СодержитМаркируемыеТовары")
			И ЗначениеЗаполнено(ЭлектронныйДокумент) Тогда
			МассивДокументов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЭлектронныйДокумент);
			УстановитьПривилегированныйРежим(Истина);
			СоответствиеТребованиямГИСМТ.ДобавитьВРегистрДляОтслеживанияСоответствияТребованиямГИСМТ(МассивДокументов);
			РезультатПроверкиПоДокументу = СоответствиеТребованиямГИСМТ.РезультатПроверкиПоДокументу(ЭлектронныйДокумент);
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если РезультатПроверкиПоДокументу.ДанныеИсходногоДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ШтрихкодыЭД = РезультатПроверкиПоДокументу.ДанныеИсходногоДокумента.Штрихкоды;
	ТоварыЭД    = РезультатПроверкиПоДокументу.ДанныеИсходногоДокумента.Товары;
	
	ШтрихкодыEAN                = Новый Массив;
	GTINПотребительскихУпаковок = Новый Соответствие;
	КодыЕдиницИзмеренияПоGTIN   = Новый Соответствие();
	
	Для Каждого СтрокаТаблицы Из ШтрихкодыЭД Цикл
		
		ШтрихкодEAN = РазборКодаМаркировкиИССлужебныйКлиентСерверПовтИсп.ШтрихкодEANИзGTIN(СтрокаТаблицы.GTIN);
		Если ШтрихкодыEAN.Найти(ШтрихкодEAN) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ШтрихкодыEAN.Добавить(ШтрихкодEAN);
		GTINПотребительскихУпаковок.Вставить(ШтрихкодEAN, Истина);
		
	КонецЦикла;
	
	ПараметрыСканирования = ШтрихкодированиеОбщегоНазначенияИС.ПараметрыСканирования(ЭлектронныйДокумент);
	
	ДанныеПоШтрихкодамEANРезультат = ШтрихкодированиеОбщегоНазначенияИС.ДанныеПоШтрихкодамEAN(
		ШтрихкодыEAN, ПараметрыСканирования, GTINПотребительскихУпаковок);
	ДанныеПоШтрихкодамEAN = ДанныеПоШтрихкодамEANРезультат.ДанныеПоШтрихкодамEAN;
	
	СтруктураПоискаНомерСтроки  = Новый Структура("НомерСтроки", 0);
	СтруктураПоискаШтрихкодEAN  = Новый Структура("ШтрихкодEAN", ШтрихкодEAN);
	СтруктураПоискаGTIN         = Новый Структура("GTIN",        "");
	ПодобраннаяНоменклатура     = Новый Массив;
	
	Для Каждого СтрокаТаблицы Из ШтрихкодыЭД Цикл
		
		ШтрихкодEAN = РазборКодаМаркировкиИССлужебныйКлиентСерверПовтИсп.ШтрихкодEANИзGTIN(СтрокаТаблицы.GTIN);
		
		СтруктураПоискаШтрихкодEAN.ШтрихкодEAN = ШтрихкодEAN;
		СтруктураПоискаGTIN.GTIN               = СтрокаТаблицы.GTIN;
		СтруктураПоискаНомерСтроки.НомерСтроки = СтрокаТаблицы.НомерСтроки;
		
		Если ТаблицаМаркируемойПродукции.НайтиСтроки(СтруктураПоискаGTIN).Количество() Тогда
			
			СтрокаДанных = ТаблицаМаркируемойПродукции[0];
			СтрокаДанных.КоличествоПотребительскихУпаковок = СтрокаДанных.КоличествоПотребительскихУпаковок + СтрокаТаблицы.КоличествоПотребительскихУпаковок;
			
		Иначе
			
			СтрокаДанных = ТаблицаМаркируемойПродукции.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДанных, СтрокаТаблицы);
			
			ШтрихкодEAN = РазборКодаМаркировкиИССлужебныйКлиентСерверПовтИсп.ШтрихкодEANИзGTIN(СтрокаТаблицы.GTIN);
			ШтрихкодыEAN.Добавить(ШтрихкодEAN);
			GTINПотребительскихУпаковок.Вставить(ШтрихкодEAN, Истина);
			СтрокаДанных.КодыGTIN.Добавить(СтрокаТаблицы.GTIN);
			
		КонецЕсли;
		
		ПоискСтрокШтрихкода = ДанныеПоШтрихкодамEAN.НайтиСтроки(СтруктураПоискаШтрихкодEAN);
		
		Если ПоискСтрокШтрихкода.Количество() = 1 Тогда
			СтрокаШтрихкода = ПоискСтрокШтрихкода[0];
			СтрокаДанных.Номенклатура   = СтрокаШтрихкода.Номенклатура;
			СтрокаДанных.Характеристика = СтрокаШтрихкода.Характеристика;
			СтрокаДанных.Серия          = СтрокаШтрихкода.Серия;
			ПодобраннаяНоменклатура.Добавить(СтрокаДанных.Номенклатура);
		КонецЕсли;
		
		ПоискСтрокТоварыЭД = ТоварыЭД.НайтиСтроки(СтруктураПоискаНомерСтроки);
		
		Для Каждого СтрокаТоварыЭД Из ПоискСтрокТоварыЭД Цикл
			СтрокаДанных.Количество = СтрокаДанных.Количество + СтрокаТоварыЭД.Количество;
			КодыЕдиницИзмеренияПоGTIN.Вставить(СтрокаДанных.GTIN, СтрокаТоварыЭД.ЕдиницаИзмеренияКод);
		КонецЦикла;
		
	КонецЦикла;
	
	УпаковкиНоменклатуры = ИнтеграцияИС.УпаковкиНоменклатуры(ПодобраннаяНоменклатура);
	Для Каждого Номенклатура Из ПодобраннаяНоменклатура Цикл
		НоваяСтрока = УпаковкиНоменклатуры.Добавить();
		НоваяСтрока.Номенклатура = Номенклатура;
	КонецЦикла;
	
	ОписанияНоменклатуры         = ОбщегоНазначенияИС.ОписаниеНоменклатуры(ПодобраннаяНоменклатура);
	ВесОбъемУпаковокНоменклатуры = ИнтеграцияИСВызовСервера.КоэффициентВесОбъемУпаковок(УпаковкиНоменклатуры, Ложь);
	
	Для Каждого СтрокаТаблицы Из ТаблицаМаркируемойПродукции Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеНоменклатуры  = ОписанияНоменклатуры[СтрокаТаблицы.Номенклатура];
		КодЕдиницы            = КодыЕдиницИзмеренияПоGTIN[СтрокаТаблицы.GTIN];
		ТипИзмеряемойВеличины = ИнтеграцияИС.ТипИзмеряемойВеличиныПоКодуКлассификатора(КодЕдиницы);
		ВесОбъемУпаковок      = ВесОбъемУпаковокНоменклатуры[СтрокаТаблицы.Номенклатура];
		
		Если Не ЗначениеЗаполнено(ОписаниеНоменклатуры.ПотребительскаяУпаковка) Тогда
			СтруктураПоиска = Новый Структура(
				"Номенклатура,Упаковка",
				СтрокаТаблицы.Номенклатура,
				ОбщегоНазначенияИС.ПустоеЗначениеОпределяемогоТипа("Упаковка"));
			ПоискСтрок = УпаковкиНоменклатуры.НайтиСтроки(СтруктураПоиска);
			Если ПоискСтрок.Количество() Тогда
				ПоискСтрок[0].ЯвляетсяПотребительской = Истина;
				ПоискСтрок[0].Коэффициент             = 1;
			КонецЕсли;
		КонецЕсли;
		
		Если ОписаниеНоменклатуры.КоличествоВПотребительскойУпаковке <> 0
			И СтрокаТаблицы.КоличествоПотребительскихУпаковок * ОписаниеНоменклатуры.КоличествоВПотребительскойУпаковке = СтрокаТаблицы.Количество Тогда
			СтрокаТаблицы.Количество = СтрокаТаблицы.КоличествоПотребительскихУпаковок;
			
			Продолжить;
		
		ИначеЕсли ОписаниеНоменклатуры.КоличествоВПотребительскойУпаковке <> 0 Тогда
			
			Если ТипИзмеряемойВеличины = "Вес" Тогда
				ИмяПоляКоэффициент = "Вес";
			ИначеЕсли ТипИзмеряемойВеличины = "Объем" Тогда
				ИмяПоляКоэффициент = "Объем";
			Иначе
				ИмяПоляКоэффициент = "Коэффициент";
			КонецЕсли;
			
			НайденоТочноеСоответствие = Ложь;
			КоэффициентВесОбъем       = 1;
			
			Для Каждого КлючИЗначение Из ВесОбъемУпаковок Цикл
				
				Коэффициент = КлючИЗначение.Значение[ИмяПоляКоэффициент];
				Если Не ЗначениеЗаполнено(Коэффициент) Тогда
					Продолжить;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(КлючИЗначение.Ключ) Тогда
					КоэффициентВесОбъем = Коэффициент;
				КонецЕсли;
				
				РасчетноеКоличество = СтрокаТаблицы.КоличествоПотребительскихУпаковок * Коэффициент;
				
				Если РасчетноеКоличество = СтрокаТаблицы.Количество Тогда
					СтрокаТаблицы.Количество = СтрокаТаблицы.КоличествоПотребительскихУпаковок;
					НайденоТочноеСоответствие = Истина;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не НайденоТочноеСоответствие Тогда
				
				Если ОписаниеНоменклатуры.КоличествоВПотребительскойУпаковке = 1 Тогда
					СтрокаТаблицы.Количество = СтрокаТаблицы.Количество / КоэффициентВесОбъем;
				Иначе
					СтрокаТаблицы.Количество = СтрокаТаблицы.Количество / ОписаниеНоменклатуры.КоличествоВПотребительскойУпаковке;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЕстьМаркируемаяПродукция(Объект, ИмяТЧ, ЕстьМаркируемаяПродукция) Экспорт
	
	Если Не ЗначениеЗаполнено(ИмяТЧ) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ТаблицаТовары.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ
	|	ВремТаблТовары
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТовары
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьМаркируемаяПродукция
	|ИЗ
	|	ВремТаблТовары КАК ТаблицаТовары
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеИС
	|		ПО ТаблицаТовары.Номенклатура = ОписаниеИС.Номенклатура
	|		И ОписаниеИС.КлючВидовПродукции <> ЗНАЧЕНИЕ(Справочник.КлючиВидовПродукцииИС.ПустаяСсылка)
	|";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	//При необходимости фильтровать здесь (в объекте есть ссылка)
	Запрос.УстановитьПараметр("ТаблицаТовары", Объект[ИмяТЧ].Выгрузить(, "Номенклатура"));
	Результат = Запрос.Выполнить();
	
	ЕстьМаркируемаяПродукция = НЕ Результат.Пустой();
	
КонецПроцедуры

#Область ПоСценарию

Функция ЗапросПродукцииДанныеФормыСтруктура(ДанныеФормыСтруктура, Сценарий, ИмяКоллекции = "Товары")
	
	Возврат ЗапросПродукцииДанныеФормыКоллекция(ДанныеФормыСтруктура[ИмяКоллекции], Сценарий);
	
КонецФункции

Функция ЗапросПродукцииДанныеФормыКоллекция(ДанныеФормыКоллекция, Сценарий)
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	Товары.Номенклатура   КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Серия          КАК Серия,
	|	Товары.Количество     КАК Количество
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.Номенклатура      КАК Номенклатура,
	|	ВТ_Товары.Характеристика    КАК Характеристика,
	|	ВТ_Товары.Серия             КАК Серия,
	|	МАКСИМУМ(ЕСТЬNULL(ОписаниеИС.ВидПродукции, ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка))) КАК ВидПродукции,
	|	СУММА(ВТ_Товары.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_МаркируемаяПродукция
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатураыИС КАК ОписаниеИС
	|		ПО ВТ_Товары.Номенклатура = ОписаниеИС.Номенклатура
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Товары.Номенклатура,
	|	ВТ_Товары.Характеристика,
	|	ВТ_Товары.Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ШтрихкодыНоменклатуры.Штрихкод, """") КАК GTIN,
	|	МаркируемаяПродукция.Номенклатура              КАК Номенклатура,
	|	МаркируемаяПродукция.Характеристика            КАК Характеристика,
	|	МаркируемаяПродукция.Серия                     КАК Серия,
	|	МаркируемаяПродукция.ВидПродукции              КАК ВидПродукции,
	|	МаркируемаяПродукция.Количество                КАК Количество
	|ИЗ
	|	ВТ_МаркируемаяПродукция КАК МаркируемаяПродукция
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК ШтрихкодыНоменклатуры
	|		ПО МаркируемаяПродукция.Номенклатура = ШтрихкодыНоменклатуры.Номенклатура
	|		 И МаркируемаяПродукция.Характеристика = ШтрихкодыНоменклатуры.Характеристика
	|ИТОГИ ПО
	|	Номенклатура,
	|	Характеристика,
	|	GTIN
	|";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Товары", ДанныеФормыКоллекция.Выгрузить());
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Функция ЗапросПродукцииПриобретениеТоваровУслуг(Документ, Сценарий)
	
	//Демо. Когда сценарий один, параметр не влияет.
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ШтрихкодыНоменклатуры.Штрихкод, """") КАК GTIN,
	|	Товары.Номенклатура                            КАК Номенклатура,
	|	Товары.Характеристика                          КАК Характеристика,
	|	Товары.Количество                              КАК Количество,
	|	ОписаниеИС.КлючВидовПродукции                  КАК ВидПродукции
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеИС
	|		ПО Товары.Номенклатура = ОписаниеИС.Номенклатура
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК ШтрихкодыНоменклатуры
	|		ПО Товары.Номенклатура = ШтрихкодыНоменклатуры.Номенклатура
	|			И Товары.Характеристика = ШтрихкодыНоменклатуры.Характеристика
