	|	ОписаниеИС.КлючВидовПродукции.ВидПродукцииГИСМТ <> ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка)
	|ИТОГИ ПО
	|	Номенклатура,
	|	Характеристика,
	|	GTIN
	|";
	
	Если ЭлектронноеВзаимодействиеИСМП.ДокументСвязанСЭлектронным(Документ) Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Товары.Серия", """");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументСсылка", Документ);
	
	Возврат Запрос.Выполнить();
	
