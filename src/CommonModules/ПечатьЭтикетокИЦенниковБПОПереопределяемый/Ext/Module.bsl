// Дополняет колонки таблицы значений товаров при необходимости
//
// Параметры:
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//  ТаблицаЗначенийТоваров - ТаблицаЗначений - шаблон таблицы значений с колонками.
//
Процедура ТаблицаЗначенийТоваров(СтандартнаяОбработка, ТаблицаЗначенийТоваров) Экспорт
	
	ТипСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200));
	
	ТаблицаЗначенийТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаЗначенийТоваров.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаЗначенийТоваров.Колонки.Добавить("ВидПродукции", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыПродукцииИС"));
	ТаблицаЗначенийТоваров.Колонки.Добавить("КодМаркировки", Новый ОписаниеТипов(ТипСтрока));
	ТаблицаЗначенийТоваров.Колонки.Добавить("КодУпаковки", Новый ОписаниеТипов(ТипСтрока));
	ТаблицаЗначенийТоваров.Колонки.Добавить("МаркировкаОстатков", Новый ОписаниеТипов(ТипСтрока));
	ТаблицаЗначенийТоваров.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаЗначенийТоваров.Колонки.Добавить("НомерВГруппе", Новый ОписаниеТипов(ТипСтрока));
	ТаблицаЗначенийТоваров.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	ТаблицаЗначенийТоваров.Колонки.Добавить("ПолныйКодМаркировки", Новый ОписаниеТипов(ТипСтрока));
	ТаблицаЗначенийТоваров.Колонки.Добавить("ПолныйКодУпаковки", Новый ОписаниеТипов(ТипСтрока));
	ТаблицаЗначенийТоваров.Колонки.Добавить("СодержимоеКоличество", Новый ОписаниеТипов("Число"));
	
	ТаблицаЗначенийТоваров.Колонки.Добавить("СпособВводаВОборот", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыВводаВОборотСУЗ"));
	ТаблицаЗначенийТоваров.Колонки.Добавить("СрокГодности", Новый ОписаниеТипов(ТипСтрока));
	ТаблицаЗначенийТоваров.Колонки.Добавить("ТипШтрихкода", Новый ОписаниеТипов(ТипСтрока));
	ТаблицаЗначенийТоваров.Колонки.Добавить("УчетноеКоличество", Новый ОписаниеТипов("Число"));
	ТаблицаЗначенийТоваров.Колонки.Добавить("ХешСуммаКодаМаркировки", Новый ОписаниеТипов(ТипСтрока));
	
	ТаблицаЗначенийТоваров.Колонки.Добавить("ХешСуммаКодаУпаковки", Новый ОписаниеТипов(ТипСтрока));
	ТаблицаЗначенийТоваров.Колонки.Добавить("Шаблон", Новый ОписаниеТипов("ПеречислениеСсылка.ШаблоныКодовМаркировкиСУЗ"));
	ТаблицаЗначенийТоваров.Колонки.Добавить("ШаблонЭтикетки", Новый ОписаниеТипов("СправочникСсылка.ШаблоныЭтикетокИЦенниковБПО"));
	ТаблицаЗначенийТоваров.Колонки.Добавить("ШтрихкодУпаковки", Новый ОписаниеТипов("СправочникСсылка.ШтрихкодыУпаковокТоваров"));
	ТаблицаЗначенийТоваров.Колонки.Добавить("ЭтоКодМаркировки", Новый ОписаниеТипов("Булево"));
	ТаблицаЗначенийТоваров.Колонки.Добавить("GTIN", Новый ОписаниеТипов(ТипСтрока));
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

