// Возвращает данные для построения шаблонов и печатных форм.
// 
// Параметры:
//  ПараметрыПечати - Структура - ПоляДляЗаполнения - Массив -
//  ПоляДляЗаполнения - Массив Из Структура - Поля для заполнения
//  ТоварыДляПечати - МассивИз Структура
// 
// Возвращаемое значение:
//  Массив из Структура - Данные для формирования печатных форм
Функция ДанныеДляФормированияПечатныхФорм(ПараметрыПечати, ПоляДляЗаполнения, ТоварыДляПечати = Неопределено) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("СоответствиеПолейИШаблонов", ПоляДляЗаполнения);
	СтруктураНастроек.Вставить("КаждаяЭтикеткаНаНовомЛисте", ПараметрыПечати.КаждаяЭтикеткаНаНовомЛисте);
	СтруктураНастроек.Вставить("МассивОбъектов", ПараметрыПечати.МассивОбъектов);
	СтруктураНастроек.Вставить("КоллекцияПечатныхФорм", ПараметрыПечати.КоллекцияПечатныхФорм);
	СтруктураНастроек.Вставить("ОбъектыПечати", ПараметрыПечати.ОбъектыПечати);
	СтруктураНастроек.Вставить("ВариантПечати", ПараметрыПечати.ВариантПечати);
	
	РегистрыСведений.ПулКодовМаркировкиСУЗ.РаспечататьЭтикеткиИЗафиксироватьДатуПечати(ПараметрыПечати, ТабличныйДокумент, СтруктураНастроек);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

