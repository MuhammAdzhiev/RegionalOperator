// Назначение модуля: Правила начисления ТКО по нормативу, расчетному объему или контейнерам с контролем действия тарифа.
// РАСЧЕТНАЯ МОДЕЛЬ ПРИМЕРА (требует согласования с принятым порядком расчетов):
// Тариф.Ставка = руб./м3.
// Норматив: база (человек или м2) * месячный норматив м3 на единицу * ставка руб./м3.
// ПоОбъему: договорный объем м3 в месяц * ставка руб./м3.
// ЗаБак: количество баков * объем одного бака м3 * количество вывозов за месяц * ставка руб./м3.
// Проверяет ставку, тип начисления и действие тарифа на весь календарный месяц.
// Параметры:
//   ТарифОбъект - объект тарифа, содержащий ставку и правила ее применения.
//   ПериодНачало - начало месяца, за который выполняется начисление.
Процедура ПроверитьТарифНаПериод(ТарифОбъект, ПериодНачало) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ТарифОбъект.ТипНачисления) Тогда
		ВызватьИсключение "У тарифа не указан тип начисления.";
	КонецЕсли;
	
	Если ТарифОбъект.Ставка <= 0 Тогда
		ВызватьИсключение "Ставка тарифа должна быть больше нуля.";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТарифОбъект.ДатаНачала) Тогда
		ВызватьИсключение "У тарифа не указана дата начала действия.";
	КонецЕсли;
	// Даты тарифа трактуются как календарные дни включительно.
	ПериодНачало = НачалоМесяца(ПериодНачало);
	ПоследнийДень = НачалоДня(КонецМесяца(ПериодНачало));
	
	Если НачалоДня(ТарифОбъект.ДатаНачала) > НачалоДня(ПериодНачало) Тогда
		ВызватьИсключение "Тариф начал действовать после начала месяца начисления. "
		+ "Расчет периода со сменой тарифа необходимо делать отдельно.";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТарифОбъект.ДатаОкончания) Тогда
		Если НачалоДня(ТарифОбъект.ДатаОкончания) < НачалоДня(ТарифОбъект.ДатаНачала) Тогда
			ВызватьИсключение "Дата окончания тарифа меньше даты начала.";
		КонецЕсли;
		
		Если НачалоДня(ТарифОбъект.ДатаОкончания) < ПоследнийДень Тогда
			ВызватьИсключение "Тариф заканчивается до окончания месяца начисления. " + "Нужен расчет периода со сменой тарифа.";
		КонецЕсли;
	КонецЕсли;
	
	Если ТарифОбъект.ТипНачисления = Перечисления.ТипНачисления.Норматив Тогда
		Если НЕ ЗначениеЗаполнено(ТарифОбъект.БазаНорматива) Тогда
			ВызватьИсключение "Для нормативного тарифа не указана база норматива.";
		КонецЕсли;
		
		Если ТарифОбъект.НормативМ3НаЕдиницуВМесяц <= 0 Тогда
			ВызватьИсключение "Для нормативного тарифа укажите месячный норматив м3 на единицу.";
		КонецЕсли;
		
	ИначеЕсли ТарифОбъект.ТипНачисления = Перечисления.ТипНачисления.ПоОбъему
		Или ТарифОбъект.ТипНачисления = Перечисления.ТипНачисления.ЗаБак Тогда
		// Параметры объема проверяются отдельно для каждого лицевого счета.
		Возврат;
		
	Иначе
		ВызватьИсключение "Неизвестный тип начисления тарифа.";
	КонецЕсли;
	
КонецПроцедуры
// Рассчитывает месячную сумму начисления по типу тарифа и параметрам лицевого счета с округлением до копеек.
// Параметры:
//   ДанныеЛС - строка данных по лицевому счету с расчетными параметрами.
//   ТарифОбъект - объект тарифа, содержащий ставку и правила ее применения.
// Возвращаемое значение:
//   Число — сумма начисления за месяц в рублях с округлением до копеек.
Функция РассчитатьСумму(ДанныеЛС, ТарифОбъект) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДанныеЛС.ОбъектНедвижимости) Тогда
		ВызватьИсключение "Для лицевого счета " + Строка(ДанныеЛС.ЛицевойСчет) + " не указан объект недвижимости.";
	КонецЕсли;
	
	Если ТарифОбъект.ТипНачисления = Перечисления.ТипНачисления.Норматив Тогда
		
		Если ТарифОбъект.БазаНорматива = Перечисления.БазаНормативаТКО.ПоПроживающим Тогда
			База = ДанныеЛС.КоличествоПроживающих;
			
		ИначеЕсли ТарифОбъект.БазаНорматива = Перечисления.БазаНормативаТКО.ПоПлощади Тогда
			База = ДанныеЛС.Площадь;
			
		Иначе
			ВызватьИсключение "Неизвестная база нормативного начисления.";
		КонецЕсли;
		
		Если База <= 0 Тогда
			ВызватьИсключение "ЛС " + Строка(ДанныеЛС.ЛицевойСчет) + ": расчетная база для норматива не заполнена. "
			+ "Нулевое число проживающих нельзя автоматически трактовать как отсутствие платы.";
		КонецЕсли;
		
		ОбъемМ3 = База * ТарифОбъект.НормативМ3НаЕдиницуВМесяц;
		
	ИначеЕсли ТарифОбъект.ТипНачисления = Перечисления.ТипНачисления.ПоОбъему Тогда
		
		ОбъемМ3 = ДанныеЛС.РасчетныйОбъемМ3;
		Если ОбъемМ3 <= 0 Тогда
			ВызватьИсключение "ЛС " + Строка(ДанныеЛС.ЛицевойСчет) + ": не заполнен расчетный объем м3 за месяц.";
		КонецЕсли;
		
	ИначеЕсли ТарифОбъект.ТипНачисления = Перечисления.ТипНачисления.ЗаБак Тогда
		
		Если ДанныеЛС.КоличествоБаков <= 0 Или ДанныеЛС.ОбъемБакаМ3 <= 0 Или ДанныеЛС.КоличествоВывозовЗаМесяц <= 0 Тогда
			ВызватьИсключение "ЛС " + Строка(ДанныеЛС.ЛицевойСчет) 
			+ ": не заполнены количество баков, объем бака или число вывозов.";
		КонецЕсли;
		
		ОбъемМ3 = ДанныеЛС.КоличествоБаков * ДанныеЛС.ОбъемБакаМ3 * ДанныеЛС.КоличествоВывозовЗаМесяц;
		
	Иначе
		ВызватьИсключение "Неизвестный тип начисления тарифа.";
	КонецЕсли;
	
	// Финансовое округление до копеек; используемые тарифы должны быть в руб./м3.
	Возврат Окр(ОбъемМ3 * ТарифОбъект.Ставка, 2);
	
КонецФункции
