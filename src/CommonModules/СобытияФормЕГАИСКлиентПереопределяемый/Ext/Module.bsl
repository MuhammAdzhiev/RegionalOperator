#КонецОбласти

#Область Номенклатура

// Открывает форму подбора номенклатуры.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, в которой вызывается команда открытия обработки сопоставления,
//  ОповещениеПриЗавершении - ОписаниеОповещения - процедура, вызываемая после закрытия формы подбора.
Процедура ОткрытьФормуПодбораНоменклатуры(Форма, ОповещениеПриЗавершении = Неопределено) Экспорт
	
	ВидыПродукцииЕГАИС = КонструкторИСОбщегоНазначенияКлиентСервер.ВидыПродукцииЕГАИС();
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
		ВидыПродукцииЕГАИС,
		ШтрихкодированиеОбщегоНазначенияЕГАИСКлиентСервер.ВидыПродукцииИСМПЕГАИС());
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВидыПродукции", ВидыПродукцииЕГАИС);
	
	ОбменСКонтрагентамиКЭДОКлиент.ОткрытьФормуПодбораТоваров(
		Форма.УникальныйИдентификатор, ОповещениеПриЗавершении, ДополнительныеПараметры);
	
	
КонецПроцедуры

// Открывает форму создания номенклатуры.
// 
// Параметры:
//  ФормаВладелец - ФормаКлиентскогоПриложения - форма владелец.
//  Реквизиты     - Структура - параметры формы создания номенклатуры.
Процедура ОткрытьФормуСозданияНоменклатуры(ФормаВладелец, Знач Реквизиты) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",      Новый Структура);
	ПараметрыФормы.Вставить("ТипНоменклатуры",         ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Товар"));
	ПараметрыФормы.Вставить("ДополнительныеПараметры", Новый Структура);
	
	Если Реквизиты <> Неопределено Тогда
		
		ПараметрыФормы.ДополнительныеПараметры = Реквизиты;
		
		Если Реквизиты.Свойство("МаркируемаяПродукцияЕГАИС")
			И ТипЗнч(Реквизиты.МаркируемаяПродукцияЕГАИС) = Тип("Булево")
			И Не Реквизиты.МаркируемаяПродукцияЕГАИС Тогда
			
			Для Каждого ВидПрокуции Из КонструкторИСОбщегоНазначенияКлиентСервер.ВидыПродукцииЕГАИСНеМаркируемые() Цикл
				Если Не ИнтеграцияИСМПКлиентСерверПовтИсп.ВестиУчетМаркируемойПродукции(ВидПрокуции) Тогда
					Продолжить;
				КонецЕсли;
				Если Реквизиты.УпакованнаяПродукцияЕГАИС
					И ОбщегоНазначенияИСКлиентСерверПовтИсп.ПоддерживаетсяЧастичноеВыбытие(ВидПрокуции)
					Или Не Реквизиты.УпакованнаяПродукцияЕГАИС
						И Не ОбщегоНазначенияИСКлиентСерверПовтИсп.ПоддерживаетсяЧастичноеВыбытие(ВидПрокуции) Тогда
					Продолжить;
				КонецЕсли;
				
				ПараметрыФормы.ЗначенияЗаполнения.Вставить("ВидПродукцииГИСМТ", ВидПрокуции);
				Прервать;
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ВидПродукции Из КонструкторИСОбщегоНазначенияКлиентСервер.ВидыПродукцииЕГАИСМаркируемые() Цикл
		ПараметрыФормы.ЗначенияЗаполнения.Вставить("ВидПродукцииЕГАИС", ВидПродукции);
	КонецЦикла;
	
	ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта", ПараметрыФормы, ФормаВладелец);
	
КонецПроцедуры

#КонецОбласти

