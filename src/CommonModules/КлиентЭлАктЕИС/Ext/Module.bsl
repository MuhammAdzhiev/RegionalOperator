КонецФункции

// См. ЭлектронноеАктированиеЕИСПереопределяемый.ГосударственныйКонтрактДокумента
// 
// Параметры:
//  Документ - ОпределяемыйТип.ОснованияЭлектронныхДокументовДокументОбъектЭДО
// 
// Возвращаемое значение:
//  ОпределяемыйТип.ГосударственныеКонтрактыБЭД
Функция ГосударственныйКонтрактДокумента(Знач Документ) Экспорт
	
	Возврат ЭлектронноеАктированиеЕИС.ГосударственныйКонтрактДоговора(Документ.ДоговорКонтрагента);
	
КонецФункции

// См. ЭлектронноеАктированиеЕИСПереопределяемый.НайтиСоздатьКонтрагентаПоСведениямОЗаказчике
// 
// Параметры:
//  ДанныеКонтрагента - Структура
// 
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты
Функция НайтиСоздатьКонтрагентаПоСведениямОЗаказчике(ДанныеКонтрагента) Экспорт

	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	
	ИНН = ДанныеКонтрагента.ИНН;
	КПП = ДанныеКонтрагента.КПП;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И Контрагенты.КПП = &КПП";
	
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	Контрагенты = Запрос.Выполнить().Выгрузить();
	
	Если Контрагенты.Количество() > 0 Тогда
		Контрагент = Контрагенты[0].Ссылка;
	КонецЕсли;
	
	Если Контрагент.Пустая() Тогда
		НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
		НовыйКонтрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
		НовыйКонтрагент.ИНН = ИНН;
		НовыйКонтрагент.КПП = КПП;
		Если ЗначениеЗаполнено(ДанныеКонтрагента.СокращенноеНаименование) Тогда
			НовыйКонтрагент.Наименование = ДанныеКонтрагента.СокращенноеНаименование;
		Иначе
			НовыйКонтрагент.Наименование = ДанныеКонтрагента.ПолноеНаименование;
		КонецЕсли;
		НовыйКонтрагент.НаименованиеПолное = ДанныеКонтрагента.ПолноеНаименование;
		НовыйКонтрагент.ОбменДанными.Загрузка = Истина;
		НовыйКонтрагент.Записать();
		Контрагент = НовыйКонтрагент.Ссылка;
	КонецЕсли;
	
	Возврат Контрагент;
	
КонецФункции

// Преобразование прикладного значения ставки в текстовое для приложения УПД/УКД.
// См. ЭлектронноеАктированиеЕИСПереопределяемый.СтавкаНДСДляПриложенияЕИС
// 
// Параметры:
//  СтавкаНДС - ПеречислениеСсылка.СтавкиНДС
// 
// Возвращаемое значение:
//   Строка
Функция СтавкаНДСДляПриложенияЕИС(Знач СтавкаНДС) Экспорт
	
	СтавкиНДС = Новый Соответствие;
	СтавкиНДС.Вставить(Перечисления.СтавкиНДС.НДС0, "0%");
	СтавкиНДС.Вставить(Перечисления.СтавкиНДС.НДС5, "5%");
	СтавкиНДС.Вставить(Перечисления.СтавкиНДС.НДС7, "7%");
	СтавкиНДС.Вставить(Перечисления.СтавкиНДС.НДС10, "10%");
	СтавкиНДС.Вставить(Перечисления.СтавкиНДС.НДС18, "18%");
	СтавкиНДС.Вставить(Перечисления.СтавкиНДС.НДС20, "20%");
	СтавкиНДС.Вставить(Перечисления.СтавкиНДС.НДС22, "22%");
	СтавкиНДС.Вставить(Перечисления.СтавкиНДС.БезНДС, "без НДС");
	СтавкаНДСПриложения = СтавкиНДС[СтавкаНДС];
	
	Если СтавкаНДСПриложения = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Неизвестная ставка НДС.'");
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
	
	Возврат СтавкаНДСПриложения;
	
КонецФункции

// См. ЭлектронноеАктированиеЕИСПереопределяемый.ОпределитьВладельцаПрисоединенныхФайлов
// 
// Параметры:
//  ОбъектыУчетаЭД - Массив из Структура
// 
// Возвращаемое значение:
//  ОпределяемыйТип.ОснованияЭлектронныхДокументовДокументОбъектЭДО
Функция ВладелецПрисоединенныхФайлов(ОбъектыУчетаЭД) Экспорт
	
	СсылкаНаОбъект = Неопределено;
	Для каждого Основание Из ОбъектыУчетаЭД Цикл
		Если ТипЗнч(Основание.ОбъектУчета) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			СсылкаНаОбъект = Основание.ОбъектУчета;
			Прервать;
		ИначеЕсли ТипЗнч(Основание.ОбъектУчета) = Тип("ДокументСсылка.РезультатыРассмотренияАктаПриемкиЕИС") Тогда
			СсылкаНаОбъект = Основание.ОбъектУчета.ДокументОснование;
			Прервать;
		Иначе
			Если ТипЗнч(Основание.ОбъектУчета) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
				// Счет-фактура является владельцем только если отправляется отдельно.
				СсылкаНаОбъект = Основание.ОбъектУчета.ДокументОснование;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СсылкаНаОбъект;
		
КонецФункции

// См. ЭлектронноеАктированиеЕИСПереопределяемый.СоздатьЭлементФормыПараметровЭлектронногоАктированияДокумента
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
// 
// Возвращаемое значение:
//   ЭлементыФормы
Функция СоздатьЭлементФормыПараметровЭлектронногоАктированияДокумента(Форма) Экспорт
	
	ЭлементыФормы = Форма.Элементы;
	
	ГруппаЛево = ЭлементыФормы.ГруппаШапка.ПодчиненныеЭлементы[0];
	ИмяДекорации = ЭлектронноеАктированиеЕИС.ИмяДекорацииФормыПараметровЭлектронногоАктированияДокумента();
	ТипДекорации = Тип("ДекорацияФормы");
	ДекорацияГосударственныйКонтракт = ЭлементыФормы.Вставить(
			ИмяДекорации,
			ТипДекорации,
			ГруппаЛево);
	ДекорацияГосударственныйКонтракт.Вид = ВидДекорацииФормы.Надпись;
	ДекорацияГосударственныйКонтракт.Гиперссылка = Истина;
	ДекорацияГосударственныйКонтракт.АвтоМаксимальнаяШирина = Ложь;
	ДекорацияГосударственныйКонтракт.Заголовок = НСтр("ru = '<нет данных о контракте>'");
	
	Возврат ДекорацияГосударственныйКонтракт;
	
КонецФункции

// См. ЭлектронноеАктированиеЕИСПереопределяемый.ЗаполнитьТабличнуюЧастьДокументаПоДаннымДереваТоваровУслуг
// 
// Параметры:
//  СсылкаНаДокумент - ОпределяемыйТип.ОснованияЭлектронныхДокументовДокументОбъектЭДО
//  ДеревоТоваров - ДеревоЗначений
//  ДеревоРаботУслуг - ДеревоЗначений
// 
// Возвращаемое значение:
//  см. ЭлектронноеАктированиеЕИС.НовыйРезультатЗаполненияТабличныхЧастей
Функция ЗаполнитьТабличнуюЧастьДокументаПоДаннымДереваТоваровУслуг(
			СсылкаНаДокумент, ДеревоТоваров, ДеревоРаботУслуг) Экспорт
		
	Результат = ЭлектронноеАктированиеЕИС.НовыйРезультатЗаполненияТабличныхЧастей();
	
	ДокументОбъект = СсылкаНаДокумент.ПолучитьОбъект();

	Ошибки = Новый Массив;
	
	КоличествоСтрокВДокументе = ДокументОбъект.Товары.Количество();
	Для Каждого РодительскаяСтрока Из ДеревоТоваров.Строки Цикл
		Если РодительскаяСтрока.Строки.Количество() = 0 Тогда
			// Без детализации.
			Если РодительскаяСтрока.НомерСтроки < КоличествоСтрокВДокументе Тогда
				СтрокаДокумента = ДокументОбъект.Товары.Получить(РодительскаяСтрока.НомерСтроки - 1);
				СтрокаДокумента.Количество = РодительскаяСтрока.Количество;
				СтрокаДокумента.Сумма = РодительскаяСтрока.Сумма;
				ЗаполнитьЗначенияСвойств(СтрокаДокумента, РодительскаяСтрока);
			КонецЕсли;
		Иначе
			Для Каждого СтрокаДетализации Из РодительскаяСтрока.Строки Цикл
				Если СтрокаДетализации.Номенклатура.Пустая() Тогда
					ОписаниеОшибки = НСтр("ru='Не заполнена номенклатура.'");
					Ошибки.Добавить(ОписаниеОшибки);
				КонецЕсли;
				Если СтрокаДетализации.НомерСтроки > 0 Тогда
					// Строки с номером.
					Если РодительскаяСтрока.НомерСтроки <= КоличествоСтрокВДокументе Тогда
						СтрокаДокумента = ДокументОбъект.Товары.Получить(СтрокаДетализации.НомерСтроки - 1);
						ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаДетализации);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Если Ошибки.Количество() > 0 Тогда
		Результат.ОписаниеОшибки = СтрСоединить(Ошибки);
		Возврат Результат;
	КонецЕсли;

	Для Каждого РодительскаяСтрока Из ДеревоТоваров.Строки Цикл
		Если РодительскаяСтрока.Строки.Количество() > 0 Тогда
			// Новые строки.
			Для Каждого СтрокаДетализации Из РодительскаяСтрока.Строки Цикл
				Если СтрокаДетализации.НомерСтроки = 0 Тогда
					// Строки без номера.
					СтрокаДокумента = ДокументОбъект.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаДетализации);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Результат.Выполнено = Истина;
	Возврат Результат;
		
КонецФункции

// Установить видимость колонок таб частей.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа.
Процедура УстановитьВидимостьКолонокТабЧастей(Форма) Экспорт
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
		Форма, "ИспользуетсяЭлектронноеАктирование") Тогда
		Форма.Элементы.ТоварыПредставлениеДляАктированияЕИС.Видимость =
			Форма.ИспользуетсяЭлектронноеАктирование;
		Форма.Элементы.ТоварыСтранаПроизводителя.Видимость =
			Форма.ИспользуетсяЭлектронноеАктирование;
		Форма.Элементы.ТоварыГруппаОбъемВТекстовомВыражении.Видимость =
			Форма.ИспользуетсяЭлектронноеАктирование;
	КонецЕсли;
	
КонецПроцедуры

// См. ЭлектронноеАктированиеЕИСПереопределяемый.ЗаполнитьСвязиПараметровВыбораИПараметрыВыбораДоговора
// 
// Параметры:
//  СвязиПараметровВыбора - СвязиПараметровВыбораКомпоновкиДанных
//  ПараметрыВыбора - ФиксированныйМассив из ПараметрВыбора
Процедура ЗаполнитьСвязиПараметровВыбораИПараметрыВыбораДоговора(СвязиПараметровВыбора,
			 ПараметрыВыбора) Экспорт
	
	МассивСвязей = Новый Массив();
	НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Владелец", "Объект.Контрагент");
	МассивСвязей.Добавить(НоваяСвязь);
	НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Организация", "Объект.Организация");
	МассивСвязей.Добавить(НоваяСвязь);

	СвязиПараметровВыбора = Новый ФиксированныйМассив(МассивСвязей);
	
	ВидыДоговоров = Новый Массив();
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	ЗначенияПараметровВыбора = Новый ФиксированныйМассив(ВидыДоговоров);
		
	НовыйПараметр = Новый ПараметрВыбора("Отбор.ВидДоговора", ЗначенияПараметровВыбора);
	
	МассивСвязей = Новый Массив();
	МассивСвязей.Добавить(НовыйПараметр);
	
	ПараметрыВыбора = Новый ФиксированныйМассив(МассивСвязей);
	
КонецПроцедуры

// В документах есть договоры с госконтрактами.
// 
// Параметры:
//  Документы - Массив из ДокументСсылка.РеализацияТоваровУслуг,
//              Массив из ДокументСсылка._ДемоПередачаТоваровМеждуОрганизациями,
//              ДокументСсылка._ДемоПередачаТоваровМеждуОрганизациями,
//              ДокументСсылка.РеализацияТоваровУслуг - документы или ссылка на документ.
// 
// Возвращаемое значение:
//  Булево - Истина, если в документах есть хотя бы один с договором, привязанным к госконтракту.
Функция ВДокументахЕстьДоговорыСГосконтрактами(Документы) Экспорт
	
	ЕстьГосКонтракты = Ложь;
	Если ТипЗнч(Документы) = Тип("Массив") Тогда
		Для Каждого Документ Из Документы Цикл
			Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Документ, "ДоговорКонтрагента") Тогда
				Продолжить;
			КонецЕсли;
			ГосКонтракт = ЭлектронноеАктированиеЕИС.ГосударственныйКонтрактДоговора(
				Документ.ДоговорКонтрагента);
			Если ЗначениеЗаполнено(ГосКонтракт) Тогда
				ЕстьГосКонтракты = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Документы, "ДоговорКонтрагента") Тогда
			ГосКонтракт = ЭлектронноеАктированиеЕИС.ГосударственныйКонтрактДоговора(
				Документы.ДоговорКонтрагента);
			ЕстьГосКонтракты = ЗначениеЗаполнено(ГосКонтракт);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЕстьГосКонтракты;
	
КонецФункции

// См. ЭлектронноеАктированиеЕИСПереопределяемый.СоздатьДоговорНаОснованииКонтракта.
// 
// Параметры:
//  СсылкаНаКонтракт - ОпределяемыйТип.ГосударственныеКонтрактыБЭД
//  РезультатСоздания - Структура
Процедура СоздатьДоговорНаОснованииКонтракта(СсылкаНаКонтракт, РезультатСоздания) Экспорт
	
	Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
	Договор.НомерДоговора = СсылкаНаКонтракт.Номер;
	Договор.ДатаДоговора = СсылкаНаКонтракт.ДатаЗаключенияКонтракта;
	Договор.Владелец = СсылкаНаКонтракт.Контрагент;
	Договор.Организация = СсылкаНаКонтракт.Организация;
	Шаблон = НСтр("ru = 'РК %1 №%2 от %3'");
	ФорматДаты = НСтр("ru='ДЛФ=D;'");
	ДатаКонтракта = Формат(СсылкаНаКонтракт.ДатаЗаключенияКонтракта, ФорматДаты);
	Договор.Наименование = СтрШаблон(Шаблон,
		СсылкаНаКонтракт.Код,
		СсылкаНаКонтракт.Номер,
		ДатаКонтракта);
	Договор.Записать();
	
	РезультатСоздания.Договор = Договор.Ссылка;
	РезультатСоздания.Выполнено = Истина;
	
КонецПроцедуры

// См. ЭлектронноеАктированиеЕИСПереопределяемый.СтавкаНДСОбъектаЗакупки.
// 
// Параметры:
//  СтавкаНДСОбъектаЗакупки - Строка
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.СтавкиНДС
Функция СтавкаНДСОбъектаЗакупки(Знач СтавкаНДСОбъектаЗакупки) Экспорт
	
	СтавкиНДС = Новый Соответствие;
	СтавкиНДС.Вставить("0", Перечисления.СтавкиНДС.НДС0);
	СтавкиНДС.Вставить("5", Перечисления.СтавкиНДС.НДС5);
	СтавкиНДС.Вставить("7", Перечисления.СтавкиНДС.НДС7);
	СтавкиНДС.Вставить("10", Перечисления.СтавкиНДС.НДС10);
	СтавкиНДС.Вставить("18", Перечисления.СтавкиНДС.НДС18);
	СтавкиНДС.Вставить("20", Перечисления.СтавкиНДС.НДС20);
	СтавкиНДС.Вставить("22", Перечисления.СтавкиНДС.НДС22);
	СтавкиНДС.Вставить("n", Перечисления.СтавкиНДС.БезНДС);
	СтавкиНДС.Вставить("N", Перечисления.СтавкиНДС.БезНДС);
	СтавкаНДС = СтавкиНДС[СтавкаНДСОбъектаЗакупки];
	
	Если СтавкаНДС = Неопределено Тогда
		Шаблон = НСтр("ru='Неизвестная ставка НДС объекта закупки ""%1"".'");
		ТекстОшибки = СтрШаблон(Шаблон, СтавкаНДСОбъектаЗакупки);
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
	
	Возврат СтавкаНДС;
	
КонецФункции

// См. ЭлектронноеАктированиеЕИСПереопределяемый.ДляДокументаЗаполняютсяМестаПоставки.
// 
// Параметры:
//  Документ - ДокументСсылка
//  МестаПоставкиЗаполняются - Булево
Процедура ДляДокументаЗаполняютсяМестаПоставки(Документ, МестаПоставкиЗаполняются) Экспорт
	
	МестаПоставкиЗаполняются = Истина;
	Если Документ.ВидОперации = Перечисления.ВидыОпераций.Корректировка
		ИЛИ Документ.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		МестаПоставкиЗаполняются = Ложь;
	КонецЕсли;
	
КонецПроцедуры

// См. ЭлектронноеАктированиеЕИСПереопределяемый.ДляДокументаЗаполняетсяСудебноеРешение.
// 
// Параметры:
//  Документ - ДокументСсылка
//  СудебноеРешениеЗаполняется - Булево
Процедура ДляДокументаЗаполняетсяСудебноеРешение(Документ, СудебноеРешениеЗаполняется) Экспорт
	
	СудебноеРешениеЗаполняется = Ложь;
	Если Документ.ВидОперации = Перечисления.ВидыОпераций.Реализация
		ИЛИ Документ.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		СудебноеРешениеЗаполняется = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Заполнить представления строк контракта.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа.
//  ТабЧасть - Строка - имя таб.части документа.
Процедура ЗаполнитьПредставленияСтрокКонтракта(Форма, ТабЧасть) Экспорт
	
	Объект = Форма.Объект;
	
	СписокВыбора = Форма.Элементы[ТабЧасть + "ПредставлениеДляАктированияЕИС"].СписокВыбора;
	Для каждого Строка Из Объект[ТабЧасть] Цикл
		
		Если ЗначениеЗаполнено(Строка.ИдентификаторДляАктированияЕИС) Тогда
			Строка.ПредставлениеДляАктированияЕИС = Строка.ИдентификаторДляАктированияЕИС;
			ЭлектронноеАктированиеЕИСВызовСервера.
				ПриИзмененииИдентификатораДляАктированияЕИС(
					СписокВыбора, ТабЧасть, Строка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Заполнить служебные данные ЕИС.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа.
Процедура ЗаполнитьСлужебныеДанныеЕИС(Форма) Экспорт
	
	СтрокиКонтракта = Новый Соответствие;
	
	ИмяТабЧасти = "Товары";
	ДанныеДляЗаполнения =
		ЭлектронноеАктированиеЕИС.ДанныеДляЗаполненияТабличнойЧастиДокумента(
			Форма.Объект.ДоговорКонтрагента);
	Если НЕ ЗначениеЗаполнено(ДанныеДляЗаполнения) Тогда
		Возврат;
	КонецЕсли;
		
	СуффиксЭлементаФормы = "ПредставлениеДляАктированияЕИС";
	Форма.Элементы[ИмяТабЧасти + СуффиксЭлементаФормы].СписокВыбора.Очистить();
	
	Для каждого ОбъектЗакупки Из ДанныеДляЗаполнения Цикл
		Форма.Элементы[ИмяТабЧасти + СуффиксЭлементаФормы].СписокВыбора.Добавить(
			ОбъектЗакупки.Идентификатор,
			ОбъектЗакупки.Наименование);
		СтрокиКонтракта.Вставить(ОбъектЗакупки.Идентификатор, ОбъектЗакупки);
	КонецЦикла;
	
КонецПроцедуры

// См. ЭлектронноеАктированиеЕИСПереопределяемый.ЗаполнитьДеревьяДанныхПараметровАктированияДокумента
Процедура ЗаполнитьДеревьяДанныхПараметровАктированияДокумента(Документ,
	ДанныеКонтракта, ДеревоТоваров, ДеревоРаботУслуг) Экспорт
	
	// Заполняем корневые элементы.
	Для Каждого ОбъектЗакупки Из ДанныеКонтракта.ОбъектыЗакупки Цикл
		Если ЭлектронноеАктированиеЕИС.ОбъектЗакупкиУслугаИлиРабота(ОбъектЗакупки) Тогда
			Строка = ДеревоРаботУслуг.Строки.Добавить();
		Иначе
			Строка = ДеревоТоваров.Строки.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Строка, ОбъектЗакупки);
		Строка.Номенклатура = ОбъектЗакупки.Наименование;
		Строка.ИдентификаторДляАктированияЕИС = ОбъектЗакупки.Идентификатор;
		Строка.ГиперссылкаОткрыть = "Открыть";
	КонецЦикла;

	Запрос = ЗапросПоНоменклатуре(Документ);
	Номенклатура = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.Прямой);

	Для Каждого Строка Из Номенклатура Цикл
		
		ОбъектНайден = Ложь;
		Для Каждого Объект Из ДеревоТоваров.Строки Цикл
			Если Объект.ИдентификаторДляАктированияЕИС = Строка.ИдентификаторДляАктированияЕИС Тогда
				СтрокаДерева = Объект.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДерева, Строка);
				ОбъектНайден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ОбъектНайден Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Объект Из ДеревоРаботУслуг.Строки Цикл
			Если Объект.ИдентификаторДляАктированияЕИС = Строка.ИдентификаторДляАктированияЕИС Тогда
				СтрокаДерева = Объект.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДерева, Строка);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Найти или создать единицу измерения.
// 
// Параметры:
//  КодЕдиницыИзмерения - Строка - Код единицы измерения
//  НаименованиеЕдиницыИзмерения - Строка - Наименование единицы измерения
// 
// Возвращаемое значение:
//  СправочникСсылка.ЕдиницыИзмерения, Неопределено - Найти создать единицу измерения
Функция НайтиСоздатьЕдиницуИзмерения(
		КодЕдиницыИзмерения, НаименованиеЕдиницыИзмерения) Экспорт
	
	ЕдиницаИзмерения = Неопределено;
	
	Если ЗначениеЗаполнено(КодЕдиницыИзмерения) Тогда
		ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.ЕдиницаИзмеренияПоКоду(
			КодЕдиницыИзмерения, НаименованиеЕдиницыИзмерения);
	ИначеЕсли ЗначениеЗаполнено(НаименованиеЕдиницыИзмерения) Тогда
		ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(
			НаименованиеЕдиницыИзмерения, Истина);
	Иначе
		ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ЕдиницаИзмерения;
	
КонецФункции

// См. ЭлектронноеАктированиеЕИСПереопределяемый.ЗаполнитьМестаПоставкиДокумента
Процедура ЗаполнитьМестаПоставкиДокумента(Документ, МестаПоставки) Экспорт
	
	Если НЕ ПустаяСтрока(Документ.АдресДоставкиЗначенияПолей) Тогда
		МестоПоставки = РаботаСАдресами.
			КонтактнаяИнформацияВСтруктуруJSON(Документ.АдресДоставкиЗначенияПолей);
		МестаПоставки.Добавить(МестоПоставки);
	Иначе
		КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Документ.Контрагент, Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента, , Ложь);
		Если КонтактнаяИнформация.Количество() > 0 Тогда
			ЮрАдрес = КонтактнаяИнформация[0];
			МестоПоставки = ЮрАдрес.Значение;
			МестаПоставки.Добавить(МестоПоставки);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


// Заполнить данные дерева для электронного актирования ЕИС.
// 
// Параметры:
//  ДеревоДанных - ДеревоЗначений - Дерево данных.
//  ДанныеЭлектронногоАктированияЕИС - Структура - Данные электронного актирования ЕИС
//  ВыборкаШапки - ВыборкаДанных - Выборка шапки.
//  ДанныеПриложенияЕИС - Структура - Данные приложения ЕИС.
//  ЭтоУКД - Булево - это УКД.
Процедура ЗаполнитьДанныеДереваДляЭлектронногоАктированияЕИС(ДеревоДанных,
		ДанныеЭлектронногоАктированияЕИС,
		ВыборкаШапки,
		ДанныеПриложенияЕИС,
		ЭтоУКД) Экспорт

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДанныеЭлектронногоАктированияЕИС.ДанныеБД",
		ДанныеЭлектронногоАктированияЕИС);

	ПодписантыЕИС = ДанныеЭлектронногоАктированияЕИС.ПодписантыДокументовЕИС;
	
	ТаблицаПодписанты = ЭлектронноеАктированиеЕИС.НоваяТаблицаПодписантов();
	
	ПорядковыйНомерРуководителяОрганизации = 1;
	
	// Номер строки указывается в атрибуте ИныеСвед.
	// в дальнейшем используется для заполнения приложений для ЕИС.
	НомерСтроки = 1;
	Для Каждого Подписант Из ПодписантыЕИС Цикл
		Строка = ТаблицаПодписанты.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Подписант);
		Строка.Статус = "1";
		Если ЭтоУКД Тогда
			Строка.ОбластьПолномочий = "6";
		Иначе
			Строка.ОбластьПолномочий = "5";
		КонецЕсли;
		Строка.ОснованиеПолномочий = "Должностные обязанности";
		Строка.НомерСтроки = НомерСтроки;
		Если ВРЕГ(Подписант.Должность) = ВРЕГ("Руководитель")
			ИЛИ ВРЕГ(Подписант.Должность) = ВРЕГ("Генеральный директор")
			ИЛИ ПодписантыЕИС.Количество() = 1 Тогда
			ПорядковыйНомерРуководителяОрганизации = НомерСтроки;
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	ДанныеПриложенияЕИС.ПорядковыйНомерРуководителяОрганизации = ПорядковыйНомерРуководителяОрганизации;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДанныеЭлектронногоАктированияЕИС.Подписанты", ТаблицаПодписанты);

	ДанныеПриложенияЕИС.ДокументОснование = ВыборкаШапки.ДокументОснование;
	ДанныеПриложенияЕИС.Контрагент = ВыборкаШапки.Контрагент;
	ДанныеПриложенияЕИС.ДоговорКонтрагента = ВыборкаШапки.ДоговорКонтрагента;
	
	ТаблицаГрузополучателей = ДеревоДанных.Строки.Найти(
		"СведенияОГрузополучателе", "ПолныйПуть");
	ЕстьТаблицаГрузополучателей = ЗначениеЗаполнено(ТаблицаГрузополучателей)
		И ЗначениеЗаполнено(ТаблицаГрузополучателей.Значение)
		И ТаблицаГрузополучателей.Строки.Количество() > 0;
	
	Если ЭтоУКД Тогда
		ЗаполнитьДанныеПриложенияУКД(
			ДанныеЭлектронногоАктированияЕИС,
			ДанныеПриложенияЕИС);
	Иначе
		ЗаполнитьДанныеПриложенияУПД(
			ДанныеЭлектронногоАктированияЕИС,
			ДанныеПриложенияЕИС,
			ЕстьТаблицаГрузополучателей);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДанныеЭлектронногоАктированияЕИС.ДанныеПриложения",
		ДанныеПриложенияЕИС);
	
	// Идентификатор гос.контракта заполняется только для контрактов ГОЗ
	// и контрактов с казначейским сопровождением.
	ДанныеКонтракта = ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта[0];
	НомерГОЗ = ДанныеКонтракта.НомерГОЗ;
	Если (ДанныеКонтракта.ЭтоКонтрактГОЗ И ЗначениеЗаполнено(НомерГОЗ))
		ИЛИ ДанныеКонтракта.ТребуетсяКазначейскоеСопровождение Тогда
		Если ДанныеКонтракта.ЭтоКонтрактГОЗ Тогда
			ИдентификаторГосКонтракта = НомерГОЗ;
		Иначе
			Если ЗначениеЗаполнено(ДанныеКонтракта.НомерИГК) Тогда
				ИдентификаторГосКонтракта = ДанныеКонтракта.НомерИГК;
			Иначе
				// Вычисление ИД госконтракта для казначейского сопровождения.
				СуффиксКазначейскогоСопровождения = "4";
				ИдентификаторГосКонтракта = ДанныеКонтракта.Код
					+ СуффиксКазначейскогоСопровождения;
			КонецЕсли;
		КонецЕсли;
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(ВыборкаШапки.Ссылка, 
			"Объект.ИдентификаторГосКонтракта");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта",
			ИдентификаторГосКонтракта, ПараметрыОбработкиОшибок);
	Иначе
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта",
			"");
	КонецЕсли;
	
КонецПроцедуры

// Заполнить данные дерева для электронного актирования ЕИС формата 5.02 и 5.03.
// 
// Параметры:
//  ДеревоДанных - ДеревоЗначений - Дерево данных.
//  ДанныеЭлектронногоАктированияЕИС - Структура - Данные электронного актирования ЕИС
//  ВыборкаШапки - ВыборкаДанных - Выборка шапки.
//  ДанныеПриложенияЕИС - Структура - Данные приложения ЕИС.
//  ЭтоУКД - Булево - это УКД.
Процедура ЗаполнитьДанныеДереваДляЭлектронногоАктированияЕИС_5_02(ДеревоДанных,
		ДанныеЭлектронногоАктированияЕИС,
		ВыборкаШапки,
		ДанныеПриложенияЕИС,
		ЭтоУКД) Экспорт

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДанныеЭлектронногоАктированияЕИС.ДанныеБД",
		ДанныеЭлектронногоАктированияЕИС);

	ПодписантыЕИС = ДанныеЭлектронногоАктированияЕИС.ПодписантыДокументовЕИС;
	
	ТаблицаПодписанты = ЭлектронноеАктированиеЕИС.НоваяТаблицаПодписантов();
	
	ПорядковыйНомерРуководителяОрганизации = 1;
	
	// Номер строки указывается в атрибуте ИныеСвед.
	// в дальнейшем используется для заполнения приложений для ЕИС.
	Если ПодписантыЕИС.Количество() > 0 Тогда
		Подписант = ПодписантыЕИС[0];
		
		Строка = ТаблицаПодписанты.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Подписант);
		
		Строка.Статус = "1";
		Если ЭтоУКД Тогда
			Строка.ОбластьПолномочий = "6";
		Иначе
			Строка.ОбластьПолномочий = "5";
		КонецЕсли;
		Строка.ОснованиеПолномочий = "Должностные обязанности";
		Строка.НомерСтроки = 1;
		Если ВРЕГ(Подписант.Должность) = ВРЕГ("Руководитель")
			ИЛИ ВРЕГ(Подписант.Должность) = ВРЕГ("Генеральный директор")
			ИЛИ ПодписантыЕИС.Количество() = 1 Тогда
			ПорядковыйНомерРуководителяОрганизации = 1;
		КонецЕсли;
		
		ПодписантЕИС = Новый Структура;
		ПодписантЕИС.Вставить("ЛогинПрод", Подписант.Идентификатор);
		ПодписантЕИС.Вставить("ПорядНом", 1);
		ДанныеПриложенияЕИС.Подписант = ПодписантЕИС;
	КонецЕсли;
	
	ДанныеПриложенияЕИС.ПорядковыйНомерРуководителяОрганизации = ПорядковыйНомерРуководителяОрганизации;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДанныеЭлектронногоАктированияЕИС.Подписанты", ТаблицаПодписанты);

	ДанныеПриложенияЕИС.ДокументОснование = ВыборкаШапки.ДокументОснование;
	ДанныеПриложенияЕИС.Контрагент = ВыборкаШапки.Контрагент;
	ДанныеПриложенияЕИС.ДоговорКонтрагента = ВыборкаШапки.ДоговорКонтрагента;
	
	ТаблицаГрузополучателей = ДеревоДанных.Строки.Найти(
		"СведенияОГрузополучателе", "ПолныйПуть");
	ЕстьТаблицаГрузополучателей = ЗначениеЗаполнено(ТаблицаГрузополучателей)
		И ЗначениеЗаполнено(ТаблицаГрузополучателей.Значение)
		И ТаблицаГрузополучателей.Строки.Количество() > 0;
	
	Если ЭтоУКД Тогда
		ЗаполнитьДанныеПриложенияУКД(
			ДанныеЭлектронногоАктированияЕИС,
			ДанныеПриложенияЕИС);
	Иначе
		ЗаполнитьДанныеПриложенияУПД(
			ДанныеЭлектронногоАктированияЕИС,
			ДанныеПриложенияЕИС,
			ЕстьТаблицаГрузополучателей);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДанныеЭлектронногоАктированияЕИС.ДанныеПриложения",
		ДанныеПриложенияЕИС);
	
	// Идентификатор гос.контракта заполняется только для контрактов ГОЗ
	// и контрактов с казначейским сопровождением.
	ДанныеКонтракта = ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта[0];
	НомерГОЗ = ДанныеКонтракта.НомерГОЗ;
	Если (ДанныеКонтракта.ЭтоКонтрактГОЗ И ЗначениеЗаполнено(НомерГОЗ))
		ИЛИ ДанныеКонтракта.ТребуетсяКазначейскоеСопровождение Тогда
		Если ДанныеКонтракта.ЭтоКонтрактГОЗ Тогда
			ИдентификаторГосКонтракта = НомерГОЗ;
		Иначе
			Если ЗначениеЗаполнено(ДанныеКонтракта.НомерИГК) Тогда
				ИдентификаторГосКонтракта = ДанныеКонтракта.НомерИГК;
			Иначе
				// Вычисление ИД госконтракта для казначейского сопровождения.
				СуффиксКазначейскогоСопровождения = "4";
				ИдентификаторГосКонтракта = ДанныеКонтракта.Код
					+ СуффиксКазначейскогоСопровождения;
			КонецЕсли;
		КонецЕсли;
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(ВыборкаШапки.Ссылка, 
			"Объект.ИдентификаторГосКонтракта");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СведенияОСчетеФактуре.ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта",
			ИдентификаторГосКонтракта, ПараметрыОбработкиОшибок);
	Иначе
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СведенияОСчетеФактуре.ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта",
			"");
	КонецЕсли;
	
КонецПроцедуры

// Заполнить данные приложения УКД.
// 
// Параметры:
//  ДанныеЭлектронногоАктированияЕИС - Структура - Данные электронного актирования ЕИС
//  ДанныеПриложенияЕИС - Структура - Данные приложения ЕИС
Процедура ЗаполнитьДанныеПриложенияУКД(ДанныеЭлектронногоАктированияЕИС, ДанныеПриложенияЕИС) Экспорт
	
	Если ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта.Количество() = 0 Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнены данные государственного контракта для электронного актирования.'");
		ЭлектронноеАктированиеЕИС.ДобавитьОшибкуЗаполненияПриложения(
			ДанныеПриложенияЕИС, ОписаниеОшибки);
		Возврат;
	Иначе
		ДанныеПриложенияЕИС.ГосударственныйКонтракт =
			ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта[0].Ссылка;
	КонецЕсли;
	
	ЭлектронноеАктированиеЕИС.ДобавитьДвоичныеВложенияПриложенияДляЕИС(
		ДанныеПриложенияЕИС, ДанныеЭлектронногоАктированияЕИС);
	
КонецПроцедуры

// Заполнить данные приложения УПД.
// 
// Параметры:
//  ДанныеЭлектронногоАктированияЕИС - Структура - Данные электронного актирования ЕИС
//  ДанныеПриложенияЕИС - Структура - Данные приложения ЕИС
//  ЕстьТаблицаГрузополучателей - Булево - Признак таблицы грузополучателей
Процедура ЗаполнитьДанныеПриложенияУПД(
				ДанныеЭлектронногоАктированияЕИС,
				ДанныеПриложенияЕИС,
				ЕстьТаблицаГрузополучателей = Ложь) Экспорт
	
	СтоимостьТоваровСНалогом = 0;
	ВсегоКОплатеСуммаНалога = 0;
	
	ЭтоВалютныйКонтракт = Ложь;
	НоминалКурсаВалюты = 1;
	
	Если ЭтоВалютныйКонтракт Тогда
		// Заполняется, если валюта УПД не совпадает с валютой контракта.
		ДанныеПриложенияЕИС.СведенияОТоварах.СтоимостьТоваровСНалогом = СтоимостьТоваровСНалогом;
		ДанныеПриложенияЕИС.СведенияОТоварах.ВсегоКОплатеСуммаНалога = ВсегоКОплатеСуммаНалога;
		// В случае, если валюта документа - Российский Рубль, игнорирование атрибута НоминалКурсВал при загрузке правомерно.
		ДанныеПриложенияЕИС.СведенияОТоварах.НоминалКурсаВалюты = НоминалКурсаВалюты;
	КонецЕсли;

	Если ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта.Количество() = 0 Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнены данные государственного контракта для электронного актирования.'");
		ЭлектронноеАктированиеЕИС.ДобавитьОшибкуЗаполненияПриложения(
			ДанныеПриложенияЕИС, ОписаниеОшибки);
		Возврат;
	Иначе
		ДанныеПриложенияЕИС.ГосударственныйКонтракт =
			ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта[0].Ссылка;
	КонецЕсли;
	
	ЭлектронноеАктированиеЕИС.ДобавитьДвоичныеВложенияПриложенияДляЕИС(
		ДанныеПриложенияЕИС, ДанныеЭлектронногоАктированияЕИС);
	
	Если ЕстьТаблицаГрузополучателей Тогда
		ИдентификаторУчастника = ЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаГрузополучателя();
	Иначе
		ИдентификаторУчастника = ЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаПокупателя();
	КонецЕсли;
	
	Для Каждого МестоПоставки Из ДанныеЭлектронногоАктированияЕИС.МестаПоставкиДокументовДляЕИС Цикл
		Место = ЭлектронноеАктированиеЕИС.НовыеСведенияОМестеПоставкиТовара();
		УИД = СтрЗаменить(МестоПоставки.ИдентификаторАдреса, "-", "");
		Место.Идентификатор = Лев(УИД, 32);
		Место.ИдентификаторУчастника = ИдентификаторУчастника;
		МестоJSON = МестоПоставки.ДанныеМеста;
		ЗаполнитьЗначенияСвойств(Место, МестоПоставки);
		КодыАдреса = ЭлектронноеАктированиеЕИС.КодыАдреса(МестоJSON);
		Место.Классификатор = ЭлектронноеАктированиеЕИС.МестоПоставкиПоКЛАДР();
		Место.Код = КодыАдреса.КодКЛАДР;
		
		СведенияАдресаПоГАР = ПолучитьСведенияАдресаПоГАР(МестоПоставки.ДанныеМеста);
	
		Если НЕ СтрДлина(СведенияАдресаПоГАР.КодГАР) = 36
			ИЛИ НЕ СтрДлина(СведенияАдресаПоГАР.КодСтраны) = 3 Тогда
				
			КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
			ИмяСобытия = НСтр("ru = 'ЭлектронноеАктированиеЕИС.ПриФормированииАдресаМестаПоставки'",
				КодОсновногоЯзыка);
			Если НЕ СтрДлина(СведенияАдресаПоГАР.КодГАР) = 36 Тогда
				ПодробноеПредставлениеОшибки = НСтр("ru = 'Не удалось получить идентификатор ГАР места поставки. %1'",
					КодОсновногоЯзыка);
			ИначеЕсли НЕ СтрДлина(СведенияАдресаПоГАР.КодСтраны) = 3 Тогда
				ПодробноеПредставлениеОшибки = НСтр("ru = 'Не удалось получить код страны места поставки. %1'",
					КодОсновногоЯзыка);
			КонецЕсли;
			ДополнениеКПодробномуПредставлениюОшибки = НСтр("ru = 'Проверьте правильность заполнения адреса места поставки.'",
					КодОсновногоЯзыка);
			ПодробноеПредставлениеОшибки = СтрШаблон(ПодробноеПредставлениеОшибки, ДополнениеКПодробномуПредставлениюОшибки);
			ЭлектронноеАктированиеЕИС.ДобавитьОшибкуЗаполненияПриложения(
				ДанныеПриложенияЕИС, ПодробноеПредставлениеОшибки);
			ЗаписьЖурналаРегистрации(ИмяСобытия,
				УровеньЖурналаРегистрации.Ошибка, , ,
				ПодробноеПредставлениеОшибки);
					
			Возврат;
		КонецЕсли;
	
		Место.КодГАР = СведенияАдресаПоГАР.КодГар;
		Место.КодСтраны = СведенияАдресаПоГАР.КодСтраны;
		
		ДанныеПриложенияЕИС.МестаПоставки.Добавить(Место);
	КонецЦикла;
		
КонецПроцедуры

Функция ПолучитьСведенияАдресаПоГАР(МестоJSON)
	
	КодГАРИКодСтраны = Новый Структура;
	КодГАРИКодСтраны.Вставить("КодГАР", "");
	КодГАРИКодСтраны.Вставить("КодСтраны", "");
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(МестоJSON);
	Попытка
		ОбъектАдрес = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		Шаблон = НСтр("ru = 'Не удалось разобрать данные адреса места поставки: %1.'");
		ОписаниеОшибки = СтрШаблон(Шаблон, МестоJSON);
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Возврат КодГАРИКодСтраны;
	КонецПопытки;
	
	КодыАдреса = ЭлектронноеАктированиеЕИС.КодыАдреса(МестоJSON);
	Если КодыАдреса.Свойство("Идентификатор") И ЗначениеЗаполнено(КодыАдреса.Идентификатор) Тогда
		КодГАРИКодСтраны.КодГАР = Строка(КодыАдреса.Идентификатор);
	Иначе
		КодГАРИКодСтраны.КодГАР = Строка(КодыАдреса.ИдентификаторДома);
	КонецЕсли;
	Если ОбъектАдрес.Свойство("countryCode") Тогда
		КодГАРИКодСтраны.КодСтраны = ОбъектАдрес.countryCode;
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(КодГАРИКодСтраны.КодСтраны)
		ИЛИ НЕ ЗначениеЗаполнено(КодГАРИКодСтраны.КодГАР) Тогда
		
		КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ИмяСобытия = НСтр("ru = 'ЭлектронноеАктированиеЕИС.ПриФормированииАдресаМестаПоставки'",
			КодОсновногоЯзыка);
		ПодробноеПредставлениеОшибки = НСтр("ru = 'Не удалось получить адрес участника.'",
			КодОсновногоЯзыка);
		ЗаписьЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки);
			
		Возврат КодГАРИКодСтраны;
		
	КонецЕсли;
	
	Возврат КодГАРИКодСтраны;
	
КонецФункции

// Заполнить данные по строке товаров УПД 2019.
// 
// Параметры:
//  НоваяСтрокаЭД - СтрокаТаблицыЗначений
//  СтрокаВыборки - ВыборкаИзРезультатаЗапроса
//  СтруктураДанных - Структура
//  ДанныеПриложенияЕИС - Структура
Процедура ЗаполнитьДанныеПоСтрокеТоваровУПД_2019(НоваяСтрокаЭД, СтрокаВыборки, СтруктураДанных, ДанныеПриложенияЕИС) Экспорт

	ДанныеЭлектронногоАктированияЕИС = СтруктураДанных.ДанныеЭлектронногоАктированияЕИС;
	
	СтрокиДокумента = ДанныеЭлектронногоАктированияЕИС.СтрокиДокумента;
	
	ИдентификаторСтроки = НоваяСтрокаЭД.ИдентификаторСтроки;
	СтрокаКонтракта = СтрокиДокумента.Найти(ИдентификаторСтроки, "ИдентификаторСтроки");
	Если НЕ ЗначениеЗаполнено(СтрокаКонтракта) Тогда
		Шаблон = НСтр("ru='Не найдена строка госконтракта по идентификатору строки документа %1.'");
		ТекстОшибки = СтрШаблон(Шаблон, ИдентификаторСтроки);
		ЭлектронноеАктированиеЕИС.ДобавитьОшибкуЗаполненияПриложения(
			ДанныеПриложенияЕИС, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ДанныеКонтракта = ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта[0];

	Если НоваяСтрокаЭД.Количество <> 0 Тогда
		Количество = НоваяСтрокаЭД.Количество;
	Иначе
		Количество = 1;
	КонецЕсли;
	
	НалоговаяСтавка = КлиентЭДОКлиентСервер.ПолучитьСтавкуНДСЧислом(НоваяСтрокаЭД.НалоговаяСтавка);
	
	// Замена кода товара в УПД на данные из контракта.
	НоваяСтрокаЭД.ТоварКод = СтрокаКонтракта.КодТовараДляЕИС;
	// Цена за единицу указывается с точностью до 11 цифр.
	Если ЭлектронноеАктированиеЕИС.
			ЭтоОбъектЗакупкиСВозможностьюКорректировкиЦены(ДанныеКонтракта, СтрокаКонтракта) Тогда
		НоваяСтрокаЭД.ЦенаЗаЕдиницуИзмерения = Окр(НоваяСтрокаЭД.СтоимостьТоваровСНалогом / Количество
			/ (1 + НалоговаяСтавка), 11);
		ЦенаИзКонтрактаСНДС = Окр(НоваяСтрокаЭД.СтоимостьТоваровСНалогом / Количество, 11);
	Иначе
		ЦенаИзКонтрактаСНДС = СтрокаКонтракта.Цена;
		ЦенаЗаЕдиницуИзмерения = Окр(ЦенаИзКонтрактаСНДС / (1 + НалоговаяСтавка), 11);
		НоваяСтрокаЭД.ЦенаЗаЕдиницуИзмерения = ЦенаЗаЕдиницуИзмерения;
		НоваяСтрокаЭД.СтоимостьТоваровБезНалога = Окр(ЦенаЗаЕдиницуИзмерения * Количество, 2);
		НоваяСтрокаЭД.СтоимостьТоваровСНалогом =
			Окр(НоваяСтрокаЭД.СтоимостьТоваровБезНалога * (1 + НалоговаяСтавка), 2);
		НоваяСтрокаЭД.СуммаНалога =
			НоваяСтрокаЭД.СтоимостьТоваровСНалогом - НоваяСтрокаЭД.СтоимостьТоваровБезНалога;
	КонецЕсли;
	
	ИдентификаторДляАктированияЕИС = СтрокаКонтракта.ИдентификаторДляАктированияЕИС;
	
	// Определяем вид ТРУ.
	ВидТРУ = ЭлектронноеАктированиеЕИС.ОпределитьВидТРУДляУПД(СтрокаКонтракта.Тип);
	ЭтоРаботаИлиУслуга = СтрокаКонтракта.ЭтоРаботаИлиУслуга;
	// Устанавливаем признак в строке УПД.
	НоваяСтрокаЭД.Признак = Строка(ВидТРУ);
		
	СтрокаПриложения = ЭлектронноеАктированиеЕИС.НовыеНеДетализированныеСведенияОТРУ();
	СтрокаПриложения.Идентификатор = ИдентификаторДляАктированияЕИС;
	СтрокаПриложения.НомерСтрокиТаблицы = НоваяСтрокаЭД.НомерСтроки;
	Если ЭтоРаботаИлиУслуга Тогда
		Если ЗначениеЗаполнено(СтрокаКонтракта.ОбъемРаботыУслуги) Тогда
			// Количество указывается в текстовом выражении.
			СтрокаПриложения.ОбъемВТекстовомВыражении = СтрокаКонтракта.ОбъемВТекстовомВыражении;
		КонецЕсли;
	КонецЕсли;
	
	СтрокаПриложения.ЦенаИзКонтрактаСНДС = ЦенаИзКонтрактаСНДС;
	СтрокаПриложения.ИсходноеНаименование = СтрокаКонтракта.Наименование;
	
	СтрокаПриложения.ТехническийИдентификатор = СтрокаКонтракта.ВнутреннийИдентификаторЕИС;
	СтрокаПриложения.ВнешнийТехническийИдентификатор = СтрокаКонтракта.ВнешнийИдентификатор;
	
	Если НЕ ВидТРУ = ЭлектронноеАктированиеЕИС.ВидТРУУслуга() Тогда
		Если ЗначениеЗаполнено(СтрокаВыборки.СтранаПроисхожденияКод) Тогда
			СтрокаПриложения.КодСтраныПроисхождения = СтрокаВыборки.СтранаПроисхожденияКод;
			СтрокаПриложения.НаименованиеСтраныПроисхождения = СтрокаВыборки.СтранаПроисхожденияНаименование;
		КонецЕсли;
		Если НЕ СтрокаКонтракта.СтранаПроизводителя.Пустая() Тогда
			СтрокаПриложения.КодСтраныПроизводителя = СтрокаКонтракта.СтранаПроизводителя.Код;
			СтрокаПриложения.НаименованиеСтраныПроизводителя = СтрокаКонтракта.СтранаПроизводителя.Наименование;
		КонецЕсли;
	КонецЕсли;
	
	// Признак поставки объекта закупки с улучшенными характеристиками:
	// - 1 - не установлен;
	// - 2 - установлен из информации о контракте;
	// - 3 - установлен пользователем.
	// Игнорируется для авансовых СЧФ.
	// Игнорируется при приеме исправления к документу, который был подписан до версии 11.2.
	// В других случаях контролируется обязательное заполнение.
	// Если для позиции ТРУ в сведениях о контракте установлен одноименный признак, то контролируется, что в составе данного атрибута указано значение "2 - установлен из информации о контракте".
	// Если для позиции ТРУ в сведениях о контракте НЕ установлен одноименный признак, то контролируется, что в составе данного атрибута указано значение, отличное от "2 - установлен из информации о контракте".
	// В исправлении редактирование данного признака допускается только в том случае, если:
	// - статус документа, к которому формируется исправление - «Отказано при рассмотрении»
	// - в сведениях о контракте для данной позиции не установлен признак поставки объекта закупки с улучшенными характеристиками.
	СтрокаПриложения.ПризнакПоставкиОбъектаЗакупкиСУлучшеннымиХарактеристиками = 1;
	
	Если НЕ ЭтоРаботаИлиУслуга Тогда
		МестаПоставкиДокументовДляЕИС =
			СтруктураДанных.ДанныеЭлектронногоАктированияЕИС.МестаПоставкиДокументовДляЕИС;
		Если МестаПоставкиДокументовДляЕИС.Количество() = 1 Тогда
			МестоПоставки = ЭлектронноеАктированиеЕИС.НовыеСведенияОМестеПоставкиТоварнойПозиции();
			МестоПоставки.Идентификатор = МестаПоставкиДокументовДляЕИС[0].ИдентификаторАдреса;
			МестоПоставки.Идентификатор = СтрЗаменить(МестоПоставки.Идентификатор, "-", "");
			МестоПоставки.ПоставляемоеКоличество = НоваяСтрокаЭД.Количество; 
			СтрокаПриложения.СведенияОМестахПоставкиТовара.Добавить(МестоПоставки);
		КонецЕсли;
	КонецЕсли;
	
	ДанныеПриложенияЕИС.СведенияОТоварах.ТоварыРаботыУслуги.Добавить(СтрокаПриложения);

	// _Демо начало примера
	ЭтоМедицинскаяСпециализация = Ложь;
	Если ЭтоМедицинскаяСпециализация Тогда
		ЗаполнитьДанныеОМедицинскойСпецификеВСтрокеУПД(СтрокаПриложения, СтрокаКонтракта, СтрокаВыборки, Ложь);
	КонецЕсли;
	ЭтоСтроительнаяСпециализация = Ложь;
	Если ЭтоСтроительнаяСпециализация Тогда
		ЗаполнитьДанныеОСтроительнойСпецификеВСтрокеУПД(СтрокаПриложения,
			СтрокаКонтракта,
			СтрокаВыборки,
			Неопределено,
			Неопределено);
	КонецЕсли;
	// _Демо конец примера
	
КонецПроцедуры

// Заполнить данные по строке товаров УПД 5.02 и 5.03.
// 
// Параметры:
//  НоваяСтрокаЭД - СтрокаТаблицыЗначений
//  СтрокаВыборки - ВыборкаИзРезультатаЗапроса
//  СтруктураДанных - Структура
//  ДанныеПриложенияЕИС - Структура
Процедура ЗаполнитьДанныеПоСтрокеТоваровУПД_5_02(НоваяСтрокаЭД, СтрокаВыборки, СтруктураДанных, ДанныеПриложенияЕИС) Экспорт

	ДанныеЭлектронногоАктированияЕИС = СтруктураДанных.ДанныеЭлектронногоАктированияЕИС;
	
	СтрокиДокумента = ДанныеЭлектронногоАктированияЕИС.СтрокиДокумента;
	
	ИдентификаторСтроки = НоваяСтрокаЭД.ИдентификаторСтроки;
	СтрокаКонтракта = СтрокиДокумента.Найти(ИдентификаторСтроки, "ИдентификаторСтроки");
	Если НЕ ЗначениеЗаполнено(СтрокаКонтракта) Тогда
		Шаблон = НСтр("ru='Не найдена строка госконтракта по идентификатору строки документа %1.'");
		ТекстОшибки = СтрШаблон(Шаблон, ИдентификаторСтроки);
		ЭлектронноеАктированиеЕИС.ДобавитьОшибкуЗаполненияПриложения(
			ДанныеПриложенияЕИС, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ДанныеКонтракта = ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта[0];

	Если НоваяСтрокаЭД.Количество <> 0 Тогда
		Количество = НоваяСтрокаЭД.Количество;
	Иначе
		Количество = 1;
	КонецЕсли;
	
	НалоговаяСтавка = КлиентЭДОКлиентСервер.ПолучитьСтавкуНДСЧислом(НоваяСтрокаЭД.НалоговаяСтавка);
	
	// Замена кода товара в УПД на данные из контракта.
	НоваяСтрокаЭД.Код = СтрокаКонтракта.КодТовараДляЕИС;
	// Цена за единицу указывается с точностью до 11 цифр.
	Если ЭлектронноеАктированиеЕИС.
			ЭтоОбъектЗакупкиСВозможностьюКорректировкиЦены(ДанныеКонтракта, СтрокаКонтракта) Тогда
		НоваяСтрокаЭД.Цена = Окр(НоваяСтрокаЭД.СтоимостьСНалогом / Количество
			/ (1 + НалоговаяСтавка), 11);
		ЦенаИзКонтрактаСНДС = Окр(НоваяСтрокаЭД.СтоимостьСНалогом / Количество, 11);
	Иначе
		ЦенаИзКонтрактаСНДС = СтрокаКонтракта.Цена;
		ЦенаЗаЕдиницуИзмерения = Окр(ЦенаИзКонтрактаСНДС / (1 + НалоговаяСтавка), 11);
		НоваяСтрокаЭД.Цена = ЦенаЗаЕдиницуИзмерения;
		
		НоваяСтрокаЭД.СтоимостьСНалогом = Окр(ЦенаИзКонтрактаСНДС * Количество, 11);
		
		Если НоваяСтрокаЭД.НалоговаяСтавка = Перечисления.СтавкиНДС.БезНДС Тогда
			НоваяСтрокаЭД.СуммаНалога.Вставить("БезНДС", Истина);
			НоваяСтрокаЭД.СтоимостьБезНалога = НоваяСтрокаЭД.СтоимостьСНалогом;
		Иначе
			МножительНДС = НалоговаяСтавка * 100;
			СуммаНДС = Окр(НоваяСтрокаЭД.СтоимостьСНалогом * (МножительНДС / (100 + МножительНДС)), 2);
			НоваяСтрокаЭД.СуммаНалога.Вставить("Сумма", СуммаНДС);
			НоваяСтрокаЭД.СтоимостьБезНалога =
				НоваяСтрокаЭД.СтоимостьСНалогом - СуммаНДС;
		КонецЕсли;
		
	КонецЕсли;
	
	ИдентификаторДляАктированияЕИС = СтрокаКонтракта.ИдентификаторДляАктированияЕИС;
	
	// Определяем вид ТРУ.
	ВидТРУ = ЭлектронноеАктированиеЕИС.ОпределитьВидТРУДляУПД(СтрокаКонтракта.Тип);
	ЭтоРаботаИлиУслуга = СтрокаКонтракта.ЭтоРаботаИлиУслуга;
	// Устанавливаем признак в строке УПД.
	НоваяСтрокаЭД.Признак = Строка(ВидТРУ);
		
	СтрокаПриложения = ЭлектронноеАктированиеЕИС.НовыеНеДетализированныеСведенияОТРУ();
	СтрокаПриложения.Идентификатор = ИдентификаторДляАктированияЕИС;
	СтрокаПриложения.НомерСтрокиТаблицы = НоваяСтрокаЭД.НомерСтроки;
	Если ЭтоРаботаИлиУслуга Тогда
		Если ЗначениеЗаполнено(СтрокаКонтракта.ОбъемРаботыУслуги) Тогда
			// Количество указывается в текстовом выражении.
			СтрокаПриложения.ОбъемВТекстовомВыражении = СтрокаКонтракта.ОбъемВТекстовомВыражении;
		КонецЕсли;
	КонецЕсли;
	
	СтрокаПриложения.ЦенаИзКонтрактаСНДС = ЦенаИзКонтрактаСНДС;
	СтрокаПриложения.ИсходноеНаименование = СтрокаКонтракта.Наименование;
	
	СтрокаПриложения.ТехническийИдентификатор = СтрокаКонтракта.ВнутреннийИдентификаторЕИС;
	СтрокаПриложения.ВнешнийТехническийИдентификатор = СтрокаКонтракта.ВнешнийИдентификатор;
	
	Если НЕ ВидТРУ = ЭлектронноеАктированиеЕИС.ВидТРУУслуга() Тогда
		Если ЗначениеЗаполнено(СтрокаВыборки.СтранаПроисхожденияКод) Тогда
			СтрокаПриложения.КодСтраныПроисхождения = СтрокаВыборки.СтранаПроисхожденияКод;
			СтрокаПриложения.НаименованиеСтраныПроисхождения = СтрокаВыборки.СтранаПроисхожденияНаименование;
		КонецЕсли;
		Если НЕ СтрокаКонтракта.СтранаПроизводителя.Пустая() Тогда
			СтрокаПриложения.КодСтраныПроизводителя = СтрокаКонтракта.СтранаПроизводителя.Код;
			СтрокаПриложения.НаименованиеСтраныПроизводителя = СтрокаКонтракта.СтранаПроизводителя.Наименование;
		КонецЕсли;
	КонецЕсли;
	
	// Признак поставки объекта закупки с улучшенными характеристиками:
	// - 1 - не установлен;
	// - 2 - установлен из информации о контракте;
	// - 3 - установлен пользователем.
	// Игнорируется для авансовых СЧФ.
	// Игнорируется при приеме исправления к документу, который был подписан до версии 11.2.
	// В других случаях контролируется обязательное заполнение.
	// Если для позиции ТРУ в сведениях о контракте установлен одноименный признак, то контролируется, что в составе данного атрибута указано значение "2 - установлен из информации о контракте".
	// Если для позиции ТРУ в сведениях о контракте НЕ установлен одноименный признак, то контролируется, что в составе данного атрибута указано значение, отличное от "2 - установлен из информации о контракте".
	// В исправлении редактирование данного признака допускается только в том случае, если:
	// - статус документа, к которому формируется исправление - «Отказано при рассмотрении»
	// - в сведениях о контракте для данной позиции не установлен признак поставки объекта закупки с улучшенными характеристиками.
	СтрокаПриложения.ПризнакПоставкиОбъектаЗакупкиСУлучшеннымиХарактеристиками = 1;
	
	Если НЕ ЭтоРаботаИлиУслуга Тогда
		МестаПоставкиДокументовДляЕИС =
			СтруктураДанных.ДанныеЭлектронногоАктированияЕИС.МестаПоставкиДокументовДляЕИС;
		Если МестаПоставкиДокументовДляЕИС.Количество() = 1 Тогда
			МестоПоставки = ЭлектронноеАктированиеЕИС.НовыеСведенияОМестеПоставкиТоварнойПозиции();
			МестоПоставки.Идентификатор = МестаПоставкиДокументовДляЕИС[0].ИдентификаторАдреса;
			МестоПоставки.Идентификатор = СтрЗаменить(МестоПоставки.Идентификатор, "-", "");
			МестоПоставки.ПоставляемоеКоличество = НоваяСтрокаЭД.Количество; 
			СтрокаПриложения.СведенияОМестахПоставкиТовара.Добавить(МестоПоставки);
		КонецЕсли;
	КонецЕсли;
	
	ДанныеПриложенияЕИС.СведенияОТоварах.ТоварыРаботыУслуги.Добавить(СтрокаПриложения);
	
	// _Демо начало примера
	ЭтоМедицинскаяСпециализация = Ложь;
	Если ЭтоМедицинскаяСпециализация Тогда
		ЗаполнитьДанныеОМедицинскойСпецификеВСтрокеУПД(СтрокаПриложения, СтрокаКонтракта, СтрокаВыборки, Ложь);
	КонецЕсли;
	ЭтоСтроительнаяСпециализация = Ложь;
	Если ЭтоСтроительнаяСпециализация Тогда
		ЗаполнитьДанныеОСтроительнойСпецификеВСтрокеУПД(СтрокаПриложения,
			СтрокаКонтракта,
			СтрокаВыборки,
			Неопределено,
			Неопределено);
	КонецЕсли;
	// _Демо конец примера
	
КонецПроцедуры

// Заполнить данные по строке товаров УКД.
// 
// Параметры:
//  НоваяСтрокаЭД - Структура
//  СтрокаВыборки - Структура
//  СтруктураДанных - Структура
//  ДанныеПриложенияЕИС - Структура
Процедура ЗаполнитьДанныеПоСтрокеТоваровУКД(НоваяСтрокаЭД, СтрокаВыборки, СтруктураДанных, ДанныеПриложенияЕИС) Экспорт
	
	ДанныеЭлектронногоАктированияЕИС = СтруктураДанных.ДанныеЭлектронногоАктированияЕИС;
	
	ДанныеПоДетализации = ДанныеЭлектронногоАктированияЕИС.ДанныеПоДетализации;
	СтрокиДокумента = ДанныеЭлектронногоАктированияЕИС.СтрокиДокумента;
	
	ИдентификаторСтроки = НоваяСтрокаЭД.ИдентификаторСтроки;
	СтрокаДокумента = СтрокиДокумента.Найти(ИдентификаторСтроки, "ИдентификаторСтроки");
	Если НЕ ЗначениеЗаполнено(СтрокаДокумента) Тогда
		Шаблон = НСтр("ru='Не найдена строка госконтракта по идентификатору строки документа %1.'");
		ТекстОшибки = СтрШаблон(Шаблон, ИдентификаторСтроки);
		ЭлектронноеАктированиеЕИС.ДобавитьОшибкуЗаполненияПриложения(
			ДанныеПриложенияЕИС, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	// Замена кода и наименования товара в УПД на данные из контракта.
	НоваяСтрокаЭД.ТоварНаименование = СтрокаДокумента.Наименование;
	
	// Замена цены на цену из контракта с точностью до 11 знаков.
	НоваяСтрокаЭД.ЦенаЗаЕдиницуИзмерения = СтрокаДокумента.ЦенаЗаЕдиницуИзмерения;
	НоваяСтрокаЭД.ЦенаЗаЕдиницуИзмеренияДоКорректировки = СтрокаДокумента.ЦенаЗаЕдиницуИзмерения;
	
	ИдентификаторДляАктированияЕИС = СтрокаДокумента.ИдентификаторДляАктированияЕИС;
	СтрокаДетализации = ДанныеПоДетализации[ИдентификаторДляАктированияЕИС];
	ЕстьДетализация = СтрокаДетализации.КоличествоСтрок > 1;
	
	// Определяем вид ТРУ.
	ЭтоРаботаИлиУслуга = СтрокаДокумента.ЭтоРаботаИлиУслуга;
	
	СтрокаПриложения = ЭлектронноеАктированиеЕИС.НовыеСведенияОТРУДляУКД();
	СтрокаПриложения.НомерСтрокиТаблицы = НоваяСтрокаЭД.НомерСтроки;
	
	Если НоваяСтрокаЭД.Количество = 0 Тогда
		СтрокаПриложения.ЦенаСНДСПослеИзменения = 0;
	Иначе
		СтрокаПриложения.ЦенаСНДСПослеИзменения =
			НоваяСтрокаЭД.СтоимостьТоваровСНалогом / НоваяСтрокаЭД.Количество; 
	КонецЕсли;
	
	Если НоваяСтрокаЭД.КоличествоДоКорректировки = 0 Тогда
		СтрокаПриложения.ЦенаСНДСДоИзменения = 0;
	Иначе
		СтрокаПриложения.ЦенаСНДСДоИзменения =
			НоваяСтрокаЭД.СтоимостьТоваровСНалогомДоКорректировки / НоваяСтрокаЭД.КоличествоДоКорректировки;
	КонецЕсли;
	
	СтрокаПриложения.ИсходноеНаименование = СтрокаДокумента.Наименование;
	
	СтрокаПриложения.ВнешнийТехническийИдентификатор = СтрокаДокумента.ВнешнийИдентификатор;
	СтрокаПриложения.Код = СтрокаДокумента.КодТовараДляЕИС;
	СтрокаПриложения.НаименованиеЕдиницыИзмеренияДоИзменения =
		НоваяСтрокаЭД.ЕдиницаИзмерения.НаименованиеПолное;
	СтрокаПриложения.НаименованиеЕдиницыИзмеренияПослеИзменения =
		НоваяСтрокаЭД.ЕдиницаИзмерения.НаименованиеПолное;
	// Для работ и услуг.
	Если ЭтоРаботаИлиУслуга Тогда
		СтрокаПриложения.ОбъемВТекстовомВыраженииДоИзменения =
			СтрокаДокумента.ОбъемВТекстовомВыраженииДоКорректировки;
		СтрокаПриложения.ОбъемВТекстовомВыраженииПослеИзменения =
			СтрокаДокумента.ОбъемВТекстовомВыражении;
	КонецЕсли;
	
	Если ЕстьДетализация Тогда
		Если НЕ ЗначениеЗаполнено(СтрокаДетализации.ДанныеРодителя) Тогда
			// создаем родителя
		КонецЕсли;
	Иначе
		
		СтрокаПриложения.Идентификатор = ИдентификаторДляАктированияЕИС;
		
	КонецЕсли;
	
	ДанныеПриложенияЕИС.СведенияОТоварах.ТоварыРаботыУслуги.Добавить(СтрокаПриложения);
	
КонецПроцедуры

// Колонки электронного актирования.
// 
// Возвращаемое значение:
//  Массив из Строка
Функция КолонкиЭлектронногоАктирования() Экспорт
	
	Колонки = Новый Массив;
	Колонки.Добавить("ИдентификаторДляАктированияЕИС");
	Колонки.Добавить("СтранаПроизводителя");
	Колонки.Добавить("ОбъемВТекстовомВыражении");
	Колонки.Добавить("ОбъемВТекстовомВыраженииДоКорректировки");
	Возврат Колонки;
	
КонецФункции

// Сохраняет данные по электронному актированию, извлекая их из данных формы.
//
// Параметры:
//  КоллекцияДанных		 - ДанныеФормыКоллекция, ТаблицаЗначений - таблица, из которой будут получены данные по маркировке.
//  ЗаписываемыйОбъект	 - ДокументОбъект - объект документа, в котором хранятся сведения по маркировке.
//
Процедура СохранитьИдентификаторыДляАктированияЕИС(КоллекцияДанных, ЗаписываемыйОбъект) Экспорт
	
	Госконтракт = ЭлектронноеАктированиеЕИС.ГосударственныйКонтрактДоговора(
		ЗаписываемыйОбъект.ДоговорКонтрагента);
	АктированиеВключено = ЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеВЕИС();
	ОбменВключен = ЭлектронноеАктированиеЕИС.ОбменПоОрганизацииВключен(
		ЗаписываемыйОбъект.Организация);
	Если НЕ ОбменВключен
		ИЛИ НЕ АктированиеВключено
		ИЛИ НЕ ЗначениеЗаполнено(Госконтракт) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписываемыйОбъект.ДанныеДляАктированияЕИС.Очистить();
	Для Каждого СтрокаТовары Из КоллекцияДанных Цикл
		НоваяСтрока = ЗаписываемыйОбъект.ДанныеДляАктированияЕИС.Добавить();
		НоваяСтрока.ИдентификаторСтроки = СтрокаТовары.ИдентификаторСтроки;
		Если ПустаяСтрока(СтрокаТовары.ИдентификаторДляАктированияЕИС) Тогда
			ОписаниеОшибки = НСтр("ru = 'Не заполнен идентификатор строки государственного контракта в табличной части.'");
			ВызватьИсключение(ОписаниеОшибки);
		КонецЕсли;
		НоваяСтрока.ИдентификаторДляАктированияЕИС = СтрокаТовары.ИдентификаторДляАктированияЕИС;
		НоваяСтрока.СтранаПроизводителя = СтрокаТовары.СтранаПроизводителя;
		НоваяСтрока.ОбъемВТекстовомВыражении = СтрокаТовары.ОбъемВТекстовомВыражении;
		НоваяСтрока.ОбъемВТекстовомВыраженииДоКорректировки = СтрокаТовары.ОбъемВТекстовомВыраженииДоКорректировки;
	КонецЦикла;
	
КонецПроцедуры

// Заполняет представление указанных в документе данных электронного актирования табличной части.
//
// Параметры:
//  ВладелецКоллекции - ДанныеФормыСтруктура - объект документа-владельца формы, либо сама форма.
//     Форма указывается в том случае, если таблица-коллекция является реквизитом формы, а не объекта.
//  ИмяКоллекции      - Строка - имя табличной части, в которой заполняется реквизиты.
//     Таблица должна содержать колонки: "НомерСтроки, ИдентификаторСтроки, ИдентификаторДляАктированияЕИС, СтранаПроизводителя".
//
Процедура ЗаполнитьРеквизитыЭлектронногоАктирования(ВладелецКоллекции, ИмяКоллекции = "Товары") Экспорт
	
	КоллекцияДанных = ВладелецКоллекции[ИмяКоллекции];
	
	Для Каждого СтрокаКоллекции Из КоллекцияДанных Цикл
		Если ЗначениеЗаполнено(СтрокаКоллекции.ИдентификаторСтроки) Тогда
			ПараметрыОтбора = Новый Структура("ИдентификаторСтроки",
				СтрокаКоллекции.ИдентификаторСтроки);
			
			Данные = ВладелецКоллекции.ДанныеДляАктированияЕИС.Выгрузить(ПараметрыОтбора);
			Если Данные.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(СтрокаКоллекции, Данные[0]);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Дополнить запрос данными для электронного актирования ЕИС.
// 
// Параметры:
//  ТекстЗапроса - Строка
//  ИмяДокумента - Неопределено
//  МножествоСсылок - Булево
Процедура ДополнитьЗапросДаннымиДляЭлектронногоАктированияЕИС(ТекстЗапроса,
	Знач ИмяДокумента = Неопределено, Знач МножествоСсылок = Ложь) Экспорт
	
	ТекстЗапроса = ТекстЗапроса + ";
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеДляАктированияЕИС.ИдентификаторДляАктированияЕИС,
	|	ДанныеДляАктированияЕИС.СтранаПроизводителя,
	|	ДанныеДляАктированияЕИС.ИдентификаторСтроки,
	|	ДанныеДляАктированияЕИС.ОбъемВТекстовомВыражении,
	|	ДанныеДляАктированияЕИС.ОбъемВТекстовомВыраженииДоКорректировки,
	|	1 КАК КоличествоСтрок,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Ссылка,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.НомерСтроки,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ВнешнийИдентификатор,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ВнутреннийИдентификаторЕИС,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ЕдиницаИзмерения,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Идентификатор,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.КодТовараДляЕИС,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Количество,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Наименование,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ОбъемРаботыУслуги,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.СтавкаНДС,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.СтранаПроизводителя КАК СтранаПроизводителяКонтракт,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.СтранаПроисхождения КАК СтранаПроисхожденияКонтракт,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Сумма,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Тип,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Цена,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ЭтоЛекарственныйПрепарат,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ЭтоМедицинскоеИзделие,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ЭтоРаботаИлиУслуга,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.СуммаНДС,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ЦенаЗаЕдиницуИзмерения
	|ИЗ
	|	Документ.#ИмяДокумента.ДанныеДляАктированияЕИС КАК ДанныеДляАктированияЕИС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГосударственныеКонтрактыЕИС.ОбъектыЗакупки КАК ГосударственныеКонтрактыЕИСОбъектыЗакупки
	|		ПО ДанныеДляАктированияЕИС.ИдентификаторДляАктированияЕИС = ГосударственныеКонтрактыЕИСОбъектыЗакупки.Идентификатор
	|		И
	|			ДанныеДляАктированияЕИС.Ссылка.ДоговорКонтрагента = ГосударственныеКонтрактыЕИСОбъектыЗакупки.Ссылка.ВладелецКонтракта
	|ГДЕ
	|	ДанныеДляАктированияЕИС.Ссылка &УсловиеСсылки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПодписантыОрганизацийЕИС.ОбластьПолномочий КАК ОбластьПолномочий,
	|	ПодписантыОрганизацийЕИС.ОснованиеПолномочий КАК ОснованиеПолномочий,
	|	ПодписантыОрганизацийЕИС.Фамилия КАК Фамилия,
	|	ПодписантыОрганизацийЕИС.Имя КАК Имя,
	|	ПодписантыОрганизацийЕИС.Отчество КАК Отчество,
	|	ПодписантыОрганизацийЕИС.ИНН КАК ИНН,
	|	ПодписантыОрганизацийЕИС.Должность КАК Должность,
	|	ПодписантыДокументовЕИС.Статус КАК Статус,
	|	ПодписантыОрганизацийЕИС.ТипПодписанта КАК ТипПодписанта,
	|	ПодписантыОрганизацийЕИС.ПолноеНаименованиеОрганизации КАК ПодписантПолноеНаименованиеОрганизации,
	|	ПодписантыДокументовЕИС.ОбластьПолномочий КАК ОбластьПолномочийДокумент,
	|	ПодписантыДокументовЕИС.ОснованиеПолномочий КАК ОснованиеПолномочийДокумент,
	|	ПодписантыДокументовЕИС.Организация КАК Организация,
	|	ПодписантыОрганизацийЕИС.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ПодписантыДокументовЕИС КАК ПодписантыДокументовЕИС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодписантыОрганизацийЕИС КАК ПодписантыОрганизацийЕИС
	|		ПО (ПодписантыДокументовЕИС.Подписант = ПодписантыОрганизацийЕИС.Ссылка)
	|ГДЕ
	|	ПодписантыДокументовЕИС.Подписант.Актуален = ИСТИНА
	|	И ПодписантыДокументовЕИС.Подписант.ПометкаУдаления = ЛОЖЬ
	|	И ПодписантыДокументовЕИС.Документ &УсловиеСсылки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МестаПоставкиДокументовДляЕИС.Организация,
	|	МестаПоставкиДокументовДляЕИС.ИдентификаторАдреса,
	|	МестаПоставкиДокументовДляЕИС.Документ КАК Регистратор,
	|	МестаПоставкиДокументовДляЕИС.Место,
	|	МестаПоставкиДокументовДляЕИС.Классификатор,
	|	МестаПоставкиДокументовДляЕИС.Код,
	|	МестаПоставкиДокументовДляЕИС.Наименование,
	|	МестаПоставкиДокументовДляЕИС.Адрес,
	|	МестаПоставкиДокументовДляЕИС.РайонИлиГород,
	|	МестаПоставкиДокументовДляЕИС.НаселенныйПункт,
	|	МестаПоставкиДокументовДляЕИС.ДанныеМеста
	|ИЗ
	|	РегистрСведений.МестаПоставкиДокументовДляЕИС КАК МестаПоставкиДокументовДляЕИС
	|ГДЕ
	|	МестаПоставкиДокументовДляЕИС.Документ &УсловиеСсылки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.ВидВложения.Код КАК КодВида,
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.ВидВложения.Наименование КАК НаименованиеВида,
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.ВидВложения,
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.ПрисоединенныйФайл
	|ИЗ
	|	РегистрСведений.ПриложенныеФайлыДляЭлектронногоАктированияЕИС КАК ПриложенныеФайлыДляЭлектронногоАктированияЕИС
	|ГДЕ
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.Документ &УсловиеСсылки
	|;
	|" + ЭлектронноеАктированиеЕИС.ТекстЗапросаДанныхШапкиГосударственногоКонтракта();
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&УсловиеСсылки", ?(МножествоСсылок, "В (&Ссылка)", "= &Ссылка"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяДокумента", ИмяДокумента);		
	
КонецПроцедуры
	
// См. СозданиеНаОснованииПереопределяемый.ПриОпределенииОбъектовСКомандамиСозданияНаОсновании
Процедура ПриОпределенииОбъектовСКомандамиСозданияНаОсновании(Объекты) Экспорт

	Объекты.Добавить(Метаданные.Документы.АктПриемкиВходящийЕИС);
	
КонецПроцедуры
	
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполнить подписантов результата рассмотрения.
// 
// Параметры:
//  РезультатРассмотрения - ДокументСсылка.РезультатыРассмотренияАктаПриемкиЕИС - Результат рассмотрения.
//  Данные - ДеревоЗначений
Процедура ЗаполнитьПодписантовРезультатаРассмотрения(РезультатРассмотрения, Данные)

	ЭтоУКД = РезультатРассмотрения.ЭтоКорректировка;
	ТипДокумента = ?(ЭтоУКД, "УКД", "УПД");
	
	ТаблицаПодписанты = ЭлектронноеАктированиеЕИС.НоваяТаблицаПодписантов();
	
	Подписант = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РезультатРассмотрения, "ПринялТРУ");
	Строка = ТаблицаПодписанты.Добавить();
	ЗаполнитьЗначенияСвойств(Строка, Подписант);
	Строка.Статус = "5";
	ДанныеПолномочий = ЭлектронноеАктированиеЕИС.ДанныеОПолномочияхПодписантаЗаказчика(
		Подписант, ТипДокумента);
	Строка.ОбластьПолномочий = ДанныеПолномочий.КодОбластиПолномочий;
	Строка.ОснованиеПолномочий = ДанныеПолномочий.ОснованиеПолномочий;
	Строка.НомерСтроки = 1;
	
	ПодписантыЕИС = РезультатРассмотрения.УполномоченныеЛицаЗаказчика;
	
	Если НЕ ЭтоУКД Тогда
		// Номер строки указывается в атрибуте ИныеСвед.
		// в дальнейшем используется для заполнения приложений для ЕИС.
		НомерСтроки = 2;
		Для Каждого УполномоченноеЛицо Из ПодписантыЕИС Цикл
			Подписант = УполномоченноеЛицо.Подписант;
			Строка = ТаблицаПодписанты.Добавить();
			ЗаполнитьЗначенияСвойств(Строка, Подписант);
			Строка.Статус = "5";
			ДанныеПолномочий = ЭлектронноеАктированиеЕИС.ДанныеОПолномочияхПодписантаЗаказчика(
				Подписант, ТипДокумента);
			Строка.ОбластьПолномочий = ДанныеПолномочий.КодОбластиПолномочий;
			Строка.ОснованиеПолномочий = ДанныеПолномочий.ОснованиеПолномочий;
			Строка.НомерСтроки = НомерСтроки;
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные,
		"ДанныеЭлектронногоАктированияЕИС.Подписанты", ТаблицаПодписанты);
	
КонецПроцедуры

// _Демо начало примера
// Пример заполнения данных о медицинском препарате.
Процедура ЗаполнитьДанныеОМедицинскойСпецификеВСтрокеУПД(СтрокаПриложения,
		ДанныеОТовареИзДокумента,
		ДанныеОТовареИзКонтракта,
		ЭтоИсправлениеСчетФактуры)
	
	СтрокаПриложения.ЭтоЛекарственныйПрепарат = Истина;
	СведенияЛП = СтрокаПриложения.СведенияОЛекарственномПрепарате;
	// В качестве идентификатора ЛП используем внутренний идентификатор номенклатуры.
	Если ЭтоИсправлениеСчетФактуры И ЗначениеЗаполнено(ДанныеОТовареИзДокумента.ИдентификаторЛПДляОбхода) Тогда
		СведенияЛП.ИдентификаторЛекарственногоПрепарата = ДанныеОТовареИзДокумента.ИдентификаторЛПДляОбхода;
	Иначе
		СведенияЛП.ИдентификаторЛекарственногоПрепарата =
			ЭлектронноеАктированиеЕИС.
				ИдентификаторЛекарственногоПрепаратаДляПриложенияКТитулуПродавца(ДанныеОТовареИзДокумента.Номенклатура);
	КонецЕсли;
	СведенияЛП.ЦенаЗаПотребительскуюУпаковкуСНДС = ДанныеОТовареИзДокумента.ЦенаЗаПотребительскуюУпаковкуСНДС;
	СведенияЛП.Серия = ДанныеОТовареИзДокумента.СерияЛекарственногоПрепарата;
	ФорматДаты = НСтр("ru = 'ДЛФ=D'");
	СведенияЛП.СрокГодности = Формат(ДанныеОТовареИзДокумента.СрокГодности, ФорматДаты);
	СведенияЛП.МеждународноеНепатентованноеНаименование =
		ДанныеОТовареИзДокумента.МеждународноеНепатентованноеНаименование;
	СведенияЛП.ТорговоеНаименование = ДанныеОТовареИзДокумента.ТорговоеНаименованиеЛП;
	СведенияЛП.ЛекарственнаяФорма = ДанныеОТовареИзДокумента.ЛекарственнаяФорма;
	СведенияЛП.ДозировкаНаименование = ДанныеОТовареИзДокумента.ДозировкаНаименование;
	СведенияЛП.ДозировкаЗначение = ДанныеОТовареИзДокумента.ДозировкаЗначение;
	СведенияЛП.НаименованиеПотребительскойЕдиницыИзмерения =
		ДанныеОТовареИзДокумента.НаименованиеПотребительскойЕдиницыИзмерения;
	СведенияЛП.КоличествоВПотребительскихЕдиницахИзмерения =
		ДанныеОТовареИзДокумента.КоличествоВПотребительскихЕдиницахИзмерения;
	СведенияЛП.ВидПервичнойУпаковки = ДанныеОТовареИзДокумента.ВидПервичнойУпаковки;
	СведенияЛП.КоличествоВПервичнойУпаковке = ДанныеОТовареИзДокумента.КоличествоВПервичнойУпаковке;
	СведенияЛП.КоличествоПервичныхУпаковокВПотребительскойУпаковке =
		ДанныеОТовареИзДокумента.КоличествоПервичныхУпаковокВПотребительскойУпаковке;
	СведенияЛП.КоличествоЛекарственныхФормВПотребительскойУпаковке
		= ДанныеОТовареИзДокумента.КоличествоЛекарственныхФормВПотребительскойУпаковке;
	СведенияЛП.КоличествоПотребительскихЕдиницВПотребительскойУпаковке
		= ДанныеОТовареИзДокумента.КоличествоПотребительскихЕдиницВПотребительскойУпаковке;
	СведенияЛП.КоличествоВПервичнойУпаковке = ДанныеОТовареИзДокумента.КоличествоВПервичнойУпаковке;
	СведенияЛП.ВключенВЖНВЛП = ДанныеОТовареИзДокумента.ВключенВЖНВЛП;
	СведенияЛП.ФактическаяОтпускнаяЦенаЖНВЛП = ДанныеОТовареИзДокумента.ФактическаяОтпускнаяЦенаЖНВЛП;
	СведенияЛП.ПредельнаяОтпускнаяЦенаЖНВЛП = ДанныеОТовареИзДокумента.ПредельнаяОтпускнаяЦенаЖНВЛП;
	СведенияЛП.СуммарныйРазмерОптовыхНадбавокЖНВЛП = ДанныеОТовареИзДокумента.СуммарныйРазмерОптовыхНадбавокЖНВЛП;
	СведенияЛП.СуммарныйРазмерОптовыхНадбавокВПроцентахЖНВЛП = ДанныеОТовареИзДокумента.СуммарныйРазмерОптовыхНадбавокВПроцентахЖНВЛП;
	
КонецПроцедуры

// Пример заполнения данных о строительной специализации.
Процедура ЗаполнитьДанныеОСтроительнойСпецификеВСтрокеУПД(СтрокаПриложения,
		СведенияОТоварах,
		ДанныеОТовареИзДокумента,
		ДанныеОТовареИзКонтракта,
		ДанныеОТовареИзФайлаКонтракта)
		
	СведенияОТоварах.НаименованиеОбъектаСтроительства = НСтр("ru = 'Объект строительства 1'");
	СтрокаПриложения.НомерПозицииПоСмете = НСтр("ru = 'Позиция по смете 1'");
	
	СтрокаПриложения.ОтраслеваяСпециализация =
		ЭлектронноеАктированиеЕИС.ОтраслеваяСпециализацияСтроительство();
	СтроительнаяДетализация =
		ЭлектронноеАктированиеЕИС.НовыеСведенияОтраслевойСпециализацииСтроительствоДляУПД();
		
	// Вид работ.
	ВидРабот = ЭлектронноеАктированиеЕИС.НовыйВидРаботСтроительство();
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	ВидРабот.Идентификатор = СтрЗаменить(Идентификатор, "-", "");
	ВидРабот.НаименованиеВидаРабот = НСтр("ru = 'Вид работ 1'");
	ВидРабот.НомерПозицииПоСмете = НСтр("ru = 'Позиция по смете 1'");
	ВидРабот.ЭтоТовар = Ложь;
	ВидРабот.Количество = 1;
	ВидРабот.ЦенаБезНДС = 1;
	ВидРабот.ЦенаСНДС = 1;
	ВидРабот.СтоимостьБезНДСВсего = 1;
	ВидРабот.СтоимостьСНДСВсего = 1;
	ВидРабот.БезНДС = Истина;
	ВидРабот.КодТовараПоОКПД2 = ДанныеОТовареИзФайлаКонтракта.ОКПД2.Код;
	ВидРабот.ОКЕИ.Код = ДанныеОТовареИзКонтракта.ЕдиницаИзмерения.Код;
	ВидРабот.КодОЕИ = "123";
	Если НЕ ДанныеОТовареИзДокумента.СтранаПроисхождения.Пустая() Тогда
		ВидРабот.КодСтраныПроисхождения = ДанныеОТовареИзДокумента.СтранаПроисхождения.Код;
		ВидРабот.НаименованиеСтраныПроисхождения = ДанныеОТовареИзДокумента.СтранаПроисхождения.Наименование;
	КонецЕсли;
	Если НЕ ДанныеОТовареИзДокумента.СтранаПроизводителя.Пустая() Тогда
		ВидРабот.КодСтраныПроизводителя = ДанныеОТовареИзДокумента.СтранаПроизводителя.Код;
		ВидРабот.НаименованиеСтраныПроизводителя = ДанныеОТовареИзДокумента.СтранаПроизводителя.Наименование;
	КонецЕсли;
	СтроительнаяДетализация.ВидыРабот.Добавить(ВидРабот);
	
	СтрокаПриложения.СведенияОтраслевойСпециализация = СтроительнаяДетализация;
	
КонецПроцедуры
// _Демо конец примера

Функция ЗапросПоНоменклатуре(Документ)

	ТекстЗапроса = "ВЫБРАТЬ
	|	*,
	|	"""" КАК Идентификатор
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ДанныеДляАктированияЕИС КАК
	|			РеализацияТоваровУслугДанныеДляАктированияЕИС
	|		ПО РеализацияТоваровУслугТовары.ИдентификаторСтроки = РеализацияТоваровУслугДанныеДляАктированияЕИС.ИдентификаторСтроки
	|		И РеализацияТоваровУслугДанныеДляАктированияЕИС.Ссылка = РеализацияТоваровУслугТовары.Ссылка
	|ГДЕ
	|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", Документ);
	Возврат Запрос;

КонецФункции

Функция ДанныеПриложенияУПДЗаказчика(РезультатыРассмотренияАктаПриемкиЕИС)
	
	ДанныеПриложенияУПД = ЭлектронноеАктированиеЕИС.НовыеДанныеПриложенияКТитулуЗаказчикаУПД();
	
	Если НЕ ТипЗнч(РезультатыРассмотренияАктаПриемкиЕИС) = Тип("ДокументСсылка.РезультатыРассмотренияАктаПриемкиЕИС") Тогда
		ОписаниеОшибки = НСтр("ru = 'Требуется создать документ рассмотрения документа приемки.'");
		ЭлектронноеАктированиеЕИС.ДобавитьОшибкуЗаполненияПриложения(ДанныеПриложенияУПД, ОписаниеОшибки);
		Возврат ДанныеПриложенияУПД;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	РезультатыРассмотренияАктаПриемкиЕИС.СуммаДокумента КАК ИтогоФактическиПринято,
	|	РезультатыРассмотренияАктаПриемкиЕИС.ИнформацияОПричинахИОснованияхОтказа КАК ИнформацияОРасхожденияхПричинахОтказа,
	|	РезультатыРассмотренияАктаПриемкиЕИС.ДатаПолученияТРУ КАК ДатаПолученияТРУ,
	|	РезультатыРассмотренияАктаПриемкиЕИС.КодРешенияПриемочнойКомиссии КАК КодРешенияПриемочнойКомиссии,
	|	РезультатыРассмотренияАктаПриемкиЕИС.ТекстРешенияПриемочнойКомиссии КАК РешениеПриемочнойКомиссии,
	|	РезультатыРассмотренияАктаПриемкиЕИС.ОснованиеСозданияПриемочнойКомиссии КАК ОснованиеСозданияПриемочнойКомиссии
	|ИЗ
	|	Документ.РезультатыРассмотренияАктаПриемкиЕИС КАК РезультатыРассмотренияАктаПриемкиЕИС
	|ГДЕ
	|	РезультатыРассмотренияАктаПриемкиЕИС.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасхожденияДляОбъектовЗакупки.Идентификатор КАК ИдентификаторПринятогоТРУ,
	|	РасхожденияДляОбъектовЗакупки.ВнешнийИдентификатор КАК ВнешнийТехническийИдентификаторПозицииТРУ,
	|	ЛОЖЬ КАК ПризнакПринятияТРУ,
	|	РасхожденияДляОбъектовЗакупки.ПринятыйОбъемРаботыУслуги КАК ПринятыйОбъемРаботыУслуги,
	|	РасхожденияДляОбъектовЗакупки.Всего КАК СтоимостьСНалогом,
	|	РасхожденияДляОбъектовЗакупки.ПричинаОтказаОтПриемки КАК ПричинаОтказаОтПриемки
	|ИЗ
	|	Документ.РезультатыРассмотренияАктаПриемкиЕИС.РасхожденияДляОбъектовЗакупки КАК РасхожденияДляОбъектовЗакупки
	|ГДЕ
	|	РасхожденияДляОбъектовЗакупки.Ссылка = &Ссылка
	|	И РасхожденияДляОбъектовЗакупки.Количество <> РасхожденияДляОбъектовЗакупки.КоличествоПринято
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РешениеЧленовПриемочнойКомиссии.НомерСтроки КАК НомерПодписанта,
	|	РешениеЧленовПриемочнойКомиссии.РольВПриемочнойКомиссии КАК РольВПриемочнойКомиссии,
	|	ПРЕДСТАВЛЕНИЕ(РешениеЧленовПриемочнойКомиссии.Подписант.ОснованиеПолномочий) КАК
	|		ОснованиеПолномочийЧленаПриемочнойКомиссии,
	|	РешениеЧленовПриемочнойКомиссии.КодРешения КАК КодРешенияЧленаПриемочнойКомиссии
	|ИЗ
	|	Документ.РезультатыРассмотренияАктаПриемкиЕИС.РешениеЧленовПриемочнойКомиссии КАК РешениеЧленовПриемочнойКомиссии
	|ГДЕ
	|	РешениеЧленовПриемочнойКомиссии.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УполномоченныеЛицаЗаказчика.НомерСтроки КАК НомерПодписанта,
	|	ПРЕДСТАВЛЕНИЕ(УполномоченныеЛицаЗаказчика.Подписант.ТипПодписанта) КАК ВидУполномоченногоЛица
	|ИЗ
	|	Документ.РезультатыРассмотренияАктаПриемкиЕИС.УполномоченныеЛицаЗаказчика КАК УполномоченныеЛицаЗаказчика
	|ГДЕ
	|	УполномоченныеЛицаЗаказчика.Ссылка = &Ссылка
	|	И УполномоченныеЛицаЗаказчика.Подписант.ЭтоИноеУполномоченноеЛицо = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрочиеНачисления.ТребованиеОбУплатеНеустойки КАК НаименованиеТребования,
	|	ПрочиеНачисления.НомерТребования КАК НомерТребования,
	|	ПрочиеНачисления.ДатаТребования КАК ДатаТребования,
	|	ПрочиеНачисления.ТипНеустойки КАК ТипНеустойки,
	|	ПрочиеНачисления.СуммаНеустойки КАК РазмерНеустойки,
	|	ПрочиеНачисления.КодПричины КАК КодПричины,
	|	ПрочиеНачисления.НаименованиеПричины КАК НаименованиеПричины
	|ИЗ
	|	Документ.РезультатыРассмотренияАктаПриемкиЕИС.ПрочиеНачисления КАК ПрочиеНачисления
	|ГДЕ
	|	ПрочиеНачисления.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.ПрисоединенныйФайл КАК ПрисоединенныйФайл,
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.ВидВложения.Код КАК КодВида,
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.ВидВложения.Наименование КАК НаименованиеВида
	|ИЗ
	|	РегистрСведений.ПриложенныеФайлыДляЭлектронногоАктированияЕИС КАК ПриложенныеФайлыДляЭлектронногоАктированияЕИС
	|ГДЕ
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.Документ = &Ссылка" );
	
	Запрос.УстановитьПараметр("Ссылка", РезультатыРассмотренияАктаПриемкиЕИС);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаШапки = МассивРезультатов[0].Выбрать();
	ВыборкаШапки.Следующий();
	ЗаполнитьЗначенияСвойств(ДанныеПриложенияУПД, ВыборкаШапки);
	
	// Сведения о принятии 
	// Если код итога приемки равен 1 (в УПД (титул покупателя) значение атрибута «Код,
	// обозначающий итог приемки товара (работ, услуг, прав)» (Файл/ИнфПок/СодФХЖ4/СвПрин/КодСодОпер/@КодИтога) равно 1),
	// то игнорируется при приеме
	ВыборкаРасхождений = МассивРезультатов[1].Выбрать();
	Если ВыборкаРасхождений.Количество() > 0 Тогда
		
		Пока ВыборкаРасхождений.Следующий() Цикл
			
			ДетализированныеСведения = Ложь;
			СведенияОТРУ = ЭлектронноеАктированиеЕИС.НовыеСведенияТРУУПДЗаказчика(ДетализированныеСведения);
		
			СведенияОНеДетализированныхПозицияхТРУ = СведенияОТРУ.СведенияОНедетализированныхПозицияхТРУ;
			ЗаполнитьЗначенияСвойств(СведенияОНеДетализированныхПозицияхТРУ, ВыборкаРасхождений);
			
			СведенияОНеДетализированныхПозицияхТРУ.ОтраслеваяСпециализация = Неопределено;
			
			ДанныеПриложенияУПД.СведенияОТРУ.Добавить(СведенияОТРУ);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Информация о решении приемочной комиссии
	// Наличие блока означает, что установлен признак "Для определения результатов приемки товаров, работ,
	// услуг создана приемочная комиссия"
	ВыборкаРешениеЧленовПриемочнойКомиссии = МассивРезультатов[2].Выбрать();
	Если ВыборкаРешениеЧленовПриемочнойКомиссии.Количество() > 0 Тогда
		
		ИнформацияОРешенииПриемочнойКомиссии = ЭлектронноеАктированиеЕИС.НовыеСведенияИнформацииОРешенииПриемочнойКомиссииЗаказчика();
		ЗаполнитьЗначенияСвойств(ИнформацияОРешенииПриемочнойКомиссии, ВыборкаШапки);
		
		СведенияОЧленеПриемочнойКомиссии = ИнформацияОРешенииПриемочнойКомиссии.СведенияОЧленеПриемочнойКомиссии;
		
		Пока ВыборкаРешениеЧленовПриемочнойКомиссии.Следующий() Цикл
			СведенияОЧленеПриемочнойКомиссииЗаказчика = ЭлектронноеАктированиеЕИС.НовыеСведенияОЧленеПриемочнойКомиссииЗаказчика();
			ЗаполнитьЗначенияСвойств(СведенияОЧленеПриемочнойКомиссииЗаказчика, ВыборкаРешениеЧленовПриемочнойКомиссии);
			
			ЗначениеРолиВПриемочнойКомиссии = ЗначениеРолиВПриемочнойКомиссии(
				ВыборкаРешениеЧленовПриемочнойКомиссии.РольВПриемочнойКомиссии);
			СведенияОЧленеПриемочнойКомиссииЗаказчика.РольВПриемочнойКомиссии = ЗначениеРолиВПриемочнойКомиссии;
			
			ИнформацияОРешении = СведенияОЧленеПриемочнойКомиссииЗаказчика.ИнформацияОРешенииЧленаПриемочнойКомиссии;
			КодРешения = ВыборкаРешениеЧленовПриемочнойКомиссии.КодРешенияЧленаПриемочнойКомиссии;	
				
			ИнформацияОРешении.КодРешенияЧленаПриемочнойКомиссии = КодРешения;
			ИнформацияОРешении.РешениеЧленаПриемочнойКомиссии = 
				ЭлектронноеАктированиеЕИС.РешениеЧленаПриемочнойКомиссииЗаказчикаПоКоду(КодРешения);
			
			СведенияОЧленеПриемочнойКомиссии.Добавить(СведенияОЧленеПриемочнойКомиссииЗаказчика);	
		КонецЦикла;
		
		ДанныеПриложенияУПД.ИнформацияОРешенииПриемочнойКомиссии = ИнформацияОРешенииПриемочнойКомиссии;
			
	КонецЕсли;
	
	// Иные уполномоченные лица
	// Наличие блока означает, что установлен признак "Документ подписывают иные уполномоченные лица".
	// В блоке указывается номер подписанта, который соответствует иному уполномоченному лицу,
	// информация о котором указывается в основном документе УПД (титул покупателя)
	ВыборкаИныхУполномоченныхЛиц = МассивРезультатов[3].Выбрать();
	Если ВыборкаИныхУполномоченныхЛиц.Количество() > 0 Тогда
		Пока ВыборкаИныхУполномоченныхЛиц.Следующий() Цикл
		
			СведенияОИныхУполномоченныхЛицахЗаказчика = ЭлектронноеАктированиеЕИС.НовыеСведенияОИныхУполномоченныхЛицахЗаказчика();
			ЗаполнитьЗначенияСвойств(СведенияОИныхУполномоченныхЛицахЗаказчика, ВыборкаИныхУполномоченныхЛиц);
			ДанныеПриложенияУПД.ИныеУполномоченныеЛица.Добавить(СведенияОИныхУполномоченныхЛицахЗаказчика);
					
		КонецЦикла;
				
	КонецЕсли;
	
	// Информация о прочих начислениях (пени, налоги и взносы)
	ВыборкаНеустоек = МассивРезультатов[4].Выбрать();
	Если ВыборкаНеустоек.Количество() > 0 Тогда
	
		СведенияОПрочихНачисленияхЗаказчика = ЭлектронноеАктированиеЕИС.НовыеСведенияОПрочихНачисленияхЗаказчика();
		СведенияОПрочихНачисленияхЗаказчика.ИнформацияОНачисленнойНеустойке =
			ЭлектронноеАктированиеЕИС.НовыеСведенияОНачисленныхНеустойкахЗаказчика();
		ТребованиеЗаказчикаОбУплатеНеустойки =
			СведенияОПрочихНачисленияхЗаказчика.ИнформацияОНачисленнойНеустойке.ТребованиеЗаказчикаОбУплатеНеустойки;
		
		Пока ВыборкаНеустоек.Следующий() Цикл
			
			СведенияОНачисленнойНеустойкеЗаказчика =
				ЭлектронноеАктированиеЗаказчикаЕИС.НовыеСведенияОНачисленнойНеустойкеЗаказчика();
			
			ЗаполнитьЗначенияСвойств(СведенияОНачисленнойНеустойкеЗаказчика, ВыборкаНеустоек);
			ЗаполнитьЗначенияСвойств(СведенияОНачисленнойНеустойкеЗаказчика.ПричинаНачисленияНеустойки, ВыборкаНеустоек);
			
			ТребованиеЗаказчикаОбУплатеНеустойки.Добавить(СведенияОНачисленнойНеустойкеЗаказчика);
				
		КонецЦикла;
		
		СведенияОПрочихНачисленияхЗаказчика.ИнформацияОНалогахИВзносах = Неопределено;
		
		ДанныеПриложенияУПД.ПрочиеНачисления = СведенияОПрочихНачисленияхЗаказчика;
		
	КонецЕсли;
	
	// Прикрепленные документы
	ВыборкаПрисоединенныхФайлов = МассивРезультатов[5].Выбрать();
	Если ВыборкаПрисоединенныхФайлов.Количество() > 0 Тогда
		
		ДопустимыеРасширения = ЭлектронноеАктированиеЕИС.ДопустимыеРасширенияПриложенныхФайлов();
		Пока ВыборкаПрисоединенныхФайлов.Следующий() Цикл
			Файл = ВыборкаПрисоединенныхФайлов.ПрисоединенныйФайл;
			ДанныеФайла = ЭлектронноеАктированиеЕИС.ПолучитьДанныеФайлаБСП(Файл);
			Расширение = ДанныеФайла.Расширение;
			Если ДопустимыеРасширения.Найти(Расширение) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СведенияОПрикрепленныхДокументах = ЭлектронноеАктированиеЕИС.НовыеСведенияОПрикрепленныхДокументахЗаказчика();
			СведенияОПрикрепленныхДокументах.ВнешнийУникальныйИдентификаторКонтента = Файл.УникальныйИдентификатор();
			СведенияОПрикрепленныхДокументах.ИмяФайла = ДанныеФайла.ИмяФайла;
			СведенияОПрикрепленныхДокументах.РасширениеФайла = ДанныеФайла.Расширение;
			СведенияОПрикрепленныхДокументах.ДатаВремяПрикрепленияДокумента = МестноеВремя(ДанныеФайла.ДатаМодификацииУниверсальная);
			СсылкаНаСправочникВидовДокументов = СведенияОПрикрепленныхДокументах.СсылкаНаСправочникВидовДокументов;
			СсылкаНаСправочникВидовДокументов.Код = ВыборкаПрисоединенныхФайлов.КодВида;
			СсылкаНаСправочникВидовДокументов.Наименование = ВыборкаПрисоединенныхФайлов.НаименованиеВида;
		
			ДанныеПриложенияУПД.Вложения.Добавить(СведенияОПрикрепленныхДокументах);	
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ДанныеПриложенияУПД;
	
КонецФункции

Функция ЗначениеРолиВПриемочнойКомиссии(РольВПриемочнойКомиссии)
	
	Если РольВПриемочнойКомиссии = Перечисления.РолиВПриемочнойКомиссииЕИС.ПредседательПриемочнойКомиссии Тогда
		Возврат "1";
	ИначеЕсли РольВПриемочнойКомиссии = Перечисления.РолиВПриемочнойКомиссииЕИС.ЧленПриемочнойКомиссии Тогда 
		Возврат "2";
	КонецЕсли;
	
КонецФункции

Функция ДанныеПриложенияУКДЗаказчика(РезультатыРассмотренияАктаПриемкиЕИС)
	
	СтруктураУКДЗаказчика = ЭлектронноеАктированиеЕИС.НовыеДанныеПриложенияКТитулуЗаказчикаУКД();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	РезультатыРассмотренияАктаПриемкиЕИС.ОснованиеСозданияПриемочнойКомиссии КАК ОснованиеСозданияПриемочнойКомиссии
	|ИЗ
	|	Документ.РезультатыРассмотренияАктаПриемкиЕИС КАК РезультатыРассмотренияАктаПриемкиЕИС
	|ГДЕ
	|	РезультатыРассмотренияАктаПриемкиЕИС.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РешениеЧленовПриемочнойКомиссии.НомерСтроки КАК НомерПодписанта,
	|	РешениеЧленовПриемочнойКомиссии.РольВПриемочнойКомиссии КАК РольВПриемочнойКомиссии,
	|	ПРЕДСТАВЛЕНИЕ(РешениеЧленовПриемочнойКомиссии.Подписант.ОснованиеПолномочий) КАК
	|		ОснованиеПолномочийЧленаПриемочнойКомиссии,
	|	РешениеЧленовПриемочнойКомиссии.КодРешения КАК КодРешенияЧленаПриемочнойКомиссии
	|ИЗ
	|	Документ.РезультатыРассмотренияАктаПриемкиЕИС.РешениеЧленовПриемочнойКомиссии КАК РешениеЧленовПриемочнойКомиссии
	|ГДЕ
	|	РешениеЧленовПриемочнойКомиссии.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрочиеНачисления.ТребованиеОбУплатеНеустойки КАК НаименованиеТребования,
	|	ПрочиеНачисления.НомерТребования КАК НомерТребования,
	|	ПрочиеНачисления.ДатаТребования КАК ДатаТребования,
	|	ПрочиеНачисления.ТипНеустойки КАК ТипНеустойки,
	|	ПрочиеНачисления.СуммаНеустойки КАК РазмерНеустойки,
	|	ПрочиеНачисления.КодПричины КАК КодПричины,
	|	ПрочиеНачисления.НаименованиеПричины КАК НаименованиеПричины
	|ИЗ
	|	Документ.РезультатыРассмотренияАктаПриемкиЕИС.ПрочиеНачисления КАК ПрочиеНачисления
	|ГДЕ
	|	ПрочиеНачисления.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.ПрисоединенныйФайл КАК ПрисоединенныйФайл,
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.ВидВложения.Код КАК КодВида,
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.ВидВложения.Наименование КАК НаименованиеВида
	|ИЗ
	|	РегистрСведений.ПриложенныеФайлыДляЭлектронногоАктированияЕИС КАК ПриложенныеФайлыДляЭлектронногоАктированияЕИС
	|ГДЕ
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.Документ = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", РезультатыРассмотренияАктаПриемкиЕИС);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	// Шапка документа
	ВыборкаШапки = МассивРезультатов[0].Выбрать();
	ВыборкаШапки.Следующий();
	ЗаполнитьЗначенияСвойств(СтруктураУКДЗаказчика, ВыборкаШапки);
	
	// Информация о решении приемочной комиссии
	// Наличие блока означает, что установлен признак "Для определения результатов приемки товаров, работ,
	// услуг создана приемочная комиссия"
	ВыборкаРешениеЧленовПриемочнойКомиссии = МассивРезультатов[1].Выбрать();
	Если ВыборкаРешениеЧленовПриемочнойКомиссии.Количество() > 0 Тогда
		
		ИнформацияОРешенииПриемочнойКомиссии = 
			ЭлектронноеАктированиеЕИС.НовыеСведенияИнформацииОРешенииПриемочнойКомиссииЗаказчика();
		ЗаполнитьЗначенияСвойств(ИнформацияОРешенииПриемочнойКомиссии, ВыборкаШапки);
		
		СведенияОЧленеПриемочнойКомиссии = ИнформацияОРешенииПриемочнойКомиссии.СведенияОЧленеПриемочнойКомиссии;
		
		Пока ВыборкаРешениеЧленовПриемочнойКомиссии.Следующий() Цикл
			СведенияОЧленеПриемочнойКомиссииЗаказчика = 
				ЭлектронноеАктированиеЕИС.НовыеСведенияОЧленеПриемочнойКомиссииЗаказчика();
			ЗаполнитьЗначенияСвойств(СведенияОЧленеПриемочнойКомиссииЗаказчика, ВыборкаРешениеЧленовПриемочнойКомиссии);
			
			ИнформацияОРешении = СведенияОЧленеПриемочнойКомиссииЗаказчика.ИнформацияОРешенииЧленаПриемочнойКомиссии;
			КодРешения = ВыборкаРешениеЧленовПриемочнойКомиссии.КодРешенияЧленаПриемочнойКомиссии;	
				
			ИнформацияОРешении.КодРешенияЧленаПриемочнойКомиссии = КодРешения;
			ИнформацияОРешении.РешениеЧленаПриемочнойКомиссии = 
				ЭлектронноеАктированиеЕИС.РешениеЧленаПриемочнойКомиссииЗаказчикаПоКоду(КодРешения);
			
			СведенияОЧленеПриемочнойКомиссии.Добавить(СведенияОЧленеПриемочнойКомиссииЗаказчика);	
		КонецЦикла;
		
		СтруктураУКДЗаказчика.ИнформацияОРешенииПриемочнойКомиссии = ИнформацияОРешенииПриемочнойКомиссии;
			
	КонецЕсли;
	
	// Прочие начисления
	// Блок может быть заполнен только в том случае, если функция УКД КСЧФДИС или ДИС.
	ВыборкаНеустоек = МассивРезультатов[2].Выбрать();
	Если ВыборкаНеустоек.Количество() > 0 Тогда
			
		СведенияОПрочихНачисленияхЗаказчика = ЭлектронноеАктированиеЕИС.НовыеСведенияОПрочихНачисленияхЗаказчика();
		СведенияОПрочихНачисленияхЗаказчика.ИнформацияОНачисленнойНеустойке =
			ЭлектронноеАктированиеЕИС.НовыеСведенияОНачисленныхНеустойкахЗаказчика();
		ТребованиеЗаказчикаОбУплатеНеустойки = СведенияОПрочихНачисленияхЗаказчика.ИнформацияОНачисленнойНеустойке.ТребованиеЗаказчикаОбУплатеНеустойки;
		
		Пока ВыборкаНеустоек.Следующий() Цикл
			
			СведенияОНачисленнойНеустойкеЗаказчика =
				ЭлектронноеАктированиеЗаказчикаЕИС.НовыеСведенияОНачисленнойНеустойкеЗаказчика();
			
			ЗаполнитьЗначенияСвойств(СведенияОНачисленнойНеустойкеЗаказчика, ВыборкаНеустоек);
			ЗаполнитьЗначенияСвойств(СведенияОНачисленнойНеустойкеЗаказчика.ПричинаНачисленияНеустойки, ВыборкаНеустоек);
			
			ТребованиеЗаказчикаОбУплатеНеустойки.Добавить(СведенияОНачисленнойНеустойкеЗаказчика);
				
		КонецЦикла;
		
		СведенияОПрочихНачисленияхЗаказчика.ИнформацияОНалогахИВзносах = Неопределено;
		
		СтруктураУКДЗаказчика.ПрочиеНачисления = СведенияОПрочихНачисленияхЗаказчика;
		
	КонецЕсли;
	
	// Прикрепленные документы
	ВыборкаПрисоединенныхФайлов = МассивРезультатов[3].Выбрать();
	Если ВыборкаПрисоединенныхФайлов.Количество() > 0 Тогда
		
		ДопустимыеРасширения = ЭлектронноеАктированиеЕИС.ДопустимыеРасширенияПриложенныхФайлов();
		Пока ВыборкаПрисоединенныхФайлов.Следующий() Цикл
			Файл = ВыборкаПрисоединенныхФайлов.ПрисоединенныйФайл;
			ДанныеФайла = ЭлектронноеАктированиеЕИС.ПолучитьДанныеФайлаБСП(Файл);
			Расширение = ДанныеФайла.Расширение;
			Если ДопустимыеРасширения.Найти(Расширение) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СведенияОПрикрепленныхДокументах = ЭлектронноеАктированиеЕИС.НовыеСведенияОПрикрепленныхДокументахЗаказчика();
			СведенияОПрикрепленныхДокументах.ВнешнийУникальныйИдентификаторКонтента = Файл.УникальныйИдентификатор();
			СведенияОПрикрепленныхДокументах.ИмяФайла = ДанныеФайла.ИмяФайла;
			СведенияОПрикрепленныхДокументах.РасширениеФайла = ДанныеФайла.Расширение;
			СведенияОПрикрепленныхДокументах.ДатаВремяПрикрепленияДокумента = МестноеВремя(ДанныеФайла.ДатаМодификацииУниверсальная);
			СсылкаНаСправочникВидовДокументов = СведенияОПрикрепленныхДокументах.СсылкаНаСправочникВидовДокументов;
			СсылкаНаСправочникВидовДокументов.Код = ВыборкаПрисоединенныхФайлов.КодВида;
			СсылкаНаСправочникВидовДокументов.Наименование = ВыборкаПрисоединенныхФайлов.НаименованиеВида;
		
			СтруктураУКДЗаказчика.Вложения.Добавить(СведенияОПрикрепленныхДокументах);	
		КонецЦикла;
		
	КонецЕсли;
		
	Возврат СтруктураУКДЗаказчика;
		
КонецФункции

#КонецОбласти