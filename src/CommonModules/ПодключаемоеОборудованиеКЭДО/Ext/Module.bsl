#Область ПрограммныйИнтерфейс

Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Организация = Неопределено;
	ФискализацияДоступна = Ложь;
	
	Если ТипЗнч(Форма.Объект.Ссылка) = Тип("ДокументСсылка.ЭлектронныйДокументИсходящийЭДО") Тогда
		Для Каждого Основание Из Форма.Основания Цикл
			Если ТипЗнч(Основание.Значение) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
				ФискализацияДоступна = Истина;
				Организация = Основание.Значение.Организация;
				Если Основание.Значение.СтатусФискализацииДокумента = Перечисления.СтатусФискализацииДокумента.Фискализирован Тогда
					Форма.Элементы.ПробитьЧек.Заголовок = "Чек пробит";
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ФискализацияДоступна = Истина;
		Организация = Форма.Объект.Организация;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПодключаемоеОборудование.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	               |ГДЕ
	               |	ПодключаемоеОборудование.ТипОборудования = ЗНАЧЕНИЕ(Перечисление.ТипыПодключаемогоОборудования.ОблачнаяККТ)
	               |	И ПодключаемоеОборудование.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() ИЛИ НЕ ФискализацияДоступна Тогда
		Если Не ТипЗнч(Форма.Объект.Ссылка) = Тип("ДокументСсылка.ЭлектронныйДокументИсходящийЭДО") Тогда
			Форма.Элементы.СтраницаРеквизитыЧека.Видимость = Ложь;
		Иначе
			Если Форма.Элементы.Найти("ПробитьЧек") <> Неопределено Тогда
				Форма.Элементы.ПробитьЧек.Видимость = Ложь;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ВыборкаИзЗапроса = РезультатЗапроса.Выбрать();
		ВыборкаИзЗапроса.Следующий();
		Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "Устройство") Тогда
			ДобавляемыеРеквизиты = Новый Массив;
			Реквизит = Новый РеквизитФормы(
				"Устройство",
				Новый ОписаниеТипов("СправочникСсылка.ПодключаемоеОборудование"),,
				"Устройство");
			ДобавляемыеРеквизиты.Добавить(Реквизит);
			Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты)
		КонецЕсли;
		Форма.Устройство = ВыборкаИзЗапроса.Ссылка;
		Если Не ТипЗнч(Форма.Объект.Ссылка) = Тип("ДокументСсылка.ЭлектронныйДокументИсходящийЭДО") Тогда
			Форма.Объект.СистемаНалогообложения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Форма.Объект.Организация, "СистемаНалогообложения");
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ПриЧтенииНаСервере(Форма, ТекущийОбъект) Экспорт
	
	Если Форма.ИмяФормы = "Документ.ЭлектронныйДокументИсходящийЭДО.Форма.ФормаПросмотраЛегкийКлиентЭДО" Тогда
		
		Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "Устройство") Тогда
			ДобавляемыеРеквизиты = Новый Массив;
			Реквизит = Новый РеквизитФормы(
				"Устройство",
				Новый ОписаниеТипов("СправочникСсылка.ПодключаемоеОборудование"),,
				"Устройство");
			ДобавляемыеРеквизиты.Добавить(Реквизит);
			Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		КонецЕсли;
		
		Если Форма.Элементы.Найти("ГруппаФискализация") = Неопределено Тогда
		
			ГруппаФормы = Форма.Элементы.Вставить(
				"ГруппаФискализация",
				Тип("ГруппаФормы"),
				Форма.Элементы.ГруппаКомандыОсновные,
				Форма.Элементы.ГруппаКомандыРаспечататьВыгрузить);
			ГруппаФормы.Вид = ВидГруппыФормы.ГруппаКнопок;
		
		КонецЕсли;
		
		Если Форма.Элементы.Найти("ПробитьЧек") = Неопределено Тогда
			
			КомандаФормы = Форма.Команды.Добавить("ПробитьЧекЭлектронныйДокументИсходящий");
			КомандаФормы.Действие  = "Подключаемый_ВыполнитьПереопределяемуюКоманду";
			КомандаФормы.Заголовок = Нстр("ru = 'Пробить чек'");
			
			Кнопка = Форма.Элементы.Добавить("ПробитьЧек",
				Тип("КнопкаФормы"),
				ГруппаФормы);
				Кнопка.ИмяКоманды = КомандаФормы.Имя;
				Кнопка.Отображение = ОтображениеКнопки.Текст;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриОпределенииВидовПодключаемыхКоманд(ВидыПодключаемыхКоманд) Экспорт
	
	Вид = ВидыПодключаемыхКоманд.Добавить();
	Вид.Имя = "ГруппаКомандБПО";
	Вид.ИмяПодменю = "ПодменюБПО";
	Вид.Заголовок = НСтр("ru = 'ПодключаемоеОборудование'");
	Вид.Картинка = Новый Картинка;
	Вид.Отображение = ОтображениеКнопки.Текст;
	
КонецПроцедуры

// (См. ПодключаемыеКомандыПереопределяемый.ПриОпределенииКомандПодключенныхКОбъекту)
//
Процедура ПриОпределенииКомандПодключенныхКОбъекту(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды) Экспорт
	
	Если НастройкиФормы.ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокументаЛегкийИнтерфейс" Тогда
		Команда = Команды.Добавить();
		Команда.Вид = "ГруппаКомандБПО";
		Команда.Идентификатор = "ПробитьЧекРеализации";
		Команда.Представление = НСтр("ru = 'Пробить чек'");
		Команда.Важность = "Обычное";
		Команда.Порядок = 1;
		Команда.ОтображениеКнопки = ОтображениеКнопки.Текст;
		Команда.ИзменяетВыбранныеОбъекты = Истина;
		Команда.РежимЗаписи = "Проводить";
		Команда.Обработчик = "ПодключаемоеОборудованиеКЭДОКлиент.ПробитьЧекПодключаемый";
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеДляФискализацииДокумента(ПараметрыФискализации) Экспорт
	
	Отказ = Ложь;
	Если ИнтеграцияИСМПКлиентСерверПовтИсп.ВестиУчетМаркируемойПродукции() Тогда
		ИнтеграцияИСКЭДО.ПроверитьЗаполнениеАкцизныхМарокПоСсылкам(ПараметрыФискализации.ДокументОснование, Отказ, , Истина);
	КонецЕсли; 
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗаписатьДокументРеализации(ПараметрыФискализации.ДокументОснование, ПредопределенноеЗначение("Перечисление.СтатусФискализацииДокумента.Фискализируется"), ПараметрыФискализации);
	ОбщиеПараметры = Документы.РеализацияТоваровУслуг.ПодготовитьДанныеДляПробитияЧека(ПараметрыФискализации.ДокументОснование);
	
	Возврат ОбщиеПараметры;
	
КонецФункции 

Функция ФискализироватьЧекВОблаке(ПараметрыФискализации) Экспорт
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ПараметрыФискализации.УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Фискализация чека в сервисе.'");
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ДокументОснование", ПараметрыФискализации.ДокументОснование);
	ПараметрыПроцедуры.Вставить("ПараметрыОперации", ПараметрыФискализации.ПараметрыОперации); 
	ПараметрыПроцедуры.Вставить("ИдентификаторУстройства", ПараметрыФискализации.ИдентификаторУстройства);
	
	РезультатВыполнения = ДлительныеОперации.ВыполнитьВФоне(
		"ПодключаемоеОборудованиеКЭДО.ФискализироватьЧек",
		ПараметрыПроцедуры,
		ПараметрыВыполнения);
		
	Возврат РезультатВыполнения;
	
КонецФункции

Процедура ФискализироватьЧек(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	СтатусПробитияЧека = ОборудованиеЧекопечатающиеОблачныеККТ.ФискализацияЧека(ПараметрыПроцедуры.ДокументОснование, ПараметрыПроцедуры.ИдентификаторУстройства, ПараметрыПроцедуры.ПараметрыОперации);
	Если СтатусПробитияЧека.ДанныеОперации.СтатусОперации = "Выполнена" ИЛИ СтатусПробитияЧека.ДанныеОперации.СтатусОперации = "Ошибка" Тогда
		РезультатВыполнения = ОборудованиеЧекопечатающиеОблачныеККТ.РезультатВыполненияОперации(СтатусПробитияЧека, ПараметрыПроцедуры);
		ЗаписатьДокументРеализации(ПараметрыПроцедуры.ДокументОснование);
		ПоместитьВоВременноеХранилище(РезультатВыполнения, АдресРезультата);
	Иначе 
		ПолучитьСтатусЧекаВОблаке(ПараметрыПроцедуры, АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьСтатусЧекаВОблаке(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	СтатусПробитияЧека = ОборудованиеЧекопечатающиеОблачныеККТ.СтатусПробитияЧека(ПараметрыПроцедуры.ДокументОснование);
	Если СтатусПробитияЧека.ДанныеОперации.СтатусОперации = "Выполнена" ИЛИ СтатусПробитияЧека.ДанныеОперации.СтатусОперации = "Ошибка" Тогда
		РезультатВыполнения = ОборудованиеЧекопечатающиеОблачныеККТ.РезультатВыполненияОперации(СтатусПробитияЧека, ПараметрыПроцедуры); 
		ЗаписатьДокументРеализации(ПараметрыПроцедуры.ДокументОснование);
		ПоместитьВоВременноеХранилище(РезультатВыполнения, АдресРезультата);
	Иначе 
		ПолучитьСтатусЧекаВОблаке(ПараметрыПроцедуры, АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаписатьДокументРеализации(Документ, СтатусФискализации = Неопределено, ПараметрыФискализации = Неопределено) Экспорт
	
	Результат = Ложь;
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		СсылкаДокумента = Документ;
	Иначе
		СсылкаДокумента = Документ.Ссылка;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных();
	
	ЭлементБлокировки = Блокировка.Добавить(Метаданные.Документы.РеализацияТоваровУслуг.ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("Ссылка", СсылкаДокумента);
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка.Заблокировать();
		
		ДокументОбъект = Документ.ПолучитьОбъект();
		
		Если СтатусФискализации = Неопределено Тогда
			ДокументОбъект.СтатусФискализацииДокумента = Перечисления.СтатусФискализацииДокумента.Фискализирован;
		Иначе
			ДокументОбъект.СтатусФискализацииДокумента = СтатусФискализации;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыФискализации) И ПараметрыФискализации.Свойство("СостояниеДокументаОснования") Тогда
			СостояниеДокументаОснования = ПараметрыФискализации.СостояниеДокументаОснования;
			ДокументОбъект.АдресЭП = СостояниеДокументаОснования.АдресЭП;
			ДокументОбъект.Телефон = СостояниеДокументаОснования.Телефон;
			ДокументОбъект.СистемаНалогообложения = СостояниеДокументаОснования.СистемаНалогообложения;
		КонецЕсли;
		
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Результат = Истина;
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ЗаписьЖурналаРегистрации(
		НСтр("ru = 'При формировании данных чек возникла ошибка.'"),
		УровеньЖурналаРегистрации.Ошибка,,,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
		ОтменитьТранзакцию();
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьОптовыеЦеныНоменклатурыПриЗаписи(Источник, Отказ) Экспорт
	
	СтатусДокумента = ЭлектронныеДокументыЭДО.СостояниеДокумента(Источник.Ссылка);
	
	Если СтатусДокумента = Перечисления.СостоянияДокументовЭДО.ОбменЗавершен Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
		|	РеализацияТоваровУслугТовары.Характеристика,
		|	РеализацияТоваровУслугТовары.Цена
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
		|		ПО (РеализацияТоваровУслугТовары.Номенклатура = СпрНоменклатура.Ссылка)
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаПоРезультатамЗапроса = РезультатЗапроса.Выбрать();
		Пока ВыборкаПоРезультатамЗапроса.Следующий() Цикл
			Номенклатура = ВыборкаПоРезультатамЗапроса.Номенклатура.ПолучитьОбъект();
			Номенклатура.ЦенаОптовая = ВыборкаПоРезультатамЗапроса.Цена;
			Номенклатура.Записать();  
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция СостояниеДокументаОснования(СсылкаОснования) Экспорт
	
	Результат = Новый Структура;
	ТребуетсяЗаполнениеРеквизитовДокумента = Ложь;
	ДокументОснованиеФискализирован = Ложь;
	
	СведенияОбЭлектронномДокументе = ОбменСКонтрагентами.СведенияОбЭлектронномДокументе(СсылкаОснования);
	Для Каждого ДокументУчета Из СведенияОбЭлектронномДокументе.ОбъектыУчета Цикл
		Если ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			РеализацияОснованиеУПД = ДокументУчета;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(РеализацияОснованиеУПД.СистемаНалогообложения)
		ИЛИ (НЕ ЗначениеЗаполнено(РеализацияОснованиеУПД.АдресЭП)
		И НЕ ЗначениеЗаполнено(РеализацияОснованиеУПД.Телефон)) Тогда
		ТребуетсяЗаполнениеРеквизитовДокумента = Истина;
	КонецЕсли;
	
	Если РеализацияОснованиеУПД.СтатусФискализацииДокумента = Перечисления.СтатусФискализацииДокумента.Фискализирован Тогда
		ДокументОснованиеФискализирован = Истина;;
	КонецЕсли;
	
	Результат.Вставить("ДокументОснованиеФискализирован", ДокументОснованиеФискализирован);
	Результат.Вставить("ТребуетсяЗаполнениеРеквизитовДокумента", ТребуетсяЗаполнениеРеквизитовДокумента);
	Результат.Вставить("СистемаНалогообложения", РеализацияОснованиеУПД.СистемаНалогообложения);
	Результат.Вставить("АдресЭП", РеализацияОснованиеУПД.АдресЭП);
	Результат.Вставить("Телефон", РеализацияОснованиеУПД.Телефон);
	Результат.Вставить("РеализацияОснованиеУПД", РеализацияОснованиеУПД);
	
	Возврат Результат;
	
КонецФункции

#Область ПечатьЭтикеток
Процедура ПечатьЭтикетокИСМП(ТаблицаДляПечати, ТабличныйДокумент, СтруктураНастроек, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Шаблоны = "ШаблонЭтикетки";
	ШаблоныДляПечати = ТаблицаДляПечати.Скопировать(, Шаблоны);
	
	СоответствиеПолейИШаблонов = Обработки.ПечатьЭтикетокИЦенниковБПО.ПоляШаблонов(ШаблоныДляПечати);
	
	НастройкиПечати = Новый Структура;
	НастройкиПечати.Вставить("ИсходныеДанные", Неопределено); // Таблица с произвольными данными.
	НастройкиПечати.Вставить("ОбязательныеПоля", Новый Массив);
	НастройкиПечати.Вставить("СоответствиеШаблоновИСтруктурыШаблонов" , Новый Соответствие);
	НастройкиПечати.Вставить("ПараметрыДанных", Новый Структура);
	НастройкиПечати.Вставить("КомпоновщикНастроек", Неопределено); // Отбор
	НастройкиПечати.Вставить("ИмяМакетаСхемыКомпоновкиДанных" , Неопределено);
	
	НастройкиПечати.ОбязательныеПоля.Добавить("КоличествоЦенниковДляПечати");
	НастройкиПечати.ОбязательныеПоля.Добавить("КоличествоЭтикетокДляПечати");
	НастройкиПечати.ОбязательныеПоля.Добавить("ШаблонЦенникаДляПечати");
	НастройкиПечати.ОбязательныеПоля.Добавить("ШаблонЭтикеткиДляПечати");
	НастройкиПечати.ОбязательныеПоля.Добавить("Номенклатура");
	
	ТипСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200));
	ИсходныеДанные = Новый ТаблицаЗначений();
	ТаблицаЗначенийТоваров(Ложь, ИсходныеДанные);
	ИсходныеДанные.Колонки.Добавить("Штрихкод", ТипСтрока);
	ИсходныеДанные.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ИсходныеДанные.Колонки.Добавить("КоличествоПечать", ОбщегоНазначения.ОписаниеТипаЧисло(10));
	ИсходныеДанные.Колонки.Добавить("ПредставлениеНоменклатуры", ОбщегоНазначения.ОписаниеТипаСтрока(255));
	
	Для Каждого Товар Из ТаблицаДляПечати Цикл
		Строка = ИсходныеДанные.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Товар); 
	КонецЦикла;
	
	НастройкиПечати.ИсходныеДанные = ИсходныеДанные;
	ДанныеНоменклатурыДляФормированияПечатныхФорм = Новый Массив;
	
	Если Не СтруктураНастроек.Свойство("ВариантПечати") Тогда
		СтруктураНастроек.Вставить("ВариантПечати", 0);
	КонецЕсли;
	
	Если СтруктураНастроек.ВариантПечати = 0 Тогда
		
		Для Каждого Шаблон Из СоответствиеПолейИШаблонов Цикл;
			
			ШаблонМакета = Шаблон.Ключ;
			СписокПолей = Шаблон.Значение;
			
			ДобавленныеПоля = Новый Массив;
			Для Каждого Поле Из СписокПолей Цикл
				Если Не ЗначениеЗаполнено(ДобавленныеПоля.Найти(Поле.Значение)) Тогда
					НастройкиПечати.ОбязательныеПоля.Добавить(Поле);
					ДобавленныеПоля.Добавить(Поле.Значение);
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
		Для Каждого ОбязательноеПоле Из НастройкиПечати.ОбязательныеПоля Цикл
			
			Если ТипЗнч(ОбязательноеПоле) = Тип("Структура") Тогда
				СтрокаПоиска = ОбязательноеПоле.Значение;
				СтрокаПоиска = СтрЗаменить(СтрокаПоиска, ".", "");
				СтрокаПоиска = СтрЗаменить(СтрокаПоиска, "[", ""); 
				СтрокаПоиска = СтрЗаменить(СтрокаПоиска, "]", "");
				СтрокаПоиска = СтрЗаменить(СтрокаПоиска, " ", "");
				СтрокаПоиска = СтрЗаменить(СтрокаПоиска, "%", "_");
				СтрокаПоиска = СтрЗаменить(СтрокаПоиска, ",", "_");
				СтрокаПоиска = СтрЗаменить(СтрокаПоиска, "(", "_");
				СтрокаПоиска = СтрЗаменить(СтрокаПоиска, ")", "_");
				СтрокаПоиска = СтрЗаменить(СтрокаПоиска, """", "_");
				Колонка = ИсходныеДанные.Колонки.Найти(СтрокаПоиска);
				Если Колонка = Неопределено Тогда
					Продолжить;
				Иначе
					Колонка.Заголовок = ОбязательноеПоле.Наименование;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого ПозицияПечати Из ИсходныеДанные Цикл 
			
			ТаблицаДанных = ИсходныеДанные.СкопироватьКолонки();
			СтрокаТаблицыДанных = ТаблицаДанных.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыДанных, ПозицияПечати);
			
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("Шаблон", ПозицияПечати.ШаблонЭтикетки);
			СтруктураДанных.Вставить("ТаблицаНоменклатуры", ТаблицаДанных);
			ДанныеНоменклатурыДляФормированияПечатныхФорм.Добавить(СтруктураДанных)
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Шаблон Из СоответствиеПолейИШаблонов Цикл;
			
			ШаблонМакета = Шаблон.Ключ;
			СписокПолей = Шаблон.Значение;
			
			ДобавленныеПоля = Новый Массив;
			СтруктураШаблона = Новый Структура;
			СтруктураШаблона.Вставить("Шаблон", ШаблонМакета);
			СтруктураШаблона.Вставить("ИмяКолонкиШаблон", "ШаблонЭтикетки");
			//НастройкиПечати.ИмяМакетаСхемыКомпоновкиДанных = МакетСхемыКомпоновкиДанных(ШаблонМакета.ТипЦенника);
			// Заполняем коллекцию обязательных полей и формируем соответствие шаблонов.
			Для Каждого Поле Из СписокПолей Цикл
				Если Не ЗначениеЗаполнено(ДобавленныеПоля.Найти(Поле.Значение)) Тогда
					НастройкиПечати.ОбязательныеПоля.Добавить(Поле);
					ДобавленныеПоля.Добавить(Поле.Значение);
				КонецЕсли;
			КонецЦикла;
			
			ТаблицаДанных = ПодготовитьДанныеДляПечати(НастройкиПечати, СтруктураШаблона);
			
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("Шаблон", ШаблонМакета);
			СтруктураДанных.Вставить("ТаблицаНоменклатуры", ТаблицаДанных.ТаблицаТоваров);
			ДанныеНоменклатурыДляФормированияПечатныхФорм.Добавить(СтруктураДанных);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ДанныеПечатныхФорм = Обработки.ПечатьЭтикетокИЦенниковБПО.ДанныеДляПечатиЭтикеток(ДанныеНоменклатурыДляФормированияПечатныхФорм, СоответствиеПолейИШаблонов);
	Обработки.ПечатьЭтикетокИЦенниковБПО.ВывестиТабличныеДокументыНаПечать(ДанныеПечатныхФорм, СтруктураНастроек, ТабличныйДокумент);
	
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции
Функция ПодготовитьДанныеДляПечати(НастройкиПечати, ОписаниеШаблона = Неопределено) Экспорт
	
	ТаблицаИсходныеДанные = НастройкиПечати.ИсходныеДанные;
	Результат = Новый Структура;
	СтруктураОтбора = Новый Структура;
	ИмяКолонки = СтрЗаменить(ОписаниеШаблона.ИмяКолонкиШаблон, "ДляПечати", "");
	СтруктураОтбора.Вставить(ИмяКолонки, ОписаниеШаблона.Шаблон);
	ТаблицаИсходныеДанные = НастройкиПечати.ИсходныеДанные.Скопировать(СтруктураОтбора);
	
	Результат.Вставить("ТаблицаТоваров" , ТаблицаИсходныеДанные);  
	Для Каждого ОбязательноеПоле Из НастройкиПечати.ОбязательныеПоля Цикл
		
		Если ТипЗнч(ОбязательноеПоле) = Тип("Структура") Тогда
			СтрокаПоиска = ОбязательноеПоле.Значение;
			СтрокаПоиска = СтрЗаменить(СтрокаПоиска, ".", "");
			СтрокаПоиска = СтрЗаменить(СтрокаПоиска, "[", ""); 
			СтрокаПоиска = СтрЗаменить(СтрокаПоиска, "]", "");
			СтрокаПоиска = СтрЗаменить(СтрокаПоиска, " ", "");
			СтрокаПоиска = СтрЗаменить(СтрокаПоиска, "%", "_");
			СтрокаПоиска = СтрЗаменить(СтрокаПоиска, ",", "_");
			СтрокаПоиска = СтрЗаменить(СтрокаПоиска, "(", "_");
			СтрокаПоиска = СтрЗаменить(СтрокаПоиска, ")", "_");
			СтрокаПоиска = СтрЗаменить(СтрокаПоиска, """", "_");
			Колонка = ТаблицаИсходныеДанные.Колонки.Найти(СтрокаПоиска);
			Если Колонка = Неопределено Тогда
				Продолжить;
			Иначе
				Колонка.Заголовок = ОбязательноеПоле.Наименование;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.Вставить("ТаблицаТоваров" , ТаблицаИсходныеДанные);
	Возврат Результат;
	
КонецФункции

// Функция формирует незаполненную структуру результатов.
//
Функция НовыйРезультатДанныеДляПечати() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ТаблицаТоваров" , Неопределено);
	Результат.Вставить("СоответствиеПолейСКДКолонкамТаблицыТоваров", Новый Соответствие);
	
	Возврат Результат;
	
КонецФункции

// Возвращает Макет стандартный схемы компоновки данных для обработки и печати данных.
//  Параметры:
//   ТипЦенника - Строка
// 
// Возвращаемое значение:
//  СхемаКомпоновкиДанных.
Функция МакетСхемыКомпоновкиДанных(ТипЦенника = "") Экспорт
	
	Возврат Справочники.ШаблоныЭтикетокИЦенниковБПО.ПолучитьМакет("ПоляШаблонаИСМПТаблицаПечати");
	
КонецФункции

Функция НайтиПолеСКДПоПолномуИмени(Элементы, ПолноеИмя, Кэш = Неопределено) Экспорт
	
	Если Кэш <> Неопределено Тогда
		Поле = Кэш.Получить(ПолноеИмя);
		Если Поле <> Неопределено Тогда
			Возврат Поле;
		КонецЕсли;
	КонецЕсли;
	
	МассивЧастейИмен = ИзПолногоИмениПоляПолучитьЧасти(ПолноеИмя);
	КоличествоЧастей = МассивЧастейИмен.Количество();
	
	ТекущееИмя = МассивЧастейИмен[0];
	Поле = НайтиПолеСКДПоИмени(Элементы, ТекущееИмя, Кэш);
	Если Поле = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Сч = 2 По КоличествоЧастей Цикл
		ТекущееИмя = ТекущееИмя +"." + МассивЧастейИмен[Сч-1];
		Поле = НайтиПолеСКДПоИмени(Поле.Элементы, ТекущееИмя, Кэш);
		Если Поле = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	Если Кэш <> Неопределено Тогда
		Кэш.Вставить(ПолноеИмя, Поле);
	КонецЕсли;
	
	Возврат Поле;
	
КонецФункции

// Находит среди элементов полей СКД поле по имени.
//
// Параметры:
//  Элементы - ПолеКомпоновкиДанных - поля СКД.
//  Имя - Строка - имя поля СКД.
//  Кэш - Соответствие - соответствие полей и наименований СКД.
//
// Возвращаемое значение:
//  ПолеКомпоновкиДанных - поле СКД по полному имени.
//
Функция НайтиПолеСКДПоИмени(Элементы, Имя, Кэш = Неопределено) Экспорт
	
	Если Кэш <> Неопределено Тогда
		Элемент = Кэш.Получить(Имя);
		Если Элемент <> Неопределено Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Элементы.Найти(Имя);
	
КонецФункции

// Получает полное имя поля по частям.
//
// Параметры:
//	ПолноеИмя - полное имя поля СКД.
//
// Возвращаемое значение:
//	МассивЧастей - массив, содержащий части полного имени.
//
Функция ИзПолногоИмениПоляПолучитьЧасти(ПолноеИмя)

	МассивЧастей = Новый Массив;
	ИмяДляОбработки = ПолноеИмя;
	
	Пока НЕ ПустаяСтрока(ИмяДляОбработки) Цикл
		Если Лев(ИмяДляОбработки, 1) = "[" Тогда
			
			Позиция = Найти(ИмяДляОбработки, "]");
			Если Позиция = 0 Тогда
				МассивЧастей.Добавить(Сред(ИмяДляОбработки, 2));
				ИмяДляОбработки = "";
			Иначе
				МассивЧастей.Добавить(Сред(ИмяДляОбработки, 1, Позиция));
				ИмяДляОбработки = Сред(ИмяДляОбработки, Позиция + 2);
			КонецЕсли;
			
		Иначе
			
			Позиция = Найти(ИмяДляОбработки, ".");
			Если Позиция = 0 Тогда
				МассивЧастей.Добавить(ИмяДляОбработки);
				ИмяДляОбработки = "";
			Иначе
				МассивЧастей.Добавить(Лев(ИмяДляОбработки, Позиция - 1));
				ИмяДляОбработки = Сред(ИмяДляОбработки, Позиция + 1);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивЧастей;

КонецФункции 

Процедура СкопироватьЭлементыОтбора(ПриемникЗначения, ИсточникЗначения, ПроверятьДоступность = Ложь, ОчищатьПриемник = Истина) Экспорт
	
	ПриемникЭлементов = ПриемникЗначения.Элементы;
	ИсточникЭлементов = ИсточникЗначения.Элементы;
	Если ОчищатьПриемник Тогда
		ПриемникЭлементов.Очистить();
	КонецЕсли;
	
	Для каждого ЭлементИсточник Из ИсточникЭлементов Цикл
		
		ЭлементПриемник = ПриемникЭлементов.Добавить(ТипЗнч(ЭлементИсточник));
		ЗаполнитьЗначенияСвойств(ЭлементПриемник, ЭлементИсточник);
		
		// В некоторых элементах коллекции необходимо заполнить другие коллекции.
		Если ТипЗнч(ЭлементИсточник) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			СкопироватьЭлементыОтбора(ЭлементПриемник, ЭлементИсточник);
		КонецЕсли
		
	КонецЦикла;
	
КонецПроцедуры

// Дополняет колонки таблицы значений товаров при необходимости
//
// Параметры:
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//  ТаблицаЗначенийТоваров - ТаблицаЗначений - шаблон таблицы значений с колонками.
//
Процедура ТаблицаЗначенийТоваров(СтандартнаяОбработка, ТаблицаЗначенийТоваров) Экспорт
	
	ТипСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200));
	
	ТаблицаЗначенийТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаЗначенийТоваров.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаЗначенийТоваров.Колонки.Добавить("ВидПродукции", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыПродукцииИС"));
	ТаблицаЗначенийТоваров.Колонки.Добавить("КодМаркировки", Новый ОписаниеТипов(ТипСтрока));
	ТаблицаЗначенийТоваров.Колонки.Добавить("КодУпаковки", Новый ОписаниеТипов(ТипСтрока));
	ТаблицаЗначенийТоваров.Колонки.Добавить("МаркировкаОстатков", Новый ОписаниеТипов(ТипСтрока));
	ТаблицаЗначенийТоваров.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаЗначенийТоваров.Колонки.Добавить("НомерВГруппе", Новый ОписаниеТипов(ТипСтрока));
	ТаблицаЗначенийТоваров.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	ТаблицаЗначенийТоваров.Колонки.Добавить("ПолныйКодМаркировки", Новый ОписаниеТипов(ТипСтрока));
	ТаблицаЗначенийТоваров.Колонки.Добавить("ПолныйКодУпаковки", Новый ОписаниеТипов(ТипСтрока));
