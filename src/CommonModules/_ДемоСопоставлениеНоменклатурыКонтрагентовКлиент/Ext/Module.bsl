
#Область ПрограммныйИнтерфейс

// см. СопоставлениеНоменклатурыКонтрагентовКлиентПереопределяемый.ПриОпределенииНастроекСопоставленияНоменклатуры
Процедура ПриОпределенииНастроекСопоставленияНоменклатуры(НастройкиСопоставления) Экспорт
	
	ВедетсяУчетОсновныхСредств = _ДемоСопоставлениеНоменклатурыКонтрагентовВызовСервера.ВедетсяУчетОсновныхСредств();
	НастройкиСопоставления.ОрганизацияВидимость = ВедетсяУчетОсновныхСредств;
	НастройкиСопоставления.ДоговорВидимость     = ВедетсяУчетОсновныхСредств;
	
КонецПроцедуры

#Область ЗагрузкаЭД

// Выполняет загрузку данных из файла
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, из которой была вызвана команда.
//
Процедура ЗагрузитьОтчетКомиссионераИзФайла(Форма) Экспорт

	ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьЗагрузкуОтчетаМаркетплейсаИзФайла", ЭтотОбъект, 
		Новый Структура("Форма", Форма));	
		
	ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботыСФайлами(ОписаниеОповещения);

КонецПроцедуры

Процедура СкачатьОтчетКомиссионераИзФайла() Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьСкачиваниеОтчетаМаркетплейсаВФайл", ЭтотОбъект);	
	ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботыСФайлами(ОписаниеОповещения);
	
КонецПроцедуры

#КонецОбласти

Процедура ПрочитатьЗагруженныеФайлыВСтруктуру(ЗагруженныеФайлы, ДополнительныеПараметры) Экспорт 
	
	Если ЗагруженныеФайлы <> Неопределено Тогда
		
		ОписаниеФайлов = ЗагруженныеФайлы[0];
		АдресФайла     = ОписаниеФайлов.Адрес;
		РасширениеФайла = ОписаниеФайлов.СсылкаНаФайл.Расширение;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Форма      = ДополнительныеПараметры.Форма;
	
	Результат = _ДемоСопоставлениеНоменклатурыКонтрагентовВызовСервера.ОбработатьТабличныйДокументВСтруктуруСервер(АдресФайла, РасширениеФайла, Форма.УникальныйИдентификатор);
	Статус = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "Статус");
	
	Если Статус <> "Выполнено" Тогда
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Форма);
		ПараметрыОжидания.Вставить("ИдентификаторЗадания", Результат.ИдентификаторЗадания);
		
		ПараметрыОповещения = Новый Структура("АдресХранилища, УникальныйИдентификатор", 
			Результат.АдресРезультата, Форма.УникальныйИдентификатор);
		ДлительнаяОперацияЗавершение = Новый ОписаниеОповещения("ПрочитатьЗагруженныеФайлыВСтруктуруЗавершение", 
			ЭтотОбъект, ПараметрыОповещения);

		ДлительныеОперацииКлиент.ОжидатьЗавершение(Результат, ДлительнаяОперацияЗавершение, ПараметрыОжидания);

	Иначе
		НачатьЗагрузкуИзСтруктуры(Результат.АдресРезультата, Форма.УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьЗагруженныеФайлыВСтруктуруЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Статус = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "Статус");
	Если Статус = "Выполнено" Тогда
		НачатьЗагрузкуИзСтруктуры(ДополнительныеПараметры.АдресХранилища, 
			ДополнительныеПараметры.УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

#Область СозданиеПоступленияИзЭД

Процедура НачатьЗагрузкуИзСтруктуры(АдресХранилища, ИдентификаторФормы) Экспорт
	
	ДанныеЭД = _ДемоСопоставлениеНоменклатурыКонтрагентовВызовСервера.РазобратьПолученныеДанныеДокументИзСтруктуры(АдресХранилища, ИдентификаторФормы);
	Если ДанныеЭД.Свойство("ТекстОшибки") Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ДанныеЭД.ТекстОшибки;		
		Сообщение.ИдентификаторНазначения = ИдентификаторФормы;
		Сообщение.Сообщить();
		Возврат;
		
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("АдресХранилища", АдресХранилища);
	ДополнительныеПараметры.Вставить("ИдентификаторФормы", ИдентификаторФормы);
	ДополнительныеПараметры.Вставить("ДанныеЭД", ДанныеЭД);
	
	Если ДанныеЭД.Свойство("НастройкиСопоставления") Тогда
		ДополнительныеПараметры.Вставить("НастройкиСопоставления", ДанныеЭД.НастройкиСопоставления);		
	КонецЕсли;
	
	ТребуетЗаполненияПолучателя = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЭД, 
		"ТребуетЗаполненияПолучателя", Ложь);
	
	Если ТребуетЗаполненияПолучателя Тогда
		ОрганизацияПоУмолчанию = _ДемоСопоставлениеНоменклатурыКонтрагентовВызовСервера.ОрганизацияПоУмолчанию();
		Если ОрганизацияПоУмолчанию.Пустая() Тогда 
			Обработчик = Новый ОписаниеОповещения("ДополнитьДанныеДокументаИзСтруктурыИнтерактивно", ЭтотОбъект, ДополнительныеПараметры);
			ПоказатьВводЗначения(Обработчик, , НСтр("ru = 'Укажите организацию'"), Тип("СправочникСсылка.Организации"));
		Иначе
			ДополнитьДанныеДокументаИзСтруктурыИнтерактивно(ОрганизацияПоУмолчанию,
				ДополнительныеПараметры);
		КонецЕсли;
	Иначе
		НачатьСопоставлениеНоменклатуры(ДополнительныеПараметры);
	КонецЕсли;
		
КонецПроцедуры

Процедура ДополнитьДанныеДокументаИзСтруктурыИнтерактивно(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		_ДемоСопоставлениеНоменклатурыКонтрагентовВызовСервера.ДобавитьПолучателяВСтруктуру(Результат, ДополнительныеПараметры.АдресХранилища); 
	КонецЕсли;
	
	НачатьСопоставлениеНоменклатуры(ДополнительныеПараметры);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область КонвертацияФайлаВФорматФНС

Процедура ПродолжитьЗагрузкуОтчетаМаркетплейсаИзФайла(РасширениеПодключено, ДополнительныеПараметры) Экспорт
	
	Если РасширениеПодключено = Истина Тогда
		
		Заголовок = НСтр("ru='Выберите файл детализации отчета о продажах'");
		Фильтр    = "(*.xlsx;*.xls;*.mxl;*.zip)|*.xlsx;*.xls;*.mxl;*.zip";
		ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов(Заголовок, Ложь, Фильтр);
		
		Форма = ДополнительныеПараметры.Форма;
		ОписаниеОповещения = Новый ОписаниеОповещения("ПрочитатьЗагруженныеФайлыВСтруктуру", ЭтотОбъект, 
			Новый Структура("Форма", Форма));
		НачатьПомещениеФайловНаСервер(ОписаниеОповещения,,, ПараметрыДиалога, Форма.УникальныйИдентификатор);
		
	Иначе 
		
		ТекстСообщения = НСтр("ru='Расширение для работы с файлами в веб-клиенте не подключено, загрузка документа остановлена.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);

	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Процедура ПродолжитьСкачиваниеОтчетаМаркетплейсаВФайл(РасширениеПодключено, ДополнительныеПараметры) Экспорт
	
	Если РасширениеПодключено = Истина Тогда
		
		Адрес = _ДемоСопоставлениеНоменклатурыКонтрагентовВызовСервера.ОтчетаМаркетплейсаВХранилище();
		
		ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
		ПараметрыСохранения.Диалог.Фильтр = ДополнительныеОтчетыИОбработкиКлиентСервер.ФильтрДиалоговВыбораИСохранения();
		ПараметрыСохранения.Диалог.Заголовок = НСтр("ru = 'Сохранение'");
		ПараметрыСохранения.Диалог.Фильтр = "(*.xlsx)|*.xlsx";
		
		ИмяФайла = НСтр("ru='Отчет маркетплейса'");
		
		ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, Адрес, ИмяФайла, ПараметрыСохранения);
		
	Иначе 
		
		ТекстСообщения = НСтр("ru='Расширение для работы с файлами в веб-клиенте не подключено.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);

	КонецЕсли;
	
КонецПроцедуры

#Область СозданиеПоступленияИзЭД

Процедура НачатьСопоставлениеНоменклатуры(ДополнительныеПараметры)
	
	НастройкиСопоставления = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры,
		"НастройкиСопоставления");
	
	СписокНеСопоставленнойНоменклатуры = _ДемоСопоставлениеНоменклатурыКонтрагентовВызовСервера.СписокНеСопоставленнойНоменклатурыПоСтруктуре(
		ДополнительныеПараметры.АдресХранилища, ДополнительныеПараметры.ИдентификаторФормы);
	НеСопоставлено = СписокНеСопоставленнойНоменклатуры.Количество();
	
	Если НеСопоставлено > 0 И ДополнительныеПараметры.Свойство("НеСопоставлено") Тогда
		ОчиститьСообщения();
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Создание документа невозможно: номенклатура не сопоставлена'"));
	ИначеЕсли НеСопоставлено > 0 Тогда			
		ДополнительныеПараметры.Вставить("НеСопоставлено", НеСопоставлено);
		ОбработчикОповещения = Новый ОписаниеОповещения("СопоставитьПередЗаполнениемИзСтруктурыОповещение",
			ЭтотОбъект, ДополнительныеПараметры);
		СопоставлениеНоменклатурыКонтрагентовКлиент.ОткрытьСопоставлениеНоменклатуры(
			СписокНеСопоставленнойНоменклатуры, НастройкиСопоставления, ОбработчикОповещения);
	Иначе
		СоздатьДокументИзСтруктуры(ДополнительныеПараметры.ДанныеЭД);
	КонецЕсли;
	
КонецПроцедуры

Процедура СопоставитьПередЗаполнениемИзСтруктурыОповещение(Результат, ДополнительныеПараметры) Экспорт
	
	НачатьСопоставлениеНоменклатуры(ДополнительныеПараметры);
	
КонецПроцедуры

Процедура СоздатьДокументИзСтруктуры(ДанныеЭД)
	
	СсылкаДокумента = _ДемоСопоставлениеНоменклатурыКонтрагентовВызовСервера.СоздатьДокументИзСтруктуры(ДанныеЭД);
	Если ТипЗнч(СсылкаДокумента) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		ОповеститьОбИзменении(СсылкаДокумента);
		ПоказатьЗначение(, СсылкаДокумента);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти