	Иначе
		ИсточникДанных = Контекст;
	КонецЕсли;
	
	ВидыПродукции = Новый Массив();
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
		ВидыПродукции,
		КонструкторИСОбщегоНазначенияКлиентСервер.УчитываемыеВидыПродукцииИСМП(Истина));
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
		ВидыПродукции,
		ОбщегоНазначенияЕГАИСКлиентСерверПовтИсп.УчитываемыеВидыМаркируемойПродукции());
	
	#Область Метаданные
	
	ПараметрыСканирования.ИмяТабличнойЧастиШтрихкодыУпаковок = "ШтрихкодыУпаковок";
	ПараметрыСканирования.ИмяКолонкиШтрихкодУпаковки = "ШтрихкодУпаковки";
	
	#КонецОбласти
	
	#Область ПоддержкаПродукцииИСМП
	
	Реквизиты = Новый Структура("ДатаДокумента", ИсточникДанных.Дата);
	Если ШтрихкодированиеИСМПКлиентСервер.ЗаполнитьПараметрыСканированияДокументаОптовойОтгрузки(ПараметрыСканирования, ВидыПродукции) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыСканирования, Реквизиты);
	КонецЕсли;
	
	#КонецОбласти
	
КонецПроцедуры

