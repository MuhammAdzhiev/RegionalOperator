#Область КомандыСтраницыПриглашений

// Создать нового контрагента
//
// Параметры:
//  ПараметрКоманды - Неопределено
//  ПараметрыВыполненияКоманды - Неопределено
Процедура СоздатьКонтрагентаКоманда(ПараметрКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	ОткрытьФорму("Справочник.Контрагенты.ФормаОбъекта");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикСобытий

// Обработка события формы оповещение.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - 
//  ИмяСобытия - Строка -
//  Параметр - Произвольный -
//  Источник - Произвольный -
Процедура ОбработкаОповещения(Форма, ИмяСобытия, Параметр, Источник) Экспорт
	
	Если Форма.ИмяФормы = "Обработка.ИнтерфейсДокументовЭДО.Форма.ТекущиеДелаПоЭДОЛегкийКлиентЭДО" Тогда
		Если ИмяСобытия = ТарификацияКЭДОКлиентСервер.ИмяОповещенияОтключенияУслугиМаркировка() Тогда
			Если Форма.Открыта() И Не ЗначениеЗаполнено(Форма.НавигационнаяСсылка) Тогда
				Форма.Закрыть();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Не КлиентЭДОКлиентПовтИсп.ИспользуетсяГосИС() Тогда
		Возврат;
	КонецЕсли;
	
	СобытияФормИСКлиент.ОбработкаОповещения(Форма, ИмяСобытия, Параметр, Источник, Неопределено);
	
	Если Форма.ИмяФормы = "Обработка.ИнтерфейсДокументовЭДО.Форма.ТекущиеДелаПоЭДОЛегкийКлиентЭДО" Тогда
		
		Если ИмяСобытия = СоответствиеТребованиямГИСМТКлиент.ИмяСобытияОповещенияПослеПроверкиДокументаНаСоответствиеТребованиямГИСМТ()
			И ЗначениеЗаполнено(Форма.ТекущийРаздел) Тогда
			
			Форма.Элементы[Форма.ТекущийРаздел].Обновить();
			
		ИначеЕсли ИмяСобытия = СоответствиеТребованиямГИСМТКлиент.ИмяСобытияВыполненаПроверкаВРегламентномЗадании() Тогда
			
			Для Каждого КлючИЗначение Из Параметр Цикл
				
				Тип = КлючИЗначение.Ключ;
				
				Если Тип = Тип("ДокументСсылка.ЭлектронныйДокументВходящийЭДО")
					И Форма.ТекущийРаздел = "ВходящиеЭлектронныеДокументы" Тогда
					Форма.Элементы[Форма.ТекущийРаздел].Обновить();
				ИначеЕсли Тип = Тип("ДокументСсылка.ЭлектронныйДокументИсходящийЭДО") Тогда
					Если Форма.ТекущийРаздел = "ИсходящиеЭлектронныеДокументы"
						Или Форма.ТекущийРаздел = "Черновики" Тогда
						Форма.Элементы[Форма.ТекущийРаздел].Обновить();
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Обработка навигационной ссылки.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  НавигационнаяСсылкаФорматированнойСтроки - Строка
//  СтандартнаяОбработка - Булево
Процедура ОбработкаНавигационнойСсылки(Форма, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка) Экспорт
	
	Если Не КлиентЭДОКлиентПовтИсп.ИспользуетсяГосИС() Тогда
		Возврат;
	КонецЕсли;
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "СоответствиеТребованиямГИСМТГосИС" Тогда
		
		СтандартнаяОбработка = Ложь;
		СоответствиеТребованиямГИСМТКлиент.ОткрытьФормуСРезультатомПроверкиДокументаНаСоответствиеТребованиямГИСМТ(Форма);
		
	КонецЕсли;
	
	СобытияФормИСКлиент.ОбработкаНавигационнойСсылки(Форма, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
	
КонецПроцедуры

// Выполнить переопределяемую команду.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Команда - КомандаФормы
//  ДополнительныеПараметры	- Структура - дополнительные параметры.
Процедура ВыполнитьПереопределяемуюКоманду(Форма, Команда) Экспорт
	
	Если Не КлиентЭДОКлиентПовтИсп.ИспользуетсяГосИС() Тогда
		Возврат;
	КонецЕсли;
	
	СобытияФормИСКлиент.ВыполнитьПереопределяемуюКоманду(Форма, Команда, Неопределено);
	ПодключаемоеОборудованиеКЭДОКлиент.ВыполнитьПереопределяемуюКоманду(Форма, Команда, Неопределено);
	
КонецПроцедуры

// Обработка оповещения ЕГАИС.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//   ИмяСобытия - Строка -
//  Параметр - Произвольный -
//  Источник - Произвольный -
//  ДополнительныеПараметры - Произвольный -
Процедура ОбработкаОповещенияЕГАИС(Форма, ИмяСобытия, Параметр, Источник, ДополнительныеПараметры) Экспорт
	
	Если ИмяСобытия = "ВыполненОбменЕГАИС" Тогда
		Если (Параметр = Неопределено
			Или (ТипЗнч(Параметр) = Тип("Структура") И Параметр.ОбновлятьСтатусВФормахДокументов)) Тогда
			ПриОбновлениияПоляИнтеграцииВФормеДокументаОснования(Форма, "ЕГАИС");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Параметр) <> Тип("Структура") Тогда
		Возврат;
	ИначеЕсли НЕ Параметр.Свойство("Основание") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыИнтеграции = Форма.ПараметрыИнтеграцииГосИС.Получить("ЕГАИС");
	Если ПараметрыИнтеграции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект = Форма[ПараметрыИнтеграции.ИмяРеквизитаФормыОбъект];
	Если Параметр.Основание = Объект.Ссылка
		Или Не ЗначениеЗаполнено(Параметр.Основание) Тогда
		ПриОбновлениияПоляИнтеграцииВФормеДокументаОснования(Форма, "ЕГАИС");
	ИначеЕсли Форма.ИмяФормы = "Документ.ЭлектронныйДокументИсходящийЭДО.Форма.ФормаПросмотраЛегкийКлиентЭДО" Тогда
		Для Каждого ДанныеОбъектаУчета Из Форма.ОбъектыУчетаДокумента Цикл
			Если Параметр.Основание = ДанныеОбъектаУчета.ОбъектУчета Тогда
				ПриОбновлениияПоляИнтеграцииВФормеДокументаОснования(Форма, "ЕГАИС");
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Успешный результат проверок перед отправкой документа.
// 
// Параметры:
//  Команда - КомандаФормы
//  Форма - ФормаКлиентскогоПриложения
//  Источник - Произвольный
// Возвращаемое значение:
//  Булево, Структура - Успешный результат проверок перед отправкой документа:
// * ТребуетсяВопросПользователю - Булево - 
// * ТекущееСостояние - ПеречислениеСсылка.СтатусыОбработкиДокументовИСМП - 
Функция УспешныйРезультатПроверокПередОтправкойДокумента(Команда, Форма, Источник) Экспорт
	
	ВозвращаемоеЗначение = Истина;
	
	Если Команда.Имя = "КомандыЭДОСформироватьПодписатьОтправитьЭД0"
		И КлиентЭДОКлиентПовтИсп.ИспользуетсяГосИС()
		И Форма.ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокументаЛегкийИнтерфейс"
		И КлиентЭДОКлиентСервер.ИспользоватьМаркировкуВДокументеРеализацияТоваровУслуг(Форма.Объект) Тогда
 		
 		Результат = КлиентЭДОВызовСервера.РезультатПроверкиНаСоответствиеТребованиямГИСМТ(Форма.Объект.Ссылка);
 		
 		Если Результат.ТребуетсяВопросПользователю Тогда
 			
 			ДополнительныеПараметры = Новый Структура;
 			ДополнительныеПараметры.Вставить("Команда",  Команда);
 			ДополнительныеПараметры.Вставить("Форма",    Форма);
 			ДополнительныеПараметры.Вставить("Источник", Источник);
 			
 			ВопросПередОтправкойДокументаБезПроверкиГИСМТЗавершение = Новый ОписаниеОповещения(
 				"ВопросПередОтправкойДокументаБезПроверкиГИСМТЗавершение",
 				ЭтотОбъект,
 				ДополнительныеПараметры);
			
 			ПоказатьВопрос(
 				ВопросПередОтправкойДокументаБезПроверкиГИСМТЗавершение,
 				Результат.ТекстВопроса,
 				РежимДиалогаВопрос.ДаНет,,
 				КодВозвратаДиалога.Нет);
 		
 			ВозвращаемоеЗначение = Ложь;
 			
 		КонецЕсли;
 		
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Вопрос перед отправкой документа без проверки ГИСМТЗавершение.
// 
// Параметры:
//  Ответ - КодВозвратаДиалога
//  ДополнительныеПараметры - Структура
Процедура ВопросПередОтправкойДокументаБезПроверкиГИСМТЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПодключаемыеКомандыЭДОКлиент.ВыполнитьПодключаемуюКомандуЭДО(
		ДополнительныеПараметры.Команда,
		ДополнительныеПараметры.Форма,
		ДополнительныеПараметры.Источник);
		
КонецПроцедуры

#КонецОбласти

