//  ПараметрыВыполненияКоманды - Структура:
//  * ОписаниеКоманды - Структура:
//  ** ТипПараметра - Неопределено,ОписаниеТипов
//  * Форма - ФормаКлиентскогоПриложения:
//  * ОбъектыУчетаДокумента - ДанныеФормыКоллекция Из ДанныеФормыЭлементКоллекции:
//   ** ОбъектУчета - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО
Процедура СоздатьНаОснованииИсправлениеКоманда(ПараметрКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	ОбъектУчета = ОбъектУчетаИзПараметровВыполненияКоманды(ПараметрыВыполненияКоманды);
	СоздатьНаОснованииИсправление(ОбъектУчета);
	
КонецПроцедуры

// Создать на основании исправление.
// 
// Параметры:
//  ПараметрКоманды - ДокументСсылка
//  ПараметрыВыполненияКоманды - Неопределено,Структура:
//  * Источник - ОкноКлиентскогоПриложения,ФормаКлиентскогоПриложения
//  * Уникальность - Булево
//  * Окно - ОкноКлиентскогоПриложения
//  * НавигационнаяСсылка - Строка
Процедура СоздатьНаОснованииИсправление(ПараметрКоманды, ПараметрыВыполненияКоманды = Неопределено) Экспорт
	
	Если ТипЗнч(ПараметрКоманды) <> Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ОткрытьФормуИсправленияРеализацияТоваровУслуг(ПараметрКоманды, ПараметрыВыполненияКоманды);
		Возврат;
	КонецЕсли;
	
	ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОпераций.Исправление");
	МассивОснований = КлиентЭДОВызовСервера.ОснованияСчетаФактурыВыданногоДляКорректировки(ПараметрКоманды, ВидОперации);
	КоличествоОснований = МассивОснований.Количество();
	
	Если КоличествоОснований = 1 Тогда
		ПараметрКоманды = МассивОснований[0];
	ИначеЕсли КоличествоОснований > 1 Тогда
		Оповещение = Новый ОписаниеОповещения("ОбработкаКомандыПослеВыбораОснованияРеализацияТоваровУслуг",
			ЭтотОбъект, ПараметрыВыполненияКоманды);
		СписокОснований = Новый СписокЗначений;
		СписокОснований.ЗагрузитьЗначения(МассивОснований);
		СписокОснований.ПоказатьВыборЭлемента(Оповещение, НСтр("ru = 'Документы-основания для исправления'"));
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуИсправленияРеализацияТоваровУслуг(ПараметрКоманды, ПараметрыВыполненияКоманды);
	
КонецПроцедуры

