#Область ПрограммныйИнтерфейс

// См. процедуру ОбщегоНазначенияКлиентПереопределяемый.ПриНачалеРаботыСистемы().
//
Процедура ПриНачалеРаботыСистемы(Параметры) Экспорт
	
	ПараметрыРаботыКлиента = СтандартныеПодсистемыКлиент.ПараметрыРаботыКлиентаПриЗапуске();
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыРаботыКлиента, "ПоказатьНачалоРаботы", Ложь) Тогда
		Параметры.Вставить("ИнтерактивнаяОбработка",
			Новый ОписаниеОповещения("ИнтерактивнаяОбработкаЗапросЛицензионногоСоглашения", ЭтотОбъект));
	КонецЕсли;
	
	// БПО
	ИнтеграцияПодсистемБПОКлиент.ПриНачалеРаботыСистемы();
	// Конец БПО
	
КонецПроцедуры

//см. ОбщегоНазначенияКлиентПереопределяемый.ПередНачаломРаботыСистемы
Процедура ПередНачаломРаботыСистемы(Параметры) Экспорт
	
	// БПО
	ИнтеграцияПодсистемБПОКлиент.ПередНачаломРаботыСистемы();
	// Конец БПО
	

	Перезапустить = Ложь;
	ТарификацияКЭДОВызовСервера.НастроитьЗарегистрированныеУслугиПередЗапуском(Перезапустить);
	
	Если Перезапустить Тогда
		ЗавершитьРаботуСистемы(Ложь, Истина);
	КонецЕсли;	
	
КонецПроцедуры

// См. процедуру ОбщегоНазначенияКлиентПереопределяемый.ПослеНачалаРаботыСистемы.
//
Процедура ПослеНачалаРаботыСистемы() Экспорт
	
	Если Не ОбщегоНазначенияКлиент.ДоступноИспользованиеРазделенныхДанных() Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоМобильныйКлиент = Ложь;
	
	#Если МобильныйКлиент Тогда
		ЭтоМобильныйКлиент = Истина;
	#КонецЕсли
	
	ПоказыватьСтартовыйПомощникКЭДО = Ложь;
	ПараметрыРаботыКлиента = СтандартныеПодсистемыКлиент.ПараметрыРаботыКлиентаПриЗапуске();
	
	Если Не КлиентЭДОВызовСервера.ИспользуетсяЛегкийКлиентЭДО()
		И ПараметрыРаботыКлиента.Свойство("ПоказыватьСтартовыйПомощникКЭДО")
		И ПараметрыРаботыКлиента.ПоказыватьСтартовыйПомощникКЭДО И Не ЭтоМобильныйКлиент Тогда
		ПоказыватьСтартовыйПомощникКЭДО = Истина;
	КонецЕсли;
	
	ТребуетсяОбновлениеИнтерфейса           = Ложь;
	ТребуетсяОткрытьФормуПервогоПодключения = Ложь;
	КлиентЭДОВызовСервера.НастроитьИнтерфейс(
		ПоказыватьСтартовыйПомощникКЭДО, ТребуетсяОбновлениеИнтерфейса, ТребуетсяОткрытьФормуПервогоПодключения);
	
	Если ТребуетсяОбновлениеИнтерфейса Тогда
		ОбновитьИнтерфейс();
	КонецЕсли;
	
	Если ТребуетсяОткрытьФормуПервогоПодключения Тогда
		ПараметрыСоздания = УчетныеЗаписиЭДОКлиент.НовыеПараметрыСозданияУчетнойЗаписи();
		ПараметрыСоздания.РежимОткрытия = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		УчетныеЗаписиЭДОКлиент.СоздатьУчетнуюЗапись(ПараметрыСоздания);
	КонецЕсли;
	
КонецПроцедуры

// См. ОбщегоНазначенияКлиентПереопределяемый.ПриУстановкеЗаголовкаКлиентскогоПриложения.
Процедура ПриУстановкеЗаголовкаКлиентскогоПриложения(ЗаголовокПриложения, ПриЗапуске) Экспорт
	
	ПараметрыКлиента = ?(ПриЗапуске, СтандартныеПодсистемыКлиент.ПараметрыРаботыКлиентаПриЗапуске(),
		СтандартныеПодсистемыКлиент.ПараметрыРаботыКлиента());
	
	ИмяПараметраПредставлениеКонфигурации = ТарификацияКЭДОКлиентСервер.ИмяПараметраПредставлениеКонфигурации();
	ИмяПараметраТребуетсяИзменитьПредставление = ТарификацияКЭДОКлиентСервер.ИмяПараметраТребуетсяИзменитьЗаголовокПриложения();
	
	Если Не ПараметрыКлиента.Свойство(ИмяПараметраТребуетсяИзменитьПредставление) Тогда
		Возврат;
	КонецЕсли;
	Если ПараметрыКлиента[ИмяПараметраТребуетсяИзменитьПредставление] Тогда
		ЗаголовокПриложения = ПараметрыКлиента[ИмяПараметраПредставлениеКонфигурации];
	Иначе
		ПараметрКлиента = СтандартныеПодсистемыКлиент.ПараметрКлиента();
		Если ПараметрКлиента.Свойство(ИмяПараметраТребуетсяИзменитьПредставление)
			И СтандартныеПодсистемыКлиент.ПараметрКлиента(ИмяПараметраТребуетсяИзменитьПредставление) Тогда
			ЗаголовокПриложения = СтандартныеПодсистемыКлиент.ПараметрКлиента(ИмяПараметраПредставлениеКонфигурации)
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//см. ОбщегоНазначенияКлиентПереопределяемый.ПередПериодическойОтправкойДанныхКлиентаНаСервер
Процедура ПередПериодическойОтправкойДанныхКлиентаНаСервер(Параметры) Экспорт
	
	// ГосИС
	ОбщегоНазначенияЕГАИСКлиент.ПередПериодическойОтправкойДанныхКлиентаНаСервер(Параметры);
	// ГосИС конец
	
КонецПроцедуры

//см. ОбщегоНазначенияКлиентПереопределяемый.ПослеПериодическогоПолученияДанныхКлиентаНаСервере
Процедура ПослеПериодическогоПолученияДанныхКлиентаНаСервере(Результаты) Экспорт
	
	// ГосИС
	ОбщегоНазначенияЕГАИСКлиент.ПослеПериодическогоПолученияДанныхКлиентаНаСервере(Результаты);
	// ГосИС конец
	
КонецПроцедуры

// Возвращает фильтр, используемый для выбора файлов-изображений.
//
// Возвращаемое значение:
//  Строка - строка, содержащая фильтр для файлов-изображений.
//
Функция ФильтрФайловИзображений() Экспорт
	Возврат НСтр("ru = 'Все картинки (*.bmp;*.gif;*.png;*.jpeg;*.dib;*.rle;*.tif;*.jpg;*.ico;*.wmf;*.emf)|*.bmp;*.gif;*.png;*.jpeg;*.dib;*.rle;*.tif;*.jpg;*.ico;*.wmf;*.emf"
		                            + "|Все файлы(*.*)|*.*"
		                            + "|Формат bmp(*.bmp*;*.dib;*.rle)|*.bmp;*.dib;*.rle"
		                            + "|Формат GIF(*.gif*)|*.gif"
		                            + "|Формат JPEG(*.jpeg;*.jpg)|*.jpeg;*.jpg"
		                            + "|Формат PNG(*.png*)|*.png"
		                            + "|Формат TIFF(*.tif)|*.tif"
		                            + "|Формат icon(*.ico)|*.ico"
		                            + "|Формат метафайл(*.wmf;*.emf)|*.wmf;*.emf'");
КонецФункции

// Показывает диалог с вопросом о разрешении редактирования реквизитов объекта.
//
// Параметры:
//  Оповещение  - ОписаниеОповещения - Описание процедуры, принимающей результат выбора.
//  Ссылка - ДокументСсылка - Документ, о котором должен быть задан вопрос.
//
Процедура ПоказатьВопросОРазрешенииРедактированияРеквизитовОбъекта(Оповещение, Ссылка) Экспорт
	
	ТекстВопроса = СтрШаблон(НСтр("ru = '%1 был создан по электронному документу.
		|Не рекомендуется разрешать редактирование из-за риска рассогласования данных.'"), Ссылка);
		
	ЗаголовокДиалога = НСтр("ru = 'Разрешение редактирования реквизитов'");
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Разрешить редактирование'"));
	Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Отмена'"));
	ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки,, КодВозвратаДиалога.Нет, ЗаголовокДиалога);
	
КонецПроцедуры

// Выполняет поиск номенклатуры по штрих-коду в регистре сведений "Штрихкоды" и в сервисе 1С:Номенклатура.
//
// Параметры:
//  Оповещение  - ОписаниеОповещения - Описание процедуры, принимающей результат поиска.
//  ВыборПриСовпадении - Булево - открывать форму выбора номенклатуры, если найдено несколько совпадений.
//
Процедура ПоискНоменклатурыПоШтрихкоду(Оповещение, ВыборПриСовпадении = Ложь) Экспорт
	
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОРезультате", Оповещение);
	Контекст.Вставить("ВыборПриСовпадении", ВыборПриСовпадении);
	
	Штрихкод = Неопределено;
	Если Оповещение.ДополнительныеПараметры <> Неопределено
		И Оповещение.ДополнительныеПараметры.Свойство("Штрихкод", Штрихкод)
		И ЗначениеЗаполнено(Штрихкод) Тогда
		
		ПоискНоменклатурыПоШтрихкодуПослеВводаСтроки(Штрихкод, Контекст);
	Иначе
		ОповещениеПослеВводаСтроки = Новый ОписаниеОповещения("ПоискНоменклатурыПоШтрихкодуПослеВводаСтроки",
			ЭтотОбъект, Контекст);
		ПоказатьВводСтроки(ОповещениеПослеВводаСтроки, "", НСтр("ru = 'Введите штрихкод'"));
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает отбор динамического списка по штрих-коду.
//
// Параметры:
//  Оповещение  - ОписаниеОповещения - Описание процедуры, принимающей результат поиска.
//  ДинамическийСписок - ДинамическийСписок - реквизит формы, для которого требуется установить отбор.
//
Процедура УстановитьОтборПоШтрихкоду(Оповещение, ДинамическийСписок) Экспорт
	
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОРезультате", Оповещение);
	Контекст.Вставить("ДинамическийСписок", ДинамическийСписок);
	
	Оповещение = Новый ОписаниеОповещения("УстановитьОтборПоШтрихкодуПослеПоиска", ЭтотОбъект, Контекст);
	ПоискНоменклатурыПоШтрихкоду(Оповещение);
	
КонецПроцедуры

// Открывает форму выбора / заполнения кодов маркировки.
//
// Параметры:
//  Форма				 - ФормаКлиентскогоПриложения - объект формы, из которой нужно открыть форму выбора / заполнения кодов.
//  СтандартнаяОбработка - Булево - стандартный параметр обработчика события элемента формы, из которого происходит выбор.
//  ИмяЭлементаФормы	 - Строка - имя элемента формы (таблицы), в котором хранятся сведения по товарам.
//  ТолькоПросмотр		 - Булево - если нужно открыть форму в режиме просмотра, нужно передать значение Истина.
//
Процедура ВыбратьКодыМаркировки(Форма, СтандартнаяОбработка, ИмяЭлементаФормы = "Товары", ТолькоПросмотр = Ложь) Экспорт

	СтандартнаяОбработка = Ложь;
	Элемент = Форма.Элементы[ИмяЭлементаФормы];
	ПараметрыВыбораКодов = Новый Структура;

	Тип = ТипЗнч(Форма.Объект.Ссылка);
	Если ТолькоПросмотр Или Тип = Тип("ДокументСсылка.АктОРасхожденияхПоОтгрузке") Тогда
		ПараметрыВыбораКодов.Вставить("ТолькоПросмотр", Истина);
	Иначе
		ПараметрыВыбораКодов.Вставить("ТолькоПросмотр", Ложь);
	КонецЕсли;

	ИменаТаблицМаркировкиАктаОРасхождениях = КлиентЭДОКлиентСервер.ИменаТаблицМаркировкиАктаОРасхождениях();

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если Тип = Тип("ДокументСсылка.АктОРасхожденияхПоОтгрузке")
		Или Тип = Тип("ДокументСсылка.АктОРасхожденияхПоПриемке") Тогда
		
		ПараметрыВыбораКодов.Вставить("ЭтоАктОРасхождениях");
		
		Для Каждого ИмяТаблицы Из ИменаТаблицМаркировкиАктаОРасхождениях Цикл
			ПараметрыВыбораКодов.Вставить(ИмяТаблицы, ТекущиеДанные[ИмяТаблицы].ВыгрузитьЗначения());
		КонецЦикла;
	Иначе
		ПараметрыВыбораКодов.Вставить("КодыУпаковокМаркируемойПродукции",
			ТекущиеДанные.КодыУпаковокМаркируемойПродукции.ВыгрузитьЗначения());
	КонецЕсли;

	ПараметрыВыбораКодов.Вставить("Номенклатура", ТекущиеДанные.Номенклатура);
	ПараметрыВыбораКодов.Вставить("Количество", ТекущиеДанные.Количество);
	
	Если ТолькоПросмотр Тогда
		ОписаниеОповещения = Неопределено;
	Иначе
		ДополнительныеПараметры = Новый Структура("Элемент, Форма", Элемент, Форма);
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьКодыМаркировкиПослеВыбора", ЭтотОбъект,
			ДополнительныеПараметры);
	КонецЕсли;
	
	ОткрытьФорму("ОбщаяФорма.ВыборКодовМаркировки", ПараметрыВыбораКодов, Элемент, Форма.УникальныйИдентификатор,,,
		ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// Обработчик события "ПриНачалеРедактирования" элемента формы (таблицы), хранящего данные товаров.
//
// Параметры:
//  Элемент		 - ПолеФормы - элемент управления формы (таблица), в котором хранятся сведения по товарам.
//  НоваяСтрока	 - Булево - смотри одноименный параметр события "ПриНачалеРедактирования".
//  Копирование	 - Булево - смотри одноименный параметр события "ПриНачалеРедактирования".
//
Процедура ИдентификаторыСтрокПриНачалеРедактированияТаблицы(Элемент, НоваяСтрока, Копирование) Экспорт

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если НоваяСтрока И ТекущиеДанные.Свойство("ИдентификаторСтроки") Тогда
		КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

// Сохраняет в кэше на форме текущую строку указанной таблицы.
// Перед использованием необходим разовый вызов РаботаСТабличнымиЧастями.ИнициализироватьКэшСтрок().
//
// Параметры:
//  ТаблицаФормы - ТаблицаФормы - элемент формы, содержащий табличную часть.
//  Форма - ФормаКлиентскогоПриложения - форма объекта метаданных.
//
Процедура КэшироватьТекущуюСтроку(ТаблицаФормы, Форма) Экспорт
	
	ТекущиеДанные = ТаблицаФормы.ТекущиеДанные;
	КэшСтроки     = Новый Структура(Форма.КэшированныеСтроки[ТаблицаФормы.Имя]);
	
	Если ТекущиеДанные <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(КэшСтроки, ТекущиеДанные);
	Иначе
		Для Каждого КлючИЗначение Из КэшСтроки Цикл
			КэшСтроки[КлючИЗначение.Ключ] = Неопределено;
		КонецЦикла;
	КонецЕсли;
	
	Форма.КэшированныеСтроки[ТаблицаФормы.Имя] = Новый ФиксированнаяСтруктура(КэшСтроки);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиКлиентПереопределяемый.СоздатьКонтрагентаИнтерактивно
Процедура СоздатьКонтрагентаИнтерактивно(РеквизитыКонтрагента, ОписаниеОповещенияОСозданииКонтрагента) Экспорт
	
	СтруктураЗаполнения = Новый Структура;
	СтруктураЗаполнения.Вставить("Наименование", РеквизитыКонтрагента.Наименование);
	СтруктураЗаполнения.Вставить("НаименованиеПолное", РеквизитыКонтрагента.Наименование);
	СтруктураЗаполнения.Вставить("ИНН", РеквизитыКонтрагента.ИНН);
	СтруктураЗаполнения.Вставить("КПП", РеквизитыКонтрагента.КПП);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СтруктураЗаполнения", СтруктураЗаполнения);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОписаниеОповещенияОСозданииКонтрагента", ОписаниеОповещенияОСозданииКонтрагента);
	
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения(Неопределено,, ДополнительныеПараметры);
	ОткрытьФорму("Справочник.Контрагенты.Форма.ФормаЭлемента", ПараметрыФормы,,,,, ОписаниеОповещенияОЗакрытии);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиКлиентПереопределяемый.ВыбратьКонтрагента
Процедура ВыбратьКонтрагента(РеквизитыОтбораКонтрагента, ОписаниеОповещенияОЗакрытии) Экспорт
	
	Отбор = Новый Структура;
	Если ЗначениеЗаполнено(РеквизитыОтбораКонтрагента.Наименование) Тогда
		Отбор.Вставить("Наименование", РеквизитыОтбораКонтрагента.Наименование);
	КонецЕсли;
	Если ЗначениеЗаполнено(РеквизитыОтбораКонтрагента.ИНН) Тогда
		Отбор.Вставить("ИНН", РеквизитыОтбораКонтрагента.ИНН);
	КонецЕсли;
	Если ЗначениеЗаполнено(РеквизитыОтбораКонтрагента.КПП) Тогда
		Отбор.Вставить("КПП", РеквизитыОтбораКонтрагента.КПП);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Отбор);

	ОткрытьФорму("Справочник.Контрагенты.Форма.ФормаВыбора", ПараметрыФормы,,,,, ОписаниеОповещенияОЗакрытии)
	
КонецПроцедуры

// Обновляет интерфейс начальной страницы в зависимости от пользовательской настройки.
// 
// Параметры:
//  Легкий - Булево
//  ТекущаяФорма - Неопределено,ФормаКлиентскогоПриложения
Процедура ОбновитьИнтерфейсНачальнойСтраницы(Легкий, ТекущаяФорма = Неопределено) Экспорт
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	ОткрытаяФормаТекущихДел = ТекущаяФорма;
#Иначе
	ОткрытаяФормаТекущихДел = Неопределено;
	
	ВариантыИнтерфейса = ОбменСКонтрагентамиКлиентСервер.ВариантыИнтерфейсаДокументовЭДО();
	Если Легкий Тогда
		ПрежнийВариантИнтерфейса = ВариантыИнтерфейса.Расширенный;
	Иначе
		ПрежнийВариантИнтерфейса = ВариантыИнтерфейса.Легкий;
	КонецЕсли;
	ИмяПрежнейФормыТекущихДел = 
		ОбменСКонтрагентамиКлиентСервер.ФормаТекущихДелЭДОПоВариантуИнтерфейса(ПрежнийВариантИнтерфейса);
	
	ОткрытыеФормыТекущихДел = ОбщегоНазначенияБЭДКлиент.ОткрытаяФормаОкнаПриложения(ИмяПрежнейФормыТекущихДел);
		
	Для Каждого Форма Из ОткрытыеФормыТекущихДел Цикл
		Если Не Форма.Окно.НачальнаяСтраница Тогда
			ОткрытаяФормаТекущихДел = Форма;
		КонецЕсли;
	КонецЦикла;
		
	ТребуетсяОбновлениеИнтерфейса = Ложь;
	Если КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		КлиентЭДОВызовСервера.УстановитьИнтерфейсГосИС(ТребуетсяОбновлениеИнтерфейса);
	Иначе
		КлиентЭДОВызовСервера.УстановитьИнтерфейсТекущиеДелаЭДО(ТребуетсяОбновлениеИнтерфейса);
	КонецЕсли;

	Если ТребуетсяОбновлениеИнтерфейса Тогда
		ОбновитьИнтерфейс();
	КонецЕсли;
#КонецЕсли

	Если ОткрытаяФормаТекущихДел <> Неопределено Тогда
		ОткрытаяФормаТекущихДел.Закрыть();
		ФормаТекущихДел = ОбменСКонтрагентамиКлиент.ПутьКФормеТекущихДелЭДО();
		ОткрытьФорму(ФормаТекущихДел);
	КонецЕсли;
	
КонецПроцедуры

#Область СозданиеНовогоКонтрагентаПриВводе

// Обработчик события "АвтоПодбор" элемента формы (Поле ввода), хранящего данные контрагента.
//
// Параметры:
//  Элемент					 - ПолеФормы - элемент управления формы (Поле ввода), в котором хранится ссылка на контрагента.
//  Текст					 - Строка - смотри одноименный параметр события "АвтоПодбор".
//  ДанныеВыбора			 - СписокЗначений - смотри одноименный параметр события "АвтоПодбор".
//  ПараметрыПолученияДанных - Структура - смотри одноименный параметр события "АвтоПодбор".
//  Ожидание				 - Число - смотри одноименный параметр события "АвтоПодбор".
//  СтандартнаяОбработка	 - Булево - смотри одноименный параметр события "АвтоПодбор".
//
Процедура КонтрагентАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка) Экспорт
	
	Если НЕ ПустаяСтрока(Текст) 
		И (НЕ ЗначениеЗаполнено(Элемент.ОграничениеТипа)
		ИЛИ Элемент.ОграничениеТипа.СодержитТип(Тип("СправочникСсылка.Контрагенты"))) Тогда
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = КлиентЭДОВызовСервера.ДанныеВыбораКонтрагента(ПараметрыПолученияДанных, Ложь);
	КонецЕсли;
	
КонецПроцедуры

