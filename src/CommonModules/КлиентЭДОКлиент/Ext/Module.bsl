// Асинхронная процедура.
Процедура ИнтерактивнаяОбработкаЗапросЛицензионногоСоглашения(Параметры, Контекст) Экспорт
	
	ОткрытьФорму("Обработка.НачалоРаботыКЭДО.Форма.ЛицензионноеСоглашение", , , , , ,
		Новый ОписаниеОповещения("ПослеЗакрытияФормыЗапросаЛицензионногоСоглашения", ЭтотОбъект, Параметры));
	
КонецПроцедуры

// Асинхронная процедура.
Процедура ПослеЗакрытияФормыЗапросаЛицензионногоСоглашения(Результат, Параметры) Экспорт
	
	Если Результат <> Истина Тогда
		Параметры.Отказ = Истина;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(Параметры.ОбработкаПродолжения);
	
КонецПроцедуры

// Асинхронная процедура.
Процедура ПоискНоменклатурыПоШтрихкодуПослеВводаСтроки(ШтрихКод, Контекст) Экспорт
	
	Если ШтрихКод = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Контекст.Вставить("ШтрихКод", ШтрихКод);
	
	КонтекстОповещенияОРезультате = Контекст.ОповещениеОРезультате.ДополнительныеПараметры;
	Если КонтекстОповещенияОРезультате <> Неопределено
		И КонтекстОповещенияОРезультате.Свойство("Штрихкод")
		И НЕ ЗначениеЗаполнено(КонтекстОповещенияОРезультате.Штрихкод) Тогда
		КонтекстОповещенияОРезультате.Штрихкод = ШтрихКод;
	КонецЕсли;
	
	НоменклатураПоШтрихкоду = КлиентЭДОВызовСервера.НоменклатураПоШтрихкоду(ШтрихКод);
	
	Если НоменклатураПоШтрихкоду = Неопределено Тогда
		Оповещение = Новый ОписаниеОповещения("ПоискНоменклатурыПоШтрихкодуПослеДобавленияИзСервиса", ЭтотОбъект, Контекст);
		РаботаСНоменклатуройКЭДОКлиент.ПоискНоменклатурыПоШтрихкодуВСервисе(Оповещение, ШтрихКод);
	Иначе
		ПоискНоменклатурыПоШтрихкодуЗавершение(НоменклатураПоШтрихкоду, Контекст);
	КонецЕсли;
	
КонецПроцедуры

// Асинхронная процедура.
Процедура ПоискНоменклатурыПоШтрихкодуПослеДобавленияИзСервиса(Результат, Контекст) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат.Количество() = 0 Тогда
		ПоискНоменклатурыПоШтрихкодуЗавершение(Неопределено, Контекст);
		Возврат;
	КонецЕсли;
	
	Если Результат.Свойство("ШтрихкодыНоменклатуры") Тогда
		ВыполнитьОбработкуОповещения(Контекст.ОповещениеОРезультате, Результат.ШтрихкодыНоменклатуры);	
	КонецЕсли;
		
КонецПроцедуры

Процедура ПоискНоменклатурыПоШтрихкодуЗавершение(НоменклатураПоШтрихкоду, Контекст)
	
	Если НоменклатураПоШтрихкоду = Неопределено Тогда
		ВыполнитьОбработкуОповещения(Контекст.ОповещениеОРезультате, Неопределено);
		Возврат;
	КонецЕсли;
	
	Если НоменклатураПоШтрихкоду.Количество() > 1 Тогда
		
		Если Контекст.ВыборПриСовпадении Тогда
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("Штрихкод", Контекст.Штрихкод);
			
			НоваяФорма = ОткрытьФорму("ОбщаяФорма.ВыборНоменклатурыИзСписка",
				ПараметрыОткрытия,
				ЭтотОбъект,
				,,,
				Контекст.ОповещениеОРезультате,
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				
			ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(НоменклатураПоШтрихкоду, НоваяФорма.Список);
		Иначе
			ВыполнитьОбработкуОповещения(Контекст.ОповещениеОРезультате, НоменклатураПоШтрихкоду);
		КонецЕсли;
		
	Иначе
		
		ВыполнитьОбработкуОповещения(Контекст.ОповещениеОРезультате, НоменклатураПоШтрихкоду[0]);
		
	КонецЕсли;
	
КонецПроцедуры

// Асинхронная процедура.
Процедура УстановитьОтборПоШтрихкодуПослеПоиска(Результат, Контекст) Экспорт
	
	ОтборУстановлен = Ложь; 
	
	Если Результат <> Неопределено Тогда
		
		Если ТипЗнч(Результат) = Тип("Массив") Тогда
			Сравнение = ВидСравненияКомпоновкиДанных.ВСписке;
			ОтборНоменклатуры = Новый Массив;
			Для Каждого ЭлементКоллекции Из Результат Цикл
				ОтборНоменклатуры.Добавить(ЭлементКоллекции.Номенклатура);
			КонецЦикла;
		Иначе
			Сравнение = ВидСравненияКомпоновкиДанных.Равно;
			ОтборНоменклатуры = Результат.Номенклатура;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Контекст.ДинамическийСписок, "Ссылка", ОтборНоменклатуры, Сравнение);
		
		ОтборУстановлен = Истина;
		
	КонецЕсли;
	
	Если Контекст.ОповещениеОРезультате <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(Контекст.ОповещениеОРезультате, ОтборУстановлен);
	КонецЕсли;
	
КонецПроцедуры

// Асинхронная процедура.
Процедура ВыбратьКодыМаркировкиПослеВыбора(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		Элемент = ДополнительныеПараметры.Элемент;
		Форма   = ДополнительныеПараметры.Форма;
		ТекущиеДанныеКоллекции = Элемент.ТекущиеДанные;

		Если ПустаяСтрока(ТекущиеДанныеКоллекции.ИдентификаторСтроки) Тогда
			КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(ТекущиеДанныеКоллекции);
		КонецЕсли;

		Тип = ТипЗнч(Форма.Объект.Ссылка);
		Если Тип = Тип("ДокументСсылка.АктОРасхожденияхПоПриемке")
			Или Тип = Тип("ДокументСсылка.АктОРасхожденияхПоОтгрузке") Тогда
			
			ВсеКодыМаркировки = Новый Массив;
			
			ИменаТаблиц = КлиентЭДОКлиентСервер.ИменаТаблицМаркировкиАктаОРасхождениях();
			Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
				КодыМаркировки = Результат[ИмяТаблицы];
				ТекущиеДанныеКоллекции[ИмяТаблицы].ЗагрузитьЗначения(КодыМаркировки);
				Если ЗначениеЗаполнено(КодыМаркировки) Тогда
					ВсеКодыМаркировки.Добавить(КлиентЭДОКлиентСервер.ПредставлениеКодовМаркировки(КодыМаркировки));
				КонецЕсли;
			КонецЦикла;
			
			ТекущиеДанныеКоллекции.МаркируемыеУпаковки = КлиентЭДОКлиентСервер.ПредставлениеКодовМаркировки(ВсеКодыМаркировки);
		Иначе
			КодыУпаковок             = Результат.КодыУпаковокМаркируемойПродукции;
			ТекущиеДанныеКоллекции.КодыУпаковокМаркируемойПродукции.ЗагрузитьЗначения(КодыУпаковок);
			ТекущиеДанныеКоллекции.МаркируемыеУпаковки = КлиентЭДОКлиентСервер.ПредставлениеКодовМаркировки(КодыУпаковок);
		КонецЕсли;
		
		Форма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Асинхронная процедура.
Процедура НоменклатураОбработкаВыбораПослеПолученияДанныхИзСервиса(Результат, Контекст) Экспорт
	
	Если Результат.Статус <> "Выполнено" Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("РаботаСНоменклатурой_АдресДанныхЗаполнения", Результат.АдресРезультата);
	ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта", ПараметрыФормы, Контекст.Элемент);
	
КонецПроцедуры

Процедура НачатьОжиданиеОбновленияИнформацииПоПриглашениямВ1СЭДО(КлючиСинхронизации, ОписаниеОповещенияЗавершение) Экспорт
	
	ДлительнаяОперация = КлиентЭДОВызовСервера.НачатьОбновлениеИнформацииПоПриглашениямВ1СЭДО(
		КлючиСинхронизации, Новый УникальныйИдентификатор);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
	ПараметрыОжидания.ВыводитьОкноОжидания            = Ложь;
	ПараметрыОжидания.ОповещениеПользователя.Показать = Ложь;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

Процедура ОбработчикКомандыСоздатьСвязанныйДокументЛекгийКлиентЭДО(Значение, ДополнительныеПараметры) Экспорт
	
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Истина;
	СобытияФормИСКлиент.ОбработкаНавигационнойСсылки(
		ДополнительныеПараметры.Форма, Значение, СтандартнаяОбработка);
	
КонецПроцедуры

Процедура ОбработчикГиперссылкиПанелиДополнительногоСостоянияЛекгийКлиентЭДО(Значение, ДополнительныеПараметры) Экспорт
	
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Значение = "СоответствиеТребованиямГИСМТГосИС" Тогда
		СоответствиеТребованиямГИСМТКлиент.ОткрытьФормуСРезультатомПроверкиДокументаНаСоответствиеТребованиямГИСМТ(
			ДополнительныеПараметры.Форма);
	КонецЕсли;
	
КонецПроцедуры

// см. ИнтеграцияИСКлиентПереопределяемый.ПриОбновлениияПоляИнтеграцииВФормеДокументаОснования
Процедура ПриОбновлениияПоляИнтеграцииВФормеДокументаОснования(Форма, Подсистема) Экспорт
	
	Если Форма.ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокументаЛегкийИнтерфейс"
		Или Форма.ИмяФормы = "Документ.СчетФактураВыданный.Форма.ФормаДокументаЛегкийИнтерфейс"
		Или Форма.ИмяФормы = "Документ.СчетФактураВыданный.Форма.ФормаДокументаНаАвансЛегкийИнтерфейс"
		Или Форма.ИмяФормы = "Документ.ЗаказПоставщику.Форма.ФормаДокументаЛегкийИнтерфейс" Тогда
		
		ИмяСобытия = ИнтерфейсКлиентЭДОКлиент.ИмяСобытияИзменениеСвязанныхДокументов();
		
		Оповестить(ИмяСобытия, Форма.Объект.Ссылка, Подсистема);
	
	ИначеЕсли Форма.ИмяФормы = "Документ.ЭлектронныйДокументВходящийЭДО.Форма.ФормаПросмотраЛегкийКлиентЭДО"
		Или Форма.ИмяФормы = "Документ.ЭлектронныйДокументИсходящийЭДО.Форма.ФормаПросмотраЛегкийКлиентЭДО" Тогда
		
		ИмяСобытия = ЛегкийИнтерфейсДокументовЭДОКлиент.ИмяСобытияИзменениеСвязанныхДокументов();
		
		Оповестить(ИмяСобытия, Форма.Объект.Ссылка, Подсистема);
		
	КонецЕсли;
	
КонецПроцедуры

#Область ВводСчетаФактуры

// Обрабатывает результат вопроса о проведении документа.
// 
// Параметры:
//  Результат - КодВозвратаДиалога
//  Контекст  - Структура:
//  * Форма - ФормаКлиентскогоПриложения:
//  ** Объект - ДокументОбъект
//
Процедура ВвестиСчетФактуруПослеПодтверждениеПроведения(Результат, Контекст) Экспорт
	
	ДокументПроведен = Ложь;
	Если Результат = КодВозвратаДиалога.Да Тогда
		Попытка
			ДокументПроведен = Контекст.Форма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
		Исключение
			ПоказатьПредупреждение(,НСтр("ru = 'Не удалось выполнить проведение документа'"));
		КонецПопытки;
		
		Если ДокументПроведен Тогда
			ВвестиСчетФактуруПослеПроведения(Контекст.Форма);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Вводит документ счет-фактуру на основании текущего документа.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * Объект - ДокументОбъект
//
Процедура ВвестиСчетФактуруПослеПроведения(Форма)
	
	ПараметрыФормы = Новый Структура("Основание", Форма.Объект.Ссылка);
	ОткрытьФорму("Документ.СчетФактураВыданный.ФормаОбъекта", ПараметрыФормы, Форма);
	
КонецПроцедуры

#КонецОбласти

#Область СведенияПрослеживаемости

Процедура ОбработатьРезультатВводаСведенийПрослеживаемости(СведенияПрослеживаемостиТовара, Контекст) Экспорт
	
	Если СведенияПрослеживаемостиТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Контекст.ТекущиеДанные;
	СведенияПрослеживаемости = Контекст.СведенияПрослеживаемости;
	Для Каждого СтрокаСведений Из Контекст.НаборСведенийПоОтбору Цикл
		СведенияПрослеживаемости.Удалить(СтрокаСведений);
	КонецЦикла;
	
	Для Каждого СведенияПартииТовара Из СведенияПрослеживаемостиТовара Цикл
		НоваяСтрока = СведенияПрослеживаемости.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СведенияПартииТовара);
		НоваяСтрока.ИдентификаторСтроки = ТекущиеДанные.ИдентификаторСтроки;
	КонецЦикла;
	
	ТекущиеДанные.РНПТ = КлиентЭДОКлиентСервер.ПредставлениеРНПТ(СведенияПрослеживаемостиТовара);
	
КонецПроцедуры

#КонецОбласти

#Область СозданиеУчетныхДокументов

// Параметры:
//  ЭлементСписка - Неопределено,ЭлементСпискаЗначений
//  ПараметрыВыполненияКоманды - Неопределено,Структура:
//  * Источник - ОкноКлиентскогоПриложения,ФормаКлиентскогоПриложения
//  * Уникальность - Булево
//  * Окно - ОкноКлиентскогоПриложения
//  * НавигационнаяСсылка - Строка
Процедура ОбработкаКомандыПослеВыбораОснованияРеализацияТоваровУслуг(ЭлементСписка, ПараметрыВыполненияКоманды) Экспорт
	
	Если ЭлементСписка <> Неопределено Тогда
		ОткрытьФормуИсправленияРеализацияТоваровУслуг(ЭлементСписка.Значение, ПараметрыВыполненияКоманды);
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  ПараметрКоманды - ДокументСсылка
//  ПараметрыВыполненияКоманды - Неопределено,Структура:
//  * Источник - ОкноКлиентскогоПриложения,ФормаКлиентскогоПриложения
//  * Уникальность - Булево
//  * Окно - ОкноКлиентскогоПриложения
//  * НавигационнаяСсылка - Строка
Процедура ОткрытьФормуИсправленияРеализацияТоваровУслуг(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОпераций.Исправление");
	ЗначенияЗаполнения = Новый Структура("Основание, ВидОперации", ПараметрКоманды, ВидОперации);
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ТипПараметраКоманды = ТипЗнч(ПараметрКоманды);
	Если ТипПараметраКоманды = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Если ПараметрыВыполненияКоманды <> Неопределено Тогда
			ОткрытьФорму("Документ.РеализацияТоваровУслуг.ФормаОбъекта",
				ПараметрыФормы,
				ПараметрыВыполненияКоманды.Источник, 
				ПараметрыВыполненияКоманды.Уникальность,
				ПараметрыВыполненияКоманды.Окно, 
				ПараметрыВыполненияКоманды.НавигационнаяСсылка);
		Иначе
			ОткрытьФорму("Документ.РеализацияТоваровУслуг.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;
	ИначеЕсли ТипПараметраКоманды = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Если ПараметрыВыполненияКоманды <> Неопределено Тогда
			ОткрытьФорму("Документ.СчетФактураВыданный.ФормаОбъекта",
				ПараметрыФормы,
				ПараметрыВыполненияКоманды.Источник, 
				ПараметрыВыполненияКоманды.Уникальность,
				ПараметрыВыполненияКоманды.Окно, 
				ПараметрыВыполненияКоманды.НавигационнаяСсылка);
		Иначе
			ОткрытьФорму("Документ.СчетФактураВыданный.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;
	ИначеЕсли ТипПараметраКоманды = Тип("ДокументСсылка.АктОРасхожденияхПоПриемке") Тогда
		Если ПараметрыВыполненияКоманды <> Неопределено Тогда
			ОткрытьФорму("Документ.АктОРасхожденияхПоПриемке.ФормаОбъекта",
				ПараметрыФормы,
				ПараметрыВыполненияКоманды.Источник, 
				ПараметрыВыполненияКоманды.Уникальность,
				ПараметрыВыполненияКоманды.Окно, 
				ПараметрыВыполненияКоманды.НавигационнаяСсылка);
		Иначе
			ОткрытьФорму("Документ.АктОРасхожденияхПоПриемке.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  ЭлементСписка - Неопределено,ЭлементСпискаЗначений
//  ПараметрыВыполненияКоманды - Неопределено,Структура:
//  * Источник - ОкноКлиентскогоПриложения,ФормаКлиентскогоПриложения
//  * Уникальность - Булево
//  * Окно - ОкноКлиентскогоПриложения
//  * НавигационнаяСсылка - Строка
Процедура ОбработкаКомандыПослеВыбораОснованияКорректировкиРеализацияТоваровУслуг(ЭлементСписка,
	ПараметрыВыполненияКоманды) Экспорт
	
	Если ЭлементСписка <> Неопределено Тогда
		ОткрытьФормуКорректировкиРеализацияТоваровУслуг(ЭлементСписка.Значение, ПараметрыВыполненияКоманды);
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  ПараметрКоманды - ДокументСсылка
//  ПараметрыВыполненияКоманды - Неопределено,Структура:
//  * Источник - ОкноКлиентскогоПриложения,ФормаКлиентскогоПриложения
//  * Уникальность - Булево
//  * Окно - ОкноКлиентскогоПриложения
//  * НавигационнаяСсылка - Строка
Процедура ОткрытьФормуКорректировкиРеализацияТоваровУслуг(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОпераций.Корректировка");
	ЗначенияЗаполнения = Новый Структура("Основание, ВидОперации", ПараметрКоманды, ВидОперации);
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ТипПараметраКоманды = ТипЗнч(ПараметрКоманды);
	Если ТипПараметраКоманды = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Если ПараметрыВыполненияКоманды <> Неопределено Тогда
			ОткрытьФорму("Документ.РеализацияТоваровУслуг.ФормаОбъекта",
				ПараметрыФормы,
				ПараметрыВыполненияКоманды.Источник, 
				ПараметрыВыполненияКоманды.Уникальность,
				ПараметрыВыполненияКоманды.Окно, 
				ПараметрыВыполненияКоманды.НавигационнаяСсылка);
		Иначе
			ОткрытьФорму("Документ.РеализацияТоваровУслуг.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;
	ИначеЕсли ТипПараметраКоманды = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Если ПараметрыВыполненияКоманды <> Неопределено Тогда
			ОткрытьФорму("Документ.СчетФактураВыданный.ФормаОбъекта",
				ПараметрыФормы,
				ПараметрыВыполненияКоманды.Источник, 
				ПараметрыВыполненияКоманды.Уникальность,
				ПараметрыВыполненияКоманды.Окно, 
				ПараметрыВыполненияКоманды.НавигационнаяСсылка);
		Иначе
			ОткрытьФорму("Документ.СчетФактураВыданный.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;
	ИначеЕсли ТипПараметраКоманды = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		Если ПараметрыВыполненияКоманды <> Неопределено Тогда
			ОткрытьФорму("Документ.ПоступлениеТоваровУслуг.ФормаОбъекта",
				ПараметрыФормы,
				ПараметрыВыполненияКоманды.Источник, 
				ПараметрыВыполненияКоманды.Уникальность,
				ПараметрыВыполненияКоманды.Окно, 
				ПараметрыВыполненияКоманды.НавигационнаяСсылка);
		Иначе
			ОткрытьФорму("Документ.ПоступлениеТоваровУслуг.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  ПараметрыВыполненияКоманды - Структура:
//  * ОписаниеКоманды - Структура:
//  ** ТипПараметра - Неопределено,ОписаниеТипов
//  * Форма - ФормаКлиентскогоПриложения:
//  * ОбъектыУчетаДокумента - ДанныеФормыКоллекция Из ДанныеФормыЭлементКоллекции:
//   ** ОбъектУчета - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО
//
// Возвращаемое значение:
//  Неопределено,ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО
Функция ОбъектУчетаИзПараметровВыполненияКоманды(ПараметрыВыполненияКоманды)

	ОбъектУчета = Неопределено;
	ТипПараметраКоманды = ПараметрыВыполненияКоманды.ОписаниеКоманды.ТипПараметра; // ОписаниеТипов
	
	Для Каждого ДанныеОбъектаУчета Из ПараметрыВыполненияКоманды.Форма.ОбъектыУчетаДокумента Цикл
		Если ТипПараметраКоманды.СодержитТип(ТипЗнч(ДанныеОбъектаУчета.ОбъектУчета)) Тогда
			ОбъектУчета = ДанныеОбъектаУчета.ОбъектУчета;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ОбъектУчета;
	
КонецФункции

#КонецОбласти // СозданиеУчетныхДокументов

