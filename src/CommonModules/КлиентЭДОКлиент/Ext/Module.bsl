// Вызывается при окончании ввода текста в поле "Сумма скидки".
// 
// Параметры:
//  СтрокаТаблицы - ДанныеФормыЭлементКоллекции
//  Текст - Строка
Процедура ПриОкончанииВводаТекстаСуммаСкидки(СтрокаТаблицы, Текст) Экспорт
	
	СуммаБезСкидки = СтрокаТаблицы.Сумма + СтрокаТаблицы.СуммаСкидки;
	Если Число(Текст) > СуммаБезСкидки Тогда 
		Текст = Строка(СуммаБезСкидки);
		СтрокаТаблицы.СуммаСкидки = СуммаБезСкидки;
	КонецЕсли;
	
КонецПроцедуры

// Очищает табличную часть формы по отбору.
// 
// Параметры:
//  Таблица - ДанныеФормыКоллекция. - Очищаемая таблица документа
//  ИдентификаторСтроки - Строка. - Идентификатор текущей строки документа
//
Процедура ОчиститьТаблицуПоИдентификаторуСтроки(Таблица, ИдентификаторСтроки) Экспорт
	
	Отбор = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	СтрокиТаблицыПоОтбору = Таблица.НайтиСтроки(Отбор);
	Для Каждого СтрокаТаблицы Из СтрокиТаблицыПоОтбору Цикл
		Таблица.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
