		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
		// Табличные части
		ДанныеИБ.Товары.Загрузить(ПолученныеДанные.Товары.Выгрузить());
		ДанныеИБ.КодыУпаковокМаркируемойПродукции.Загрузить(ПолученныеДанные.КодыУпаковокМаркируемойПродукции.Выгрузить());
	
		ПолученныеДанные = Неопределено;
		
	КонецЕсли;
	
	Если ДанныеИБ = Неопределено Тогда
		КомпонентыОбмена.ПараметрыКонвертации.ДокументыСИзмененнымиКлючевымиРеквизитами.Добавить(
			ПолученныеДанные.ПолучитьСсылкуНового());
	ИначеЕсли ЭлектронноеВзаимодействиеКЭДО.ИзмененыКлючевыеРеквизитыОбъекта(ДанныеИБ) Тогда
		КомпонентыОбмена.ПараметрыКонвертации.ДокументыСИзмененнымиКлючевымиРеквизитами.Добавить(ДанныеИБ.Ссылка);
	КонецЕсли;
		
	Объект = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	Если ЗначениеЗаполнено(Объект.АдресДоставки) Тогда
		ЗаполнитьЗначенияПолейКИПоПредставлению(Объект.АдресДоставки, Объект.АдресДоставкиЗначенияПолей);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_СчетПокупателю_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.ВидДокумента = Перечисления.ВидыДокументов.СчетНаОплату;
	
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Номенклатура",       "Номенклатура");
	ПравилаЗаполнения.Вставить("Характеристика",     "Характеристика");
	ПравилаЗаполнения.Вставить("Упаковка",           "ЕдиницаИзмерения");
	ПравилаЗаполнения.Вставить("Количество",         "Количество");
	ПравилаЗаполнения.Вставить("КоличествоУпаковок", "КоличествоУпаковок");
	ПравилаЗаполнения.Вставить("Сумма",              "Сумма");
	ПравилаЗаполнения.Вставить("ЦенаЗаУпаковку",     "Цена");
	ПравилаЗаполнения.Вставить("СтавкаНДС",          "СтавкаНДС");
	ПравилаЗаполнения.Вставить("СуммаНДС",           "СуммаНДС");
	ПравилаЗаполнения.Вставить("СуммаСНДС",          "СуммаСНДС");
	
	ИтогиПоТоварам = ЗагрузитьТоварыДокумента(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена, ПравилаЗаполнения);
	
	ЗагрузитьУслугиДокумента(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена, ПравилаЗаполнения);
	
	ПолученныеДанные.ОблагаетсяНДСУПокупателя = ИтогиПоТоварам.ОблагаетсяНДСУПокупателя;
КонецПроцедуры
Процедура ПКО_Документ_СчетПокупателю_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ЗаполнитьЕдиницыИзмеренияУслугПоУмолчанию(ПолученныеДанные);
	
	Если ДанныеИБ <> Неопределено Тогда
	
		// Переносим те свойства, которые указаны в ПКС.
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
		// Табличные части
		ДанныеИБ.Товары.Загрузить(ПолученныеДанные.Товары.Выгрузить());
	
		ПолученныеДанные = Неопределено;
		
	КонецЕсли;
	
	Если ДанныеИБ = Неопределено Тогда
		КомпонентыОбмена.ПараметрыКонвертации.ДокументыСИзмененнымиКлючевымиРеквизитами.Добавить(
			ПолученныеДанные.ПолучитьСсылкуНового());
	ИначеЕсли ЭлектронноеВзаимодействиеКЭДО.ИзмененыКлючевыеРеквизитыОбъекта(ДанныеИБ) Тогда
		КомпонентыОбмена.ПараметрыКонвертации.ДокументыСИзмененнымиКлючевымиРеквизитами.Добавить(ДанныеИБ.Ссылка);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_СчетФактураВыданный_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.ВидДокумента = Перечисления.ВидыДокументов.СчетФактура;
	ПолученныеДанные.ВидОперации  = Перечисления.ВидыОпераций.Реализация;
	
	ПолученныеДанные.ЦенаВключаетНДС = Истина;
	
	ВидСчетаФактуры = ?(ДанныеXDTO.Свойство("ВидСчетаФактуры") И ЗначениеЗаполнено(ДанныеXDTO.ВидСчетаФактуры),
		ДанныеXDTO.ВидСчетаФактуры.Значение, "");
		
	Если ВидСчетаФактуры = "НаАванс" Тогда
		ПолученныеДанные.ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс;
	КонецЕсли;
		
	Если ВидСчетаФактуры = "Корректировочный" Тогда
		ПолученныеДанные.ВидОперации = Перечисления.ВидыОпераций.Корректировка;
	КонецЕсли;
	
	Если ДанныеXDTO.КлючевыеСвойства.Свойство("НомерИсправления")
			И ЗначениеЗаполнено(ДанныеXDTO.КлючевыеСвойства.НомерИсправления) Тогда
		ПолученныеДанные.ВидОперации = Перечисления.ВидыОпераций.Исправление;
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ИсправляемыйСчетФактура")
		И ЗначениеЗаполнено(ДанныеXDTO.ИсправляемыйСчетФактура) Тогда
	
		ПолученныеДанные.ДополнительныеСвойства.Вставить("НомерИсходногоДокумента", ДанныеXDTO.ИсправляемыйСчетФактура.Номер);
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ДатаИсходногоДокумента", ДанныеXDTO.ИсправляемыйСчетФактура.Дата);
		
		Если ДанныеXDTO.ИсправляемыйСчетФактура.Свойство("НомерИсправления")
			И ЗначениеЗаполнено(ДанныеXDTO.ИсправляемыйСчетФактура.НомерИсправления) Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("НомерИсправленияИсходногоДокумента",
				ДанныеXDTO.ИсправляемыйСчетФактура.НомерИсправления);
		КонецЕсли;
		
		Если ДанныеXDTO.ИсправляемыйСчетФактура.Свойство("ДатаИсправления")
			И ЗначениеЗаполнено(ДанныеXDTO.ИсправляемыйСчетФактура.ДатаИсправления) Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ДатаИсправленияИсходногоДокумента",
				ДанныеXDTO.ИсправляемыйСчетФактура.ДатаИсправления);
		КонецЕсли;
	КонецЕсли;
	
	// Документы-основания
	МассивСтрокДокументыОснования = Новый Массив;
	ДанныеXDTO.Вставить("ДокументОснование", Неопределено);
	Если ДанныеXDTO.Свойство("ДокументыОснования") И ЗначениеЗаполнено(ДанныеXDTO.ДокументыОснования) Тогда
		
		Для Каждого Строка Из ДанныеXDTO.ДокументыОснования Цикл
			
			СтруктураДанныхСтроки = Новый Структура;
			
			ТипДокументаОснования = Строка.ДокументОснование.ТипЗначения;
			Если СтрНайти(ТипДокументаОснования, "КорректировкаРеализацииТоваров") > 0 Тогда
				ИмяПКО = "Документ_КорректировкаРеализации_Получение";
			ИначеЕсли СтрНайти(ТипДокументаОснования, "РеализацияТоваровУслуг") > 0 Тогда
				ИмяПКО = "Документ_РеализацияТоваровУслуг_Получение";
			Иначе
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ИмяПКО) Тогда
				ТекДокументОснование = Новый Структура("Значение, ИмяПКО", Строка.ДокументОснование, ИмяПКО);
				СтруктураДанныхСтроки.Вставить("ДокументОснование", ТекДокументОснование);
			КонецЕсли;
			
			МассивСтрокДокументыОснования.Добавить(СтруктураДанныхСтроки);
	
		КонецЦикла;
	КонецЕсли;
	Если МассивСтрокДокументыОснования.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ДокументыОснования", МассивСтрокДокументыОснования);
	КонецЕсли;
	
	// Платежно-расчетные документы
	МассивСтрокДокументы = Новый Массив;
	Если ДанныеXDTO.Свойство("ПлатежноРасчетныеДокументы") И ЗначениеЗаполнено(ДанныеXDTO.ПлатежноРасчетныеДокументы) Тогда
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("ДатаДокумента",  "ДатаПлатежноРасчетногоДокумента");
		ПравилаЗаполнения.Вставить("НомерДокумента", "НомерПлатежноРасчетногоДокумента");
		Для Каждого Строка Из ДанныеXDTO.ПлатежноРасчетныеДокументы Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
	
			МассивСтрокДокументы.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
	КонецЕсли;
	Если МассивСтрокДокументы.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ПлатежноРасчетныеДокументы", МассивСтрокДокументы);
	КонецЕсли;
	
	// Авансы
	МассивСтрокАвансы = Новый Массив;
	Если ДанныеXDTO.Свойство("Авансы") И ЗначениеЗаполнено(ДанныеXDTO.Авансы) Тогда
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("Номенклатура", "Номенклатура");
		ПравилаЗаполнения.Вставить("Содержание", "Содержание");
		ПравилаЗаполнения.Вставить("СтавкаНДС", "СтавкаНДС");
		ПравилаЗаполнения.Вставить("СуммаНДС", "СуммаНДС");
		ПравилаЗаполнения.Вставить("Сумма", "Сумма");
		ПравилаЗаполнения.Вставить("СуммаСНДС", "СуммаСНДС");
		Если КомпонентыОбмена.ПараметрыКонвертации.ТекущаяВерсияФорматаЧислом >= ВерсияФорматаЧислом("1.7") Тогда
			ПравилаЗаполнения.Вставить("Характеристика", "Характеристика");
		КонецЕсли;
		Для Каждого СтрокаТаблицы Из ДанныеXDTO.Авансы Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(СтрокаТаблицы, ПравилаЗаполнения);
			Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") Тогда
				СтруктураДанныхСтроки.Вставить("СтавкаНДС", СтавкаНДСПоЗначениюXDTO(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС));
			КонецЕсли;
			СтруктураДанныхСтроки.Вставить("СуммаСНДС", СтрокаТаблицы.Сумма);
					
			МассивСтрокАвансы.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
	КонецЕсли;
	Если МассивСтрокАвансы.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Товары", МассивСтрокАвансы);
	КонецЕсли;
	
	РеквизитыПоОснованию = Новый Массив;
	
	Если НЕ (ДанныеXDTO.Свойство("Сумма") И ЗначениеЗаполнено(ДанныеXDTO.Сумма)) Тогда
		РеквизитыПоОснованию.Добавить("СуммаДокумента");
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("Договор") И ЗначениеЗаполнено(ДанныеXDTO.Договор) Тогда
		РеквизитыПоОснованию.Добавить("ДоговорКонтрагента");
	КонецЕсли;
	
	Если РеквизитыПоОснованию.Количество() Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("РеквизитыПоОснованию", РеквизитыПоОснованию);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_СчетФактураВыданный_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ЗначениеЗаполнено(ПолученныеДанные.СчетФактураОснование) Тогда
		ЗаполнитьНомерДатуИсходногоДокумента(ПолученныеДанные, ПолученныеДанные.СчетФактураОснование);
	КонецЕсли;
	
	КоличествоДокументовОснования = ПолученныеДанные.ДокументыОснования.Количество();
	Если КоличествоДокументовОснования > 0 Тогда
		
		Реквизиты = Новый Массив;
		Реквизиты.Добавить("ЦенаВключаетНДС");
		Реквизиты.Добавить("ОблагаетсяНДСУПокупателя");
		РеквизитыПоОснованию = Неопределено;
		Если ПолученныеДанные.ДополнительныеСвойства.Свойство("РеквизитыПоОснованию", РеквизитыПоОснованию)
			И ЗначениеЗаполнено(РеквизитыПоОснованию) Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Реквизиты, РеквизитыПоОснованию);
		КонецЕсли;
		
		ДокументОснование = ПолученныеДанные.ДокументыОснования[0].ДокументОснование;
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, Реквизиты);
		ЗаполнитьЗначенияСвойств(ПолученныеДанные, ЗначенияРеквизитов);
		
		Если Реквизиты.Найти("СуммаДокумента") <> Неопределено
			И КоличествоДокументовОснования > 1 Тогда
	
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	СУММА(РеализацияТоваровУслуг.СуммаДокумента) КАК СуммаДокумента
				|ИЗ
				|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
				|ГДЕ
				|	РеализацияТоваровУслуг.Ссылка В(&ДокументыОснования)";
			
			ДокументыОснования = ПолученныеДанные.ДокументыОснования.ВыгрузитьКолонку("ДокументОснование");
			Запрос.УстановитьПараметр("ДокументыОснования", ДокументыОснования);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ПолученныеДанные.СуммаДокумента = Выборка.СуммаДокумента;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДанныеИБ <> Неопределено Тогда
	
		// Переносим те свойства, которые указаны в ПКС.
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
		// Табличные части
		ДанныеИБ.Товары.Загрузить(ПолученныеДанные.Товары.Выгрузить());
		ДанныеИБ.ДокументыОснования.Загрузить(ПолученныеДанные.ДокументыОснования.Выгрузить());
		ДанныеИБ.ПлатежноРасчетныеДокументы.Загрузить(ПолученныеДанные.ПлатежноРасчетныеДокументы.Выгрузить());
	
		ПолученныеДанные = Неопределено;
		
	КонецЕсли;
	
	Если ДанныеИБ = Неопределено Тогда
		КомпонентыОбмена.ПараметрыКонвертации.ДокументыСИзмененнымиКлючевымиРеквизитами.Добавить(
			ПолученныеДанные.ПолучитьСсылкуНового());
	ИначеЕсли ЭлектронноеВзаимодействиеКЭДО.ИзмененыКлючевыеРеквизитыОбъекта(ДанныеИБ) Тогда
		КомпонентыОбмена.ПараметрыКонвертации.ДокументыСИзмененнымиКлючевымиРеквизитами.Добавить(ДанныеИБ.Ссылка);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_УстановкаЦенНоменклатуры_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные = Неопределено;
	
	ТипЦен = Неопределено;
	Если Не ДанныеXDTO.Свойство("ТипЦен", ТипЦен)
		ИЛИ Не ЗначениеЗаполнено(ТипЦен) Тогда
		Возврат;
	КонецЕсли;
	
	Товары = Неопределено;
	Если Не ДанныеXDTO.Свойство("Товары", Товары)
		ИЛИ Не ЗначениеЗаполнено(Товары) Тогда
		Возврат;
	КонецЕсли;
	
	ВидЦены = СсылкаПоДаннымXDTO(КомпонентыОбмена, ТипЦен, "Справочник_ВидыЦен");
	
	ПКОНоменклатуры = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Номенклатура_Получение");
	
	ЕстьХарактеристики = Товары.Колонки.Найти("Характеристика") <> Неопределено;
	Если ЕстьХарактеристики Тогда 
		ПКОХарактеристики = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_ХарактеристикиНоменклатуры");
	КонецЕсли;
	
	ЕстьУпаковки = Товары.Колонки.Найти("Упаковка") <> Неопределено;
	Если ЕстьУпаковки Тогда 
		ПКОУпаковки = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_ЕдиницыИзмерения");
	КонецЕсли;
	
	ИнформативныеЦены = Новый ТаблицаЗначений;
	ИнформативныеЦены.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ИнформативныеЦены.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ИнформативныеЦены.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.ЕдиницыИзмерения"));
	ИнформативныеЦены.Колонки.Добавить("ВидЦены", Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"));
	ИнформативныеЦены.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	
	Для Каждого СтрокаТаблицы Из Товары Цикл
		
		Номенклатура = СсылкаПоДаннымXDTO(КомпонентыОбмена, СтрокаТаблицы.Номенклатура, ПКОНоменклатуры);
		
		Характеристика = Неопределено;
		Если ЕстьХарактеристики И ЗначениеЗаполнено(СтрокаТаблицы.Характеристика) Тогда
			Характеристика = СсылкаПоДаннымXDTO(КомпонентыОбмена, СтрокаТаблицы.Характеристика, ПКОХарактеристики);
		КонецЕсли;
		
		Упаковка = Неопределено;
		Если ЕстьУпаковки И ЗначениеЗаполнено(СтрокаТаблицы.Упаковка) Тогда
			Упаковка = СсылкаПоДаннымXDTO(КомпонентыОбмена, СтрокаТаблицы.Упаковка, ПКОУпаковки);
		КонецЕсли;
		
		НоваяСтрока = ИнформативныеЦены.Добавить();
		НоваяСтрока.Номенклатура     = Номенклатура;
		НоваяСтрока.Характеристика   = Характеристика;
		НоваяСтрока.ЕдиницаИзмерения = Упаковка;
		НоваяСтрока.ВидЦены          = ВидЦены;
		НоваяСтрока.Цена             = СтрокаТаблицы.Цена;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ИнформативныеЦены) Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ПрайсЛист");
		ЭлементБлокировки.УстановитьЗначение("ВидЦены", ВидЦены);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаЦен.Номенклатура КАК Номенклатура,
			|	ТаблицаЦен.Характеристика КАК Характеристика,
			|	ТаблицаЦен.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ТаблицаЦен.ВидЦены КАК ВидЦены,
			|	ТаблицаЦен.Цена КАК Цена
			|ПОМЕСТИТЬ ВТ_ЦеныНоменклатуры
			|ИЗ
			|	&ТаблицаЦен КАК ТаблицаЦен
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ВТ_ЦеныНоменклатуры.Номенклатура КАК Номенклатура,
			|	ВТ_ЦеныНоменклатуры.Характеристика КАК Характеристика,
			|	ВТ_ЦеныНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ВТ_ЦеныНоменклатуры.Цена КАК Цена,
			|	ПрайсЛист.Организация КАК Организация,
			|	ПрайсЛист.Склад КАК Склад,
			|	ПрайсЛист.Количество КАК Количество,
			|	ПрайсЛист.Оценка КАК Оценка
			|ИЗ
			|	ВТ_ЦеныНоменклатуры КАК ВТ_ЦеныНоменклатуры
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрайсЛист КАК ПрайсЛист
			|		ПО ВТ_ЦеныНоменклатуры.Номенклатура = ПрайсЛист.Номенклатура
			|			И ВТ_ЦеныНоменклатуры.Характеристика = ПрайсЛист.Характеристика
			|			И ВТ_ЦеныНоменклатуры.ЕдиницаИзмерения = ПрайсЛист.ЕдиницаИзмерения
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ВТ_ЦеныНоменклатуры.Номенклатура КАК Номенклатура,
			|	ВТ_ЦеныНоменклатуры.Характеристика КАК Характеристика,
			|	ВТ_ЦеныНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения
			|ИЗ
			|	ВТ_ЦеныНоменклатуры КАК ВТ_ЦеныНоменклатуры
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПрайсЛист КАК ПрайсЛист
			|		ПО ВТ_ЦеныНоменклатуры.Номенклатура = ПрайсЛист.Номенклатура
			|			И ВТ_ЦеныНоменклатуры.Характеристика = ПрайсЛист.Характеристика
			|			И ВТ_ЦеныНоменклатуры.ЕдиницаИзмерения = ПрайсЛист.ЕдиницаИзмерения
			|			И (ПрайсЛист.ВидЦены = &ПустойВидЦены)";
		
		ПустойВидЦены = Справочники.ВидыЦен.ПустаяСсылка();
		Запрос.УстановитьПараметр("ТаблицаЦен", ИнформативныеЦены);
		Запрос.УстановитьПараметр("ПустойВидЦены", ПустойВидЦены);
		
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
		НаборЗаписей = РегистрыСведений.ПрайсЛист.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВидЦены.Установить(ВидЦены);
		
		Выборка = РезультатыЗапроса[1].Выбрать();
		Пока Выборка.Следующий() Цикл
			Запись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, Выборка);
			Запись.ВидЦены = ВидЦены;
		КонецЦикла;
		
		ОбменДаннымиXDTOСервер.ЗаписатьОбъектВИБ(КомпонентыОбмена, НаборЗаписей, "РегистрСведенийНаборЗаписей.ПрайсЛист"); 
		
		Если Не РезультатыЗапроса[2].Пустой() Тогда
			ВыборкаУдаление = РезультатыЗапроса[2].Выбрать();
			Пока ВыборкаУдаление.Следующий() Цикл
				УдалитьНаборЗаписей = РегистрыСведений.ПрайсЛист.СоздатьНаборЗаписей();
				УдалитьНаборЗаписей.Отбор.Номенклатура.Установить(ВыборкаУдаление.Номенклатура);
				УдалитьНаборЗаписей.Отбор.Характеристика.Установить(ВыборкаУдаление.Характеристика);
				УдалитьНаборЗаписей.Отбор.ЕдиницаИзмерения.Установить(ВыборкаУдаление.ЕдиницаИзмерения);
				УдалитьНаборЗаписей.Отбор.ВидЦены.Установить(ПустойВидЦены);
				ОбменДаннымиXDTOСервер.ЗаписатьОбъектВИБ(КомпонентыОбмена, УдалитьНаборЗаписей, "РегистрСведенийНаборЗаписей.ПрайсЛист"); 
			КонецЦикла;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры
Процедура ПКО_Документ_ЧекККМ_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПравилаЗаполненияТоваров = Новый Соответствие;
	ПравилаЗаполненияТоваров.Вставить("Номенклатура",        "Номенклатура");
	ПравилаЗаполненияТоваров.Вставить("Характеристика",      "Характеристика");
	ПравилаЗаполненияТоваров.Вставить("Упаковка",            "ЕдиницаИзмерения");
	ПравилаЗаполненияТоваров.Вставить("Количество",          "Количество");
	ПравилаЗаполненияТоваров.Вставить("КоличествоУпаковок",  "КоличествоУпаковок");
	ПравилаЗаполненияТоваров.Вставить("Сумма",               "Сумма");
	ПравилаЗаполненияТоваров.Вставить("ЦенаЗаУпаковку",      "Цена");
	ПравилаЗаполненияТоваров.Вставить("СтавкаНДС",           "СтавкаНДС");
	ПравилаЗаполненияТоваров.Вставить("СуммаНДС",            "СуммаНДС");
	ПравилаЗаполненияТоваров.Вставить("СуммаСНДС",           "СуммаСНДС");
	ПравилаЗаполненияТоваров.Вставить("НомерГТД",            "НомерГТД");
	ПравилаЗаполненияТоваров.Вставить("СтранаПроисхождения", "СтранаПроисхождения");
	ПравилаЗаполненияТоваров.Вставить("ИдентификаторСтроки", "ИдентификаторСтроки");
	
	ИтогиПоТоварам = ЗагрузитьТоварыДокумента(ДанныеXDTO, ПолученныеДанные,
		КомпонентыОбмена, ПравилаЗаполненияТоваров);
	
	ПравилаЗаполненияУслуг = Новый Соответствие;
	ПравилаЗаполненияУслуг.Вставить("Номенклатура",        "Номенклатура");
	ПравилаЗаполненияУслуг.Вставить("Количество",          "Количество");
	ПравилаЗаполненияУслуг.Вставить("Количество",          "КоличествоУпаковок");
	ПравилаЗаполненияУслуг.Вставить("Сумма",               "Сумма");
	ПравилаЗаполненияУслуг.Вставить("Цена",                "Цена");
	ПравилаЗаполненияУслуг.Вставить("СтавкаНДС",           "СтавкаНДС");
	ПравилаЗаполненияУслуг.Вставить("СуммаНДС",            "СуммаНДС");
	ПравилаЗаполненияУслуг.Вставить("СуммаСНДС",           "СуммаСНДС");
	ПравилаЗаполненияУслуг.Вставить("ИдентификаторСтроки", "ИдентификаторСтроки");
	
	ИтогиПоУслугам = ЗагрузитьУслугиДокумента(ДанныеXDTO, ПолученныеДанные,
		КомпонентыОбмена, ПравилаЗаполненияУслуг);
	
	ЗагрузитьАкцизныеМарки(ДанныеXDTO, ПолученныеДанные);
	
	ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная;
	Если ИтогиПоУслугам.ЕстьУслуги И НЕ ИтогиПоТоварам.ЕстьТовары Тогда
		ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот;
	КонецЕсли;
	
	ПолученныеДанные.ВидДокумента = ВидДокумента;
	ПолученныеДанные.ВидОперации  = Перечисления.ВидыОпераций.Реализация;
	ПолученныеДанные.СтатусФискализацииДокумента = Перечисления.СтатусФискализацииДокумента.Фискализирован;
	
	ОблагаетсяНДСУПокупателя = ИтогиПоТоварам.ОблагаетсяНДСУПокупателя;
	
	ПолученныеДанные.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;
КонецПроцедуры
Процедура ПКО_Документ_ЧекККМ_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ЗаполнитьЕдиницыИзмеренияУслугПоУмолчанию(ПолученныеДанные);
	
	Если ДанныеИБ <> Неопределено Тогда
	
		// Переносим те свойства, которые указаны в ПКС.
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
		// Табличные части
		ДанныеИБ.Товары.Загрузить(ПолученныеДанные.Товары.Выгрузить());
		ДанныеИБ.КодыУпаковокМаркируемойПродукции.Загрузить(ПолученныеДанные.КодыУпаковокМаркируемойПродукции.Выгрузить());
	
		ПолученныеДанные = Неопределено;
		
	КонецЕсли;
	
	Если ДанныеИБ = Неопределено Тогда
		КомпонентыОбмена.ПараметрыКонвертации.ДокументыСИзмененнымиКлючевымиРеквизитами.Добавить(
			ПолученныеДанные.ПолучитьСсылкуНового());
	ИначеЕсли ЭлектронноеВзаимодействиеКЭДО.ИзмененыКлючевыеРеквизитыОбъекта(ДанныеИБ) Тогда
		КомпонентыОбмена.ПараметрыКонвертации.ДокументыСИзмененнымиКлючевымиРеквизитами.Добавить(ДанныеИБ.Ссылка);
	КонецЕсли;
		
	Объект = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	Если ЗначениеЗаполнено(Объект.АдресДоставки) Тогда
		ЗаполнитьЗначенияПолейКИПоПредставлению(Объект.АдресДоставки, Объект.АдресДоставкиЗначенияПолей);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Объект.Контрагент = КонтрагентРозничныйПокупатель(КомпонентыОбмена);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_SKUКонтрагента_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ДанныеXDTO.КлючевыеСвойства.Свойство("УпаковкаНоменклатуры") 
		И ЗначениеЗаполнено(ДанныеXDTO.КлючевыеСвойства.УпаковкаНоменклатуры) Тогда
		
		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("ЕдиницаИзмерения", "ЕдиницаИзмерения");
		ПравилаЗаполнения.Вставить("Коэффициент", "Коэффициент");
		ПравилаЗаполнения.Вставить("Наименование", "НаименованиеУпаковки");
		ДанныеУпаковки = ДанныеКоллекцииВВидеСтруктуры(ДанныеXDTO.КлючевыеСвойства.УпаковкаНоменклатуры,
			ПравилаЗаполнения);
			
		ПолученныеДанные.НаименованиеУпаковки = ДанныеУпаковки.НаименованиеУпаковки;
		
		Если Не ЗначениеЗаполнено(ДанныеУпаковки.Коэффициент) Тогда
			ПолученныеДанные.КоличествоУпаковок = 1;
			ПолученныеДанные.КоличествоБазовойЕдиницыИзмерения = 1;
		Иначе
			ПолученныеДанные.КоличествоУпаковок = 1;
			ПолученныеДанные.КоличествоБазовойЕдиницыИзмерения = ДанныеУпаковки.Коэффициент;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеУпаковки.ЕдиницаИзмерения) Тогда
			ПравилаЗаполнения = Новый Соответствие;
			ПравилаЗаполнения.Вставить("Код", "КодОКЕИБазовойЕдиницыИзмерения");
			ПравилаЗаполнения.Вставить("Наименование", "НаименованиеБазовойЕдиницыИзмерения");
			ДанныеЕдиницыИзмерения = ДанныеКоллекцииВВидеСтруктуры(
				ДанныеУпаковки.ЕдиницаИзмерения, ПравилаЗаполнения);
		
			ЗаполнитьЗначенияСвойств(ПолученныеДанные, ДанныеЕдиницыИзмерения);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_SKUКонтрагента_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	ДанныеДляЗаписиВИБ.НаименованиеПолное = ?(ПустаяСтрока(ДанныеДляЗаписиВИБ.НаименованиеПолное),
		ДанныеДляЗаписиВИБ.НаименованиеНоменклатуры, ДанныеДляЗаписиВИБ.НаименованиеПолное);
КонецПроцедуры
Процедура ПКО_Справочник_БанковскиеСчета_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	// Владелец: выбираем ПКО в зависимости от типа владельца.
	Если ДанныеXDTO.КлючевыеСвойства.Свойство("Владелец") Тогда
	
		Владелец = ДанныеXDTO.КлючевыеСвойства.Владелец;		
		Если СтрНайти(Владелец.ТипЗначения, "Контрагент") > 0 Тогда
			ИмяПКО = "Справочник_Контрагенты_Получение";
		ИначеЕсли СтрНайти(Владелец.ТипЗначения, "Организация") > 0 Тогда
	        ИмяПКО = "Справочник_Организации_Получение";
		Иначе
			НаименованиеСчета = "";
			Если ДанныеXDTO.Свойство("Наименование") Тогда
				НаименованиеСчета = ДанныеXDTO.Наименование;
			КонецЕсли;
			ЗарегистрироватьОшибкуЗаписиБанковскогоСчета(НаименованиеСчета);
			Возврат;	
		КонецЕсли;
		
		ПолученныеДанные.ДополнительныеСвойства.Вставить(
			"Владелец", Новый Структура("Значение,ИмяПКО", Владелец, ИмяПКО));
		
	КонецЕсли
КонецПроцедуры
Процедура ПКО_Справочник_БанковскиеСчета_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.Владелец) Тогда
		ПолученныеДанные = Неопределено;
		Возврат;
	КонецЕсли;
	
	Валютный = Ложь;
	Если ЗначениеЗаполнено(ПолученныеДанные.ВалютаДенежныхСредств) Тогда
		Валютный = ПолученныеДанные.ВалютаДенежныхСредств <> Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	ПолученныеДанные.Валютный = Валютный;
	
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.Наименование)
		И (ДанныеИБ = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ДанныеИБ.Наименование)) Тогда
		ПолученныеДанные.Наименование = КлиентЭДОКлиентСервер.НаименованиеБанковскогоСчетаПоУмолчанию(
			ПолученныеДанные.НомерСчета, ПолученныеДанные.Банк, ПолученныеДанные.Владелец, Валютный);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ИнформативныеОстатки_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные = Неопределено;
	
	Товары = Неопределено;
	Если Не ДанныеXDTO.Свойство("Товары", Товары)
		ИЛИ Не ЗначениеЗаполнено(Товары) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСклада = Неопределено;
	Если Не ДанныеXDTO.КлючевыеСвойства.Свойство("Склад", ДанныеСклада)
		ИЛИ Не ЗначениеЗаполнено(ДанныеСклада) Тогда
		Возврат;
	КонецЕсли;
	
	Склад = СсылкаПоДаннымXDTO(КомпонентыОбмена, ДанныеСклада, "Справочник_Склады_Получение");
	
	ДанныеОрганизации = Неопределено;
	Если ДанныеXDTO.КлючевыеСвойства.Свойство("Организация", ДанныеОрганизации)
		И ЗначениеЗаполнено(ДанныеОрганизации) Тогда
		Организация = СсылкаПоДаннымXDTO(КомпонентыОбмена, ДанныеОрганизации, "Справочник_Организации_Получение");
	Иначе
		Организация = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	ПКОНоменклатуры = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Номенклатура_Получение");
	
	ЕстьХарактеристики = Товары.Колонки.Найти("Характеристика") <> Неопределено;
	Если ЕстьХарактеристики Тогда 
		ПКОХарактеристики = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_ХарактеристикиНоменклатуры");
	КонецЕсли;
	
	ЕстьУпаковки = Товары.Колонки.Найти("Упаковка") <> Неопределено;
	Если ЕстьУпаковки Тогда 
		ПКОУпаковки = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_ЕдиницыИзмерения");
	КонецЕсли;
	
	ИнформативныеОстатки = Новый ТаблицаЗначений;
	ИнформативныеОстатки.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ИнформативныеОстатки.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ИнформативныеОстатки.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.ЕдиницыИзмерения"));
	ИнформативныеОстатки.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	
	Для Каждого СтрокаТаблицы Из Товары Цикл
		
		Номенклатура = СсылкаПоДаннымXDTO(КомпонентыОбмена, СтрокаТаблицы.Номенклатура, ПКОНоменклатуры);
		
		Характеристика = Неопределено;
		Если ЕстьХарактеристики И ЗначениеЗаполнено(СтрокаТаблицы.Характеристика) Тогда
			Характеристика = СсылкаПоДаннымXDTO(КомпонентыОбмена, СтрокаТаблицы.Характеристика, ПКОХарактеристики);
		КонецЕсли;
		
		Упаковка = Неопределено;
		Если ЕстьУпаковки И ЗначениеЗаполнено(СтрокаТаблицы.Упаковка) Тогда
			Упаковка = СсылкаПоДаннымXDTO(КомпонентыОбмена, СтрокаТаблицы.Упаковка, ПКОУпаковки);
		КонецЕсли;
		
		НоваяСтрока = ИнформативныеОстатки.Добавить();
		НоваяСтрока.Номенклатура     = Номенклатура;
		НоваяСтрока.Характеристика   = Характеристика;
		НоваяСтрока.ЕдиницаИзмерения = Упаковка;
		НоваяСтрока.Количество       = СтрокаТаблицы.КоличествоНаСкладе;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ИнформативныеОстатки) Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ПрайсЛист");
		ЭлементБлокировки.ИсточникДанных = ИнформативныеОстатки;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Характеристика", "Характеристика");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ЕдиницаИзмерения", "ЕдиницаИзмерения");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаОстатков.Номенклатура КАК Номенклатура,
			|	ТаблицаОстатков.Характеристика КАК Характеристика,
			|	ТаблицаОстатков.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ТаблицаОстатков.Количество КАК Количество
			|ПОМЕСТИТЬ ВТ_Остатки
			|ИЗ
			|	&ТаблицаОстатков КАК ТаблицаОстатков
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ВТ_Остатки.Номенклатура КАК Номенклатура,
			|	ВТ_Остатки.Характеристика КАК Характеристика,
			|	ВТ_Остатки.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ВТ_Остатки.Количество КАК Количество,
			|	ПрайсЛист.ВидЦены КАК ВидЦены,
			|	ПрайсЛист.Цена КАК Цена,
			|	ПрайсЛист.Оценка КАК Оценка
			|ИЗ
			|	ВТ_Остатки КАК ВТ_Остатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрайсЛист КАК ПрайсЛист
			|		ПО ВТ_Остатки.Номенклатура = ПрайсЛист.Номенклатура
			|			И ВТ_Остатки.Характеристика = ПрайсЛист.Характеристика
			|			И ВТ_Остатки.ЕдиницаИзмерения = ПрайсЛист.ЕдиницаИзмерения
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ВТ_Остатки.Номенклатура КАК Номенклатура,
			|	ВТ_Остатки.Характеристика КАК Характеристика,
			|	ВТ_Остатки.ЕдиницаИзмерения КАК ЕдиницаИзмерения
			|ИЗ
			|	ВТ_Остатки КАК ВТ_Остатки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПрайсЛист КАК ПрайсЛист
			|		ПО ВТ_Остатки.Номенклатура = ПрайсЛист.Номенклатура
			|			И ВТ_Остатки.Характеристика = ПрайсЛист.Характеристика
			|			И ВТ_Остатки.ЕдиницаИзмерения = ПрайсЛист.ЕдиницаИзмерения
			|			И (ПрайсЛист.Склад = &ПустойСклад)";
			
		ПустойСклад = Справочники.Склады.ПустаяСсылка();
		Запрос.УстановитьПараметр("ТаблицаОстатков", ИнформативныеОстатки);
		Запрос.УстановитьПараметр("ПустойСклад", ПустойСклад);
		
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
		НаборЗаписей = РегистрыСведений.ПрайсЛист.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Склад.Установить(Склад);
		НаборЗаписей.Отбор.Организация.Установить(Организация);
		
		Выборка = РезультатыЗапроса[1].Выбрать();
		Пока Выборка.Следующий() Цикл
			Запись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, Выборка);
			Запись.Организация = Организация;
			Запись.Склад = Склад;
		КонецЦикла;
		
		ОбменДаннымиXDTOСервер.ЗаписатьОбъектВИБ(КомпонентыОбмена, НаборЗаписей, "РегистрСведенийНаборЗаписей.ПрайсЛист"); 
		
		Если Не РезультатыЗапроса[2].Пустой() Тогда
			ВыборкаУдаление = РезультатыЗапроса[2].Выбрать();
			Пока ВыборкаУдаление.Следующий() Цикл
				УдалитьНаборЗаписей = РегистрыСведений.ПрайсЛист.СоздатьНаборЗаписей();
				УдалитьНаборЗаписей.Отбор.Номенклатура.Установить(ВыборкаУдаление.Номенклатура);
				УдалитьНаборЗаписей.Отбор.Характеристика.Установить(ВыборкаУдаление.Характеристика);
				УдалитьНаборЗаписей.Отбор.ЕдиницаИзмерения.Установить(ВыборкаУдаление.ЕдиницаИзмерения);
				УдалитьНаборЗаписей.Отбор.Склад.Установить(ПустойСклад);
				ОбменДаннымиXDTOСервер.ЗаписатьОбъектВИБ(КомпонентыОбмена, УдалитьНаборЗаписей, "РегистрСведенийНаборЗаписей.ПрайсЛист"); 
			КонецЦикла;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры
Процедура ПКО_Справочник_КонтактныеЛица_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ДанныеXDTO.КлючевыеСвойства.Свойство("Владелец")
		И Не ЗначениеЗаполнено(ПолученныеДанные.Владелец) Тогда
		
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Владелец", 
			ДанныеXDTO.КлючевыеСвойства.Владелец);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_Контрагенты_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	УстановитьПоляПоискаКонтрагента(КомпонентыОбмена, ДанныеXDTO);
	
	СтранаРегистрацииДанныеXDTO = Неопределено;
	Если ПолученныеДанные.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо
		И ДанныеXDTO.КлючевыеСвойства.Свойство("СтранаРегистрации", СтранаРегистрацииДанныеXDTO)
		И ЗначениеЗаполнено(СтранаРегистрацииДанныеXDTO)
		И ЗначениеЗаполнено(СтранаРегистрацииДанныеXDTO.Код)
		И СтранаРегистрацииДанныеXDTO.Код <> "643" Тогда
		
		ПолученныеДанные.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент;
	КонецЕсли;
	
	ЗагрузитьКонтактнуюИнформацию(ДанныеXDTO, ПолученныеДанные, Справочники.ВидыКонтактнойИнформации.СправочникКонтрагенты);
КонецПроцедуры
Процедура ПКО_Справочник_Контрагенты_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.НаименованиеПолное) Тогда
		ПолученныеДанные.НаименованиеПолное = ПолученныеДанные.Наименование;
	КонецЕсли;
	Если ДанныеИБ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Заменяем свойства, которые получили из XDTO.
	ЗаполнитьНеПустыеСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
	// Виды контактной информации и дополнительные реквизиты, которые есть в данных ИБ
	// не удаляются, если этих значений нет в полученных данных.
	// Если значение есть - то оно обновляется.
	ЗаполнитьКонтактнуюИнформациюВДанныеИБ(ПолученныеДанные, ДанныеИБ);
	
	ПолученныеДанные = Неопределено;
КонецПроцедуры
Процедура ПКО_Справочник_Номенклатура_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ДанныеXDTO.Свойство("Группа") И ЗначениеЗаполнено(ДанныеXDTO.Группа) Тогда
		ПравилоКонвертацииСвойства = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_НоменклатураГруппа");
		НоменклатураГруппа = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, ДанныеXDTO.Группа, ПравилоКонвертацииСвойства).Ссылка;
		ПолученныеДанные.Родитель = НоменклатураГруппа;
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("СтавкаНДС") Тогда	
		СтавкаНДС = СтавкаНДСПоЗначениюXDTO(КомпонентыОбмена, ДанныеXDTO.СтавкаНДС);
		ПолученныеДанные.СтавкаНДС = СтавкаНДС;
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ВидНоменклатуры") И ЗначениеЗаполнено(ДанныеXDTO.ВидНоменклатуры) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ВидНоменклатуры", ДанныеXDTO.ВидНоменклатуры);
	
	ИначеЕсли ДанныеXDTO.Свойство("ТипНоменклатуры") И ЗначениеЗаполнено(ДанныеXDTO.ТипНоменклатуры) Тогда
		ПравилоКонвертацииЗначения = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.Найти(
			"ТипыНоменклатуры_Получение", "ИмяПКПД");
		Если ПравилоКонвертацииЗначения <> Неопределено Тогда
			ТипНоменклатуры = ПравилоКонвертацииЗначения.КонвертацииЗначенийПриПолучении.Получить(ДанныеXDTO.ТипНоменклатуры.Значение);
			Если ТипНоменклатуры <> Неопределено Тогда
				ПолученныеДанные.ДополнительныеСвойства.Вставить("ТипНоменклатуры", ТипНоменклатуры);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена, Истина);
КонецПроцедуры
Процедура ПКО_Справочник_Номенклатура_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ТипНоменклатуры = Неопределено;
	Если (ДанныеИБ = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ДанныеИБ.ВидНоменклатуры))
		И ПолученныеДанные.ДополнительныеСвойства.Свойство("ТипНоменклатуры", ТипНоменклатуры)
		И ЗначениеЗаполнено(ТипНоменклатуры) Тогда
		
		ВидНоменклатуры = КомпонентыОбмена.ПараметрыКонвертации.ВидыНоменклатурыПоУмолчанию.Получить(ТипНоменклатуры);
		
		Если ВидНоменклатуры = Неопределено Тогда
		
			НеобходимоСоздатьЭлемент = Ложь;
			
			Если ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар Тогда
				НаименованиеЭлементаДляОбменаПоУмолчанию = НСтр("ru = 'Товар'", Метаданные.ОсновнойЯзык.КодЯзыка); // строка записывается в ИБ
			ИначеЕсли ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
				НаименованиеЭлементаДляОбменаПоУмолчанию = НСтр("ru = 'Услуга'", Метаданные.ОсновнойЯзык.КодЯзыка); // строка записывается в ИБ
			ИначеЕсли ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа Тогда
				НаименованиеЭлементаДляОбменаПоУмолчанию = НСтр("ru = 'Работа'", Метаданные.ОсновнойЯзык.КодЯзыка); // строка записывается в ИБ
			КонецЕсли;
			
			Запрос = Новый Запрос(
				"ВЫБРАТЬ ПЕРВЫЕ 2
				|	ВидыНоменклатуры.Ссылка КАК ВидНоменклатуры,
				|	ВЫБОР
				|		КОГДА ВидыНоменклатуры.Наименование = &НаименованиеЭлементаДляОбменаПоУмолчанию
				|			ТОГДА ИСТИНА
				|		ИНАЧЕ ЛОЖЬ
				|	КОНЕЦ КАК ЭтоЭлементПоУмолчаниюДляОбмена
				|ИЗ
				|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
				|ГДЕ
				|	НЕ ВидыНоменклатуры.ПометкаУдаления
				|	И ВидыНоменклатуры.ТипНоменклатуры = &ТипНоменклатуры
				|
				|УПОРЯДОЧИТЬ ПО
				|	ЭтоЭлементПоУмолчаниюДляОбмена УБЫВ");
	
			Запрос.УстановитьПараметр("ТипНоменклатуры", ТипНоменклатуры);
			Запрос.УстановитьПараметр("НаименованиеЭлементаДляОбменаПоУмолчанию", НаименованиеЭлементаДляОбменаПоУмолчанию);
			РезультатЗапроса = Запрос.Выполнить();
			Выборка = РезультатЗапроса.Выбрать();
			
			Если Выборка.Следующий() Тогда
				Если Выборка.Количество() = 1 Или Выборка.ЭтоЭлементПоУмолчаниюДляОбмена Тогда
					ВидНоменклатуры = Выборка.ВидНоменклатуры;
				Иначе
					НеобходимоСоздатьЭлемент = Истина;
				КонецЕсли;
			Иначе
				НеобходимоСоздатьЭлемент = Истина;
			КонецЕсли;
	
			// Создание элемента для обмена с заданными параметрами
			Если НеобходимоСоздатьЭлемент Тогда
				
				ВидНоменклатурыОбъект = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
				
				ВидНоменклатурыОбъект.Наименование    = НаименованиеЭлементаДляОбменаПоУмолчанию;
				ВидНоменклатурыОбъект.ТипНоменклатуры = ТипНоменклатуры;
				ВидНоменклатурыОбъект.Описание        = НСтр("ru = '#Создан автоматически при обмене на основе универсального формата данных'", Метаданные.ОсновнойЯзык.КодЯзыка); // строка записывается в ИБ
				
				Попытка
					ВидНоменклатурыОбъект.Записать();
					ВидНоменклатуры = ВидНоменклатурыОбъект.Ссылка;
				Исключение
					ВидНоменклатуры = Справочники.ВидыНоменклатуры.ПустаяСсылка();
					ЗаписатьОшибкуВЖурналРегистрации(ВидНоменклатуры,
						ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), КомпонентыОбмена);
				КонецПопытки
				
			КонецЕсли;
			
			КомпонентыОбмена.ПараметрыКонвертации.ВидыНоменклатурыПоУмолчанию.Вставить(ТипНоменклатуры, ВидНоменклатуры);
			
		КонецЕсли;
		
		ПолученныеДанные.ВидНоменклатуры = ВидНоменклатуры;
		
	ИначеЕсли ДанныеИБ <> Неопределено Тогда
		
		ПолученныеДанные.ВидНоменклатуры = ДанныеИБ.ВидНоменклатуры;
		
	КонецЕсли;
	
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
								ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
КонецПроцедуры
Процедура ПКО_Справочник_Организации_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ЗагрузитьКонтактнуюИнформацию(ДанныеXDTO, ПолученныеДанные, Справочники.ВидыКонтактнойИнформации.СправочникОрганизации)
КонецПроцедуры
Процедура ПКО_Справочник_Организации_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.НаименованиеСокращенное) Тогда
		Если ЗначениеЗаполнено(ПолученныеДанные.НаименованиеПолное) Тогда
			ПолученныеДанные.НаименованиеСокращенное = ПолученныеДанные.НаименованиеПолное;
		Иначе
			ПолученныеДанные.НаименованиеСокращенное = ПолученныеДанные.Наименование;
		КонецЕсли;
	КонецЕсли;
	Если ДанныеИБ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Заменяем свойства, которые получили из XDTO.
	ЗаполнитьНеПустыеСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
	// Виды контактной информации и дополнительные реквизиты, которые есть в данных ИБ
	// не удаляются, если этих значений нет в полученных данных.
	// Если значение есть - то оно обновляется.
	ЗаполнитьКонтактнуюИнформациюВДанныеИБ(ПолученныеДанные, ДанныеИБ);
	
	ПолученныеДанные = Неопределено;
КонецПроцедуры
Процедура ПКО_Справочник_ШтрихкодыНоменклатуры_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ДанныеXDTO.Свойство("ШтрихкодОтбор") Тогда
		Штрихкод = ДанныеXDTO.ШтрихкодОтбор;
	Иначе
		Штрихкод = ДанныеXDTO.Штрихкод;
	КонецЕсли;
	
	ПолученныеДанные.ДополнительныеСвойства.Вставить("Штрихкод", Штрихкод);
	ПолученныеДанные.ДополнительныеСвойства.Вставить("Записи", Неопределено);
	
	Если ДанныеXDTO.Свойство("Записи")
		И ЗначениеЗаполнено(ДанныеXDTO.Записи) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Записи", ДанныеXDTO.Записи);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ШтрихкодыНоменклатуры_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Справочник_Номенклатура_Получение = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена,"Справочник_Номенклатура_Получение");
	Справочник_ХарактеристикиНоменклатуры = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена,"Справочник_ХарактеристикиНоменклатуры");
	Справочник_ЕдиницыИзмерения = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена,"Справочник_ЕдиницыИзмерения");
	
	ПолученныеДанные.Отбор.Штрихкод.Значение = ПолученныеДанные.ДополнительныеСвойства.Штрихкод;
	ПолученныеДанные.Отбор.Штрихкод.Использование = Истина;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Записи <> Неопределено Тогда
		Для Каждого Строка Из ПолученныеДанные.ДополнительныеСвойства.Записи Цикл
			СтрокаЗаписи = ПолученныеДанные.Добавить();
			СтрокаЗаписи.Штрихкод = ПолученныеДанные.ДополнительныеСвойства.Штрихкод;
			
			СтрокаЗаписи.Номенклатура = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, 
				Строка.Номенклатура, 
				Справочник_Номенклатура_Получение, 
				"ПолучитьСсылку").Ссылка;
				
			Если ЗначениеЗаполнено(Строка.Характеристика) Тогда
				СтрокаЗаписи.Характеристика = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, 
					Строка.Характеристика, 
					Справочник_ХарактеристикиНоменклатуры, 
					"ПолучитьСсылку").Ссылка;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Строка.Упаковка) Тогда
				СтрокаЗаписи.ЕдиницаИзмерения = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, 
					Строка.Упаковка.ЕдиницаИзмерения, 
					Справочник_ЕдиницыИзмерения, 
					"ПолучитьСсылку").Ссылка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_ТорговоеПредложение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПравилоКонвертацииСвойстваЕдиницыИзмерения = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_ЕдиницыИзмерения");
		ПравилоКонвертацииСвойстваНоменклатура = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Номенклатура_Получение");
		ПравилоКонвертацииСвойстваВидыЦен = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_ВидыЦен");
		ПравилоКонвертацииСвойстваХарактеристика = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_ХарактеристикиНоменклатуры");
		
		ПолученныеДанные.Очистить();
		
		Для Каждого Товар Из ДанныеXDTO.Товары Цикл 
			
			ЕдиницаИзмерения = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, Товар.ЕдиницаИзмерения, ПравилоКонвертацииСвойстваЕдиницыИзмерения).Ссылка;
			Номенклатура = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, Товар.Номенклатура, ПравилоКонвертацииСвойстваНоменклатура).Ссылка;
			
			Если Товар.Характеристика <> Неопределено Тогда 
				Характеристика = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, Товар.Характеристика, ПравилоКонвертацииСвойстваХарактеристика).Ссылка;
			Иначе 
				Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
			КонецЕсли;
	
			КлючСтроки = Товар.КлючСтроки;
			Количество = Товар.Количество;
			Наличие = Товар.Наличие;
			МассивСтрок = ДанныеXDTO.Цены.НайтиСтроки(Новый Структура("КлючСтроки", КлючСтроки));
			Для Каждого СтрокаЦены Из МассивСтрок Цикл 
				
				ВидЦены = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, СтрокаЦены.ТипЦены, ПравилоКонвертацииСвойстваВидыЦен).Ссылка;
				Цена = СтрокаЦены.Цена;
				
				СтрокаПрайсЛиста = ПолученныеДанные.Добавить();
				СтрокаПрайсЛиста.ЕдиницаИзмерения = ЕдиницаИзмерения;
				СтрокаПрайсЛиста.Характеристика = Характеристика;
				СтрокаПрайсЛиста.Номенклатура = Номенклатура;
				СтрокаПрайсЛиста.ВидЦены = ВидЦены;
				СтрокаПрайсЛиста.Количество = Количество;
				СтрокаПрайсЛиста.Оценка = Наличие;
				СтрокаПрайсЛиста.Цена = Цена;
	
			КонецЦикла;
		КонецЦикла;
	
		ПолученныеДанные.Записать();
		
		СтруктураПараметров = Новый Структура();
		СтруктураПараметров.Вставить("СписокТоваров"		, Неопределено);
		СтруктураПараметров.Вставить("ТорговоеПредложение"	, Неопределено);
	
	
		РегистрыСведений.ПрайсЛист.ОбновитьТоварыТорговыхПредложений(СтруктураПараметров, Неопределено);
КонецПроцедуры

#КонецОбласти
#Область ОтправкаИПолучение
Процедура ПКО_Справочник_Валюты_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.СпособУстановкиКурса = Перечисления.СпособыУстановкиКурсаВалюты.РучнойВвод;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.6") Тогда
		СвойствоПараметрыПрописи = "ПараметрыПрописи";
	Иначе
		СвойствоПараметрыПрописи = "ПараметрыПрописиНаРусском";
	КонецЕсли;
	Если ДанныеXDTO.Свойство(СвойствоПараметрыПрописи) Тогда
		ПолученныеДанные.ПараметрыПрописи = ДанныеXDTO[СвойствоПараметрыПрописи];
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_Валюты_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ДанныеИБ <> Неопределено
		И ЗначениеЗаполнено(ДанныеИБ.СпособУстановкиКурса) Тогда
		ПолученныеДанные.СпособУстановкиКурса = ДанныеИБ.СпособУстановкиКурса;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ВидыЦен_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ДанныеXDTO.Свойство("Наименование") Тогда
		ПолученныеДанные.Наименование = ДанныеXDTO.Наименование;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ДополнительныеРеквизиты_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.Заголовок) Тогда
		ПолученныеДанные.Заголовок = ПолученныеДанные.Наименование;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ЕдиницыИзмерения_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если НЕ ЗначениеЗаполнено(ДанныеИБ.Код) Тогда
	
		Код = ДанныеИБ.МеждународноеСокращение;
		Если Не ЗначениеЗаполнено(Код) Тогда
			Код = ДанныеИБ.Наименование;
		КонецЕсли;
		
		Код = Лев(Код, 4);
		
		Если СтекВыгрузки.Количество() = 1 Тогда
			ДанныеXDTO.КлючевыеСвойства.Вставить("Код", Код);
		Иначе
			ДанныеXDTO.Вставить("Код", Код);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ЕдиницыИзмерения_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Наименование = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеXDTO.КлючевыеСвойства, "Наименование");
	
	Если ЗначениеЗаполнено(Наименование) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Наименование", Наименование);
	КонецЕсли;
	
	ПолученныеДанные.Код = СокрЛП(ПолученныеДанные.Код);
КонецПроцедуры
Процедура ПКО_Справочник_ЕдиницыИзмерения_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ДанныеИБ = Неопределено Тогда
		Наименование = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ПолученныеДанные.ДополнительныеСвойства, "Наименование", "");
		Ссылка = Справочники.ЕдиницыИзмерения.ЕдиницаИзмеренияПоКоду(СокрЛП(ПолученныеДанные.Код), Наименование);
		Если Ссылка <> Неопределено Тогда
			ДанныеИБ = Ссылка.ПолучитьОбъект();
		КонецЕсли;
	КонецЕсли;
	
	ПолученныеДанные = Неопределено;
КонецПроцедуры
Процедура ПКО_Справочник_НоменклатураГруппа_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ДанныеИБ <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ДанныеИБ, ПолученныеДанные,
			"Код,
			|Наименование");
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_Упаковки_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Номенклатура = Неопределено;
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.6") Тогда
		Если ЗначениеЗаполнено(ДанныеИБ.НоменклатураВладелец) Тогда
			Номенклатура = ДанныеИБ.НоменклатураВладелец;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		ДанныеXDTO.Вставить("Номенклатура", Номенклатура);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеИБ.Коэффициент) Тогда
		ДанныеXDTO.Вставить("Коэффициент", 1);
	КонецЕсли;  
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Если ЗначениеЗаполнено(Номенклатура) Тогда
			ДанныеXDTO.Вставить("Номенклатура", Номенклатура);
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		ДанныеXDTO.КлючевыеСвойства.Вставить("Номенклатура", Номенклатура);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеИБ.Коэффициент) Тогда
		ДанныеXDTO.КлючевыеСвойства.Вставить("Коэффициент", 1);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_Упаковки_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ДанныеXDTO.КлючевыеСвойства.Свойство("Номенклатура")
		И Не ЗначениеЗаполнено(ПолученныеДанные.НоменклатураВладелец) Тогда
		
		ПолученныеДанные.ДополнительныеСвойства.Вставить("НоменклатураВладелец", 
			ДанныеXDTO.КлючевыеСвойства.Номенклатура);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_Упаковки_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.НоменклатураВладелец) Тогда
		ПолученныеДанные = Неопределено;
		
		Возврат;
	КонецЕсли;
	
	Если ПолученныеДанные.Коэффициент = 0 Тогда
		ПолученныеДанные.Коэффициент = 1;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ФизическиеЛица_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если Не ДанныеXDTO.Свойство("ФИО") 
		Или Не ЗначениеЗаполнено(ДанныеXDTO.ФИО)
		Или (Не СокрЛП(ДанныеXDTO.ФИО) = СокрЛП(ДанныеИБ.Наименование)) Тогда
		
		ДанныеXDTO.Вставить("ФИО", ДанныеИБ.Наименование);
	КонецЕсли;
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	
	Если Не ДанныеXDTO.КлючевыеСвойства.Свойство("ФИО") 
		Или Не ЗначениеЗаполнено(ДанныеXDTO.ФИО)
		Или (Не СокрЛП(ДанныеXDTO.ФИО) = СокрЛП(ДанныеИБ.Наименование)) Тогда
		
		ДанныеXDTO.КлючевыеСвойства.Вставить("ФИО", ДанныеИБ.Наименование);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ФизическиеЛица_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ПустаяСтрока(ПолученныеДанные.Наименование) Тогда
		ПолученныеДанные.Наименование = ПолученныеДанные.ФИО;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ХарактеристикиНоменклатуры_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если КомпонентыОбмена.ПараметрыКонвертации.ТекущаяВерсияФорматаЧислом >= ВерсияФорматаЧислом("1.6")
		И ТипЗнч(ДанныеИБ.Владелец) = Тип("СправочникСсылка.Номенклатура") Тогда
			ДанныеXDTO.КлючевыеСвойства.Вставить("Номенклатура", ДанныеИБ.Владелец);
	ИначеЕсли КомпонентыОбмена.ПараметрыКонвертации.ТекущаяВерсияФорматаЧислом >= ВерсияФорматаЧислом("1.7")
		И ТипЗнч(ДанныеИБ.Владелец) = Тип("СправочникСсылка.ВидыНоменклатуры") Тогда
			ДанныеXDTO.КлючевыеСвойства.Вставить("ВидНоменклатуры", ДанныеИБ.Владелец);
	КонецЕсли;
												
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, Истина);
КонецПроцедуры
Процедура ПКО_Справочник_ХарактеристикиНоменклатуры_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ИнструкцияВладелец = Новый Структура;
	Если ДанныеXDTO.КлючевыеСвойства.Свойство("ВидНоменклатуры") Тогда
		ИнструкцияВладелец.Вставить("Значение", ДанныеXDTO.КлючевыеСвойства.ВидНоменклатуры);
		ИнструкцияВладелец.Вставить("ИмяПКО",   "Справочник_ВидыНоменклатуры_Получение");
	ИначеЕсли ДанныеXDTO.КлючевыеСвойства.Свойство("Номенклатура") Тогда
	
		Если КомпонентыОбмена.ПараметрыКонвертации.ТекущаяВерсияФорматаЧислом >= ВерсияФорматаЧислом("1.7") Тогда
			ИнструкцияВладелец.Вставить("Значение", ДанныеXDTO.КлючевыеСвойства.Номенклатура);
			ИнструкцияВладелец.Вставить("ИмяПКО",   "Справочник_Номенклатура_Получение");
		Иначе
			Номенклатура = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
				КомпонентыОбмена,
				ДанныеXDTO.КлючевыеСвойства.Номенклатура,
				ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Номенклатура_Получение"), 
				"ПолучитьСсылку");
			
			Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
				Реквизиты = Новый Структура("ВидНоменклатуры, ИспользоватьХарактеристики, ИндивидуальныеХарактеристикиНоменклатуры",
					"ВидНоменклатуры", "ВидНоменклатуры.ИспользоватьХарактеристики", "ВидНоменклатуры.ИндивидуальныеХарактеристикиНоменклатуры");
				РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, Реквизиты);
					
				Если Не ЗначениеЗаполнено(РеквизитыНоменклатуры.ВидНоменклатуры) Тогда
					Возврат;
				ИначеЕсли РеквизитыНоменклатуры.ИндивидуальныеХарактеристикиНоменклатуры Тогда
					ПолученныеДанные.Владелец = Номенклатура;
				ИначеЕсли РеквизитыНоменклатуры.ИспользоватьХарактеристики Тогда
					ПолученныеДанные.Владелец = РеквизитыНоменклатуры.ВидНоменклатуры;
				Иначе
					ЗарегистрироватьОшибкуНастройкиВидаНоменклатуры(РеквизитыНоменклатуры.ВидНоменклатуры, КомпонентыОбмена);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнструкцияВладелец) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Владелец", ИнструкцияВладелец);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ХарактеристикиНоменклатуры_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ВерсияФорматаЧислом17 = ВерсияФорматаЧислом("1.7");
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.Владелец)
		ИЛИ (НЕ ДанныеИБ = Неопределено И ТипЗнч(ДанныеИБ.Владелец) = Тип("СправочникСсылка.ВидыНоменклатуры")
		И КомпонентыОбмена.ПараметрыКонвертации.ТекущаяВерсияФорматаЧислом < ВерсияФорматаЧислом17) Тогда
		ПолученныеДанные = Неопределено;
		Возврат;
	КонецЕсли;
	
	Если ДанныеИБ = Неопределено
		И ЗначениеЗаполнено(ПолученныеДанные.Владелец)
		И КомпонентыОбмена.ПараметрыКонвертации.ТекущаяВерсияФорматаЧислом >= ВерсияФорматаЧислом17 Тогда
		КомпонентыОбмена.ПараметрыКонвертации.ВладельцыНовыхХарактеристик.Вставить(ПолученныеДанные.Владелец);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецОбласти
#Область Алгоритмы

Функция ВерсияФорматаЧислом(СтрокаВерсии)
	Если Не ЗначениеЗаполнено(СтрокаВерсии) Или СтрокаВерсии = "1.0.beta" Тогда
		Возврат 0;
	КонецЕсли;
	
	ВерсияФорматаЧислом = 0;
	
	РазрядыВерсии = СтрРазделить(СтрокаВерсии, ".");
	Если РазрядыВерсии.Количество() <> 2 Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Неправильный формат параметра СтрокаВерсии1: %1'"), СтрокаВерсии);
	КонецЕсли;
	
	МножительРазряда = 10000;
	Для ИндексРазрядаОбратный = 0 По 1 Цикл
		ВерсияФорматаЧислом = ВерсияФорматаЧислом + Число(РазрядыВерсии[ИндексРазрядаОбратный])*МножительРазряда;
		МножительРазряда = МножительРазряда / 100;
	КонецЦикла;
	Возврат ВерсияФорматаЧислом;
КонецФункции
Функция ВидКонтактнойИнформацииИзСтроки(ВидКИСтрокой, НаименованиеКИ, ГруппаВидовКИ)
	ТекВидКИ = Неопределено;
		
	ПрефиксПользовательскойКИ = "ПользовательскаяКИ";
			
	Если СтрНачинаетсяС(ВидКИСтрокой, ПрефиксПользовательскойКИ) Тогда
	
		ИмяТипаКИ = СтрЗаменить(ВидКИСтрокой, ПрефиксПользовательскойКИ, "");
	
		ТекВидКИ  = ВидПользовательскойКонтактнойИнформации(НаименованиеКИ,
			ГруппаВидовКИ,
			Перечисления.ТипыКонтактнойИнформации[ИмяТипаКИ]);
		
	Иначе
	
		СправочникВидыКИ = Справочники.ВидыКонтактнойИнформации;
		
		Если ГруппаВидовКИ = СправочникВидыКИ.СправочникКонтрагенты Тогда
			Если ВидКИСтрокой = "АдресЭлектроннойПочты" Тогда
				ТекВидКИ = СправочникВидыКИ.EmailКонтрагента;
			ИначеЕсли ВидКИСтрокой = "ПочтовыйАдрес" Тогда
				ТекВидКИ = СправочникВидыКИ.ПочтовыйАдресКонтрагента;
			ИначеЕсли ВидКИСтрокой = "ФактическийАдрес" Тогда
				ТекВидКИ = СправочникВидыКИ.ФактАдресКонтрагента;
			ИначеЕсли ВидКИСтрокой = "ЮридическийАдрес" Тогда
				ТекВидКИ = СправочникВидыКИ.ЮрАдресКонтрагента;
			ИначеЕсли ВидКИСтрокой = "Телефон" Тогда
				ТекВидКИ = СправочникВидыКИ.ТелефонКонтрагента;
			ИначеЕсли ВидКИСтрокой = "Факс" Тогда
				ТекВидКИ = СправочникВидыКИ.ФаксКонтрагента;
			КонецЕсли;
		ИначеЕсли ГруппаВидовКИ = СправочникВидыКИ.СправочникОрганизации Тогда
			Если ВидКИСтрокой = "АдресЭлектроннойПочты" Тогда
				ТекВидКИ = СправочникВидыКИ.EmailОрганизации;
			ИначеЕсли ВидКИСтрокой = "ПочтовыйАдрес" Тогда
				ТекВидКИ = СправочникВидыКИ.ПочтовыйАдресОрганизации;
			ИначеЕсли ВидКИСтрокой = "ФактическийАдрес" Тогда
				ТекВидКИ = СправочникВидыКИ.ФактАдресОрганизации;
			ИначеЕсли ВидКИСтрокой = "ЮридическийАдрес" Тогда
				ТекВидКИ = СправочникВидыКИ.ЮрАдресОрганизации;
			ИначеЕсли ВидКИСтрокой = "Телефон" Тогда
				ТекВидКИ = СправочникВидыКИ.ТелефонОрганизации;
			ИначеЕсли ВидКИСтрокой = "Факс" Тогда
				ТекВидКИ = СправочникВидыКИ.ФаксОрганизации;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТекВидКИ;
КонецФункции
Функция ВидПользовательскойКонтактнойИнформации(НаименованиеКИ, ГруппаВидовКИ, ТипКИ)
	ТекВидКИ = Неопределено;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВидыКонтактнойИнформации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыКонтактнойИнформации КАК ВидыКонтактнойИнформации
	|ГДЕ
	|	ВидыКонтактнойИнформации.Ссылка В ИЕРАРХИИ(&ГруппаВидовКИ)
	|	И ВидыКонтактнойИнформации.Наименование = &Наименование
	|	И ВидыКонтактнойИнформации.Тип = &ТипКИ
	|	И ВидыКонтактнойИнформации.Используется = ИСТИНА
	|	И ВидыКонтактнойИнформации.ЭтоГруппа = ЛОЖЬ");
	Запрос.УстановитьПараметр("ГруппаВидовКИ", ГруппаВидовКИ);
	Запрос.УстановитьПараметр("Наименование",  НаименованиеКИ);
	Запрос.УстановитьПараметр("ТипКИ",         ТипКИ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ТекВидКИ = Выборка.Ссылка;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекВидКИ) Тогда
		ТекВидКИ = НовыйВидКонтактнойИнформации(НаименованиеКИ, ГруппаВидовКИ, ТипКИ);
	КонецЕсли;
	
	Возврат ТекВидКИ;
КонецФункции
Процедура ВыгрузитьГрафикОплат(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, ИмяТаблицы)
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.8") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Запрос.УстановитьПараметр("ФормаОплаты", ?(ЗначениеЗаполнено(ДанныеИБ.ФормаОплаты),
		ДанныеИБ.ФормаОплаты, Перечисления.ФормыОплаты.Безналичная));
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	&ФормаОплаты КАК ФормаОплаты,
	|	Таблица.ВариантОплаты КАК ВариантОплаты,
	|	Таблица.ДатаПлатежа КАК ДатаПлатежа,
	|	Таблица.ПроцентПлатежа КАК ПроцентПлатежа,
	|	Таблица.СуммаПлатежа КАК СуммаПлатежа,
	|	Таблица.Сдвиг КАК КоличествоДнейОтсрочки
	|ИЗ
	|	&ИмяТаблицы КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяТаблицы", ИмяТаблицы);
	
	ДанныеXDTO.Вставить("ЭтапыОплаты", Запрос.Выполнить().Выгрузить());
КонецПроцедуры
Процедура ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, ЕстьДопРеквизиты = Ложь)
	ТаблицаДопРеквизитов = Новый ТаблицаЗначений;
	ТаблицаДопРеквизитов.Колонки.Добавить("Свойство");
	ТаблицаДопРеквизитов.Колонки.Добавить("ЗначениеСвойства");
	
	Если ЕстьДопРеквизиты Тогда
		ВыгрузкаДопРеквизитовИзТаблицыЗначений(ДанныеИБ.ДополнительныеРеквизиты, ТаблицаДопРеквизитов);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Свойство КАК Свойство,
	|	Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения
	|ГДЕ Объект = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	ДанныеИБДополнительныеРеквизиты = Запрос.Выполнить().Выгрузить();
	ВыгрузкаДопРеквизитовИзТаблицыЗначений(ДанныеИБДополнительныеРеквизиты, ТаблицаДопРеквизитов);
	Если ТаблицаДопРеквизитов.Количество() > 0 Тогда
		ДанныеXDTO.Вставить("ДополнительныеРеквизиты", ТаблицаДопРеквизитов);
	КонецЕсли;
КонецПроцедуры
Процедура ВыгрузитьНалогообложениеНДС(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, ИмяСвойства = "Налогообложение")
	ОтборБезНДС = Новый Структура("СтавкаНДС", Перечисления.СтавкиНДС.БезНДС);
	БезНДС = ДанныеИБ.Товары.НайтиСтроки(ОтборБезНДС).Количество() = ДанныеИБ.Товары.Количество();
	
	Если ДанныеИБ.ОблагаетсяНДСУПокупателя Тогда
		ДанныеXDTO.Вставить(ИмяСвойства, "НДСИсчисляетсяПокупателем");
	ИначеЕсли БезНДС Тогда
		ДанныеXDTO.Вставить(ИмяСвойства, "НеОблагаетсяНДС");
	Иначе	
		ДанныеXDTO.Вставить(ИмяСвойства, "ОблагаетсяНДС");
	КонецЕсли;
КонецПроцедуры
Процедура ВыгрузкаДопРеквизитов_ОпределитьИмяПКО(ЗначениеСвойства, ИмяПКО, ИмяПКОГруппа)
	ТипЗначенияСвойства = ТипЗнч(ЗначениеСвойства);
	Если ТипЗначенияСвойства = Тип("СправочникСсылка.Номенклатура") Тогда
		ИмяПКО = "Справочник_Номенклатура_Отправка";
		ИмяПКОГруппа = "Справочник_НоменклатураГруппа";
	ИначеЕсли ТипЗначенияСвойства = Тип("СправочникСсылка.ЗначенияСвойствОбъектов") Тогда
		ИмяПКО = "Справочник_ЗначенияДополнительныхРеквизитов";
	КонецЕсли;
КонецПроцедуры
Процедура ВыгрузкаДопРеквизитовИзТаблицыЗначений(ДанныеИБДополнительныеРеквизиты, ТаблицаДопРеквизитов)
	Для Каждого СтрокаТЧ Из ДанныеИБДополнительныеРеквизиты Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Свойство) ИЛИ НЕ ЗначениеЗаполнено(СтрокаТЧ.Значение) Тогда
			Продолжить;
		КонецЕсли;
		ТипЗначенияСвойства = ТипЗнч(СтрокаТЧ.Значение);
		ИмяПКО = "";
		ИмяПКОГруппа = "";
		Если ТипЗначенияСвойства = Тип("Число") 
			ИЛИ ТипЗначенияСвойства = Тип("Строка")
			ИЛИ ТипЗначенияСвойства = Тип("Булево")
			ИЛИ ТипЗначенияСвойства = Тип("Дата") Тогда
			НовСтрока = ТаблицаДопРеквизитов.Добавить();
			НовСтрока.Свойство = СтрокаТЧ.Свойство;
			НовСтрока.ЗначениеСвойства = СтрокаТЧ.Значение;
			Продолжить;
		КонецЕсли;
		ВыгрузкаДопРеквизитов_ОпределитьИмяПКО(СтрокаТЧ.Значение, ИмяПКО, ИмяПКОГруппа);
		Если ИмяПКО = "" Тогда
			Продолжить;
		КонецЕсли; 	
		Если ИмяПКОГруппа <> "" И СтрокаТЧ.Значение.ЭтоГруппа Тогда
			ТекИмяПКО = ИмяПКОГруппа;
		Иначе
			ТекИмяПКО = ИмяПКО;
		КонецЕсли;
		НовСтрока = ТаблицаДопРеквизитов.Добавить();
		НовСтрока.Свойство = СтрокаТЧ.Свойство;
		НовСтрока.ЗначениеСвойства = Новый Структура("Значение, ИмяПКО", СтрокаТЧ.Значение, ТекИмяПКО);
	КонецЦикла;
КонецПроцедуры
Функция ДанныеКоллекцииВВидеСтруктуры(Источник, ПравилаЗаполнения)
	Результат = Новый Структура;
	СтруктураДляПереносаЗначения = Новый Структура;
	Для Каждого ПравилоЗаполнения Из ПравилаЗаполнения Цикл
		СтруктураДляПереносаЗначения.Вставить(ПравилоЗаполнения.Ключ);
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(СтруктураДляПереносаЗначения, Источник);
	
	Для Каждого ПравилоЗаполнения Из ПравилаЗаполнения Цикл
		Значение = СтруктураДляПереносаЗначения[ПравилоЗаполнения.Ключ];
		Если Значение <> Неопределено Тогда
			Результат.Вставить(ПравилоЗаполнения.Значение, Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции
Процедура ДополнитьЗапросДаннымиНоменклатурыКонтрагента(ЗапросКТабличнойЧасти, ТаблицаОтбора, СоставДанныхНоменклатурыКонтрагента, НомерЗапросаВПакете = Неопределено)
	Схема = Новый СхемаЗапроса;
	
	Схема.УстановитьТекстЗапроса(ЗапросКТабличнойЧасти.Текст);
	
	Если НомерЗапросаВПакете = Неопределено Тогда
		НомерЗапросаВПакете = Схема.ПакетЗапросов.Количество() - 1;
	КонецЕсли;	
		
	Запрос = Схема.ПакетЗапросов[НомерЗапросаВПакете];
	
	// Колонки должны присутствовать в запросе.
	// По ним будет происходить соединение с временной таблицей.
	КолонкаНомерСтроки = Запрос.Колонки.Найти("НомерСтроки");
	КолонкаНоменклатураКонтрагента = Запрос.Колонки.Найти("SKUКонтрагентаСсылка");
	Если КолонкаНомерСтроки = Неопределено Или КолонкаНоменклатураКонтрагента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Получение номенклатуры контрагента по таблице отбора
	ИмяВременнойТаблицы = "втНоменклатураКонтрагента";
	
	КоличествоКолонок = Запрос.Колонки.Количество();
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	СопоставлениеНоменклатурыКонтрагентов.СоздатьВременнуюТаблицуНоменклатурыКонтрагентовПоТаблицеОтборов(
		ТаблицаОтбора, ИмяВременнойТаблицы, МенеджерВременныхТаблиц);
	
	ТаблицаНоменклатурыКонтрагента = Запрос.Операторы[0].Источники.Добавить(
		Тип("ОписаниеВременнойТаблицыСхемыЗапроса"),
		ИмяВременнойТаблицы,
		ИмяВременнойТаблицы);
		
	// Ключи для соединения
	ТаблицаНоменклатурыКонтрагента.Источник.ДоступныеПоля.Добавить(
		"НомерСтроки",
		ТаблицаОтбора.Колонки["НомерСтроки"].ТипЗначения);
		
	ТаблицаНоменклатурыКонтрагента.Источник.ДоступныеПоля.Добавить(
		"НоменклатураКонтрагента",
		Тип("СправочникСсылка.НоменклатураКонтрагентов"));
		
	// Данные номенклатуры контрагента
	Для Каждого КлючЗначение Из СоставДанныхНоменклатурыКонтрагента Цикл
		ТаблицаНоменклатурыКонтрагента.Источник.ДоступныеПоля.Добавить(КлючЗначение.Ключ);
			
		Запрос.Операторы[0].ВыбираемыеПоля.Добавить(
		СтрШаблон("ЕСТЬNULL(%1.%2, """")", ИмяВременнойТаблицы, КлючЗначение.Ключ),
		КоличествоКолонок);
		
		Запрос.Колонки[КоличествоКолонок].Псевдоним = КлючЗначение.Значение;
		
		КоличествоКолонок = КоличествоКолонок + 1;
	КонецЦикла;
	
	// Подстановка данных номенклатуры контрагента в результирующую выборку
	ТаблицаНоменклатурыКонтрагента.Соединения.Добавить(Запрос.Операторы[0].Источники[0]);
	
	Соединение = ТаблицаНоменклатурыКонтрагента.Соединения[ТаблицаНоменклатурыКонтрагента.Соединения.Количество() - 1];
	Соединение.ТипСоединения = ТипСоединенияСхемыЗапроса.ПравоеВнешнее;
	Соединение.Условие = Новый ВыражениеСхемыЗапроса(
		СтрШаблон(
			"%1 = %3.НомерСтроки И %2 = %3.НоменклатураКонтрагента
			| И ВЫРАЗИТЬ(%2 КАК Справочник.НоменклатураКонтрагентов) <> ЗНАЧЕНИЕ(Справочник.НоменклатураКонтрагентов.)",
			Строка(Запрос.Операторы[0].ВыбираемыеПоля[Запрос.Колонки.Индекс(КолонкаНомерСтроки)]),
			Строка(Запрос.Операторы[0].ВыбираемыеПоля[Запрос.Колонки.Индекс(КолонкаНоменклатураКонтрагента)]),
			ИмяВременнойТаблицы));
	
	ЗапросКТабличнойЧасти.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ЗапросКТабличнойЧасти.Текст = Схема.ПолучитьТекстЗапроса();
КонецПроцедуры
Процедура ЗагрузитьАкцизныеМарки(ДанныеXDTO, ПолученныеДанные)
	АкцизныеМарки = Неопределено;
	Если Не ДанныеXDTO.Свойство("АкцизныеМарки", АкцизныеМарки)
		ИЛИ Не ЗначениеЗаполнено(АкцизныеМарки) Тогда
		Возврат;
	КонецЕсли;
	
	Товары = Неопределено;
	Если Не ДанныеXDTO.Свойство("Товары", Товары)
		ИЛИ Не ЗначениеЗаполнено(Товары) Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтрокТовары = Неопределено;
	ПолученныеДанные.ДополнительныеСвойства.Свойство("Товары", МассивСтрокТовары);
		
	МассивАкцизныхМарок = Новый Массив;
	Для Каждого СтрокаТаблицы Из АкцизныеМарки Цикл
		
		Если ПустаяСтрока(СтрокаТаблицы.НомерАкцизнойМарки) Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураАкцизнойМарки = Новый Структура("НомерУпаковки, ИдентификаторСтроки");
		СтруктураАкцизнойМарки.НомерУпаковки = СтрокаТаблицы.НомерАкцизнойМарки;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторСтроки) Тогда
			НайденнаяСтрока = Товары.Найти(СтрокаТаблицы.ИдентификаторСтроки, "ИдентификаторСтроки");
			Если НайденнаяСтрока <> Неопределено Тогда
				СтруктураАкцизнойМарки.ИдентификаторСтроки = СтрокаТаблицы.ИдентификаторСтроки;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(СтрокаТаблицы.НомерСтрокиДокумента)
			И ЗначениеЗаполнено(МассивСтрокТовары)
			И МассивСтрокТовары.Количество() >= СтрокаТаблицы.НомерСтрокиДокумента Тогда
			СтруктураАкцизнойМарки.ИдентификаторСтроки = 
				МассивСтрокТовары[СтрокаТаблицы.НомерСтрокиДокумента - 1].ИдентификаторСтроки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураАкцизнойМарки.ИдентификаторСтроки) Тогда
			МассивАкцизныхМарок.Добавить(СтруктураАкцизнойМарки);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивАкцизныхМарок.Количество() Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("КодыУпаковокМаркируемойПродукции", МассивАкцизныхМарок);
	КонецЕсли;
КонецПроцедуры
Процедура ЗагрузитьГрафикОплат(КомпонентыОбмена, ДанныеXDTO, ПолученныеДанные)
	Если Не ДанныеXDTO.Свойство("ЭтапыОплаты")
		Или Не ЗначениеЗаполнено(ДанныеXDTO.ЭтапыОплаты) Тогда
		
		Возврат;
	КонецЕсли;
		
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("ВариантОплаты", "ВариантОплаты");
	ПравилаЗаполнения.Вставить("ДатаПлатежа", "ДатаПлатежа");
	ПравилаЗаполнения.Вставить("ПроцентПлатежа","ПроцентПлатежа");
	ПравилаЗаполнения.Вставить("КоличествоДнейОтсрочки", "Сдвиг");
	ПравилаЗаполнения.Вставить("СуммаПлатежа", "СуммаПлатежа");
	
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ФормаОплаты",
		Новый Структура("Значение, ИмяПКО",
			ДанныеXDTO.ЭтапыОплаты[0].ФормаОплаты, "ФормыОплаты"));
	
	ЭтапыГрафикаОплаты = Новый Массив;
	Для Каждого ЭтапОплатыXDTO Из ДанныеXDTO.ЭтапыОплаты Цикл
		ЭтапГрафикаОплаты = ДанныеКоллекцииВВидеСтруктуры(ЭтапОплатыXDTO, ПравилаЗаполнения);
	
		ЭтапыГрафикаОплаты.Добавить(ЭтапГрафикаОплаты);
	КонецЦикла;
	
	Если ЭтапыГрафикаОплаты.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ЭтапыГрафикаОплаты", ЭтапыГрафикаОплаты);
	КонецЕсли;
КонецПроцедуры
Процедура ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена, ЕстьТЧДопРеквизиты = Ложь)
	Если Не (ДанныеXDTO.Свойство("ДополнительныеРеквизиты")
			И ЗначениеЗаполнено(ДанныеXDTO.ДополнительныеРеквизиты)) Тогда
		Возврат;
	КонецЕсли;
	
	Если СтандартныеПодсистемыСервер.ЭтоБазоваяВерсияКонфигурации() 
		Или Не ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеРеквизитыИСведения") Тогда
		Возврат;
	КонецЕсли;
	
	МетаОбъект      = ПолученныеДанные.Метаданные();
	ИмяБазовогоТипа = ОбщегоНазначения.ИмяБазовогоТипаПоОбъектуМетаданных(МетаОбъект);
	
	ТипДанныхСтрокой = ИмяБазовогоТипа + "." + МетаОбъект.Имя;
	
	МассивСтрокДопРеквизиты = Новый Массив;
	МассивСтрокДопСведения  = Новый Массив;
	
	Для Каждого СтрокаТЧ Из ДанныеXDTO.ДополнительныеРеквизиты Цикл
	
		ЭтоДопСведение = СтрокаТЧ.Свойство.Свойство("ЭтоДополнительноеСведение") И СтрокаТЧ.Свойство.ЭтоДополнительноеСведение;
		
		ДопРеквизитыСтрока = КомпонентыОбмена.ПараметрыКонвертации.ЗагруженныеДопРеквизитыИСведения.Добавить();
		ДопРеквизитыСтрока.Свойство       = СтрокаТЧ.Свойство;
		ДопРеквизитыСтрока.ЭтоДопСведение = ЭтоДопСведение;
		ДопРеквизитыСтрока.ТипОбъекта     = ТипДанныхСтрокой;
	
		СтруктураДанныхСтроки = Новый Структура("Свойство, Значение");
	
		// Проверка на простой тип.
		Если ТипЗнч(СтрокаТЧ.ЗначениеСвойства) = Тип("Строка")
			Или ТипЗнч(СтрокаТЧ.ЗначениеСвойства) = Тип("Число")
			Или ТипЗнч(СтрокаТЧ.ЗначениеСвойства) = Тип("Дата")
			Или ТипЗнч(СтрокаТЧ.ЗначениеСвойства) = Тип("Булево") Тогда
			
			СтруктураДанныхСтроки.Свойство = СтрокаТЧ.Свойство;
			СтруктураДанныхСтроки.Значение = СтрокаТЧ.ЗначениеСвойства;
			
			ДопРеквизитыСтрока.ТипЗначения = ТипЗнч(СтрокаТЧ.ЗначениеСвойства);
		Иначе
			ИмяПКО = "";
			ЗагрузкаДопРеквизитов_ОпределитьИмяПКО(СтрокаТЧ.ЗначениеСвойства, ИмяПКО, ДопРеквизитыСтрока.ТипЗначения);
			
			Если ИмяПКО = "" Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураДанныхСтроки.Свойство = СтрокаТЧ.Свойство;
			
			ЗначениеСвойства = СтрокаТЧ.ЗначениеСвойства;
			Если ИмяПКО = "Справочник_ЗначенияДополнительныхРеквизитов" Тогда
				Если Не (ЗначениеСвойства.Свойство("Владелец") И ЗначениеЗаполнено(ЗначениеСвойства.Владелец)) Тогда
					// Ключевое свойство Владелец необходимо указать явно.
					ЗначениеСвойства.Вставить("Владелец", СтрокаТЧ.Свойство);
				КонецЕсли;
			КонецЕсли;
			
			СтруктураДанныхСтроки.Значение = Новый Структура("Значение, ИмяПКО", СтрокаТЧ.ЗначениеСвойства, ИмяПКО);
			
		КонецЕсли;
		
		Если ЭтоДопСведение Тогда
			МассивСтрокДопСведения.Добавить(СтруктураДанныхСтроки);
		ИначеЕсли ЕстьТЧДопРеквизиты Тогда
			МассивСтрокДопРеквизиты.Добавить(СтруктураДанныхСтроки);
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивСтрокДопРеквизиты.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ДополнительныеРеквизиты", МассивСтрокДопРеквизиты);
	КонецЕсли;
	
	Если МассивСтрокДопСведения.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ДополнительныеСведения", МассивСтрокДопСведения);
	КонецЕсли;
КонецПроцедуры
Процедура ЗагрузитьДополнительныеСведения(ОбъектСсылка, СтруктураДопСвойства, КомпонентыОбмена)
	Если Не СтруктураДопСвойства.Свойство("ДополнительныеСведения")
		Или СтруктураДопСвойства.ДополнительныеСведения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеРеквизитыИСведения") Тогда
		Возврат;
	КонецЕсли;
		
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ДополнительныеСведения");
	ЭлементБлокировки.УстановитьЗначение("Объект", ОбъектСсылка);
	
	НачатьТранзакцию();
	
	Попытка
		Блокировка.Заблокировать();
		
		ДопСведенияНаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
		ДопСведенияНаборЗаписей.Отбор.Объект.Установить(ОбъектСсылка);
		
		ПКО_ДопРеквизиты = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_ДополнительныеРеквизиты");
		
		Для Каждого СтрокаДопСведения Из СтруктураДопСвойства.ДополнительныеСведения Цикл
			СвойствоСсылка = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, 
				СтрокаДопСведения.Свойство, 
				ПКО_ДопРеквизиты, 
				"ПолучитьСсылку").Ссылка;
				
			Если ТипЗнч(СтрокаДопСведения.Значение) = Тип("Структура") Тогда
				ПКО_ЗначениеСвойства = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, СтрокаДопСведения.Значение.ИмяПКО);
				
				ЗначениеСвойства = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, 
					СтрокаДопСведения.Значение.Значение, 
					ПКО_ЗначениеСвойства, 
					"ПолучитьСсылку").Ссылка;
			Иначе
				ЗначениеСвойства = СтрокаДопСведения.Значение;
			КонецЕсли;
			
			НовЗапись = ДопСведенияНаборЗаписей.Добавить();
			НовЗапись.Объект   = ОбъектСсылка;
			НовЗапись.Свойство = СвойствоСсылка;
			НовЗапись.Значение = ЗначениеСвойства;
		КонецЦикла;
			
		ДопСведенияНаборЗаписей.ОбменДанными.Загрузка = Истина;
		ДопСведенияНаборЗаписей.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры
Процедура ЗагрузитьКонтактнуюИнформацию(ДанныеXDTO, ПолученныеДанные, ГруппаВидовКИ)
	Если Не (ДанныеXDTO.Свойство("КонтактнаяИнформация")
		И ЗначениеЗаполнено(ДанныеXDTO.КонтактнаяИнформация)) Тогда
		Возврат;
	КонецЕсли;
		
	Для Каждого СтрокаXDTO Из ДанныеXDTO.КонтактнаяИнформация Цикл
		ВидКИСтрокой   = СокрЛП(СтрокаXDTO.ВидКонтактнойИнформации.Значение);
		НаименованиеКИ = СокрЛП(СтрокаXDTO.НаименованиеКонтактнойИнформации);
		
		ТекВидКИ = ВидКонтактнойИнформацииИзСтроки(ВидКИСтрокой, НаименованиеКИ, ГруппаВидовКИ);
		
		Если Не ЗначениеЗаполнено(ТекВидКИ) Тогда
			Продолжить;
		КонецЕсли;
	
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ПолученныеДанные, СокрЛП(СтрокаXDTO.ЗначенияПолей), ТекВидКИ);
	КонецЦикла;
КонецПроцедуры
Функция ЗагрузитьТоварыДокумента(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена, ПравилаЗаполнения)
	Результат = Новый Структура;
	Результат.Вставить("Сумма", 0);
	Результат.Вставить("ЕстьТовары", Ложь);
	Результат.Вставить("ОблагаетсяНДСУПокупателя", Ложь);
	
	ИмяТабличнойЧастиТовары = ?(ДанныеXDTO.Свойство("ТоварыПродажа"), "ТоварыПродажа", "Товары");
	
	Если Не ДанныеXDTO.Свойство(ИмяТабличнойЧастиТовары)
		ИЛИ Не ЗначениеЗаполнено(ДанныеXDTO[ИмяТабличнойЧастиТовары]) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Товары = Новый ТаблицаЗначений;
	ТабличнаяЧастьТовары = Неопределено;
	Если ДанныеXDTO.Свойство(ИмяТабличнойЧастиТовары, ТабличнаяЧастьТовары)
		И ЗначениеЗаполнено(ТабличнаяЧастьТовары) Тогда
	
		Товары = НормализованнаяТаблицаТоваров(КомпонентыОбмена, ТабличнаяЧастьТовары);
	КонецЕсли;
	
	Результат.ЕстьТовары = Истина;
	
	ИмяСвойстваНоменклатура = ПравилаЗаполнения["Номенклатура"];
	ИмяСвойстваХарактеристика = ПравилаЗаполнения["Характеристика"];
	ИмяСвойстваУпаковка = ПравилаЗаполнения["Упаковка"];
	ИмяСвойстваКоличество = ПравилаЗаполнения["Количество"];
	ИмяСвойстваКоличествоУпаковок = ПравилаЗаполнения["КоличествоУпаковок"];
	ИмяСвойстваЦена = ПравилаЗаполнения["Цена"];
	ИмяСвойстваЦенаЗаУпаковку = ПравилаЗаполнения["ЦенаЗаУпаковку"];
	ИмяСвойстваСуммаСНДС = ПравилаЗаполнения["СуммаСНДС"];
	ИмяСвойстваСуммаСтавкаНДС = ПравилаЗаполнения["СтавкаНДС"];
	ИмяСвойстваИдентификаторСтроки = ПравилаЗаполнения["ИдентификаторСтроки"];
	
	ПравилоКонвертацииБазовойЕдиницы = ОбменДаннымиXDTOСервер.ПКОПоИмени(
		КомпонентыОбмена, "Справочник_ЕдиницыИзмерения");
	
	
	ОбрабатыватьХарактеристикиПослеЗагрузки = Ложь;
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.7") Тогда
		ОбрабатыватьХарактеристикиПослеЗагрузки = Истина;
		СсылкаНаОбъект = ПолученныеДанные.ПолучитьСсылкуНового();
		ХарактеристикиДопОбработка = КомпонентыОбмена.ПараметрыКонвертации.ХарактеристикиДопОбработка;
		ПравилоКонвертацииНоменклатуры = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Номенклатура_Получение");
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("СуммаВключаетНДС") Тогда
		СуммаВключаетНДС = ДанныеXDTO.СуммаВключаетНДС;
	Иначе
		СуммаВключаетНДС = Ложь;
	КонецЕсли;
	
	ОблагаетсяНДСУПокупателя = Ложь;
	
	МассивСтрокТовары = Новый Массив;
	
	ИндексСтроки = 0;
	Для Каждого СтрокаТаблицы Из Товары Цикл
		
		ДанныеСтроки = ДанныеКоллекцииВВидеСтруктуры(СтрокаТаблицы, ПравилаЗаполнения);
		Если ДанныеСтроки.Свойство("СтавкаНДС") Тогда
			ДанныеСтроки.Вставить("СтавкаНДС", СтавкаНДСПоЗначениюXDTO(КомпонентыОбмена, ДанныеСтроки.СтавкаНДС));
		КонецЕсли;
	    Если ДанныеСтроки.Свойство("СтавкаНДСДоИзменения") Тогда
			ДанныеСтроки.Вставить("СтавкаНДСДоИзменения", СтавкаНДСПоЗначениюXDTO(КомпонентыОбмена, ДанныеСтроки.СтавкаНДСДоИзменения));
		КонецЕсли;
		
		ЗаполнитьНомерГТДСтрануПроисхождения(ДанныеСтроки, КомпонентыОбмена);
		
		ИдентификаторСтроки = Неопределено;
		Если ИмяСвойстваИдентификаторСтроки <> Неопределено
			И (Не ДанныеСтроки.Свойство(ИмяСвойстваИдентификаторСтроки, ИдентификаторСтроки)
				ИЛИ Не ЗначениеЗаполнено(ИдентификаторСтроки)) Тогда
			ДанныеСтроки.Вставить(ИмяСвойстваИдентификаторСтроки, Строка(Новый УникальныйИдентификатор));
		КонецЕсли;
		
		Если ОбрабатыватьХарактеристикиПослеЗагрузки
			И СвойствоДанныхСтроки(ДанныеСтроки, ИмяСвойстваНоменклатура)
			И СвойствоДанныхСтроки(ДанныеСтроки, ИмяСвойстваХарактеристика) Тогда
			
			Номенклатура = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, ДанныеСтроки[ИмяСвойстваНоменклатура],
				ПравилоКонвертацииНоменклатуры, "ПолучитьСсылку").Ссылка;
			ДанныеСтроки.Вставить(ИмяСвойстваНоменклатура, Номенклатура);
			
			НоваяСтрока = ХарактеристикиДопОбработка.Добавить();
			НоваяСтрока.Документ = СсылкаНаОбъект;
			НоваяСтрока.КлючСвязи = ИндексСтроки;
			НоваяСтрока.Номенклатура = Номенклатура;
			НоваяСтрока.НаименованиеПолное = ДанныеСтроки[ИмяСвойстваХарактеристика].НаименованиеПолное;
			
			Если ДанныеСтроки[ИмяСвойстваХарактеристика].Свойство("Ссылка")
				И ЗначениеЗаполнено(ДанныеСтроки[ИмяСвойстваХарактеристика].Ссылка.Значение) Тогда
				НоваяСтрока.ЗначениеСсылки = ДанныеСтроки[ИмяСвойстваХарактеристика].Ссылка.Значение;
				НоваяСтрока.СсылкаПоЗначению = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(
					Новый УникальныйИдентификатор(НоваяСтрока.ЗначениеСсылки));
			КонецЕсли;
			
			ДанныеСтроки.Удалить(ИмяСвойстваХарактеристика);
		КонецЕсли;
		
		ЗаполнитьСуммуСНДСПоДаннымСтроки(ДанныеСтроки, СуммаВключаетНДС, ПравилаЗаполнения);
		
		СуммаСНДС = 0;
		Если СвойствоДанныхСтроки(ДанныеСтроки, ИмяСвойстваСуммаСНДС, СуммаСНДС) Тогда
			Результат.Сумма = Результат.Сумма + СуммаСНДС; 
		КонецЕсли;
		
		Если (Не ДанныеСтроки.Свойство(ИмяСвойстваУпаковка)
			Или Не ЗначениеЗаполнено(ДанныеСтроки[ИмяСвойстваУпаковка]))
			И СтрокаТаблицы.ЕдиницаИзмерения <> Неопределено Тогда
			
			ДанныеСтроки.Вставить(ИмяСвойстваУпаковка,
				ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
					КомпонентыОбмена, СтрокаТаблицы.ЕдиницаИзмерения,
					ПравилоКонвертацииБазовойЕдиницы, "ПолучитьСсылку").Ссылка);
		КонецЕсли;
			
		МассивСтрокТовары.Добавить(ДанныеСтроки);
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	Если ДанныеXDTO.Свойство("Налогообложение")
		И ЗначениеЗаполнено(ДанныеXDTO.Налогообложение) Тогда
		ОблагаетсяНДСУПокупателя = ДанныеXDTO.Налогообложение.Значение = "ОблагаетсяНДСУПокупателя";
	ИначеЕсли ДанныеXDTO.Свойство("НалогообложениеНДСПродавца")
		И ЗначениеЗаполнено(ДанныеXDTO.НалогообложениеНДСПродавца) Тогда
		ОблагаетсяНДСУПокупателя = ДанныеXDTO.НалогообложениеНДСПродавца.Значение = "НДСИсчисляетсяПокупателем";
	КонецЕсли;
	
	Результат.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("Товары") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			ПолученныеДанные.ДополнительныеСвойства.Товары,
			МассивСтрокТовары);
	Иначе
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Товары", МассивСтрокТовары);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции
Функция ЗагрузитьУслугиДокумента(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена, ПравилаЗаполнения)
	Результат = Новый Структура;
	Результат.Вставить("Сумма", 0);
	Результат.Вставить("ЕстьУслуги", Ложь);
	
	Услуги = Неопределено;
	Если Не ДанныеXDTO.Свойство("Услуги", Услуги)
		ИЛИ Не ЗначениеЗаполнено(Услуги) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяСвойстваКоличество = ПравилаЗаполнения["Количество"];
	ИмяСвойстваКоличествоУпаковок = ПравилаЗаполнения["КоличествоУпаковок"];
	ИмяСвойстваЦена = ПравилаЗаполнения["Цена"];
	ИмяСвойстваЦенаЗаУпаковку = ПравилаЗаполнения["ЦенаЗаУпаковку"];
	ИмяСвойстваСуммаСНДС = ПравилаЗаполнения["СуммаСНДС"];
	
	Если ДанныеXDTO.Свойство("СуммаВключаетНДС") Тогда
		СуммаВключаетНДС = ДанныеXDTO.СуммаВключаетНДС;
	Иначе
		СуммаВключаетНДС = Ложь;
	КонецЕсли;
	
	Результат.ЕстьУслуги = Истина;
	
	МассивСтрокУслуги = Новый Массив;
		
	Для Каждого СтрокаТаблицы Из ДанныеXDTO.Услуги Цикл
	
		ДанныеСтроки = ДанныеКоллекцииВВидеСтруктуры(СтрокаТаблицы, ПравилаЗаполнения);
		Если ДанныеСтроки.Свойство("СтавкаНДС") Тогда
			ДанныеСтроки.Вставить("СтавкаНДС", СтавкаНДСПоЗначениюXDTO(КомпонентыОбмена, ДанныеСтроки.СтавкаНДС));
		КонецЕсли;
		Если ДанныеСтроки.Свойство("СтавкаНДСДоИзменения") Тогда
			ДанныеСтроки.Вставить("СтавкаНДСДоИзменения", СтавкаНДСПоЗначениюXDTO(КомпонентыОбмена, ДанныеСтроки.СтавкаНДСДоИзменения));
		КонецЕсли;
		
		ЗаполнитьСуммуСНДСПоДаннымСтроки(ДанныеСтроки, СуммаВключаетНДС, ПравилаЗаполнения);
	
		СуммаСНДС = 0;
		Если СвойствоДанныхСтроки(ДанныеСтроки, ИмяСвойстваСуммаСНДС, СуммаСНДС) Тогда
			Результат.Сумма = Результат.Сумма + СуммаСНДС; 
		КонецЕсли;
		
		Если ИмяСвойстваКоличествоУпаковок <> Неопределено Тогда
			Если ДанныеСтроки.Свойство(ИмяСвойстваКоличество) Тогда
				ДанныеСтроки.Вставить(ИмяСвойстваКоличествоУпаковок, ДанныеСтроки[ИмяСвойстваКоличество]);
			Иначе
				ДанныеСтроки.Вставить(ИмяСвойстваКоличествоУпаковок, 0);
			КонецЕсли;
		КонецЕсли;
		
		МассивСтрокУслуги.Добавить(ДанныеСтроки);
		
	КонецЦикла;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("Товары") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПолученныеДанные.ДополнительныеСвойства.Товары, МассивСтрокУслуги);
	Иначе
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Товары", МассивСтрокУслуги);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции
Процедура ЗагрузкаДопРеквизитов_ОпределитьИмяПКО(ЗначениеСвойства, ИмяПКО, ТипЗначенияСвойства)
	ТипЗначенияСвойства = ЗначениеСвойства.ТипЗначения;
	
	Если Найти(ТипЗначенияСвойства, "НоменклатураГруппа")>0 Тогда
		ИмяПКО = "Справочник_НоменклатураГруппа";
		ТипЗначенияСвойства = Тип("СправочникСсылка.Номенклатура");
	ИначеЕсли Найти(ТипЗначенияСвойства, "Номенклатура")>0 Тогда
		ИмяПКО = "Справочник_Номенклатура_Получение";
		ТипЗначенияСвойства = Тип("СправочникСсылка.Номенклатура");
	ИначеЕсли Найти(ТипЗначенияСвойства, "КонтрагентГруппа")>0 Тогда
		Возврат;
	ИначеЕсли Найти(ТипЗначенияСвойства, "ЗначенияДополнительныхРеквизитов")>0 Тогда
		ИмяПКО = "Справочник_ЗначенияДополнительныхРеквизитов";
		ТипЗначенияСвойства = Тип("СправочникСсылка.ЗначенияСвойствОбъектов");
	КонецЕсли;
КонецПроцедуры
Процедура ЗаписатьОшибкуВЖурналРегистрации(СсылкаНаОбъект, ОписаниеОшибки, КомпонентыОбмена, ОписаниеДействия = Неопределено, Уровень = Неопределено)
	// Процедура вызывается из исключений, при попытке записать или заблокировать объект в ИБ.
	
	Если ОписаниеДействия = Неопределено Тогда
		ОписаниеДействия = НСтр("ru = 'создать объект'");
	КонецЕсли;
	
	ТекстОшибки = НСтр("ru = 'Не удалось %1 %2.
							|%3'");
	ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					ОписаниеДействия, СсылкаНаОбъект.Метаданные().Синоним, ОписаниеОшибки);
	
	Если Уровень = Неопределено Тогда
		Уровень = УровеньЖурналаРегистрации.Информация;
	КонецЕсли;
	
	УзелКорреспондента = КомпонентыОбмена.УзелКорреспондента;
	КлючСообщенияЖурналаРегистрации = КомпонентыОбмена.КлючСообщенияЖурналаРегистрации;
	
	ОбъектМетаданных = Неопределено;
	
	Если     УзелКорреспондента <> Неопределено
		И Не УзелКорреспондента.Пустая() Тогда
		
		ОбъектМетаданных = УзелКорреспондента.Метаданные();
		
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(КлючСообщенияЖурналаРегистрации, Уровень, ОбъектМетаданных, СсылкаНаОбъект, ТекстОшибки);
КонецПроцедуры
Процедура ЗаполнитьЕдиницыИзмеренияУслугПоУмолчанию(ПолученныеДанные)
	Отбор = Новый Структура("ЕдиницаИзмерения", Справочники.ЕдиницыИзмерения.ПустаяСсылка());
	НайденныеСтроки = ПолученныеДанные.Товары.НайтиСтроки(Отбор);
	Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
		МассивНоменклатуры = Новый Массив;
		Для Каждого СтрокаТаблицы Из НайденныеСтроки Цикл
			МассивНоменклатуры.Добавить(СтрокаТаблицы.Номенклатура);
		КонецЦикла;
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Номенклатура.Ссылка КАК Ссылка,
			|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
			|		ПО Номенклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка
			|			И (ВидыНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга))
			|ГДЕ
			|	Номенклатура.Ссылка В(&МассивНоменклатуры)
			|	И Номенклатура.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)";
		
		Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ЕдиницыИзмеренияНоменклатуры = Новый Соответствие;
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				ЕдиницыИзмеренияНоменклатуры.Вставить(Выборка.Ссылка, Выборка.ЕдиницаИзмерения);
			КонецЦикла;
			Для Каждого СтрокаТаблицы Из НайденныеСтроки Цикл
				ЕдиницаИзмерения = ЕдиницыИзмеренияНоменклатуры[СтрокаТаблицы.Номенклатура];
				Если ЕдиницаИзмерения <> Неопределено Тогда
					СтрокаТаблицы.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьЗначенияПолейКИПоПредставлению(Представление, ЗначенияПолей, ТипКИ = Неопределено)
	Если ТипКИ = Неопределено Тогда
		ТипКИ = Перечисления.ТипыКонтактнойИнформации.Адрес;
	КонецЕсли;
	
	Если УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформации(ЗначенияПолей) = Представление Тогда
		Возврат;
	КонецЕсли;
	
	// Сохраним комментарий из старых значений полей.
	Комментарий = СокрЛП(УправлениеКонтактнойИнформацией.КомментарийКонтактнойИнформации(ЗначенияПолей));
	
	// Сформируем значения полей КИ по представлению.
	ЗначенияПолей = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияПоПредставлению(Представление,	ТипКИ);
	
	Если ЗначениеЗаполнено(Комментарий) Тогда
		// Вернем комментарий обратно.
		УправлениеКонтактнойИнформацией.УстановитьКомментарийКонтактнойИнформации(ЗначенияПолей, Комментарий);
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьЗначенияСтавокНДС(КомпонентыОбмена)
	ЗначенияСтавокНДС = Новый ТаблицаЗначений;
	ЗначенияСтавокНДС.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ЗначенияСтавокНДС.Колонки.Добавить("Ставка", Новый ОписаниеТипов("Число"));
	ЗначенияСтавокНДС.Колонки.Добавить("РасчетнаяСтавка", Новый ОписаниеТипов("Булево"));
	ЗначенияСтавокНДС.Колонки.Добавить("ВидСтавки", Новый ОписаниеТипов("Строка"));
	ЗначенияСтавокНДС.Колонки.Добавить("НеОблагается", Новый ОписаниеТипов("Булево"));
	
	Для Каждого МетаданныеПеречисления Из Метаданные.Перечисления.СтавкиНДС.ЗначенияПеречисления Цикл
		             
		СтавкаНДС = Перечисления.СтавкиНДС[МетаданныеПеречисления.Имя];
		СтавкаНДССтруктура = СтавкаНДССтруктура(СтавкаНДС);
		
		Если ЗначениеЗаполнено(СтавкаНДССтруктура) Тогда                  
			СтрокаСтавки = ЗначенияСтавокНДС.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСтавки, СтавкаНДССтруктура);
			СтрокаСтавки.СтавкаНДС = СтавкаНДС;
	    КонецЕсли;
	    
	КонецЦикла;
	
	КомпонентыОбмена.ПараметрыКонвертации.ЗначенияСтавокНДС = ЗначенияСтавокНДС;
КонецПроцедуры
Процедура ЗаполнитьКонтактнуюИнформациюВДанныеИБ(ПолученныеДанные, ДанныеИБ)
	// Если в контактной информации, которые получены из сообщения обмена,
	// нет значения, которое указано в базе, то сохраняем это значение в данных ИБ.
	
	СвойстваВидаКонтактнойИнформации = ПолученныеДанные.КонтактнаяИнформация.Выгрузить();
	СвойстваВидаКонтактнойИнформации.Свернуть("Вид", "");
	
	Для Каждого СвойствоВидаКонтактнойИнформации Из СвойстваВидаКонтактнойИнформации Цикл
		Если ЗначениеЗаполнено(СвойствоВидаКонтактнойИнформации.Вид) Тогда
			
			СтруктураОтбора = Новый Структура("Вид", СвойствоВидаКонтактнойИнформации.Вид);	
		
			// Перед тем, как добавить виды контактной информации из полученных данных, нужно предварительно
			// удалить строки для свойства из ДанныеИБ.
			
			СтрокиДляУдаления = ДанныеИБ.КонтактнаяИнформация.НайтиСтроки(СтруктураОтбора);
			Для Каждого СтрокаДляУдаления Из СтрокиДляУдаления Цикл
				ДанныеИБ.КонтактнаяИнформация.Удалить(СтрокаДляУдаления);
			КонецЦикла;
			
			СтрокиДляКопирования = ПолученныеДанные.КонтактнаяИнформация.НайтиСтроки(СтруктураОтбора);
			Для Каждого СтрокаДляКопирования Из СтрокиДляКопирования Цикл
				ЗаполнитьЗначенияСвойств(ДанныеИБ.КонтактнаяИнформация.Добавить(), СтрокаДляКопирования);
			КонецЦикла;
		
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьНеПустыеСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ, МассивИсключений = Неопределено)
	Для Каждого СвойствоОбъекта Из КонвертацияСвойств Цикл
		СвойствоИБ = СвойствоОбъекта.СвойствоКонфигурации;
		Если СокрЛП(СвойствоИБ) = "" Тогда
			Продолжить;
		КонецЕсли;
		Если МассивИсключений <> Неопределено И МассивИсключений.Найти(СвойствоИБ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПолученныеДанные[СвойствоИБ]) Тогда
			ДанныеИБ[СвойствоИБ] = ПолученныеДанные[СвойствоИБ];
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьНоменклатуруХарактеристику(КомпонентыОбмена, СтрокаТаблицы, Выборка, ЭтоУслуга)
	Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
		Номенклатура = Выборка.Номенклатура;
	ИначеЕсли ЗначениеЗаполнено(Выборка.SKUКонтрагентаСсылка) Тогда
		Номенклатура = НовыйИнструкция(
			"Справочник_Номенклатура_ИзНоменклатурыКонтрагента", Выборка.SKUКонтрагентаСсылка);
			
		СтрокаТаблицы.Упаковка = ИнструкцияПоВыгрузкеУпаковки(КомпонентыОбмена, Выборка);
			
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Выборка, "НаименованиеПоставщика")
		И ЗначениеЗаполнено(Выборка.НаименованиеПоставщика) Тогда
		
		НоменклатураСтруктура = Новый Структура;
		НоменклатураСтруктура.Вставить("Наименование", Выборка.НаименованиеПоставщика);
		
		Номенклатура = НовыйИнструкция(
			"Справочник_Номенклатура_ИзСтруктуры_Отправка",
			НоменклатураСтруктура);
		
		СтрокаТаблицы.Упаковка = Неопределено;
	Иначе	
		Возврат;	
	КонецЕсли;
	
	СтрокаТаблицы.Номенклатура = Номенклатура;
	
	
	Если (ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8")
		Или Не ЭтоУслуга) 
		И ЗначениеЗаполнено(Выборка.Номенклатура)
		И ЗначениеЗаполнено(Выборка.Характеристика) Тогда
	
		СтрокаТаблицы.Характеристика = Новый Структура("Ссылка, Наименование, Владелец",
			Выборка.Характеристика, Выборка.ХарактеристикаНаименование, Номенклатура);
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьНомерГТДСтрануПроисхождения(ДанныеСтроки, КомпонентыОбмена)
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17") Тогда
		Возврат;
	КонецЕсли;
	
	НомерГТД = Неопределено;
	СтранаПроисхождения = Неопределено;
	Если ДанныеСтроки.Свойство("НомерГТД") Тогда
		НомерГТД = ДанныеСтроки.НомерГТД.НомерГТД;
		СтранаПроисхождения = ДанныеСтроки.НомерГТД.СтранаПроисхождения;
	КонецЕсли;
	Если ЗначениеЗаполнено(НомерГТД) Тогда
		ДанныеСтроки.Вставить("НомерГТД", НомерГТД);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтранаПроисхождения) Тогда
		ДанныеСтроки.Вставить("СтранаПроисхождения", СтранаПроисхождения);
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьНомерДатуИсходногоДокумента(Объект, Основание)
	РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание,
		"ВидОперации,НомерЭД,Дата,НомерИсправления,НомерИсходногоДокумента,ДатаИсходногоДокумента,НомерИсправленияИсходногоДокумента,
		|ДатаИсправленияИсходногоДокумента,НомерИсправляемогоКорректировочногоДокумента,ДатаИсправляемогоКорректировочногоДокумента");
	
	Если НЕ ЗначениеЗаполнено(РеквизитыОснования) Тогда
		Возврат;
	КонецЕсли;
	
	КлиентЭДО.ЗаполнитьНомерДатуИсходногоДокумента(Объект, РеквизитыОснования);
КонецПроцедуры
Процедура ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ, МассивИсключений = Неопределено)
	Для Каждого СвойствоОбъекта Из КонвертацияСвойств Цикл
		СвойствоИБ = СвойствоОбъекта.СвойствоКонфигурации;
		Если СокрЛП(СвойствоИБ) = "" Тогда
			Продолжить;
		КонецЕсли;
		Если МассивИсключений <> Неопределено И МассивИсключений.Найти(СвойствоИБ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДанныеИБ[СвойствоИБ] = ПолученныеДанные[СвойствоИБ];
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьСтавкуНДСВТаблице(Таблица, ИмяПоляСтавкаНДСПеречислением, ИмяПоляСтавкаНДС, КомпонентыОбмена)
	Если Таблица.Колонки.Найти(ИмяПоляСтавкаНДС) = Неопределено Тогда
		Таблица.Колонки.Добавить(ИмяПоляСтавкаНДС);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаТаблицы[ИмяПоляСтавкаНДС] = СтавкаНДСОтправка(СтрокаТаблицы[ИмяПоляСтавкаНДСПеречислением], КомпонентыОбмена);
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьСуммуСНДСПоДаннымСтроки(ДанныеСтроки, ЦенаВключаетНДС, ПравилаЗаполнения)
	ИмяСвойстваСумма = ПравилаЗаполнения["Сумма"];
	ИмяСвойстваСуммаНДС = ПравилаЗаполнения["СуммаНДС"];
	ИмяСвойстваСуммаСНДС = ПравилаЗаполнения["СуммаСНДС"];
	
	СуммаСНДС = 0;
	Если ИмяСвойстваСуммаСНДС <> Неопределено
		И СвойствоДанныхСтроки(ДанныеСтроки, ИмяСвойстваСумма, СуммаСНДС) Тогда
		
		СуммаНДС = 0;
		Если НЕ ЦенаВключаетНДС 
			И ИмяСвойстваСуммаНДС <> Неопределено
			И СвойствоДанныхСтроки(ДанныеСтроки, ИмяСвойстваСуммаНДС, СуммаНДС) Тогда
			СуммаСНДС = СуммаСНДС + СуммаНДС;
		КонецЕсли;
		
		ДанныеСтроки.Вставить(ИмяСвойстваСуммаСНДС, СуммаСНДС);
	КонецЕсли;
КонецПроцедуры
Процедура ЗаполнитьТоварыУслугиКорректировкиПоступления(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена)
	Товары = Новый ТаблицаЗначений;
