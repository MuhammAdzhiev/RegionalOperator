	Возврат ТаблицаОтбора;
КонецФункции
Процедура УстановитьИспользованиеХарактеристикДляВидов(КомпонентыОбмена)
	ПараметрыКонвертации = КомпонентыОбмена.ПараметрыКонвертации;
	Если Не ЗначениеЗаполнено(ПараметрыКонвертации.ВладельцыНовыхХарактеристик)
		ИЛИ ПараметрыКонвертации.ТекущаяВерсияФорматаЧислом < ВерсияФорматаЧислом("1.7") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Если НЕ Константы.ИспользоватьХарактеристикиНоменклатуры.Получить() Тогда
		Константы.ИспользоватьХарактеристикиНоменклатуры.Установить(Истина);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыНоменклатуры.Ссылка КАК Ссылка,
		|	ЛОЖЬ КАК ИндивидуальныеХарактеристики
		|ИЗ
		|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|ГДЕ
		|	ВидыНоменклатуры.Ссылка В(&ВладельцыХарактеристик)
		|	И НЕ ВидыНоменклатуры.ИспользоватьХарактеристики
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Номенклатура.ВидНоменклатуры,
		|	ИСТИНА
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В(&ВладельцыХарактеристик)
		|	И НЕ Номенклатура.ВидНоменклатуры.ИспользоватьХарактеристики";
		
	МассивВладельцев = Новый Массив;
	Для Каждого Элемент Из ПараметрыКонвертации.ВладельцыНовыхХарактеристик Цикл
		МассивВладельцев.Добавить(Элемент.Ключ);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ВладельцыХарактеристик", МассивВладельцев);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.СледующийПоЗначениюПоля("Ссылка") Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.ИспользоватьХарактеристики = Истина;
		Если Выборка.ИндивидуальныеХарактеристики Тогда
			Объект.ИндивидуальныеХарактеристикиНоменклатуры = Истина;
		КонецЕсли;
		ОбменДаннымиXDTOСервер.ЗаписатьОбъектВИБ(КомпонентыОбмена, Объект, "СправочникОбъект.ВидыНоменклатуры"); 
	КонецЦикла;
КонецПроцедуры
Процедура УстановитьПоляПоискаКонтрагента(КомпонентыОбмена, ДанныеXDTO)
	// Поиск контрагента должен осуществляться следующим образом
	//  - если заполнен ИНН, то поиск осуществляется по ИНН для физ.лица и ИНН/КПП для юрлица + ЭтоГруппа
	//  - если ИНН не заполнен, то поиск осуществляется сначала по полному наименованию, затем по наименованию + ЭтоГруппа.
	
	ПравилаКонвертацииКонтрагентов = КомпонентыОбмена.ПравилаКонвертацииОбъектов.Найти("Справочник_Контрагенты_Получение", "ИмяПКО");
	Если ПравилаКонвертацииКонтрагентов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоляПоиска = ПравилаКонвертацииКонтрагентов.ПоляПоиска;
	ПоляПоиска.Очистить();
	
	ИННЗаполнен = Ложь;
	КППЗаполнен = Ложь;
	Если ДанныеXDTO.Свойство("КлючевыеСвойства") И ЗначениеЗаполнено(ДанныеXDTO.КлючевыеСвойства) Тогда
		ИННЗаполнен = ДанныеXDTO.КлючевыеСвойства.Свойство("ИНН") И ЗначениеЗаполнено(ДанныеXDTO.КлючевыеСвойства.ИНН);
		КППЗаполнен = ДанныеXDTO.КлючевыеСвойства.Свойство("КПП") И ЗначениеЗаполнено(ДанныеXDTO.КлючевыеСвойства.КПП);
		ЭтоЮридическоеЛицо = ДанныеXDTO.КлючевыеСвойства.Свойство("ЮридическоеФизическоеЛицо") И ДанныеXDTO.КлючевыеСвойства.ЮридическоеФизическоеЛицо.Значение = "ЮридическоеЛицо";
	Иначе
		ИННЗаполнен = ДанныеXDTO.Свойство("ИНН") И ЗначениеЗаполнено(ДанныеXDTO.ИНН);
		КППЗаполнен = ДанныеXDTO.Свойство("КПП") И ЗначениеЗаполнено(ДанныеXDTO.КПП);
		ЭтоЮридическоеЛицо = ДанныеXDTO.Свойство("ЮридическоеФизическоеЛицо") И ДанныеXDTO.ЮридическоеФизическоеЛицо.Значение = "ЮридическоеЛицо";
	КонецЕсли;
	
	Если ИННЗаполнен Тогда
		Если ЭтоЮридическоеЛицо И КППЗаполнен Тогда
			ПоляПоиска.Добавить("ИНН,КПП,ЭтоГруппа");
		Иначе
			ПоляПоиска.Добавить("ИНН,ЭтоГруппа");
		КонецЕсли;
	Иначе
		ПоляПоиска.Добавить("НаименованиеПолное,ЭтоГруппа");
		ПоляПоиска.Добавить("Наименование,ЭтоГруппа");
	КонецЕсли;
КонецПроцедуры
Функция ЭтоУслуга(ТипНоменклатуры)
	Возврат ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга
			ИЛИ ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа;
КонецФункции

