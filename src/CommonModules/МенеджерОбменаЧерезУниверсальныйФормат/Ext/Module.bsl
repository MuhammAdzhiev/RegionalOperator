#Область СлужебныйПрограммныйИнтерфейс
#Область ПроцедурыКонвертации
// Процедура, выполняемая перед началом конвертации данных.
//
// Параметры:
//  КомпонентыОбмена - см. ОбменДаннымиXDTOСервер.ИнициализироватьКомпонентыОбмена
//
Процедура ПередКонвертацией(КомпонентыОбмена) Экспорт
	ПараметрыКонвертации = КомпонентыОбмена.ПараметрыКонвертации;
	ПараметрыКонвертации.Вставить("ТекущаяВерсияФорматаЧислом", ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена));
	
	Если КомпонентыОбмена.НаправлениеОбмена = "Получение" Тогда
		
		// Виды  номенклатуры по умолчанию. 
		ВидыНоменклатурыПоУмолчанию = Новый Соответствие;
		ПараметрыКонвертации.Вставить("ВидыНоменклатурыПоУмолчанию", ВидыНоменклатурыПоУмолчанию);
		
		// Инициализация таблицы для заполнения наборов дополнительных реквизитов и сведений.
		ДопРеквизитыИСведения = Новый ТаблицаЗначений;
		ДопРеквизитыИСведения.Колонки.Добавить("Свойство");
		ДопРеквизитыИСведения.Колонки.Добавить("ЭтоДопСведение");
		ДопРеквизитыИСведения.Колонки.Добавить("ТипОбъекта");
		ДопРеквизитыИСведения.Колонки.Добавить("ТипЗначения");
		КомпонентыОбмена.ПараметрыКонвертации.ЗагруженныеДопРеквизитыИСведения = ДопРеквизитыИСведения;
		
		ПараметрыКонвертации.Вставить("ДокументыСИзмененнымиКлючевымиРеквизитами", Новый Массив);
		
		ХарактеристикиДопОбработка= Новый ТаблицаЗначений;
		ХарактеристикиДопОбработка.Колонки.Добавить("Документ");
		ХарактеристикиДопОбработка.Колонки.Добавить("КлючСвязи", Новый ОписаниеТипов("Число"));
		ХарактеристикиДопОбработка.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ХарактеристикиДопОбработка.Колонки.Добавить("ЗначениеСсылки", Новый ОписаниеТипов("Строка"));
		ХарактеристикиДопОбработка.Колонки.Добавить("СсылкаПоЗначению", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
		ХарактеристикиДопОбработка.Колонки.Добавить("НаименованиеПолное", Новый ОписаниеТипов("Строка"));
		
		ПараметрыКонвертации.ХарактеристикиДопОбработка = ХарактеристикиДопОбработка;
		
		ПараметрыКонвертации.Вставить("ИспользуютсяХарактеристикиНоменклатуры", Ложь);
		ПараметрыКонвертации.Вставить("ВладельцыНовыхХарактеристик", Новый Соответствие);
		
		ЗаполнитьЗначенияСтавокНДС(КомпонентыОбмена);
		
	КонецЕсли;
	
	Если Не КомпонентыОбмена.ЭтоОбменЧерезПланОбмена Тогда
	
		Если ПараметрыКонвертации.ИспользоватьОтборПоОрганизациям = Неопределено Тогда
			ПараметрыКонвертации.ИспользоватьОтборПоОрганизациям = Ложь;
		КонецЕсли;
	
	Иначе
	
		// Заполнение параметров из узла обмена.
		РеквизитыУзлаОбмена = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			КомпонентыОбмена.УзелКорреспондента,
			"ИспользоватьОтборПоОрганизациям,ВариантНастройки");
	
		ПараметрыКонвертации.ИспользоватьОтборПоОрганизациям = РеквизитыУзлаОбмена.ИспользоватьОтборПоОрганизациям;
	   		ПараметрыКонвертации.Вставить("ВариантНастройки", РеквизитыУзлаОбмена.ВариантНастройки);
	
		СписокОрганизаций = Новый СписокЗначений;
		СписокОрганизаций.ЗагрузитьЗначения(КомпонентыОбмена.УзелКорреспондента.Организации.ВыгрузитьКолонку("Организация"));
		ПараметрыКонвертации.Вставить("Организации", СписокОрганизаций);
	
	КонецЕсли;
КонецПроцедуры

// Процедура, выполняемая после выполнения конвертации данных.
//
// Параметры:
//   КомпонентыОбмена - см. ОбменДаннымиXDTOСервер.ИнициализироватьКомпонентыОбмена
//
Процедура ПослеКонвертации(КомпонентыОбмена) Экспорт
	Если КомпонентыОбмена.НаправлениеОбмена = "Получение" Тогда
		
		УстановитьИспользованиеХарактеристикДляВидов(КомпонентыОбмена);
		КлиентЭДО.СозданиеЭлектронныхДокументов();
		
	КонецЕсли;
КонецПроцедуры

