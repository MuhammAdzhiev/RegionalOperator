	Товары.Колонки.Добавить("КоличествоДоИзменения");
	Товары.Колонки.Добавить("Количество");
	Товары.Колонки.Добавить("ЦенаДоКорректировки");
	Товары.Колонки.Добавить("ЦенаДоИзменения");
	Товары.Колонки.Добавить("Цена");
	Товары.Колонки.Добавить("СуммаДоКорректировки");
	Товары.Колонки.Добавить("СуммаДоИзменения");
	Товары.Колонки.Добавить("Сумма");
	Товары.Колонки.Добавить("СтавкаНДСДоИзменения");
	Товары.Колонки.Добавить("СтавкаНДС");
	Товары.Колонки.Добавить("СуммаНДСДоКорректировки");
	Товары.Колонки.Добавить("СуммаНДСДоИзменения");
	Товары.Колонки.Добавить("СуммаНДС");
	Товары.Колонки.Добавить("НомерГТДДоИзменения");
	Товары.Колонки.Добавить("НомерГТД");
	Товары.Колонки.Добавить("СтранаПроисхожденияДоИзменения");
	Товары.Колонки.Добавить("СтранаПроисхождения");
	Товары.Колонки.Добавить("Штрихкод");
	Товары.Колонки.Добавить("ЕстьВДокументеПоступленияРеализации");
	Товары.Колонки.Добавить("КоличествоУпаковок");
	Товары.Колонки.Добавить("КоличествоУпаковокДоКорректировки");
	Товары.Колонки.Добавить("КоличествоУпаковокДоИзменения");
	
	
	Услуги = Новый ТаблицаЗначений;
	Услуги.Колонки.Добавить("Номенклатура");
	Услуги.Колонки.Добавить("КоличествоДоКорректировки");
	Услуги.Колонки.Добавить("КоличествоДоИзменения");
	Услуги.Колонки.Добавить("Количество");
	Услуги.Колонки.Добавить("ЦенаДоКорректировки");
	Услуги.Колонки.Добавить("ЦенаДоИзменения");
	Услуги.Колонки.Добавить("Цена");
	Услуги.Колонки.Добавить("СуммаДоКорректировки");
	Услуги.Колонки.Добавить("СуммаДоИзменения");
	Услуги.Колонки.Добавить("Сумма");
	Услуги.Колонки.Добавить("СтавкаНДСДоИзменения");
	Услуги.Колонки.Добавить("СтавкаНДС");
	Услуги.Колонки.Добавить("СуммаНДСДоКорректировки");
	Услуги.Колонки.Добавить("СуммаНДСДоИзменения");
	Услуги.Колонки.Добавить("СуммаНДС");
	Услуги.Колонки.Добавить("ЕстьВДокументеПоступленияРеализации");
	
	МассивНоменклатуры = ДанныеИБ.Товары.ВыгрузитьКолонку("Номенклатура");
	
	ЭтоКорректировка = ДанныеИБ.ВидОперации = Перечисления.ВидыОпераций.Корректировка;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(Товары.Характеристика.Наименование, """") КАК ХарактеристикаНаименование,
	|	СправочникНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА СправочникНоменклатура.ЕдиницаИзмерения = Товары.ЕдиницаИзмерения
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ Товары.ЕдиницаИзмерения
	|	КОНЕЦ КАК Упаковка,
	|	Товары.КоличествоУпаковокДоКорректировки КАК КоличествоУпаковокДоКорректировки,
	|	Товары.КоличествоУпаковокДоКорректировки * &КоэффициентУпаковки КАК КоличествоДоКорректировки,
	|	Товары.КоличествоУпаковок * &КоэффициентУпаковки КАК Количество,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.ЦенаДоКорректировки КАК ЦенаДоКорректировки,
	|	Товары.Цена КАК Цена,
	|	Товары.СуммаДоКорректировки КАК СуммаДоКорректировки,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДСДоКорректировки КАК СуммаНДСДоКорректировки,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.НомерГТД КАК НомерГТД,
	|	Товары.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ЕСТЬNULL(СправочникНоменклатура.ВидНоменклатуры.ТипНоменклатуры, ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)) КАК ТипНоменклатуры,
	|	ЕСТЬNULL(Штрихкоды.Штрихкод, НЕОПРЕДЕЛЕНО) КАК Штрихкод,
	|	Товары.НоменклатураКонтрагента КАК SKUКонтрагентаСсылка,
	|	Товары.НаименованиеПоставщика КАК НаименованиеПоставщика
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО Товары.Номенклатура = СправочникНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|		ПО (СправочникНоменклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
	|		ПО Товары.Номенклатура = Штрихкоды.Номенклатура
	|			И Товары.Характеристика = Штрихкоды.Характеристика
	|			И Товары.ЕдиницаИзмерения = Штрихкоды.ЕдиницаИзмерения
	|ГДЕ
	|	Товары.Ссылка = &Ссылка";
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		ДополнитьЗапросДаннымиНоменклатурыКонтрагента(
			Запрос,
			ТаблицаОтбораНоменклатурыКонтрагента(ДанныеИБ),
			СоставДанныхНоменклатурыКонтрагента(),
			0);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	
	Если НЕ ЭтоКорректировка Тогда
		
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ
		|	Товары.НомерСтроки КАК НомерСтроки,
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Характеристика КАК Характеристика,
		|	ЕСТЬNULL(Товары.Характеристика.Наименование, """") КАК ХарактеристикаНаименование,
		|	СправочникНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ВЫБОР
		|		КОГДА СправочникНоменклатура.ЕдиницаИзмерения = Товары.ЕдиницаИзмерения
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ Товары.ЕдиницаИзмерения
		|	КОНЕЦ КАК Упаковка,
		|	Товары.КоличествоУпаковокДоКорректировки КАК КоличествоУпаковокДоКорректировки,
		|	Товары.КоличествоУпаковокДоКорректировки * &КоэффициентУпаковки КАК КоличествоДоКорректировки,
		|	Товары.КоличествоУпаковок * &КоэффициентУпаковки КАК Количество,
		|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
		|	Товары.ЦенаДоКорректировки КАК ЦенаДоКорректировки,
		|	Товары.Цена КАК Цена,
		|	Товары.СуммаДоКорректировки КАК СуммаДоКорректировки,
		|	Товары.Сумма КАК Сумма,
		|	Товары.СтавкаНДС КАК СтавкаНДС,
		|	Товары.СуммаНДСДоКорректировки КАК СуммаНДСДоКорректировки,
		|	Товары.СуммаНДС КАК СуммаНДС,
		|	Товары.НомерГТД КАК НомерГТД,
		|	Товары.СтранаПроисхождения КАК СтранаПроисхождения,
		|	ЕСТЬNULL(СправочникНоменклатура.ВидНоменклатуры.ТипНоменклатуры, ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)) КАК ТипНоменклатуры,
		|	ЕСТЬNULL(Штрихкоды.Штрихкод, НЕОПРЕДЕЛЕНО) КАК Штрихкод,
		|	Товары.НоменклатураКонтрагента КАК SKUКонтрагентаСсылка,
		|	Товары.НаименованиеПоставщика КАК НаименованиеПоставщика
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг.Товары КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|		ПО Товары.Номенклатура = СправочникНоменклатура.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|		ПО (СправочникНоменклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
		|		ПО Товары.Номенклатура = Штрихкоды.Номенклатура
		|			И Товары.Характеристика = Штрихкоды.Характеристика
		|			И Товары.ЕдиницаИзмерения = Штрихкоды.ЕдиницаИзмерения
		|ГДЕ
		|	Товары.Ссылка = &ДокументОснование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.ОблагаетсяНДСУПокупателя КАК ОблагаетсяНДСУПокупателя
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Ссылка = &ДокументОснование";
		
		Запрос.УстановитьПараметр("ДокументОснование", ДанныеИБ.ДокументОснование);
		
		Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
			ДополнитьЗапросДаннымиНоменклатурыКонтрагента(
				Запрос,
				ТаблицаОтбораНоменклатурыКонтрагента(ДанныеИБ),
				СоставДанныхНоменклатурыКонтрагента(),
				1);
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КоэффициентУпаковки",
		Справочники.ЕдиницыИзмерения.ТекстЗапросаКоэффициентУпаковки("Товары.ЕдиницаИзмерения"));
	
	РезультатыЗапросов = Запрос.ВыполнитьПакет();
	
	ТоварыДоИсправления = Неопределено;
	Если НЕ ЭтоКорректировка И НЕ РезультатыЗапросов[1].Пустой() Тогда
		ТоварыДоИсправления = Новый ТаблицаЗначений;
		Для Каждого Колонка Из РезультатыЗапросов[1].Колонки Цикл
			ТоварыДоИсправления.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
		КонецЦикла;
		ВыборкаДоИсправления = РезультатыЗапросов[1].Выбрать();
		Пока ВыборкаДоИсправления.СледующийПоЗначениюПоля("НомерСтроки") Цикл
			ЗаполнитьЗначенияСвойств(ТоварыДоИсправления.Добавить(), ВыборкаДоИсправления);
		КонецЦикла;
	КонецЕсли;
	
	УстановитьОблагаетсяНДСУПокупателя = Ложь;
	УстановитьОблагаетсяНДСУПокупателяДоИсправления = Ложь;
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.6") Тогда
		УстановитьОблагаетсяНДСУПокупателя = ДанныеИБ.ОблагаетсяНДСУПокупателя;
		Если ТоварыДоИсправления <> Неопределено Тогда
			ВыборкаДоИсправления = РезультатыЗапросов[2].Выбрать();
			Если ВыборкаДоИсправления.Следующий() Тогда
				УстановитьОблагаетсяНДСУПокупателяДоИсправления = ВыборкаДоИсправления.ОблагаетсяНДСУПокупателя;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ЕдиницаИзмеренияПустаяСсылка = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
	
	Выборка = РезультатыЗапросов[0].Выбрать();
	Пока Выборка.СледующийПоЗначениюПоля("НомерСтроки") Цикл
		ЭтоТовар = Не ЭтоУслуга(Выборка.ТипНоменклатуры);
		
		Если ЭтоТовар Тогда
			НоваяСтрока = Товары.Добавить();
		Иначе
			НоваяСтрока = Услуги.Добавить();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		ЗаполнитьНоменклатуруХарактеристику(КомпонентыОбмена, НоваяСтрока, Выборка, НЕ ЭтоТовар);
		
		Если ЭтоКорректировка Тогда
			НоваяСтрока.КоличествоДоИзменения         = Выборка.КоличествоДоКорректировки;
			НоваяСтрока.КоличествоУпаковокДоИзменения = Выборка.КоличествоУпаковокДоКорректировки;
			НоваяСтрока.ЦенаДоИзменения               = Выборка.ЦенаДоКорректировки;
			НоваяСтрока.СуммаДоИзменения              = Выборка.СуммаДоКорректировки;
			НоваяСтрока.СтавкаНДСДоИзменения          = Выборка.СтавкаНДС;
			НоваяСтрока.СуммаНДСДоИзменения           = Выборка.СуммаНДСДоКорректировки;
			Если ЭтоТовар Тогда
				НоваяСтрока.НомерГТДДоИзменения = Выборка.НомерГТД;
				НоваяСтрока.СтранаПроисхожденияДоИзменения = Выборка.СтранаПроисхождения;
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(ТоварыДоИсправления) Тогда
			Отбор = Новый Структура;
			Отбор.Вставить("SKUКонтрагентаСсылка", Выборка.SKUКонтрагентаСсылка);
			Отбор.Вставить("СтавкаНДС", Выборка.СтавкаНДС);
			Если ЭтоТовар Тогда
				Отбор.Вставить("ЕдиницаИзмерения", Выборка.ЕдиницаИзмерения);
			КонецЕсли;
			Если НоваяСтрока.КоличествоДоКорректировки > 0 Тогда
				Отбор.Вставить("КоличествоДоКорректировки", Выборка.КоличествоДоКорректировки);
				Отбор.Вставить("ЦенаДоКорректировки",       Выборка.ЦенаДоКорректировки);
			КонецЕсли;
			
			НайденныеСтроки = ТоварыДоИсправления.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() Тогда
				СтрокаДоИзменения = НайденныеСтроки[0];
				НоваяСтрока.КоличествоДоИзменения         = СтрокаДоИзменения.Количество;
				НоваяСтрока.КоличествоУпаковокДоИзменения = СтрокаДоИзменения.КоличествоУпаковок;
				НоваяСтрока.ЦенаДоИзменения               = СтрокаДоИзменения.Цена;
				НоваяСтрока.СуммаДоИзменения              = СтрокаДоИзменения.Сумма;
				НоваяСтрока.СтавкаНДСДоИзменения          = СтрокаДоИзменения.СтавкаНДС;
				НоваяСтрока.СуммаНДСДоИзменения           = СтрокаДоИзменения.СуммаНДС;
				Если ЭтоТовар Тогда
					НоваяСтрока.НомерГТДДоИзменения = СтрокаДоИзменения.НомерГТД;
					НоваяСтрока.СтранаПроисхожденияДоИзменения = СтрокаДоИзменения.СтранаПроисхождения;
				КонецЕсли;
				
				Если УстановитьОблагаетсяНДСУПокупателяДоИсправления Тогда
					НоваяСтрока.СуммаНДСДоИзменения = СтавкаОблагаетсяНДСУПокупателя();
				КонецЕсли;
				
				ТоварыДоИсправления.Удалить(СтрокаДоИзменения);
			КонецЕсли;
		КонецЕсли;
		
		Если УстановитьОблагаетсяНДСУПокупателя Тогда
			НоваяСтрока.СтавкаНДС = СтавкаОблагаетсяНДСУПокупателя();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НоваяСтрока.КоличествоДоКорректировки)
			ИЛИ ЗначениеЗаполнено(НоваяСтрока.КоличествоДоИзменения) Тогда
			НоваяСтрока.ЕстьВДокументеПоступленияРеализации = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТоварыДоИсправления) Тогда
		
		Для Каждого СтрокаДоИзменения Из ТоварыДоИсправления Цикл
			ЭтоТовар = Не ЭтоУслуга(СтрокаДоИзменения.ТипНоменклатуры);
			
			Если ЭтоТовар Тогда
				НоваяСтрока = Товары.Добавить();
			Иначе
				НоваяСтрока = Услуги.Добавить();
			КонецЕсли;
		
			Номенклатура = Неопределено;
			Если ЗначениеЗаполнено(СтрокаДоИзменения.Номенклатура) Тогда
				Номенклатура = Выборка.Номенклатура;
			ИначеЕсли ЗначениеЗаполнено(Выборка.SKUКонтрагентаСсылка) Тогда
				Номенклатура = НовыйИнструкция(
					"Справочник_Номенклатура_ИзНоменклатурыКонтрагента", Выборка.SKUКонтрагентаСсылка);
			КонецЕсли;
			
			НоваяСтрока.Номенклатура                  = Номенклатура;
			НоваяСтрока.КоличествоДоИзменения         = СтрокаДоИзменения.Количество;
			НоваяСтрока.КоличествоУпаковокДоИзменения = СтрокаДоИзменения.КоличествоУпаковок;
			НоваяСтрока.ЦенаДоИзменения               = СтрокаДоИзменения.Цена;
			НоваяСтрока.СуммаДоИзменения              = СтрокаДоИзменения.Сумма;
			НоваяСтрока.СтавкаНДСДоИзменения          = СтрокаДоИзменения.СтавкаНДС;
			НоваяСтрока.СуммаНДСДоИзменения           = СтрокаДоИзменения.СуммаНДС;
			Если ЭтоТовар Тогда
				НоваяСтрока.НомерГТДДоИзменения = СтрокаДоИзменения.НомерГТД;
				НоваяСтрока.СтранаПроисхожденияДоИзменения = СтрокаДоИзменения.СтранаПроисхождения;
				
				Если ЗначениеЗаполнено(СтрокаДоИзменения.Номенклатура)
					И ЗначениеЗаполнено(СтрокаДоИзменения.Характеристика) Тогда
					НоваяСтрока.Характеристика = Новый Структура("Ссылка, Наименование, Владелец",
						СтрокаДоИзменения.Характеристика, СтрокаДоИзменения.ХарактеристикаНаименование, Номенклатура);
				КонецЕсли;
				
			КонецЕсли;
			
			Если УстановитьОблагаетсяНДСУПокупателяДоИсправления Тогда
				НоваяСтрока.СуммаНДСДоИзменения = СтавкаОблагаетсяНДСУПокупателя();
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НоваяСтрока.КоличествоДоИзменения) Тогда
				НоваяСтрока.ЕстьВДокументеПоступленияРеализации = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Товары) Тогда
		ЗаполнитьСтавкуНДСВТаблице(Товары, "СтавкаНДС", "СтавкаНДСДоИзменения", КомпонентыОбмена);
		ЗаполнитьСтавкуНДСВТаблице(Товары, "СтавкаНДС", "СтавкаНДС", КомпонентыОбмена);
		ДанныеXDTO.Вставить("Товары", Товары);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Услуги) Тогда
		ЗаполнитьСтавкуНДСВТаблице(Услуги, "СтавкаНДС", "СтавкаНДСДоИзменения", КомпонентыОбмена);
		ЗаполнитьСтавкуНДСВТаблице(Услуги, "СтавкаНДС", "СтавкаНДС", КомпонентыОбмена);
		ДанныеXDTO.Вставить("Услуги", Услуги);
	КонецЕсли;
КонецПроцедуры
Функция ЗаполнитьХарактеристикиПослеЗагрузкиДокумента(Объект, КомпонентыОбмена)
	ХарактеристикиЗаполнены = Ложь;
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Документ", Объект.Ссылка);
	
	ХарактеристикиДокумента = КомпонентыОбмена.ПараметрыКонвертации.ХарактеристикиДопОбработка.Скопировать(СтруктураПоиска,
		"КлючСвязи, Номенклатура, НаименованиеПолное, ЗначениеСсылки, СсылкаПоЗначению");
	
	Если ХарактеристикиДокумента.Количество() = 0 Тогда
		Возврат ХарактеристикиЗаполнены;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ХарактеристикиДокумента.КлючСвязи КАК КлючСвязи,
		|	ХарактеристикиДокумента.Номенклатура КАК Номенклатура,
		|	ВЫРАЗИТЬ(ХарактеристикиДокумента.НаименованиеПолное КАК СТРОКА(150)) КАК НаименованиеПолное,
		|	ХарактеристикиДокумента.ЗначениеСсылки КАК ЗначениеСсылки,
		|	ХарактеристикиДокумента.СсылкаПоЗначению КАК СсылкаПоЗначению
		|ПОМЕСТИТЬ ВТ_Характеристики
		|ИЗ
		|	&Таблица КАК ХарактеристикиДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Характеристики.КлючСвязи КАК КлючСвязи,
		|	ВТ_Характеристики.НаименованиеПолное КАК НаименованиеПолное,
		|	ВТ_Характеристики.ЗначениеСсылки КАК ЗначениеСсылки,
		|	ВТ_Характеристики.СсылкаПоЗначению КАК СсылкаПоЗначению,
		|	ВЫБОР
		|		КОГДА ВидыНоменклатуры.ИндивидуальныеХарактеристикиНоменклатуры
		|			ТОГДА СправочникНоменклатура.Ссылка
		|		ИНАЧЕ ВидыНоменклатуры.Ссылка
		|	КОНЕЦ КАК Владелец,
		|	ХарактеристикиПоНаименованию.Ссылка КАК Характеристика,
		|	ВидыНоменклатуры.ИспользоватьХарактеристики КАК ИспользоватьХарактеристики,
		|	ВидыНоменклатуры.Ссылка КАК ВидНоменклатуры
		|ИЗ
		|	ВТ_Характеристики КАК ВТ_Характеристики
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|		ПО ВТ_Характеристики.Номенклатура = СправочникНоменклатура.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|		ПО (СправочникНоменклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиПоСсылке
		|		ПО ВТ_Характеристики.СсылкаПоЗначению = ХарактеристикиПоСсылке.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиПоНаименованию
		|		ПО (ВЫБОР
		|				КОГДА ВидыНоменклатуры.ИндивидуальныеХарактеристикиНоменклатуры
		|					ТОГДА СправочникНоменклатура.Ссылка
		|				ИНАЧЕ ВидыНоменклатуры.Ссылка
		|			КОНЕЦ = ХарактеристикиПоНаименованию.Владелец)
		|			И (НЕ ХарактеристикиПоНаименованию.ПометкаУдаления)
		|			И ВТ_Характеристики.НаименованиеПолное = ХарактеристикиПоНаименованию.Наименование
		|ГДЕ
		|	ХарактеристикиПоСсылке.Ссылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_Характеристики.КлючСвязи,
		|	ВТ_Характеристики.НаименованиеПолное,
		|	ВТ_Характеристики.ЗначениеСсылки,
		|	ВТ_Характеристики.СсылкаПоЗначению,
		|	ВТ_Характеристики.Номенклатура,
		|	ХарактеристикиНоменклатуры.Ссылка,
		|	ИСТИНА,
		|	НЕОПРЕДЕЛЕНО
		|ИЗ
		|	ВТ_Характеристики КАК ВТ_Характеристики
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|		ПО ВТ_Характеристики.СсылкаПоЗначению = ХарактеристикиНоменклатуры.Ссылка
		|ГДЕ
		|	НЕ ХарактеристикиНоменклатуры.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Таблица", ХарактеристикиДокумента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	КэшХарактеристик = Новый ТаблицаЗначений;
	КэшХарактеристик.Колонки.Добавить("Владелец");
	КэшХарактеристик.Колонки.Добавить("НаименованиеПолное");
	КэшХарактеристик.Колонки.Добавить("ЗначениеСсылки");
	КэшХарактеристик.Колонки.Добавить("СсылкаНаОбъект");
	
	Отбор = Новый Структура("Владелец,НаименованиеПолное,ЗначениеСсылки");
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.СледующийПоЗначениюПоля("КлючСвязи") Цикл
		
		Если Не Выборка.ИспользоватьХарактеристики Тогда
			Если ЗначениеЗаполнено(Выборка.ВидНоменклатуры) Тогда
				ЗарегистрироватьОшибкуНастройкиВидаНоменклатуры(Выборка.ВидНоменклатуры, КомпонентыОбмена);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если Выборка.Владелец = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.Характеристика) Тогда 
			Объект.Товары[Выборка.КлючСвязи].Характеристика = Выборка.Характеристика;
		Иначе
			Характеристика = Неопределено;
			ЗаполнитьЗначенияСвойств(Отбор, Выборка);
			НайденныеСтроки = КэшХарактеристик.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() Тогда
				Характеристика = НайденныеСтроки.СсылкаНаОбъект;
			Иначе
				Если ЗначениеЗаполнено(Выборка.СсылкаПоЗначению) Тогда
					НоваяХарактеристика = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
					НоваяХарактеристика.УстановитьСсылкуНового(Выборка.СсылкаПоЗначению);
				Иначе 
					НоваяХарактеристика = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
				КонецЕсли;
				
				НоваяХарактеристика.Владелец = Выборка.Владелец;
				НоваяХарактеристика.Наименование = СокрЛП(Выборка.НаименованиеПолное);
				НоваяХарактеристика.ОбменДанными.Загрузка = Истина;
				НоваяХарактеристика.Записать();
				
				Характеристика = НоваяХарактеристика.Ссылка;
				
				Кэш = КэшХарактеристик.Добавить();
				ЗаполнитьЗначенияСвойств(Кэш, Выборка);
				Кэш.СсылкаНаОбъект = Характеристика;
			КонецЕсли;
			
			Объект.Товары[Выборка.КлючСвязи].Характеристика = Характеристика;
		КонецЕсли;
		
		ХарактеристикиЗаполнены = Истина;
	КонецЦикла;
	
	МассивСтрок = КомпонентыОбмена.ПараметрыКонвертации.ХарактеристикиДопОбработка.НайтиСтроки(СтруктураПоиска);
	
	Для Каждого СтрокаМассива Из МассивСтрок Цикл 
		КомпонентыОбмена.ПараметрыКонвертации.ХарактеристикиДопОбработка.Удалить(СтрокаМассива);
	КонецЦикла;
	
	Возврат ХарактеристикиЗаполнены;
КонецФункции
Процедура ЗаполнитьШтрихкодПоСтроке(СтрокаТаблицыТоваров, ТаблицаШтрихкодов)
	Отбор = Новый Структура;
	Отбор.Вставить("Номенклатура", СтрокаТаблицыТоваров.Номенклатура);
	
	Отбор.Вставить("Характеристика", 
		?(ЗначениеЗаполнено(СтрокаТаблицыТоваров.Характеристика),
		СтрокаТаблицыТоваров.Характеристика,
		Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка()));
	
	Отбор.Вставить("Упаковка", 
		?(ЗначениеЗаполнено(СтрокаТаблицыТоваров.Упаковка),
		СтрокаТаблицыТоваров.Упаковка,
		СтрокаТаблицыТоваров.ЕдиницаИзмерения));
		
	НайденныеШтрихкоды = ТаблицаШтрихкодов.НайтиСтроки(Отбор);
	Если ЗначениеЗаполнено(НайденныеШтрихкоды) Тогда
		СтрокаТаблицыТоваров.Штрихкод = СокрЛП(НайденныеШтрихкоды[0].Штрихкод);
	КонецЕсли;
КонецПроцедуры
Процедура ЗарегистрироватьОшибкуЗаписиБанковскогоСчета(НаименованиеСчета)
	СтрокаСообщения = НСтр("ru = 'Не удалось записать банковский счет %1, полученный из другой информационной базы.
		|Владелец счета физическое лицо.'",
		ОбщегоНазначения.КодОсновногоЯзыка());
	СтрокаСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, НаименованиеСчета);
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Обмен данными'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Предупреждение,,, СтрокаСообщения);
КонецПроцедуры
Процедура ЗарегистрироватьОшибкуЗаписиОбъекта(Объект, УзелОбмена, ТекстИсключения)
	СообщенияПользователю = ПолучитьСообщенияПользователю(Истина);
	ТекстСообщения = ТекстИсключения;
	Для Каждого Сообщение Из СообщенияПользователю Цикл
		ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения), "", Символы.ПС) + Сообщение.Текст;
	КонецЦикла;
	
	ПричинаОшибки = ТекстСообщения;
	Если Не ПустаяСтрока(СокрЛП(ТекстСообщения)) Тогда
		
		ПричинаОшибки = " " + НСтр("ru = 'По причине %1.'");
		ПричинаОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПричинаОшибки, ТекстСообщения);
		
	КонецЕсли;
	
	СтрокаСообщения = НСтр("ru = 'Не удалось записать объект %1, полученный из другой информационной базы.%2
		|Возможно не заполнены все реквизиты, обязательные к заполнению.'",
		ОбщегоНазначения.КодОсновногоЯзыка());
	СтрокаСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Строка(Объект), ПричинаОшибки);
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Обмен данными'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Предупреждение,,, СтрокаСообщения);
	
	РегистрыСведений.РезультатыОбменаДанными.ЗарегистрироватьОшибкуПроверкиОбъекта(Объект.Ссылка, УзелОбмена,
		ТекстСообщения, Перечисления.ТипыПроблемОбменаДанными.НезаполненныеРеквизиты);
КонецПроцедуры
Процедура ЗарегистрироватьОшибкуНастройкиВидаНоменклатуры(Ссылка, КомпонентыОбмена)
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОшибки = Нстр("ru = 'Не настроено использование характеристик. Загрузка характеристик номенклатуры по данному виду не производится.'");
	ЗарегистрироватьОшибкуЗаписиОбъекта(Объект, КомпонентыОбмена.УзелКорреспондента, ОписаниеОшибки);
КонецПроцедуры
Процедура ЗарегистрироватьОшибкуПроведенияДокумента(Объект, УзелОбмена, ТекстИсключения, РегистрироватьПроблемыВРезультатахОбмена = Истина)
	СообщенияПользователю = ПолучитьСообщенияПользователю(Истина);
	ТекстСообщения = ТекстИсключения;
	Для Каждого Сообщение Из СообщенияПользователю Цикл
		ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения), "", Символы.ПС) + Сообщение.Текст;
	КонецЦикла;
	
	ПричинаОшибки = ТекстСообщения;
	Если Не ПустаяСтрока(СокрЛП(ТекстСообщения)) Тогда
		
		ПричинаОшибки = " " + НСтр("ru = 'По причине %1.'");
		ПричинаОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПричинаОшибки, ТекстСообщения);
		
	КонецЕсли;
	
	СтрокаСообщения = НСтр("ru = 'Не удалось провести документ %1, полученный из другой информационной базы.%2
		|Возможно не заполнены все реквизиты, обязательные к заполнению.'",
		ОбщегоНазначения.КодОсновногоЯзыка());
	СтрокаСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Строка(Объект), ПричинаОшибки);
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Обмен данными'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Предупреждение,,, СтрокаСообщения);
	
	Если РегистрироватьПроблемыВРезультатахОбмена Тогда
		РегистрыСведений.РезультатыОбменаДанными.ЗарегистрироватьОшибкуПроверкиОбъекта(Объект.Ссылка, УзелОбмена,
			ТекстСообщения, Перечисления.ТипыПроблемОбменаДанными.НепроведенныйДокумент);
	КонецЕсли;
КонецПроцедуры
Функция ЗначениеИзСвойствXDTO(ДанныеXDTO, ИмяСвойства, ЗначениеПоУмолчанию)
	Если Не ДанныеXDTO.Свойство(ИмяСвойства)
		Или Не ЗначениеЗаполнено(ДанныеXDTO[ИмяСвойства]) Тогда
		Возврат ЗначениеПоУмолчанию; 
	КонецЕсли;
	
	Возврат ДанныеXDTO[ИмяСвойства];
КонецФункции
Функция ЗначениеСтавкиНДСПоXDTO(КомпонентыОбмена, СтавкаНДСXDTO)
	Если Не ЗначениеЗаполнено(СтавкаНДСXDTO) Тогда
		Возврат Перечисления.СтавкиНДС.ПустаяСсылка();
	КонецЕсли; 
	
	Ставка = ЗначениеИзСвойствXDTO(СтавкаНДСXDTO, "Ставка", 0);
	РасчетнаяСтавка = ЗначениеИзСвойствXDTO(СтавкаНДСXDTO, "РасчетнаяСтавка", Ложь);
	НеОблагается = ЗначениеИзСвойствXDTO(СтавкаНДСXDTO, "НеОблагается", Ложь);
	
	Если Не ЗначениеЗаполнено(Ставка) Тогда
		Возврат ?(НеОблагается, Перечисления.СтавкиНДС.БезНДС, Перечисления.СтавкиНДС.НДС0);
	КонецЕсли;
	
	ЗначенияСтавокНДС = КомпонентыОбмена.ПараметрыКонвертации.ЗначенияСтавокНДС;
	
	ОтборСтавок = Новый Структура();
	ОтборСтавок.Вставить("Ставка", Ставка);
	ОтборСтавок.Вставить("РасчетнаяСтавка", РасчетнаяСтавка);
	
	ПодходящиеСтавки = ЗначенияСтавокНДС.НайтиСтроки(ОтборСтавок);
	
	Если Не ЗначениеЗаполнено(ПодходящиеСтавки) Тогда
		Возврат Перечисления.СтавкиНДС.ПустаяСсылка();
	Иначе
		Возврат ПодходящиеСтавки[0].СтавкаНДС;
	КонецЕсли;
КонецФункции
Функция ИнструкцииПоВыгрузкеSKUКонтрагента(КомпонентыОбмена, СтрокаДокумента)
	Если Не ЗначениеЗаполнено(СтрокаДокумента.SKUКонтрагентаСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НоменклатураКонтрагента = Новый Структура;
	НоменклатураКонтрагента.Вставить("Ссылка", СтрокаДокумента.SKUКонтрагентаСсылка);
	НоменклатураКонтрагента.Вставить("Наименование", СтрокаДокумента.SKUКонтрагентаНаименование);
	НоменклатураКонтрагента.Вставить("Артикул", СтрокаДокумента.SKUКонтрагентаАртикул);
	НоменклатураКонтрагента.Вставить("Идентификатор", СтрокаДокумента.SKUКонтрагентаИдентификатор);
	НоменклатураКонтрагента.Вставить("Штрихкод", СтрокаДокумента.SKUКонтрагентаШтрихкод);
	
	ЕдиницаИзмерения = Новый Структура;
	ЕдиницаИзмерения.Вставить("Наименование",
		СтрокаДокумента.SKUКонтрагентаНаименованиеБазовойЕдиницыИзмерения);
	ЕдиницаИзмерения.Вставить("Код", СтрокаДокумента.SKUКонтрагентаКодОКЕИБазовойЕдиницыИзмерения);
	
	ЕдиницаИзмеренияИнструкция = НовыйИнструкция("Справочник_ЕдиницыИзмерения_ИзСтруктуры", ЕдиницаИзмерения); 
	
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		НоменклатураКонтрагента.Вставить("Владелец", СтрокаДокумента.SKUКонтрагентаВладелец);
		НоменклатураКонтрагента.Вставить("ИдентификаторНоменклатурыСервиса1СНоменклатура",
			СтрокаДокумента.SKUКонтрагентаИдентификаторНоменклатурыСервиса1СНоменклатура);
		НоменклатураКонтрагента.Вставить("ИдентификаторХарактеристикиСервиса1СНоменклатура",
			СтрокаДокумента.SKUКонтрагентаИдентификаторХарактеристикиСервиса1СНоменклатура);
	
		Номенклатура = Новый Структура;
		Номенклатура.Вставить("Наименование", СтрокаДокумента.SKUКонтрагентаНаименование);
		Номенклатура.Вставить("Артикул", СтрокаДокумента.SKUКонтрагентаАртикул);
		Номенклатура.Вставить("ИдентификаторСервиса1СНоменклатура",
			СтрокаДокумента.SKUКонтрагентаИдентификаторНоменклатурыСервиса1СНоменклатура);
		
		НоменклатураИнструкция = НовыйИнструкция("Справочник_Номенклатура_ИзСтруктуры_Отправка", Номенклатура);
		
		Если ЗначениеЗаполнено(СтрокаДокумента.SKUКонтрагентаУпаковкаНаименование)
			Или ЗначениеЗаполнено(СтрокаДокумента.SKUКонтрагентаНаименованиеБазовойЕдиницыИзмерения) Тогда
			Упаковка = Новый Структура;
			Упаковка.Вставить("ЕдиницаИзмерения", ЕдиницаИзмеренияИнструкция);
			Упаковка.Вставить("Номенклатура", НоменклатураИнструкция);
		
			Если ЗначениеЗаполнено(СтрокаДокумента.SKUКонтрагентаУпаковкаНаименование) Тогда
				Упаковка.Вставить("Наименование", СтрокаДокумента.SKUКонтрагентаУпаковкаНаименование);
				Упаковка.Вставить("Коэффициент",
					?(СтрокаДокумента.SKUКонтрагентаУпаковкаЗнаменатель = 0,
						СтрокаДокумента.SKUКонтрагентаУпаковкаЧислитель,
						Окр(СтрокаДокумента.SKUКонтрагентаУпаковкаЧислитель / СтрокаДокумента.SKUКонтрагентаУпаковкаЗнаменатель, 3)));
			Иначе
				Упаковка.Вставить("Наименование",
					СтрокаДокумента.SKUКонтрагентаНаименованиеБазовойЕдиницыИзмерения);
				Упаковка.Вставить("Коэффициент", 1);
			КонецЕсли;
			
			УпаковкаИнструкция = НовыйИнструкция("Справочник_УпаковкиSKUКонтрагента_ИзСтруктуры", Упаковка);
			
			НоменклатураКонтрагента.Вставить("УпаковкаНоменклатуры", УпаковкаИнструкция);
		КонецЕсли;
	Иначе			
		НоменклатураКонтрагента.Вставить("ЕдиницаИзмерения", ЕдиницаИзмеренияИнструкция);		
	КонецЕсли;
	
	
	Возврат	НовыйИнструкция("Справочник_SKUКонтрагента_ИзСтруктуры_Отправка", НоменклатураКонтрагента);
КонецФункции
Функция ИнструкцияПоВыгрузкеУпаковки(КомпонентыОбмена, СтрокаДокумента)
	ВерсияФорматаЧислом = ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена);		
		ЕдиницаИзмерения = Новый Структура;
		
		Если ВерсияФорматаЧислом >= ВерсияФорматаЧислом("1.8") Тогда
		
			ЕдиницаИзмерения.Вставить("Наименование",
				СтрокаДокумента.SKUКонтрагентаНаименованиеБазовойЕдиницыИзмерения);
			ЕдиницаИзмерения.Вставить("Код", 
				СтрокаДокумента.SKUКонтрагентаКодОКЕИБазовойЕдиницыИзмерения);
			
			ЕдиницаИзмеренияИнструкция = НовыйИнструкция("Справочник_ЕдиницыИзмерения_ИзСтруктуры", ЕдиницаИзмерения); 
			
			НаименованиеНоменклатуры = ?(ЗначениеЗаполнено(СтрокаДокумента.SKUКонтрагентаНаименование),
				СтрокаДокумента.SKUКонтрагентаНаименование, 
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДокумента.SKUКонтрагентаСсылка, "Наименование"));
			
			Номенклатура = Новый Структура;
			Номенклатура.Вставить("Наименование", НаименованиеНоменклатуры);
			Номенклатура.Вставить("Артикул", СтрокаДокумента.SKUКонтрагентаАртикул);
			Номенклатура.Вставить("ИдентификаторСервиса1СНоменклатура",
				СтрокаДокумента.SKUКонтрагентаИдентификаторНоменклатурыСервиса1СНоменклатура);
			
			НоменклатураИнструкция = НовыйИнструкция("Справочник_Номенклатура_ИзСтруктуры_Отправка", Номенклатура);
	
		Иначе
	
			ЕдиницаИзмерения.Вставить("Наименование",
				СтрокаДокумента.SKUКонтрагентаСсылка.НаименованиеБазовойЕдиницыИзмерения);
			ЕдиницаИзмерения.Вставить("Код", 
				СтрокаДокумента.SKUКонтрагентаСсылка.КодОКЕИБазовойЕдиницыИзмерения);
			
			ЕдиницаИзмеренияИнструкция = НовыйИнструкция("Справочник_ЕдиницыИзмерения_ИзСтруктуры", ЕдиницаИзмерения); 
			
			Номенклатура = Новый Структура;
			Номенклатура.Вставить("Наименование", СтрокаДокумента.SKUКонтрагентаСсылка.Наименование);
			Номенклатура.Вставить("Артикул", СтрокаДокумента.SKUКонтрагентаСсылка.Артикул);
			Номенклатура.Вставить("ИдентификаторСервиса1СНоменклатура",
				СтрокаДокумента.SKUКонтрагентаСсылка.ИдентификаторНоменклатурыСервиса);
			
			НоменклатураИнструкция = НовыйИнструкция("Справочник_Номенклатура_ИзСтруктуры_Отправка", Номенклатура);
			
		КонецЕсли;
		
		Упаковка = Новый Структура;
		Упаковка.Вставить("ЕдиницаИзмерения", ЕдиницаИзмеренияИнструкция);
		Упаковка.Вставить("Номенклатура", НоменклатураИнструкция);
	
		Если ВерсияФорматаЧислом >= ВерсияФорматаЧислом("1.8") Тогда
		
			Если ЗначениеЗаполнено(СтрокаДокумента.SKUКонтрагентаУпаковкаНаименование) Тогда
				Упаковка.Вставить("Наименование", СтрокаДокумента.SKUКонтрагентаУпаковкаНаименование);
				Упаковка.Вставить("Коэффициент",
					?(СтрокаДокумента.SKUКонтрагентаУпаковкаЗнаменатель = 0,
						СтрокаДокумента.SKUКонтрагентаУпаковкаЧислитель,
						Окр(СтрокаДокумента.SKUКонтрагентаУпаковкаЧислитель / СтрокаДокумента.SKUКонтрагентаУпаковкаЗнаменатель, 3)));
			Иначе
				Упаковка.Вставить("Наименование",
				СтрокаДокумента.SKUКонтрагентаНаименованиеБазовойЕдиницыИзмерения);
				Упаковка.Вставить("Коэффициент", 1);
			КонецЕсли;
	
		Иначе
	
			Если ЗначениеЗаполнено(СтрокаДокумента.SKUКонтрагентаСсылка.НаименованиеУпаковки) Тогда
				Упаковка.Вставить("Наименование", СтрокаДокумента.SKUКонтрагентаСсылка.НаименованиеУпаковки);
				Упаковка.Вставить("Коэффициент",
					?(СтрокаДокумента.SKUКонтрагентаСсылка.КоличествоУпаковок = 0,
						СтрокаДокумента.SKUКонтрагентаСсылка.КоличествоБазовойЕдиницыИзмерения,
						Окр(СтрокаДокумента.SKUКонтрагентаСсылка.КоличествоБазовойЕдиницыИзмерения / СтрокаДокумента.SKUКонтрагентаСсылка.КоличествоУпаковок, 3)));
			Иначе
				Упаковка.Вставить("Наименование",
				СтрокаДокумента.SKUКонтрагентаСсылка.НаименованиеБазовойЕдиницыИзмерения);
				Упаковка.Вставить("Коэффициент", 1);
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат НовыйИнструкция("Справочник_УпаковкиSKUКонтрагента_ИзСтруктуры", Упаковка);
КонецФункции
Функция ИсправляемыйДокументПоступления(ДокументОснование, ДокументыОснования = Неопределено)
	Если ДокументыОснования = Неопределено Тогда
		ДокументыОснования = Новый Массив;
	КонецЕсли;
	
	ДокументыОснования.Добавить(ДокументОснование);
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование,
			"ВидОперации,ДокументОснование,НомерИсправляемогоКорректировочногоДокумента");
			
		Если РеквизитыДокумента.ВидОперации = Перечисления.ВидыОпераций.Исправление
			И ЗначениеЗаполнено(РеквизитыДокумента.НомерИсправляемогоКорректировочногоДокумента)
			И ДокументыОснования.Найти(РеквизитыДокумента.ДокументОснование) = Неопределено Тогда
			
			Возврат ИсправляемыйДокументПоступления(РеквизитыДокумента.ДокументОснование, ДокументыОснования);
		Иначе
		
			ИмяПКО = "Документ_ПоступлениеТоваровУслуг_Отправка";
			Если РеквизитыДокумента.ВидОперации <> Перечисления.ВидыОпераций.Реализация Тогда
				ИмяПКО = "Документ_КорректировкаПоступления_Отправка";
			КонецЕсли;
			 
			Возврат Новый Структура("Значение, ИмяПКО", ДокументОснование, ИмяПКО);
		КонецЕсли;
	Иначе
		Возврат ДокументОснование;
	КонецЕсли;
КонецФункции
Функция КонтрагентРозничныйПокупатель(КомпонентыОбмена)
	ПараметрыКонвертации = КомпонентыОбмена.ПараметрыКонвертации;
	Если ЗначениеЗаполнено(ПараметрыКонвертации.КонтрагентРозничныйПокупатель) Тогда
		Возврат ПараметрыКонвертации.КонтрагентРозничныйПокупатель;
	КонецЕсли;
	
	Элемент = Справочники.Контрагенты.ПустаяСсылка();
	
	НаименованиеЭлементаДляОбменаПоУмолчанию = НСтр("ru='Розничный покупатель'");
	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|Контрагенты.Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	НЕ Контрагенты.ПометкаУдаления
		|	И Контрагенты.Наименование = &НаименованиеЭлементаДляОбменаПоУмолчанию");
	
	Запрос.УстановитьПараметр("НаименованиеЭлементаДляОбменаПоУмолчанию", НаименованиеЭлементаДляОбменаПоУмолчанию);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Элемент = Выборка.Ссылка;
	Иначе
	
		// Создание элемента для обмена с заданными параметрами
		КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
		КонтрагентОбъект.Наименование = НаименованиеЭлементаДляОбменаПоУмолчанию;
		КонтрагентОбъект.НаименованиеПолное = КонтрагентОбъект.Наименование;
		КонтрагентОбъект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;
		КонтрагентОбъект.УстановитьНовыйКод();
	
		Попытка
			КонтрагентОбъект.Записать();
			Элемент = КонтрагентОбъект.Ссылка;
		Исключение
		КонецПопытки
		
	КонецЕсли;
	
	ПараметрыКонвертации.КонтрагентРозничныйПокупатель = Элемент;
	
	Возврат Элемент;
КонецФункции
Функция НовыйВидКонтактнойИнформации(Наименование, Родитель, ТипКИ)
	ВидКИОбъект = Справочники.ВидыКонтактнойИнформации.СоздатьЭлемент();
	ВидКИОбъект.Родитель     = Родитель;
	ВидКИОбъект.Наименование = Наименование;
	ВидКИОбъект.Тип          = ТипКИ;
	ВидКИОбъект.Используется = Истина;
	ВидКИОбъект.Записать();
	
	Возврат ВидКИОбъект.Ссылка;
КонецФункции
Функция НовыйИнструкция(ИмяПКО, Значение)
	Возврат Новый Структура("Значение, ИмяПКО", Значение, ИмяПКО);
КонецФункции
Функция НовыйТаблицаТоваров(КомпонентыОбмена)
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НомерСтрокиДокумента");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Характеристика");
	Результат.Колонки.Добавить("ЕдиницаИзмерения");
	Результат.Колонки.Добавить("Упаковка");
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("КоличествоУпаковок", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("ЦенаЗаУпаковку", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("СтавкаНДС");
	Результат.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Штрихкод", Новый ОписаниеТипов("Строка"));
	
	Возврат Результат;
КонецФункции
Функция НовыйТаблицаУслуг(КомпонентыОбмена)
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НомерСтрокиДокумента");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Содержание");
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("СтавкаНДС");
	Результат.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число"));
	
	Возврат Результат;
КонецФункции
Функция НормализованнаяТаблицаТоваров(КомпонентыОбмена, ТоварыXDTO)
	Товары = НовыйТаблицаТоваров(КомпонентыОбмена);
	Для Каждого КолонкаТоваровXDTO Из ТоварыXDTO.Колонки Цикл
		Если Товары.Колонки.Найти(КолонкаТоваровXDTO.Имя) = Неопределено Тогда
			Товары.Колонки.Добавить(КолонкаТоваровXDTO.Имя);
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого СтрокаТоваровXDTO Из ТоварыXDTO Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТоваровXDTO);
		Если Не ЗначениеЗаполнено(НоваяСтрока.Упаковка) Тогда
		    НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
		    НоваяСтрока.ЦенаЗаУпаковку = НоваяСтрока.Цена;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.КоличествоУпаковок) Тогда
			НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.ЦенаЗаУпаковку) Тогда
			НоваяСтрока.ЦенаЗаУпаковку = ?(НоваяСтрока.КоличествоУпаковок > 0, НоваяСтрока.Сумма / НоваяСтрока.КоличествоУпаковок, 0);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Товары;
КонецФункции
Процедура ОтложеннаяОбработка_ЗаказПоставщику(Объект, КомпонентыОбмена, ОбъектМодифицирован)
	ОбъектМодифицирован = Ложь;
	
	ЕстьХарактеристики = КомпонентыОбмена.ПараметрыКонвертации.ХарактеристикиДопОбработка.Найти(
		Объект.Ссылка, "Документ") <> Неопределено;
	Если ЕстьХарактеристики Тогда
		ХарактеристикиЗаполнены = ЗаполнитьХарактеристикиПослеЗагрузкиДокумента(Объект, КомпонентыОбмена);
	Иначе
		ХарактеристикиЗаполнены = Ложь;
	КонецЕсли;
	
	ИзменилисьКлючевыеРеквизиты = Ложь;
	Если КомпонентыОбмена.ПараметрыКонвертации.ДокументыСИзмененнымиКлючевымиРеквизитами.Найти(Объект.Ссылка) <> Неопределено Тогда
		Объект.ДополнительныеСвойства.Вставить("ИзменилисьКлючевыеРеквизиты", Истина);
		ИзменилисьКлючевыеРеквизиты = Истина;
	КонецЕсли;
	
	Если ЕстьХарактеристики И Не ХарактеристикиЗаполнены Тогда
		ОписаниеОшибки = Нстр("ru = 'Характеристики номенклатуры не загружены. Для загрузки необходимо настроить использование характеристик в соответствующих видах номенклатуры.'");
		ЗарегистрироватьОшибкуПроведенияДокумента(
			Объект, КомпонентыОбмена.УзелКорреспондента, ОписаниеОшибки);
	Иначе
		ОбменДаннымиXDTOСервер.ВыполнитьПроведениеДокументаПриЗагрузке(КомпонентыОбмена, Объект, Истина);
	КонецЕсли;
	
	Если (НЕ Объект.Проведен И ИзменилисьКлючевыеРеквизиты)
		ИЛИ ХарактеристикиЗаполнены Тогда
		Объект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
КонецПроцедуры
Процедура ОтложеннаяОбработкаДокумента(Объект, КомпонентыОбмена, ОбъектМодифицирован)
	ОбъектМодифицирован = Ложь;
	
	ЕстьХарактеристики = КомпонентыОбмена.ПараметрыКонвертации.ХарактеристикиДопОбработка.Найти(
		Объект.Ссылка, "Документ") <> Неопределено;
	Если ЕстьХарактеристики Тогда
		ХарактеристикиЗаполнены = ЗаполнитьХарактеристикиПослеЗагрузкиДокумента(Объект, КомпонентыОбмена);
	Иначе
		ХарактеристикиЗаполнены = Ложь;
	КонецЕсли;
	
	ИзменилисьКлючевыеРеквизиты = Ложь;
	Если КомпонентыОбмена.ПараметрыКонвертации.ДокументыСИзмененнымиКлючевымиРеквизитами.Найти(Объект.Ссылка) <> Неопределено Тогда
		Объект.ДополнительныеСвойства.Вставить("ИзменилисьКлючевыеРеквизиты", Истина);
		ИзменилисьКлючевыеРеквизиты = Истина;
	КонецЕсли;
	
	Если ИзменилисьКлючевыеРеквизиты ИЛИ ХарактеристикиЗаполнены Тогда
		Объект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
	Если ЕстьХарактеристики И Не ХарактеристикиЗаполнены Тогда
		ОписаниеОшибки = Нстр("ru = 'Характеристики номенклатуры не загружены. Для загрузки необходимо настроить использование характеристик в соответствующих видах номенклатуры.'");
		ЗарегистрироватьОшибкуПроведенияДокумента(
			Объект, КомпонентыОбмена.УзелКорреспондента, ОписаниеОшибки);
	Иначе
		ОбменДаннымиXDTOСервер.ВыполнитьПроведениеДокументаПриЗагрузке(КомпонентыОбмена, Объект, Истина);
	КонецЕсли;
	
	НайденнаяСтрока = КомпонентыОбмена.ДокументыДляОтложенногоПроведения.Найти(Объект.Ссылка, "ДокументСсылка");
	Если НайденнаяСтрока <> Неопределено Тогда
		КомпонентыОбмена.ДокументыДляОтложенногоПроведения.Удалить(НайденнаяСтрока);
	КонецЕсли;
КонецПроцедуры
Процедура ОтложеннаяОбработкаСправочников(Объект, КомпонентыОбмена, ОбъектМодифицирован)
	// Если справочник загружается в обмене EDI не по ссылке, обработчик должен присутствовать.
КонецПроцедуры
Процедура ПодготовитьДанныеКонтактнаяИнформация(ДанныеИБ, ДанныеXDTO)
	Если ДанныеИБ.КонтактнаяИнформация.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТабКонтактнаяИнформация = Новый ТаблицаЗначений;
	ТабКонтактнаяИнформация.Колонки.Добавить("ЗначенияПолей");
	ТабКонтактнаяИнформация.Колонки.Добавить("ВидКонтактнойИнформации");
	ТабКонтактнаяИнформация.Колонки.Добавить("НаименованиеКонтактнойИнформации");
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	КонтактнаяИнформация.Тип КАК Тип,
		|	КонтактнаяИнформация.Вид КАК Вид,
		|	КонтактнаяИнформация.Представление КАК Представление,
		|	КонтактнаяИнформация.ЗначенияПолей КАК ЗначенияПолей,
		|	ВидыКонтактнойИнформации.Наименование КАК Наименование,
		|	ВидыКонтактнойИнформации.Предопределенный КАК Предопределенный
		|ИЗ
		|	&КонтактнаяИнформация КАК КонтактнаяИнформация
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыКонтактнойИнформации КАК ВидыКонтактнойИнформации
		|		ПО КонтактнаяИнформация.Вид = ВидыКонтактнойИнформации.Ссылка
		|ГДЕ
		|	КонтактнаяИнформация.Ссылка = &Ссылка";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КонтактнаяИнформация",
		ДанныеИБ.Метаданные().ПолноеИмя() + ".КонтактнаяИнформация");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Вид)
			ИЛИ (НЕ ЗначениеЗаполнено(Выборка.ЗначенияПолей) И НЕ ЗначениеЗаполнено(Выборка.Представление)) Тогда
			Продолжить;
		КонецЕсли;
	
		СтрокаТЗКИ = ТабКонтактнаяИнформация.Добавить();
	
		Если Лев(СокрЛ(Выборка.ЗначенияПолей),1) = "<" Тогда
			// КИ в правильном формате.
			СтрокаТЗКИ.ЗначенияПолей = СокрЛП(Выборка.ЗначенияПолей);
		Иначе
			ЗначенияПолей = "";
			// Попытка №1.
			Если ЗначениеЗаполнено(СокрЛП(Выборка.ЗначенияПолей)) Тогда 
				ЗначенияПолей = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияВXML(СокрЛП(Выборка.ЗначенияПолей), СокрЛП(Выборка.Представление), Выборка.Вид);
			КонецЕсли;
			Если Лев(СокрЛ(ЗначенияПолей),1) <> "<" Тогда
				// Попытка №2.
				ЗначенияПолей = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияПоПредставлению(СокрЛП(Выборка.Представление), Выборка.Вид);
			КонецЕсли;
			СтрокаТЗКИ.ЗначенияПолей = ЗначенияПолей;
		КонецЕсли;
	
		Если Выборка.Предопределенный Тогда
	
			СтрокаТЗКИ.ВидКонтактнойИнформации = Выборка.Вид;
	
		Иначе
	
			// Получение наименования значения перечисления.
			ИндексТипаКИ = Перечисления.ТипыКонтактнойИнформации.Индекс(Выборка.Тип);
			ИмяТипаКИ = Метаданные.Перечисления.ТипыКонтактнойИнформации.ЗначенияПеречисления[ИндексТипаКИ].Имя;
	
			СтрокаТЗКИ.ВидКонтактнойИнформации = "ПользовательскаяКИ"+ИмяТипаКИ;
			СтрокаТЗКИ.НаименованиеКонтактнойИнформации = Выборка.Наименование;
		КонецЕсли;
	
	КонецЦикла;
	
	ДанныеXDTO.Вставить("КонтактнаяИнформация", ТабКонтактнаяИнформация);
КонецПроцедуры
Процедура ПодготовитьДатуПоставкиВДанныхXDTO(ДанныеXDTO)
	ДанныеXDTO.Вставить("ОтгружатьЗаказЦеликом", Не ДанныеXDTO.Свойство("ОтгружатьЗаказЦеликом")
		Или ДанныеXDTO.ОтгружатьЗаказЦеликом);
	Если Не ДанныеXDTO.Свойство("ОжидаемаяДатаПоставки") Тогда
		ДанныеXDTO.Вставить("ОжидаемаяДатаПоставки", Дата(1,1,1));
	КонецЕсли;
		
	Если ДанныеXDTO.Свойство("Товары") И ЗначениеЗаполнено(ДанныеXDTO.Товары) Тогда
		Если ДанныеXDTO.Товары.Колонки.Найти("ОжидаемаяДатаПоставки") = Неопределено Тогда
			ДанныеXDTO.Товары.Колонки.Добавить("ОжидаемаяДатаПоставки", Новый ОписаниеТипов("Дата"));
		КонецЕсли;
		
		Для Каждого СтрокаТаблицы Из ДанныеXDTO.Товары Цикл
			Если ДанныеXDTO.ОтгружатьЗаказЦеликом Или Не ЗначениеЗаполнено(СтрокаТаблицы.ОжидаемаяДатаПоставки) Тогда
				СтрокаТаблицы.ОжидаемаяДатаПоставки = ДанныеXDTO.ОжидаемаяДатаПоставки;
			Иначе
				ДанныеXDTO.ОжидаемаяДатаПоставки = Макс(ДанныеXDTO.ОжидаемаяДатаПоставки, СтрокаТаблицы.ОжидаемаяДатаПоставки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
Функция СвойствоДанныхСтроки(ДанныеСтроки, Ключ, Значение = Неопределено)
	Если Ключ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ДанныеСтроки.Свойство(Ключ, Значение);
КонецФункции
Функция СоставДанныхНоменклатурыКонтрагента()
	Результат = Новый Структура;
	Результат.Вставить("Владелец", "SKUКонтрагентаВладелец");
	Результат.Вставить("Идентификатор", "SKUКонтрагентаИдентификатор");
	Результат.Вставить("Наименование", "SKUКонтрагентаНаименование");
	Результат.Вставить("Артикул", "SKUКонтрагентаАртикул");
	Результат.Вставить("ШтрихкодКомбинации", "SKUКонтрагентаШтрихкод");
	Результат.Вставить("ЕдиницаИзмерения", "SKUКонтрагентаУпаковкаНаименование");
	Результат.Вставить("КоличествоБазовойЕдиницыИзмерения", "SKUКонтрагентаУпаковкаЧислитель");
	Результат.Вставить("КоличествоУпаковок", "SKUКонтрагентаУпаковкаЗнаменатель");
	Результат.Вставить("ИдентификаторНоменклатурыСервиса", "SKUКонтрагентаИдентификаторНоменклатурыСервиса1СНоменклатура");
	Результат.Вставить("ИдентификаторХарактеристикиСервиса", "SKUКонтрагентаИдентификаторХарактеристикиСервиса1СНоменклатура");
	Результат.Вставить("НаименованиеБазовойЕдиницыИзмерения", "SKUКонтрагентаНаименованиеБазовойЕдиницыИзмерения");
	Результат.Вставить("ЕдиницаИзмеренияКод", "SKUКонтрагентаКодОКЕИБазовойЕдиницыИзмерения");
	
	Возврат Результат
КонецФункции
Функция СсылкаПоДаннымXDTO(КомпонентыОбмена, ДанныеXDTO, Знач ПравилоКонвертации)
	Если ТипЗнч(ПравилоКонвертации) = Тип("Строка") Тогда
		ПравилоКонвертации = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, ПравилоКонвертации);
	КонецЕсли;
	
	СсылкаНаОбъект = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
		КомпонентыОбмена, ДанныеXDTO, ПравилоКонвертации, "ПолучитьСсылку");
	
	Если ТипЗнч(СсылкаНаОбъект) <> ПравилоКонвертации.ТипДанных Тогда
		СсылкаНаОбъект = СсылкаНаОбъект.Ссылка;
	КонецЕсли;
	
	Возврат СсылкаНаОбъект;
КонецФункции
Функция СтавкаНДСОтправка(СтавкаНДС, КомпонентыОбмена)
	Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17") Тогда	
		
		Инструкция = Новый Структура;
		Инструкция.Вставить("Значение", СтавкаНДССтруктура(СтавкаНДС));
		Инструкция.Вставить("ИмяПКО", "Справочник_СтавкиНДС_Отправка");
		
		Возврат Инструкция;
		
	Иначе
		
		ПКПД_СтавкиНДС = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.Найти("СтавкиНДС", "ИмяПКПД");
		Возврат ПКПД_СтавкиНДС.КонвертацииЗначенийПриОтправке.Получить(СтавкаНДС);
		
	КонецЕсли;
КонецФункции
Функция СтавкаНДСПоЗначениюXDTO(КомпонентыОбмена, СтавкаНДСXDTO)
	Если Не ЗначениеЗаполнено(СтавкаНДСXDTO) Тогда
		Возврат Перечисления.СтавкиНДС.ПустаяСсылка();
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17") Тогда
		
		ПКПД_СтавкиНДС = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.Найти("СтавкиНДС", "ИмяПКПД");
		Возврат ПКПД_СтавкиНДС.КонвертацииЗначенийПриПолучении.Получить(СтавкаНДСXDTO.Значение);
	
	Иначе
	
		Возврат ЗначениеСтавкиНДСПоXDTO(КомпонентыОбмена, СтавкаНДСXDTO);
			
	КонецЕсли;
КонецФункции
Функция СтавкаНДССтруктура(СтавкаНДС)
	Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтавкаНДССтруктура = Новый Структура("
		|Ставка,
		|РасчетнаяСтавка,
		|НеОблагается,
		|ВидСтавки");
	
	СтавкаНДССтруктура.РасчетнаяСтавка = Ложь;
	СтавкаНДССтруктура.НеОблагается = Ложь;
	
	Если СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда	
		СтавкаНДССтруктура.Ставка = 0;
		СтавкаНДССтруктура.НеОблагается = Истина;
		СтавкаНДССтруктура.ВидСтавки = "БезНДС";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18 Тогда
		СтавкаНДССтруктура.Ставка = 18;
		СтавкаНДССтруктура.ВидСтавки = "Общая";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
		СтавкаНДССтруктура.Ставка = 18;
		СтавкаНДССтруктура.РасчетнаяСтавка = Истина;
		СтавкаНДССтруктура.ВидСтавки = "ОбщаяРасчетная";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10 Тогда
		СтавкаНДССтруктура.Ставка = 10;
		СтавкаНДССтруктура.ВидСтавки = "Пониженная";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
		СтавкаНДССтруктура.Ставка = 10;
		СтавкаНДССтруктура.РасчетнаяСтавка = Истина;
		СтавкаНДССтруктура.ВидСтавки = "ПониженнаяРасчетная";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
		СтавкаНДССтруктура.Ставка = 20;
		СтавкаНДССтруктура.ВидСтавки = "Общая";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
		СтавкаНДССтруктура.Ставка = 20;
		СтавкаНДССтруктура.РасчетнаяСтавка = Истина;
		СтавкаНДССтруктура.ВидСтавки = "ОбщаяРасчетная";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда
		СтавкаНДССтруктура.Ставка = 22;
		СтавкаНДССтруктура.ВидСтавки = "Общая";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС22_122 Тогда
		СтавкаНДССтруктура.Ставка = 22;
		СтавкаНДССтруктура.РасчетнаяСтавка = Истина;
		СтавкаНДССтруктура.ВидСтавки = "ОбщаяРасчетная";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС0 Тогда
		СтавкаНДССтруктура.Ставка = 0;
		СтавкаНДССтруктура.ВидСтавки = "Нулевая";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5 Тогда
		СтавкаНДССтруктура.Ставка = 5;
		СтавкаНДССтруктура.ВидСтавки = "Общая";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС7 Тогда
		СтавкаНДССтруктура.Ставка = 7;
		СтавкаНДССтруктура.ВидСтавки = "Общая";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5_105 Тогда
		СтавкаНДССтруктура.Ставка = 5;
		СтавкаНДССтруктура.РасчетнаяСтавка = Истина;
		СтавкаНДССтруктура.ВидСтавки = "ОбщаяРасчетная";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС7_107 Тогда
		СтавкаНДССтруктура.Ставка = 7;
		СтавкаНДССтруктура.РасчетнаяСтавка = Истина;
		СтавкаНДССтруктура.ВидСтавки = "ОбщаяРасчетная";
