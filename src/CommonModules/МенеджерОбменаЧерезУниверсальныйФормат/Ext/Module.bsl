Процедура ПОД_Справочник_Номенклатура_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	ИспользованиеПКО.Справочник_Номенклатура_Отправка = Не ДанныеИБ.ЭтоГруппа;
	ИспользованиеПКО.Справочник_НоменклатураГруппа    = ДанныеИБ.ЭтоГруппа;
	
	Если КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		ПравилоУстановкаЦенОтправка = КомпонентыОбмена.ПравилаОбработкиДанных.Найти("Документ_УстановкаЦенНоменклатуры_Отправка", "Имя");
		
		Если Не ПравилоУстановкаЦенОтправка = Неопределено Тогда
			ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, ДанныеИБ, ПравилоУстановкаЦенОтправка);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
Процедура ПОД_Справочник_Организации_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	Если КомпонентыОбмена.ПараметрыКонвертации.ВариантНастройки = "ОбменМаркировка" Тогда
		ИспользованиеПКО.Вставить("Справочник_КассыККМ_ИзСтруктуры_Отправка", Истина);
		ИспользованиеПКО.Вставить("Справочник_Склады_ИзСтруктуры_Отправка", Истина);		
	КонецЕсли;
КонецПроцедуры
Процедура ПОД_Справочник_СостоянияЭД_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	Если КомпонентыОбмена.ПараметрыКонвертации.ТекущаяВерсияФорматаЧислом < ВерсияФорматаЧислом("1.7")
		ИЛИ ДанныеИБ.Количество() = 0  Тогда
		ИспользованиеПКО.Очистить();
		Возврат;	
	КонецЕсли;
	
	СсылкаНаОбъект = ДанныеИБ.Отбор.СсылкаНаОбъект.Значение;
	ТипСсылки = ТипЗнч(СсылкаНаОбъект);
	Если ТипСсылки = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, "ВидДокумента, ВидОперации");
		Если ЗначенияРеквизитов.ВидДокумента = Перечисления.ВидыДокументов.НакладнаяНаВозврат Тогда
			ИмяПКООснованиеЭД = "Документ_ВозвратТоваровОтПокупателя_Отправка";
		ИначеЕсли ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОпераций.Реализация Тогда
			ИмяПКООснованиеЭД = "Документ_ПоступлениеТоваровУслуг_Отправка";
		Иначе
			ИмяПКООснованиеЭД = "Документ_КорректировкаПоступления_Отправка";
		КонецЕсли;
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
		ИмяПКООснованиеЭД = "Документ_СчетФактураПолученный_Отправка";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ИмяПКООснованиеЭД = "Документ_ЗаказКлиента_Отправка";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		ИмяПКООснованиеЭД = "Документ_ЗаказПоставщику_Отправка";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		ВидОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "ВидОперации");
		Если ВидОперации = Перечисления.ВидыОпераций.Реализация Тогда
			ИмяПКООснованиеЭД = "Документ_РеализацияТоваровУслуг_Отправка";
		Иначе
			ИмяПКООснованиеЭД = "Документ_КорректировкаРеализации_Отправка";
		КонецЕсли;
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ИмяПКООснованиеЭД = "Документ_СчетФактураВыданный_Отправка";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
		ИмяПКООснованиеЭД = "Документ_СчетПокупателю_Отправка";
	Иначе
		ИспользованиеПКО.Очистить();
		Возврат;	
	КонецЕсли;
	
	ТаблицаЗаписи = ДанныеИБ.Выгрузить();
	СостояниеЭДО = ТаблицаЗаписи[0].СостояниеЭДО;
	ТипСостояния = ОбменСКонтрагентами.ТипСостоянияЭлектронногоДокументаУниверсальногоФормата(
		КомпонентыОбмена.ВерсияФорматаОбмена, СостояниеЭДО);
	СводныеСостояния = ОбменСКонтрагентами.ТипыСводныхСостоянийЭДОУниверсальногоФормата(
		КомпонентыОбмена.ВерсияФорматаОбмена, СостояниеЭДО);
	
	Если НЕ ЗначениеЗаполнено(ИмяПКООснованиеЭД)
		Или НЕ ЗначениеЗаполнено(ТипСостояния) Тогда
		ИспользованиеПКО.Очистить();
	Иначе
		ДанныеИБ.ДополнительныеСвойства.Вставить("ОснованиеЭлектронногоДокумента",
					Новый Структура("Значение, ИмяПКО", СсылкаНаОбъект, ИмяПКООснованиеЭД));
		ДанныеИБ.ДополнительныеСвойства.Вставить("СостояниеЭлектронногоДокумента", ТипСостояния);
		ДанныеИБ.ДополнительныеСвойства.Вставить("СостояниеОбменаЭДНаНашейСтороне", СводныеСостояния.НаНашейСтороне);
		ДанныеИБ.ДополнительныеСвойства.Вставить("СостояниеОбменаЭДНаСторонеКонтрагента", СводныеСостояния.НаСторонеКонтрагента);
	КонецЕсли;
КонецПроцедуры
Процедура ПОД_Справочник_ХарактеристикиНоменклатуры_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.6") Тогда
		ИспользованиеПКО.Очистить();
	КонецЕсли;
КонецПроцедуры
Процедура ПОД_Справочник_ШтрихкодыНоменклатуры_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	Если ДанныеИБ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запись = ДанныеИБ[0];
	Если Не ЗначениеЗаполнено(Запись.Штрихкод)
		Или Не ЗначениеЗаполнено(Запись.Номенклатура) Тогда
		ИспользованиеПКО.Очистить();
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_ВозвратТоваровОтПокупателя_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.Вставить("ВидОперации", "ВозвратОтКлиента");
	
	УстановитьОблагаетсяНДСУПокупателя = Ложь;
	
	ОтборБезНДС = Новый Структура("СтавкаНДС", Перечисления.СтавкиНДС.БезНДС);
	БезНДС = ДанныеИБ.Товары.НайтиСтроки(ОтборБезНДС).Количество() = ДанныеИБ.Товары.Количество();
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.6") Тогда
		Если ДанныеИБ.ОблагаетсяНДСУПокупателя Тогда
			ДанныеXDTO.Вставить("Налогообложение", "НДСИсчисляетсяПокупателем");
			УстановитьОблагаетсяНДСУПокупателя = Истина;
		ИначеЕсли БезНДС Тогда
			ДанныеXDTO.Вставить("Налогообложение", "НеОблагаетсяНДС");
		Иначе	
			ДанныеXDTO.Вставить("Налогообложение", "ОблагаетсяНДС");
		КонецЕсли;
	Иначе
		Если БезНДС Тогда
			ДанныеXDTO.Вставить("Налогообложение", "ПродажаНеОблагаетсяНДС");
		Иначе	
			ДанныеXDTO.Вставить("Налогообложение", "ПродажаОблагаетсяНДС");
		КонецЕсли;
	КонецЕсли;
	
	ВалютаВзаиморасчетов = ДанныеИБ.Валюта;
	РасчетыВУсловныхЕдиницах = Ложь;
	Если ЗначениеЗаполнено(ДанныеИБ.ДоговорКонтрагента) Тогда
		ВалютаВзаиморасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.ДоговорКонтрагента, "ВалютаРасчетов");
		РасчетыВУсловныхЕдиницах = ДанныеИБ.Валюта = Константы.ВалютаРегламентированногоУчета.Получить()
			И ДанныеИБ.Валюта <> ВалютаВзаиморасчетов;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("ВалютаВзаиморасчетов", ВалютаВзаиморасчетов);
	ДанныеXDTO.Вставить("РасчетыВУсловныхЕдиницах", РасчетыВУсловныхЕдиницах);
	
	СчетФактура = Документы.СчетФактураПолученный.СчетФактураДокумента(ДанныеИБ.Ссылка);
	Если ЗначениеЗаполнено(СчетФактура) Тогда
		ДанныеXDTO.Вставить("ПокупателемВыставляетсяСчетФактураНаВозврат", Истина);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.НомерСтроки,
	|	Товары.НомерСтроки КАК НомерСтрокиДокумента,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(Товары.Характеристика.Наименование, """") КАК ХарактеристикаНаименование,
	|	ЕСТЬNULL(СправочникНоменклатура.ЕдиницаИзмерения, Товары.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА СправочникНоменклатура.ЕдиницаИзмерения = Товары.ЕдиницаИзмерения
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ Товары.ЕдиницаИзмерения
	|	КОНЕЦ КАК Упаковка,
	|	Товары.КоличествоУпаковок * &КоэффициентУпаковки КАК Количество,
	|	ВЫБОР
	|		КОГДА Товары.КоличествоУпаковок > 0
	|			ТОГДА ВЫРАЗИТЬ(Товары.Сумма / (Товары.КоличествоУпаковок * &КоэффициентУпаковки) КАК ЧИСЛО(15, 2))
	|		ИНАЧЕ Товары.Сумма
	|	КОНЕЦ КАК Цена,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Цена КАК ЦенаЗаУпаковку,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.НомерГТД КАК НомерГТД,
	|	Товары.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ЕСТЬNULL(Штрихкоды.Штрихкод, НЕОПРЕДЕЛЕНО) КАК Штрихкод,
	|	Товары.ВозвратПодДеятельность КАК ВозвратПодДеятельность,
	|	Товары.НоменклатураКонтрагента КАК SKUКонтрагентаСсылка,
	|	Товары.НаименованиеПоставщика КАК НаименованиеПоставщика
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО Товары.Номенклатура = СправочникНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
	|		ПО Товары.Номенклатура = Штрихкоды.Номенклатура
	|			И Товары.Характеристика = Штрихкоды.Характеристика
	|			И Товары.ЕдиницаИзмерения = Штрихкоды.ЕдиницаИзмерения
	|ГДЕ
	|	Товары.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КоэффициентУпаковки",
		Справочники.ЕдиницыИзмерения.ТекстЗапросаКоэффициентУпаковки("Товары.ЕдиницаИзмерения"));
	
	Товары = НовыйТаблицаТоваров(КомпонентыОбмена);
	Товары.Колонки.Добавить("НомерГТД");
	Товары.Колонки.Добавить("СтранаПроисхождения");
	Товары.Колонки.Добавить("ВозвратПодДеятельность");
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		ДополнитьЗапросДаннымиНоменклатурыКонтрагента(
			Запрос,
			ТаблицаОтбораНоменклатурыКонтрагента(ДанныеИБ),
			СоставДанныхНоменклатурыКонтрагента(),
			0);
	КонецЕсли;
	ТаблицаДокумента = Запрос.Выполнить().Выбрать();
	Пока ТаблицаДокумента.Следующий() Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТаблицаДокумента);
			
		Если УстановитьОблагаетсяНДСУПокупателя Тогда
			НоваяСтрока.СтавкаНДС = СтавкаОблагаетсяНДСУПокупателя();
		КонецЕсли;		
		
		ЗаполнитьНоменклатуруХарактеристику(КомпонентыОбмена, НоваяСтрока, ТаблицаДокумента, Ложь);
	КонецЦикла;
	
	ЗаполнитьСтавкуНДСВТаблице(Товары, "СтавкаНДС", "СтавкаНДС", КомпонентыОбмена);
	ДанныеXDTO.Вставить("Товары", Товары);
КонецПроцедуры
Процедура ПКО_Документ_ЗаказКлиента_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
			ДанныеXDTO.Вставить("ДатаВходящегоДокумента", ДанныеИБ.ДатаЭД);
			ДанныеXDTO.Вставить("НомерВходящегоДокумента", ДанныеИБ.НомерЭД);
		КонецЕсли;
	
		Возврат;
	КонецЕсли;
	
	ВалютаВзаиморасчетов = ДанныеИБ.Валюта;
	РасчетыВУсловныхЕдиницах = Ложь;
	
	Если ЗначениеЗаполнено(ДанныеИБ.ДоговорКонтрагента) Тогда
		ВалютаВзаиморасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.ДоговорКонтрагента, "ВалютаРасчетов");
		РасчетыВУсловныхЕдиницах = ДанныеИБ.Валюта = Константы.ВалютаРегламентированногоУчета.Получить()
			И ДанныеИБ.Валюта <> ВалютаВзаиморасчетов;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("ВалютаВзаиморасчетов", ВалютаВзаиморасчетов);
	ДанныеXDTO.Вставить("РасчетыВУсловныхЕдиницах", РасчетыВУсловныхЕдиницах);
	
	// Выборка из табличной части документа
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Запрос.УстановитьПараметр("ОтгрузкаОднойДатой", ДанныеИБ.ОтгрузкаОднойДатой);
	Запрос.УстановитьПараметр("ДатаОтгрузки", ДанныеИБ.ДатаОтгрузки);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(Товары.Характеристика.Наименование, """") КАК ХарактеристикаНаименование,
	|	ЕСТЬNULL(СправочникНоменклатура.ЕдиницаИзмерения, Товары.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА СправочникНоменклатура.ЕдиницаИзмерения = Товары.ЕдиницаИзмерения
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ Товары.ЕдиницаИзмерения
	|	КОНЕЦ КАК Упаковка,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Цена КАК ЦенаЗаУпаковку,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.КоличествоУпаковок * &КоэффициентУпаковки КАК Количество,
	|	ВЫБОР
	|		КОГДА Товары.КоличествоУпаковок > 0
	|			ТОГДА ВЫРАЗИТЬ(Товары.Сумма / (Товары.КоличествоУпаковок * &КоэффициентУпаковки) КАК ЧИСЛО(15, 2))
	|		ИНАЧЕ Товары.Сумма
	|	КОНЕЦ КАК Цена,
	|	ЕСТЬNULL(СправочникНоменклатура.ВидНоменклатуры.ТипНоменклатуры, ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)) КАК ТипНоменклатуры,
	|	&ТекстЗапросаSKUКонтрагента КАК SKUКонтрагентаСсылка,
	|	ВЫБОР
	|		КОГДА &ОтгрузкаОднойДатой
	|			ТОГДА &ДатаОтгрузки
	|		ИНАЧЕ Товары.ДатаОтгрузки
	|	КОНЕЦ КАК ОжидаемаяДатаПоставки
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО Товары.Номенклатура = СправочникНоменклатура.Ссылка
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.ЕдиницаИзмерения КАК Упаковка,
	|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК ШтрихкодыНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК Товары
	|		ПО Товары.Номенклатура = ШтрихкодыНоменклатуры.Номенклатура
	|			И Товары.Характеристика = ШтрихкодыНоменклатуры.Характеристика
	|			И Товары.ЕдиницаИзмерения = ШтрихкодыНоменклатуры.ЕдиницаИзмерения
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КоэффициентУпаковки",
		Справочники.ЕдиницыИзмерения.ТекстЗапросаКоэффициентУпаковки("Товары.ЕдиницаИзмерения"));
	
	// Приведение выборки к терминам ED
	Товары = НовыйТаблицаТоваров(КомпонентыОбмена);
	Товары.Колонки.Добавить("SKUКонтрагента");
	
	Услуги = НовыйТаблицаУслуг(КомпонентыОбмена);
	Услуги.Колонки.Добавить("SKUКонтрагента");
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"&ТекстЗапросаSKUКонтрагента",
			"Товары.НоменклатураКонтрагента");
	
		ДополнитьЗапросДаннымиНоменклатурыКонтрагента(
			Запрос,
			ТаблицаОтбораНоменклатурыКонтрагента(ДанныеИБ),
			СоставДанныхНоменклатурыКонтрагента(),
			0);
	
		Товары.Колонки.Добавить("ОжидаемаяДатаПоставки");
		
		Услуги.Колонки.Добавить("Характеристика");
		Услуги.Колонки.Добавить("ОжидаемаяДатаПоставки");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"&ТекстЗапросаSKUКонтрагента",
			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	Пакет = Запрос.ВыполнитьПакет();
	
	ТаблицаДокумента = Пакет[Пакет.ВГраница() - 1].Выгрузить();
	
	Штрихкоды = Пакет[Пакет.ВГраница()].Выгрузить();
	Штрихкоды.Индексы.Добавить("Номенклатура, Характеристика, Упаковка");
	
	УстановитьОблагаетсяНДСУПокупателя = ДанныеИБ.ОблагаетсяНДСУПокупателя
		И ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.6");
	
	// Заполнение табличных частей ED
	ДатаОтгрузки = ДанныеИБ.ДатаОтгрузки;
	НомерСтрокиТовара = 1;
	НомерСтрокиУслуги = 1;
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл 
		Если ЭтоУслуга(СтрокаДокумента.ТипНоменклатуры) Тогда
			НоваяСтрока = Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
			
			НоваяСтрока.НомерСтрокиДокумента = НомерСтрокиУслуги;
			НомерСтрокиУслуги = НомерСтрокиУслуги + 1;
			
			ЭтоУслуга = Истина;
		Иначе
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
			
			ЗаполнитьШтрихкодПоСтроке(НоваяСтрока, Штрихкоды);
			
			НоваяСтрока.НомерСтрокиДокумента = НомерСтрокиТовара;
			НомерСтрокиТовара = НомерСтрокиТовара + 1;
			
			ЭтоУслуга = Ложь;
			
			Если УстановитьОблагаетсяНДСУПокупателя Тогда
				НоваяСтрока.СтавкаНДС = СтавкаОблагаетсяНДСУПокупателя();
			КонецЕсли;		
		КонецЕсли;
		
		ДатаОтгрузки = Макс(ДатаОтгрузки, СтрокаДокумента.ОжидаемаяДатаПоставки);
		
		ЗаполнитьНоменклатуруХарактеристику(КомпонентыОбмена, НоваяСтрока, СтрокаДокумента, ЭтоУслуга);
		
		НоваяСтрока.SKUКонтрагента = ИнструкцииПоВыгрузкеSKUКонтрагента(КомпонентыОбмена, СтрокаДокумента);
	КонецЦикла;
	
	Если Товары.Количество() Тогда
		ЗаполнитьСтавкуНДСВТаблице(Товары, "СтавкаНДС", "СтавкаНДС", КомпонентыОбмена);
		ДанныеXDTO.Вставить("Товары", Товары);
	КонецЕсли;
	
	Если Услуги.Количество() Тогда
		ЗаполнитьСтавкуНДСВТаблице(Услуги, "СтавкаНДС", "СтавкаНДС", КомпонентыОбмена);
		ДанныеXDTO.Вставить("Услуги", Услуги);
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		ДанныеXDTO.КлючевыеСвойства.Вставить("ДатаВходящегоДокумента", ДанныеИБ.ДатаЭД);
		ДанныеXDTO.КлючевыеСвойства.Вставить("НомерВходящегоДокумента", ДанныеИБ.НомерЭД);
		
		ВыгрузитьНалогообложениеНДС(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO,
			"НалогообложениеНДСПродавца");
			
		ДанныеXDTO.Вставить("ОтгружатьЗаказЦеликом", ДанныеИБ.ОтгрузкаОднойДатой);
		ДанныеXDTO.Вставить("ОжидаемаяДатаПоставки", ДатаОтгрузки);
		
		ВыгрузитьГрафикОплат(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO,
			"Документ.ЗаказПокупателя.ЭтапыГрафикаОплаты");
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_ЗаказПоставщику_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ВалютаВзаиморасчетов = ДанныеИБ.Валюта;
	РасчетыВУсловныхЕдиницах = Ложь;
	
	Если ЗначениеЗаполнено(ДанныеИБ.ДоговорКонтрагента) Тогда
		ВалютаВзаиморасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.ДоговорКонтрагента, "ВалютаРасчетов");
		РасчетыВУсловныхЕдиницах = ДанныеИБ.Валюта = Константы.ВалютаРегламентированногоУчета.Получить()
			И ДанныеИБ.Валюта <> ВалютаВзаиморасчетов;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("ВалютаВзаиморасчетов", ВалютаВзаиморасчетов);
	ДанныеXDTO.Вставить("РасчетыВУсловныхЕдиницах", РасчетыВУсловныхЕдиницах);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(Товары.Характеристика.Наименование, """") КАК ХарактеристикаНаименование,
	|	ЕСТЬNULL(СправочникНоменклатура.ЕдиницаИзмерения, Товары.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА СправочникНоменклатура.ЕдиницаИзмерения = Товары.ЕдиницаИзмерения
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ Товары.ЕдиницаИзмерения
	|	КОНЕЦ КАК Упаковка,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Цена КАК ЦенаЗаУпаковку,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.КоличествоУпаковок * &КоэффициентУпаковки КАК Количество,
	|	ВЫБОР
	|		КОГДА Товары.КоличествоУпаковок > 0
	|			ТОГДА ВЫРАЗИТЬ(Товары.Сумма / (Товары.КоличествоУпаковок * &КоэффициентУпаковки) КАК ЧИСЛО(15, 2))
	|		ИНАЧЕ Товары.Сумма
	|	КОНЕЦ КАК Цена,
	|	ЕСТЬNULL(СправочникНоменклатура.ВидНоменклатуры.ТипНоменклатуры, ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)) КАК ТипНоменклатуры,
	|	ВЫБОР
	|		КОГДА &ПоступлениеОднойДатой
	|			ТОГДА &ДатаПоступления
	|		ИНАЧЕ Товары.ДатаПоступления
	|	КОНЕЦ КАК ОжидаемаяДатаПоставки,
	|	&ТекстЗапросаSKUКонтрагента КАК SKUКонтрагентаСсылка
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО Товары.Номенклатура = СправочникНоменклатура.Ссылка
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.ЕдиницаИзмерения КАК Упаковка,
	|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК ШтрихкодыНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Товары КАК Товары
	|		ПО Товары.Номенклатура = ШтрихкодыНоменклатуры.Номенклатура
	|			И Товары.Характеристика = ШтрихкодыНоменклатуры.Характеристика
	|			И Товары.ЕдиницаИзмерения = ШтрихкодыНоменклатуры.ЕдиницаИзмерения
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	Запрос.УстановитьПараметр("ПоступлениеОднойДатой", ДанныеИБ.ПоступлениеОднойДатой);
	Запрос.УстановитьПараметр("ДатаПоступления", ДанныеИБ.ДатаПоступления);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КоэффициентУпаковки",
		Справочники.ЕдиницыИзмерения.ТекстЗапросаКоэффициентУпаковки("Товары.ЕдиницаИзмерения"));
	
	Товары = НовыйТаблицаТоваров(КомпонентыОбмена);
	Товары.Колонки.Добавить("SKUКонтрагента");
	
	Услуги = НовыйТаблицаУслуг(КомпонентыОбмена);
	Услуги.Колонки.Добавить("SKUКонтрагента");
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.7") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"&ТекстЗапросаSKUКонтрагента",
			"Товары.НоменклатураКонтрагента");
	
		ДополнитьЗапросДаннымиНоменклатурыКонтрагента(
			Запрос,
			ТаблицаОтбораНоменклатурыКонтрагента(ДанныеИБ),
			СоставДанныхНоменклатурыКонтрагента(),
			0);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"&ТекстЗапросаSKUКонтрагента",
			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		Товары.Колонки.Добавить("ОжидаемаяДатаПоставки");
		
		Услуги.Колонки.Добавить("Характеристика");
		Услуги.Колонки.Добавить("ОжидаемаяДатаПоставки");
	КонецЕсли;
	
	Пакет = Запрос.ВыполнитьПакет();
	
	ТаблицаДокумента = Пакет[Пакет.ВГраница() - 1].Выгрузить();
	
	Штрихкоды = Пакет[Пакет.ВГраница()].Выгрузить();
	Штрихкоды.Индексы.Добавить("Номенклатура, Характеристика, Упаковка");
	
	УстановитьОблагаетсяНДСУПокупателя = ДанныеИБ.ОблагаетсяНДСУПокупателя
		И КомпонентыОбмена.ПараметрыКонвертации.ТекущаяВерсияФорматаЧислом >= ВерсияФорматаЧислом("1.6");
	
	ДатаПоступления = ДанныеИБ.ДатаПоступления;
	НомерСтрокиТовара = 1;
	НомерСтрокиУслуги = 1;
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл 
		Если ЭтоУслуга(СтрокаДокумента.ТипНоменклатуры) Тогда
			НоваяСтрока = Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
			ЭтоУслуга = Истина;
			
			НоваяСтрока.НомерСтрокиДокумента = НомерСтрокиУслуги;
			НомерСтрокиУслуги = НомерСтрокиУслуги + 1;
		Иначе
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
			
			ЗаполнитьШтрихкодПоСтроке(НоваяСтрока, Штрихкоды);
			
			ЭтоУслуга = Ложь;
			
			Если УстановитьОблагаетсяНДСУПокупателя Тогда
				НоваяСтрока.СтавкаНДС = СтавкаОблагаетсяНДСУПокупателя();
			КонецЕсли;
			
			НоваяСтрока.НомерСтрокиДокумента = НомерСтрокиТовара;
			НомерСтрокиТовара = НомерСтрокиТовара + 1;
		КонецЕсли;
		
		ДатаПоступления = Макс(ДатаПоступления, СтрокаДокумента.ОжидаемаяДатаПоставки);
		
		ЗаполнитьНоменклатуруХарактеристику(КомпонентыОбмена, НоваяСтрока, СтрокаДокумента, ЭтоУслуга);
		
		НоваяСтрока.SKUКонтрагента = ИнструкцииПоВыгрузкеSKUКонтрагента(КомпонентыОбмена, СтрокаДокумента);
	КонецЦикла;
	
	Если Товары.Количество() Тогда
		ЗаполнитьСтавкуНДСВТаблице(Товары, "СтавкаНДС", "СтавкаНДС", КомпонентыОбмена);
		ДанныеXDTO.Вставить("Товары", Товары);
	КонецЕсли;
	
	Если Услуги.Количество() Тогда
		ЗаполнитьСтавкуНДСВТаблице(Услуги, "СтавкаНДС", "СтавкаНДС", КомпонентыОбмена);
		ДанныеXDTO.Вставить("Услуги", Услуги);
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		ВыгрузитьНалогообложениеНДС(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO,
			"НалогообложениеНДСПродавца");
			
		ДанныеXDTO.Вставить("ОтгружатьЗаказЦеликом", ДанныеИБ.ПоступлениеОднойДатой);
		ДанныеXDTO.Вставить("ОжидаемаяДатаПоставки", ДатаПоступления);
		
		ВыгрузитьГрафикОплат(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO,
			"Документ.ЗаказПоставщику.ЭтапыГрафикаОплаты");
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_КорректировкаПоступления_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если ЗначениеЗаполнено(ДанныеИБ.НомерИсправления) Тогда
		ДанныеXDTO.Вставить("ДатаИсправления", ДанныеИБ.ДатаЭД);
	КонецЕсли;
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("ВидОперации", "СогласованноеИзменение");
	Если ДанныеИБ.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		ДанныеXDTO.Вставить("ВидОперации", "ИсправлениеОшибки");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИБ.ДокументОснование) Тогда
		
		ИмяПКО = "Документ_ПоступлениеТоваровУслуг_Отправка";
		
		РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеИБ.ДокументОснование,"ВидДокумента,ВидОперации");
		Если РеквизитыОснования.ВидОперации <> Перечисления.ВидыОпераций.Реализация Тогда  
			ИмяПКО = "Документ_КорректировкаПоступления_Отправка";
		ИначеЕсли РеквизитыОснования.ВидДокумента = Перечисления.ВидыДокументов.НакладнаяНаВозврат Тогда
			ИмяПКО = "Документ_ВозвратТоваровОтПокупателя_Отправка";
		КонецЕсли;
		 
		ДокументПоступления = Новый Структура("Значение, ИмяПКО", ДанныеИБ.ДокументОснование, ИмяПКО);
		ДанныеXDTO.Вставить("ДокументПоступления", ДокументПоступления);
	
	КонецЕсли;
	
	ИсправляемыйДокументПоступления = ИсправляемыйДокументПоступления(ДанныеИБ.ДокументОснование);
	Если ЗначениеЗаполнено(ИсправляемыйДокументПоступления) Тогда
		ДанныеXDTO.Вставить("ИсправляемыйДокументПоступления", ИсправляемыйДокументПоступления);
	КонецЕсли;
	
	ЗаполнитьТоварыУслугиКорректировкиПоступления(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена);
КонецПроцедуры
Процедура ПКО_Документ_ПоступлениеТоваровУслуг_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("ВидОперации", "ПокупкаУПоставщика");
	
	УстановитьОблагаетсяНДСУПокупателя = Ложь;
	
	ОтборБезНДС = Новый Структура("СтавкаНДС", Перечисления.СтавкиНДС.БезНДС);
	БезНДС = ДанныеИБ.Товары.НайтиСтроки(ОтборБезНДС).Количество() = ДанныеИБ.Товары.Количество();
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.6") Тогда
		Если ДанныеИБ.ОблагаетсяНДСУПокупателя Тогда
			ДанныеXDTO.Вставить("Налогообложение", "НДСИсчисляетсяПокупателем");
			УстановитьОблагаетсяНДСУПокупателя = Истина;
		ИначеЕсли БезНДС Тогда
			ДанныеXDTO.Вставить("Налогообложение", "НеОблагаетсяНДС");
		Иначе	
			ДанныеXDTO.Вставить("Налогообложение", "ОблагаетсяНДС");
		КонецЕсли;
	Иначе
		Если БезНДС Тогда
			ДанныеXDTO.Вставить("Налогообложение", "ПродажаНеОблагаетсяНДС");
		Иначе	
			ДанныеXDTO.Вставить("Налогообложение", "ПродажаОблагаетсяНДС");
		КонецЕсли;
	КонецЕсли;
	
	ВалютаВзаиморасчетов = ДанныеИБ.Валюта;
	РасчетыВУсловныхЕдиницах = Ложь;
	Если ЗначениеЗаполнено(ДанныеИБ.ДоговорКонтрагента) Тогда
		ВалютаВзаиморасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.ДоговорКонтрагента, "ВалютаРасчетов");
		РасчетыВУсловныхЕдиницах = ДанныеИБ.Валюта = Константы.ВалютаРегламентированногоУчета.Получить()
			И ДанныеИБ.Валюта <> ВалютаВзаиморасчетов;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("ВалютаВзаиморасчетов", ВалютаВзаиморасчетов);
	ДанныеXDTO.Вставить("РасчетыВУсловныхЕдиницах", РасчетыВУсловныхЕдиницах);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(Товары.Характеристика.Наименование, """") КАК ХарактеристикаНаименование,
	|	ЕСТЬNULL(СправочникНоменклатура.ЕдиницаИзмерения, Товары.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА СправочникНоменклатура.ЕдиницаИзмерения = Товары.ЕдиницаИзмерения
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ Товары.ЕдиницаИзмерения
	|	КОНЕЦ КАК Упаковка,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Цена КАК ЦенаЗаУпаковку,
	|	Товары.КоличествоУпаковок * &КоэффициентУпаковки КАК Количество,
	|	ВЫБОР
	|		КОГДА Товары.КоличествоУпаковок > 0
	|			ТОГДА ВЫРАЗИТЬ(Товары.Сумма / (Товары.КоличествоУпаковок * &КоэффициентУпаковки) КАК ЧИСЛО(15, 2))
	|		ИНАЧЕ Товары.Сумма
	|	КОНЕЦ КАК Цена,
	|	ЕСТЬNULL(СправочникНоменклатура.ВидНоменклатуры.ТипНоменклатуры, ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)) КАК
	|		ТипНоменклатуры,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.НомерГТД КАК НомерГТД,
	|	Товары.СтранаПроисхождения КАК СтранаПроисхождения,
	|	Товары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ЕСТЬNULL(Штрихкоды.Штрихкод, НЕОПРЕДЕЛЕНО) КАК Штрихкод,
	|	Товары.НоменклатураКонтрагента КАК SKUКонтрагентаСсылка,
	|	Товары.НаименованиеПоставщика КАК НаименованиеПоставщика
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО Товары.Номенклатура = СправочникНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
	|		ПО Товары.Номенклатура = Штрихкоды.Номенклатура
	|		И Товары.Характеристика = Штрихкоды.Характеристика
	|		И Товары.ЕдиницаИзмерения = Штрихкоды.ЕдиницаИзмерения
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеТоваровУслугКодыУпаковокМаркируемойПродукции.НомерУпаковки КАК НомерУпаковки,
	|	ПоступлениеТоваровУслугКодыУпаковокМаркируемойПродукции.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.КодыУпаковокМаркируемойПродукции КАК
	|		ПоступлениеТоваровУслугКодыУпаковокМаркируемойПродукции
	|ГДЕ
	|	ПоступлениеТоваровУслугКодыУпаковокМаркируемойПродукции.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КоэффициентУпаковки",
		Справочники.ЕдиницыИзмерения.ТекстЗапросаКоэффициентУпаковки("Товары.ЕдиницаИзмерения"));
		
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		ДополнитьЗапросДаннымиНоменклатурыКонтрагента(
			Запрос,
			ТаблицаОтбораНоменклатурыКонтрагента(ДанныеИБ),
			СоставДанныхНоменклатурыКонтрагента(),
			0);
	КонецЕсли;
			
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Товары = НовыйТаблицаТоваров(КомпонентыОбмена);
	Товары.Колонки.Добавить("НомерГТД");
	Товары.Колонки.Добавить("СтранаПроисхождения");
	Товары.Колонки.Добавить("ИдентификаторСтроки");
	
	Услуги = НовыйТаблицаУслуг(КомпонентыОбмена);
	
	НомерСтрокиТовара = 1;
	НомерСтрокиУслуги = 1;
	ТаблицаДокумента = РезультатыЗапроса[0].Выбрать();
	Пока ТаблицаДокумента.Следующий() Цикл
		Если ЭтоУслуга(ТаблицаДокумента.ТипНоменклатуры) Тогда
			НоваяСтрока = Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТаблицаДокумента);
			Если Не ЗначениеЗаполнено(НоваяСтрока.Количество) Тогда
				НоваяСтрока.Количество = 1;
			КонецЕсли;
			НоваяСтрока.НомерСтрокиДокумента = НомерСтрокиУслуги;
			НомерСтрокиУслуги = НомерСтрокиУслуги + 1;
			
			ЭтоУслуга = Истина;
		Иначе
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТаблицаДокумента);
			НоваяСтрока.НомерСтрокиДокумента = НомерСтрокиТовара;
	
			ЭтоУслуга = Ложь;
			
			Если УстановитьОблагаетсяНДСУПокупателя Тогда
				НоваяСтрока.СтавкаНДС = СтавкаОблагаетсяНДСУПокупателя();
			КонецЕсли;
			
			НоваяСтрока.НомерСтрокиДокумента = НомерСтрокиТовара;
			НомерСтрокиТовара = НомерСтрокиТовара + 1;
		КонецЕсли;
		
		ЗаполнитьНоменклатуруХарактеристику(КомпонентыОбмена, НоваяСтрока, ТаблицаДокумента, ЭтоУслуга);
	КонецЦикла;
	
	Если Товары.Количество() Тогда
		ЗаполнитьСтавкуНДСВТаблице(Товары, "СтавкаНДС", "СтавкаНДС", КомпонентыОбмена);
		ДанныеXDTO.Вставить("Товары", Товары);
	КонецЕсли;
	
	Если Услуги.Количество() Тогда
		ЗаполнитьСтавкуНДСВТаблице(Услуги, "СтавкаНДС", "СтавкаНДС", КомпонентыОбмена);
		ДанныеXDTO.Вставить("Услуги", Услуги);
	КонецЕсли;
	
	АкцизныеМарки = Новый ТаблицаЗначений;
	АкцизныеМарки.Колонки.Добавить("НомерСтрокиДокумента");
	АкцизныеМарки.Колонки.Добавить("Номенклатура");
	АкцизныеМарки.Колонки.Добавить("НомерАкцизнойМарки");
	АкцизныеМарки.Колонки.Добавить("ИдентификаторСтроки");
	
	ВыборкаМаркировок = РезультатыЗапроса[1].Выбрать();
	Пока ВыборкаМаркировок.Следующий() Цикл
		
		СтрокаТовара = Товары.Найти(ВыборкаМаркировок.ИдентификаторСтроки, "ИдентификаторСтроки");
		Если СтрокаТовара = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = АкцизныеМарки.Добавить();
		НоваяСтрока.НомерСтрокиДокумента = СтрокаТовара.НомерСтрокиДокумента;
		НоваяСтрока.Номенклатура         = СтрокаТовара.Номенклатура;
		НоваяСтрока.НомерАкцизнойМарки   = ВыборкаМаркировок.НомерУпаковки;
		НоваяСтрока.ИдентификаторСтроки  = ВыборкаМаркировок.ИдентификаторСтроки;
	КонецЦикла;
	
	Если АкцизныеМарки.Количество() Тогда
		ДанныеXDTO.Вставить("АкцизныеМарки", АкцизныеМарки);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_СчетПоставщика_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("ВидОперации", "ПокупкаУПоставщика");
	
	ВалютаВзаиморасчетов = ДанныеИБ.Валюта;
	РасчетыВУсловныхЕдиницах = Ложь;
	Если ЗначениеЗаполнено(ДанныеИБ.ДоговорКонтрагента) Тогда
		ВалютаВзаиморасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.ДоговорКонтрагента, "ВалютаРасчетов");
		РасчетыВУсловныхЕдиницах = ДанныеИБ.Валюта = Константы.ВалютаРегламентированногоУчета.Получить()
			И ДанныеИБ.Валюта <> ВалютаВзаиморасчетов;
	КонецЕсли;
	
	ДанныеXDTO.Вставить("ВалютаВзаиморасчетов", ВалютаВзаиморасчетов);
	ДанныеXDTO.Вставить("РасчетыВУсловныхЕдиницах", РасчетыВУсловныхЕдиницах);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(Товары.Характеристика.Наименование, """") КАК ХарактеристикаНаименование,
	|	ЕСТЬNULL(СправочникНоменклатура.ЕдиницаИзмерения, Товары.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА СправочникНоменклатура.ЕдиницаИзмерения = Товары.ЕдиницаИзмерения
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ Товары.ЕдиницаИзмерения
	|	КОНЕЦ КАК Упаковка,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Цена КАК ЦенаЗаУпаковку,
	|	Товары.КоличествоУпаковок * &КоэффициентУпаковки КАК Количество,
	|	ВЫБОР
	|		КОГДА Товары.КоличествоУпаковок > 0
	|			ТОГДА ВЫРАЗИТЬ(Товары.Сумма / (Товары.КоличествоУпаковок * &КоэффициентУпаковки) КАК ЧИСЛО(15, 2))
	|		ИНАЧЕ Товары.Сумма
	|	КОНЕЦ КАК Цена,
	|	ЕСТЬNULL(СправочникНоменклатура.ВидНоменклатуры.ТипНоменклатуры, ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)) КАК ТипНоменклатуры,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	ЕСТЬNULL(Штрихкоды.Штрихкод, НЕОПРЕДЕЛЕНО) КАК Штрихкод,
	|	Товары.НоменклатураКонтрагента КАК SKUКонтрагентаСсылка,
	|	Товары.НаименованиеПоставщика КАК НаименованиеПоставщика
	|ИЗ
	|	Документ.СчетНаОплатуПоставщика.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО Товары.Номенклатура = СправочникНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
	|		ПО Товары.Номенклатура = Штрихкоды.Номенклатура
	|			И Товары.Характеристика = Штрихкоды.Характеристика
	|			И Товары.ЕдиницаИзмерения = Штрихкоды.ЕдиницаИзмерения
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки ";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КоэффициентУпаковки",
		Справочники.ЕдиницыИзмерения.ТекстЗапросаКоэффициентУпаковки("Товары.ЕдиницаИзмерения"));
	
	Товары = НовыйТаблицаТоваров(КомпонентыОбмена);
	
	Услуги = НовыйТаблицаУслуг(КомпонентыОбмена);
	
	УстановитьОблагаетсяНДСУПокупателя = ДанныеИБ.ОблагаетсяНДСУПокупателя
		И ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.6");
	
	НомерСтрокиТовара = 1;
	НомерСтрокиУслуги = 1;
	ТаблицаДокумента = Запрос.Выполнить().Выбрать();
	Пока ТаблицаДокумента.Следующий() Цикл
		Если ЭтоУслуга(ТаблицаДокумента.ТипНоменклатуры) Тогда
			НоваяСтрока = Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТаблицаДокумента);
			ЭтоУслуга = Истина;
			
			НоваяСтрока.НомерСтрокиДокумента = НомерСтрокиУслуги;
			НомерСтрокиУслуги = НомерСтрокиУслуги + 1;
		Иначе
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТаблицаДокумента);
			ЭтоУслуга = Ложь;
			
			Если УстановитьОблагаетсяНДСУПокупателя Тогда
				НоваяСтрока.СтавкаНДС = СтавкаОблагаетсяНДСУПокупателя();
			КонецЕсли;
			
			НоваяСтрока.НомерСтрокиДокумента = НомерСтрокиТовара;
			НомерСтрокиТовара = НомерСтрокиТовара + 1;
		КонецЕсли;
		
		ЗаполнитьНоменклатуруХарактеристику(КомпонентыОбмена, НоваяСтрока, ТаблицаДокумента, ЭтоУслуга);
	КонецЦикла;
	
	Если Товары.Количество() Тогда
		ЗаполнитьСтавкуНДСВТаблице(Товары, "СтавкаНДС", "СтавкаНДС", КомпонентыОбмена);
		ДанныеXDTO.Вставить("Товары", Товары);
	КонецЕсли;
	
	Если Услуги.Количество() Тогда
		ЗаполнитьСтавкуНДСВТаблице(Услуги, "СтавкаНДС", "СтавкаНДС", КомпонентыОбмена);
		ДанныеXDTO.Вставить("Услуги", Услуги);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_СчетФактураВыданный_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если ДанныеИБ.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		ДанныеXDTO.Вставить("Номер", ДанныеИБ.НомерИсходногоДокумента);
		ДанныеXDTO.Вставить("Дата" , ДанныеИБ.ДатаИсходногоДокумента);
		ДанныеXDTO.Вставить("НомерИсправления", ДанныеИБ.НомерИсправления);
		ДанныеXDTO.Вставить("ДатаИсправления" , ДанныеИБ.Дата);
	Иначе
		ДанныеXDTO.Вставить("Номер", ДанныеИБ.Номер);
		ДанныеXDTO.Вставить("Дата" , ДанныеИБ.Дата);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_СчетФактураПолученный_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.Вставить("СпособВыставления", "ВЭлектронномВиде");
	
	Если ЗначениеЗаполнено(ДанныеИБ.НомерИсправления) Тогда
		ДанныеXDTO.Вставить("ДатаИсправления", ДанныеИБ.ДатаЭД);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИБ.ДатаПолучения) Тогда
		ДанныеXDTO.Вставить("ДатаПолучения", ДанныеИБ.ДатаПолучения);
	Иначе
		ДанныеXDTO.Вставить("ДатаПолучения", ДанныеИБ.Дата);
	КонецЕсли;
	
	ДокументыОснования = Новый ТаблицаЗначений();
	ДокументыОснования.Колонки.Добавить("ДокументОснование");
	
	ИмяПКО = "Документ_ПоступлениеТоваровУслуг_Отправка";
	
	Для Каждого СтрокаТаблицы Из ДанныеИБ.ДокументыОснования Цикл
		СтрокаОснование = ДокументыОснования.Добавить();
		СтрокаОснование.ДокументОснование = Новый Структура("Значение, ИмяПКО", СтрокаТаблицы.ДокументОснование, ИмяПКО);
	КонецЦикла;
	
	ДанныеXDTO.Вставить("ВидСчетаФактуры", "НаПоступление");
	Если ДанныеИБ.ВидОперации = Перечисления.ВидыОпераций.Корректировка
		ИЛИ (ДанныеИБ.ВидОперации = Перечисления.ВидыОпераций.Исправление
			И ЗначениеЗаполнено(ДанныеИБ.НомерИсправляемогоКорректировочногоДокумента)) Тогда
			
		ДанныеXDTO.Вставить("ВидСчетаФактуры", "Корректировочный");
			
		ДокументыОснования.Колонки.Добавить("ИсходныйДокумент");
		ИсходныйДокумент = Новый Структура("Значение, ИмяПКО",
			ДанныеИБ.СчетФактураОснование, "Документ_СчетФактураПолученный_Отправка");
		ДокументыОснования.ЗаполнитьЗначения(ИсходныйДокумент, "ИсходныйДокумент");
		
		Если ЗначениеЗаполнено(ДанныеИБ.НомерИсправленияИсходногоДокумента) Тогда
			ДокументыОснования.Колонки.Добавить("УчитыватьИсправлениеИсходногоДокумента");
			ДокументыОснования.ЗаполнитьЗначения(Истина, "УчитыватьИсправлениеИсходногоДокумента");
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеXDTO.Вставить("ДокументыОснования", ДокументыОснования);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(ПоступлениеТоваровУслугТовары.СуммаНДС) КАК СуммаНДС
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
		|ГДЕ
		|	ПоступлениеТоваровУслугТовары.Ссылка В (&ДокументыОснования)";
	
	Запрос.УстановитьПараметр("ДокументыОснования", ДанныеИБ.ДокументыОснования.ВыгрузитьКолонку("ДокументОснование"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДанныеXDTO.Вставить("СуммаНДС", Выборка.СуммаНДС);
	КонецЕсли;
	
	Если ДанныеИБ.ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс
		И ДанныеИБ.Товары.Количество() Тогда
	
		Авансы = Новый ТаблицаЗначений();
		Авансы.Колонки.Добавить("Сумма");
		Авансы.Колонки.Добавить("СтавкаНДС");
		Авансы.Колонки.Добавить("СуммаНДС");
		
		Для Каждого СтрокаТаблицы Из ДанныеИБ.Товары Цикл
			Аванс = Авансы.Добавить();
			Аванс.Сумма = СтрокаТаблицы.СуммаСНДС - СтрокаТаблицы.СуммаНДС;
			Аванс.СтавкаНДС = СтрокаТаблицы.СтавкаНДС;
			Аванс.СуммаНДС  = СтрокаТаблицы.СуммаНДС;
		КонецЦикла;
		ЗаполнитьСтавкуНДСВТаблице(Авансы, "СтавкаНДС", "СтавкаНДС", КомпонентыОбмена);	
		ДанныеXDTO.Вставить("Авансы", Авансы);	
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_УстановкаЦенНоменклатуры_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если ТипЗнч(ДанныеИБ) <> Тип("Структура") Тогда
		ДанныеXDTO = Неопределено;
	ИначеЕсли ДанныеИБ.Свойство("ТипЦен")
		И ДанныеИБ.Свойство("Товары") Тогда
		
		ДанныеXDTO.Вставить("Товары", ДанныеИБ.Товары);
		ДанныеXDTO.Вставить("ТипЦен", ДанныеИБ.ТипЦен);
	Иначе
		ДанныеXDTO = Неопределено;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_SKUКонтрагента_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Владелец = Неопределено;
	УпаковкаИнструкция = Неопределено;
	
	ЕдиницаИзмерения = Новый Структура;
	ЕдиницаИзмерения.Вставить("Наименование", ДанныеИБ.НаименованиеБазовойЕдиницыИзмерения);
	ЕдиницаИзмерения.Вставить("Код", ДанныеИБ.КодОКЕИБазовойЕдиницыИзмерения);
	
	ЕдиницаИзмеренияИнструкция = НовыйИнструкция("Справочник_ЕдиницыИзмерения_ИзСтруктуры", ЕдиницаИзмерения); 
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		Владелец = ?(ЗначениеЗаполнено(ДанныеИБ.ВладелецНоменклатуры), ДанныеИБ.ВладелецНоменклатуры,ДанныеИБ.Владелец);
		
		Номенклатура = Новый Структура;
		Номенклатура.Вставить("Наименование", ДанныеИБ.Наименование);
		Номенклатура.Вставить("Артикул", ДанныеИБ.Артикул);
		Номенклатура.Вставить("ИдентификаторСервиса1СНоменклатура", ДанныеИБ.ИдентификаторНоменклатурыСервиса);
		
		НоменклатураИнструкция = НовыйИнструкция(
			"Справочник_Номенклатура_ИзСтруктуры_Отправка", Номенклатура);
	
		Если ЗначениеЗаполнено(ДанныеИБ.НаименованиеУпаковки) Тогда
			Упаковка = Новый Структура;
			Упаковка.Вставить("Наименование", ДанныеИБ.НаименованиеУпаковки);
			Упаковка.Вставить("ЕдиницаИзмерения", ЕдиницаИзмеренияИнструкция);
			Упаковка.Вставить("Номенклатура", Номенклатура);
			Упаковка.Вставить("Коэффициент",?(ДанныеИБ.КоличествоУпаковок = 0,
				ДанныеИБ.КоличествоБазовойЕдиницыИзмерения,
				Окр(ДанныеИБ.КоличествоБазовойЕдиницыИзмерения / ДанныеИБ.КоличествоУпаковок,3)));
		Иначе
			Упаковка = Новый Структура;
			Упаковка.Вставить("Наименование", ДанныеИБ.НаименованиеБазовойЕдиницыИзмерения);
			Упаковка.Вставить("ЕдиницаИзмерения", ЕдиницаИзмеренияИнструкция);
			Упаковка.Вставить("Номенклатура", Номенклатура);
			Упаковка.Вставить("Коэффициент", 1);
		КонецЕсли;
		
		УпаковкаИнструкция = НовыйИнструкция(
			"Справочник_УпаковкиSKUКонтрагента_ИзСтруктуры", Упаковка); 
	КонецЕсли;
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
			ДанныеXDTO.Вставить("УпаковкаНоменклатуры", УпаковкаИнструкция);
			ДанныеXDTO.Вставить("Владелец", Владелец);
		Иначе
			ДанныеXDTO.Вставить("ЕдиницаИзмерения", ЕдиницаИзмеренияИнструкция);
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		ДанныеXDTO.КлючевыеСвойства.Вставить("УпаковкаНоменклатуры", УпаковкаИнструкция);
		ДанныеXDTO.КлючевыеСвойства.Вставить("Владелец", Владелец);
		
		ДанныеXDTO.Вставить("ЕдиницаИзмерения", ЕдиницаИзмеренияИнструкция);
	Иначе
		ДанныеXDTO.КлючевыеСвойства.Вставить("ЕдиницаИзмерения", ЕдиницаИзмеренияИнструкция);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_БанковскиеСчета_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	// Владелец
	Инструкция = Новый Структура("Значение, ИмяПКО");
	Инструкция.Значение = ДанныеИБ.Владелец;
	ТипВладельца = ТипЗнч(Инструкция.Значение);
	Если ТипВладельца = Тип("СправочникСсылка.Контрагенты") Тогда
		Инструкция.ИмяПКО = "Справочник_Контрагенты_Отправка";
	ИначеЕсли ТипВладельца = Тип("СправочникСсылка.Организации") Тогда
		Инструкция.ИмяПКО = "Справочник_Организации_Отправка";
	КонецЕсли;
	ДанныеXDTO.КлючевыеСвойства.Вставить("Владелец", Инструкция);
КонецПроцедуры
Процедура ПКО_Справочник_ДоговорыКонтрагентов_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.КлючевыеСвойства.Вставить("РасчетыВУсловныхЕдиницах", Ложь);
КонецПроцедуры
Процедура ПКО_Справочник_КассыККМ_ИзСтруктуры_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.КлючевыеСвойства.Вставить("Наименование", НСтр("ru = 'Касса ККМ по умолчанию'"));
	
	ОрганизацияПоУмолчанию = Справочники.Организации.ОрганизацияПоУмолчанию();
	ДанныеXDTO.КлючевыеСвойства.Вставить("Организация", ОрганизацияПоУмолчанию);
	
	ТорговыйОбъект = Новый Структура;
	ТорговыйОбъект.Вставить("Наименование", НСтр("ru = 'Торговый объект по умолчанию'"));
	
	Инструкция = Новый Структура("Значение, ИмяПКО", ТорговыйОбъект, "Справочник_Склады_ИзСтруктуры_Отправка");
	
	ДанныеXDTO.КлючевыеСвойства.Вставить("Склад", Инструкция);
КонецПроцедуры
Процедура ПКО_Справочник_Контрагенты_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
		
	КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		ДанныеИБ, Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента,,Ложь);
	
	СтранаАдреса = Неопределено;
	Если КонтактнаяИнформация.Количество() Тогда
		СтранаАдреса = УправлениеКонтактнойИнформацией.СтранаАдресаКонтактнойИнформации(КонтактнаяИнформация[0].Значение);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтранаАдреса) И ЗначениеЗаполнено(СтранаАдреса.Ссылка) Тогда
		ДанныеXDTO.КлючевыеСвойства.Вставить("СтранаРегистрации", СтранаАдреса.Ссылка);
	КонецЕсли;
	
	ПодготовитьДанныеКонтактнаяИнформация(ДанныеИБ, ДанныеXDTO);
КонецПроцедуры
Процедура ПКО_Справочник_Номенклатура_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДанныеИБ.ЭтоГруппа Тогда
		ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.ВидНоменклатуры, "ТипНоменклатуры");
		ДанныеXDTO.Вставить("ТипНоменклатуры", ТипНоменклатуры);
	Иначе	
		ДанныеXDTO.Вставить("ТипНоменклатуры", "");
		ДанныеXDTO.Вставить("НаименованиеПолное", "");
		Возврат;
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.6") Тогда
		ДанныеXDTO.Вставить("ВидНоменклатуры", ДанныеИБ.ВидНоменклатуры);
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17") Тогда
		ДанныеXDTO.Вставить("СтавкаНДС", СтавкаНДСОтправка(ДанныеИБ.СтавкаНДС, КомпонентыОбмена));		
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДанныеИБ.ЕдиницаИзмерения) Тогда
		ДанныеXDTO.Вставить("ЕдиницаИзмерения", Справочники.ЕдиницыИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию());
	КонецЕсли;
		
	Если КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		
		ОрганизацияПоУмолчанию = Справочники.Организации.ОрганизацияПоУмолчанию();
		СНОТовара = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОрганизацияПоУмолчанию, "СистемаНалогообложения");
		
		ИнструкцияСНО = Новый Структура;
		ИнструкцияСНО.Вставить("ИмяПКО",   "СистемыНалогообложения");
		ИнструкцияСНО.Вставить("Значение", СНОТовара);
		ДанныеXDTO.Вставить("СистемаНалогообложения", ИнструкцияСНО);
		
		ДанныеXDTO.Вставить("ОрганизацияПродажи", ОрганизацияПоУмолчанию);
	
		ВидАП = ДанныеИБ.ВидАлкогольнойПродукции;
		Если ЗначениеЗаполнено(ВидАП) Тогда
			СтруктураВидАП = Новый Структура("Код, Наименование, ВидЛицензии");
			ЗаполнитьЗначенияСвойств(СтруктураВидАП, ВидАП);
			Если ЗначениеЗаполнено(ВидАП.ВидЛицензии) Тогда
				ВидЛицензии = "";
				ВидыЛицензийАП = Перечисления.ВидыЛицензийАлкогольнойПродукции;
				Если ВидАП.ВидЛицензии = ВидыЛицензийАП.Пиво Тогда
					ВидЛицензии = "Пиво";
				ИначеЕсли ВидАП.ВидЛицензии = ВидыЛицензийАП.АлкогольнаяПродукция Тогда
					ВидЛицензии = "АлкогольнаяПродукция";
				ИначеЕсли ВидАП.ВидЛицензии = ВидыЛицензийАП.СпиртосодержащаяПищеваяПродукция Тогда
					ВидЛицензии = "СпиртосодержащаяПищеваяПродукция";
				ИначеЕсли ВидАП.ВидЛицензии = ВидыЛицензийАП.СпиртосодержащаяНеПищеваяПродукция Тогда
					ВидЛицензии = "СпиртосодержащаяНеПищеваяПродукция";
				КонецЕсли;
				СтруктураВидАП.Вставить("ВидЛицензии", ВидЛицензии);
			КонецЕсли;
			ДанныеXDTO.Вставить("ВидАлкогольнойПродукции", СтруктураВидАП);
		Иначе
			ДанныеXDTO.Вставить("ВидАлкогольнойПродукции", Неопределено);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеИБ.КодТНВЭД) Тогда
			СтруктураКодТНВЭД = Новый Структура("КодТНВЭД, Наименование, ЕдиницаИзмерения");
			СтруктураКодТНВЭД.КодТНВЭД = ДанныеИБ.КодТНВЭД;
			СтруктураКодТНВЭД.Наименование = НСтр("ru = 'Наименование по умолчанию'");
			СтруктураКодТНВЭД.ЕдиницаИзмерения = ДанныеИБ.ЕдиницаИзмерения;
			
			Инструкция = Новый Структура("Значение, ИмяПКО", СтруктураКодТНВЭД, "Справочник_КлассификаторТНВЭД");
			ДанныеXDTO.Вставить("КодТНВЭД", Инструкция);
		КонецЕсли;
		
		МаркируемаяПродукция = ИнтеграцияИСМПКлиентСерверПовтИсп.ОбязательнаяРегистрацияОборотаМаркируемойПродукции(
			ДанныеИБ.ОсобенностьУчета,
			ТекущаяДатаСеанса());
			
		Если НЕ МаркируемаяПродукция И ЗначениеЗаполнено(ВидАП) Тогда
			МаркируемаяПродукция = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидАП, "Маркируемый");
		КонецЕсли;
		
		ДанныеXDTO.Вставить("Маркируемый", МаркируемаяПродукция);
		
		МассивПодакцизныхППР = Новый Массив;
		МассивПодакцизныхППР.Добавить(Перечисления.ПризнакиПредметаРасчета.ПодакцизныйТовар);
		МассивПодакцизныхППР.Добавить(Перечисления.ПризнакиПредметаРасчета.ПодакцизныйТоварМаркируемыйСИИмеющийКМ);
		МассивПодакцизныхППР.Добавить(Перечисления.ПризнакиПредметаРасчета.ПодакцизныйТоварМаркируемыйСИНеИмеющийКМ);
		
		ПодакцизныйТовар = НЕ МассивПодакцизныхППР.Найти(ДанныеИБ.ПризнакПредметаРасчета) = Неопределено;
		ДанныеXDTO.Вставить("ПодакцизныйТовар", ПодакцизныйТовар);
	
	КонецЕсли;
	
	ВыгрузитьДополнительныеРеквизитыИСведения(КомпонентыОбмена, ДанныеИБ, ДанныеXDTO, Истина);
КонецПроцедуры
Процедура ПКО_Справочник_Организации_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	ПодготовитьДанныеКонтактнаяИнформация(ДанныеИБ, ДанныеXDTO);
КонецПроцедуры
Процедура ПКО_Справочник_Склады_ИзСтруктуры_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.КлючевыеСвойства.Вставить("Наименование", НСтр("ru = 'Торговый объект по умолчанию'"));
КонецПроцедуры
Процедура ПКО_Справочник_СостоянияЭД_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.КлючевыеСвойства.Вставить("ОснованиеЭлектронногоДокумента",
		ДанныеИБ.ДополнительныеСвойства.ОснованиеЭлектронногоДокумента);
	ДанныеXDTO.Вставить("СостояниеЭлектронногоДокумента",
		ДанныеИБ.ДополнительныеСвойства.СостояниеЭлектронногоДокумента);
	ДанныеXDTO.Вставить("СостояниеОбменаЭДНаНашейСтороне",
		ДанныеИБ.ДополнительныеСвойства.СостояниеОбменаЭДНаНашейСтороне);
	ДанныеXDTO.Вставить("СостояниеОбменаЭДНаСторонеКонтрагента",
		ДанныеИБ.ДополнительныеСвойства.СостояниеОбменаЭДНаСторонеКонтрагента);
КонецПроцедуры
Процедура ПКО_Справочник_ХарактеристикиНоменклатуры_ИзСтруктуры_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.КлючевыеСвойства.Вставить("НаименованиеПолное", ДанныеИБ.Наименование);
	
	Если КомпонентыОбмена.ПараметрыКонвертации.ТекущаяВерсияФорматаЧислом >= ВерсияФорматаЧислом("1.6")
		И ТипЗнч(ДанныеИБ.Владелец) = Тип("СправочникСсылка.Номенклатура") Тогда
		ДанныеXDTO.КлючевыеСвойства.Вставить("Номенклатура", ДанныеИБ.Владелец);
	ИначеЕсли КомпонентыОбмена.ПараметрыКонвертации.ТекущаяВерсияФорматаЧислом >= ВерсияФорматаЧислом("1.7")
		И ТипЗнч(ДанныеИБ.Владелец) = Тип("СправочникСсылка.ВидыНоменклатуры") Тогда
		ДанныеXDTO.КлючевыеСвойства.Вставить("ВидНоменклатуры", ДанныеИБ.Владелец);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ШтрихкодыНоменклатуры_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.Вставить("Штрихкод", ДанныеИБ.Отбор.Штрихкод.Значение);
	ДанныеXDTO.Вставить("ШтрихкодОтбор", ДанныеИБ.Отбор.Штрихкод.Значение);
	
	ТаблицаЗаписи = Новый ТаблицаЗначений;
	ТаблицаЗаписи.Колонки.Добавить("Штрихкод");
	ТаблицаЗаписи.Колонки.Добавить("Номенклатура");
	ТаблицаЗаписи.Колонки.Добавить("Характеристика");
	
	Для Каждого СтрокаНабора Из ДанныеИБ Цикл
		
		СтрокаЗаписи = ТаблицаЗаписи.Добавить();
		СтрокаЗаписи.Штрихкод = СтрокаНабора.Штрихкод;
		СтрокаЗаписи.Номенклатура = СтрокаНабора.Номенклатура;
		ДанныеXDTO.Вставить("НоменклатураОтбор", СтрокаНабора.Номенклатура);
		
		Если ЗначениеЗаполнено(СтрокаНабора.Характеристика) Тогда
			ХарактеристикаНаименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаНабора.Характеристика, "Наименование");
			Характеристика = Новый Структура("Ссылка, Наименование, Владелец",
				СтрокаНабора.Характеристика, ХарактеристикаНаименование, СтрокаНабора.Номенклатура);
			ХарактеристикаИнструкция = Новый Структура("Значение, ИмяПКО",
				Характеристика, "Справочник_ХарактеристикиНоменклатуры_ИзСтруктуры");
			СтрокаЗаписи.Характеристика = ХарактеристикаИнструкция;
			ДанныеXDTO.Вставить("ХарактеристикаОтбор", ХарактеристикаИнструкция);
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеXDTO.Вставить("Записи", ТаблицаЗаписи);
КонецПроцедуры

#КонецОбласти
