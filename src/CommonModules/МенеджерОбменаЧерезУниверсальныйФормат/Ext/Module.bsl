КонецПроцедуры
Процедура ПКО_Документ_ВозвратТоваровПоставщику_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ДанныеИБ <> Неопределено Тогда
	
		// Переносим те свойства, которые указаны в ПКС.
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
		// Табличные части
		ДанныеИБ.Товары.Загрузить(ПолученныеДанные.Товары.Выгрузить());
		ДанныеИБ.КодыУпаковокМаркируемойПродукции.Загрузить(ПолученныеДанные.КодыУпаковокМаркируемойПродукции.Выгрузить());
	
		ПолученныеДанные = Неопределено;
		
	КонецЕсли;
	
	Если ДанныеИБ = Неопределено Тогда
		КомпонентыОбмена.ПараметрыКонвертации.ДокументыСИзмененнымиКлючевымиРеквизитами.Добавить(
			ПолученныеДанные.ПолучитьСсылкуНового());
	ИначеЕсли ЭлектронноеВзаимодействиеКЭДО.ИзмененыКлючевыеРеквизитыОбъекта(ДанныеИБ) Тогда
		КомпонентыОбмена.ПараметрыКонвертации.ДокументыСИзмененнымиКлючевымиРеквизитами.Добавить(ДанныеИБ.Ссылка);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_ЗаказКлиента_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.ВидДокумента = Перечисления.ВидыДокументов.ОтветНаЗаказ;
	
	Если КомпонентыОбмена.ПараметрыКонвертации.ТекущаяВерсияФорматаЧислом < ВерсияФорматаЧислом("1.7") Тогда
		ПолученныеДанные.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		ПодготовитьДатуПоставкиВДанныхXDTO(ДанныеXDTO);
		
		ПолученныеДанные.ДатаОтгрузки = ДанныеXDTO.ОжидаемаяДатаПоставки;
		ПолученныеДанные.ОтгрузкаОднойДатой = ДанныеXDTO.ОтгружатьЗаказЦеликом;
	КонецЕсли;
	
	// Чтение таблицы товаров из объекта XDTO
	ПравилаЗаполненияТоваров = Новый Соответствие;
	ПравилаЗаполненияТоваров.Вставить("Номенклатура",        "Номенклатура");
	ПравилаЗаполненияТоваров.Вставить("Характеристика",      "Характеристика");
	ПравилаЗаполненияТоваров.Вставить("Упаковка",            "ЕдиницаИзмерения");
	ПравилаЗаполненияТоваров.Вставить("Количество",          "Количество");
	ПравилаЗаполненияТоваров.Вставить("КоличествоУпаковок",  "КоличествоУпаковок");
	ПравилаЗаполненияТоваров.Вставить("Сумма",               "Сумма");
	ПравилаЗаполненияТоваров.Вставить("ЦенаЗаУпаковку",      "Цена");
	ПравилаЗаполненияТоваров.Вставить("СтавкаНДС",           "СтавкаНДС");
	ПравилаЗаполненияТоваров.Вставить("СуммаНДС",            "СуммаНДС");
	ПравилаЗаполненияТоваров.Вставить("СуммаСНДС",           "СуммаСНДС");
	ПравилаЗаполненияТоваров.Вставить("ОжидаемаяДатаПоставки", "ДатаОтгрузки");
	ПравилаЗаполненияТоваров.Вставить("SKUКонтрагента", "НоменклатураКонтрагента");
	
	ИтогиПоТоварам = ЗагрузитьТоварыДокумента(ДанныеXDTO, ПолученныеДанные,
		КомпонентыОбмена, ПравилаЗаполненияТоваров);
	
	// Чтение таблицы услуг из объекта XDTO
	ПравилаЗаполненияУслуг = Новый Соответствие;
	ПравилаЗаполненияУслуг.Вставить("Номенклатура",        "Номенклатура");
	ПравилаЗаполненияУслуг.Вставить("Характеристика",      "Характеристика");
	ПравилаЗаполненияУслуг.Вставить("Упаковка",            "ЕдиницаИзмерения");
	ПравилаЗаполненияУслуг.Вставить("Количество",          "Количество");
	ПравилаЗаполненияУслуг.Вставить("Количество",          "КоличествоУпаковок");
	ПравилаЗаполненияУслуг.Вставить("Сумма",               "Сумма");
	ПравилаЗаполненияУслуг.Вставить("Цена",                "Цена");
	ПравилаЗаполненияУслуг.Вставить("СтавкаНДС",           "СтавкаНДС");
	ПравилаЗаполненияУслуг.Вставить("СуммаНДС",            "СуммаНДС");
	ПравилаЗаполненияУслуг.Вставить("СуммаСНДС",           "СуммаСНДС");
	ПравилаЗаполненияУслуг.Вставить("ОжидаемаяДатаПоставки", "ДатаОтгрузки");
	ПравилаЗаполненияУслуг.Вставить("SKUКонтрагента", "НоменклатураКонтрагента");
	
	ИтогиПоУслугам = ЗагрузитьУслугиДокумента(ДанныеXDTO, ПолученныеДанные,
		КомпонентыОбмена, ПравилаЗаполненияУслуг);
	
	ПолученныеДанные.ОблагаетсяНДСУПокупателя = ИтогиПоТоварам.ОблагаетсяНДСУПокупателя;
	
	Если Не ДанныеXDTO.Свойство("Сумма") Тогда
		ПолученныеДанные.СуммаДокумента = ИтогиПоТоварам.Сумма + ИтогиПоУслугам.Сумма; 
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("КонтактноеЛицоКонтрагента")
		И ДанныеXDTO.КонтактноеЛицоКонтрагента <> Неопределено Тогда
		
		Если Не ДанныеXDTO.Свойство("Контрагент") Тогда
			Возврат;
		КонецЕсли;	 
			
		КонтактноеЛицоКонтрагента =  ДанныеXDTO.КонтактноеЛицоКонтрагента;
		КонтактноеЛицоКонтрагента.Вставить(
			"Владелец", 
			ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
				КомпонентыОбмена, 
				ДанныеXDTO.Контрагент,
				ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Контрагенты_Получение"),
				"ПолучитьСсылку").Ссылка);
	
		ПолученныеДанные.ДополнительныеСвойства.Вставить("КонтактноеЛицоКонтрагента",
			ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
				КомпонентыОбмена,
				КонтактноеЛицоКонтрагента,
				ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_КонтактныеЛица_Получение"),
				"ПолучитьСсылку").Ссылка);
		
	КонецЕсли;
	
	ЗагрузитьГрафикОплат(КомпонентыОбмена, ДанныеXDTO, ПолученныеДанные);
КонецПроцедуры
Процедура ПКО_Документ_ЗаказКлиента_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если Не ЗначениеЗаполнено(ПолученныеДанные.СпособДоставки) Тогда
		ПолученныеДанные.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПолученныеДанные.ФормаОплаты) Тогда
		ПолученныеДанные.ФормаОплаты = Перечисления.ФормыОплаты.Безналичная;
	КонецЕсли;
	
	
	Если ДанныеИБ <> Неопределено Тогда
	
		// Переносим те свойства, которые указаны в ПКС.
		ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
		// Табличные части
		ДанныеИБ.Товары.Загрузить(ПолученныеДанные.Товары.Выгрузить());
	
		ПолученныеДанные = Неопределено;
		
	КонецЕсли;
	
	Если ДанныеИБ = Неопределено Тогда
		КомпонентыОбмена.ПараметрыКонвертации.ДокументыСИзмененнымиКлючевымиРеквизитами.Добавить(
			ПолученныеДанные.ПолучитьСсылкуНового());
	ИначеЕсли ЭлектронноеВзаимодействиеКЭДО.ИзмененыКлючевыеРеквизитыОбъекта(ДанныеИБ) Тогда
		КомпонентыОбмена.ПараметрыКонвертации.ДокументыСИзмененнымиКлючевымиРеквизитами.Добавить(ДанныеИБ.Ссылка);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_ЗаказПоставщику_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.ВидДокумента = Перечисления.ВидыДокументов.ЗаказТовара;
	
	Если КомпонентыОбмена.ПараметрыКонвертации.ТекущаяВерсияФорматаЧислом < ВерсияФорматаЧислом("1.7") Тогда
		ПолученныеДанные.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
	КонецЕсли;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.8") Тогда
		ПодготовитьДатуПоставкиВДанныхXDTO(ДанныеXDTO);
		
		ПолученныеДанные.ДатаПоступления = ДанныеXDTO.ОжидаемаяДатаПоставки;
		Если НЕ ЗначениеЗаполнено(ПолученныеДанные.ДатаПоступления)
			И ДанныеXDTO.Свойство("ОжидаемаяДатаПоступления") Тогда
			ПолученныеДанные.ДатаПоступления = ДанныеXDTO.ОжидаемаяДатаПоступления;			
		КонецЕсли;
		ПолученныеДанные.ПоступлениеОднойДатой = ДанныеXDTO.ОтгружатьЗаказЦеликом;
	КонецЕсли;	  	
	
	// Чтение таблицы товаров из объекта XDTO
	ПравилаЗаполненияТоваров = Новый Соответствие;                  
	ПравилаЗаполненияТоваров.Вставить("Номенклатура",          "Номенклатура");
	ПравилаЗаполненияТоваров.Вставить("Характеристика",        "Характеристика");
	ПравилаЗаполненияТоваров.Вставить("Упаковка",              "ЕдиницаИзмерения");
	ПравилаЗаполненияТоваров.Вставить("Количество",            "Количество");
	ПравилаЗаполненияТоваров.Вставить("КоличествоУпаковок",    "КоличествоУпаковок");
	ПравилаЗаполненияТоваров.Вставить("Сумма",                 "Сумма");
	ПравилаЗаполненияТоваров.Вставить("ЦенаЗаУпаковку",        "Цена");
	ПравилаЗаполненияТоваров.Вставить("СтавкаНДС",             "СтавкаНДС");
	ПравилаЗаполненияТоваров.Вставить("СуммаНДС",              "СуммаНДС");
	ПравилаЗаполненияТоваров.Вставить("СуммаСНДС",             "СуммаСНДС");
	ПравилаЗаполненияТоваров.Вставить("SKUКонтрагента",        "НоменклатураКонтрагента");
	ПравилаЗаполненияТоваров.Вставить("ОжидаемаяДатаПоставки", "ДатаПоступления");
	
	ИтогиПоТоварам = ЗагрузитьТоварыДокумента(ДанныеXDTO, ПолученныеДанные,
		КомпонентыОбмена, ПравилаЗаполненияТоваров);
	
	// Чтение таблицы услуг из объекта XDTO
