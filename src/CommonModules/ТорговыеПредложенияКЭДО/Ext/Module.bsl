	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПрайсЛист КАК ПрайсЛистСкидки
	|		ПО ВР_СкидкиПроцентСуммаВидыЦен.Номенклатура = ПрайсЛистСкидки.Номенклатура
	|		И ВР_СкидкиПроцентСуммаВидыЦен.Характеристика = ПрайсЛистСкидки.Характеристика
	|		И ВР_СкидкиПроцентСуммаВидыЦен.ЕдиницаИзмерения = ПрайсЛистСкидки.ЕдиницаИзмерения
	|		И (ВР_СкидкиПроцентСуммаВидыЦен.Организация = ПрайсЛистСкидки.Организация
	|		ИЛИ ПрайсЛистСкидки.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|		И ВР_СкидкиПроцентСуммаВидыЦен.ВидыЦен = ПрайсЛистСкидки.ВидЦены";
	
	Запрос.УстановитьПараметр("ПредставлениеКонтакта", НСтр("ru = 'Отдел продаж'"));
	
	ИспользоватьДополнительныеРеквизитыИСведения = ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеРеквизитыИСведения");
	Запрос.УстановитьПараметр("ИспользоватьДополнительныеРеквизитыИСведения", ИспользоватьДополнительныеРеквизитыИСведения);
	
	ДобавитьРеквизитыНоменклатурыВЗапрос(Запрос);

