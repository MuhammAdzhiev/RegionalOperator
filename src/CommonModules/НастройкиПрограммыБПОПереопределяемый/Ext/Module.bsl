#Область ПрограммныйИнтерфейс

#Область РаботаСФормойПанельАдминистрирования

// Дополнительные переопределяемые действия с управляемой формой в Панели администрирования БПО
// при событии "ПриСозданииНаСервере".
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма настройки оборудования
//  Отказ - Булево - Отказ создания
//  Параметры - Структура - Параметры операции
//  СтандартнаяОбработка - Булево - Стандартная обработка
//
Процедура ПанельАдминистрированияПриСозданииНаСервере(Форма, Отказ, Параметры, СтандартнаяОбработка) Экспорт
	
	Если КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		Возврат;
	КонецЕсли;
	
	НовыеРеквизиты = Новый Массив();
	НовыеРеквизиты.Добавить(
		Новый РеквизитФормы(
			"ИспользоватьПодключаемоеОборудование",
			Новый ОписаниеТипов("Булево"),,
			"Подключаемое оборудование"));
	Форма.ИзменитьРеквизиты(НовыеРеквизиты);
	Форма.ИспользоватьПодключаемоеОборудование = ПолучитьФункциональнуюОпцию("ИспользоватьПодключаемоеОборудование");
	
	ФлажокИспользоватьПодключаемоеОборудование = Форма.Элементы.Вставить(
		"ИспользоватьПодключаемоеОборудование",
		Тип("ПолеФормы"),
		Форма,
		Форма.Элементы.ГруппаУправлениеПодключаемымОборудованием);
	ФлажокИспользоватьПодключаемоеОборудование.Вид = ВидПоляФормы.ПолеФлажка;
	ФлажокИспользоватьПодключаемоеОборудование.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ФлажокИспользоватьПодключаемоеОборудование.ПутьКДанным = "ИспользоватьПодключаемоеОборудование";
	
	ФлажокИспользоватьПодключаемоеОборудование.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииРеквизита");
	
КонецПроцедуры

// Дополнительная настройка доступности при изменении реквизита формы
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  РеквизитПутьКДанным - Строка
//
Процедура ПанельАдминистрированияУстановкаДоступности(Форма, РеквизитПутьКДанным) Экспорт
	
	Если КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		Возврат;
	КонецЕсли;
	
	Форма.Элементы.ГруппаУправлениеПодключаемымОборудованием.Доступность = Форма.ИспользоватьПодключаемоеОборудование;
	Форма.Элементы.ГруппаУправлениеЖурналамиОпераций.Доступность = Форма.ИспользоватьПодключаемоеОборудование;
	
КонецПроцедуры

