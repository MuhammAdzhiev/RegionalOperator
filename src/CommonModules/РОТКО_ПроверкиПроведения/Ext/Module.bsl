// Назначение модуля: Централизованные предметные проверки документов перед проведением; движения регистров здесь не создаются.
// Эти функции выполняют предметные проверки, но НЕ создают движений.
// Возвращают пустую строку при успехе либо текст первой обнаруженной ошибки.
// Проверяет проведение и допустимый завершенный статус исходного рейса.
// Параметры:
//   ДанныеРейса - данные рейса для проверки и сопоставления.
// Возвращаемое значение:
//   Строка — пустая при успехе, иначе описание нарушения.
Функция ОшибкаСостоянияРейса(ДанныеРейса)
	
	Если НЕ ДанныеРейса.Проведен Тогда
		Возврат "Исходный рейс не проведен.";
	КонецЕсли;
	
	Если ДанныеРейса.Статус <> Перечисления.СтатусРейса.Выполнен
		И ДанныеРейса.Статус <> Перечисления.СтатусРейса.ЧастичноВыполнен Тогда
		Возврат "Исходный рейс должен быть выполнен или частично выполнен.";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции
// Проверяет реквизиты приема, положительный объем и соответствие документа исходному рейсу.
// Параметры:
//   ДокументПриема - объект документа приема отходов.
// Возвращаемое значение:
//   Строка — пустая при успехе, иначе описание нарушения.
Функция ПроверитьПриемОтходов(ДокументПриема) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументПриема.Рейс) Тогда
		Возврат "Не указан рейс.";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументПриема.ОбъектПриемаТКО) Тогда
		Возврат "Не указан объект приема ТКО.";
	КонецЕсли;
	
	Если ДокументПриема.ОбъемМ3 <= 0 Тогда
		Возврат "Объем принятого ТКО должен быть больше нуля.";
	КонецЕсли;
	
	РейсОбъект = ДокументПриема.Рейс.ПолучитьОбъект();
	Если РейсОбъект = Неопределено Тогда
		Возврат "Исходный рейс не найден.";
	КонецЕсли;
	
	Ошибка = ОшибкаСостоянияРейса(РейсОбъект);
	Если НЕ ПустаяСтрока(Ошибка) Тогда
		Возврат Ошибка;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(РейсОбъект.ОбъектПриема) Тогда
		Возврат "В исходном рейсе не заполнен объект приема.";
	КонецЕсли;
	
	Если ДокументПриема.ОбъектПриемаТКО <> РейсОбъект.ОбъектПриема Тогда
		Возврат "Объект приема в документе не соответствует объекту приема рейса.";
	КонецЕсли;
	
	// Реквизиты шапки заполняются командой «Заполнить из рейса».
	// При проведении они не должны расходиться с основанием.
	Если ДокументПриема.ТипИсполнителя <> РейсОбъект.ТипИсполнителя Тогда
		Возврат "Тип исполнителя отличается от указанного в рейсе.";
	КонецЕсли;
	
	Если ДокументПриема.Подрядчик <> РейсОбъект.Подрядчик Тогда
		Возврат "Подрядчик отличается от указанного в рейсе.";
	КонецЕсли;
	
	Если ДокументПриема.ТС <> РейсОбъект.ТС Тогда
		Возврат "Транспортное средство отличается от указанного в рейсе.";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции
// Проверяет период и строки акта, а также состояние и реквизиты связанных рейсов одним запросом.
// Параметры:
//   ДокументАкта - объект акта подрядчика.
// Возвращаемое значение:
//   Строка — пустая при успехе, иначе описание нарушения.
Функция ПроверитьАктПодрядчика(ДокументАкта) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументАкта.Подрядчик) Тогда
		Возврат "Не указан подрядчик в шапке акта.";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументАкта.ПериодС) Или НЕ ЗначениеЗаполнено(ДокументАкта.ПериодПо) Тогда
		Возврат "Не заполнен период акта подрядчика.";
	КонецЕсли;
	
	Если ДокументАкта.ПериодС > ДокументАкта.ПериодПо Тогда
		Возврат "Начало периода акта позже окончания.";
	КонецЕсли;
	
	Если ДокументАкта.Строки.Количество() = 0 Тогда
		Возврат "Нельзя провести акт подрядчика без строк.";
	КонецЕсли;
	// Рейсы читаются ОДНИМ запросом, чтобы не получать объект рейса по одному разу для каждой строки акта.
	СписокРейсов = Новый Массив;
	НомерСтроки = 0;
	
	Для Каждого СтрокаАкта Из ДокументАкта.Строки Цикл
		НомерСтроки = НомерСтроки + 1;
		
		Если НЕ ЗначениеЗаполнено(СтрокаАкта.Рейс) Тогда
			Возврат "Строка " + Строка(НомерСтроки) + ": не заполнен рейс.";
		КонецЕсли;
		
		Если СписокРейсов.Найти(СтрокаАкта.Рейс) = Неопределено Тогда
			СписокРейсов.Добавить(СтрокаАкта.Рейс);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Рейсы.Ссылка КАК Рейс,
	|	Рейсы.Проведен КАК Проведен,
	|	Рейсы.Статус КАК Статус,
	|	Рейсы.ТипИсполнителя КАК ТипИсполнителя,
	|	Рейсы.Подрядчик КАК Подрядчик,
	|	Рейсы.ТС КАК ТС,
	|	Рейсы.ОбъектПриема КАК ОбъектПриема
	|ИЗ
	|	Документ.Рейс КАК Рейсы
	|ГДЕ
	|	Рейсы.Ссылка В(&СписокРейсов)"; 
	
	Запрос.УстановитьПараметр("СписокРейсов", СписокРейсов);
	
	ДанныеРейсов = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Данные = Новый Структура("Проведен,Статус,ТипИсполнителя,Подрядчик,ТС,ОбъектПриема", Выборка.Проведен, Выборка.Статус,
		Выборка.ТипИсполнителя, Выборка.Подрядчик, Выборка.ТС, Выборка.ОбъектПриема);
		ДанныеРейсов.Вставить(Выборка.Рейс, Данные);
	КонецЦикла;
	
	НомерСтроки = 0;
	Для Каждого СтрокаАкта Из ДокументАкта.Строки Цикл
		НомерСтроки = НомерСтроки + 1;
		Префикс = "Строка " + Строка(НомерСтроки) + ": ";
		
		Данные = ДанныеРейсов.Получить(СтрокаАкта.Рейс);
		Если Данные = Неопределено Тогда
			Возврат Префикс + "рейс не найден.";
		КонецЕсли;
		
		Ошибка = ОшибкаСостоянияРейса(Данные);
		Если НЕ ПустаяСтрока(Ошибка) Тогда
			Возврат Префикс + Ошибка;
		КонецЕсли;
		
		Если Данные.ТипИсполнителя <> Перечисления.ТипИсполнителя.Подрядчик Тогда
			Возврат Префикс + "в акт подрядчика включен рейс собственного исполнителя.";
		КонецЕсли;
		
		Если Данные.Подрядчик <> ДокументАкта.Подрядчик Тогда
			Возврат Префикс + "подрядчик в рейсе отличается от подрядчика акта.";
		КонецЕсли;
		// Проверку заполненности ключа и наличия обоих объемов оставляем действующей в модуле объекта (доработка P2-08).
		Если СтрокаАкта.ТС <> Данные.ТС Тогда
			Возврат Префикс + "ТС не соответствует исходному рейсу.";
		КонецЕсли;
		
		Если СтрокаАкта.ОбъектПриема <> Данные.ОбъектПриема Тогда
			Возврат Префикс + "объект приема не соответствует исходному рейсу.";
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции
// Проверяет обязательную причину и допустимость исходных объемов в строках корректировки.
// Параметры:
//   ДокументКорректировки - объект документа корректировки факта рейса.
// Возвращаемое значение:
//   Строка — пустая при успехе, иначе описание нарушения.
Функция ПроверитьКорректировкуФактаРейса(ДокументКорректировки) Экспорт
	
	Если ПустаяСтрока(СокрЛП(ДокументКорректировки.ПричинаКорректировки)) Тогда
		Возврат "Не указана причина корректировки фактического объема.";
	КонецЕсли;
	
	Если ДокументКорректировки.Корректировки.Количество() = 0 Тогда
		Возврат "Табличная часть корректировки пуста.";
	КонецЕсли;
	
	НомерСтроки = 0;
	Для Каждого СтрокаКорректировки Из ДокументКорректировки.Корректировки Цикл
		НомерСтроки = НомерСтроки + 1;
		Если СтрокаКорректировки.СтарыйФактМ3 < 0 Тогда
			Возврат "Строка " + Строка(НомерСтроки) + ": старый фактический объем не может быть отрицательным.";
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции
