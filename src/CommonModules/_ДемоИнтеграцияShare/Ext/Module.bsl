#Область СлужебныйПрограммныйИнтерфейс

// См. ИнтеграцияShareПереопределяемый.ПриОпределенииСоставаКомандShare
Процедура ПриОпределенииСоставаКомандShare(СоставКоманд) Экспорт
	
	// Договоры
	СоставКоманд.Исходящие.Добавить(Метаданные.Справочники.ДоговорыКонтрагентов.ПолноеИмя());
	СоставКоманд.Входящие.Добавить(Метаданные.Справочники.ДоговорыКонтрагентов.ПолноеИмя());
	
	// ОтчетОСписанииКомиссионногоТовара
	СоставКоманд.Исходящие.Добавить(Метаданные.Документы._ДемоОтчетКомиссионера.ПолноеИмя());
	СоставКоманд.Входящие.Добавить(Метаданные.Документы._ДемоОтчетКомиссионера.ПолноеИмя());
	
	// ОтчетОПродажахКомиссионногоТовара
	СоставКоманд.Исходящие.Добавить(Метаданные.Документы._ДемоОтчетКомитенту.ПолноеИмя());
	СоставКоманд.Входящие.Добавить(Метаданные.Документы._ДемоОтчетКомитенту.ПолноеИмя());
	
	// ПрайсЛист
	СоставКоманд.Исходящие.Добавить(Метаданные.Документы._ДемоОперация.ПолноеИмя());
	СоставКоманд.Входящие.Добавить(Метаданные.Документы._ДемоОперация.ПолноеИмя());
	
КонецПроцедуры

// См. ИнтеграцияShareПереопределяемый.ЗаполнитьНастройкиФормированияДокумента
Процедура ЗаполнитьНастройкиФормированияДокумента(СсылкаНаДокумент, НастройкиФормирования) Экспорт
	
	ПоддерживаемыеФорматыЭДО = ОбменСКонтрагентами.ФорматыДокументов();
	ТипыДокументов           = ОбменСКонтрагентами.ТипыДокументов();
	НаправленияДокументов    = ОбменСКонтрагентами.НаправленияДокументов();
	
	ТипИсточника = ТипЗнч(СсылкаНаДокумент);

	Если ТипИсточника = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		
		Реквизиты = "Организация, Владелец";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаДокумент, Реквизиты);
		
		НастройкиФормирования.ТипДокумента       = ТипыДокументов.ДокументПредприятия;
		НастройкиФормирования.Формат             = ПоддерживаемыеФорматыЭДО.ДокументПредприятия;
		НастройкиФормирования.Направление        = НаправленияДокументов.Исходящий;
		НастройкиФормирования.Организация        = ЗначенияРеквизитов.Организация;
		НастройкиФормирования.Контрагент         = ЗначенияРеквизитов.Владелец;
		НастройкиФормирования.ДоговорКонтрагента = СсылкаНаДокумент;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка._ДемоОтчетКомиссионера") Тогда
		
		Реквизиты = "Организация, Контрагент, ДоговорКонтрагента";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаДокумент, Реквизиты);
		
		НастройкиФормирования.ТипДокумента       = ТипыДокументов.ОтчетОПродажахКомиссионногоТовара;
		НастройкиФормирования.Формат             = ПоддерживаемыеФорматыЭДО.CML208;
		НастройкиФормирования.Направление        = НаправленияДокументов.Исходящий;
		НастройкиФормирования.Организация        = ЗначенияРеквизитов.Организация;
		НастройкиФормирования.Контрагент         = ЗначенияРеквизитов.Контрагент;
		НастройкиФормирования.ДоговорКонтрагента = ЗначенияРеквизитов.ДоговорКонтрагента;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка._ДемоОтчетКомитенту") Тогда
		
		Реквизиты = "Организация, Контрагент, ДоговорКонтрагента";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаДокумент, Реквизиты);
		
		НастройкиФормирования.ТипДокумента       = ТипыДокументов.ОтчетОСписанииКомиссионногоТовара;
		НастройкиФормирования.Формат             = ПоддерживаемыеФорматыЭДО.CML208;
		НастройкиФормирования.Направление        = НаправленияДокументов.Исходящий;
		НастройкиФормирования.Организация        = ЗначенияРеквизитов.Организация;
		НастройкиФормирования.Контрагент         = ЗначенияРеквизитов.Контрагент;
		НастройкиФормирования.ДоговорКонтрагента = ЗначенияРеквизитов.ДоговорКонтрагента;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка._ДемоОперация") Тогда
		
		Реквизиты = "Организация, Контрагент, ДоговорКонтрагента, НаправлениеЭД, ВидЭД";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаДокумент, Реквизиты);
		
		Если ЗначенияРеквизитов.ВидЭД <> ТипыДокументов.ПрайсЛист Тогда
			Возврат;
		КонецЕсли;
		
		НастройкиФормирования.ТипДокумента       = ЗначенияРеквизитов.ВидЭД;
		НастройкиФормирования.Формат             = ПоддерживаемыеФорматыЭДО.CML208;
		НастройкиФормирования.Направление        = ЗначенияРеквизитов.НаправлениеЭД;
		НастройкиФормирования.Организация        = ЗначенияРеквизитов.Организация;
		НастройкиФормирования.Контрагент         = ЗначенияРеквизитов.Контрагент;
		НастройкиФормирования.ДоговорКонтрагента = ЗначенияРеквизитов.ДоговорКонтрагента;
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
