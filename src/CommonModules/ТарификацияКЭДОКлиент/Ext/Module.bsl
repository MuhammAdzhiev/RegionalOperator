// @strict-types

#Область ПрограммныйИнтерфейс

// см. СтандартныеПодсистемыКлиент.ПриПолученииСерверногоОповещения
Процедура ПриПолученииСерверногоОповещения(ИмяОповещения, Результат) Экспорт

#Если МобильныйКлиент Тогда
	Возврат;
#КонецЕсли

	Если ИмяОповещения = ТарификацияКЭДОКлиентСервер.ИмяСерверногоОповещенияИзмененияСпискаУслуг() Тогда
		
		ИмяПараметраПредставлениеКонфигурации = ТарификацияКЭДОКлиентСервер.ИмяПараметраПредставлениеКонфигурации();
		ИмяПараметраТребуетсяИзменитьПредставление = ТарификацияКЭДОКлиентСервер.ИмяПараметраТребуетсяИзменитьЗаголовокПриложения();
		
		СтандартныеПодсистемыКлиент.ПараметрыРаботыКлиента();
		СтандартныеПодсистемыКлиент.УстановитьПараметрКлиента(
			ИмяПараметраПредставлениеКонфигурации,
			Результат.Заголовок);
		СтандартныеПодсистемыКлиент.УстановитьПараметрКлиента(
			ИмяПараметраТребуетсяИзменитьПредставление,
			Истина);
		СтандартныеПодсистемыКлиент.УстановитьРасширенныйЗаголовокПриложения();
		СтандартныеПодсистемыКлиент.УстановитьПараметрКлиента(
			ИмяПараметраТребуетсяИзменитьПредставление,
			Ложь);
		
		Если Результат.ИспользоватьМаркировку Тогда
			Оповестить(ТарификацияКЭДОКлиентСервер.ИмяОповещенияПодключениеУслугиМаркировка());
		Иначе
			Оповестить(ТарификацияКЭДОКлиентСервер.ИмяОповещенияОтключенияУслугиМаркировка());
		КонецЕсли;
		
		КлиентЭДОВызовСервера.УстановитьСтандартныйИнтерфейс();
		ОбновитьПовторноИспользуемыеЗначения();
		ОбновитьИнтерфейс();
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
