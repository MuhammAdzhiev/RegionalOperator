					НоваяСтрока, ВыборкаТоваров, СтруктураДанных, ДанныеПриложенияЕИС);
			КонецЕсли;
			// Конец  ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		
		КонецЦикла;
		
		ТекстОшибки = НСтр("ru = 'Не удалось заполнить итоговые стоимостные показатели. Возможные причины:
		|	- не заполнена табличная часть ""Товары""
		|	- не заполнены колонки ""Сумма"", ""НДС"", ""Количество""'");
		
		ИтогСтоимостьТоваровБезНалога = СведенияОТоварах.Итог("СтоимостьТоваровБезНалога");
		ИтогСтоимостьТоваровСНалогом = СведенияОТоварах.Итог("СтоимостьТоваровСНалогом");
		ИтогСуммаНалога = СведенияОТоварах.Итог("СуммаНалога");
		ИтогКоличество = СведенияОТоварах.Итог("Количество");
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
