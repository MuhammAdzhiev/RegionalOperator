						НовыеСведения.КоличествоУчетное = ТекущиеСведения.КоличествоУпаковок;
						НовыеСведения.Количество = ТекущиеСведения.КоличествоПрослеживаемости;
						НовыеСведения.ЕдиницаИзмеренияКод = ТекущиеСведения.ЕдиницаИзмеренияКод;
						НовыеСведения.ЕдиницаИзмеренияНаименование = ТекущиеСведения.ЕдиницаИзмеренияНаименование;
						НовыеСведения.СтоимостьБезНДС = ТекущиеСведения.СтоимостьБезНДС;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
			Сопоставление = Новый Структура;
			Сопоставление.Вставить("Наименование", ВыборкаТоваров.НаименованиеПолное);
