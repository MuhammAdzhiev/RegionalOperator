// Подготавливает данные для электронного документа УПД (информация покупателя) по приказу ФНС № ЕД-7-26/970@.
//
// Параметры:
//  Основания - Массив Из ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - основания электронного документа.
//  Данные - ДеревоЗначений - данные для заполнения электронного документа. Строится по макету 
//                            см. Обработка.ОбменСКонтрагентами.Макет.УПД_ИнформацияПокупателя_5_02. Выходной параметр.
//  Отказ - Булево - признак отказа от дальнейшего формирования электронного документа.
//                   Информационное сообщение пользователю необходимо формировать самостоятельно.
//
Процедура ЗаполнитьДанныеУПД_5_02_ИнформацияПокупателя(Знач Основания, Данные, Отказ) Экспорт
	
	ПередачаТоваров = Документы._ДемоПередачаТоваровМеждуОрганизациями.ПустаяСсылка();
	
	Если Не ТипЗнч(Основания) = Тип("Массив") Тогда
		Основания = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Основания);
	КонецЕсли;
	
	Для каждого Основание Из Основания Цикл
		Если ТипЗнч(Основание) = Тип("ДокументСсылка._ДемоПередачаТоваровМеждуОрганизациями") Тогда
			ПередачаТоваров = Основание;
		КонецЕсли;
	КонецЦикла;
	
	ДатаПолученияТоваров = Дата(1, 1, 1);
	СодержаниеОперации   = "-";
	СоставительДокумента = "-";
	КодИтога = "1";
	
	Если ЗначениеЗаполнено(ПередачаТоваров) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	_ДемоПередачаТоваровМеждуОрганизациями.Дата,
		|	_ДемоПередачаТоваровМеждуОрганизациями.ОрганизацияПолучатель.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
		|	_ДемоПередачаТоваровМеждуОрганизациями.ОрганизацияПолучатель.ИНН КАК ОрганизацияИНН,
		|	_ДемоПередачаТоваровМеждуОрганизациями.ОрганизацияПолучатель.КПП КАК ОрганизацияКПП
		|ИЗ
		|	Документ._ДемоПередачаТоваровМеждуОрганизациями КАК _ДемоПередачаТоваровМеждуОрганизациями
		|ГДЕ
		|	_ДемоПередачаТоваровМеждуОрганизациями.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ПередачаТоваров);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		ДатаПолученияТоваров = Выборка.Дата;
		
		СоставительДокумента = ?(ЗначениеЗаполнено(Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН/КПП %2/%3'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН, Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН %2'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН));

	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СоставительДокументаНаименование", СоставительДокумента);
	
	Путь = "СодержаниеФХЖ.СведенияОПринятииТоваров.";
	Если ЗначениеЗаполнено(ДатаПолученияТоваров) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			Данные, Путь + "ДатаПолученияТоваров", ДатаПолученияТоваров);
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, Путь + "СодержаниеОперации", СодержаниеОперации);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, Путь + "КодИтога", КодИтога);
	
КонецПроцедуры

//См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_5_02.
Процедура ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_5_02(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	СпособОбработки = ПараметрыДляОтраженияВУчете.ПараметрыПоФорматуДокумента.СпособОбработки;
	
	Если ЗначениеЗаполнено(СпособОбработки) И СпособОбработки = "_ДемоПередачаТоваровМеждуОрганизациями" Тогда
		Возврат;
	КонецЕсли;
	
	ПервичныйДокумент = Неопределено;
	
	СпособОбработкиПервичногоДокумента = "";
	
	Если ЗначениеЗаполнено(СпособОбработки) И ТипЗнч(СпособОбработки) = Тип("Структура") Тогда
		Если СпособОбработки.Свойство("ПервичныйДокумент") Тогда
			СпособОбработкиПервичногоДокумента = СпособОбработки.ПервичныйДокумент;
		КонецЕсли;
	Иначе
		СпособОбработкиПервичногоДокумента = СпособОбработки;
	КонецЕсли;
	
	Для Каждого Строка Из РезультатОтраженияВУчете.ДокументыУчета Цикл
		ПервичныйДокумент = Строка;
	КонецЦикла;

	ДокументыУчета = Новый Массив;
	
	НайтиДокументОПередаче(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина,
		СпособОбработкиПервичногоДокумента, РезультатОтраженияВУчете.ОписаниеОшибки, "СведенияОСчетеФактуре");
	ДокументыУчета.Добавить(ПервичныйДокумент);
	
	РезультатОтраженияВУчете.ДокументыУчета = ДокументыУчета;
	
КонецПроцедуры

#КонецОбласти

#Область УПД_5_03

// Подготавливает данные для электронного документа УПД (информация продавца) по приказу ФНС № ЕД-7-26/1032@.
//
// Параметры:
//  Основание - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - основание для электронного документа.
//  Настройки - ФиксированнаяСтруктура - настройки заполнения данных:
//   * ТипДокумента - Произвольный - тип документа, который нужно сформировать. Возможные значения представлены следующими 
//                                   свойствами результата функции см. ОбменСКонтрагентами.ТипыДокументов:
//                                    - АктВыполненныхРабот, 
//                                    - АктНаПередачуПрав, 
//                                    - ТоварнаяНакладная, 
//                                    - СчетФактура, 
//                                    - УПД,
//                                    - СведенияОРеализацииКомиссионером,
//                                    - СведенияОЗакупкеКомиссионером.
//   * Отправитель - ОпределяемыйТип.Организация - отправитель электронного документа.
//   * Получатель - ОпределяемыйТип.УчастникЭДО - получатель электронного документа.
//   * Договор - ОпределяемыйТип.ДоговорСКонтрагентомЭДО - договор с получателем электронного документа.
//   * ВариантыЗаполненияПолей - Структура - пользовательские настройки для заполнения полей:
//    ** ТоварКод - Строка - значение из списка, заданного в ПриОпределенииВариантовЗаполненияПолейЭлектронныхДокументов
//                           для идентификатора "УПД_ТоварКод".
//  Данные - ДеревоЗначений - данные для заполнения электронного документа. Строится по макету 
//                            см. Обработка.ОбменСКонтрагентами.Макет.УПД_ИнформацияПродавца_5_03. Выходной параметр.
//  Описание - Структура - дополнительная информация о документе. Выходной параметр.
//   * Основания - Массив из ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылки на дополнительные объекты-основания
//                 электронного документа помимо указанного в параметре "Основание".
//  Отказ - Булево - признак отказа от дальнейшего формирования электронного документа.
//                   Информационное сообщение пользователю необходимо формировать самостоятельно.
//
Процедура ЗаполнитьДанныеУПД_5_03_ИнформацияПродавца(Знач Основание, Знач Настройки, Данные, Описание, Отказ) Экспорт
	
	ВсеВидыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	ТипДокумента = Настройки.ТипДокумента;
	
	СтруктураЭД = ОбщегоНазначения.СкопироватьРекурсивно(Настройки, Ложь);
	СчетФактура = Неопределено;
	ПередаточныеДокументы = Новый Массив;
	
	ТипДокументаОснования = ТипЗнч(Основание);
	Если ТипДокументаОснования = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		СчетФактура = Основание;
		ПередаточныеДокументы = ОснованияСчетаФактуры(Основание);
	Иначе
		СчетФактура = Документы.СчетФактураВыданный.СчетФактураДокумента(Основание);
		ПередаточныеДокументы.Добавить(Основание);
	КонецЕсли;

	Если ТипДокумента = ВсеВидыДокументов.УПД Тогда
		
		СтруктураЭД.Вставить("Функция", "СЧФДОП");
		
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_5_02(СчетФактура, СтруктураЭД, Данные, Отказ);
		Иначе
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
			Если УПДБезНДС(Данные) Тогда
				СтруктураЭД.Функция = "ДОП";
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СчетФактура Тогда
		
		СтруктураЭД.Вставить("Функция", "СЧФ");
		ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);

	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СведенияОРеализацииКомиссионером Тогда

		СтруктураЭД.Вставить("Функция", "СвРК");
		
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_5_02(СчетФактура, СтруктураЭД, Данные, Отказ);
		Иначе
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
		КонецЕсли;
			
	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СведенияОЗакупкеКомиссионером Тогда

		СтруктураЭД.Вставить("Функция", "СвЗК");
		ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
			
	Иначе
		
		СтруктураЭД.Вставить("Функция", "ДОП");
		ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
		
	КонецЕсли;
	
	ФункцияУПД = СтруктураЭД.Функция;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "Функция", ФункцияУПД);
	
	Если ФункцияУПД = "СЧФДОП" Тогда
		
		Если Основание = СчетФактура Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Описание.Основания, ПередаточныеДокументы);
		Иначе
			Описание.Основания.Добавить(СчетФактура);
		КонецЕсли;
		
	КонецЕсли;	

КонецПроцедуры

// Подготавливает данные для электронного документа УПД (информация покупателя) по приказу ФНС № ЕД-7-26/1032@.
//
// Параметры:
//  Основания - Массив Из ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - основания электронного документа.
//  Данные - ДеревоЗначений - данные для заполнения электронного документа. Строится по макету 
//                            см. Обработка.ОбменСКонтрагентами.Макет.УПД_ИнформацияПокупателя_5_03. Выходной параметр.
//  Отказ - Булево - признак отказа от дальнейшего формирования электронного документа.
//                   Информационное сообщение пользователю необходимо формировать самостоятельно.
//
Процедура ЗаполнитьДанныеУПД_5_03_ИнформацияПокупателя(Знач Основания, Данные, Отказ) Экспорт
	
	ПередачаТоваров = Документы._ДемоПередачаТоваровМеждуОрганизациями.ПустаяСсылка();
	
	Если Не ТипЗнч(Основания) = Тип("Массив") Тогда
		Основания = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Основания);
	КонецЕсли;
	
	Для каждого Основание Из Основания Цикл
		Если ТипЗнч(Основание) = Тип("ДокументСсылка._ДемоПередачаТоваровМеждуОрганизациями") Тогда
			ПередачаТоваров = Основание;
		КонецЕсли;
	КонецЦикла;
	
	ДатаПолученияТоваров = Дата(1, 1, 1);
	СодержаниеОперации   = "-";
	СоставительДокумента = "-";
	КодИтога = "1";
	
	Если ЗначениеЗаполнено(ПередачаТоваров) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	_ДемоПередачаТоваровМеждуОрганизациями.Дата,
		|	_ДемоПередачаТоваровМеждуОрганизациями.ОрганизацияПолучатель.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
		|	_ДемоПередачаТоваровМеждуОрганизациями.ОрганизацияПолучатель.ИНН КАК ОрганизацияИНН,
		|	_ДемоПередачаТоваровМеждуОрганизациями.ОрганизацияПолучатель.КПП КАК ОрганизацияКПП
		|ИЗ
		|	Документ._ДемоПередачаТоваровМеждуОрганизациями КАК _ДемоПередачаТоваровМеждуОрганизациями
		|ГДЕ
		|	_ДемоПередачаТоваровМеждуОрганизациями.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ПередачаТоваров);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		ДатаПолученияТоваров = Выборка.Дата;
		
		СоставительДокумента = ?(ЗначениеЗаполнено(Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН/КПП %2/%3'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН, Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН %2'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН));

	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СоставительДокументаНаименование", СоставительДокумента);
	
	Путь = "СодержаниеФХЖ.СведенияОПринятииТоваров.";
	Если ЗначениеЗаполнено(ДатаПолученияТоваров) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			Данные, Путь + "ДатаПолученияТоваров", ДатаПолученияТоваров);
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, Путь + "СодержаниеОперации", СодержаниеОперации);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, Путь + "КодИтога", КодИтога);
	
КонецПроцедуры

//См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_5_03.
Процедура ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_5_03(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	СпособОбработки = ПараметрыДляОтраженияВУчете.ПараметрыПоФорматуДокумента.СпособОбработки;
	
	ПервичныйДокумент = Неопределено;
	
	СпособОбработкиПервичногоДокумента = "";
	
	Если ЗначениеЗаполнено(СпособОбработки) И ТипЗнч(СпособОбработки) = Тип("Структура") Тогда
		Если СпособОбработки.Свойство("ПервичныйДокумент") Тогда
			СпособОбработкиПервичногоДокумента = СпособОбработки.ПервичныйДокумент;
		КонецЕсли;
	Иначе
		СпособОбработкиПервичногоДокумента = СпособОбработки;
	КонецЕсли;
	
	Для Каждого Строка Из РезультатОтраженияВУчете.ДокументыУчета Цикл
		ПервичныйДокумент = Строка;
	КонецЦикла;

	ДокументыУчета = Новый Массив;
	
	НайтиДокументОПередаче(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина,
		СпособОбработкиПервичногоДокумента, РезультатОтраженияВУчете.ОписаниеОшибки, "СведенияОСчетеФактуре");
	ДокументыУчета.Добавить(ПервичныйДокумент);
	
	РезультатОтраженияВУчете.ДокументыУчета = ДокументыУчета;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ПрикладныеЭлектронныеДокументы

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииПрикладныхТиповЭлектронныхДокументов.
Процедура ПриОпределенииПрикладныхТиповЭлектронныхДокументов(ТипыЭлектронныхДокументов) Экспорт
	
	ТипыЭлектронныхДокументов.Добавить(
		Перечисления._ДемоПрикладныеТипыЭлектронныхДокументов._ДемоАктСверкиВзаиморасчетов);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииСведенийОПрикладныхФорматах.
Процедура ПриОпределенииСведенийОПрикладныхФорматах(ТаблицаФорматов) Экспорт
	
	ВерсияФормата = ТаблицаФорматов.Добавить();
	ВерсияФормата.ПрикладнойТипДокумента = 
		Перечисления._ДемоПрикладныеТипыЭлектронныхДокументов._ДемоАктСверкиВзаиморасчетов;
	ВерсияФормата.ИдентификаторФормата = "Акт сверки 1.0";
	ВерсияФормата.ПредставлениеФормата = НСтр("ru = 'Акт сверки 1.0'");
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииНастроекРегламентаЭДО.
Процедура ПриОпределенииНастроекРегламентаЭДО(Настройки, ТипЭлектронногоДокумента, ВерсияФормата, СтандартнаяОбработка) Экспорт
	
	Если ТипЭлектронногоДокумента =
		Перечисления._ДемоПрикладныеТипыЭлектронныхДокументов._ДемоАктСверкиВзаиморасчетов Тогда
		
		СтандартнаяОбработка = Ложь;
		Настройки.Вставить("ТребуетсяИзвещениеОПолучении", Истина);
		Настройки.Вставить("ТребуетсяОтветнаяПодпись",     Истина);
		Настройки.Вставить("РедактироватьПодпись",         Ложь);
		Настройки.Вставить("РедактироватьИзвещение",       Истина);
		Настройки.Вставить("РедактироватьОтветнуюПодпись", Ложь);
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииТиповУчетныхДокументовПоПрикладномуТипуЭлектронногоДокумента.
Процедура ПриОпределенииТиповУчетныхДокументовПоПрикладномуТипуЭлектронногоДокумента(ТипЭлектронногоДокумента, ТипыУчетныхДокументов) Экспорт
	
	Если ТипЭлектронногоДокумента = 
		Перечисления._ДемоПрикладныеТипыЭлектронныхДокументов._ДемоАктСверкиВзаиморасчетов Тогда
		АктСверкиПустаяСсылка = Документы._ДемоАктСверкиВзаиморасчетов.ПустаяСсылка();
		ТипыУчетныхДокументов.Добавить(АктСверкиПустаяСсылка, АктСверкиПустаяСсылка.Метаданные().Представление());
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииСоответствияИсходящихПрикладныхТиповДокументамУчета.
Процедура ПриОпределенииСоответствияИсходящихПрикладныхТиповДокументамУчета(СоответствиеТиповДокументам) Экспорт 
	
	СоответствиеТиповДокументам.Вставить(Перечисления._ДемоПрикладныеТипыЭлектронныхДокументов._ДемоАктСверкиВзаиморасчетов,
		НСтр("ru = 'Демо: Акт сверки расчетов с контрагентом'"));
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииСпособовОбработкиПрикладногоТипаЭлектронногоДокумента.
Процедура ПриОпределенииСпособовОбработкиПрикладногоТипаЭлектронногоДокумента(ТипЭлектронногоДокумента, СпособыОбработки) Экспорт
	
	Если ТипЭлектронногоДокумента = 
		Перечисления._ДемоПрикладныеТипыЭлектронныхДокументов._ДемоАктСверкиВзаиморасчетов Тогда
		
		СпособыОбработки.Добавить("_ДемоАктСверкиВзаиморасчетов",
			НСтр("ru = 'Демо: Акт сверки расчетов с контрагентом'"), Истина);
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииСпособовОбработкиПрикладногоТипаЭлектронногоДокумента.
Процедура ПриОпределенииСоставаКомандЭДООснованияПрикладногоЭлектронногоДокумента(СоставКомандЭДО) Экспорт
	
	СоставКомандЭДО.Исходящие.Добавить("Документ._ДемоАктСверкиВзаиморасчетов");
	СоставКомандЭДО.Входящие.Добавить("Документ._ДемоАктСверкиВзаиморасчетов");
	
	СоставКомандЭДО.Исходящие.Добавить("Документ._ДемоПередачаТоваровМеждуОрганизациями");
	СоставКомандЭДО.Входящие.Добавить("Документ._ДемоПередачаТоваровМеждуОрганизациями");
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииПараметровПрикладногоЭлектронногоДокументаПоИсточнику.
Процедура ПриОпределенииПараметровПрикладногоЭлектронногоДокументаПоИсточнику(Источник, Параметры) Экспорт
	
	ТипИсточника = ТипЗнч(Источник);
	ЭтоСсылка = ОбщегоНазначения.ЭтоСсылка(ТипИсточника);
	
	Если ТипИсточника = Тип("ДокументСсылка._ДемоАктСверкиВзаиморасчетов")
		ИЛИ ТипИсточника = Тип("ДокументОбъект._ДемоАктСверкиВзаиморасчетов") Тогда
		
		Реквизиты = "Организация, Контрагент, ДоговорКонтрагента, ПоДаннымКонтрагента";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		Параметры.ПрикладнойТипДокумента = 
			Перечисления._ДемоПрикладныеТипыЭлектронныхДокументов._ДемоАктСверкиВзаиморасчетов;
		Если ЗначенияРеквизитов.ПоДаннымКонтрагента <> Неопределено Тогда
			Параметры.Входящий       = ЗначенияРеквизитов.ПоДаннымКонтрагента;
		КонецЕсли;
		Параметры.Организация        = ЗначенияРеквизитов.Организация;
		Параметры.Контрагент         = ЗначенияРеквизитов.Контрагент;
		Параметры.ДоговорКонтрагента = ЗначенияРеквизитов.ДоговорКонтрагента;
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриПолученииОписанияОснованияПрикладногоЭлектронногоДокумента.
Процедура ПриПолученииОписанияОснованияПрикладногоЭлектронногоДокумента(ОснованиеОбъект, Описание, СтандартнаяОбработка) Экспорт
	
	ТипОснования = ТипЗнч(ОснованиеОбъект);
	Если ТипОснования = Тип("ДокументОбъект._ДемоАктСверкиВзаиморасчетов") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Описание.Организация = ОснованиеОбъект.Организация;
		Описание.Контрагент  = ОснованиеОбъект.Контрагент;
		Описание.Дата  = ОснованиеОбъект.Дата;
		Описание.Номер = ОснованиеОбъект.НомерЭД;
		Описание.Вид   = ОснованиеОбъект.Метаданные().Синоним;
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.СформироватьФайлПрикладногоЭлектронногоДокумента.
Процедура ПриФормированииФайлаПрикладногоЭлектронногоДокумента(ПараметрыФормирования, РезультатФормирования, Отказ) Экспорт
	
	Если ПараметрыФормирования.ТипЭлектронногоДокумента <>
		Перечисления._ДемоПрикладныеТипыЭлектронныхДокументов._ДемоАктСверкиВзаиморасчетов Тогда
		Возврат;
	КонецЕсли;
		
	// Подготовка данных.
	СтруктураДанных = Документы._ДемоАктСверкиВзаиморасчетов.ПолучитьДанныеДляЭД(ПараметрыФормирования.СсылкаНаОбъект);
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();
	
	ИмяФайла = СтрШаблон("ON_ACCOUNTS_%1_%2_%3_%4",
		ПараметрыФормирования.ИдентификаторОрганизации,
		ПараметрыФормирования.ИдентификаторКонтрагента,
		Формат(ПараметрыФормирования.ДатаФормирования, "ДФ=yyyyMMdd"),
		ПараметрыФормирования.ИдентификаторФайла);
	
	// формирование электронного документа.
	ФайлXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("ON_ACCOUNTS", "Файл"));
	
	ФайлXDTO.Установить("ИдФайл", ИмяФайла);
	ФайлXDTO.Установить("ВерсФорм", "1.02");
	ФайлXDTO.Установить("ИдФорм", "ЭДОАктСверки");
	
	ДокументXDTO = СоздатьОбъектXDTO(ФайлXDTO, "Документ");
	ДокументXDTO.Установить("Номер", ВыборкаШапки.НомерЭД);
	ДокументXDTO.Установить("Дата",  Формат(ПараметрыФормирования.ДатаФормирования, "ДФ=dd.MM.yyyy"));
	
	ЗаполнитьСведенияОбУчастникеАктаСверки(ДокументXDTO, ВыборкаШапки.Организация);
	
	ЗаполнитьСведенияОбУчастникеАктаСверки(ДокументXDTO, ВыборкаШапки.Контрагент);
	
	Если ЗначениеЗаполнено(ВыборкаШапки.ДоговорНаименование) Тогда
		ОснованиеXDTO = СоздатьОбъектXDTO(ДокументXDTO, "Основание");
		ОснованиеXDTO.Установить("Наим", ВыборкаШапки.ДоговорНаименование);
		Если ЗначениеЗаполнено(ВыборкаШапки.ДоговорНомер) Тогда
			ОснованиеXDTO.Установить("Номер", ВыборкаШапки.ДоговорНомер);
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаШапки.ДоговорДата) Тогда
			ОснованиеXDTO.Установить("Дата", Формат(ВыборкаШапки.ДоговорДата, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		ДокументXDTO.Установить("Основание", ОснованиеXDTO);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.ДатаНачала) Тогда
		Период = Формат(ВыборкаШапки.ДатаНачала, "ДФ=dd.MM.yyyy") + "-"
			+ Формат(ВыборкаШапки.ДатаОкончания, "ДФ=dd.MM.yyyy");
	Иначе
		Период = Формат(ВыборкаШапки.ДатаОкончания, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	ПериодXDTO = СоздатьОбъектXDTO(ДокументXDTO, "Период");
	ПериодXDTO.Установить("Продолж", Период);
	ДокументXDTO.Установить("Период", ПериодXDTO);
	
	ТаблицаXDTO = СоздатьОбъектXDTO(ДокументXDTO, "Таблица");
	ТаблицаРасшифровки = СтруктураДанных.ТаблицаРасшифровки;
	Для Каждого СтрокаТаблицы Из ТаблицаРасшифровки Цикл
		СтрокаТаблицыXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "СтрТабл");
		СтрокаТаблицыXDTO.Установить("Тип", "Отправитель");
		СтрокаТаблицыXDTO.Установить("Наим", СтрокаТаблицы.НаименованиеДокумента);
		СтрокаТаблицыXDTO.Установить("Примечание", СтрокаТаблицы.Примечание);
		СтрокаТаблицыXDTO.Установить("Дебет",  Формат(СтрокаТаблицы.Дебет, "ЧДЦ=2; ЧРД=.; ЧГ=0"));
		СтрокаТаблицыXDTO.Установить("Кредит", Формат(СтрокаТаблицы.Кредит, "ЧДЦ=2; ЧРД=.; ЧГ=0"));
		
		ОснованиеXDTO = СоздатьОбъектXDTO(СтрокаТаблицыXDTO, "Основание");
		ОснованиеXDTO.Установить("Номер", СтрокаТаблицы.Номер);
		ОснованиеXDTO.Установить("Дата",  Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"));
		СтрокаТаблицыXDTO.Основание.Добавить(ОснованиеXDTO);
		
		ТаблицаXDTO.СтрТабл.Добавить(СтрокаТаблицыXDTO);
	КонецЦикла;
	
	// Сальдо начальное.
	СтрокаИтоговXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "ИтогТабл");
	СтрокаИтоговXDTO.Установить("Дата", Формат(ВыборкаШапки.ДатаНачала, "ДФ=dd.MM.yyyy"));
	СтрокаИтоговXDTO.Установить("Дебет", ?(ВыборкаШапки.ОстатокНаНачало > 0,
		Формат(ВыборкаШапки.ОстатокНаНачало, "ЧДЦ=2; ЧРД=.; ЧГ=0"), "0.00"));
	СтрокаИтоговXDTO.Установить("Кредит", ?(ВыборкаШапки.ОстатокНаНачало < 0,
		Формат(-ВыборкаШапки.ОстатокНаНачало, "ЧДЦ=2; ЧРД=.; ЧГ=0"), "0.00"));
	ТаблицаXDTO.ИтогТабл.Добавить(СтрокаИтоговXDTO);
	
	// Обороты за период.
	ИтогДебет  = ТаблицаРасшифровки.Итог("Дебет");
	ИтогКредит = ТаблицаРасшифровки.Итог("Кредит");
	СтрокаИтоговXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "ИтогТабл");
	СтрокаИтоговXDTO.Установить("Дебет", Формат(ИтогДебет, "ЧДЦ=2; ЧРД=.; ЧГ=0"));
	СтрокаИтоговXDTO.Установить("Кредит", Формат(ИтогКредит, "ЧДЦ=2; ЧРД=.; ЧГ=0"));
	ТаблицаXDTO.ИтогТабл.Добавить(СтрокаИтоговXDTO);
	
	// Сальдо конечно.
	ОстатокНаКонец = ВыборкаШапки.ОстатокНаНачало + ИтогДебет - ИтогКредит;
	СтрокаИтоговXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "ИтогТабл");
	СтрокаИтоговXDTO.Установить("Дата", Формат(ВыборкаШапки.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	СтрокаИтоговXDTO.Установить("Дебет", ?(ОстатокНаКонец > 0,
		Формат(ОстатокНаКонец, "ЧДЦ=2; ЧРД=.; ЧГ=0"), "0.00"));
	СтрокаИтоговXDTO.Установить("Кредит", ?(ОстатокНаКонец < 0,
		Формат(-ОстатокНаКонец, "ЧДЦ=2; ЧРД=.; ЧГ=0"), "0.00"));
	ТаблицаXDTO.ИтогТабл.Добавить(СтрокаИтоговXDTO);
	
	ДокументXDTO.Таблица.Добавить(ТаблицаXDTO);
	
	ФайлXDTO.Установить("Документ", ДокументXDTO);
	
	ФайлXDTO.Проверить();
	
	ПотокВПамяти = Новый ПотокВПамяти;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьПоток(ПотокВПамяти);
	ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ФайлXDTO);
	ЗаписьXML.Закрыть();
	
	ПотокВПамяти.Перейти(0, ПозицияВПотоке.Начало);
	
	ЧтениеТекста = Новый ЧтениеТекста(ПотокВПамяти, КодировкаТекста.UTF8);
	Текст = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	ПотокВПамяти.Закрыть();
	
	Текст = СтрЗаменить(Текст, "xmlns=""ON_ACCOUNTS""", "");
	
	ПотокВПамяти = Новый ПотокВПамяти;
	
	ЗаписьТекста = Новый ЗаписьТекста(ПотокВПамяти, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(Текст);
	ЗаписьТекста.Закрыть();
	
	// Заполнение сведений о сформированном электронном документе.
	РезультатФормирования.ДанныеФайла = ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
	РезультатФормирования.ИмяФайла    = ИмяФайла;
	РезультатФормирования.Расширение  = "xml";
	РезультатФормирования.НомерДокументаОтправителя = ВыборкаШапки.НомерЭД;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьТабличныйДокументПрикладногоЭлектронногоДокумента.
Процедура ПриЗаполненииТабличногоДокументаИзФайлаПрикладногоЭлектронногоДокумента(ТабличныйДокумент, ДанныеФайла, ПараметрыЗаполнения) Экспорт
	
	Если ПараметрыЗаполнения.ВидЭлектронногоДокумента <>
		Перечисления._ДемоПрикладныеТипыЭлектронныхДокументов._ДемоАктСверкиВзаиморасчетов Тогда
		Возврат;
	КонецЕсли;
		
	Поток = ДанныеФайла.ОткрытьПотокДляЧтения();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьПоток(Поток);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	ЧтениеXML.Закрыть();
	Поток.Закрыть();
	
	ДокументDOM.ЭлементДокумента.УстановитьСоответствиеПространстваИмен("", "ON_ACCOUNTS");
	
	Поток = Новый ПотокВПамяти;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьПоток(Поток);
	
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
	ЗаписьXML.Закрыть();
	
	Поток.Перейти(0, ПозицияВПотоке.Начало);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьПоток(Поток);
	
	ФайлXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ФабрикаXDTO.Тип("ON_ACCOUNTS", "Файл"));
	
	ЧтениеXML.Закрыть();
	Поток.Закрыть();
	
	ДокументXDTO = ФайлXDTO.Документ;
	
	Если ПараметрыЗаполнения.ЭлектронныеПодписи.Количество() Тогда
		
		ПодписьОтправителя = Неопределено;
		ПодписьПолучателя  = Неопределено;
		Для Каждого Подпись Из ПараметрыЗаполнения.ЭлектронныеПодписи Цикл
			Если Подпись.ОтветнаяПодпись Тогда
				ПодписьПолучателя = Подпись;
			Иначе
				ПодписьОтправителя = Подпись;
			КонецЕсли;
		КонецЦикла;
		
		Если ПодписьОтправителя <> Неопределено Тогда
			Сертификат = Новый СертификатКриптографии(ПодписьОтправителя.Сертификат.Получить());
			СвойстваСубъекта = ЭлектроннаяПодпись.СвойстваСубъектаСертификата(Сертификат);
			ФИООтправителя = СвойстваСубъекта.Фамилия + " " + СвойстваСубъекта.Имя + " " + СвойстваСубъекта.Отчество;
			ДолжностьОтправителя = СвойстваСубъекта.Должность;
			ТекстЭлектроннаяПодписьОтправителя = НСтр("ru='электронная подпись'");
		КонецЕсли;
		
		Если ПодписьПолучателя <> Неопределено Тогда
			Сертификат = Новый СертификатКриптографии(ПодписьПолучателя.Сертификат.Получить());
			СвойстваСубъекта = ЭлектроннаяПодпись.СвойстваСубъектаСертификата(Сертификат);
			ФИОПолучателя = СвойстваСубъекта.Фамилия + " " + СвойстваСубъекта.Имя + " " + СвойстваСубъекта.Отчество;
			ДолжностьПолучателя = СвойстваСубъекта.Должность;
			ТекстЭлектроннаяПодписьПолучателя = НСтр("ru='электронная подпись'");
		КонецЕсли;
		
	Иначе
		ФИООтправителя = "";
		ДолжностьОтправителя = "";
		ТекстЭлектроннаяПодписьОтправителя = "";
		
		ФИОПолучателя = "";
		ДолжностьПолучателя = "";
		ТекстЭлектроннаяПодписьПолучателя = "";
	КонецЕсли;
	
	Макет = Документы._ДемоАктСверкиВзаиморасчетов.ПолучитьМакет("АктСверки");
	Макет.КодЯзыка = Метаданные.Языки.Русский.КодЯзыка; 
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	
	ДатаДокумента = СтроковыеФункцииКлиентСервер.СтрокаВДату(ДокументXDTO.Дата);
	ТекстЗаголовка = СтрШаблон(НСтр("ru='Акт сверки взаимных расчетов №%1 от %2'"),
		ДокументXDTO.Номер, Формат(ДатаДокумента, "ДЛФ=ДД"));
	ОбластьЗаголовок.Параметры.ТекстЗаголовка = ТекстЗаголовка;
	
	Период = СтрРазделить(ДокументXDTO.Получить("Период/Продолж"), "-", Ложь);
	Если Период.Количество() = 1 Тогда
		ПредставлениеПериода = СтрШаблон(НСтр("ru = 'по состоянию на %1'"),
			Формат(СтроковыеФункцииКлиентСервер.СтрокаВДату(Период[0]), "ДЛФ=ДД"),);
	Иначе
		ПредставлениеПериода = СтрШаблон(НСтр("ru = 'В период с %1 по %2'"),
			Формат(СтроковыеФункцииКлиентСервер.СтрокаВДату(Период[0]), "ДЛФ=ДД"),
			Формат(СтроковыеФункцииКлиентСервер.СтрокаВДату(Период[1]), "ДЛФ=ДД"));
	КонецЕсли;
	ОбластьЗаголовок.Параметры.ПредставлениеПериода = ПредставлениеПериода;
	
	ПредставлениеОтправителя = ДокументXDTO.Получить("Участник[Роль='Отправитель']/Наим");
	ПредставлениеПолучателя  = ДокументXDTO.Получить("Участник[Роль='Получатель']/Наим");
	
	ОбластьЗаголовок.Параметры.ПредставлениеОтправителя = ПредставлениеОтправителя;
	Если ДокументXDTO.Получить("Участник[Роль='Отправитель']/СвЮЛ") <> Неопределено Тогда
		ОбластьЗаголовок.Параметры.ФИООтправителя = ФИООтправителя;
		ОбластьЗаголовок.Параметры.ДолжностьОтправителя = ДолжностьОтправителя;
	КонецЕсли;
	
	ОбластьЗаголовок.Параметры.ПредставлениеПолучателя  = ПредставлениеПолучателя;
	Если ДокументXDTO.Получить("Участник[Роль='Получатель']/СвЮЛ") <> Неопределено Тогда
		ОбластьЗаголовок.Параметры.ФИОПолучателя = ФИОПолучателя;
		ОбластьЗаголовок.Параметры.ДолжностьПолучателя = ДолжностьПолучателя;
	КонецЕсли;
	
	Если ДокументXDTO.Основание <> Неопределено Тогда
		ДатаДоговора = СтроковыеФункцииКлиентСервер.СтрокаВДату(ДокументXDTO.Основание.Дата);
		ОбластьЗаголовок.Параметры.ПредставлениеДоговора = СтрШаблон(НСтр("ru = 'по договору %1 № %2 от %3'"),
			ДокументXDTO.Основание.Наим, ДокументXDTO.Основание.Номер, Формат(ДатаДоговора, "ДЛФ=ДД"));
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовок);
	
	ИтогиВзаиморасчетов = Новый ТаблицаЗначений;
	ИтогиВзаиморасчетов.Колонки.Добавить("Дата",  Новый ОписаниеТипов("Дата"));
	ИтогиВзаиморасчетов.Колонки.Добавить("Дебет",  Новый ОписаниеТипов("Число"));
	ИтогиВзаиморасчетов.Колонки.Добавить("Кредит", Новый ОписаниеТипов("Число"));
	
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицыРасчеты");
	ОбластьШапкаТаблицы.Параметры.ПредставлениеОтправителя = ПредставлениеОтправителя;
	ОбластьШапкаТаблицы.Параметры.ПредставлениеПолучателя  = ПредставлениеПолучателя;
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
	
	Для Каждого СтрокаИтоговXDTO Из ДокументXDTO.Таблица[0].ИтогТабл Цикл
		Если СтрокаИтоговXDTO.Дата = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ИтогиВзаиморасчетов.Добавить();
		НоваяСтрока.Дата = СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрокаИтоговXDTO.Дата);
		НоваяСтрока.Дебет = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(СтрокаИтоговXDTO.Дебет);
		НоваяСтрока.Кредит = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(СтрокаИтоговXDTO.Кредит);
	КонецЦикла;
	
	ИтогиВзаиморасчетов.Сортировать("Дата");
	
	ОбластьНачальныйОстаток = Макет.ПолучитьОбласть("СтрокаТаблицыРасчетыНачОстаток");
	СтрокаНачальныйОстаток = ИтогиВзаиморасчетов[0];
	ОбластьНачальныйОстаток.Параметры.НачалоПериодаСверки  = Формат(СтрокаНачальныйОстаток.Дата, "ДЛФ=ДД");
	ОбластьНачальныйОстаток.Параметры.СуммаДолгПолучателя  = СтрокаНачальныйОстаток.Дебет;
	ОбластьНачальныйОстаток.Параметры.СуммаДолгОтправителя = СтрокаНачальныйОстаток.Кредит;
	ТабличныйДокумент.Вывести(ОбластьНачальныйОстаток);
	
	ОбластьРасчеты = Макет.ПолучитьОбласть("СтрокаТаблицыРасчеты");
	
	Для Каждого СтрокаРасчетовXDTO Из ДокументXDTO.Таблица[0].СтрТабл Цикл
		ДатаРасчетов = СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрокаРасчетовXDTO.Получить("Основание/Дата"));
		ОбластьРасчеты.Параметры.Дата = Формат(ДатаРасчетов, "ДЛФ=ДД");
		ОбластьРасчеты.Параметры.Документ = СтрокаРасчетовXDTO.Наим + " " + СтрШаблон(НСтр("ru = '№%1 от %2'"),
			СтрокаРасчетовXDTO.Получить("Основание/Номер"), Формат(ДатаРасчетов, "ДЛФ=ДД"));
		Дебет = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(СтрокаРасчетовXDTO.Дебет);
		Кредит = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(СтрокаРасчетовXDTO.Кредит);
		ОбластьРасчеты.Параметры.ОтКого = ?(ЗначениеЗаполнено(Дебет), ПредставлениеОтправителя, ПредставлениеПолучателя);
		ОбластьРасчеты.Параметры.СуммаДолгПолучателя  = Дебет;
		ОбластьРасчеты.Параметры.СуммаДолгОтправителя = Кредит;
		ТабличныйДокумент.Вывести(ОбластьРасчеты);
	КонецЦикла;
	
	ОбластьКонечныйОстаток = Макет.ПолучитьОбласть("СтрокаТаблицыРасчетыКонОстаток");
	СтрокаКонечныйОстаток = ИтогиВзаиморасчетов[ИтогиВзаиморасчетов.Количество() - 1];
	ОбластьКонечныйОстаток.Параметры.КонецПериодаСверки   = Формат(СтрокаКонечныйОстаток.Дата, "ДЛФ=ДД");
	ОбластьКонечныйОстаток.Параметры.СуммаДолгПолучателя  = СтрокаКонечныйОстаток.Дебет;
	ОбластьКонечныйОстаток.Параметры.СуммаДолгОтправителя = СтрокаКонечныйОстаток.Кредит;
	ТабличныйДокумент.Вывести(ОбластьКонечныйОстаток);
	
	Если СтрокаКонечныйОстаток.Дебет = 0 И СтрокаКонечныйОстаток.Кредит = 0 Тогда
		ОбластьЗаголовокЗадолженность = Макет.ПолучитьОбласть("ЗаголовокЗадолженностьОтсутствует");
		ОбластьЗаголовокЗадолженность.Параметры.КонецПериодаСверки = Формат(СтрокаКонечныйОстаток.Дата, "ДЛФ=ДД");
		ТабличныйДокумент.Вывести(ОбластьЗаголовокЗадолженность);
	Иначе
		ОбластьЗаголовокЗадолженность = Макет.ПолучитьОбласть("ЗаголовокЗадолженность");
		ОбластьЗаголовокЗадолженность.Параметры.КонецПериодаСверки = Формат(СтрокаКонечныйОстаток.Дата, "ДЛФ=ДД");
		ТабличныйДокумент.Вывести(ОбластьЗаголовокЗадолженность);
		
		ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
		
		ОбластьСтрокаЗадолженность = Макет.ПолучитьОбласть("СтрокаЗадолженность");
		Если СтрокаКонечныйОстаток.Дебет > 0 Тогда
			Дебитор = ПредставлениеПолучателя;
			Сумма = СтрокаКонечныйОстаток.Дебет;
		Иначе
			Дебитор = ПредставлениеОтправителя;
			Сумма = СтрокаКонечныйОстаток.Кредит;
		КонецЕсли;
		ОбластьСтрокаЗадолженность.Параметры.Дебитор = Дебитор;
		ОбластьСтрокаЗадолженность.Параметры.Валюта = Строка(ВалютаРегламентированногоУчета);
		ОбластьСтрокаЗадолженность.Параметры.Сумма = Сумма;
		КодВалюты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВалютаРегламентированногоУчета, "Код");
		ОбменСКонтрагентамиКЭДО.СуммаПрописью(Сумма, КодВалюты, ОбластьСтрокаЗадолженность.Параметры.СуммаПрописью);
		ТабличныйДокумент.Вывести(ОбластьСтрокаЗадолженность);
	КонецЕсли;
	
	ОбластьЗаголовокРасхождения = Макет.ПолучитьОбласть("ЗаголовокРасхождения");
	ТабличныйДокумент.Вывести(ОбластьЗаголовокРасхождения);
	
	ОбластьПодписи = Макет.ПолучитьОбласть("Подписи");
	
	Отправитель = ДокументXDTO.Получить("Участник[Роль='Отправитель']");
	Если Отправитель.СвЮЛ <> Неопределено Тогда
		ПредставлениеОтправителя = СтрШаблон(НСтр("ru = '%1, ИНН %2, КПП %3'"),
			ПредставлениеОтправителя, Отправитель.СвЮЛ.ИНН, Отправитель.СвЮЛ.КПП);
	ИначеЕсли Отправитель.СвФЛ <> Неопределено Тогда
		ПредставлениеОтправителя = СтрШаблон(НСтр("ru = '%1, ИНН %2'"), ПредставлениеОтправителя, Отправитель.СвФЛ.ИНН);
	КонецЕсли;
	
	Если Отправитель.Адрес.Количество() Тогда
		ПредставлениеОтправителя = ПредставлениеОтправителя + ", " + ПредставлениеАдресаАктаСверки(Отправитель.Адрес[0]);
	КонецЕсли;
	
	ОбластьПодписи.Параметры.ПредставлениеОтправителя = ПредставлениеОтправителя;
	
	Получатель = ДокументXDTO.Получить("Участник[Роль='Получатель']");
	Если Получатель.СвЮЛ <> Неопределено Тогда
		ПредставлениеПолучателя = СтрШаблон(НСтр("ru = '%1, ИНН %2, КПП %3'"),
			ПредставлениеПолучателя, Получатель.СвЮЛ.ИНН, Получатель.СвЮЛ.КПП);
	ИначеЕсли Получатель.СвФЛ <> Неопределено Тогда
		ПредставлениеПолучателя = СтрШаблон(НСтр("ru = '%1, ИНН %2'"), ПредставлениеПолучателя, Получатель.СвФЛ.ИНН);
	КонецЕсли;
	
	Если Получатель.Адрес.Количество() Тогда
		ПредставлениеПолучателя = ПредставлениеПолучателя + ", " + ПредставлениеАдресаАктаСверки(Получатель.Адрес[0]);
	КонецЕсли;
	
	ОбластьПодписи.Параметры.ПредставлениеПолучателя = ПредставлениеПолучателя;
	
	ОбластьПодписи.Параметры.ФИООтправителя = ФИООтправителя;
	ОбластьПодписи.Параметры.ДолжностьОтправителя = ДолжностьОтправителя;
	ОбластьПодписи.Параметры.ЭлектроннаяПодписьОтправителя = ТекстЭлектроннаяПодписьОтправителя;
	
	ОбластьПодписи.Параметры.ФИОПолучателя = ФИОПолучателя;
	ОбластьПодписи.Параметры.ДолжностьПолучателя = ДолжностьПолучателя;
	ОбластьПодписи.Параметры.ЭлектроннаяПодписьПолучателя = ТекстЭлектроннаяПодписьПолучателя;
	
	ТабличныйДокумент.Вывести(ОбластьПодписи);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ОпределитьПараметрыФайлаПрикладногоЭлектронногоДокумента.
Процедура ПриОпределенииПараметровФайлаПрикладногоЭлектронногоДокумента(ДанныеФайла, РасширениеФайла, Параметры) Экспорт
	
	Если РасширениеФайла <> "xml" Тогда
		Возврат;
	КонецЕсли;
	
	Поток = ДанныеФайла.ОткрытьПотокДляЧтения();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьПоток(Поток);
	
	Попытка
		ЧтениеXML.Прочитать();
	Исключение
		ЧтениеXML.Закрыть();
		Поток.Закрыть();
		
		ВидОперации = НСтр("ru = 'Чтение данных из содержания XML по данным прикладного решения.'");
		ПредставлениеОшибкиПодробное = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбработкаНеисправностейБЭД.ОбработатьОшибку(ВидОперации, 
			ОбщегоНазначенияБЭДКлиентСервер.ПодсистемыБЭД().ОбменСКонтрагентами, ПредставлениеОшибкиПодробное);
			
		Возврат;
	КонецПопытки;
	
	Если ЧтениеXML.Имя = "Файл" И ЧтениеXML.ПолучитьАтрибут("ИдФорм") = "ЭДОАктСверки" Тогда
		
		Параметры.ТипЭлектронногоДокумента = Перечисления._ДемоПрикладныеТипыЭлектронныхДокументов._ДемоАктСверкиВзаиморасчетов;
		Параметры.НаименованиеДокументаОтправителя = Метаданные.Документы._ДемоАктСверкиВзаиморасчетов.Синоним;
		
		Если ЧтениеXML.Прочитать() И ЧтениеXML.Имя = "Документ" Тогда
			Параметры.НомерДокументаОтправителя = ЧтениеXML.ПолучитьАтрибут("Номер");
			Параметры.ДатаДокументаОтправителя  = СтроковыеФункцииКлиентСервер.СтрокаВДату(ЧтениеXML.ПолучитьАтрибут("Дата"));
			
			Пока ЧтениеXML.Прочитать() Цикл
				Если ЧтениеXML.Имя = "Участник"
					И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
						
					Если ЧтениеXML.ПолучитьАтрибут("Роль") = "Отправитель" Тогда
						СведенияОбОтправителе = Параметры.Отправитель;
						Если ЧтениеXML.Прочитать() И ЧтениеXML.Имя = "СвЮЛ" Тогда
							СведенияОбОтправителе.Наименование = ЧтениеXML.ПолучитьАтрибут("Наим");
							СведенияОбОтправителе.ИНН = ЧтениеXML.ПолучитьАтрибут("ИНН");
							СведенияОбОтправителе.КПП = ЧтениеXML.ПолучитьАтрибут("КПП");
						КонецЕсли;
					КонецЕсли;
					
					Если ЧтениеXML.ПолучитьАтрибут("Роль") = "Получатель" Тогда
						СведенияОПолучателе = Параметры.Получатель;
						Если ЧтениеXML.Прочитать() И ЧтениеXML.Имя = "СвЮЛ" Тогда
							СведенияОПолучателе.Наименование = ЧтениеXML.ПолучитьАтрибут("Наим");
							СведенияОПолучателе.ИНН = ЧтениеXML.ПолучитьАтрибут("ИНН");
							СведенияОПолучателе.КПП = ЧтениеXML.ПолучитьАтрибут("КПП");
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	ЧтениеXML.Закрыть();
	Поток.Закрыть();
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеЭлектронногоДокументаСНоменклатурой.
Процедура ПриОтраженииВУчетеЭлектронногоДокументаСНоменклатурой(Документ, Настройки) Экспорт
	
	Если Документ.СпособОбработки = "_ДемоАктСверкиВзаиморасчетов" Тогда
		Настройки.ОтражатьТолькоСопоставленные = Ложь;
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриСозданииОбъектовУчетаИзФайлаПрикладногоЭлектронногоДокумента.
Процедура ПриСозданииОбъектовУчетаИзФайлаПрикладногоЭлектронногоДокумента(ПараметрыФайлаЭлектронногоДокумента, СсылкиНаОбъекты) Экспорт
	
	Если ПараметрыФайлаЭлектронногоДокумента.СпособОбработки <> "_ДемоАктСверкиВзаиморасчетов" Тогда // СпособОбработки см. СписокОперацийВидаЭД.
		Возврат;
	КонецЕсли;
	
	Поток = ПараметрыФайлаЭлектронногоДокумента.ДанныеФайла.ОткрытьПотокДляЧтения();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьПоток(Поток);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	ЧтениеXML.Закрыть();
	Поток.Закрыть();
	
	ДокументDOM.ЭлементДокумента.УстановитьСоответствиеПространстваИмен("", "ON_ACCOUNTS");
	
	Поток = Новый ПотокВПамяти;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьПоток(Поток);
	
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
	ЗаписьXML.Закрыть();
	
	Поток.Перейти(0, ПозицияВПотоке.Начало);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьПоток(Поток);
	
	ФайлXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ФабрикаXDTO.Тип("ON_ACCOUNTS", "Файл"));
	
	ЧтениеXML.Закрыть();
	Поток.Закрыть();
	
	ДокументXDTO = ФайлXDTO.Документ;
	
	Если ЗначениеЗаполнено(СсылкиНаОбъекты) Тогда
		ДокументОбъект = СсылкиНаОбъекты[0].ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы._ДемоАктСверкиВзаиморасчетов.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.УстановитьНовыйНомер();
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	ДокументОбъект.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	ДокументОбъект.ПоДаннымКонтрагента = ПараметрыФайлаЭлектронногоДокумента.Входящий;
	ДокументОбъект.НомерЭД = ДокументXDTO.Номер;
	ДокументОбъект.ДатаЭД = СтроковыеФункцииКлиентСервер.СтрокаВДату(ДокументXDTO.Дата);
	
	Контрагент = Неопределено;
	РольКонтрагента = ?(ПараметрыФайлаЭлектронногоДокумента.Входящий, "Отправитель", "Получатель");
	УчастникXDTO = ДокументXDTO.Получить(СтрШаблон("Участник[Роль='%1']",РольКонтрагента));
	Если УчастникXDTO.СвЮЛ <> Неопределено Тогда
		ИНН = УчастникXDTO.СвЮЛ.ИНН;
		КПП = УчастникXDTO.СвЮЛ.КПП;
	ИначеЕсли УчастникXDTO.СвФЛ <> Неопределено Тогда
		ИНН = УчастникXDTO.СвФЛ.ИНН;
		КПП = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		Запрос = Новый Запрос();
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Контрагенты.Ссылка
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.ИНН = &ИНН
			|	И Контрагенты.КПП = &КПП
			|	И НЕ Контрагенты.ПометкаУдаления";
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Запрос.УстановитьПараметр("КПП", КПП);
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Контрагент = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект.Контрагент = Контрагент;
	
	Организация = Неопределено;
	РольОрганизации = ?(ПараметрыФайлаЭлектронногоДокумента.Входящий, "Получатель", "Отправитель");
	УчастникXDTO = ДокументXDTO.Получить(СтрШаблон("Участник[Роль='%1']", РольОрганизации));
	Если УчастникXDTO.СвЮЛ <> Неопределено Тогда
		ИНН = УчастникXDTO.СвЮЛ.ИНН;
		КПП = УчастникXDTO.СвЮЛ.КПП;
	ИначеЕсли УчастникXDTO.СвФЛ <> Неопределено Тогда
		ИНН = УчастникXDTO.СвФЛ.ИНН;
		КПП = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		Запрос = Новый Запрос();
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Организации.Ссылка
			|ИЗ
			|	Справочник.Организации КАК Организации
			|ГДЕ
			|	Организации.ИНН = &ИНН
			|	И Организации.КПП = &КПП
			|	И НЕ Организации.ПометкаУдаления";
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Запрос.УстановитьПараметр("КПП", КПП);
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Организация = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект.Организация = Организация;
	
	ДоговорКонтрагента = Неопределено;
	Если ДокументXDTO.Основание <> Неопределено
		И ЗначениеЗаполнено(Контрагент) И ЗначениеЗаполнено(Организация) Тогда
		
		НомерДоговора = ДокументXDTO.Основание.Номер;
		ДатаДоговора  = СтроковыеФункцииКлиентСервер.СтрокаВДату(ДокументXDTO.Основание.Дата);
		
		Запрос = Новый Запрос();
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Договоры.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ДоговорыКонтрагентов КАК Договоры
			|ГДЕ
			|	Договоры.Владелец = &Контрагент
			|	И Договоры.Организация = &Организация
			|	И Договоры.НомерДоговора = &НомерДоговора
			|	И Договоры.ДатаДоговора = &ДатаДоговора
			|	И НЕ Договоры.ПометкаУдаления";
		Запрос.УстановитьПараметр("Контрагент",    Контрагент);
		Запрос.УстановитьПараметр("Организация",   Организация);
		Запрос.УстановитьПараметр("НомерДоговора", НомерДоговора);
		Запрос.УстановитьПараметр("ДатаДоговора",  ДатаДоговора);
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			ДоговорКонтрагента = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект.ДоговорКонтрагента = ДоговорКонтрагента;
	
	Период = СтрРазделить(ДокументXDTO.Получить("Период/Продолж"), "-", Ложь);
	Если НЕ ЗначениеЗаполнено(Период) Тогда
		ДокументОбъект.ДатаНачала = '00010101';
		ДокументОбъект.ДатаОкончания = '00010101';
	ИначеЕсли Период.Количество() = 1 Тогда
		ДокументОбъект.ДатаНачала = '00010101';
		ДокументОбъект.ДатаОкончания = СтроковыеФункцииКлиентСервер.СтрокаВДату(Период[0]);
	Иначе
		ДокументОбъект.ДатаНачала = СтроковыеФункцииКлиентСервер.СтрокаВДату(Период[0]);
		ДокументОбъект.ДатаОкончания = СтроковыеФункцииКлиентСервер.СтрокаВДату(Период[1]);
	КонецЕсли;
	
	ИтогиВзаиморасчетов = Новый ТаблицаЗначений;
	ИтогиВзаиморасчетов.Колонки.Добавить("Дата",   Новый ОписаниеТипов("Дата"));
	ИтогиВзаиморасчетов.Колонки.Добавить("Дебет",  Новый ОписаниеТипов("Число"));
	ИтогиВзаиморасчетов.Колонки.Добавить("Кредит", Новый ОписаниеТипов("Число"));
	
	Для Каждого СтрокаИтоговXDTO Из ДокументXDTO.Таблица[0].ИтогТабл Цикл
		Если СтрокаИтоговXDTO.Дата = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ИтогиВзаиморасчетов.Добавить();
		НоваяСтрока.Дата = СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрокаИтоговXDTO.Дата);
		НоваяСтрока.Дебет = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(СтрокаИтоговXDTO.Дебет);
		НоваяСтрока.Кредит = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(СтрокаИтоговXDTO.Кредит);
	КонецЦикла;
	
	Если ИтогиВзаиморасчетов.Количество() Тогда
		ИтогиВзаиморасчетов.Сортировать("Дата");
		ДокументОбъект.ОстатокНаНачало = ИтогиВзаиморасчетов[0].Дебет - ИтогиВзаиморасчетов[0].Кредит;
	КонецЕсли;
	
	ДокументОбъект.Расшифровка.Очистить();
	
	Для Каждого СтрокаРасчетовXDTO Из ДокументXDTO.Таблица[0].СтрТабл Цикл
		НоваяСтрока = ДокументОбъект.Расшифровка.Добавить();
		НоваяСтрока.Номер = СтрокаРасчетовXDTO.Получить("Основание/Номер");
		НоваяСтрока.Дата  = СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрокаРасчетовXDTO.Получить("Основание/Дата"));
		НоваяСтрока.НаименованиеДокумента = СтрокаРасчетовXDTO.Наим;
		НоваяСтрока.Примечание = СтрокаРасчетовXDTO.Примечание;
		НоваяСтрока.Дебет  = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(СтрокаРасчетовXDTO.Дебет);
		НоваяСтрока.Кредит = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(СтрокаРасчетовXDTO.Кредит);
	КонецЦикла;
	
	ЗаписатьДокумент(ДокументОбъект);
	
	СсылкиНаОбъекты.Добавить(ДокументОбъект.Ссылка);
	
КонецПроцедуры

#КонецОбласти

#Область Диагностика

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииОбъектовМетаданныхСПоддержкойДиагностикиОшибок.
Процедура ПриОпределенииОбъектовМетаданныхСПоддержкойДиагностикиОшибок(СписокЭлементов) Экспорт
	
	СписокЭлементов.Добавить(Метаданные.Документы._ДемоАктСверкиВзаиморасчетов);
	СписокЭлементов.Добавить(Метаданные.Документы._ДемоОперация);
	СписокЭлементов.Добавить(Метаданные.Документы._ДемоПередачаТоваровМеждуОрганизациями);
	СписокЭлементов.Добавить(Метаданные.Документы._ДемоОтчетКомитенту);
	
КонецПроцедуры

#КонецОбласти

#Область ПрямойОбмен

// См. ОбменСКонтрагентамиПереопределяемый.ИспользоватьПрямойОбмен.
Процедура ИспользоватьПрямойОбмен(Использовать) Экспорт
	
	Использовать = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ВнутренниеДокументы

// См. ОбменСКонтрагентамиПереопределяемый.ВключатьФункциональнуюОпциюИспользоватьВнутренниеДокументыЭДО.
Процедура ВключатьФункциональнуюОпциюИспользоватьВнутренниеДокументыЭДО(Включать) Экспорт
	
	Включать = Истина;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.РазрешеноИспользоватьВнутреннийЭДО
Процедура РазрешеноИспользоватьВнутреннийЭДО(Использовать) Экспорт
	
	Использовать = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область QRКоды

// См. БизнесСетьПереопределяемый.СформироватьПредставлениеПрикладногоДокументаСQRКодом
Процедура СформироватьПредставлениеПрикладногоДокументаСQRКодом(Знач СсылкаНаДокумент, Знач ВидЭД, Знач ДанныеQRКодовПоДокументам, ПечатнаяФорма) Экспорт
	
	ОбъектыПечати = Новый СписокЗначений;
	СсылкиНаДокументы = Новый Массив();
	СсылкиНаДокументы.Добавить(СсылкаНаДокумент);
	
	Если ВидЭД = Перечисления.ТипыДокументовЭДО.ТоварнаяНакладная Тогда
	
		ПечатнаяФорма = Документы.РеализацияТоваровУслуг.СформироватьТоварнуюНакладную(СсылкиНаДокументы, ОбъектыПечати, ДанныеQRКодовПоДокументам);
	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// _Демо начало примера

#Область ДокументПредприятия

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеПоДокументуПредприятия.
Процедура ЗаполнитьДанныеПоДокументуПредприятия(СсылкаНаОбъект, КонструкторЭД, Отказ) Экспорт

	Данные = Справочники.ДоговорыКонтрагентов.ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	Данные.Следующий();
	
	КонструкторЭД.ОбработчикОшибок.ПараметрыСвязиПоУмолчанию(СсылкаНаОбъект);
	
	ИнформацияДокумента = КонструкторЭД.ИнформацияДокумента(); // см. ОбработкаОбъект.ФорматДокументПредприятия
	ИнформацияДокумента.ВнешнийИдентификатор = XMLСтрока(СсылкаНаОбъект);
	ИнформацияДокумента.Дата                 = Данные.ДатаДоговора;
	ИнформацияДокумента.Номер                = Данные.НомерДоговора;
	
	Если Данные.СуммаВключаетНДС Тогда
		ИнформацияДокумента.Сумма    = Данные.Сумма;
		ИнформацияДокумента.СуммаНДС = Данные.СуммаНДС;
	Иначе
		ИнформацияДокумента.Сумма    = Данные.Сумма + Данные.СуммаНДС;
		ИнформацияДокумента.СуммаНДС = Данные.СуммаНДС;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Данные.Валюта_Код) Тогда
		ИнформацияДокумента.Валюта = КонструкторЭД.НоваяВалюта();
		ИнформацияДокумента.Валюта.Код = Данные.Валюта_Код;
		ИнформацияДокумента.Валюта.Наименование = Данные.Валюта_Наименование;
	КонецЕсли;
	
	ИнформацияДокумента.Наименование = Данные.Наименование;
	КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИнформацияДокумента, "Наименование", "Объект.Наименование", , СсылкаНаОбъект);
	
	ИнформацияДокумента.ДатаНачалаДействия    = Данные.ДатаНачалаДействия;
	ИнформацияДокумента.ДатаОкончанияДействия = Данные.ДатаОкончанияДействия;
	ИнформацияДокумента.ЯвляетсяБессрочным    = Не ЗначениеЗаполнено(Данные.ДатаОкончанияДействия) И Данные.НаличиеПролонгации = Ложь;
	ИнформацияДокумента.ФормаДокумента        = КонструкторЭД.ВидыФормДокумента().Электронная;
	
	ИнформацияДокумента.СвойстваВидаДокумента = КонструкторЭД.НовыеСвойстваВидаДокумента();
	ИнформацияДокумента.СвойстваВидаДокумента.ЯвляетсяДоговором = Истина;
	ИнформацияДокумента.СвойстваВидаДокумента.Наименование      =
		ИнтеграцияЭДОПовтИсп.ВидДоговоровКонтрагентовПеречисление(Данные.ВидДоговора);
	
	ИнформацияДокумента.Организация = КонструкторЭД.НовыеСведенияОСторонахДокумента();
	ЗаполнитьСведенияСтороныДокументаДляДокументаПредприятия(
		ИнформацияДокумента.Организация, Данные, КонструкторЭД, Данные.Организация, Данные.Организация_ЮрФизЛицо);
	
	ИнформацияДокумента.Организация.Адрес = КонструкторЭД.ЗаполнитьАдресАвтоматически(
		Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации, Данные.Организация, Данные.ДатаДоговора, КонструкторЭД);
		
	Если ЗначениеЗаполнено(Данные.Организация_БанковскийСчет_НомерСчета) Тогда
		ИнформацияДокумента.Организация.БанковскиеРеквизиты = КонструкторЭД.НовыеБанковскиеРеквизиты();
		ИнформацияДокумента.Организация.БанковскиеРеквизиты.ИНН                   = Данные.Организация_БанковскийСчет_ИНН;
		ИнформацияДокумента.Организация.БанковскиеРеквизиты.НомерСчета            = Данные.Организация_БанковскийСчет_НомерСчета;
		ИнформацияДокумента.Организация.БанковскиеРеквизиты.Наименование          = Данные.Организация_БанковскийСчет_НаименованиеБанка;
		ИнформацияДокумента.Организация.БанковскиеРеквизиты.БИК                   = Данные.Организация_БанковскийСчет_БИК;
		ИнформацияДокумента.Организация.БанковскиеРеквизиты.КорреспондентскийСчет = Данные.Организация_БанковскийСчет_КоррСчет;
		
		КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИнформацияДокумента.Организация.БанковскиеРеквизиты, "НомерСчета",
		"Объект.ОсновнойБанковскийСчет.НомерСчета", , Данные.Организация);
		КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИнформацияДокумента.Организация.БанковскиеРеквизиты, "БИК",
		"Объект.ОсновнойБанковскийСчет.Банк.Код", , Данные.Организация);
		КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИнформацияДокумента.Организация.БанковскиеРеквизиты,
		"КорреспондентскийСчет", "Объект.ОсновнойБанковскийСчет.Банк.КоррСчет", , Данные.Организация);
	КонецЕсли;
	
	Контрагент = КонструкторЭД.НовыеСведенияОСторонахДокумента();
	ЗаполнитьСведенияСтороныДокументаДляДокументаПредприятия(
		Контрагент, Данные, КонструкторЭД, Данные.Контрагент, Данные.Контрагент_ЮрФизЛицо);
		
	Если ЗначениеЗаполнено(Данные.Контрагент_БанковскийСчет_НомерСчета) Тогда
		Контрагент.БанковскиеРеквизиты = КонструкторЭД.НовыеБанковскиеРеквизиты();
		Контрагент.БанковскиеРеквизиты.ИНН                   = Данные.Контрагент_БанковскийСчет_ИНН;
		Контрагент.БанковскиеРеквизиты.НомерСчета            = Данные.Контрагент_БанковскийСчет_НомерСчета;
		Контрагент.БанковскиеРеквизиты.Наименование          = Данные.Контрагент_БанковскийСчет_НаименованиеБанка;
		Контрагент.БанковскиеРеквизиты.БИК                   = Данные.Контрагент_БанковскийСчет_БИК;
		Контрагент.БанковскиеРеквизиты.КорреспондентскийСчет = Данные.Контрагент_БанковскийСчет_КоррСчет;
		
		КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(Контрагент.БанковскиеРеквизиты, "НомерСчета",
			"Объект.ОсновнойБанковскийСчет.НомерСчета", , Данные.Контрагент);
		КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(Контрагент.БанковскиеРеквизиты, "БИК",
			"Объект.ОсновнойБанковскийСчет.Банк.Код", , Данные.Контрагент);
		КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(Контрагент.БанковскиеРеквизиты,
			"КорреспондентскийСчет", "Объект.ОсновнойБанковскийСчет.Банк.КоррСчет", , Данные.Контрагент);
	КонецЕсли;
	
	Контрагент.Адрес = КонструкторЭД.ЗаполнитьАдресАвтоматически(
		Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента, Данные.Контрагент, Данные.ДатаДоговора, КонструкторЭД);

	ИнформацияДокумента.Контрагент.Добавить(Контрагент);
	КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИнформацияДокумента.Контрагент[0], "Контрагент", "Объект.Владелец");
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДокументаПредприятия.
Процедура ПриОтраженииВУчетеДокументаПредприятия(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	ИнформацияДокумента = ДанныеЭлектронногоДокумента.ИнформацияДокумента[0];
	
	ОбъектУчета = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	ОбъектУчета.ДатаДоговора  = ИнформацияДокумента.Дата;
	ОбъектУчета.НомерДоговора = ИнформацияДокумента.Номер;
	ОбъектУчета.Наименование  = ИнформацияДокумента.Наименование;
	ОбъектУчета.Сумма         = ИнформацияДокумента.Сумма;
	ОбъектУчета.СуммаНДС      = ИнформацияДокумента.СуммаНДС;
	
	ОбъектУчета.ДатаНачалаДействия    = ИнформацияДокумента.ДатаНачалаДействия;
	ОбъектУчета.ДатаОкончанияДействия = ИнформацияДокумента.ДатаОкончанияДействия;
	
	НаименованиеВидаДокумента = ИнформацияДокумента.СвойстваВидаДокумента.Наименование;
	ВидыДоговоров             = Новый Соответствие;
	
	Если ВидыДоговоров[НаименованиеВидаДокумента] = Неопределено Тогда
		ОбъектУчета.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Прочее;
	Иначе
		ОбъектУчета.ВидДоговора = ВидыДоговоров[НаименованиеВидаДокумента];
	КонецЕсли;
	
	ОбъектУчета.Организация = СторонаДокументаПоДаннымДокументПредприятия(
		ИнформацияДокумента.Контрагент[0].ИдентификационныеСведения, "Организация");
	ОбъектУчета.Владелец = СторонаДокументаПоДаннымДокументПредприятия(
		ИнформацияДокумента.Организация.ИдентификационныеСведения, "Контрагент");

	Если ЗначениеЗаполнено(ИнформацияДокумента.Валюта) Тогда
		ОбъектУчета.ВалютаРасчетов = Справочники.Валюты.НайтиПоКоду(ИнформацияДокумента.Валюта.Код);
		Если Не ЗначениеЗаполнено(ОбъектУчета.ВалютаРасчетов) Тогда
			ОбъектУчета.ВалютаРасчетов = Константы.ВалютаРегламентированногоУчета.Получить();
		КонецЕсли;
	КонецЕсли;
	
	ОбъектУчета.ОбменДанными.Загрузка = Истина;
	ОбъектУчета.Записать();
	
	РезультатОтраженияВУчете.ДокументыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОбъектУчета.Ссылка);

КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииОбработчикаПриОтраженииЭлектронногоДокумента
Процедура ПриОпределенииОбработчикаПриОтраженииЭлектронногоДокумента(ОбработчикиОтражения) Экспорт
	
