// Методы, переопределяющие поведение библиотеки БЭД.

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьПараметрыЭДПоИсточнику.
Процедура ЗаполнитьПараметрыЭДПоИсточнику(Источник, ПараметрыЭлектронногоДокумента) Экспорт 
	
	ТипыДокументов        = ОбменСКонтрагентами.ТипыДокументов();
	НаправленияДокументов = ОбменСКонтрагентами.НаправленияДокументов();
	
	ТипИсточника = ТипЗнч(Источник);
	ЭтоСсылка = ОбщегоНазначения.ЭтоСсылка(ТипИсточника);
	
	Если ТипИсточника = Тип("ДокументСсылка._ДемоПередачаТоваровМеждуОрганизациями")
		ИЛИ ТипИсточника = Тип("ДокументОбъект._ДемоПередачаТоваровМеждуОрганизациями") Тогда
		
		Реквизиты = "ВидЭлектронногоДокумента, Организация, ОрганизацияПолучатель";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		
		СтрокаПараметров.Тип = Источник.ВидЭлектронногоДокумента;
		Если ЗначенияРеквизитов.ВидЭлектронногоДокумента = Перечисления.ТипыДокументовЭДО.ТоварнаяНакладная Тогда
			СтрокаПараметров.Направление = НаправленияДокументов.Исходящий;
		Иначе	
			СтрокаПараметров.Направление = НаправленияДокументов.Интеркампани;
		КонецЕсли;
		СтрокаПараметров.Организация = ЗначенияРеквизитов.Организация;
		СтрокаПараметров.Контрагент  = ЗначенияРеквизитов.ОрганизацияПолучатель;
		СтрокаПараметров.ФормированиеУниверсальногоДокумента = 
			ОбменСКонтрагентами.ВариантыФормированияУниверсальныхДокументов().Запрещено;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка._ДемоОперация")
		ИЛИ ТипИсточника = Тип("ДокументОбъект._ДемоОперация") Тогда
		
		Реквизиты = "ВидЭД, Организация, Контрагент, ДоговорКонтрагента, НаправлениеЭД";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		
		СтрокаПараметров.Тип = ЗначенияРеквизитов.ВидЭД;
		СтрокаПараметров.Направление = ЗначенияРеквизитов.НаправлениеЭД;
		СтрокаПараметров.Организация   = ЗначенияРеквизитов.Организация;
		СтрокаПараметров.Контрагент    = ЗначенияРеквизитов.Контрагент;
		СтрокаПараметров.ДоговорКонтрагента = ЗначенияРеквизитов.ДоговорКонтрагента;
	
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка._ДемоАвансовыйОтчет")
		ИЛИ ТипИсточника = Тип("ДокументОбъект._ДемоАвансовыйОтчет")
		ИЛИ ТипИсточника = Тип("ДокументСсылка._ДемоРаспоряжение")
		ИЛИ ТипИсточника = Тип("ДокументОбъект._ДемоРаспоряжение")Тогда
		
		Реквизиты = "Организация";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		
		СтрокаПараметров.Тип = ТипыДокументов.Внутренний;
		СтрокаПараметров.Направление = НаправленияДокументов.Внутренний;
		СтрокаПараметров.Организация   = ЗначенияРеквизитов.Организация;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка._ДемоОтчетКомитенту")
		ИЛИ ТипИсточника = Тип("ДокументОбъект._ДемоОтчетКомитенту") Тогда
		
		Реквизиты = "ВидДокумента, Организация, Контрагент, ДоговорКонтрагента";
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		ТипДокумента = Неопределено;
		
		Если ЗначенияРеквизитов.ВидДокумента = Перечисления.ВидыДокументов.ОтчетОПродажахКомиссионногоТовара Тогда
			ТипДокумента = ТипыДокументов.ОтчетОПродажахКомиссионногоТовара;
		ИначеЕсли ЗначенияРеквизитов.ВидДокумента = Перечисления.ВидыДокументов.ОтчетОСписанииКомиссионногоТовара Тогда 
			ТипДокумента = ТипыДокументов.ОтчетОСписанииКомиссионногоТовара;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТипДокумента) Тогда
			СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
			СтрокаПараметров.Тип = ТипДокумента;
			СтрокаПараметров.Направление = НаправленияДокументов.Исходящий;
			СтрокаПараметров.Организация = ЗначенияРеквизитов.Организация;
			СтрокаПараметров.Контрагент  = ЗначенияРеквизитов.Контрагент;
			СтрокаПараметров.ДоговорКонтрагента = ЗначенияРеквизитов.ДоговорКонтрагента;
		КонецЕсли;
	
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка._ДемоОтчетКомиссионера")
		ИЛИ ТипИсточника = Тип("ДокументОбъект._ДемоОтчетКомиссионера") Тогда
		
		Реквизиты = "ВидДокумента, Организация, Контрагент, ДоговорКонтрагента";
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		ТипДокумента = Неопределено;
		
		Если ЗначенияРеквизитов.ВидДокумента = Перечисления.ВидыДокументов.ОтчетОПродажахКомиссионногоТовара Тогда
			ТипДокумента = ТипыДокументов.ОтчетОПродажахКомиссионногоТовара;
		ИначеЕсли ЗначенияРеквизитов.ВидДокумента = Перечисления.ВидыДокументов.ОтчетОСписанииКомиссионногоТовара Тогда 
			ТипДокумента = ТипыДокументов.ОтчетОСписанииКомиссионногоТовара;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТипДокумента) Тогда
			СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
			СтрокаПараметров.Тип = ТипДокумента;
			СтрокаПараметров.Направление = НаправленияДокументов.Входящий;
			СтрокаПараметров.Организация = ЗначенияРеквизитов.Организация;
			СтрокаПараметров.Контрагент  = ЗначенияРеквизитов.Контрагент;
			СтрокаПараметров.ДоговорКонтрагента = ЗначенияРеквизитов.ДоговорКонтрагента;
		КонецЕсли;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка._ДемоДоверенность")
		ИЛИ ТипИсточника = Тип("ДокументОбъект._ДемоДоверенность") Тогда
		
		Реквизиты = "Организация, Контрагент, ДоговорКонтрагента";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		СтрокаПараметров.Тип = Перечисления.ТипыДокументовЭДО.Прочее;
		СтрокаПараметров.Направление = НаправленияДокументов.Исходящий;
		СтрокаПараметров.Организация   = ЗначенияРеквизитов.Организация;
		СтрокаПараметров.Контрагент  = ЗначенияРеквизитов.Контрагент;
		СтрокаПараметров.ДоговорКонтрагента = ЗначенияРеквизитов.ДоговорКонтрагента;
	
	ИначеЕсли ТипИсточника = Тип("Структура") Тогда
		
		// Бизнес-сеть.
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПараметров, Источник);
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПолучитьСоответствиеПеречислений.
Процедура ПолучитьСоответствиеПеречислений(СоответствиеПеречислений) Экспорт
	
	СоответствиеПеречислений.Вставить("ВариантыОплатыКлиентом",   "ВариантыОплатыКлиентом");
	СоответствиеПеречислений.Вставить("ВариантыОплатыПоставщику", "ВариантыОплатыПоставщику");
	СоответствиеПеречислений.Вставить("ФормыОплаты",              "ФормыОплаты");
	СоответствиеПеречислений.Вставить("СпособРасчета",            "СпособРасчета");
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриПолученииОписанияОснованияЭлектронногоДокумента.
Процедура ПриПолученииОписанияОснованияЭлектронногоДокумента(ОснованиеОбъект, Описание, СтандартнаяОбработка) Экспорт
	
	ТипОснования = ТипЗнч(ОснованиеОбъект);
	Если ТипОснования = Тип("ДокументОбъект._ДемоПередачаТоваровМеждуОрганизациями")
		Или ТипОснования = Тип("ДокументСсылка._ДемоПередачаТоваровМеждуОрганизациями") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Описание.Организация = ОснованиеОбъект.Организация;
		Описание.Контрагент  = ОснованиеОбъект.ОрганизацияПолучатель;
		Описание.Дата  = ОснованиеОбъект.Дата;
		Описание.Номер = ОснованиеОбъект.Номер;
		Описание.СуммаДокумента = ОснованиеОбъект.СуммаДокумента;
		Описание.Вид = ОснованиеОбъект.ВидЭлектронногоДокумента;
	
	ИначеЕсли ТипОснования = Тип("ДокументОбъект._ДемоОтчетКомитенту") 
		ИЛИ ТипОснования = Тип("ДокументСсылка._ДемоОтчетКомитенту") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Описание.Организация = ОснованиеОбъект.Организация;
		Описание.Контрагент  = ОснованиеОбъект.Контрагент;
		Описание.Дата  = ОснованиеОбъект.Дата;
		Описание.Номер = ОснованиеОбъект.НомерЭД;
		Описание.СуммаДокумента = ОснованиеОбъект.СуммаДокумента;
		Описание.Вид = ОснованиеОбъект.ВидДокумента;
		
	ИначеЕсли ТипОснования = Тип("ДокументОбъект._ДемоДоверенность") 
		ИЛИ ТипОснования = Тип("ДокументСсылка._ДемоДоверенность") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Описание.Организация = ОснованиеОбъект.Организация;
		Описание.Контрагент  = ОснованиеОбъект.Контрагент;
		Описание.Дата = ОснованиеОбъект.Дата;
		Описание.Номер = ОснованиеОбъект.Номер;
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ДополнительнаяАналитикаКонтрагентовСправочникПартнеры.
Процедура ДополнительнаяАналитикаКонтрагентовСправочникПартнеры(ИспользуетсяСправочникПартнеры) Экспорт
	
	ИспользуетсяСправочникПартнеры = Истина;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПодготовитьСтруктуруОбъектовКомандЭДО.
Процедура ПодготовитьСтруктуруОбъектовКомандЭДО(СоставКомандЭДО) Экспорт
	
	СоставКомандЭДО.Исходящие.Добавить("Документ._ДемоОперация");
	СоставКомандЭДО.Исходящие.Добавить("Документ._ДемоОтчетКомитенту");
	
	СоставКомандЭДО.Входящие.Добавить("Документ._ДемоОперация");
	СоставКомандЭДО.Входящие.Добавить("Документ._ДемоОтчетКомиссионера");
	
	СоставКомандЭДО.БезПодписи.Добавить("Документ._ДемоОперация");
	СоставКомандЭДО.БезПодписи.Добавить("Документ._ДемоОтчетКомитенту");
	
	СоставКомандЭДО.БезПодписи.Добавить("Документ._ДемоПередачаТоваровМеждуОрганизациями");
	СоставКомандЭДО.Интеркампани.Добавить("Документ._ДемоПередачаТоваровМеждуОрганизациями");
	
	СоставКомандЭДО.Внутренние.Добавить("Документ._ДемоАвансовыйОтчет");
	СоставКомандЭДО.Внутренние.Добавить("Документ._ДемоРаспоряжение");
	СоставКомандЭДО.Внутренние.Добавить("ЖурналДокументов._ДемоВнутренниеДокументы");
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеПоПрайсЛисту.
Процедура ЗаполнитьДанныеПоПрайсЛисту(СсылкаНаОбъект, ДеревоДокумента, Отказ) Экспорт
	
	ЗаполнитьПрайсПоСсылкеНаОбъект(СсылкаНаОбъект, ДеревоДокумента)
	
КонецПроцедуры

#Область ОтчетКомитенту

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеПоОтчетуОСписанииКомиссионногоТовара
Процедура ЗаполнитьДанныеПоОтчетуОСписанииКомиссионногоТовара(СсылкаНаОбъект, ДеревоДокумента, Отказ) Экспорт
	
	СтруктураДанных = Документы[СсылкаНаОбъект.Метаданные().Имя].ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ДатаФормирования", ТекущаяДатаСеанса());
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "НачалоПериода", ВыборкаШапки.Дата);
	
	ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		ВыборкаШапки.ВалютаКод, "Объект.Код");
		
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Валюта", ВыборкаШапки.ВалютаКод,
		ПараметрыОбработкиОшибок);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Курс",
		РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВыборкаШапки.Валюта, ВыборкаШапки.Дата).Курс);
	
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить сумму документа. Возможные причины:
		|	- не заполнена табличная часть ""Товары""
		|	- не заполнена колонка ""Сумма""'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Сумма", ВыборкаШапки.СуммаДокумента,
		ТекстОшибки);
	
	СведенияОКомитенте = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Контрагент, СведенияОКомитенте);
	ОбменСКонтрагентамиКЭДО.ЗаполнитьДанныеУчастника(ДеревоДокумента, СведенияОКомитенте, "Комитент", Истина);
	
	СведенияОКомиссионере = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Организация, СведенияОКомиссионере);
	ОбменСКонтрагентамиКЭДО.ЗаполнитьДанныеУчастника(ДеревоДокумента, СведенияОКомиссионере, "Комиссионер", Истина);

	ОбменСКонтрагентамиКЭДО.ЗаполнитьДокументыСделки(ДеревоДокумента, ВыборкаШапки);
	
	СведенияОТоварах = НовыеСведенияОТоварахОтчетаКомитенту();
	
	ЗаполнитьТоварыОтчетаКомитенту(СведенияОТоварах, СтруктураДанных);
	
	ОбменСКонтрагентамиКЭДО.ЗаполнитьПараметрыОбработкиОшибокВТаблицеТоваровCML(СведенияОТоварах);
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДокумента, СведенияОТоварах, "Товары");
	
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить итоговые стоимостные показатели. Возможные причины:
		|	- не заполнена табличная часть ""Товары""
		|	- не заполнена колонка ""Сумма""'");
	
	СуммаПредставление = "";
	ФорматСумм(ВыборкаШапки.СуммаДокумента, СуммаПредставление, ВыборкаШапки.ВалютаКод);
	
	ИтоговаяСтрока = НСтр("ru = 'Всего списано наименований'")
		+ " "
		+ СведенияОТоварах.Количество()
		+ ?(ВыборкаШапки.СуммаДокумента <> 0, НСтр("ru = ', на сумму'") + " ", "")
		+ ?(ВыборкаШапки.СуммаДокумента <> 0, СуммаПредставление, "");
	
	СуммаПрописью = РаботаСКурсамиВалют.СформироватьСуммуПрописью(ВыборкаШапки.СуммаДокумента, ВыборкаШапки.Валюта);
	ИтоговаяСтрока = ИтоговаяСтрока + Символы.ПС + СуммаПрописью;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогиПрописью", ИтоговаяСтрока);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеПоОтчетуОПродажахКомиссионногоТовара
Процедура ЗаполнитьДанныеПоОтчетуОПродажахКомиссионногоТовара(СсылкаНаОбъект, ДеревоДокумента, Отказ) Экспорт
	
	СтруктураДанных = Документы[СсылкаНаОбъект.Метаданные().Имя].ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ДатаФормирования", ТекущаяДатаСеанса());
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Номер", ВыборкаШапки.Номер);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Дата", ВыборкаШапки.Дата);
	
	ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		ВыборкаШапки.ВалютаКод, "Объект.Код");
		
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Валюта", ВыборкаШапки.ВалютаКод,
		ПараметрыОбработкиОшибок);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Курс",
		РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВыборкаШапки.Валюта, ВыборкаШапки.Дата).Курс);
	
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить сумму документа. Возможные причины:
		|	- не заполнена табличная часть ""Товары""
		|	- не заполнена колонка ""Сумма""'");
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Сумма", ВыборкаШапки.СуммаДокумента,
		ТекстОшибки);
	
	СведенияОКомитенте = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Контрагент, СведенияОКомитенте);
	ОбменСКонтрагентамиКЭДО.ЗаполнитьДанныеУчастника(ДеревоДокумента, СведенияОКомитенте, "Комитент", Истина);
	
	СведенияОКомиссионере = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Организация, СведенияОКомиссионере);
	ОбменСКонтрагентамиКЭДО.ЗаполнитьДанныеУчастника(ДеревоДокумента, СведенияОКомиссионере, "Комиссионер", Истина);

	ОбменСКонтрагентамиКЭДО.ЗаполнитьДокументыСделки(ДеревоДокумента, ВыборкаШапки);
	
	СведенияОТоварах = НовыеСведенияОТоварахОтчетаКомитенту();
	
	ЗаполнитьТоварыОтчетаКомитенту(СведенияОТоварах, СтруктураДанных);
	
	ОбменСКонтрагентамиКЭДО.ЗаполнитьПараметрыОбработкиОшибокВТаблицеТоваровCML(СведенияОТоварах);
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДокумента, СведенияОТоварах, "Товары");
	
	СтрокаТаблицаТоваров = ДеревоДокумента.Строки.Найти("Товары", "ПолныйПуть");
	
	СведенияПокупателей = Новый Соответствие;
	Если СведенияОТоварах.Количество() Тогда 
		Для Каждого Товар Из СтрокаТаблицаТоваров.Строки Цикл
			Покупатель = СведенияОТоварах[Число(Товар.Значение) - 1].ПокупательСсылка;
			
			Если ЗначениеЗаполнено(Покупатель) Тогда
				СведенияОПокупателе = СведенияПокупателей[Покупатель];
				Если СведенияОПокупателе = Неопределено Тогда
					СведенияОПокупателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
					ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(Покупатель, СведенияОПокупателе);
					СведенияПокупателей.Вставить(Покупатель, СведенияОПокупателе);
				КонецЕсли;
				ОбменСКонтрагентамиКЭДО.ЗаполнитьДанныеУчастника(Товар, СведенияОПокупателе,
					"Товары.НомерСтроки.Покупатель", Истина);
			КонецЕсли;
			
			ДатаРеализации = СведенияОТоварах[Число(Товар.Значение) - 1].ДатаРеализации;
			Если ЗначениеЗаполнено(ДатаРеализации) Тогда
				СтрокаДопДанных = Товар.Строки.Найти("Товары.НомерСтроки.ДопДанныеПодписанные", "ПолныйПуть", Истина);
				ЭлектронноеВзаимодействие.ДобавитьДопДанныеВДерево(СтрокаДопДанных, 
					Новый Структура("ДатаРеализации", ДатаРеализации), Истина);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить итоговые стоимостные показатели. Возможные причины:
		|	- не заполнена табличная часть ""Товары""
		|	- не заполнена колонка ""Сумма""'");
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаДокумента",
		ВыборкаШапки.СуммаДокумента, ТекстОшибки);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаВознаграждения",
		ВыборкаШапки.СуммаВознаграждения, ТекстОшибки);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СтавкаНДСВознаграждения",
		ВыборкаШапки.СтавкаНДСВознаграждения);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаНДСВознаграждения",
		ВыборкаШапки.СуммаНДСВознаграждения, ТекстОшибки);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.ЦенаВключаетНДС",
		ВыборкаШапки.ЦенаВключаетНДС);
	
	Если ЗначениеЗаполнено (ВыборкаШапки.ПроцентВознаграждения) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.Процент",
			ВыборкаШапки.ПроцентВознаграждения);
	КонецЕсли;
	
	Если ВыборкаШапки.СуммаДокумента < 0 Тогда
		ТекстИтоговаяСтрока = НСтр("ru = 'Всего возвращено наименований'");
	Иначе
		ТекстИтоговаяСтрока = НСтр("ru = 'Всего продано наименований'");
	КонецЕсли;
	
	СуммаПредставление = "";
	ФорматСумм(ВыборкаШапки.СуммаДокумента, СуммаПредставление, ВыборкаШапки.ВалютаКод);
	
	ИтоговаяСтрока = ТекстИтоговаяСтрока
		+ " "
		+ СведенияОТоварах.Количество()
		+ ?(ВыборкаШапки.СуммаДокумента <> 0, НСтр("ru = ', на сумму'") + " ", "")
		+ ?(ВыборкаШапки.СуммаДокумента <> 0, СуммаПредставление, "");
	
	СуммаПрописью = РаботаСКурсамиВалют.СформироватьСуммуПрописью(ВыборкаШапки.СуммаДокумента, ВыборкаШапки.Валюта);
	
	ИтоговаяСтрока = ИтоговаяСтрока + Символы.ПС + СуммаПрописью;
		
	Если ВыборкаШапки.СуммаВознаграждения <> 0 Тогда
		СуммаВознаграждения = НСтр("ru = 'Сумма комиссионного вознаграждения составила'")
			+ " "
			+ ?(ВыборкаШапки.СуммаВознаграждения < 0,  НСтр("ru = 'минус'") + " ", "")
			+ РаботаСКурсамиВалют.СформироватьСуммуПрописью(ВыборкаШапки.СуммаВознаграждения, ВыборкаШапки.Валюта);
	КонецЕсли;

	ИтогиПрописью = ИтоговаяСтрока + Символы.ПС + СуммаВознаграждения;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогиПрописью", ИтогиПрописью);
	
КонецПроцедуры

#КонецОбласти

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДокументаCML.
Процедура ПриОтраженииВУчетеДокументаCML(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	ТипДокумента = ПараметрыДляОтраженияВУчете.ПараметрыЭлектронногоДокумента.ТипДокумента;
	
	ДеревоРазбора = ПараметрыДляОтраженияВУчете.ПараметрыПоФорматуДокумента.ДеревоСсылокНаОбъекты;
	
	СсылкаНаВладельца = Неопределено;
	Если ЗначениеЗаполнено(РезультатОтраженияВУчете.ДокументыУчета) Тогда
		СсылкаНаВладельца = РезультатОтраженияВУчете.ДокументыУчета[0];
	КонецЕсли;
	
	НайденныйОбъект = Неопределено;
	Если ТипДокумента = ТипыДокументов.ПрайсЛист Тогда
		
		НайденныйОбъект = ПрайсЛист(ДанныеЭлектронногоДокумента, ДеревоРазбора, СсылкаНаВладельца);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.ОтчетОСписанииКомиссионногоТовара Тогда
		
		НайденныйОбъект = ОтчетОСписанииКомиссионногоТовара(ДанныеЭлектронногоДокумента, ДеревоРазбора, СсылкаНаВладельца);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.ОтчетОПродажахКомиссионногоТовара
		Или ТипДокумента = ТипыДокументов.ОтчетОСписанииКомиссионногоТовара Тогда 
		
		НайденныйОбъект = НайтиСоздатьОтчетОПродажахКомиссионногоТовара(ДанныеЭлектронногоДокумента, ДеревоРазбора,
			СсылкаНаВладельца);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденныйОбъект) Тогда
		РезультатОтраженияВУчете.ДокументыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НайденныйОбъект);
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПолучитьОтветственногоПоЭД.
Процедура ПолучитьОтветственногоПоЭД(Контрагент, Организация, ДоговорКонтрагента, ОтветственныйПоЭД) Экспорт
	
	Если ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(Контрагент.Партнер) Тогда
		Если Контрагент.Партнер.Метаданные().Реквизиты.Найти("ОсновнойМенеджер") <> Неопределено
			И ЗначениеЗаполнено(Контрагент.Партнер.ОсновнойМенеджер) Тогда
			
			ОтветственныйПоЭД = Контрагент.Партнер.ОсновнойМенеджер;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.СписокТиповДокументовПоВидуЭД.
Процедура СписокТиповДокументовПоТипуЭлектронногоДокумента(ТипДокумента, СписокВозврата) Экспорт
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	Если ТипДокумента = ТипыДокументов.ОтчетОПродажахКомиссионногоТовара
			Или ТипДокумента = ТипыДокументов.ОтчетОСписанииКомиссионногоТовара
			Или ТипДокумента = ТипыДокументов.ПрайсЛист Тогда
		СписокВозврата.Добавить(Документы._ДемоОперация.ПустаяСсылка(),
			Метаданные.Документы._ДемоОперация.Представление());
		
	ИначеЕсли ТипДокумента = ТипыДокументов.ДокументПредприятия Тогда
		СписокВозврата.Добавить(Справочники.ДоговорыКонтрагентов.ПустаяСсылка(),
			Метаданные.Справочники.ДоговорыКонтрагентов.Представление());
	КонецЕсли;
	
КонецПроцедуры

// Удаляет демо типы документов из используемых типов документов.
//
// Параметры:
//  ЭлектронныйДокумент - ДокументСсылка.ЭлектронныйДокументВходящийЭДО
//                      - ДокументСсылка.ЭлектронныйДокументИсходящийЭДО
//  СписокТипов - СписокЗначений из Строка  - типы актуальных электронных документов
//
Процедура УдалитьДемоТипыИзИспользуемыхТиповДокументов(ЭлектронныйДокумент, СписокТипов) Экспорт
		
	ИмяРеквизитаИННОрганизации = ЭлектронноеВзаимодействие.ИмяНаличиеОбъектаРеквизитаВПрикладномРешении(
		"ИННОрганизации");
	ИмяРеквизитаКППОрганизации = ЭлектронноеВзаимодействие.ИмяНаличиеОбъектаРеквизитаВПрикладномРешении(
		"КППОрганизации");
		
	Получатель = ЭлектронныйДокумент.Организация;
	
	ПараметрыПриглашения = ПриглашенияЭДОКлиентСервер.КлючПриглашения();
	ПараметрыПриглашения.ИдентификаторОрганизации = ЭлектронныйДокумент.ИдентификаторОрганизации;
	ПараметрыПриглашения.ИдентификаторКонтрагента = ЭлектронныйДокумент.ИдентификаторКонтрагента;
	ПараметрыПриглашения.ИНН = Получатель[ИмяРеквизитаИННОрганизации];
	ПараметрыПриглашения.КПП = Получатель[ИмяРеквизитаКППОрганизации];
	
	ЭтоОбменМеждуОрганизациями = ПриглашенияЭДО.ОбменЭДМеждуОрганизациями(ПараметрыПриглашения);
	
	Если Не ЭтоОбменМеждуОрганизациями Тогда
		УдаляемыйТипДокументов = 
			СписокТипов.НайтиПоЗначению("_ДемоПередачаТоваровМеждуОрганизациями");
		Если УдаляемыйТипДокументов <> Неопределено Тогда
			СписокТипов.Удалить(УдаляемыйТипДокументов);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ИспользоватьОбменЭДМеждуОрганизациями.
Процедура ИспользоватьОбменЭДМеждуОрганизациями(Отказ) Экспорт
	
	// Проектное решение: принудительно используем обмен между организациями,
	// несмотря на то, что Клиент ЭДО установил Отказ = Истина.
	Отказ = Ложь;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПодготовитьДанныеПоПередачеТоваровМеждуОрганизациями.
Процедура ПодготовитьДанныеПоПередачеТоваровМеждуОрганизациями(СсылкаНаОбъект, ДеревоЭД, Отказ) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(110)) КАК Ид,
	|	Товары.Номенклатура.Код КАК Артикул,
	|	Товары.Номенклатура.НаименованиеПолное КАК Наименование,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Количество КАК Количество,
	|	Товары.Сумма КАК Сумма,
	|	Товары.Цена КАК Цена,
	|	NULL КАК Характеристика,
	|	Товары.ЕдиницаИзмерения КАК Упаковка,
	|	Товары.ЕдиницаИзмерения.Код КАК УпаковкаКод,
	|	Товары.ЕдиницаИзмерения.Наименование КАК УпаковкаНаименование,
	|	Товары.Номенклатура.СтавкаНДС КАК СтавкаНДС,
	|	0 КАК СуммаНДС,
	|	0 КАК СуммаСкидки,
	|	Товары.Сумма КАК СуммаСНДС,
	|	Товары.ЕдиницаИзмерения.Код КАК БазоваяЕдиницаКод,
	|	Товары.ЕдиницаИзмерения.Наименование КАК БазоваяЕдиницаНаименование,
	|	Товары.ЕдиницаИзмерения.НаименованиеПолное КАК БазоваяЕдиницаНаименованиеПолное,
	|	Товары.ЕдиницаИзмерения.МеждународноеСокращение КАК БазоваяЕдиницаМеждународноеСокращение,
	|	1 КАК Коэффициент,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	Документ._ДемоПередачаТоваровМеждуОрганизациями.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	
	ТаблицаТоваров = Запрос.Выполнить().Выгрузить();
	
	ОбработатьТаблицуТоваров(ТаблицаТоваров);
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(
		ТаблицаТоваров, "Наименование", "Номенклатура", "Объект.Номенклатура", , "НомерСтроки");
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(
		ТаблицаТоваров, "БазоваяЕдиницаКод", "ЕдиницаИзмерения", "Объект.ЕдиницаИзмерения", , "НомерСтроки");
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоЭД, ТаблицаТоваров, "Товары");
	
	Основание = Новый Структура;
	Основание.Вставить("ДокументНаименование", НСтр("ru = 'Договор'"));
	Основание.Вставить("ДокументНомер", НСтр("ru = '1'"));
	Основание.Вставить("ДокументДата", ТекущаяДатаСеанса());
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, "Организация, ОрганизацияПолучатель");
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоЭД, "Сумма",               ТаблицаТоваров.Итог("Сумма"));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоЭД, "ЦенаВключаетНДС",     Истина);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоЭД, "Организация",         РеквизитыДокумента.Организация);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоЭД, "Контрагент",          РеквизитыДокумента.ОрганизацияПолучатель);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоЭД, "Грузоотправитель",    РеквизитыДокумента.Организация);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоЭД, "Грузополучатель",     РеквизитыДокумента.ОрганизацияПолучатель);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоЭД, "Основание",           Основание);

КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПодготовитьДанныеПоВозвратуТоваровМеждуОрганизациями.
