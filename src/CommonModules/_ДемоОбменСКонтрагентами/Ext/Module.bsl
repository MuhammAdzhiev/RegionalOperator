// См. ОбменСКонтрагентамиПереопределяемый.СпособыОтраженияВУчетеТипаЭлектронногоДокумента.
Процедура СпособыОтраженияВУчетеТипаЭлектронногоДокумента(ТипДокумента,СписокСпособовОбработки) Экспорт 
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	Если ТипДокумента = ТипыДокументов.ПрайсЛист Тогда
		
		СписокСпособовОбработки.Добавить("_ДемоОперация", НСтр("ru = 'Демо: Операция'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.ПередачаТоваровМеждуОрганизациями 
		Или ТипДокумента = ТипыДокументов.ТоварнаяНакладная Тогда	
		
		СписокСпособовОбработки.Добавить("_ДемоПередачаТоваровМеждуОрганизациями", 
			НСтр("ru = 'Демо: Передача товаров между организациями'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.ОтчетОПродажахКомиссионногоТовара
		Или ТипДокумента = ТипыДокументов.ОтчетОСписанииКомиссионногоТовара Тогда
	
		СписокСпособовОбработки.Добавить("ОтчетКомиссионера", НСтр("ru = 'Отчет комиссионера'"), Истина);
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.СоответствиеИсходящихВидовЭДДокументамИБ.
Процедура СоответствиеИсходящихТиповЭлектронныхДокументовДокументамИБ(СоответствиеТиповЭлектронныхДокументовДокументамИБ) Экспорт 
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.ПрайсЛист, НСтр("ru = 'Демо: Операция (Прайс-лист)'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.ОтчетОПродажахКомиссионногоТовара,
		НСтр("ru = 'Отчет о продажах комиссионного товара'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.ОтчетОСписанииКомиссионногоТовара,
		НСтр("ru = 'Отчет о списании комиссионного товара'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.АктПриемкиСтроительныхРаботУслуг, 
		НСтр("ru = 'Акт приемки строительных работ'"));
	
КонецПроцедуры

#Область ПередачаТоваровЧерезОператораЭДО

// Подготавливает данные для электронного документа УПД (информация покупателя) по приказу ФНС № ММВ-7-15/820@.
//
// Параметры:
//  Основания - Массив Из ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - основания электронного документа.
//  Данные - ДеревоЗначений - данные для заполнения электронного документа. Строится по макету 
//                            см. Обработка.ОбменСКонтрагентами.Макет.УПД_ИнформацияПокупателя_2019. Выходной параметр.
//  Отказ - Булево - признак отказа от дальнейшего формирования электронного документа.
//                   Информационное сообщение пользователю необходимо формировать самостоятельно.
//
Процедура ЗаполнитьДанныеУПД2019_ИнформацияПокупателя(Знач Основания, Данные, Отказ) Экспорт
	ПередачаТоваров = Документы._ДемоПередачаТоваровМеждуОрганизациями.ПустаяСсылка();
	
	Если НЕ ТипЗнч(Основания) = Тип("Массив") Тогда
		Основания = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Основания);
	КонецЕсли;
	
	Для каждого Основание Из Основания Цикл
		Если ТипЗнч(Основание) = Тип("ДокументСсылка._ДемоПередачаТоваровМеждуОрганизациями") Тогда
			ПередачаТоваров = Основание;
		КонецЕсли;
	КонецЦикла;
	
	ДатаПолученияТоваров = Дата(1, 1, 1);
	СодержаниеОперации   = "-";
	СоставительДокумента = "-";
	КодИтога = "1";
	
	Если ЗначениеЗаполнено(ПередачаТоваров) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	_ДемоПередачаТоваровМеждуОрганизациями.Дата,
		|	_ДемоПередачаТоваровМеждуОрганизациями.ОрганизацияПолучатель.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
		|	_ДемоПередачаТоваровМеждуОрганизациями.ОрганизацияПолучатель.ИНН КАК ОрганизацияИНН,
		|	_ДемоПередачаТоваровМеждуОрганизациями.ОрганизацияПолучатель.КПП КАК ОрганизацияКПП
		|ИЗ
		|	Документ._ДемоПередачаТоваровМеждуОрганизациями КАК _ДемоПередачаТоваровМеждуОрганизациями
		|ГДЕ
		|	_ДемоПередачаТоваровМеждуОрганизациями.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ПередачаТоваров);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		ДатаПолученияТоваров = Выборка.Дата;
		
		СоставительДокумента = ?(ЗначениеЗаполнено(Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН/КПП %2/%3'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН, Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН %2'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН));

	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СоставительДокументаНаименование", СоставительДокумента);
	
	Если ЗначениеЗаполнено(ДатаПолученияТоваров) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			Данные, "СведенияОПринятииТоваров.ДатаПолученияТоваров", ДатаПолученияТоваров);
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СведенияОПринятииТоваров.СодержаниеОперации", СодержаниеОперации);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СведенияОПринятииТоваров.КодИтога", КодИтога);
	
КонецПроцедуры

// Подготавливает данные для электронного документа УПД (информация продавца) по приказу ФНС № ММВ-7-15/820@.
//
// Параметры:
//  Основание - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - основание для электронного документа.
//  Настройки - ФиксированнаяСтруктура - настройки заполнения данных:
//   * ТипДокумента - Произвольный - тип документа, который нужно сформировать. Возможные значения представлены следующими 
//                                   свойствами результата функции см. ОбменСКонтрагентами.ТипыДокументов:
//                                    - АктВыполненныхРабот, 
//                                    - АктНаПередачуПрав, 
//                                    - ТоварнаяНакладная, 
//                                    - СчетФактура, 
//                                    - УПД,
//                                    - СведенияОРеализацииКомиссионером,
//                                    - СведенияОЗакупкеКомиссионером.
//   * Отправитель - ОпределяемыйТип.Организация - отправитель электронного документа.
//   * Получатель - ОпределяемыйТип.УчастникЭДО - получатель электронного документа.
//   * Договор - ОпределяемыйТип.ДоговорСКонтрагентомЭДО - договор с получателем электронного документа.
//   * ВариантыЗаполненияПолей - Структура - пользовательские настройки для заполнения полей:
//    ** ТоварКод - Строка - значение из списка, заданного в ПриОпределенииВариантовЗаполненияПолейЭлектронныхДокументов
//                           для идентификатора "УПД_ТоварКод".
//  Данные - ДеревоЗначений - данные для заполнения электронного документа. Строится по макету 
//                            см. Обработка.ОбменСКонтрагентами.Макет.УПД_ИнформацияПродавца_2019. Выходной параметр.
//  Описание - Структура - дополнительная информация о документе. Выходной параметр.
//   * Основания - Массив из ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылки на дополнительные объекты-основания
//                 электронного документа помимо указанного в параметре "Основание".
//  Отказ - Булево - признак отказа от дальнейшего формирования электронного документа.
//                   Информационное сообщение пользователю необходимо формировать самостоятельно.
//
Процедура ЗаполнитьДанныеУПД2019_ИнформацияПродавца(Знач Основание, Знач Настройки, Данные, Описание, Отказ) Экспорт
	
	ВсеВидыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	ТипДокумента = Настройки.ТипДокумента;
	
	СтруктураЭД = ОбщегоНазначения.СкопироватьРекурсивно(Настройки, Ложь);
	СчетФактура = Неопределено;
	ПередаточныеДокументы = Новый Массив;
	
	ТипДокументаОснования = ТипЗнч(Основание);
	Если ТипДокументаОснования = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		СчетФактура = Основание;
		ПередаточныеДокументы = ОснованияСчетаФактуры(Основание);
	Иначе
		СчетФактура = Документы.СчетФактураВыданный.СчетФактураДокумента(Основание);
		ПередаточныеДокументы.Добавить(Основание);
	КонецЕсли;

	Если ТипДокумента = ВсеВидыДокументов.УПД Тогда
		
		СтруктураЭД.Вставить("Функция", "СЧФДОП");
		
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_2019(СчетФактура, СтруктураЭД, Данные, Отказ);
		Иначе
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_2019(Основание, СтруктураЭД, Данные, Отказ);
			Если УПДБезНДС(Данные) Тогда
				СтруктураЭД.Функция = "ДОП";
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СчетФактура Тогда
		
		СтруктураЭД.Вставить("Функция", "СЧФ");
		ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_2019(Основание, СтруктураЭД, Данные, Отказ);

	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СведенияОРеализацииКомиссионером Тогда

		СтруктураЭД.Вставить("Функция", "СвРК");
		
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_2019(СчетФактура, СтруктураЭД, Данные, Отказ);
		Иначе
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_2019(Основание, СтруктураЭД, Данные, Отказ);
		КонецЕсли;
			
	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СведенияОЗакупкеКомиссионером Тогда

		СтруктураЭД.Вставить("Функция", "СвЗК");
		ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_2019(Основание, СтруктураЭД, Данные, Отказ);
			
	Иначе
		
		СтруктураЭД.Вставить("Функция", "ДОП");
		ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_2019(Основание, СтруктураЭД, Данные, Отказ);
		
	КонецЕсли;
	
	ФункцияУПД = СтруктураЭД.Функция;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "Функция", ФункцияУПД);
	
	Если ФункцияУПД = "СЧФДОП" Тогда
		
		Если Основание = СчетФактура Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Описание.Основания, ПередаточныеДокументы);
		Иначе
			Описание.Основания.Добавить(СчетФактура);
		КонецЕсли;
		
	КонецЕсли;	

КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_2019
Процедура ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_2019(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	СпособОбработки = ПараметрыДляОтраженияВУчете.ПараметрыСпособаОбмена.СпособОбмена;
	
	ПервичныйДокумент = Неопределено;
	
	СпособОбработкиПервичногоДокумента = "";
	
	Если ЗначениеЗаполнено(СпособОбработки) И ТипЗнч(СпособОбработки) = Тип("Структура") Тогда
		Если СпособОбработки.Свойство("ПервичныйДокумент") Тогда
			СпособОбработкиПервичногоДокумента = СпособОбработки.ПервичныйДокумент;
		КонецЕсли;
	Иначе
		СпособОбработкиПервичногоДокумента = СпособОбработки;
	КонецЕсли;
	
	Для Каждого Строка Из РезультатОтраженияВУчете.ДокументыУчета Цикл
		ПервичныйДокумент = Строка;
	КонецЦикла;

	ДокументыУчета = Новый Массив;
	
	НайтиДокументОПередаче(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина,
		СпособОбработкиПервичногоДокумента, РезультатОтраженияВУчете.ОписаниеОшибки);
	ДокументыУчета.Добавить(ПервичныйДокумент);
	
	РезультатОтраженияВУчете.ДокументыУчета = ДокументыУчета;
	
КонецПроцедуры

