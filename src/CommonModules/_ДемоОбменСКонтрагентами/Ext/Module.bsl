	СведенияОТоварах = Новый ТаблицаЗначений;
	СведенияОТоварах.Колонки.Добавить("НомерСтроки");
	СведенияОТоварах.Колонки.Добавить("Артикул");
	СведенияОТоварах.Колонки.Добавить("Наименование");
	СведенияОТоварах.Колонки.Добавить("НаименованиеХарактеристики");
	СведенияОТоварах.Колонки.Добавить("Номенклатура");
	СведенияОТоварах.Колонки.Добавить("Характеристика");
	СведенияОТоварах.Колонки.Добавить("БазоваяЕдиницаСсылка");
	СведенияОТоварах.Колонки.Добавить("БазоваяЕдиницаКод");
	СведенияОТоварах.Колонки.Добавить("БазоваяЕдиницаНаименование");
	СведенияОТоварах.Колонки.Добавить("БазоваяЕдиницаНаименованиеПолное");
	СведенияОТоварах.Колонки.Добавить("БазоваяЕдиницаМеждународноеСокращение");
	СведенияОТоварах.Колонки.Добавить("ЕдиницаИзмерения");
	СведенияОТоварах.Колонки.Добавить("ЕдиницаИзмеренияКодПоОКЕИ");
	СведенияОТоварах.Колонки.Добавить("ЕдиницаИзмеренияКоэффициент");
	СведенияОТоварах.Колонки.Добавить("Количество");
	СведенияОТоварах.Колонки.Добавить("Цена");
	СведенияОТоварах.Колонки.Добавить("Сумма");
	СведенияОТоварах.Колонки.Добавить("СтавкаНДС");
	СведенияОТоварах.Колонки.Добавить("СуммаНДС");
	СведенияОТоварах.Колонки.Добавить("СуммаСНДС");
	СведенияОТоварах.Колонки.Добавить("НДСУчтеноВСумме");
	СведенияОТоварах.Колонки.Добавить("ЦенаПродажи");
	СведенияОТоварах.Колонки.Добавить("СуммаПродажи");
	СведенияОТоварах.Колонки.Добавить("СуммаВознаграждения");
	СведенияОТоварах.Колонки.Добавить("ПокупательСсылка");
	СведенияОТоварах.Колонки.Добавить("СведенияОПрослеживаемости");
	СведенияОТоварах.Колонки.Добавить("Сопоставление");
	СведенияОТоварах.Колонки.Добавить("ДопДанныеПодписанные");
	СведенияОТоварах.Колонки.Добавить("ДатаРеализации");
	Возврат СведенияОТоварах;
КонецФункции

Процедура ЗаполнитьТоварыОтчетаКомитенту(СведенияОТоварах, СтруктураДанных)
	
	ВыборкаТоваров = СтруктураДанных.ВыборкаТоваров;
	ЦенаВключаетНДС = СтруктураДанных.ВыборкаШапки.ЦенаВключаетНДС;
	ЗаполнятьВознаграждение = 
		СтруктураДанных.ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.ОтчетОПродажахКомиссионногоТовара;
	
	ИспользоватьСопоставлениеНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	
	Пока ВыборкаТоваров.Следующий() Цикл
		
		НоваяСтрока = СведенияОТоварах.Добавить();
		НоваяСтрока.НомерСтроки = ВыборкаТоваров.НомерСтроки;
		НоваяСтрока.Номенклатура = ВыборкаТоваров.Номенклатура;
		НоваяСтрока.Характеристика = ВыборкаТоваров.Характеристика;
		
		НоваяСтрока.Цена = ВыборкаТоваров.ЦенаПоступления;
		НоваяСтрока.Количество = ВыборкаТоваров.КоличествоУпаковок;
		НоваяСтрока.Сумма = ВыборкаТоваров.СуммаПоступления;
		НоваяСтрока.СтавкаНДС = ВыборкаТоваров.СтавкаНДС;
		НоваяСтрока.СуммаНДС = ВыборкаТоваров.СуммаНДС;
		НоваяСтрока.НДСУчтеноВСумме = ЦенаВключаетНДС;
		
		НоваяСтрока.ЦенаПродажи = ВыборкаТоваров.Цена;
		НоваяСтрока.СуммаПродажи = ВыборкаТоваров.Сумма;
		
		НоваяСтрока.ДатаРеализации = ВыборкаТоваров.ДатаРеализации;
		
		Если ЗаполнятьВознаграждение Тогда
			НоваяСтрока.СуммаВознаграждения = ВыборкаТоваров.СуммаВознаграждения;
		КонецЕсли;
		
		НоваяСтрока.ПокупательСсылка = ВыборкаТоваров.Покупатель;
		
		Если ЗначениеЗаполнено(СтруктураДанных.СведенияПрослеживаемости) Тогда
			Отбор = Новый Структура("ИдентификаторСтроки", ВыборкаТоваров.ИдентификаторСтроки);
			КоллекцияСведений = СтруктураДанных.СведенияПрослеживаемости.НайтиСтроки(Отбор);
			Если ЗначениеЗаполнено(КоллекцияСведений) Тогда
				НоваяСтрока.СведенияОПрослеживаемости = ОбменСКонтрагентамиКЭДО.НовыеСведенияОПрослеживаемости(); // АПК:277 Допустимый вызов из служебного программного интерфейса связанной подсистемы КлиентЭДО
				Для Каждого ТекущиеСведения Из КоллекцияСведений Цикл
					НовыеСведения = НоваяСтрока.СведенияОПрослеживаемости.Добавить();
					НовыеСведения.НомерТовара = ТекущиеСведения.РНПТ;
					НовыеСведения.КоличествоУчетное = ТекущиеСведения.КоличествоУпаковок;
					НовыеСведения.Количество = ТекущиеСведения.КоличествоПрослеживаемости;
					НовыеСведения.ЕдиницаИзмеренияКод = ТекущиеСведения.ЕдиницаИзмеренияКод;
					НовыеСведения.ЕдиницаИзмеренияНаименование = ТекущиеСведения.ЕдиницаИзмеренияНаименование;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Сопоставление = Новый Соответствие;
		НоваяСтрока.Сопоставление = Сопоставление;
		
		Сопоставление.Вставить("НоменклатураИБ",   ВыборкаТоваров.Номенклатура);
		Сопоставление.Вставить("ХарактеристикаИБ", ВыборкаТоваров.Характеристика);
		Сопоставление.Вставить("УпаковкаИБ",       ВыборкаТоваров.ЕдиницаИзмерения);
		
		Если ИспользоватьСопоставлениеНоменклатуры Тогда
			
			НоваяСтрока.Артикул = ВыборкаТоваров.НоменклатураАртикул;
			НоваяСтрока.Наименование = ВыборкаТоваров.НоменклатураНаименование;
			НоваяСтрока.НаименованиеХарактеристики = ВыборкаТоваров.ХарактеристикаНаименование;
			
			НоваяСтрока.БазоваяЕдиницаСсылка = ВыборкаТоваров.БазоваяЕдиницаСсылка;
			НоваяСтрока.БазоваяЕдиницаКод = ВыборкаТоваров.БазоваяЕдиницаКод;
			НоваяСтрока.БазоваяЕдиницаНаименование = ВыборкаТоваров.БазоваяЕдиницаНаименование;
			НоваяСтрока.БазоваяЕдиницаНаименованиеПолное = ВыборкаТоваров.БазоваяЕдиницаНаименованиеПолное;
			НоваяСтрока.БазоваяЕдиницаМеждународноеСокращение = ВыборкаТоваров.БазоваяЕдиницаМеждународноеСокращение;
			
			НоваяСтрока.ЕдиницаИзмерения = ВыборкаТоваров.ЕдиницаИзмерения;
			НоваяСтрока.ЕдиницаИзмеренияКодПоОКЕИ = ВыборкаТоваров.ЕдиницаИзмеренияКод;
			НоваяСтрока.ЕдиницаИзмеренияКоэффициент = ВыборкаТоваров.ЕдиницаИзмеренияКоэффициент;
			
			Сопоставление.Вставить("Идентификатор",         ВыборкаТоваров.ИдентификаторНоменклатурыКонтрагента);
			Сопоставление.Вставить("Наименование",          ВыборкаТоваров.НаименованиеНоменклатурыКонтрагента);
			Сопоставление.Вставить("Артикул"       ,        ВыборкаТоваров.АртикулНоменклатурыКонтрагента);
			Сопоставление.Вставить("Характеристика",        ВыборкаТоваров.НаименованиеХарактеристикиКонтрагента);
			Сопоставление.Вставить("ЕдиницаИзмерения",      ВыборкаТоваров.ЕдиницаИзмеренияКонтрагента);
			Сопоставление.Вставить("ЕдиницаИзмеренияКод",   ВыборкаТоваров.ЕдиницаИзмеренияКодКонтрагента);
			Сопоставление.Вставить("СтавкаНДС",             ВыборкаТоваров.СтавкаНДСКонтрагента);
			Сопоставление.Вставить("ШтрихкодыНоменклатуры", ВыборкаТоваров.ШтрихкодыНоменклатурыКонтрагента);
			Сопоставление.Вставить("ШтрихкодКомбинации",    ВыборкаТоваров.ШтрихкодКомбинацииКонтрагента);
			
		Иначе
			
			НоваяСтрока.Артикул = ВыборкаТоваров.НоменклатураАртикул;
			НоваяСтрока.Наименование = ВыборкаТоваров.НоменклатураНаименование;
			НоваяСтрока.НаименованиеХарактеристики = ВыборкаТоваров.ХарактеристикаНаименование;
			
			НоваяСтрока.БазоваяЕдиницаСсылка = ВыборкаТоваров.БазоваяЕдиницаСсылка;
			НоваяСтрока.БазоваяЕдиницаКод = ВыборкаТоваров.БазоваяЕдиницаКод;
			НоваяСтрока.БазоваяЕдиницаНаименование = ВыборкаТоваров.БазоваяЕдиницаНаименование;
			НоваяСтрока.БазоваяЕдиницаНаименованиеПолное = ВыборкаТоваров.БазоваяЕдиницаНаименованиеПолное;
			НоваяСтрока.БазоваяЕдиницаМеждународноеСокращение = ВыборкаТоваров.БазоваяЕдиницаМеждународноеСокращение;
			
			НоваяСтрока.ЕдиницаИзмерения = ВыборкаТоваров.ЕдиницаИзмерения;
			НоваяСтрока.ЕдиницаИзмеренияКодПоОКЕИ = ВыборкаТоваров.ЕдиницаИзмеренияКод;
			НоваяСтрока.ЕдиницаИзмеренияКоэффициент = ВыборкаТоваров.ЕдиницаИзмеренияКоэффициент;
			
			Сопоставление.Вставить("Наименование", ВыборкаТоваров.НоменклатураНаименование);
			Если ЗначениеЗаполнено(ВыборкаТоваров.Характеристика) Тогда
				Сопоставление.Вставить("Характеристика", ВыборкаТоваров.ХарактеристикаНаименование);
			КонецЕсли;
			Сопоставление.Вставить("ЕдиницаИзмерения"   , ВыборкаТоваров.ЕдиницаИзмеренияНаименование);
			Сопоставление.Вставить("ЕдиницаИзмеренияКод", ВыборкаТоваров.ЕдиницаИзмеренияКод);
			Сопоставление.Вставить("СтавкаНДС", ВыборкаТоваров.НоменклатураСтавкаНДС);
			Сопоставление.Вставить("Артикул"  , ВыборкаТоваров.НоменклатураАртикул);
			
			ОбменСКонтрагентамиКЭДО.ЗаполнитьШтрихкодыТоваровВСопоставление(Сопоставление, СтруктураДанных.ШтрихкодыНоменклатуры,
				СтруктураДанных.ШтрихкодыКомбинаций, ВыборкаТоваров.Номенклатура, ВыборкаТоваров.Характеристика,
				ВыборкаТоваров.ЕдиницаИзмерения);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОтчетКомиссионера

Функция НайтиСоздатьОтчетОПродажахКомиссионногоТовара(СтрокаДляЗагрузки, ДеревоРазбора, СсылкаНаВладельца)
	
	ВозвращаемоеЗначение = Неопределено;
	
	ДанныеДляЗагрузки = СтруктураДляОтчетаОПродажах(СтрокаДляЗагрузки, ДеревоРазбора);
	
	ДанныеЗаполнения = ДанныеДляЗагрузки.Шапка;
	
	Попытка
		
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда // получены изменения по существующему документу
			
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			
		Иначе
			
			УстановитьПривилегированныйРежим(Истина);
			
			ДокументОбъект = Документы._ДемоОтчетКомиссионера.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
			ДокументОбъект.Заполнить(ДанныеЗаполнения);
			
		КонецЕсли;
		
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		Если СтрокаДляЗагрузки.ВидЭД = Перечисления.ТипыДокументовЭДО.ОтчетОПродажахКомиссионногоТовара Тогда
			ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.ОтчетОПродажахКомиссионногоТовара;
		Иначе
			ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.ОтчетОСписанииКомиссионногоТовара;
		КонецЕсли;
		
		// Заполним значения реквизитов шапки
		ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
		
		// Загрузим табличные части
		ДокументОбъект.Товары.Загрузить(ДанныеДляЗагрузки.Товары);
		ДокументОбъект.СведенияПрослеживаемости.Загрузить(ДанныеДляЗагрузки.СведенияПрослеживаемости);
		
		Если ДокументОбъект.ЭтоНовый() Тогда
			ДокументОбъект.УстановитьНовыйНомер();
		КонецЕсли;
		
		ЗаписатьДокумент(ДокументОбъект);
		ВозвращаемоеЗначение = ДокументОбъект.Ссылка;
		
	Исключение
		
		ВидОперации = НСтр("ru = 'Заполнение документа на основе ЭД'");
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ПодробныйТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ЭлектронноеВзаимодействие.ОбработатьОшибку(ВидОперации, ПодробныйТекстОшибки,,, СсылкаНаВладельца);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция СтруктураДляОтчетаОПродажах(СтрокаДляЗагрузки, ДеревоРазбора)
	
	ДанныеДляОбъекта = Новый Структура;
	ДанныеЗаполненияШапки = Новый Структура;
	Товары = Документы._ДемоОтчетКомиссионера.ПустаяСсылка().Товары.ВыгрузитьКолонки();
	СведенияПрослеживаемости = Документы._ДемоОтчетКомиссионера.ПустаяСсылка().СведенияПрослеживаемости.ВыгрузитьКолонки();
	
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(Товары);
	
	ИспользоватьСопоставление = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	ОблагаетсяНДСУПокупателя = Ложь;
	
	Для Каждого СтрокаРеквизита Из СтрокаДляЗагрузки.Строки Цикл
		
		Если СтрокаРеквизита.Строки.Количество() = 0 Тогда // примитивный тип
			
			ЗначениеРеквизита = ПолучитьЗначениеРеквизитаДерева(СтрокаРеквизита, СтрокаРеквизита.Реквизит, Истина, ДеревоРазбора);
			
			Если СтрокаРеквизита.Реквизит = "Процент" Тогда
				ИмяРеквизита = "ПроцентВознаграждения";
			ИначеЕсли СтрокаРеквизита.Реквизит = "Номер" Тогда
				ИмяРеквизита = "НомерЭД";
			ИначеЕсли СтрокаРеквизита.Реквизит = "Сумма" Тогда
				ИмяРеквизита = "СуммаДокумента";
			ИначеЕсли СтрокаРеквизита.Реквизит = "ЦенаВключаетНДС" Тогда
				ИмяРеквизита = "СуммаВключаетНДС";
			ИначеЕсли СтрокаРеквизита.Реквизит = "Курс" Тогда
				ИмяРеквизита = "КурсВзаиморасчетов";
			ИначеЕсли СтрокаРеквизита.Реквизит = "ДокументыОснования" Тогда
				ИмяРеквизита = "Основание";
			ИначеЕсли СтрокаРеквизита.Реквизит = "ТипыЦен" 
				И ТипЗнч(ЗначениеРеквизита) = Тип("ТаблицаЗначений") 
				И ЗначениеРеквизита.Колонки.Найти("Валюта") <> Неопределено 
				И ЗначениеРеквизита.Количество() Тогда
				ИмяРеквизита = "Валюта";
				ЗначениеРеквизита = ЗначениеРеквизита[0].Валюта;
				Если Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ЗначениеРеквизита)) Тогда 
					ЗначениеРеквизита = Справочники.Валюты.НайтиПоКоду(ЗначениеРеквизита);
				КонецЕсли;				
			Иначе
				ИмяРеквизита = СтрокаРеквизита.Реквизит;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
				ДанныеЗаполненияШапки.Вставить(ИмяРеквизита, ЗначениеРеквизита);
			КонецЕсли;
			
		ИначеЕсли СтрокаРеквизита.Реквизит = "СтрокаТЧ" Тогда
			// Добавим строку табличной части
			ОбменСКонтрагентамиКЭДО.ЗаполнитьСтрокуТЧ(Товары, СтрокаРеквизита.Строки, ДеревоРазбора, Ложь,
				ОблагаетсяНДСУПокупателя, ИспользоватьСопоставление, СведенияПрослеживаемости); // АПК:277 Допустимый вызов из служебного программного интерфейса связанной подсистемы КлиентЭДО
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДанныеЗаполненияШапки.Свойство("Контрагент") Тогда
		СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(Товары, ДанныеЗаполненияШапки.Контрагент);
	КонецЕсли;
	
	ДанныеЗаполненияШапки.Вставить("ОблагаетсяНДСУПокупателя", ОблагаетсяНДСУПокупателя);
	
	ДанныеДляОбъекта.Вставить("Шапка",  ДанныеЗаполненияШапки);
	ДанныеДляОбъекта.Вставить("Товары", Товары);
	ДанныеДляОбъекта.Вставить("СведенияПрослеживаемости", СведенияПрослеживаемости);
	
	Возврат ДанныеДляОбъекта;
	
КонецФункции

#КонецОбласти

