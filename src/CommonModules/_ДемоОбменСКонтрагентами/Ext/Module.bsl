	КонецЕсли;
	// Конец  ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
КонецПроцедуры

// Заполняет дерево электронного документа.
//
// Параметры:
//  СтруктураДанных - Структура - возвращается методом ПолучитьДанныеДляЭД учетного документа.
//  СтруктураЭД - Структура - настройки заполнения данных:
//   * Функция - Строка
//   * ТипДокумента - Произвольный
//   * Отправитель - ОпределяемыйТип.Организация
//   * Получатель - ОпределяемыйТип.КонтрагентБЭД
//   * Договор - ОпределяемыйТип.ДоговорСКонтрагентомЭДО
//   * ВариантыЗаполненияПолей - Структура:
//    ** ТоварКод - Строка
//  ДеревоДанных - ДеревоЗначений - дерево электронного документа.
//
Процедура ЗаполнитьДеревоДанныхУПД_5_02(СтруктураДанных, СтруктураЭД, ДеревоДанных)
	
	ПоддерживаемыеФорматы = ФорматыЭДО_ФНС.ПоддерживаемыеФорматы();
	ФорматУПД = ПоддерживаемыеФорматы.УПД_5_02.ИнформацияПродавца;
	
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	
	ЭтоЭлектронноеАктированиеЕИС = Ложь;
	МодульЭлектронноеАктированиеЕИС = Неопределено;
	ДанныеПриложенияЕИС = Неопределено;
	ДанныеЭлектронногоАктированияЕИС = Неопределено;
	
	Если ЗначениеЗаполнено(СтруктураДанных.ДанныеЭлектронногоАктированияЕИС)
		И СтруктураДанных.ДанныеЭлектронногоАктированияЕИС.Количество() > 0 Тогда
		МодульЭлектронноеАктированиеЕИС = ОбщегоНазначения.ОбщийМодуль("ЭлектронноеАктированиеЕИС");
		
		ОбменВключен = МодульЭлектронноеАктированиеЕИС.
			ОбменПоОрганизацииВключен(ВыборкаШапки.Организация);
		Контракт = МодульЭлектронноеАктированиеЕИС.
			ГосударственныйКонтрактДоговора(ВыборкаШапки.ДоговорКонтрагента);
			
		Если ОбменВключен И ЗначениеЗаполнено(Контракт) Тогда
			ЭтоЭлектронноеАктированиеЕИС = Истина;
			ДанныеПриложенияЕИС = МодульЭлектронноеАктированиеЕИС.
				НовыеДанныеПриложенияКТитулуПродавцаУПД();
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"ДанныеЭлектронногоАктированияЕИС.ДанныеПриложения", ДанныеПриложенияЕИС);
			ДанныеЭлектронногоАктированияЕИС = СтруктураДанных.ДанныеЭлектронногоАктированияЕИС;
		КонецЕсли;
		
	КонецЕсли;
	
	Комитент = Неопределено;
	ДоговорСКомитентом = Неопределено;
	Если СтруктураЭД.Функция = "СвРК" Или СтруктураЭД.Функция = "СвЗК" Тогда
		Комитент = СтруктураЭД.Получатель;
		ДоговорСКомитентом = СтруктураЭД.Договор;
	КонецЕсли;
	
	СведенияОПродавце = Неопределено; 
	Если ЗначениеЗаполнено(ВыборкаШапки.Организация) Тогда
		СведенияОПродавце = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Организация, СведенияОПродавце);
		
		Если ТипЗнч(ВыборкаШапки.Ссылка) <> Тип("ДокументСсылка.СчетФактураВыданный")
			И ЗначениеЗаполнено(ВыборкаШапки.БанковскийСчетОрганизации) Тогда
			Справочники.БанковскиеСчета.ЗаполнитьРеквизитыБанковскогоСчета(СведенияОПродавце, ВыборкаШапки.БанковскийСчетОрганизации);
		КонецЕсли;
		
		ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОПродавцах";
		ИмяУчастника = "Продавец";
		ТаблицаПродавцов = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
		ДанныеПродавца = ПолучитьДанныеУчастникаУПД(СведенияОПродавце, , , ФорматУПД);
		ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаПродавцов, ДанныеПродавца, ПутьТаблицы, ИмяУчастника);
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД(ТаблицаПродавцов, ИмяУчастника, ФорматУПД);
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаПродавцов, ПутьТаблицы);
		
		Если ЭтоЭлектронноеАктированиеЕИС Тогда
			СоставительДокументаНаименование =
				МодульЭлектронноеАктированиеЕИС.НаименованиеОрганизацииДляЭД(
					СведенияОПродавце.Ссылка);
		Иначе
			СоставительДокументаНаименование = СведенияОПродавце.ПолноеНаименование
				+ ?(ЗначениеЗаполнено(СведенияОПродавце.КПП),
					СтрШаблон(НСтр("ru = ', ИНН/КПП %1/%2'"), СведенияОПродавце.ИНН, СведенияОПродавце.КПП),
					СтрШаблон(НСтр("ru = ', ИНН %1'"), СведенияОПродавце.ИНН));
		КонецЕсли;
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(ВыборкаШапки.Ссылка, 
			"Объект.Организация");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СоставительДокументаНаименование, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	СведенияОПокупателе = Неопределено; 
	Если ЗначениеЗаполнено(ВыборкаШапки.Контрагент) Тогда
		СведенияОПокупателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Контрагент, СведенияОПокупателе);
				
		Если ТипЗнч(ВыборкаШапки.Ссылка) <> Тип("ДокументСсылка.СчетФактураВыданный")
			И ЗначениеЗаполнено(ВыборкаШапки.БанковскийСчетКонтрагента) Тогда
			Справочники.БанковскиеСчета.ЗаполнитьРеквизитыБанковскогоСчета(СведенияОПокупателе, ВыборкаШапки.БанковскийСчетКонтрагента);
		КонецЕсли;
		
		ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОПокупателях";
		ИмяУчастника = "Покупатель";
		ТаблицаПокупателей = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
		ДанныеПокупателя = ПолучитьДанныеУчастникаУПД(СведенияОПокупателе, , ЭтоЭлектронноеАктированиеЕИС, ФорматУПД);
		ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаПокупателей, ДанныеПокупателя, ПутьТаблицы, ИмяУчастника);
		Если ЭтоЭлектронноеАктированиеЕИС Тогда
			ИнформацияДляУчастника = МодульЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаПокупателя();
			ТаблицаПокупателей[0].ИнформацияДляУчастника = ИнформацияДляУчастника;
		КонецЕсли;
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД(ТаблицаПокупателей, ИмяУчастника, ФорматУПД);
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаПокупателей, ПутьТаблицы);
		
	КонецЕсли;
	
	// Обработка ошибки с указанием расширенного текста сообщения вместо параметров обработки ошибки.
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить код валюты документа. Проверьте, что:
	|	- в документе указана валюта,
	|	- для нее заполнен код по Общероссийскому классификатору валют.'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОСчетеФактуре.Валюта.Код",
		ВыборкаШапки.ВалютаКод, ТекстОшибки);
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить наименование валюты документа. Проверьте, что:
	|	- в документе указана валюта,
	|	- у неё заполнено наименование.'");
	
	НаименованиеВалютыПоОКВ = "";
	ДанныеВалютыПоКлассификатору = ИнтеграцияБСПБЭД.ДанныеВалютыПоКлассификатору(ВыборкаШапки.ВалютаКод);
	Если ЗначениеЗаполнено(ДанныеВалютыПоКлассификатору) Тогда
		НаименованиеВалютыПоОКВ = ДанныеВалютыПоКлассификатору.Наименование;
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОСчетеФактуре.Валюта.Наименование",
		НаименованиеВалютыПоОКВ, ТекстОшибки);
	
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная Тогда
		
		ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОГрузоотправителях";
		ИмяУчастника = "Грузоотправитель";
		ТаблицаГрузоотправителей = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
		
		Если ЗначениеЗаполнено(ВыборкаШапки.Грузоотправитель) Тогда
			СведенияОГрузоотправителе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
			ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Грузоотправитель, СведенияОГрузоотправителе);
			ДанныеГрузоотправителя = ПолучитьДанныеУчастникаУПД(СведенияОГрузоотправителе, , , ФорматУПД);
			ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаГрузоотправителей, ДанныеГрузоотправителя, ПутьТаблицы, ИмяУчастника);
		Иначе
			СтрокаГрузоотправителя = ТаблицаГрузоотправителей.Добавить();
			СтрокаГрузоотправителя.ОнЖе = Истина;
		КонецЕсли;
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД(ТаблицаГрузоотправителей, ИмяУчастника, ФорматУПД);
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаГрузоотправителей, ПутьТаблицы);		
		
		ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОГрузополучателях";
		ИмяУчастника = "Грузополучатель";
		ТаблицаГрузополучателей = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
		
		ПриоритетыВидовКИГрузополучателя = Новый Массив;
		ПриоритетыВидовКИГрузополучателя.Добавить("ПочтовыйАдрес");
		ПриоритетыВидовКИГрузополучателя.Добавить("ФактическийАдрес");
		
		Если ЗначениеЗаполнено(ВыборкаШапки.Грузополучатель) Тогда
			СведенияОГрузополучателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
			ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Грузополучатель, СведенияОГрузополучателе);
			Если ЗначениеЗаполнено(ВыборкаШапки.АдресДоставкиЗначенияПолей) Тогда
				СведенияОГрузополучателе.Вставить("ПроизвольныйАдрес", ВыборкаШапки.АдресДоставкиЗначенияПолей);
			КонецЕсли;
			ДанныеГрузополучателя = ПолучитьДанныеУчастникаУПД(СведенияОГрузополучателе, ПриоритетыВидовКИГрузополучателя, , ФорматУПД);
			ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаГрузополучателей, ДанныеГрузополучателя, ПутьТаблицы, ИмяУчастника);
		Иначе
			Если ЗначениеЗаполнено(ВыборкаШапки.АдресДоставкиЗначенияПолей) Тогда
				СведенияОПокупателе.Вставить("ПроизвольныйАдрес", ВыборкаШапки.АдресДоставкиЗначенияПолей);
			КонецЕсли;
			ДанныеГрузополучателя = ПолучитьДанныеУчастникаУПД(СведенияОПокупателе, ПриоритетыВидовКИГрузополучателя, , ФорматУПД);
			ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаГрузополучателей, ДанныеГрузополучателя, ПутьТаблицы, ИмяУчастника);
		КонецЕсли;
		
		Если ЭтоЭлектронноеАктированиеЕИС Тогда
			ДанныеГрузополучателя = ТаблицаГрузополучателей[ТаблицаГрузополучателей.Количество() - 1];
			ИдентификаторУчастника = МодульЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаГрузополучателя();
			ДанныеГрузополучателя[ИмяУчастника].ИнформацияДляУчастника = ИдентификаторУчастника;
		КонецЕсли;
		
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД(ТаблицаГрузополучателей, ИмяУчастника, ФорматУПД);
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаГрузополучателей, ПутьТаблицы);
		
		Если ЗначениеЗаполнено(ВыборкаШапки.ИныеСведенияОбОтгрузке) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"ИныеСведенияОбОтгрузке", ВыборкаШапки.ИныеСведенияОбОтгрузке);
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураЭД.Функция <> "СЧФ" Тогда 
		
		Путь = "СведенияОПередаче.Операция.ОснованиеОтгрузкиПередачи."; 
		
		Если ЗначениеЗаполнено(ВыборкаШапки.ДоговорКонтрагента) Тогда
			ДокументОснование = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
				ДеревоДанных, Путь + "ДокументыОснования.НомерСтроки.ДокументОснование");
			ДокументОснование.НаименованиеДокумента = ВыборкаШапки.НаименованиеДоговора;
			ДокументОснование.НомерДокумента = ВыборкаШапки.НомерДоговора;
			ДокументОснование.ДатаДокумента = ВыборкаШапки.ДатаДоговора;
			
			ТаблицаДокументовОснований = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
				ДеревоДанных, Путь + "ДокументыОснования");
			ТаблицаДокументовОснований.Колонки.Добавить("ДоговорКонтрагента");
			СтрокаДокументаОснования = ТаблицаДокументовОснований.Добавить();
			СтрокаДокументаОснования.ДокументОснование = ДокументОснование;
			СтрокаДокументаОснования.ДоговорКонтрагента = ВыборкаШапки.ДоговорКонтрагента;
			
			// Дополним таблицу оснований параметрами обработки ошибок.
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаДокументаОснования,
				"ДокументОснование.НаименованиеДокумента", "ДоговорКонтрагента", "Объект.Наименование");
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаДокументаОснования,
				"ДокументОснование.НомерДокумента", "ДоговорКонтрагента", "Объект.НомерДоговора");
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаДокументаОснования,
				"ДокументОснование.ДатаДокумента", "ДоговорКонтрагента", "Объект.ДатаДоговора");
			
			ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаДокументовОснований,
				Путь + "ДокументыОснования");
		Иначе
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				Путь + "БезДокументаОснования", Истина);
		КонецЕсли;
		
		Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная Тогда
			
			ВнестиСведенияОВыбытииМаркированныхТоваровВДеревоУПДУКД(ДеревоДанных, ВыборкаШапки);
			
			Если ЗначениеЗаполнено(Комитент) Тогда
				СведенияОКомитенте = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
				ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(Комитент, СведенияОКомитенте);
				ЗаполнитьДанныеУчастникаУПД(ДеревоДанных, СведенияОКомитенте, "СведенияОКомитенте", , , ФорматУПД);
			КонецЕсли;

			Если ЗначениеЗаполнено(ВыборкаШапки.Перевозчик) Тогда
				СведенияОПеревозчике = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
				ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Перевозчик, СведенияОПеревозчике);
				ЗаполнитьДанныеУчастникаУПД(ДеревоДанных, СведенияОПеревозчике, "СведенияОПеревозчике", , , ФорматУПД);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаШапки.ДатаОтгрузки) Тогда
				ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(ВыборкаШапки.Ссылка, 
					"Объект.ДатаОтгрузки");
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОПередаче.Операция.ДатаОтгрузки",
					ВыборкаШапки.ДатаОтгрузки, ПараметрыОбработкиОшибок);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаШапки.СведенияОТранспортировкеИГрузе) Тогда
				ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(ВыборкаШапки.Ссылка, 
					"Объект.СведенияОТранспортировкеИГрузе");
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОПередаче.Операция.Транспортировка.Сведения",
					ВыборкаШапки.СведенияОТранспортировкеИГрузе, ПараметрыОбработкиОшибок);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаШапки.НомерТранспортнойНакладной) Тогда
			    ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					"НомерТранспортнойНакладной", ВыборкаШапки.НомерТранспортнойНакладной);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаШапки.ДатаТранспортнойНакладной) Тогда
			    ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					"ДатаТранспортнойНакладной", ВыборкаШапки.ДатаТранспортнойНакладной);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОбстоятельстваФормированияСФ = Неопределено;
	Если СтруктураЭД.Функция = "СЧФ" Тогда
		ЭтоАванс = (ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс);
		ОбстоятельстваФормированияСФ = ?(ЭтоАванс, "2", "1");
	ИначеЕсли СтруктураЭД.Функция = "ДОП" Тогда
		Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.ПередачаНаКомиссию Тогда
			ОбстоятельстваФормированияСФ = "4";
		КонецЕсли;
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияОСчетеФактуре.ДополнительныеСведенияОбУчастниках.ОбстоятельстваФормированияСФ", ОбстоятельстваФормированияСФ, ПараметрыОбработкиОшибок);
	// Информация продавца о наличии кода специальных обстоятельствах документа для ФНС
	СпецКодНефти = "10000";
	ЕстьСпецКодНефти = Ложь;
	Если ЗначениеЗаполнено(ВыборкаШапки.СпециальноеОбстоятельствоФНС) Тогда
		Если СтруктураЭД.Функция = "ДОП" Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"СведенияОСчетеФактуре.ДополнительныеСведенияОбУчастниках.СпециальныеОбстоятельстваФормированияДокумента",
				ВыборкаШапки.СпециальноеОбстоятельствоФНС, ПараметрыОбработкиОшибок);
		КонецЕсли;
		Если СтруктураЭД.Функция = "СЧФДОП" Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"СведенияОСчетеФактуре.ДополнительныеСведенияОбУчастниках.СпециальныеОбстоятельстваФормированияУПД", 
				ВыборкаШапки.СпециальноеОбстоятельствоФНС, ПараметрыОбработкиОшибок);
		КонецЕсли;
		ЕстьСпецКодНефти = ВыборкаШапки.СпециальноеОбстоятельствоФНС = СпецКодНефти;
	КонецЕсли;
	// Информация продавца об обстоятельствах закупок для государственных и муниципальных нужд.
	ЗакупкаДляГосударственныхНужд = Новый Структура;
	ЗакупкаДляГосударственныхНужд.Вставить("ДатаКонтракта", ВыборкаШапки.ГосЗакупкаДатаКонтракта);
	ЗакупкаДляГосударственныхНужд.Вставить("НомерКонтракта", ВыборкаШапки.ГосЗакупкаНомерКонтракта);
	ЗакупкаДляГосударственныхНужд.Вставить("НомерСчетаПродавца", ВыборкаШапки.ГосЗакупкаНомерЛицевогоСчета);
	ЗакупкаДляГосударственныхНужд.Вставить("КодПоБюджетнойКлассификации", ВыборкаШапки.ГосЗакупкаКодБюджетнойКлассификации);
	ЗакупкаДляГосударственныхНужд.Вставить("КодЦели", ВыборкаШапки.ГосЗакупкаКодЦели);
	ЗакупкаДляГосударственныхНужд.Вставить("КодТерриториальногоОргана", ВыборкаШапки.ГосЗакупкаКазначействоКод);
	ЗакупкаДляГосударственныхНужд.Вставить("НаименованиеТерриториальногоОргана", ВыборкаШапки.ГосЗакупкаКазначействоНаименование);
	Для Каждого КлючЗначение Из ЗакупкаДляГосударственныхНужд Цикл
		Если ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
			Путь = "СведенияОСчетеФактуре.ДополнительныеСведенияОбУчастниках.СведенияОГосКонтракте." + КлючЗначение.Ключ;
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь, КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	// Основание уступки денежного требования.
	ОснованиеУступки = Новый Структура;
	ОснованиеУступки.Вставить("НаименованиеДокумента", ВыборкаШапки.ОснованиеУступкиНаименование);
	ОснованиеУступки.Вставить("НомерДокумента", ВыборкаШапки.ОснованиеУступкиНомер);
	ОснованиеУступки.Вставить("ДатаДокумента", ВыборкаШапки.ОснованиеУступкиДата);
	ОснованиеУступки.Вставить("ДополнительныеСведения", ВыборкаШапки.ОснованиеУступкиСведения);
	Для Каждого КлючЗначение Из ОснованиеУступки Цикл
		Если ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
			Путь = "СведенияОСчетеФактуре.ДополнительныеСведенияОбУчастниках.ОснованиеУступкиДенежногоТребования." + КлючЗначение.Ключ;
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь, КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.Фактор) Тогда
		Путь = "СведенияОСчетеФактуре.ДополнительныеСведенияОбУчастниках.СведенияОФакторе";
		СведенияОФакторе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Фактор, СведенияОФакторе);
		ЗаполнитьДанныеУчастникаУПД(ДеревоДанных, СведенияОФакторе, Путь, , , ФорматУПД);
	КонецЕсли;
	
	// Период оказания услуг (поставки товаров).
	Путь = "СведенияОПередаче.Операция.";
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "ДатаНачалаПоставки", ВыборкаШапки.ДатаНачалаПоставки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "ДатаОкончанияПоставки", ВыборкаШапки.ДатаОкончанияПоставки);
	СодержаниеОперации = "-";
	
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс Тогда
		
		ТаблицаАвансы = Новый ТаблицаЗначений;
		ТаблицаАвансы.Колонки.Добавить("НомерСтроки");
		ТаблицаАвансы.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(2000)));
		ТаблицаАвансы.Колонки.Добавить("СтоимостьБезНалога", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
		ТаблицаАвансы.Колонки.Добавить("СтоимостьСНалогом", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
		ТаблицаАвансы.Колонки.Добавить("СуммаНалога");
		ТаблицаАвансы.Колонки.Добавить("НалоговаяСтавка");
		ТаблицаАвансы.Колонки.Добавить("Сопоставление");
		ТаблицаАвансы.Колонки.Добавить("Признак", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1)));
		ТаблицаАвансы.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
		
		ПризнакиТоваров = Новый Структура;
		ПризнакиТоваров.Вставить("Имущество", "1");
		ПризнакиТоваров.Вставить("Работа", "2");
		ПризнакиТоваров.Вставить("Услуга", "3");
		ПризнакиТоваров.Вставить("Право", "4");
		ПризнакиТоваров.Вставить("Иное", "5");
		
		НомерСтроки = 1;
		СуммаНалога = СуммаНалогаУПД_5_02();
		ВыборкаТоваров = СтруктураДанных.ВыборкаТоваров;
		
		ШтрихкодыКомбинаций   = Неопределено;
		ШтрихкодыНоменклатуры = Неопределено;
		Если Не СтруктураДанных.Свойство("ШтрихкодыНоменклатуры", ШтрихкодыНоменклатуры)
			Или Не СтруктураДанных.Свойство("ШтрихкодыКомбинаций", ШтрихкодыКомбинаций) Тогда
			ШтрихкодыПоТоварам(ВыборкаТоваров, ШтрихкодыКомбинаций, ШтрихкодыНоменклатуры);
		КонецЕсли;

		Пока ВыборкаТоваров.Следующий() Цикл
			
			НоваяСтрока = ТаблицаАвансы.Добавить();
			НоваяСтрока.НомерСтроки = НомерСтроки;
			НомерСтроки = НомерСтроки + 1;
			
			НоваяСтрока.СуммаНалога = СуммаНалогаУПД_5_02();
			Если ВыборкаШапки.ОблагаетсяНДСУПокупателя Тогда
				НоваяСтрока.СтоимостьБезНалога = ВыборкаТоваров.СуммаСНДС;
																 
				НоваяСтрока.НалоговаяСтавка = "НДС исчисляется налоговым агентом";
				НоваяСтрока.СуммаНалога.БезНДС = Ложь;
				
				СуммаНалога.БезНДС = Ложь;
				
			Иначе
				НоваяСтрока.СтоимостьБезНалога = ВыборкаТоваров.СуммаБезНДС;
				НоваяСтрока.НалоговаяСтавка = ВыборкаТоваров.СтавкаНДС;
				Если ВыборкаТоваров.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС Тогда
					
					НоваяСтрока.СуммаНалога.Сумма = ВыборкаТоваров.СуммаНДС;
					НоваяСтрока.СуммаНалога.БезНДС = Ложь;
					
					СуммаНалога.Сумма = СуммаНалога.Сумма + ВыборкаТоваров.СуммаНДС;
			  
					СуммаНалога.БезНДС = Ложь;
					
				КонецЕсли;
				
				НоваяСтрока.СтоимостьСНалогом = ВыборкаТоваров.СуммаСНДС;
			КонецЕсли;
			
			Если НоваяСтрока.СуммаНалога.БезНДС = Истина Тогда
				НоваяСтрока.СуммаНалога.Сумма = Неопределено;
			Иначе
				НоваяСтрока.СуммаНалога.БезНДС = Неопределено;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаТоваров.Номенклатура) Тогда
				
				НоваяСтрока.Код = ВыборкаТоваров.НоменклатураКод;
				НоваяСтрока.Наименование  = ВыборкаТоваров.НаименованиеПолное;
				
				Если ВыборкаТоваров.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар Тогда
					НоваяСтрока.Признак = ПризнакиТоваров.Имущество;
				ИначеЕсли ВыборкаТоваров.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа Тогда
					НоваяСтрока.Признак = ПризнакиТоваров.Работа;
				ИначеЕсли ВыборкаТоваров.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
					НоваяСтрока.Признак = ПризнакиТоваров.Услуга;
				ИначеЕсли ВыборкаТоваров.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Право Тогда
					НоваяСтрока.Признак = ПризнакиТоваров.Право;
				КонецЕсли;
				
				Сопоставление = Новый Структура;
				Сопоставление.Вставить("Наименование", ВыборкаТоваров.НаименованиеПолное);
				Если ЗначениеЗаполнено(ВыборкаТоваров.Характеристика) Тогда
					Сопоставление.Вставить("Характеристика", ВыборкаТоваров.ХарактеристикаНаименование);
				КонецЕсли;
				Сопоставление.Вставить("ЕдиницаИзмерения", ВыборкаТоваров.ЕдиницаИзмеренияНаименование);
				Сопоставление.Вставить("ЕдиницаИзмеренияКод", ВыборкаТоваров.ЕдиницаИзмеренияКод);
				Сопоставление.Вставить("Артикул", ВыборкаТоваров.НоменклатураАртикул);
				Сопоставление.Вставить("СтавкаНДС", ВыборкаТоваров.НоменклатураСтавкаНДС);
				
				Сопоставление.Вставить("НоменклатураИБ", ВыборкаТоваров.Номенклатура);
				Сопоставление.Вставить("ХарактеристикаИБ", ВыборкаТоваров.Характеристика);
				Сопоставление.Вставить("УпаковкаИБ", ВыборкаТоваров.ЕдиницаИзмерения);

				ЗаполнитьШтрихкодыТоваровВСопоставление(Сопоставление, ШтрихкодыНоменклатуры, ШтрихкодыКомбинаций,
					ВыборкаТоваров.Номенклатура, ВыборкаТоваров.Характеристика, ВыборкаТоваров.ЕдиницаИзмерения);

				НоваяСтрока.Сопоставление = Сопоставление;
				
			Иначе
				
				Если ЗначениеЗаполнено(ВыборкаТоваров.Содержание) Тогда
					НоваяСтрока.Наименование = ВыборкаТоваров.Содержание;
				Иначе
					НоваяСтрока.Наименование = НСтр("ru = 'Предварительная оплата'");
				КонецЕсли;
				
				НоваяСтрока.Признак = ПризнакиТоваров.Иное;
				
			КонецЕсли;
		КонецЦикла;
		
		Если СуммаНалога.БезНДС = Истина Тогда
			СуммаНалога.Сумма = Неопределено;
		Иначе
			СуммаНалога.БезНДС = Неопределено;
		КонецЕсли;
		
		ТекстОшибки = НСтр("ru = 'Не удалось заполнить итоговые стоимостные показатели. Возможные причины:
		|	- не заполнена табличная часть ""Авансы""
		|	- не заполнены колонки ""Сумма"", ""НДС""'");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ТаблицаСчетаФактуры.ВсегоКОплате.СтоимостьБезНалога", ТаблицаАвансы.Итог("СтоимостьБезНалога"), ТекстОшибки);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ТаблицаСчетаФактуры.ВсегоКОплате.СтоимостьСНалогом", ТаблицаАвансы.Итог("СтоимостьСНалогом"), ТекстОшибки);
		
		ЭлектронноеВзаимодействие.ЗагрузитьСтруктуруВГруппуДерева(ДеревоДанных, СуммаНалога, "ТаблицаСчетаФактуры.ВсегоКОплате.СуммаНалога");
		ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных, "ТаблицаСчетаФактуры.ВсегоКОплате.СуммаНалога", ТекстОшибки);
		
		// Обработка ошибки через механизм сообщений пользователю.
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаАвансы,
			"СтоимостьБезНалога", ВыборкаШапки.Ссылка, "Объект.Товары.Сумма",, "НомерСтроки");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаАвансы,
			"СтоимостьСНалогом", ВыборкаШапки.Ссылка, "Объект.Товары.Сумма",, "НомерСтроки");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаАвансы,
			"НалоговаяСтавка", ВыборкаШапки.Ссылка, "Объект.Товары.СтавкаНДС",, "НомерСтроки");
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаАвансы, "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях");
		
	Иначе
		
		СведенияОТоварах = Новый ТаблицаЗначений;
		СведенияОТоварах.Колонки.Добавить("НомерСтроки");
		СведенияОТоварах.Колонки.Добавить("НомерСтрокиИсходногоДокумента");
		СведенияОТоварах.Колонки.Добавить("ИдентификаторСтроки");
		СведенияОТоварах.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(2000)));
