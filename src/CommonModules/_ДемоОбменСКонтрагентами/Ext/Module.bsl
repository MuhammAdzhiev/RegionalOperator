Функция СоздатьОбъектXDTO(ОбъектXDTO, ИмяСвойства)
	
	ТипОбъектаXDTO = ОбъектXDTO.Свойства().Получить(ИмяСвойства).Тип;
	Возврат ФабрикаXDTO.Создать(ТипОбъектаXDTO);
	
КонецФункции

Процедура ЗаполнитьСведенияОбУчастникеАктаСверки(ДокументXDTO, Участник)
	
	СведенияОбУчастнике = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(Участник, СведенияОбУчастнике);
	
	УчастникXDTO = СоздатьОбъектXDTO(ДокументXDTO, "Участник");
	УчастникXDTO.Установить("Наим", СведенияОбУчастнике.СокращенноеНаименование);
	УчастникXDTO.Установить("Роль", ?(ТипЗнч(Участник) = Тип("СправочникСсылка.Организации"),
		"Отправитель", "Получатель"));
	
	Если СведенияОбУчастнике.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		РегистрационныеСведенияXDTO = СоздатьОбъектXDTO(УчастникXDTO, "СвЮЛ");
		РегистрационныеСведенияXDTO.Установить("Наим", СведенияОбУчастнике.СокращенноеНаименование);
		РегистрационныеСведенияXDTO.Установить("ИНН",  СведенияОбУчастнике.ИНН);
		РегистрационныеСведенияXDTO.Установить("КПП",  СведенияОбУчастнике.КПП);
		УчастникXDTO.Установить("СвЮЛ", РегистрационныеСведенияXDTO);
	Иначе
		РегистрационныеСведенияXDTO = СоздатьОбъектXDTO(УчастникXDTO, "СвФЛ");
		РегистрационныеСведенияXDTO.Установить("Фамилия",  СведенияОбУчастнике.Фамилия);
		РегистрационныеСведенияXDTO.Установить("Имя",      СведенияОбУчастнике.Имя);
		РегистрационныеСведенияXDTO.Установить("Отчество", СведенияОбУчастнике.Отчество);
		РегистрационныеСведенияXDTO.Установить("ИНН",      СведенияОбУчастнике.ИНН);
		УчастникXDTO.Установить("СвФЛ", РегистрационныеСведенияXDTO);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОбУчастнике.Телефоны) Тогда
		КонтактXDTO = СоздатьОбъектXDTO(УчастникXDTO, "Контакт");
		КонтактXDTO.Установить("Телефон", СведенияОбУчастнике.Телефоны);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СведенияОбУчастнике.ЮридическийАдресXML) Тогда
		ДокументXDTO.Участник.Добавить(УчастникXDTO);
		Возврат;
	КонецЕсли;
	
	АдресXDTO = СоздатьОбъектXDTO(УчастникXDTO, "Адрес");
	АдресXDTO.Установить("Тип", "Юридический");
	
	Параметры = Новый Структура("ПроверитьАдрес", Ложь);
	АдресСтруктурой = РаботаСАдресами.СведенияОбАдресе(СведенияОбУчастнике.ЮридическийАдресXML, Параметры);
	СоответствуетФорматуКЛАДР = АдресСоответствуетФорматуКЛАДР(АдресСтруктурой);
	
	Если АдресСтруктурой.КодСтраны = "643" И СоответствуетФорматуКЛАДР Тогда // Россия
		АдресСтруктуройXDTO = СоздатьОбъектXDTO(АдресXDTO, "АдрРФ");
		
		АдресСтруктуройXDTO.Установить("Индекс", АдресСтруктурой.Индекс);
		АдресСтруктуройXDTO.Установить("КодРегион", АдресСтруктурой.КодРегиона);
		
		ПредставлениеЭлемента = ПредставлениеАдресногоЭлементаПоСоставляющим(
			АдресСтруктурой.Район, АдресСтруктурой.РайонСокращение);
		АдресСтруктуройXDTO.Установить("Район", ПредставлениеЭлемента);
		
		ПредставлениеЭлемента = ПредставлениеАдресногоЭлементаПоСоставляющим(
			АдресСтруктурой.Город, АдресСтруктурой.ГородСокращение);
		АдресСтруктуройXDTO.Установить("Город", ПредставлениеЭлемента);
		
		ПредставлениеЭлемента = ПредставлениеАдресногоЭлементаПоСоставляющим(
			АдресСтруктурой.НаселенныйПункт, АдресСтруктурой.НаселенныйПунктСокращение);
		АдресСтруктуройXDTO.Установить("НаселПункт", ПредставлениеЭлемента);
		
		ПредставлениеЭлемента = ПредставлениеАдресногоЭлементаПоСоставляющим(
			АдресСтруктурой.Улица, АдресСтруктурой.УлицаСокращение);
		АдресСтруктуройXDTO.Установить("Улица", ПредставлениеЭлемента);
		
		ПредставлениеЭлемента = ПредставлениеАдресногоЭлементаПоСоставляющим(
			НРег(АдресСтруктурой.Здание.ТипЗдания), "№", АдресСтруктурой.Здание.Номер);
		АдресСтруктуройXDTO.Установить("Дом", ПредставлениеЭлемента);
		
		Если АдресСтруктурой.Корпуса.Количество() Тогда
			ПредставлениеЭлемента = ПредставлениеАдресногоЭлементаПоСоставляющим(НРег(АдресСтруктурой.Корпуса[0].ТипКорпуса),
				АдресСтруктурой.Корпуса[0].Номер);
		Иначе
			ПредставлениеЭлемента = "";
		КонецЕсли;
		АдресСтруктуройXDTO.Установить("Корпус", ПредставлениеЭлемента);
		
		Если АдресСтруктурой.Помещения.Количество() Тогда
			ПредставлениеЭлемента = ПредставлениеАдресногоЭлементаПоСоставляющим(НРег(АдресСтруктурой.Помещения[0].ТипПомещения),
				АдресСтруктурой.Помещения[0].Номер);
		Иначе
			ПредставлениеЭлемента = "";
		КонецЕсли;
		АдресСтруктуройXDTO.Установить("Кварт", ПредставлениеЭлемента);
		
		АдресXDTO.Установить("АдрРФ", АдресСтруктуройXDTO);
	Иначе
		АдресПроизвольныйXDTO = СоздатьОбъектXDTO(АдресXDTO, "АдрИно");
		АдресПроизвольныйXDTO.Установить("КодСтр", АдресСтруктурой.КодСтраны);
		АдресПроизвольныйXDTO.Установить("АдрТекст", АдресСтруктурой.Представление);
		АдресXDTO.Установить("АдрИно", АдресПроизвольныйXDTO);
	КонецЕсли;
	
	УчастникXDTO.Адрес.Добавить(АдресXDTO);
	
	ДокументXDTO.Участник.Добавить(УчастникXDTO);
	
КонецПроцедуры

Функция АдресСоответствуетФорматуКЛАДР(СведенияОбАдресе)
	
	Соответствует = Истина;
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Округ)
		Или ЗначениеЗаполнено(СведенияОбАдресе.МуниципальныйРайон)
		Или ЗначениеЗаполнено(СведенияОбАдресе.Поселение)
		Или ЗначениеЗаполнено(СведенияОбАдресе.ВнутригородскойРайон)
		Или ЗначениеЗаполнено(СведенияОбАдресе.Территория)
		Или ЗначениеЗаполнено(СведенияОбАдресе.ДополнительнаяТерритория)
		Или ЗначениеЗаполнено(СведенияОбАдресе.ЭлементДополнительнойТерритории)
		Или НРег(СведенияОбАдресе.Здание.ТипЗдания) <> "дом"
		Или СведенияОбАдресе.Корпуса.Количество() > 1
		Или СведенияОбАдресе.Помещения.Количество() > 1 Тогда
		
		Соответствует = Ложь
	КонецЕсли;
	
	Возврат Соответствует;
	
КонецФункции

Функция ПредставлениеАдресногоЭлементаПоСоставляющим(ПервыйЭлемент = "", ВторойЭлемент = "", ТретийЭлемент = "")

	МассивСоставляющих = Новый Массив;
	Если ЗначениеЗаполнено(ПервыйЭлемент) Тогда
		МассивСоставляющих.Добавить(ПервыйЭлемент);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВторойЭлемент) Тогда
		МассивСоставляющих.Добавить(ВторойЭлемент);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТретийЭлемент) Тогда
		МассивСоставляющих.Добавить(ТретийЭлемент);
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСоставляющих, " ");

КонецФункции

Функция ПредставлениеАдресаАктаСверки(АдресXDTO)
	
	Если АдресXDTO.АдрРФ <> Неопределено Тогда
		МассивСтрок = Новый Массив;
		
		АдресСтруктурой = АдресXDTO.АдрРФ;
		
		Если ЗначениеЗаполнено(АдресСтруктурой.Индекс) Тогда
			МассивСтрок.Добавить(АдресСтруктурой.Индекс);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АдресСтруктурой.КодРегион) Тогда
			НазваниеРегиона = АдресныйКлассификатор.НаименованиеРегионаПоКоду(АдресСтруктурой.КодРегион);;
			МассивСтрок.Добавить(НазваниеРегиона);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АдресСтруктурой.Район) Тогда
			МассивСтрок.Добавить(АдресСтруктурой.Район);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АдресСтруктурой.Город) Тогда
			МассивСтрок.Добавить(АдресСтруктурой.Город);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АдресСтруктурой.НаселПункт) Тогда
			МассивСтрок.Добавить(АдресСтруктурой.НаселПункт);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АдресСтруктурой.Улица) Тогда
			МассивСтрок.Добавить(АдресСтруктурой.Улица);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АдресСтруктурой.Дом) Тогда
			МассивСтрок.Добавить(АдресСтруктурой.Дом);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АдресСтруктурой.Корпус) Тогда
			МассивСтрок.Добавить(АдресСтруктурой.Корпус);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АдресСтруктурой.Кварт) Тогда
			МассивСтрок.Добавить(АдресСтруктурой.Кварт);
		КонецЕсли;
		
		ПредставлениеАдреса = СтрСоединить(МассивСтрок, ", ");
		
	ИначеЕсли АдресXDTO.АдрИно <> Неопределено Тогда
		ПредставлениеАдреса = АдресXDTO.АдрИно.АдрТекст;
		
	КонецЕсли;
	
	Возврат ПредставлениеАдреса;
	
КонецФункции

Процедура ЗаписатьДокумент(ДокументОбъект, РежимЗаписиПроведение = Истина)
	
	ДокументОбъект.ДополнительныеСвойства.Вставить("ПроверитьЗаполнениеБезВыводаОшибок");
	
	Если РежимЗаписиПроведение
		И (ДокументОбъект.Проведен ИЛИ (ДокументОбъект.ЭтоНовый() И ДокументОбъект.ПроверитьЗаполнение())) Тогда
		ДокументОбъект.ОбменДанными.Загрузка = Ложь;
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
КонецПроцедуры

Функция ОтчетОСписанииКомиссионногоТовара(СтрокаДляЗагрузки, ДеревоРазбора, СсылкаНаВладельца)
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	ВозвращаемоеЗначение = Неопределено;
	
	ДанныеДляЗагрузки = СтруктураДляОтчетОПродажах(СтрокаДляЗагрузки, ДеревоРазбора);
	
	ДанныеЗаполнения = ДанныеДляЗагрузки.Шапка;
	
	Попытка
		
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда // получены изменения по существующему документу
			
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			
		Иначе // попробуем найти по РеквизитыИБ и РеквизитыИБКонтрагента
			
			УстановитьПривилегированныйРежим(Истина);
			
			НайденныйДок = Неопределено;
			Если ДанныеЗаполнения.Свойство("Контрагент") Тогда
				РеквизитыИБКонтрагента = Новый Структура;
				Если ДанныеЗаполнения.Свойство("НомерПоДаннымПоставщика")
					И ЗначениеЗаполнено(ДанныеЗаполнения.НомерПоДаннымПоставщика) Тогда
					
					РеквизитыИБКонтрагента.Вставить("НомерПоДаннымПоставщика", ДанныеЗаполнения.НомерПоДаннымПоставщика);
				КонецЕсли;
				Если ДанныеЗаполнения.Свойство("ДатаПоДаннымПоставщика")
					И ЗначениеЗаполнено(ДанныеЗаполнения.ДатаПоДаннымПоставщика) Тогда
					
					РеквизитыИБКонтрагента.Вставить("ДатаПоДаннымПоставщика", ДанныеЗаполнения.ДатаПоДаннымПоставщика);
				КонецЕсли;
				РеквизитыИБ = Новый Структура;
				Если ДанныеЗаполнения.Свойство("НомерПоДаннымПокупателя")
					И ЗначениеЗаполнено(ДанныеЗаполнения.НомерПоДаннымПокупателя) Тогда
					
					РеквизитыИБ.Вставить("Номер", ДанныеЗаполнения.НомерПоДаннымПокупателя);
				КонецЕсли;
				Если ДанныеЗаполнения.Свойство("ДатаПоДаннымПокупателя")
					И ЗначениеЗаполнено(ДанныеЗаполнения.ДатаПоДаннымПокупателя) Тогда
					
					РеквизитыИБ.Вставить("Дата", ДанныеЗаполнения.ДатаПоДаннымПокупателя);
				КонецЕсли;
				Если РеквизитыИБ.Количество() > 0 ИЛИ РеквизитыИБКонтрагента.Количество() > 0 Тогда // есть еще реквизиты поиска, кроме Контрагента
					НайденныйДок = НайтиДокумент(ТипыДокументов.ОтчетОСписанииКомиссионногоТовара, ДанныеЗаполнения.Контрагент, РеквизитыИБ,
																															РеквизитыИБКонтрагента);
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НайденныйДок) Тогда // нашли документ, вернем ссылку, чтоб просто привязать ЭД
				ДокументОбъект = НайденныйДок.ПолучитьОбъект();
				Возврат ДокументОбъект.Ссылка;
			КонецЕсли;
			
			ДокументОбъект = Документы._ДемоОперация.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
			ДокументОбъект.Заполнить(ДанныеЗаполнения);
			
		КонецЕсли;
		
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.НаправлениеЭД = Перечисления.НаправленияЭДО.Входящий;
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		ДокументОбъект.ВидЭД = ТипыДокументов.ОтчетОСписанииКомиссионногоТовара;
		
		// Заполним значения реквизитов шапки
		ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
		
		// Загрузим табличные части
		ДокументОбъект.Товары.Загрузить(ДанныеДляЗагрузки.Товары);
		ДокументОбъект.ЗаполнитьСуммуДокумента();
		
		Если ДокументОбъект.ЭтоНовый() Тогда
			ДокументОбъект.УстановитьНовыйНомер();
		КонецЕсли;
		
		ЗаписатьДокумент(ДокументОбъект);
		ВозвращаемоеЗначение = ДокументОбъект.Ссылка;
		
	Исключение
		
		ВидОперации = НСтр("ru = 'Заполнение документа на основе ЭД'");
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ПодробныйТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ЭлектронноеВзаимодействие.ОбработатьОшибку(ВидОперации, ПодробныйТекстОшибки,,, СсылкаНаВладельца);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

#Область ПередачаТоваровЧерезОператораЭДО

// Возвращает структуру адреса участника.
// 
// Параметры:
//  СведенияОбУчастнике - см. ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица.
//  ПриоритетыВидовКонтактнойИнформации - Массив из Строка.
//  ЭтоСведенияОбОрганизации - Булево.
//  ВерсияФормата - Строка.
// 
// Возвращаемое значение:
//  Структура:
//  	* ТипАдреса - Структура:
//  		** АдресИнформация - Структура:
//  			*** КодСтраны - Строка
//  			*** НаименованиеСтраны - Строка
//  			*** АдресТекст - Строка
//  	* АдресИнформация - Структура:
//  		** КодСтраны - Строка
//  		** АдресТекст - Строка
//  	* АвтоматическиЗаполняемый - Структура:
//  		** ОбъектКонтактнойИнформации - СправочникСсылка - ссылка на физическое или юридическое лицо
//  		** ВидКонтактнойИнформации - СправочникСсылка.ВидыКонтактнойИнформации
//  	* ТипАдреса - Структура:
//  		** АвтоматическиЗаполняемый - Структура:
//  			*** ОбъектКонтактнойИнформации - СправочникСсылка - ссылка на физическое или юридическое лицо
//  			*** ВидКонтактнойИнформации - СправочникСсылка.ВидыКонтактнойИнформации
//
Функция ДанныеАдресаУчастникаУПД(СведенияОбУчастнике, ПриоритетыВидовКонтактнойИнформации, ЭтоСведенияОбОрганизации, ВерсияФормата = "")
	
	ДанныеАдреса = Новый Структура;
	ПоддерживаемыеФорматы = ФорматыЭДО_ФНС.ПоддерживаемыеФорматы();
	
	Если СведенияОбУчастнике.Свойство("ПроизвольныйАдрес") Тогда
		СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(СведенияОбУчастнике.ПроизвольныйАдрес);
		
		Если ВерсияФормата = ПоддерживаемыеФорматы.УПД_5_02.ИнформацияПродавца Тогда
			АдресИнформация = Новый Структура();
			АдресИнформация.Вставить("КодСтраны", СведенияОбАдресе.КодСтраны);
			АдресИнформация.Вставить("НаименованиеСтраны", СведенияОбАдресе.Страна);
			АдресИнформация.Вставить("АдресТекст", СведенияОбАдресе.Представление);
			ДанныеАдреса.Вставить("ТипАдреса", Новый Структура("АдресИнформация", АдресИнформация));
		Иначе		
			ДанныеАдреса.Вставить("АдресИнформация", Новый Структура);
			ДанныеАдреса.АдресИнформация.Вставить("КодСтраны", СведенияОбАдресе.КодСтраны);
			ДанныеАдреса.АдресИнформация.Вставить("АдресТекст", СведенияОбАдресе.Представление);
		КонецЕсли;
		
		Возврат ДанныеАдреса;
	КонецЕсли;
	
	ВидКонтактнойИнформации = ?(ЭтоСведенияОбОрганизации,
		Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,
		Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
	
	Если ЗначениеЗаполнено(ПриоритетыВидовКонтактнойИнформации) Тогда
		
		Для Каждого ВидКИ Из ПриоритетыВидовКонтактнойИнформации Цикл
			
			Если ЗначениеЗаполнено(СведенияОбУчастнике[ВидКИ]) И ВидКИ = "ПочтовыйАдрес" Тогда
				ВидКонтактнойИнформации = ?(ЭтоСведенияОбОрганизации,
					Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресОрганизации,
					Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресКонтрагента);
					Прервать;
			ИначеЕсли ЗначениеЗаполнено(СведенияОбУчастнике[ВидКИ]) И ВидКИ = "ФактическийАдрес" Тогда
				ВидКонтактнойИнформации = ?(ЭтоСведенияОбОрганизации,
					Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации,
					Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента);
					Прервать;
			ИначеЕсли ЗначениеЗаполнено(СведенияОбУчастнике[ВидКИ]) И ВидКИ = "ЮридическийАдрес" Тогда
				ВидКонтактнойИнформации = ?(ЭтоСведенияОбОрганизации,
					Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,
					Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
					Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли; 
	
	КлючДанных = Неопределено;
	СведенияОбУчастнике.Свойство("Ссылка", КлючДанных);
	ДанныеАдреса.Вставить("АвтоматическиЗаполняемый", Новый Структура);
	ДанныеАдреса.АвтоматическиЗаполняемый.Вставить("ОбъектКонтактнойИнформации", КлючДанных);
	ДанныеАдреса.АвтоматическиЗаполняемый.Вставить("ВидКонтактнойИнформации", ВидКонтактнойИнформации);
	
	Если ВерсияФормата = ПоддерживаемыеФорматы.УПД_5_02.ИнформацияПродавца Тогда
		ДанныеАдреса.Вставить("ТипАдреса", Новый Структура);
		ДанныеАдреса.ТипАдреса.Вставить("АвтоматическиЗаполняемый", ДанныеАдреса.АвтоматическиЗаполняемый);
	КонецЕсли;
	
	Возврат ДанныеАдреса;
	
КонецФункции

Функция ОрганизацияПоДаннымЭД(ДеревоДанных, ВидУчастника)
	
	Организация = Неопределено;
	Если ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
		ИНН = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
		КПП = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
		КПП = ?(КПП = Неопределено, "", КПП);
		Запрос = Новый Запрос();
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	Организации.Ссылка
			|ИЗ
			|	Справочник.Организации КАК Организации
			|ГДЕ
			|	Организации.ИНН = &ИНН
			|	И Организации.КПП = &КПП
			|	И НЕ Организации.ПометкаУдаления";
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Запрос.УстановитьПараметр("КПП", КПП);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Организация = Выборка.Ссылка;
		КонецЕсли;
		
	ИначеЕсли ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
		ИНН = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
		Запрос = Новый Запрос();
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	Организации.Ссылка
			|ИЗ
			|	Справочник.Организации КАК Организации
			|ГДЕ
			|	Организации.ИНН = &ИНН
			|	И НЕ Организации.ПометкаУдаления";
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Организация = Выборка.Ссылка;
		КонецЕсли;
		
	ИначеЕсли ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
		НаименованиеПолное = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
		Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
			Запрос = Новый Запрос();
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	Организации.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.Организации КАК Организации
				|ГДЕ
				|	Организации.НаименованиеПолное = &НаименованиеПолное
				|	И НЕ Организации.ПометкаУдаления";
			Запрос.УстановитьПараметр("НаименованиеПолное", НаименованиеПолное);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Организация = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Организация;
	
КонецФункции

Функция ОснованияСчетаФактуры(Знач СчетФактура)
	
	Основания = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОснованияСФ.ДокументОснование КАК ПервичныйДокумент
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК ОснованияСФ
	|ГДЕ
	|	ОснованияСФ.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СчетФактура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Основания.Добавить(Выборка.ПервичныйДокумент);
	КонецЕсли;
	
	Возврат Основания;
	
КонецФункции

// Возвращает структуру данных участника.
//
// Параметры:
//     СведенияОбУчастнике - см. ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица
//     ПриоритетыВидовКонтактнойИнформации - Массив из Строка
//     ЭтоЭлектронноеАктированиеЕИС - Булево
//     ВерсияФормата - Строка
// 
// Возвращаемое значение:
//     Структура:
//     	* СведенияОбУчастнике - см. ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица
//     	* ТипУчастника - Структура:
//     		** ЮЛ - Структура:
//     			*** НаименованиеОрганизации - Строка
//     			*** ИНН - Строка
//     			*** КПП - Строка
//     		** ИЛ - Структура:
//     			*** НаименованиеОрганизации - Строка
//     			*** Статус - Строка
//     			*** КодСтраны - Строка
//     			*** НаименованиеСтраны - Строка
//     		** ИП - Структура:
//     			*** ИНН - Строка
//     			*** Фамилия - Строка
//     			*** Имя - Строка
//     			*** Отчество - Строка
//     			*** СвидетельствоОГосРегистрации - Строка
//     			*** ФИО - Структура:
//     				**** Фамилия - Строка
//     				**** Имя - Строка
//     				**** Отчество - Строка
//     	* Адрес - Структура - см. ДанныеАдресаУчастникаУПД
//     	* КонтактныеСведения - Структура:
//     		** Телефоны - ТаблицаЗначений:
//     			*** Телефон - Строка
//     		** ЭлектронныеПочты - ТаблицаЗначений:
//     			*** ЭлектроннаяПочта - Строка
//     	* БанковскиеРеквизиты - Структура:
//     		** НомерСчета - Строка
//     		** НаименованиеБанка - Строка
//     		** БИКБанка - Строка
//     		** КорреспондентскийСчетБанка - Строка
//     	* КодОКПО - Строка
//
Функция ПолучитьДанныеУчастникаУПД(Знач СведенияОбУчастнике, Знач ПриоритетыВидовКонтактнойИнформации = Неопределено,
	ЭтоЭлектронноеАктированиеЕИС = Ложь, ВерсияФормата = "")
	
	КлючДанных = Неопределено;
	СведенияОбУчастнике.Свойство("Ссылка", КлючДанных);
	
	ЭтоСведенияОбОрганизации = ТипЗнч(СведенияОбУчастнике.Ссылка) = Тип("СправочникСсылка.Организации");
	
	Данные = Новый Структура("СведенияОбУчастнике", СведенияОбУчастнике);	
	Данные.Вставить("ТипУчастника", Новый Структура);
	
	ПоддерживаемыеФорматы = ФорматыЭДО_ФНС.ПоддерживаемыеФорматы();
	
	Если ЭтоЭлектронноеАктированиеЕИС Тогда
		Если ЭтоСведенияОбОрганизации Тогда
			МодульЭлектронноеАктированиеЕИС = ОбщегоНазначения.ОбщийМодуль("ЭлектронноеАктированиеЕИС");
			НаименованиеОрганизации = МодульЭлектронноеАктированиеЕИС.НаименованиеОрганизацииДляЭД(
						СведенияОбУчастнике.Ссылка);
		Иначе
			НаименованиеОрганизации = СведенияОбУчастнике.ПолноеНаименование;
		КонецЕсли;
	Иначе
		НаименованиеОрганизации = СведенияОбУчастнике.СокращенноеНаименование;
	КонецЕсли;
	
	Если СведенияОбУчастнике.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		
		Данные.ТипУчастника.Вставить("ЮЛ", Новый Структура);
		Данные.ТипУчастника.ЮЛ.Вставить("НаименованиеОрганизации", НаименованиеОрганизации);
		Данные.ТипУчастника.ЮЛ.Вставить("ИНН", СведенияОбУчастнике.ИНН);
		Данные.ТипУчастника.ЮЛ.Вставить("КПП", СведенияОбУчастнике.КПП);
		
	ИначеЕсли СведенияОбУчастнике.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент Тогда
		
		Данные.ТипУчастника.Вставить("ИЛ", Новый Структура);
		Данные.ТипУчастника.ИЛ.Вставить("НаименованиеОрганизации", НаименованиеОрганизации);
		
		Если ВерсияФормата = ПоддерживаемыеФорматы.УПД_5_02.ИнформацияПродавца Тогда
			Статусы = Новый Структура;
			Статусы.Вставить("Организация", "ИО");
			Статусы.Вставить("Гражданин", "ИГ");
			Данные.ТипУчастника.ИЛ.Вставить("Статус", Статусы.Организация);
			
			Если ЗначениеЗаполнено(СведенияОбУчастнике.ЮридическийАдресXML) Тогда
				СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(СведенияОбУчастнике.ЮридическийАдресXML);
				Данные.ТипУчастника.ИЛ.Вставить("КодСтраны", СведенияОбАдресе.КодСтран);
				Данные.ТипУчастника.ИЛ.Вставить("НаименованиеСтраны", СведенияОбАдресе.Страна);
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		Данные.ТипУчастника.Вставить("ИП", Новый Структура);
		Данные.ТипУчастника.ИП.Вставить("ИНН", СведенияОбУчастнике.ИНН);
		Данные.ТипУчастника.ИП.Вставить("Фамилия", СведенияОбУчастнике.Фамилия);
		Данные.ТипУчастника.ИП.Вставить("Имя", СведенияОбУчастнике.Имя);
		Данные.ТипУчастника.ИП.Вставить("Отчество", СведенияОбУчастнике.Отчество);
		
		Если ЭтоСведенияОбОрганизации Тогда
			
			ШаблонСообщения = НСтр("ru = 'Свидетельство №%1 от %2'");
			СвидетельствоДатаВыдачи = Формат(СведенияОбУчастнике.СвидетельствоДатаВыдачи, "ДЛФ=D");
			
			Свидетельство = СтрШаблон(ШаблонСообщения, СведенияОбУчастнике.СвидетельствоСерияНомер,
				СвидетельствоДатаВыдачи);
				
			Данные.ТипУчастника.ИП.Вставить("СвидетельствоОГосРегистрации", Свидетельство);
					
		КонецЕсли;
		
		Если ВерсияФормата = ПоддерживаемыеФорматы.УПД_5_02.ИнформацияПродавца Тогда
			Данные.ТипУчастника.ИП.Вставить("ФИО", Новый Структура("Фамилия, Имя, Отчество"));
			ЗаполнитьЗначенияСвойств(Данные.ТипУчастника.ИП.ФИО, Данные.ТипУчастника.ИП);
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеАдреса = ДанныеАдресаУчастникаУПД(СведенияОбУчастнике, ПриоритетыВидовКонтактнойИнформации,
		ЭтоСведенияОбОрганизации, ВерсияФормата);
	Если ЗначениеЗаполнено(ДанныеАдреса) Тогда
		Данные.Вставить("Адрес", ДанныеАдреса);
	КонецЕсли;
	
	Данные.Вставить("КонтактныеСведения", Новый Структура);
	
	Телефон = "";
	Если СведенияОбУчастнике.Свойство("Телефоны", Телефон) И ЗначениеЗаполнено(Телефон) Тогда
		Данные.КонтактныеСведения.Вставить("Телефон", Телефон);
	
		Если ВерсияФормата = ПоддерживаемыеФорматы.УПД_5_02.ИнформацияПродавца Тогда
			Телефоны = Новый ТаблицаЗначений;
			Телефоны.Колонки.Добавить("Телефон");
			НоваяСтрока = Телефоны.Добавить();
			НоваяСтрока.Телефон = Телефон;
			Данные.КонтактныеСведения.Вставить("Телефоны", Телефоны);
		КонецЕсли;
	
	КонецЕсли;
	
	ЭлектроннаяПочта = "";
	Если СведенияОбУчастнике.Свойство("ЭлектроннаяПочта", ЭлектроннаяПочта) И ЗначениеЗаполнено(ЭлектроннаяПочта) Тогда
		Данные.КонтактныеСведения.Вставить("ЭлектроннаяПочта", ЭлектроннаяПочта);
	
		Если ВерсияФормата = ПоддерживаемыеФорматы.УПД_5_02.ИнформацияПродавца Тогда
			ЭлектронныеПочты = Новый ТаблицаЗначений;
			ЭлектронныеПочты.Колонки.Добавить("ЭлектроннаяПочта");
			НоваяСтрока = ЭлектронныеПочты.Добавить();
			НоваяСтрока.ЭлектроннаяПочта = ЭлектроннаяПочта;
			Данные.КонтактныеСведения.Вставить("ЭлектронныеПочты", ЭлектронныеПочты);
		КонецЕсли;
	
	КонецЕсли;
	
	Данные.Вставить("БанковскиеРеквизиты", Новый Структура);
	
	НомерСчета = "";
	Если СведенияОбУчастнике.Свойство("НомерСчета", НомерСчета) И ЗначениеЗаполнено(НомерСчета) Тогда
		
		Данные.БанковскиеРеквизиты.Вставить("НомерСчета", НомерСчета);
		
		Банк = ""; 
		БИК = ""; 
		КоррСчет = "";
		
		Если СведенияОбУчастнике.Свойство("Банк", Банк) И ЗначениеЗаполнено(Банк) Тогда
			
			Данные.БанковскиеРеквизиты.Вставить("НаименованиеБанка", Банк);
			
		КонецЕсли;
		Если СведенияОбУчастнике.Свойство("БИК", БИК) И ЗначениеЗаполнено(БИК) Тогда
			
			Данные.БанковскиеРеквизиты.Вставить("БИКБанка", БИК);
			
		КонецЕсли;
		Если СведенияОбУчастнике.Свойство("КоррСчет", КоррСчет) И ЗначениеЗаполнено(КоррСчет) Тогда
			
			Данные.БанковскиеРеквизиты.Вставить("КорреспондентскийСчетБанка", КоррСчет);
			
		КонецЕсли;
	КонецЕсли;
	
	КодПоОКПО = "";
	Если СведенияОбУчастнике.Свойство("КодПоОКПО", КодПоОКПО) И ЗначениеЗаполнено(КодПоОКПО) Тогда
		
		Данные.Вставить("КодОКПО", КодПоОКПО);
		
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции 

Функция ПредставлениеДокументаОбОтгрузке(НомераСтрок, НомерДокумента, ДатаДокумента)
	
	ШаблонСообщения = НСтр("ru = '№ п/п %1 № %2 от %3 г.'");
	ДатаДокументаПоФормату = Формат(ДатаДокумента, "ДФ=dd.MM.yyyy"); // АПК:1367 Заполнение электронного документа
	
	Возврат СтрШаблон(ШаблонСообщения, НомераСтрок, НомерДокумента, ДатаДокументаПоФормату);
	
КонецФункции

Функция УПДБезНДС(ДеревоДанных)
	
	СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ПолныйПуть", "СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
	ПараметрыОтбора.Вставить("Значение", Перечисления.СтавкиНДС.БезНДС);
	Возврат СведенияОТоварах.Строки.Количество() =
		СведенияОТоварах.Строки.НайтиСтроки(ПараметрыОтбора, Истина).Количество();
	
КонецФункции

Процедура ВнестиСведенияОВыбытииМаркированныхТоваровВДеревоУПДУКД(ДеревоДанных, ВыборкаШапки)
	
	Если ЗначениеЗаполнено(ВыборкаШапки.СведенияОВыбытииМаркированныхТоваров) Тогда
		ОписаниеПоляСведенийОВыбытииМТ = ОбменСКонтрагентами.ОписаниеПоляСведенийОВыбытииМаркированныхТоваров();
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ОписаниеПоляСведенийОВыбытииМТ.ИмяРеквизита,
			ВыборкаШапки.СведенияОВыбытииМаркированныхТоваров);
	КонецЕсли;
	
КонецПроцедуры

// Добавляет обработку ошибок в таблицу участников УПД.
//
// Параметры:
//  ТаблицаУчастников - ТаблицаЗначений - см. ПолучитьТаблицуУчастниковУПД_5_02
//  ПутьКУчастнику - Строка
//  ВерсияФормата - Строка
//
Процедура ДобавитьОбработкуОшибокВТаблицуУчастниковУПД(ТаблицаУчастников, ПутьКУчастнику = "", ВерсияФормата = "")
	
	ПутьКПолю = ?(ЗначениеЗаполнено(ПутьКУчастнику), ПутьКУчастнику + ".", "");
	ПоддерживаемыеФорматы = ФорматыЭДО_ФНС.ПоддерживаемыеФорматы();
	
	Для каждого СтрокаТаблицы Из ТаблицаУчастников Цикл
		
		Сведения = СтрокаТаблицы.СведенияОбУчастнике;
		Если Не ЗначениеЗаполнено(Сведения) Тогда
			Продолжить;
		КонецЕсли;
		
		Участник = ?(ЗначениеЗаполнено(ПутьКУчастнику), СтрокаТаблицы[ПутьКУчастнику], СтрокаТаблицы);
		
		Если Участник.ТипУчастника.Свойство("ЮЛ") Тогда
			
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ЮЛ.НаименованиеОрганизации", Сведения.Ссылка, "Объект.НаименованиеПолное");
				
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ЮЛ.ИНН", Сведения.Ссылка, "Объект.ИНН");
				
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ЮЛ.КПП", Сведения.Ссылка, "Объект.КПП");
				
		ИначеЕсли Участник.ТипУчастника.Свойство("ИЛ") Тогда
			
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ИЛ.НаименованиеОрганизации", Сведения.Ссылка, "Объект.НаименованиеПолное");
				
		ИначеЕсли Участник.ТипУчастника.Свойство("ИП") Тогда
			
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ИП.ИНН", Сведения.Ссылка, "Объект.ИНН");
			
			Если ВерсияФормата = ПоддерживаемыеФорматы.УПД_5_02.ИнформацияПродавца Тогда
				ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
					ПутьКПолю + "ТипУчастника.ИП.ФИО.Фамилия", Сведения.Ссылка, "Объект.НаименованиеПолное");
				
				ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
					ПутьКПолю + "ТипУчастника.ИП.ФИО.Имя", Сведения.Ссылка, "Объект.НаименованиеПолное");
					
				ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
					ПутьКПолю + "ТипУчастника.ИП.ФИО.Отчество", Сведения.Ссылка, "Объект.НаименованиеПолное");	
			Иначе				
				ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
					ПутьКПолю + "ТипУчастника.ИП.Фамилия", Сведения.Ссылка, "Объект.НаименованиеПолное");
					
				ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
					ПутьКПолю + "ТипУчастника.ИП.Имя", Сведения.Ссылка, "Объект.НаименованиеПолное");
					
				ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
					ПутьКПолю + "ТипУчастника.ИП.Отчество", Сведения.Ссылка, "Объект.НаименованиеПолное");
			КонецЕсли;
			
			Если ТипЗнч(Сведения.Ссылка) = Тип("СправочникСсылка.Организации") Тогда				
				ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
					ПутьКПолю + "ТипУчастника.ИП.СвидетельствоОГосРегистрации", Сведения.Ссылка, 
						"Объект.СвидетельствоСерияНомер");				
			КонецЕсли;
			
		КонецЕсли;
		
		ПостфиксПоляАдрес = ?(ТипЗнч(Сведения.Ссылка) = Тип("СправочникСсылка.Контрагенты"), "Контрагента", 
			"Организации");
		
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
			ПутьКПолю + "Адрес.АвтоматическиЗаполняемый", 
			Сведения.Ссылка, "КонтактнаяИнформацияПолеЮрАдрес" + ПостфиксПоляАдрес);
			
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
			ПутьКПолю + "КонтактныеСведения.Телефон", Сведения.Ссылка);
			
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
			ПутьКПолю + "КонтактныеСведения.ЭлектроннаяПочта", Сведения.Ссылка);
			
		НомерСчета = "";
		Если Сведения.Свойство("НомерСчета", НомерСчета) И ЗначениеЗаполнено(НомерСчета) Тогда
			
			Если Сведения.Свойство("БанковскийСчетСсылка") Тогда
				ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
					ПутьКПолю + "БанковскиеРеквизиты.НомерСчета", Сведения.БанковскийСчетСсылка, "Объект.НомерСчета");
			КонецЕсли;
				
			Банк = ""; 
			БИК = ""; 
			КоррСчет = "";
			
			Если Сведения.Свойство("Банк", Банк) И ЗначениеЗаполнено(Банк) Тогда
				Если Сведения.Свойство("БанкСсылка") Тогда
					ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
						ПутьКПолю + "БанковскиеРеквизиты.НаименованиеБанка", Сведения.БанкСсылка, "Объект.Наименование");
				КонецЕсли;
			КонецЕсли;
			Если Сведения.Свойство("БИК", БИК) И ЗначениеЗаполнено(БИК) Тогда
				Если Сведения.Свойство("БанкСсылка") Тогда
					ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
						ПутьКПолю + "БанковскиеРеквизиты.БИКБанка", Сведения.БанкСсылка, "Объект.Код");
				КонецЕсли;
			КонецЕсли;
			Если Сведения.Свойство("КоррСчет", КоррСчет) И ЗначениеЗаполнено(КоррСчет) Тогда
				Если Сведения.Свойство("БанкСсылка") Тогда
					ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
						ПутьКПолю + "БанковскиеРеквизиты.КорреспондентскийСчетБанка", Сведения.БанкСсылка, 
							"Объект.КоррСчет");
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		КодПоОКПО = "";
		Если Сведения.Свойство("КодПоОКПО", КодПоОКПО) И ЗначениеЗаполнено(КодПоОКПО) Тогда
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "КодОКПО", Сведения.Ссылка, "Объект.КодПоОКПО");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ)
	
	СтруктураДанных = Неопределено;
	СтруктураДанных = Документы._ДемоПередачаТоваровМеждуОрганизациями.ПолучитьДанныеДляЭД(СсылкаНаОбъект);		
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();
	
	Если ВыборкаШапки.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		
		// Обработка ошибки с открытием формы по навигационной ссылке.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерИсправления");
		ИмяФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсправления", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления",
			ВыборкаШапки.НомерИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Дата");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления",
			ВыборкаШапки.ДатаИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента",
			ВыборкаШапки.НомерИсходногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ДатаИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",
			ВыборкаШапки.ДатаИсходногоДокумента, ПараметрыОбработкиОшибок);
		
	Иначе
		// Обработка ошибки с открытием формы по навигационной ссылке.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерЭД");
		ИмяФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект,
			"Объект.НомерЭД", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", ВыборкаШапки.Номер,
			ПараметрыОбработкиОшибок);
			
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.Дата", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",  ВыборкаШапки.Дата,
			ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.ИдентификаторГосКонтракта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ИдентификаторГосКонтракта");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", ВыборкаШапки.ИдентификаторГосКонтракта,
			ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки",
		ВыборкаШапки.ДокументОснование);

	ЗаполнитьДеревоДанныхУПД_2019(СтруктураДанных, СтруктураЭД, ДеревоДанных);		

	ЗаполнитьДокументыПодтвержденияОтгрузки(ДеревоДанных, СтруктураДанных);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ)
	
	СтруктураДанных = Документы.СчетФактураВыданный.ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();
	
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс Тогда
		СтруктураЭД.Функция = "СЧФ";
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СсылкаСчетаФактуры", СсылкаНаОбъект);
	
	Если ВыборкаШапки.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		
		// Обработка ошибки с открытием формы по навигационной ссылке.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерИсправления");
		ИмяФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсправления", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления",
			ВыборкаШапки.НомерИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Дата");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления",
			ВыборкаШапки.ДатаИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента",
			ВыборкаШапки.НомерИсходногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ДатаИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",
			ВыборкаШапки.ДатаИсходногоДокумента, ПараметрыОбработкиОшибок);
		
	Иначе
		// Обработка ошибки с открытием формы по навигационной ссылке.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерЭД");
		ИмяФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект,
			"Объект.НомерЭД", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", ВыборкаШапки.Номер,
			ПараметрыОбработкиОшибок);
			
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.Дата", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",  ВыборкаШапки.Дата,
			ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.ИдентификаторГосКонтракта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ИдентификаторГосКонтракта");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", ВыборкаШапки.ИдентификаторГосКонтракта,
			ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	ОбстоятельстваФормированияСФ = "";
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс Тогда
		ВидСчетаФактуры = "Авансовый";
		ОбстоятельстваФормированияСФ = "2";
	Иначе
		ВидСчетаФактуры = "Реализация";
		ОбстоятельстваФормированияСФ = "1";
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДополнительныеСведенияОбУчастниках.ОбстоятельстваФормированияСФ", ОбстоятельстваФормированияСФ);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры", ВидСчетаФактуры);
	
	МассивОснований = Новый Массив;
	Если СтруктураДанных.Свойство("ВыборкаОснований") Тогда
		
		ВыборкаОснований = СтруктураДанных.ВыборкаОснований;
		Пока ВыборкаОснований.Следующий() Цикл
			МассивОснований.Добавить(ВыборкаОснований.ДокументОснование);
		КонецЦикла;
		
		СтруктураДанныхОснований = Документы[МассивОснований[0].Метаданные().Имя].ПолучитьДанныеДляЭД(МассивОснований);
		Если СтруктураДанныхОснований.ВыборкаШапки.Следующий() Тогда
			ЗаполнитьДеревоДанныхУПД_2019(СтруктураДанныхОснований, СтруктураЭД, ДеревоДанных);
		КонецЕсли;
		
	Иначе
		ЗаполнитьДеревоДанныхУПД_2019(СтруктураДанных, СтруктураЭД, ДеревоДанных);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.СчетФактураОснование) Тогда
		МассивОснований.Добавить(ВыборкаШапки.СчетФактураОснование);
	КонецЕсли;
	
	ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		СсылкаНаОбъект, "Объект.СчетФактураОснование");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры",
		МассивОснований, ПараметрыОбработкиОшибок);
	
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактура Тогда
		ЗаполнитьДокументыПодтвержденияОтгрузки(ДеревоДанных, СтруктураДанных);
	КонецЕсли;
	
	Если СтруктураДанных.Свойство("ВыборкаПРД") Тогда
		
		ПлатежныеДокументы = Новый ТаблицаЗначений;
		ПлатежныеДокументы.Колонки.Добавить("НомерСтроки");
		ПлатежныеДокументы.Колонки.Добавить("НомерПРД");
		ПлатежныеДокументы.Колонки.Добавить("ДатаПРД");
		ПлатежныеДокументы.Колонки.Добавить("Сумма");
		
		ВыборкаПРД = СтруктураДанных.ВыборкаПРД;
		Пока ВыборкаПРД.Следующий() Цикл
			НоваяСтрока = ПлатежныеДокументы.Добавить();
			НоваяСтрока.НомерСтроки = ВыборкаПРД.НомерСтроки;
			НоваяСтрока.НомерПРД    = ВыборкаПРД.НомерПлатежноРасчетногоДокумента;
			НоваяСтрока.ДатаПРД     = ВыборкаПРД.ДатаПлатежноРасчетногоДокумента;
			НоваяСтрока.Сумма = ВыборкаПРД.Сумма;
		КонецЦикла;
		
		// Дополним таблицу платежных документов параметрами обработки ошибок.
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ПлатежныеДокументы,
			"НомерПРД", СсылкаНаОбъект, "Объект.ПлатежноРасчетныеДокументы.НомерПлатежноРасчетногоДокумента", , 
				"НомерСтроки");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ПлатежныеДокументы,
			"ДатаПРД", СсылкаНаОбъект, "Объект.ПлатежноРасчетныеДокументы.ДатаПлатежноРасчетногоДокумента", , 
				"НомерСтроки");
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ПлатежныеДокументы, 
			"ПлатежноРасчетныеДокументы");
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет данные электронного документа.
//
// Параметры:
//  СсылкаНаОбъект - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - основание для электронного документа.
//  СтруктураЭД - Структура - настройки заполнения данных:
//   * Функция - Строка
//   * ТипДокумента - Произвольный
//   * Отправитель - ОпределяемыйТип.Организация
//   * Получатель - ОпределяемыйТип.КонтрагентБЭД
//   * Договор - ОпределяемыйТип.ДоговорСКонтрагентомЭДО
//   * ВариантыЗаполненияПолей - Структура:
//    ** ТоварКод - Строка
//  ДеревоДанных - ДеревоЗначений - дерево электронного документа.
// 	Отказ - Булево - признак отказа от дальнейшего заполнения.
//
Процедура ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ)
	
	СтруктураДанных = Неопределено;
	СтруктураДанных = Документы._ДемоПередачаТоваровМеждуОрганизациями.ПолучитьДанныеДляЭД(СсылкаНаОбъект);		
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();
	ОбщийПуть = "СведенияОСчетеФактуре.";
	
	Если ВыборкаШапки.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		
		// Обработка ошибки с открытием формы по навигационной ссылке.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерИсправления");
		ИмяФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсправления", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "Исправление.НомерИсправления", ВыборкаШапки.НомерИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Дата");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "Исправление.ДатаИсправления", ВыборкаШапки.ДатаИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "НомерДокумента", ВыборкаШапки.НомерИсходногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ДатаИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "ДатаДокумента", ВыборкаШапки.ДатаИсходногоДокумента, ПараметрыОбработкиОшибок);
	Иначе
		// Обработка ошибки с открытием формы по навигационной ссылке.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерЭД");
		ИмяФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект,
			"Объект.НомерЭД", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "НомерДокумента", ВыборкаШапки.Номер, ПараметрыОбработкиОшибок);
			
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.Дата", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "ДатаДокумента",  ВыборкаШапки.Дата, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.ИдентификаторГосКонтракта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ИдентификаторГосКонтракта");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", ВыборкаШапки.ИдентификаторГосКонтракта,
			ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки",
		ВыборкаШапки.ДокументОснование);
		
	ПараметрыОбработкиОшибокДатыОтгрузки = Неопределено;
	Если Не ЗначениеЗаполнено(ВыборкаШапки.ДатаОтгрузки) Тогда
		ТекстОшибки = НСтр("ru = 'Необходимо указать дату отгрузки'");
		ПараметрыОбработкиОшибокДатыОтгрузки = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ДатаОтгрузки", , , , ТекстОшибки);
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОПередаче.Операция.ДатаОтгрузки",
		ВыборкаШапки.ДатаОтгрузки, ПараметрыОбработкиОшибокДатыОтгрузки);

	ЗаполнитьДеревоДанныхУПД_5_02(СтруктураДанных, СтруктураЭД, ДеревоДанных);		

	ЗаполнитьДокументыПодтвержденияОтгрузки_5_02(ДеревоДанных, СтруктураДанных);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_5_02(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ)
	
	СтруктураДанных = Документы.СчетФактураВыданный.ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();
	ОбщийПуть = "СведенияОСчетеФактуре.";
	
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс Тогда
		СтруктураЭД.Функция = "СЧФ";
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СсылкаСчетаФактуры", СсылкаНаОбъект);
	
	Если ВыборкаШапки.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		
		// Обработка ошибки с открытием формы по навигационной ссылке.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерИсправления");
		ИмяФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсправления", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "Исправление.НомерИсправления", ВыборкаШапки.НомерИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Дата");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "Исправление.ДатаИсправления", ВыборкаШапки.ДатаИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "НомерДокумента", ВыборкаШапки.НомерИсходногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ДатаИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "ДатаДокумента", ВыборкаШапки.ДатаИсходногоДокумента, ПараметрыОбработкиОшибок);
	Иначе
		// Обработка ошибки с открытием формы по навигационной ссылке.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерЭД");
		ИмяФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект,
			"Объект.НомерЭД", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "НомерДокумента", ВыборкаШапки.Номер, ПараметрыОбработкиОшибок);
			
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.Дата", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "ДатаДокумента", ВыборкаШапки.Дата, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.ИдентификаторГосКонтракта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ИдентификаторГосКонтракта");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", ВыборкаШапки.ИдентификаторГосКонтракта,
			ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	ОбстоятельстваФормированияСФ = "";
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс Тогда
		ВидСчетаФактуры = "Авансовый";
		ОбстоятельстваФормированияСФ = "2";
	Иначе
		ВидСчетаФактуры = "Реализация";
		ОбстоятельстваФормированияСФ = "1";
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		ОбщийПуть + "ДополнительныеСведенияОбУчастниках.ОбстоятельстваФормированияСФ", ОбстоятельстваФормированияСФ);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры", ВидСчетаФактуры);
	
	МассивОснований = Новый Массив;
	Если СтруктураДанных.Свойство("ВыборкаОснований") Тогда
		
		ВыборкаОснований = СтруктураДанных.ВыборкаОснований;
		Пока ВыборкаОснований.Следующий() Цикл
			МассивОснований.Добавить(ВыборкаОснований.ДокументОснование);
		КонецЦикла;
		
		СтруктураДанныхОснований = Документы[МассивОснований[0].Метаданные().Имя].ПолучитьДанныеДляЭД(МассивОснований);
		Если СтруктураДанныхОснований.ВыборкаШапки.Следующий() Тогда
			ЗаполнитьДеревоДанныхУПД_5_02(СтруктураДанныхОснований, СтруктураЭД, ДеревоДанных);
		КонецЕсли;
		
	Иначе
		ЗаполнитьДеревоДанныхУПД_5_02(СтруктураДанных, СтруктураЭД, ДеревоДанных);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.СчетФактураОснование) Тогда
		МассивОснований.Добавить(ВыборкаШапки.СчетФактураОснование);
	КонецЕсли;
	
	ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		СсылкаНаОбъект, "Объект.СчетФактураОснование");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры",
		МассивОснований, ПараметрыОбработкиОшибок);
	
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактура Тогда
		ЗаполнитьДокументыПодтвержденияОтгрузки(ДеревоДанных, СтруктураДанных);
	КонецЕсли;
	
	Если СтруктураДанных.Свойство("ВыборкаПРД") Тогда
		
		ПлатежныеДокументы = Новый ТаблицаЗначений;
		ПлатежныеДокументы.Колонки.Добавить("НомерСтроки");
		ПлатежныеДокументы.Колонки.Добавить("НомерПРД");
		ПлатежныеДокументы.Колонки.Добавить("ДатаПРД");
		ПлатежныеДокументы.Колонки.Добавить("Сумма");
		
		ВыборкаПРД = СтруктураДанных.ВыборкаПРД;
		Пока ВыборкаПРД.Следующий() Цикл
			НоваяСтрока = ПлатежныеДокументы.Добавить();
			НоваяСтрока.НомерСтроки = ВыборкаПРД.НомерСтроки;
			НоваяСтрока.НомерПРД    = ВыборкаПРД.НомерПлатежноРасчетногоДокумента;
			НоваяСтрока.ДатаПРД     = ВыборкаПРД.ДатаПлатежноРасчетногоДокумента;
			НоваяСтрока.Сумма = ВыборкаПРД.Сумма;
		КонецЦикла;
		
		// Дополним таблицу платежных документов параметрами обработки ошибок.
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ПлатежныеДокументы,
			"НомерПРД", СсылкаНаОбъект, "Объект.ПлатежноРасчетныеДокументы.НомерПлатежноРасчетногоДокумента", , 
				"НомерСтроки");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ПлатежныеДокументы,
			"ДатаПРД", СсылкаНаОбъект, "Объект.ПлатежноРасчетныеДокументы.ДатаПлатежноРасчетногоДокумента", , 
				"НомерСтроки");
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ПлатежныеДокументы, 
			"ПлатежноРасчетныеДокументы");
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет данные участников УПД в дереве значений.
//
// Параметры:
//  ДеревоДанных - ДеревоЗначений
//  СведенияОбУчастнике - Структура - см. ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица
//  ВидУчастника - Строка
//  ВидАдреса - Строка
//  ЭтоЭлектронноеАктированиеЕИС - Булево
//  ВерсияФормата - Строка
//
Процедура ЗаполнитьДанныеУчастникаУПД(ДеревоДанных, СведенияОбУчастнике, ВидУчастника,
			ВидАдреса = "ЮридическийАдрес", ЭтоЭлектронноеАктированиеЕИС = Ложь, ВерсияФормата = "")
	
	// Подготовим параметры обработки ошибок
	КлючДанных = Неопределено;
	СведенияОбУчастнике.Свойство("Ссылка", КлючДанных);
	ПоддерживаемыеФорматы = ФорматыЭДО_ФНС.ПоддерживаемыеФорматы();
	
	ПараметрыОбработкиОшибокИНН = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		КлючДанных, "Объект.ИНН");
	ПараметрыОбработкиОшибокКПП = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		КлючДанных, "Объект.КПП");
	
	ТипУчастникаОрганизация = ТипЗнч(КлючДанных) = Тип("СправочникСсылка.Организации");	
	ПутьКДаннымНаименования = ?(ТипУчастникаОрганизация, "Объект.НаименованиеСокращенное", "Объект.НаименованиеПолное");
	
	ПараметрыОбработкиОшибокНаименование = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		КлючДанных, ПутьКДаннымНаименования);
	
	Если ЭтоЭлектронноеАктированиеЕИС И ТипУчастникаОрганизация Тогда
		МодульЭлектронноеАктированиеЕИС = ОбщегоНазначения.ОбщийМодуль("ЭлектронноеАктированиеЕИС");
		НаименованиеОрганизации = МодульЭлектронноеАктированиеЕИС.НаименованиеОрганизацииДляЭД(
			СведенияОбУчастнике.Ссылка);
	Иначе
		НаименованиеОрганизации = СведенияОбУчастнике.ПолноеНаименование;
	КонецЕсли;
	
	Если СведенияОбУчастнике.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда	
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации",
			НаименованиеОрганизации, ПараметрыОбработкиОшибокНаименование);	
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ЮЛ.ИНН",
			СведенияОбУчастнике.ИНН, ПараметрыОбработкиОшибокИНН);		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ЮЛ.КПП",
			СведенияОбУчастнике.КПП, ПараметрыОбработкиОшибокКПП);		
	ИначеЕсли СведенияОбУчастнике.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент Тогда	
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации",
			НаименованиеОрганизации, ПараметрыОбработкиОшибокНаименование);					
	
			Если ВерсияФормата = ПоддерживаемыеФорматы.УПД_5_02.ИнформацияПродавца Тогда
				Статусы = Новый Структура;
				Статусы.Вставить("Организация", "ИО");
				Статусы.Вставить("Гражданин", "ИГ");
				
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
					ДеревоДанных,
					ВидУчастника + ".ТипУчастника.ИЛ.Статус",
					Статусы.Организация);
				Если ЗначениеЗаполнено(СведенияОбУчастнике.ЮридическийАдресXML) Тогда
					СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(СведенияОбУчастнике.ЮридическийАдресXML);
					ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
						ДеревоДанных,
						ВидУчастника + ".ТипУчастника.ИЛ.КодСтраны",
						СведенияОбАдресе.КодСтраны);
					ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
						ДеревоДанных,
						ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеСтраны",
						СведенияОбАдресе.Страна);
				КонецЕсли;
				
			КонецЕсли;	
	Иначе		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИП.ИНН",
			СведенияОбУчастнике.ИНН, ПараметрыОбработкиОшибокИНН);
		
		Если ВерсияФормата = ПоддерживаемыеФорматы.УПД_5_02.ИнформацияПродавца Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ИП.ФИО.Фамилия",
				СведенияОбУчастнике.Фамилия, ПараметрыОбработкиОшибокНаименование);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ИП.ФИО.Имя",
				СведенияОбУчастнике.Имя, ПараметрыОбработкиОшибокНаименование);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ИП.ФИО.Отчество",
				СведенияОбУчастнике.Отчество, ПараметрыОбработкиОшибокНаименование);	
		Иначе
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ИП.Фамилия",
				СведенияОбУчастнике.Фамилия, ПараметрыОбработкиОшибокНаименование);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ИП.Имя",
				СведенияОбУчастнике.Имя, ПараметрыОбработкиОшибокНаименование);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ИП.Отчество",
				СведенияОбУчастнике.Отчество, ПараметрыОбработкиОшибокНаименование);
		КонецЕсли;
				
		Если ТипЗнч(СведенияОбУчастнике.Ссылка) = Тип("СправочникСсылка.Организации") Тогда
		
			ШаблонСтроки = НСтр("ru = 'Свидетельство №%1 от %2'");
			СвидетельствоДатаВыдачи = Формат(СведенияОбУчастнике.СвидетельствоДатаВыдачи, "ДЛФ=D");
		
			Свидетельство = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСтроки,
				СведенияОбУчастнике.СвидетельствоСерияНомер, СвидетельствоДатаВыдачи);
			
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				КлючДанных, "Объект.СвидетельствоСерияНомер");
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ИП.СвидетельствоОГосРегистрации",
				Свидетельство, ПараметрыОбработкиОшибок);			
		КонецЕсли;
	КонецЕсли;
	
	// Передаем в дерево данные для заполнения адреса.	
	ВидКонтактнойИнформации = Неопределено;	
	ТипУчастникаОрганизация = ТипЗнч(КлючДанных) = Тип("СправочникСсылка.Организации");
	
	Если ВидАдреса = "ПроизвольныйАдрес"
		И ЗначениеЗаполнено(СведенияОбУчастнике.ПроизвольныйАдресЗначенияПолей) Тогда	
		СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(СведенияОбУчастнике.ПроизвольныйАдресЗначенияПолей);	
		
		Если ВерсияФормата = ПоддерживаемыеФорматы.УПД_5_02.ИнформацияПродавца Тогда
		    ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				ВидУчастника + ".Адрес.ТипАдреса.АдресИнформация.КодСтраны", СведенияОбАдресе.КодСтраны);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				ВидУчастника + ".Адрес.ТипАдреса.АдресИнформация.НаименованиеСтраны", СведенияОбАдресе.Страна);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				ВидУчастника + ".Адрес.ТипАдреса.АдресИнформация.АдресТекст", СведенияОбАдресе.Представление);
		Иначе
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				ВидУчастника + ".Адрес.АдресИнформация.КодСтраны", СведенияОбАдресе.КодСтраны);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				ВидУчастника + ".Адрес.АдресИнформация.АдресТекст", СведенияОбАдресе.Представление);
		КонецЕсли;		
	ИначеЕсли ВидАдреса = "ПочтовыйАдрес"
		И ЗначениеЗаполнено(СведенияОбУчастнике[ВидАдреса]) Тогда		
		ВидКонтактнойИнформации = ?(ТипУчастникаОрганизация, Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресОрганизации,
			Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресКонтрагента);		
	ИначеЕсли ВидАдреса = "ФактическийАдрес" 
		И ЗначениеЗаполнено(СведенияОбУчастнике[ВидАдреса]) Тогда
		ВидКонтактнойИнформации = ?(ТипУчастникаОрганизация, Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации,
			Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента);		
	Иначе		
		ВидКонтактнойИнформации = ?(ТипУчастникаОрганизация, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,
			Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);		
	КонецЕсли;
	
	Если ВидКонтактнойИнформации <> Неопределено Тогда
		
		ПостфиксПоляАдрес = ?(ТипУчастникаОрганизация, "Организации", "Контрагента");	
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СведенияОбУчастнике.Ссылка, "КонтактнаяИнформацияПолеЮрАдрес" + ПостфиксПоляАдрес + ".");
		
		Если ВерсияФормата = ПоддерживаемыеФорматы.УПД_5_02.ИнформацияПродавца Тогда
			ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных, ВидУчастника + ".Адрес.АвтоматическиЗаполняемый",
				ПараметрыОбработкиОшибок);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных, ВидУчастника + ".Адрес.ТипАдреса.АвтоматическиЗаполняемый.ОбъектКонтактнойИнформации", КлючДанных);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных, ВидУчастника + ".Адрес.ТипАдреса.АвтоматическиЗаполняемый.ВидКонтактнойИнформации", ВидКонтактнойИнформации);	
		Иначе
			ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных, 
				ВидУчастника + ".Адрес.АвтоматическиЗаполняемый", ПараметрыОбработкиОшибок);	
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных, ВидУчастника + ".Адрес.АвтоматическиЗаполняемый.ОбъектКонтактнойИнформации", КлючДанных);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных, ВидУчастника + ".Адрес.АвтоматическиЗаполняемый.ВидКонтактнойИнформации", 
				ВидКонтактнойИнформации);
		КонецЕсли;
	КонецЕсли;
	
	Телефон = "";
	Если СведенияОбУчастнике.Свойство("Телефоны", Телефон) И ЗначениеЗаполнено(Телефон) Тогда
		Если ВерсияФормата = ПоддерживаемыеФорматы.УПД_5_02.ИнформацияПродавца Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".КонтактныеСведения.Телефоны.НомерСтроки.Телефон",
				Телефон, ПараметрыОбработкиОшибок);
		Иначе
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".КонтактныеСведения.Телефон",
				Телефон, ПараметрыОбработкиОшибок);
		КонецЕсли;				
	КонецЕсли;
	
	ЭлектроннаяПочта = "";
	Если СведенияОбУчастнике.Свойство("ЭлектроннаяПочта", ЭлектроннаяПочта) И ЗначениеЗаполнено(ЭлектроннаяПочта) Тогда
		Если ВерсияФормата = ПоддерживаемыеФорматы.УПД_5_02.ИнформацияПродавца Тогда
		    ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".КонтактныеСведения.ЭлектронныеПочты.НомерСтроки.ЭлектроннаяПочта",
				ЭлектроннаяПочта, ПараметрыОбработкиОшибок);
		Иначе
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".КонтактныеСведения.ЭлектроннаяПочта",
				ЭлектроннаяПочта, ПараметрыОбработкиОшибок);
		КонецЕсли;
	КонецЕсли;	
	
	НомерСчета = "";
	Если СведенияОбУчастнике.Свойство("НомерСчета", НомерСчета) И ЗначениеЗаполнено(НомерСчета) Тогда
		ПараметрыОбработкиОшибок = Неопределено;
		Если СведенияОбУчастнике.Свойство("БанковскийСчет") Тогда
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				СведенияОбУчастнике.БанковскийСчетСсылка, "Объект.НомерСчета");
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".БанковскиеРеквизиты.НомерСчета",
			НомерСчета, ПараметрыОбработкиОшибок);
				
		Банк = ""; 
		БИК = ""; 
		КоррСчет = "";
		
		Если СведенияОбУчастнике.Свойство("Банк", Банк) И ЗначениеЗаполнено(Банк) Тогда
			ПараметрыОбработкиОшибок = Неопределено;
			Если СведенияОбУчастнике.Свойство("БанкСсылка") Тогда
				ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
					СведенияОбУчастнике.БанкСсылка, "Объект.Наименование");
			КонецЕсли;
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".БанковскиеРеквизиты.НаименованиеБанка",
				Банк, ПараметрыОбработкиОшибок);
		КонецЕсли;
		Если СведенияОбУчастнике.Свойство("БИК", БИК) И ЗначениеЗаполнено(БИК) Тогда
			ПараметрыОбработкиОшибок = Неопределено;
			Если СведенияОбУчастнике.Свойство("БанкСсылка") Тогда
				ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
					СведенияОбУчастнике.БанкСсылка, "Объект.Код");
			КонецЕсли;
				
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".БанковскиеРеквизиты.БИКБанка",
				БИК, ПараметрыОбработкиОшибок);
		КонецЕсли;
		Если СведенияОбУчастнике.Свойство("КоррСчет", КоррСчет) И ЗначениеЗаполнено(КоррСчет) Тогда
			ПараметрыОбработкиОшибок = Неопределено;
			Если СведенияОбУчастнике.Свойство("БанкСсылка") Тогда
				ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
					СведенияОбУчастнике.БанкСсылка, "Объект.КоррСчет");
			КонецЕсли;
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".БанковскиеРеквизиты.КорреспондентскийСчетБанка",
				КоррСчет, ПараметрыОбработкиОшибок);
		КонецЕсли;
	КонецЕсли;
	
	КодПоОКПО = "";
	Если СведенияОбУчастнике.Свойство("КодПоОКПО", КодПоОКПО) И ЗначениеЗаполнено(КодПоОКПО) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(КлючДанных,
			"Объект.КодПоОКПО");
					
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ВидУчастника + ".КодОКПО", КодПоОКПО, ПараметрыОбработкиОшибок);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьДеревоДанныхУПД_2019(СтруктураДанных, СтруктураЭД, ДеревоДанных)
	
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	
	ЭтоЭлектронноеАктированиеЕИС = Ложь;
	МодульЭлектронноеАктированиеЕИС = Неопределено;
	ДанныеПриложенияЕИС = Неопределено;
	ДанныеЭлектронногоАктированияЕИС = Неопределено;
	Если ЗначениеЗаполнено(СтруктураДанных.ДанныеЭлектронногоАктированияЕИС)
		И СтруктураДанных.ДанныеЭлектронногоАктированияЕИС.Количество() > 0 Тогда
		МодульЭлектронноеАктированиеЕИС = ОбщегоНазначения.ОбщийМодуль("ЭлектронноеАктированиеЕИС");
		
		ОбменВключен = МодульЭлектронноеАктированиеЕИС.
			ОбменПоОрганизацииВключен(ВыборкаШапки.Организация);
		Контракт = МодульЭлектронноеАктированиеЕИС.
			ГосударственныйКонтрактДоговора(ВыборкаШапки.ДоговорКонтрагента);
		Если ОбменВключен
			И ЗначениеЗаполнено(Контракт) Тогда
				
			ЭтоЭлектронноеАктированиеЕИС = Истина;
			ДанныеПриложенияЕИС = МодульЭлектронноеАктированиеЕИС.
				НовыеДанныеПриложенияКТитулуПродавцаУПД();
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"ДанныеЭлектронногоАктированияЕИС.ДанныеПриложения", ДанныеПриложенияЕИС);
			ДанныеЭлектронногоАктированияЕИС = СтруктураДанных.ДанныеЭлектронногоАктированияЕИС;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Комитент = Неопределено;
	ДоговорСКомитентом = Неопределено;
	Если СтруктураЭД.Функция = "СвРК" ИЛИ СтруктураЭД.Функция = "СвЗК" Тогда
		Комитент = СтруктураЭД.Получатель;
		ДоговорСКомитентом = СтруктураЭД.Договор;
	КонецЕсли;
	
	СведенияОПродавце = Неопределено; 
	Если ЗначениеЗаполнено(ВыборкаШапки.Организация) Тогда
		СведенияОПродавце = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Организация, СведенияОПродавце);
		
		Если ТипЗнч(ВыборкаШапки.Ссылка) <> Тип("ДокументСсылка.СчетФактураВыданный")
			И ЗначениеЗаполнено(ВыборкаШапки.БанковскийСчетОрганизации) Тогда
			Справочники.БанковскиеСчета.ЗаполнитьРеквизитыБанковскогоСчета(СведенияОПродавце, 
				ВыборкаШапки.БанковскийСчетОрганизации);
		КонецЕсли;
		
		ТаблицаПродавцов = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, "СведенияОПродавце");
		ТаблицаПродавцов.Колонки.Добавить("СведенияОбУчастнике");
		ДанныеПродавца = ПолучитьДанныеУчастникаУПД(СведенияОПродавце);
		СтрокаПродавца = ТаблицаПродавцов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПродавца, ДанныеПродавца);
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД(ТаблицаПродавцов);
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаПродавцов, "СведенияОПродавце");
			
		Если ЭтоЭлектронноеАктированиеЕИС Тогда
			СоставительДокументаНаименование =
				МодульЭлектронноеАктированиеЕИС.НаименованиеОрганизацииДляЭД(
					СведенияОПродавце.Ссылка);
		Иначе
			СоставительДокументаНаименование = СведенияОПродавце.ПолноеНаименование
				+ ?(ЗначениеЗаполнено(СведенияОПродавце.КПП),
					СтрШаблон(НСтр("ru = ', ИНН/КПП %1/%2'"), СведенияОПродавце.ИНН, СведенияОПродавце.КПП),
					СтрШаблон(НСтр("ru = ', ИНН %1'"), СведенияОПродавце.ИНН));
		КонецЕсли;
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(ВыборкаШапки.Ссылка, 
			"Объект.Организация");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СоставительДокументаНаименование, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	СведенияОПокупателе = Неопределено; 
	Если ЗначениеЗаполнено(ВыборкаШапки.Контрагент) Тогда
		СведенияОПокупателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Контрагент, СведенияОПокупателе);
		
		Если ТипЗнч(ВыборкаШапки.Ссылка) <> Тип("ДокументСсылка.СчетФактураВыданный")
			И ЗначениеЗаполнено(ВыборкаШапки.БанковскийСчетКонтрагента) Тогда
			Справочники.БанковскиеСчета.ЗаполнитьРеквизитыБанковскогоСчета(СведенияОПокупателе, 
				ВыборкаШапки.БанковскийСчетКонтрагента);
		КонецЕсли;
		
		ТаблицаПокупателей = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, "СведенияОПокупателе");
		ТаблицаПокупателей.Колонки.Добавить("СведенияОбУчастнике");
		ДанныеПокупателя = ПолучитьДанныеУчастникаУПД(СведенияОПокупателе, ,
			ЭтоЭлектронноеАктированиеЕИС);
		СтрокаПокупателя = ТаблицаПокупателей.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПокупателя, ДанныеПокупателя);
		Если ЭтоЭлектронноеАктированиеЕИС Тогда
			ИнформацияДляУчастника = МодульЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаПокупателя();
			СтрокаПокупателя.ИнформацияДляУчастника = ИнформацияДляУчастника;
		КонецЕсли;
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД(ТаблицаПокупателей);
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаПокупателей, "СведенияОПокупателе");
		
	КонецЕсли;
	
	// Обработка ошибки с указанием расширенного текста сообщения вместо параметров обработки ошибки.
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить код валюты документа. Проверьте, что:
	|	- в документе указана валюта,
	|	- для нее заполнен код по Общероссийскому классификатору валют.'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод",
		ВыборкаШапки.ВалютаКод, ТекстОшибки);
	
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная Тогда
			
		ТаблицаГрузоотправителей = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, "СведенияОГрузоотправителе");
		ТаблицаГрузоотправителей.Колонки.Добавить("СведенияОбУчастнике");
		
		Если ЗначениеЗаполнено(ВыборкаШапки.Грузоотправитель) Тогда
			СведенияОГрузоотправителе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
			ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Грузоотправитель, СведенияОГрузоотправителе);
			ДанныеГрузоотправителя = ПолучитьДанныеУчастникаУПД(СведенияОГрузоотправителе);
			СтрокаГрузоотправителя = ТаблицаГрузоотправителей.Добавить();
			СтрокаГрузоотправителя.Грузоотправитель = ДанныеГрузоотправителя;
			СтрокаГрузоотправителя.СведенияОбУчастнике = СведенияОГрузоотправителе;
		Иначе
			ТаблицаГрузоотправителей.Добавить().ОнЖе = Истина;
		КонецЕсли;
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД(ТаблицаГрузоотправителей, "Грузоотправитель");
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаГрузоотправителей, 
			"СведенияОГрузоотправителе");
		
		ТаблицаГрузополучателей = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, "СведенияОГрузополучателе");
		ТаблицаГрузополучателей.Колонки.Добавить("СведенияОбУчастнике");
		
		ПриоритетыВидовКИГрузополучателя = Новый Массив;
		ПриоритетыВидовКИГрузополучателя.Добавить("ПочтовыйАдрес");
		ПриоритетыВидовКИГрузополучателя.Добавить("ФактическийАдрес");
		
		Если ЗначениеЗаполнено(ВыборкаШапки.Грузополучатель) Тогда
			СведенияОГрузополучателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
			ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Грузополучатель, СведенияОГрузополучателе);
			Если ЗначениеЗаполнено(ВыборкаШапки.АдресДоставкиЗначенияПолей) Тогда
				СведенияОГрузополучателе.Вставить("ПроизвольныйАдрес", ВыборкаШапки.АдресДоставкиЗначенияПолей);
			КонецЕсли;
			ДанныеГрузополучателя = ПолучитьДанныеУчастникаУПД(СведенияОГрузополучателе, ПриоритетыВидовКИГрузополучателя);
			ЗаполнитьЗначенияСвойств(ТаблицаГрузополучателей.Добавить(), ДанныеГрузополучателя);
		Иначе
			Если ЗначениеЗаполнено(ВыборкаШапки.АдресДоставкиЗначенияПолей) Тогда
				СведенияОПокупателе.Вставить("ПроизвольныйАдрес", ВыборкаШапки.АдресДоставкиЗначенияПолей);
			КонецЕсли;
			ДанныеГрузополучателя = ПолучитьДанныеУчастникаУПД(СведенияОПокупателе, ПриоритетыВидовКИГрузополучателя);
			ЗаполнитьЗначенияСвойств(ТаблицаГрузополучателей.Добавить(), ДанныеГрузополучателя);
		КонецЕсли;
		
		Если ЭтоЭлектронноеАктированиеЕИС Тогда
			ДанныеГрузополучателя = ТаблицаГрузополучателей[ТаблицаГрузополучателей.Количество() - 1];
			ИдентификаторУчастника = МодульЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаГрузополучателя();
			ДанныеГрузополучателя.ИнформацияДляУчастника = ИдентификаторУчастника;
		КонецЕсли;
		
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД(ТаблицаГрузополучателей);
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаГрузополучателей, "СведенияОГрузополучателе");
		
		Если ЗначениеЗаполнено(ВыборкаШапки.ИныеСведенияОбОтгрузке) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"ИныеСведенияОбОтгрузке", ВыборкаШапки.ИныеСведенияОбОтгрузке);
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураЭД.Функция <> "СЧФ" Тогда 
		
		Если ЗначениеЗаполнено(ВыборкаШапки.ДоговорКонтрагента) Тогда
			
			ОснованиеОтгрузкиТоваров = Новый ТаблицаЗначений;
			ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДоговорКонтрагента");
			ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументНаименование");
			ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументНомер");
			ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументДата");
			ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументДопСведения");
			
