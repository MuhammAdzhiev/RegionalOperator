	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	
	ТаблицаТоваров = Запрос.Выполнить().Выгрузить();
	ОбработатьТаблицуТоваров(ТаблицаТоваров);
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(
		ТаблицаТоваров, "Наименование", "Номенклатура", "Объект.Номенклатура", , "НомерСтроки");
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(
		ТаблицаТоваров, "БазоваяЕдиницаКод", "БазоваяЕдиница", "Объект.БазоваяЕдиница", , "НомерСтроки");
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоЭД, ТаблицаТоваров, "Товары");
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, "Дата, Организация, ОрганизацияПолучатель");
	
