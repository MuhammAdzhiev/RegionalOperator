// Возвращаемое значение:
//  Строка
Функция ВидКомандыСозданияНаОсновании()
	Возврат "СозданиеНаОснованииЛегкийКлиентЭДО";
КонецФункции

// Параметры:
// Команды - См. ПриОпределенииКомандПодключенныхКОбъекту.Команды
// Источники - См. ПриОпределенииКомандПодключенныхКОбъекту.Источники
Процедура ЗаполнитьКомандыВводаНаОсновании(Команды, Источники)
	
	Команды.Очистить();
	
	ИсточникиМетаданные = Источники.Строки.ВыгрузитьКолонку("Метаданные"); // Массив из ОбъектМетаданных
	Для Каждого ОбъектМетаданных Из ИсточникиМетаданные Цикл
		Если Не КлиентЭДО.ДляОбъектаМетаданныхОпределеныКомандыВводаНаОсновании(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ОбъектМетаданных.ПолноеИмя());
		//@skip-check dynamic-access-method-not-found
		МенеджерОбъекта.ЗаполнитьКомандыВводаНаОсновании(Команды);
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Команды) Тогда
		Возврат;
	КонецЕсли;
	
	Команды.Сортировать("Идентификатор");
	ДублирующиесяКоманды = Новый Массив; // Массив Из СтрокаТаблицыЗначений
	ТекущийИдентификаторКоманды = "";
	Для Каждого ДанныеКоманды Из Команды Цикл
		Если ДанныеКоманды.Идентификатор = ТекущийИдентификаторКоманды Тогда
			ДублирующиесяКоманды.Добавить(ДанныеКоманды);
		КонецЕсли;
		ТекущийИдентификаторКоманды = ДанныеКоманды.Идентификатор;
	КонецЦикла;
	Для Каждого ДублирующаясяКоманда Из ДублирующиесяКоманды Цикл
		Команды.Удалить(ДублирующаясяКоманда);
	КонецЦикла;
	
	ВидКоманды = ВидКомандыСозданияНаОсновании();
	РежимЗаписи = "НеЗаписывать";
		
	Для Каждого НоваяКоманда Из Команды Цикл
		НоваяКоманда.Вид = ВидКоманды;
		НоваяКоманда.РежимЗаписи = РежимЗаписи
	КонецЦикла;
		
КонецПроцедуры

#Область ПанельДополнительногоСостояния

// Возвращаемое значение:
//  ТаблицаЗначений:
// * Идентификатор - Строка
// * Представление - Строка
// * Обработчик - Строка
// * Порядок - Число
// * Значение - Произвольный - произвольное сериализуемое значение для передачи в обработчик команды
Функция НовыеЭлементыДополнительногоСостояния()
	
	ОписаниеТипаСтрока = ОбщегоНазначения.ОписаниеТипаСтрока(0);
	
	ЭлементыДополнительногоСостояния = Новый ТаблицаЗначений;
	ЭлементыДополнительногоСостояния.Колонки.Добавить("Идентификатор", ОписаниеТипаСтрока);
	ЭлементыДополнительногоСостояния.Колонки.Добавить("Представление", ОписаниеТипаСтрока);
	ЭлементыДополнительногоСостояния.Колонки.Добавить("Обработчик",    ОписаниеТипаСтрока);
	ЭлементыДополнительногоСостояния.Колонки.Добавить("Порядок",       ОбщегоНазначения.ОписаниеТипаЧисло(2));
	ЭлементыДополнительногоСостояния.Колонки.Добавить("Значение");
	Возврат ЭлементыДополнительногоСостояния;
	
КонецФункции

#Если Не ВнешнееСоединение Тогда

// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * Объект - ДанныеФормыСтруктура:
//   ** Ссылка - ЛюбаяСсылка
//  ДанныеПанели - См. НовыеДанныеПанелиДополнительногоСостояния
Процедура ЗаполнитьДанныеПанелиДополнительногоСостояния(Форма, ДанныеПанели)
	
	Если Не ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЗаполненииДанныхПанелиДополнительногоСостояния(Форма, ДанныеПанели);
	
КонецПроцедуры

// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * Объект - ДанныеФормыСтруктура:
//   ** Ссылка - ЛюбаяСсылка
//  * КомандыДополнительногоСостояния - Произвольный
//  ДанныеПанели - См. НовыеДанныеПанелиДополнительногоСостояния
Процедура НастроитьПанельДополнительногоСостояния(Форма, ДанныеПанели)

	Если Не ДанныеПанели.ЭлементыДополнительногоСостояния.Количество() Тогда
		Форма.Элементы.ГруппаПанельДополнительноеСостояние.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Форма.Элементы.ГруппаПанельДополнительноеСостояние.Видимость = Истина;
	
	Форма.Элементы.ГруппаДополнительноеСостояние.ЦветФона = ДанныеПанели.ЦветПанелиДополнительногоСостояния;
	
	ЭлементыДополнительногоСостояния = ДанныеПанели.ЭлементыДополнительногоСостояния;
	Форма.КомандыДополнительногоСостояния = Новый ФиксированныйМассив(
		ОбщегоНазначения.ТаблицаЗначенийВМассив(ЭлементыДополнительногоСостояния));
	ЭлементыДополнительногоСостояния.Сортировать("Порядок Возр");
	
	ИмяКоманды = "ДополнительноеСостояниеОбработкаНажатия";
	ШаблонИмениКнопки = "ДополнительноеСостояние_%1";
	НастройкаВидаКнопкиФормы = ВидКнопкиФормы.ОбычнаяКнопка;
	НастройкаОтображенияФигурыКнопки = ОтображениеФигурыКнопки.Нет;
	ЦветКнопки = ЦветаСтиля.ЦветГиперссылкиБЭД;
	РодительКнопок = Форма.Элементы.ГруппаДополнительноеСостояние; // ГруппаФормы
	Для Каждого ПодчиненныйЭлемент Из РодительКнопок.ПодчиненныеЭлементы Цикл
		ПодчиненныйЭлемент.Видимость = Ложь;
	КонецЦикла;
	
	Для ПорядковыйНомер = 1 По ЭлементыДополнительногоСостояния.Количество() Цикл
		ДанныеДополнительногоСостояния = ЭлементыДополнительногоСостояния[ПорядковыйНомер - 1];
		
		ИмяКнопки = СтрШаблон(ШаблонИмениКнопки, ДанныеДополнительногоСостояния.Идентификатор);
		КнопкаСоздания = Форма.Элементы.Найти(ИмяКнопки);
		Если КнопкаСоздания = Неопределено Тогда
			КнопкаСоздания = Форма.Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), РодительКнопок);
		КонецЕсли;
		
		КнопкаСоздания.Видимость = Истина;
		КнопкаСоздания.Вид = НастройкаВидаКнопкиФормы;
		КнопкаСоздания.ИмяКоманды = ИмяКоманды;
		КнопкаСоздания.ЦветТекста = ЦветКнопки;
		КнопкаСоздания.ОтображениеФигуры = НастройкаОтображенияФигурыКнопки;
		КнопкаСоздания.Заголовок = ДанныеДополнительногоСостояния.Представление;
	КонецЦикла;

КонецПроцедуры

#КонецЕсли // ВнешнееСоединение

#КонецОбласти // ПанельДополнительногоСостояния

#Область ПанельСвязанныхДокументов

// Возвращаемое значение:
//  ТаблицаЗначений:
// * Идентификатор - Строка
// * Представление - Строка
// * Обработчик - Строка
// * Порядок - Число
// * Значение - Произвольный
Функция НовыеКомандыСозданияСвязанныхДокументов()

	ОписаниеТипаСтрока = ОбщегоНазначения.ОписаниеТипаСтрока(0);
	
	КомандыСоздания = Новый ТаблицаЗначений;
	КомандыСоздания.Колонки.Добавить("Идентификатор", ОписаниеТипаСтрока);
	КомандыСоздания.Колонки.Добавить("Представление", ОписаниеТипаСтрока);
	КомандыСоздания.Колонки.Добавить("Обработчик",    ОписаниеТипаСтрока);
	КомандыСоздания.Колонки.Добавить("Порядок",       ОбщегоНазначения.ОписаниеТипаЧисло(2));
	КомандыСоздания.Колонки.Добавить("Значение");
	Возврат КомандыСоздания;

КонецФункции

// Возвращаемое значение:
//  ТаблицаЗначений:
// * Представление - Строка
// * Ссылка - ЛюбаяСсылка
Функция НовыеДанныеСвязанныхДокументов()
	
	ДанныеСвязанныхДокументов = Новый ТаблицаЗначений;
	ДанныеСвязанныхДокументов.Колонки.Добавить("Представление", ОбщегоНазначения.ОписаниеТипаСтрока(0));
	ДанныеСвязанныхДокументов.Колонки.Добавить("Ссылка", ОбщегоНазначения.ОписаниеТипаВсеСсылки());
	Возврат ДанныеСвязанныхДокументов;
	
КонецФункции

// Параметры:
//  СвязанныеДокументыДляЗаполнения - ТаблицаЗначений:
//  * Представление - Строка
//  * Ссылка - ДокументСсылка
//  ОбъектУчета - ДокументСсылка
//  ТекущийДокумент - ДокументСсылка
Процедура ЗаполнитьСвязанныеДокументы(СвязанныеДокументыДляЗаполнения, ОбъектУчета, ТекущийДокумент)
	
	СвязанныеДокументы = КритерииОтбора.СвязанныеДокументы.Найти(ОбъектУчета); // Массив Из ДокументСсылка
		
	РеквизитыСвязанныхДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(СвязанныеДокументы,
		"ПометкаУдаления");
	
	ЭлектронныеДокументы = ОбменСКонтрагентами.АктуальныеЭлектронныеДокументы(СвязанныеДокументы);
	
	Для Каждого СвязанныйДокумент Из СвязанныеДокументы Цикл
		
		РеквизитыДокумента = РеквизитыСвязанныхДокументов.Получить(СвязанныйДокумент);
		//@skip-check property-return-type
		Если РеквизитыДокумента.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура("ОбъектУчета", СвязанныйДокумент);
		НайденныеДокументы = ЭлектронныеДокументы.НайтиСтроки(Отбор);
		
		ШаблонПредставления = ШаблонПредставленияСвязанногоДокументаПоОбъектуУчета(ОбъектУчета,
			СвязанныйДокумент);
		
		Если ЗначениеЗаполнено(НайденныеДокументы) Тогда
			ДокументДляСвязи = НайденныеДокументы[0].ЭлектронныйДокумент;
		Иначе
			//@skip-check statement-type-change
			ДокументДляСвязи = СвязанныйДокумент;
			ШаблонПредставления = ШаблонПредставления + НСтр("ru = ' (Черновик)'");
		КонецЕсли;
		
		Если ДокументДляСвязи = ТекущийДокумент Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура("Ссылка", ДокументДляСвязи);
		Если СвязанныеДокументыДляЗаполнения.НайтиСтроки(Отбор).Количество() Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйСвязанныеДокумент = СвязанныеДокументыДляЗаполнения.Добавить();
		НовыйСвязанныеДокумент.Представление = СтрШаблон(ШаблонПредставления, Строка(ДокументДляСвязи));
		НовыйСвязанныеДокумент.Ссылка = ДокументДляСвязи;
		
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//  ОбъектУчета - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО
//  СвязанныйДокумент - ДокументСсылка
// 
// Возвращаемое значение:
//  Строка
Функция ШаблонПредставленияСвязанногоДокументаПоОбъектуУчета(ОбъектУчета, СвязанныйДокумент) Экспорт

	ШаблонПредставления = "%1";
	Если ТипЗнч(СвязанныйДокумент) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
		Или ТипЗнч(СвязанныйДокумент) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ВидОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СвязанныйДокумент, "ВидОперации");
		Если ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
			ШаблонПредставления = НСтр("ru = 'Есть исправление: %1'");
		ИначеЕсли ВидОперации = Перечисления.ВидыОпераций.Корректировка Тогда
			ШаблонПредставления = НСтр("ru = 'Есть корректировка: %1'");
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ОбъектУчета) = Тип("ДокументСсылка.СчетФактураВыданный")
		И ТипЗнч(СвязанныйДокумент) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		ШаблонПредставления = НСтр("ru = 'Основание: %1'");
	КонецЕсли;
	
	Возврат ШаблонПредставления;
	
КонецФункции

#Если Не ВнешнееСоединение Тогда

// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * Объект - ДанныеФормыСтруктура:
//   ** Ссылка - ДокументСсылка
//  ДанныеПанели - См. НовыеДанныеПанелиСвязанныхДокументов
Процедура ЗаполнитьДанныеПанелиСвязанныхДокументов(Форма, ДанныеПанели)
	
	Если Не ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСвязанныеДокументы(ДанныеПанели.СвязанныеДокументы, Форма.Объект.Ссылка, Форма.Объект.Ссылка);
	
	ПриЗаполненииДанныхПанелиСвязанныхДокументов(Форма, ДанныеПанели);
	
КонецПроцедуры

// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * Объект - ДанныеФормыСтруктура:
//   ** Ссылка - ЛюбаяСсылка
//  * КомандыСозданияСвязанныхДокументов - Произвольный
//  * СвязанныеДокументы - СписокЗначений Из ЛюбаяСсылка
//  ДанныеПанели - См. НовыеДанныеПанелиСвязанныхДокументов
Процедура НастроитьПанельСвязанныхДокументов(Форма, ДанныеПанели)

	Если Не ЗначениеЗаполнено(ДанныеПанели.СвязанныеДокументы)
		И Не ЗначениеЗаполнено(ДанныеПанели.КомандыСоздания) Тогда
		Форма.Элементы.ГруппаПанельСвязанныхДокументов.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Форма.Элементы.ГруппаПанельСвязанныхДокументов.Видимость = Истина;
	Форма.Элементы.ГруппаСоздатьСвязанныйДокумент.Видимость = Ложь;
	Форма.Элементы.ГруппаСвязанныеДокументы.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(ДанныеПанели.КомандыСоздания) Тогда
		НастроитьКомандыСозданияПанельСвязанныхДокументовЛегкийКлиентЭДО(Форма, ДанныеПанели);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеПанели.СвязанныеДокументы) Тогда
		НастроитьСвязанныеДокументыПанельСвязанныхДокументовЛегкийКлиентЭДО(Форма, ДанныеПанели);
	КонецЕсли;

КонецПроцедуры

// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * Объект - ДанныеФормыСтруктура:
//   ** Ссылка - ЛюбаяСсылка
//  * КомандыСозданияСвязанныхДокументов - Произвольный
//  * СвязанныеДокументы - СписокЗначений Из ЛюбаяСсылка
//  ДанныеПанели - См. НовыеДанныеПанелиСвязанныхДокументов
Процедура НастроитьСвязанныеДокументыПанельСвязанныхДокументовЛегкийКлиентЭДО(Форма, ДанныеПанели)

	Форма.Элементы.ГруппаСвязанныеДокументы.Видимость = Истина;

	Форма.СвязанныеДокументы.Очистить();
	Для Каждого ДанныеСвязанногоДокумента Из ДанныеПанели.СвязанныеДокументы Цикл
		Форма.СвязанныеДокументы.Добавить(ДанныеСвязанногоДокумента.Ссылка, ДанныеСвязанногоДокумента.Представление);
	КонецЦикла;
	
	КоличествоСвязанныхДокументов = ДанныеПанели.СвязанныеДокументы.Количество();
	Если КоличествоСвязанныхДокументов = 1 Тогда
		Форма.Элементы.ОткрытьСвязанныйДокумент_1.Видимость = Истина;
		Форма.Элементы.ОткрытьСвязанныйДокумент_2.Видимость = Ложь;
		Форма.Элементы.ОткрытьСписокСвязанныхДокументов.Видимость = Ложь;
		
		ПервыйСвязанныйДокумент = ДанныеПанели.СвязанныеДокументы[0];
		Форма.Элементы.ОткрытьСвязанныйДокумент_1.Заголовок = ПервыйСвязанныйДокумент.Представление;
	ИначеЕсли КоличествоСвязанныхДокументов = 2 Тогда
		Форма.Элементы.ОткрытьСвязанныйДокумент_1.Видимость = Истина;
		Форма.Элементы.ОткрытьСвязанныйДокумент_2.Видимость = Истина;
		Форма.Элементы.ОткрытьСписокСвязанныхДокументов.Видимость = Ложь;
		
		ПервыйСвязанныйДокумент = ДанныеПанели.СвязанныеДокументы[0];
		Форма.Элементы.ОткрытьСвязанныйДокумент_1.Заголовок = ПервыйСвязанныйДокумент.Представление;
		ВторойСвязанныйДокумент = ДанныеПанели.СвязанныеДокументы[1];
		Форма.Элементы.ОткрытьСвязанныйДокумент_2.Заголовок = ВторойСвязанныйДокумент.Представление;
	Иначе
		Форма.Элементы.ОткрытьСвязанныйДокумент_1.Видимость = Истина;
		Форма.Элементы.ОткрытьСвязанныйДокумент_2.Видимость = Ложь;
		Форма.Элементы.ОткрытьСписокСвязанныхДокументов.Видимость = Истина;
		
		ПервыйСвязанныйДокумент = ДанныеПанели.СвязанныеДокументы[0];
		Форма.Элементы.ОткрытьСвязанныйДокумент_1.Заголовок = ПервыйСвязанныйДокумент.Представление;
		
		ШаблонЗаголовкаДляСписка = НСтр("ru = 'и ещё %1'");
		Форма.Элементы.ОткрытьСписокСвязанныхДокументов.Заголовок =
			СтрШаблон(ШаблонЗаголовкаДляСписка, КоличествоСвязанныхДокументов - 1);
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * Объект - ДанныеФормыСтруктура:
//   ** Ссылка - ЛюбаяСсылка
//  * КомандыСозданияСвязанныхДокументов - Произвольный
//  * СвязанныеДокументы - СписокЗначений Из ЛюбаяСсылка
//  ДанныеПанели - См. НовыеДанныеПанелиСвязанныхДокументов
Процедура НастроитьКомандыСозданияПанельСвязанныхДокументовЛегкийКлиентЭДО(Форма, ДанныеПанели)

	Форма.Элементы.ГруппаСоздатьСвязанныйДокумент.Видимость = Истина;
	
	Форма.КомандыСозданияСвязанныхДокументов = Новый ФиксированныйМассив(
		ОбщегоНазначения.ТаблицаЗначенийВМассив(ДанныеПанели.КомандыСоздания));
	
	ДанныеПанели.КомандыСоздания.Сортировать("Порядок Возр");

	ИмяКоманды = "СоздатьСвязанныйДокумент";
	ШаблонИмениКнопки = "СоздатьСвязанныйДокумент_%1";
	НастройкаВидаКнопкиФормы = ВидКнопкиФормы.ОбычнаяКнопка;
	НастройкаОтображенияФигурыКнопки = ОтображениеФигурыКнопки.Нет;
	ЦветКнопки = ЦветаСтиля.ЦветГиперссылкиБЭД;
	РодительКнопок = Форма.Элементы.ГруппаСоздатьСвязанныйДокумент; // ГруппаФормы
	Для Каждого ПодчиненныйЭлемент Из РодительКнопок.ПодчиненныеЭлементы Цикл
		ПодчиненныйЭлемент.Видимость = Ложь;
	КонецЦикла;
	
	Для ПорядковыйНомер = 1 По ДанныеПанели.КомандыСоздания.Количество() Цикл
		ДанныеКоманды = ДанныеПанели.КомандыСоздания[ПорядковыйНомер - 1];
		
		ИмяКнопки = СтрШаблон(ШаблонИмениКнопки, ДанныеКоманды.Идентификатор);
		КнопкаСоздания = Форма.Элементы.Найти(ИмяКнопки);
		Если КнопкаСоздания = Неопределено Тогда
			КнопкаСоздания = Форма.Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), РодительКнопок);
		КонецЕсли;
		
		КнопкаСоздания.Видимость = Истина;
		КнопкаСоздания.Вид = НастройкаВидаКнопкиФормы;
		КнопкаСоздания.ИмяКоманды = ИмяКоманды;
		КнопкаСоздания.ЦветТекста = ЦветКнопки;
		КнопкаСоздания.ОтображениеФигуры = НастройкаОтображенияФигурыКнопки;
		КнопкаСоздания.Заголовок = ДанныеКоманды.Представление;
	КонецЦикла;
	
КонецПроцедуры

#КонецЕсли // ВнешнееСоединение

#КонецОбласти // ПанельСвязанныхДокументов

#Область ИзменениеКомандногоИнтерфейса

// Возвращает установленное расширение изменения интерфейса легкий клиент ЭДО (если установлено).
// 
// Возвращаемое значение:
//  Неопределено
//  РасширениеКонфигурации
Функция УстановленноеРасширениеИзмененияИнтерфейсаЛегкийКлиентЭДО()
	
	ИмяМакетаРасширения = ИмяМакетаРасширенияИзмененияИнтерфейсаЛегкийКлиентЭДО();
	
	Возврат УстановленноеРасширение(ИмяМакетаРасширения);

КонецФункции

// Возвращает двоичные данные расширения изменения интерфейса легкий клиент ЭДО из макета конфигурации.
// 
// Возвращаемое значение:
//  Неопределено
//  ДвоичныеДанные
Функция РасширениеИзмененияИнтерфейсаЛегкийКлиентЭДОИзМакета()
	
	ИмяМакетаРасширения = ИмяМакетаРасширенияИзмененияИнтерфейсаЛегкийКлиентЭДО();
	
	Возврат ДанныеРасширенияИзМакета(ИмяМакетаРасширения);

КонецФункции

// Установливает расширение изменения интерфейса для легкого клиента ЭДО.
//
Процедура УстановитьРасширениеИзмененияИнтерфейсаЛегкийКлиентЭДО()
	
	ИмяМакетаРасширения = ИмяМакетаРасширенияИзмененияИнтерфейсаЛегкийКлиентЭДО();
	Если Не ЗначениеЗаполнено(ИмяМакетаРасширения) Тогда
		Возврат;
	КонецЕсли;
	
	Расширение = УстановленноеРасширение(ИмяМакетаРасширения);
	Если Расширение <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Расширение = РасширенияКонфигурации.Создать();
	
	Расширение.Активно = Истина;
	Расширение.БезопасныйРежим = Ложь;
	Расширение.ЗащитаОтОпасныхДействий = Новый ОписаниеЗащитыОтОпасныхДействий();
	Расширение.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
	Расширение.ИспользоватьОсновныеРолиДляВсехПользователей = Ложь;
	Расширение.Записать(ДанныеРасширенияИзМакета(ИмяМакетаРасширения));
	
КонецПроцедуры

// Удаляет расширение изменения интерфейса для легкого клиента ЭДО.
//
Процедура УдалитьРасширениеИзмененияИнтерфейсаЛегкийКлиентЭДО()
	
	ИмяМакетаРасширения = ИмяМакетаРасширенияИзмененияИнтерфейсаЛегкийКлиентЭДО();
	Если Не ЗначениеЗаполнено(ИмяМакетаРасширения) Тогда
		Возврат;
	КонецЕсли;
	
	Расширение = УстановленноеРасширение(ИмяМакетаРасширения);
	Если Расширение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Расширение.Удалить();
	
КонецПроцедуры

Функция ИмяМакетаРасширенияИзмененияИнтерфейсаЛегкийКлиентЭДО()
	
	Возврат "ЛегкийКлиентЭДО";
	
КонецФункции

Функция УстановленноеРасширение(ИмяМакетаРасширения)
	
	ОписаниеРасширения = Новый ОписаниеКонфигурации(ДанныеРасширенияИзМакета(ИмяМакетаРасширения));
	Отбор = Новый Структура("Имя", ОписаниеРасширения.Имя);
	Расширения = РасширенияКонфигурации.Получить(Отбор);
	
	Если Расширения.Количество() > 0 Тогда
		Возврат Расширения[0];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ДанныеРасширенияИзМакета(ИмяМакетаРасширения)
	
	Возврат ПолучитьОбщийМакет(ИмяМакетаРасширения);
	
КонецФункции

