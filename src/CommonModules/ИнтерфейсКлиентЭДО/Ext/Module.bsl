// @strict-types

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// Параметры:
//  ВариантИнтерфейса - Строка - См. ОбменСКонтрагентамиКлиентСервер.ВариантыИнтерфейсаПриглашенийЭДО
Процедура ПриОпределенииВариантаИнтерфейсаПриглашенийЭДО(ВариантИнтерфейса) Экспорт
	
	Если Не НастройкиКлиентЭДО.ИспользуетсяЛегкийКлиентЭДО() Тогда
		Возврат;
	КонецЕсли;
	
	ВариантИнтерфейса = ОбменСКонтрагентамиКлиентСервер.ВариантыИнтерфейсаПриглашенийЭДО().ЛегкийКлиентЭДО;
		
КонецПроцедуры

#Область ИнтерфейсДокументовЭДО

// При определении варианта интерфейса документов ЭДО.
// 
// Параметры:
//  ВариантИнтерфейса - Строка - См. ОбменСКонтрагентамиКлиентСервер.ВариантыИнтерфейсаДокументовЭДО
Процедура ПриОпределенииВариантаИнтерфейсаДокументовЭДО(ВариантИнтерфейса) Экспорт
	
	Если Не НастройкиКлиентЭДО.ИспользуетсяЛегкийКлиентЭДО() Тогда
		Возврат;
	КонецЕсли;
	
	ВариантИнтерфейса = ОбменСКонтрагентамиКлиентСервер.ВариантыИнтерфейсаДокументовЭДО().ЛегкийКлиентЭДО;
		
КонецПроцедуры

// Определяет необходимость вывода окна с выбором варианта интерфейса документов ЭДО.
// 
// Параметры:
//  ВыборВариантаИнтерфейсаДоступен - Булево
Процедура ПриОпределенииДоступностиВыбораВариантаИнтерфейсаДокументовЭДО(ВыборВариантаИнтерфейсаДоступен) Экспорт
	
	Если НастройкиКлиентЭДО.ИспользуетсяЛегкийКлиентЭДО() Тогда
		ВыборВариантаИнтерфейсаДоступен = Ложь;
	КонецЕсли;
	
КонецПроцедуры

// См. ЛегкийИнтерфейсДокументовЭДОСлужебный.ПриЗаполненииДанныхКомпонентаПанельСвязанныхДокументовЛегкийКлиентЭДО
//
// Параметры:
//  ДанныеКомпонента - См. ЛегкийИнтерфейсДокументовЭДОСлужебный.ПриЗаполненииДанныхКомпонентаПанельСвязанныхДокументовЛегкийКлиентЭДО.ДанныеКомпонента
//  СвойстваДокумента - См. ЛегкийИнтерфейсДокументовЭДОСлужебный.ПриЗаполненииДанныхКомпонентаПанельСвязанныхДокументовЛегкийКлиентЭДО.СвойстваДокумента
//  ОбъектыУчета - См. ЛегкийИнтерфейсДокументовЭДОСлужебный.ПриЗаполненииДанныхКомпонентаПанельСвязанныхДокументовЛегкийКлиентЭДО.ОбъектыУчета
Процедура ПриЗаполненииДанныхКомпонентаПанельСвязанныхДокументовЛегкийКлиентЭДО(ДанныеКомпонента, СвойстваДокумента,
	ОбъектыУчета) Экспорт
	
	КлиентЭДО.ПриЗаполненииДанныхКомпонентаПанельСвязанныхДокументовМаркировка(ДанныеКомпонента,
		СвойстваДокумента.Ссылка, ОбъектыУчета);
	
	Если Не ЗначениеЗаполнено(ОбъектыУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ОбъектУчета Из ОбъектыУчета Цикл
		ЗаполнитьСвязанныеДокументы(ДанныеКомпонента.СвязанныеДокументы, ОбъектУчета, СвойстваДокумента.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти // ИнтерфейсДокументовЭДО

#Область ПодключаемыеКоманды

// См. ПодключаемыеКомандыПереопределяемый.ПриОпределенииВидовПодключаемыхКоманд
//
Процедура ПриОпределенииВидовПодключаемыхКоманд(ВидыПодключаемыхКоманд) Экспорт
	
	Вид = ВидыПодключаемыхКоманд.Добавить();
	Вид.Имя = ВидКомандыСозданияУчетныхДокументов();
	Вид.ИмяПодменю = "ПодменюСоздатьДокументы";
	Вид.Заголовок = НСтр("ru = 'Создать'");
	Вид.Картинка = БиблиотекаКартинок.ДобавитьДокументПакетаБЭД;
	Вид.Отображение = ОтображениеКнопки.КартинкаИТекст;
	Вид.Порядок = 1;
	
	Вид = ВидыПодключаемыхКоманд.Добавить();
	Вид.Имя = ВидКомандыСозданияКонтрагента();
	Вид.ИмяПодменю = "ГруппаСоздатьКонтрагента";
	Вид.Заголовок = НСтр("ru = 'Создать'");
	Вид.Картинка = БиблиотекаКартинок.ДобавитьДокументПакетаБЭД;
	Вид.Отображение = ОтображениеКнопки.КартинкаИТекст;
	Вид.Порядок = 1;
	
	Вид = ВидыПодключаемыхКоманд.Добавить();
	Вид.Имя = ВидКомандыСозданияКонтрагентаПодменю();
	Вид.ИмяПодменю = "ГруппаДействийСКонтрагентом";
	Вид.Заголовок = НСтр("ru = 'Контрагенты'");
	Вид.Отображение = ОтображениеКнопки.Текст;
	Вид.Порядок = 1;
	
	Вид = ВидыПодключаемыхКоманд.Добавить();
	Вид.Имя = ВидКомандыСозданияНаОсновании();
	Вид.ИмяПодменю = "ПодменюСоздатьНаОсновании";
	Вид.Заголовок = НСтр("ru = 'Создать на основании'");
	Вид.Картинка = БиблиотекаКартинок.СкопироватьОбъект;
	Вид.Отображение = ОтображениеКнопки.КартинкаИТекст;
	Вид.Порядок = 1;

КонецПроцедуры

// См. ПодключаемыеКомандыПереопределяемый.ПриОпределенииСоставаНастроекПодключаемыхОбъектов
//
Процедура ПриОпределенииСоставаНастроекПодключаемыхОбъектов(НастройкиПрограммногоИнтерфейса) Экспорт
	
	Настройка = НастройкиПрограммногоИнтерфейса.Добавить();
	Настройка.Ключ = "ДобавитьКомандыСозданияДокументов";
	Настройка.ОписаниеТипов = Новый ОписаниеТипов("Булево");
	Настройка.ВидыПодключаемыхОбъектов = "Документ";
	
	Настройка = НастройкиПрограммногоИнтерфейса.Добавить();
	Настройка.Ключ = "ДобавитьКомандыСозданияКонтрагента";
	Настройка.ОписаниеТипов = Новый ОписаниеТипов("Булево");
	Настройка.ВидыПодключаемыхОбъектов = "Справочник";
	
	Настройка = НастройкиПрограммногоИнтерфейса.Добавить();
	Настройка.Ключ = "ДобавитьКомандыСоздатьНаОсновании";
	Настройка.ОписаниеТипов = Новый ОписаниеТипов("Булево");
	Настройка.ВидыПодключаемыхОбъектов = "Документ";

КонецПроцедуры

// См. ПодключаемыеКомандыПереопределяемый.ПриОпределенииКомандПодключенныхКОбъекту
//
Процедура ПриОпределенииКомандПодключенныхКОбъекту(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки,
	Команды) Экспорт
	
	ИмяТекущейФормы = НастройкиФормы.ИмяФормы; // Строка
	
	Если Не НастройкиКлиентЭДО.ИспользуетсяЛегкийКлиентЭДО() Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяТекущейФормы = ОбменСКонтрагентами.ПутьКФормеТекущихДелЭДО() Тогда
		
		ЗаполнитьКомандыСозданияУчетныхДокументов(Команды, Источники);
		ЗаполнитьПодключаемыеКомандыКонтрагентов(Команды, Источники);
		
	КонецЕсли;
	
	Если ИмяТекущейФормы = ОбменСКонтрагентами.ПутьКФормеПросмотраЭлектронногоДокумента()
		Или ИмяТекущейФормы = ОбменСКонтрагентами.ПутьКФормеПросмотраЭлектронногоДокумента(Истина) Тогда
		ЗаполнитьКомандыВводаНаОсновании(Команды, Источники);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти // ПодключаемыеКоманды

#Область ГосИС

// Используется для вывода в формах учетных документов (черновиков) команд создания документов и ссылок на уже созданные.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * Объект - ДанныеФормыСтруктура:
//   ** Ссылка - ДокументСсылка
//  ДанныеПанели - См. НовыеДанныеПанелиСвязанныхДокументов
Процедура ПриЗаполненииДанныхПанелиСвязанныхДокументов(Форма, ДанныеПанели) Экспорт
	
	// КлиентЭДО начало
	КлиентЭДО.ПриЗаполненииДанныхКомпонентаПанельСвязанныхДокументовМаркировка(
		ДанныеПанели, Форма.Объект.Ссылка);
	// КлиентЭДО конец
	
КонецПроцедуры

// Используется для вывода в формах учетных документов (черновиков) дополнительных состояний связанных документов.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * Объект - ДанныеФормыСтруктура:
//   ** Ссылка - ЛюбаяСсылка
//  ДанныеПанели - См. НовыеДанныеПанелиДополнительногоСостояния
Процедура ПриЗаполненииДанныхПанелиДополнительногоСостояния(Форма, ДанныеПанели) Экспорт
	
	ДанныеСостояния = СоответствиеТребованиямГИСМТ.СостояниеКомандыСоответствиеТребованиямГИСМТ(Форма.Объект.Ссылка);
	
	Если ДанныеСостояния.Статус = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НовыеДанныеПанели = ДанныеПанели.ЭлементыДополнительногоСостояния.Добавить();
	НовыеДанныеПанели.Идентификатор = "СоответствиеТребованиямГИСМТГосИС";
	НовыеДанныеПанели.Представление = ДанныеСостояния.Заголовок;
	НовыеДанныеПанели.Обработчик    = "КлиентЭДОКлиент.ОбработчикГиперссылкиПанелиДополнительногоСостоянияЛекгийКлиентЭДО";
	НовыеДанныеПанели.Значение      = НовыеДанныеПанели.Идентификатор;
	
	ДанныеПанели.ЦветПанелиДополнительногоСостояния = ЦветПанелиПоСостояниюПроверкиГИСМП(ДанныеСостояния);
	
КонецПроцедуры

// Цвет панели по состоянию проверки ГИСМП.
// 
// Параметры:
//  ДанныеСостояния - см. СоответствиеТребованиямГИСМТ.СостояниеКомандыСоответствиеТребованиямГИСМТ
// 
// Возвращаемое значение:
//  Цвет - Цвет панели по состоянию проверки ГИСМП
Функция ЦветПанелиПоСостояниюПроверкиГИСМП(ДанныеСостояния) Экспорт
	
	ЦветаПанелиДополнительногоСостояния = ЦветаПанелиДополнительногоСостояния();
	
	Если ДанныеСостояния.ПроверкаОтключена Тогда
		Возврат ЦветаПанелиДополнительногоСостояния.Зеленый;
	ИначеЕсли ДанныеСостояния.Статус = Перечисления.СтатусыОбработкиДокументовИСМП.ЗавершеноСОшибкой
		Или ДанныеСостояния.Статус = Перечисления.СтатусыОбработкиДокументовИСМП.ЗавершеноСОшибкойТаймаута Тогда
		Возврат ЦветаПанелиДополнительногоСостояния.Красный;
	ИначеЕсли ДанныеСостояния.Статус = Перечисления.СтатусыОбработкиДокументовИСМП.Завершено Тогда
		Возврат ЦветаПанелиДополнительногоСостояния.Зеленый;
	ИначеЕсли ДанныеСостояния.Статус = Перечисления.СтатусыОбработкиДокументовИСМП.ЗавершеноСОжиданием Тогда
		Если ДанныеСостояния.ОтправленНаПредварительнуюПроверку Тогда
			Если ДанныеСостояния.ВыполненаПредварительнаяПроверка Тогда
				Возврат ЦветаПанелиДополнительногоСостояния.Зеленый;
			Иначе
				Возврат ЦветаПанелиДополнительногоСостояния.Желтый;
			КонецЕсли;
		Иначе
			Возврат ЦветаПанелиДополнительногоСостояния.Зеленый;
		КонецЕсли;
	Иначе
		Возврат ЦветаПанелиДополнительногоСостояния.Желтый;
	КонецЕсли;
	
КонецФункции

// Возвращаемое значение:
//  Структура:
// * Зеленый - Цвет
// * Желтый - Цвет
// * Красный - Цвет
Функция ЦветаПанелиДополнительногоСостояния() Экспорт

	Цвета = Новый Структура;
	Цвета.Вставить("Зеленый", ЦветаСтиля.ЦветФонаЗеленыйСостояниеДокументаБЭД);
	Цвета.Вставить("Желтый",  ЦветаСтиля.ЦветФонаЖелтыйСостояниеДокументаБЭД);
	Цвета.Вставить("Красный", ЦветаСтиля.ЦветФонаКрасныйСостояниеДокументаБЭД);
	Возврат Цвета;

КонецФункции

#КонецОбласти // ГосИС

#КонецОбласти // ДляВызоваИзДругихПодсистем

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Если Не ВнешнееСоединение Тогда

// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * Объект - ДанныеФормыСтруктура
//  * ФорматЭлектронногоДокумента - Строка
//  * ФорматыЭлектронныхДокументов - ДанныеФормыКоллекция:
//  ** ВыбранПоУмолчанию - Булево
//  ** ИдентификаторФормата - Строка
//  ** ПредставлениеФормата - Строка
//  ДокументОбъект - ДокументОбъект
Процедура ЗаполнитьДанныеПоФорматамЭлектронныхДокументовВФормеДокумента(Форма, ДокументОбъект) Экспорт

	Форма.ФорматыЭлектронныхДокументов.Очистить();

	//@skip-check invocation-parameter-type-intersect
	ДоступныеФорматыЭлектронныхДокументов = ОбменСКонтрагентами.ДоступныеФорматыЭлектронныхДокументов(ДокументОбъект);
	Форма.ФорматыЭлектронныхДокументов.Загрузить(ДоступныеФорматыЭлектронныхДокументов);

	Для Каждого Формат Из ДоступныеФорматыЭлектронныхДокументов Цикл
		Если Формат.ВыбранПоУмолчанию И Не ЗначениеЗаполнено(Форма.ФорматЭлектронногоДокумента) Тогда
			Форма.ФорматЭлектронногоДокумента = Формат.ИдентификаторФормата;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * Объект - ДанныеФормыСтруктура:
//  ** Ссылка - ДокументСсылка
//  * Элементы - ВсеЭлементыФормы:
//  ** СохранитьЧерновик - КнопкаКоманднойПанели
//  ** ФорматДокумента - ПолеВвода
Процедура НастроитьДоступностьФормыДокументаПоСвязанномуЭлектронномуДокументу(Форма) Экспорт
	
	Если ОбменСКонтрагентами.ДоступноВнесениеИзмененийВДанныеЭлектронногоДокументаПоОбъектамУчета(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Форма.Объект.Ссылка)) Тогда
		Возврат;
	КонецЕсли;
			
	Форма.Элементы.СохранитьЧерновик.Видимость = Ложь;
	Форма.Элементы.ФорматДокумента.ТолькоПросмотр = Истина;
	Форма.ТолькоПросмотр = Истина;
	
КонецПроцедуры

#Область ПанельДополнительногоСостояния

// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * Объект - ДанныеФормыСтруктура:
//   ** Ссылка - ЛюбаяСсылка
//  * КомандыДополнительногоСостояния - Произвольный
Процедура ПодготовитьПанельДополнительногоСостояния(Форма) Экспорт
	
	ДанныеПанели = НовыеДанныеПанелиДополнительногоСостояния();
	
	ЗаполнитьДанныеПанелиДополнительногоСостояния(Форма, ДанныеПанели);
	
	НастроитьПанельДополнительногоСостояния(Форма, ДанныеПанели);

КонецПроцедуры

// Возвращаемое значение:
//  Структура:
// * ЭлементыДополнительногоСостояния - См. НовыеЭлементыДополнительногоСостояния
// * ЦветПанелиДополнительногоСостояния - Неопределено
//                                      - См. ЦветаПанелиДополнительногоСостояния
Функция НовыеДанныеПанелиДополнительногоСостояния() Экспорт

	ДанныеПанели = Новый Структура;
	ДанныеПанели.Вставить("ЭлементыДополнительногоСостояния", НовыеЭлементыДополнительногоСостояния());
	ДанныеПанели.Вставить("ЦветПанелиДополнительногоСостояния", Неопределено);
	Возврат ДанныеПанели;
	
КонецФункции

#КонецОбласти // ПанельДополнительногоСостояния

#Область ПанельСвязанныхДокументов

// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * Объект - ДанныеФормыСтруктура:
//   ** Ссылка - ЛюбаяСсылка
//  * КомандыСозданияСвязанныхДокументов - Произвольный
//  * СвязанныеДокументы - СписокЗначений Из ЛюбаяСсылка
Процедура ПодготовитьПанельСвязанныхДокументов(Форма) Экспорт
	
	ДанныеПанели = НовыеДанныеПанелиСвязанныхДокументов();
	
	ЗаполнитьДанныеПанелиСвязанныхДокументов(Форма, ДанныеПанели);
	
	НастроитьПанельСвязанныхДокументов(Форма, ДанныеПанели);

КонецПроцедуры

// Возвращаемое значение:
//  Структура:
// * КомандыСоздания - См. НовыеКомандыСозданияСвязанныхДокументов
// * СвязанныеДокументы - См. НовыеДанныеСвязанныхДокументов
Функция НовыеДанныеПанелиСвязанныхДокументов() Экспорт
	
	ДанныеПанели = Новый Структура;
	ДанныеПанели.Вставить("КомандыСоздания", НовыеКомандыСозданияСвязанныхДокументов());
	ДанныеПанели.Вставить("СвязанныеДокументы", НовыеДанныеСвязанныхДокументов());
	Возврат ДанныеПанели;
	
КонецФункции

#КонецОбласти // ПанельСвязанныхДокументов

#КонецЕсли // ВнешнееСоединение

#Область ИзменениеКомандногоИнтерфейса

// Устаналивает расширение изменения интерфейса легкий клиент ЭДО, возвращает результат установки.
// 
// Возвращаемое значение:
//  Булево - Расширение установлено. 
Функция УстановитьРасширениеЛегкийКлиентЭДО() Экспорт
	
	ТребуетсяУстановкаРасширения = Ложь;
	
	Если Не НастройкиКлиентЭДО.ИспользуетсяЛегкийКлиентЭДО() Тогда
		Возврат ТребуетсяУстановкаРасширения;
	КонецЕсли;
	
	РасширениеЛегкийКлиентЭДО = УстановленноеРасширениеИзмененияИнтерфейсаЛегкийКлиентЭДО();
	
	Если РасширениеЛегкийКлиентЭДО = Неопределено Тогда
		
		ТребуетсяУстановкаРасширения = Истина;
		
	Иначе
		
		ДанныеПоставляемогоРасширения = РасширениеИзмененияИнтерфейсаЛегкийКлиентЭДОИзМакета();
		
		МетаданныеПоставляемогоРасширения = Новый ОбъектМетаданныхКонфигурация(ДанныеПоставляемогоРасширения);
		МетаданныеУстановленногоРасширения = Новый ОбъектМетаданныхКонфигурация(
			РасширениеЛегкийКлиентЭДО.ПолучитьДанные());
			
		ОписаниеТипаЧисло = Новый ОписаниеТипов("Число", Неопределено,
			Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный));
		ВерсияПоставляемогоРасширения = ОписаниеТипаЧисло.ПривестиЗначение(МетаданныеПоставляемогоРасширения.Версия);
		ВерсияУстановленногоРасширения = ОписаниеТипаЧисло.ПривестиЗначение(МетаданныеУстановленногоРасширения.Версия);
		
		Если Не РасширениеЛегкийКлиентЭДО.Активно
			Или РасширениеЛегкийКлиентЭДО.БезопасныйРежим
			Или РасширениеЛегкийКлиентЭДО.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях
			Или РасширениеЛегкийКлиентЭДО.ИспользоватьОсновныеРолиДляВсехПользователей
			Или ВерсияПоставляемогоРасширения > ВерсияУстановленногоРасширения Тогда
			
			УдалитьРасширениеИзмененияИнтерфейсаЛегкийКлиентЭДО();
			
			ТребуетсяУстановкаРасширения = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТребуетсяУстановкаРасширения Тогда
		УстановитьРасширениеИзмененияИнтерфейсаЛегкийКлиентЭДО();
	КонецЕсли;
	
	Возврат ТребуетсяУстановкаРасширения;
	
КонецФункции

#КонецОбласти // ИзменениеКомандногоИнтерфейса

#КонецОбласти // СлужебныйПрограммныйИнтерфейс

