// @strict-types

#Область ПрограммныйИнтерфейс

// Установка значений функциональных опций при проверке регистрации услуг.
// 
// Параметры:
//  Перезапустить - Булево - Перезапустить
Процедура НастроитьЗарегистрированныеУслугиПередЗапуском(Перезапустить) Экспорт
	// ТехнологияСервиса
	Если РаботаВМоделиСервиса.РазделениеВключено()
		И РаботаВМоделиСервиса.ДоступноИспользованиеРазделенныхДанных() 
		И Не ОбщегоНазначения.ЭтоМобильныйКлиент() Тогда
		
		Если Пользователи.ЭтоПолноправныйПользователь(, Истина) Тогда
			Возврат;
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Истина);
		
		ИдентификаторПоставщикаКЭДО = ТарификацияКЭДО.ИдентификаторПоставщикаКЭДО();
		ИдентификаторУслугиМаркировка = ТарификацияКЭДО.ИдентификаторУслугиМаркировка();
		ИдентификаторУслугиЛегкийКлиентЭДО = ТарификацияКЭДО.ИдентификаторУслугиЛегкийКлиентЭДО();
		
		ИспользоватьЛегкийКлиентЭДО = Тарификация.ЗарегистрированаЛицензияБезлимитнойУслуги(
			ИдентификаторПоставщикаКЭДО, ИдентификаторУслугиЛегкийКлиентЭДО)
			И ТарификацияКЭДО.УслугаТарифицируется(ИдентификаторУслугиЛегкийКлиентЭДО, ИдентификаторПоставщикаКЭДО);
			
		Если ИспользоватьЛегкийКлиентЭДО <> Константы.ИспользоватьЛегкийКлиентЭДО.Получить() Тогда
			Если ИспользоватьЛегкийКлиентЭДО Тогда
				ТарификацияКЭДО.ПриПодключенииУслугиЛегкийКлиентЭДО(Истина);
			Иначе
				ТарификацияКЭДО.ПриОтключенииУслугиЛегкийКлиентЭДО(Истина);				
			КонецЕсли;
			Перезапустить = Истина;
		КонецЕсли;	
		
		Если ИспользоватьЛегкийКлиентЭДО И ИнтерфейсКлиентЭДО.УстановитьРасширениеЛегкийКлиентЭДО() Тогда
			Перезапустить = Истина;
		КонецЕсли;
		
		ИспользоватьГосИС = Тарификация.ЗарегистрированаЛицензияБезлимитнойУслуги(
			ИдентификаторПоставщикаКЭДО, ИдентификаторУслугиМаркировка)
			И ТарификацияКЭДО.УслугаТарифицируется(ИдентификаторУслугиМаркировка, ИдентификаторПоставщикаКЭДО);	
			
		Если ИспользоватьГосИС <> Константы.ИспользоватьГосИС.Получить() Тогда
			Если ИспользоватьГосИС Тогда
				ТарификацияКЭДО.ПриПодключенииУслугиМаркировка(Истина);
			Иначе
				ТарификацияКЭДО.ПриОтключенииУслугиМаркировка(Истина);
			КонецЕсли;
			Перезапустить = Истина;
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Ложь);
	
	КонецЕсли;
	// Конец ТехнологияСервиса
КонецПроцедуры

// Представление конфигурации
// 
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеКонфигурации() Экспорт
	
	Возврат ТарификацияКЭДО.ПредставлениеКонфигурации();
	
КонецФункции

#КонецОбласти
