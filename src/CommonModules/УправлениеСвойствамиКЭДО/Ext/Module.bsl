// Имена предопределенных наборов свойств.
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура:
// * Справочник_Номенклатура - Строка
// * Справочник_Номенклатура_Общие - Строка
// * Справочник_ХарактеристикиНоменклатуры - Строка
// * Справочник_ХарактеристикиНоменклатуры_Общие - Строка
// * Документ_АктОРасхожденияхПоПриемке - Строка
// * Документ_ЗаказПокупателя - Строка
// * Документ_АктОРасхожденияхПоОтгрузке - Строка
// * Документ_ЗаказПоставщику - Строка
// * Документ_ПоступлениеТоваровУслуг - Строка
// * Документ_РеализацияТоваровУслуг - Строка
// * Документ_СчетНаОплатуПокупателю - Строка
// * Документ_СчетНаОплатуПоставщика - Строка
// * Документ_СчетФактураВыданный - Строка
// * Документ_СчетФактураПолученный - Строка
// * Документ_ЗапросКоммерческихПредложенийПоставщиков - Строка
// * Документ_ЗапросКоммерческогоПредложенияОтКлиента - Строка
// * Документ_КоммерческоеПредложениеКлиенту - Строка
// * Документ_КоммерческоеПредложениеПоставщика - Строка
Функция ИменаПредопределенныхНаборов() Экспорт
	ИменаНаборов = Новый Структура;
	ИменаНаборов.Вставить("Справочник_Номенклатура", "Справочник_Номенклатура");
	ИменаНаборов.Вставить("Справочник_Номенклатура_Общие", "Справочник_Номенклатура_Общие");
	ИменаНаборов.Вставить("Справочник_ХарактеристикиНоменклатуры", "Справочник_ХарактеристикиНоменклатуры");
	ИменаНаборов.Вставить("Справочник_ХарактеристикиНоменклатуры_Общие", "Справочник_ХарактеристикиНоменклатуры_Общие");
	ИменаНаборов.Вставить("Документ_АктОРасхожденияхПоПриемке", "Документ_АктОРасхожденияхПоПриемке");
	ИменаНаборов.Вставить("Документ_ЗаказПокупателя", "Документ_ЗаказПокупателя");
	ИменаНаборов.Вставить("Документ_АктОРасхожденияхПоОтгрузке", "Документ_АктОРасхожденияхПоОтгрузке");
	ИменаНаборов.Вставить("Документ_ЗаказПоставщику", "Документ_ЗаказПоставщику");
	ИменаНаборов.Вставить("Документ_ПоступлениеТоваровУслуг", "Документ_ПоступлениеТоваровУслуг");
	ИменаНаборов.Вставить("Документ_РеализацияТоваровУслуг", "Документ_РеализацияТоваровУслуг");
	ИменаНаборов.Вставить("Документ_СчетНаОплатуПокупателю", "Документ_СчетНаОплатуПокупателю");
	ИменаНаборов.Вставить("Документ_СчетНаОплатуПоставщика", "Документ_СчетНаОплатуПоставщика");
	ИменаНаборов.Вставить("Документ_СчетФактураВыданный", "Документ_СчетФактураВыданный");
	ИменаНаборов.Вставить("Документ_СчетФактураПолученный", "Документ_СчетФактураПолученный");
	ИменаНаборов.Вставить("Документ_ЗапросКоммерческихПредложенийПоставщиков",
		"Документ_ЗапросКоммерческихПредложенийПоставщиков");
	ИменаНаборов.Вставить("Документ_ЗапросКоммерческогоПредложенияОтКлиента",
		"Документ_ЗапросКоммерческогоПредложенияОтКлиента");
	ИменаНаборов.Вставить("Документ_КоммерческоеПредложениеКлиенту", "Документ_КоммерческоеПредложениеКлиенту");
	ИменаНаборов.Вставить("Документ_КоммерческоеПредложениеПоставщика", "Документ_КоммерческоеПредложениеПоставщика");
	Возврат Новый ФиксированнаяСтруктура(ИменаНаборов);
КонецФункции

