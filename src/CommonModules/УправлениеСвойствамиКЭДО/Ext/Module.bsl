// Например, общие свойства и свойства по виду номенклатуры.
// 
// Параметры:
//  Объект - См. УправлениеСвойствамиПереопределяемый.ЗаполнитьНаборыСвойствОбъекта.Объект
//  ТипСсылки - См. УправлениеСвойствамиПереопределяемый.ЗаполнитьНаборыСвойствОбъекта.ТипСсылки
//  НаборыСвойств - См. УправлениеСвойствамиПереопределяемый.ЗаполнитьНаборыСвойствОбъекта.НаборыСвойств
Процедура ЗаполнитьНаборСвойствДляНоменклатуры(Объект, ТипСсылки, НаборыСвойств)

	ИменаПредопределенныхНаборов = ИменаПредопределенныхНаборов();
	ОписаниеСвойств = НаборыСвойств.Добавить();
	ОписаниеСвойств.Набор = УправлениеСвойствами.НаборСвойствПоИмени(ИменаПредопределенныхНаборов.Справочник_Номенклатура_Общие);
	ОписаниеСвойств.ОбщийНабор = Истина;

	Если ТипЗнч(Объект) = ТипСсылки Тогда
		Номенклатура = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Объект, "ЭтоГруппа, ВидНоменклатуры");
	Иначе
		Номенклатура = Объект;
	КонецЕсли;

	Если Номенклатура.ЭтоГруппа = Ложь Тогда
		ОписаниеСвойств = НаборыСвойств.Добавить();
		ОписаниеСвойств.Набор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			Номенклатура.ВидНоменклатуры, "НаборСвойств");
	КонецЕсли;

КонецПроцедуры

// Заполняет доступные для характеристик номенклатуры наборы свойств
// Например, общие свойства и свойства по виду номенклатуры.
// 
// Параметры:
//  Объект - См. УправлениеСвойствамиПереопределяемый.ЗаполнитьНаборыСвойствОбъекта.Объект
//  ТипСсылки - См. УправлениеСвойствамиПереопределяемый.ЗаполнитьНаборыСвойствОбъекта.ТипСсылки
//  НаборыСвойств - См. УправлениеСвойствамиПереопределяемый.ЗаполнитьНаборыСвойствОбъекта.НаборыСвойств
Процедура ЗаполнитьНаборСвойствДляХарактеристики(Объект, ТипСсылки, НаборыСвойств)

	ИменаПредопределенныхНаборов = ИменаПредопределенныхНаборов();
	ОписаниеСвойств = НаборыСвойств.Добавить();
	ОписаниеСвойств.Набор = УправлениеСвойствами.НаборСвойствПоИмени(ИменаПредопределенныхНаборов.Справочник_Номенклатура_Общие);
	ОписаниеСвойств.ОбщийНабор = Истина;

	Если ТипЗнч(Объект) = ТипСсылки Тогда
		Характеристика = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, "Владелец");
	Иначе
		Характеристика = Объект;
	КонецЕсли;

	ВидНоменклатуры = Неопределено;
	ТипВладельца = ТипЗнч(Характеристика.Владелец);
	Если ТипВладельца = Тип("СправочникСсылка.ВидыНоменклатуры") Тогда
		ВидНоменклатуры = Характеристика.Владелец;
	ИначеЕсли ТипВладельца = Тип("СправочникСсылка.Номенклатура") Тогда
		ВидНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Характеристика.Владелец, "ВидНоменклатуры");
	КонецЕсли;
	Если ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		ОписаниеСвойств = НаборыСвойств.Добавить();
		ОписаниеСвойств.Набор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидНоменклатуры, "НаборСвойствХарактеристик");
	КонецЕсли;

КонецПроцедуры

