// Назначение модуля: Серверное определение координат по адресу через DaData; ключ получается из настроек информационной базы.
// Отправляет адрес в сервис геокодирования и возвращает найденные координаты либо признак отсутствия результата.
// Параметры:
//   Адрес - почтовый адрес в виде строки.
// Возвращаемое значение:
//   Структура с координатами Широта и Долгота либо незаполненными значениями.
Функция КоординатыПоАдресу(Адрес) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Широта", Неопределено);
	Результат.Вставить("Долгота", Неопределено);
	
	Адрес = СокрЛП(Строка(Адрес));
	
	Если ПустаяСтрока(Адрес) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Токен = Константы.РОТКО_ТокенDaData.Получить();  
	
	Если ПустаяСтрока(Токен) Тогда
		ВызватьИсключение "Не настроен токен сервиса DaData.";
	КонецЕсли;
	
	Попытка
		
		Соединение = Новый HTTPСоединение("suggestions.dadata.ru", 443,,,,, Новый ЗащищенноеСоединениеOpenSSL);
		
		HTTPЗапрос = Новый HTTPЗапрос("/suggestions/api/4_1/rs/suggest/address");
		
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");
		HTTPЗапрос.Заголовки.Вставить("Authorization", "Token " + Токен);
		
		ПараметрыЗапроса = Новый Структура;
		ПараметрыЗапроса.Вставить("query", Адрес);
		ПараметрыЗапроса.Вставить("count", 1);
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ПараметрыЗапроса);
		ТелоЗапроса = ЗаписьJSON.Закрыть();
		
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
		
		HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		
		Если HTTPОтвет.КодСостояния < 200 Или HTTPОтвет.КодСостояния >= 300 Тогда
			Возврат Результат;
		КонецЕсли;
		
		ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
		
		Подсказки = Неопределено;
		
		Если НЕ ДанныеОтвета.Свойство("suggestions", Подсказки) Тогда
			Возврат Результат;
		КонецЕсли;
		
		Если Подсказки.Количество() = 0 Тогда
			Возврат Результат;
		КонецЕсли;
		
		ПерваяПодсказка = Подсказки[0];
		
		ДанныеАдреса = Неопределено;
		
		Если НЕ ПерваяПодсказка.Свойство("data", ДанныеАдреса) Тогда
			Возврат Результат;
		КонецЕсли;
		
		Широта = Неопределено;
		Долгота = Неопределено;
		
		ДанныеАдреса.Свойство("geo_lat", Широта);
		ДанныеАдреса.Свойство("geo_lon", Долгота);
		
		Результат.Широта = Широта;
		Результат.Долгота = Долгота;
		
	Исключение
		
		// Можно записывать ошибку в журнал регистрации.
		// Пока просто возвращаем пустой результат.
		Возврат Результат;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции
