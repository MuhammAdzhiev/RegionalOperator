КонецПроцедуры

// Для БРМК. Определяет коды маркировки на оборудовании розлива по переданной таблице товаров.
// Необходимо заполнить выходной параметр КегиНаОборудованииРозлива
// 
// Параметры:
//  ВскрытыеПотребительскиеУпаковки - ТаблицаЗначений - Коды маркировки подключенные к оборудованию розлива:
//  * Номенклатура - ОпределяемыйТип.Номенклатура - номенклатура кода маркировки кега
//  * Характеристика - ОпределяемыйТип.ХарактеристикаНоменклатуры - характеристика кода маркировки кега
//  * Серия - ОпределяемыйТип.СерияНоменклатуры - серия кода маркировки кега
//  * ИндексИсходнойСтроки - Число - Служебный, в переопределении можно не заполнять
//  * УчитыватьСерии - Булево - учитвать серии исходной таблицы товаров
//  * ВариантЧастичногоВыбытия - ПеречислениеСсылка.ВариантыУчетаЧастичногоВыбытияИС - настройка частичного выбытия номенклатуры
//  * КодМаркировки - ОпределяемыйТип.ШтрихкодУпаковкиИС - код маркировки кега
//  * Комментарий - ОпределяемыйТип.ОборудованиеРозливаИСМП - описание оборудования, к которому подключен кег см. РегистрыСведений.ВскрытыеПотребительскиеУпаковкиИС
//  * КодМаркировкиСтрокой - Строка - представление кода маркировки см. РегистрыСведений.ВскрытыеПотребительскиеУпаковкиИС
//  * ПолныйКодМаркировки - Строка - полный код маркировки кега Base64 см. РегистрыСведений.ВскрытыеПотребительскиеУпаковкиИС
//  ТаблицаТовары - см. РегистрыСведений.ВскрытыеПотребительскиеУпаковкиИС.НоваяТаблицаПоискаВскрытыхПотребительскихУпаковок
//  ПараметрыСканирования - см. ШтрихкодированиеОбщегоНазначенияИС.ПараметрыСканирования
//  ТолькоПолноеСоответствие - Булево - Искать без учета подменной номенклатуры
Процедура ПриОпределенииВскрытыхПотребительскихУпаковок(ВскрытыеПотребительскиеУпаковки, ТаблицаТовары, ПараметрыСканирования, ТолькоПолноеСоответствие) Экспорт
	
	Возврат;
	
КонецПроцедуры

// Для БРМК. Определяет параметры полей описания номенклатуры по коду маркировки.
// 
// Параметры:
//  ПараметрыОписания - Структура:
//  *  ИмяПоляНоменклатураШтрихкода   - Строка - поле Номенклатура
//  *  ИмяПоляХарактеристикаШтрихкода - Строка - поле Характеристика
//  *  ИмяПоляСерияШтрихкода          - Строка - поле Серия
//  *  ПутьКИсточникуДанныхШтрихкода  - Строка - таблица источника
//  *  ИмяПоляКодМаркировки           - Строка - поле таблицы источника
Процедура ПриОпределенииПараметровИсточникаДанныхНоменклатурыПоКодуМаркировки(ПараметрыОписания) Экспорт
	
	Возврат;
	
КонецПроцедуры

// Заполняет представление строки номенклатуры.
//
// Параметры:
//  Представление  - Строка                                     - представление для заполнения,
//  Номенклатура   - ОпределяемыйТип.Номенклатура               - ссылка на номенклатуру,
//  Характеристика - ОпределяемыйТип.ХарактеристикаНоменклатуры - ссылка на характеристику номенклатуры,
//  Упаковка       - ОпределяемыйТип.Упаковка                   - ссылка на упаковку.
//  Серия          - ОпределяемыйТип.СерияНоменклатуры          - ссылка на серию номенклатуры.
Процедура ЗаполнитьПредставлениеНоменклатуры(Представление, Номенклатура, Характеристика, Упаковка, Серия) Экспорт
	
	НаименованиеНоменклатурыДляПечати = СокрЛП(Номенклатура);
	НаименованиеХарактеристикиДляПечати = СокрЛП(Характеристика);
	
	ТекстВСкобках = Новый Массив;
	
	Если ЗначениеЗаполнено(НаименованиеХарактеристикиДляПечати) Тогда
		ТекстВСкобках.Добавить(СокрЛП(НаименованиеХарактеристикиДляПечати));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Упаковка) Тогда
		ТекстВСкобках.Добавить(СокрЛП(Строка(Упаковка)));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Серия) Тогда
		ТекстВСкобках.Добавить(СокрЛП(Строка(Серия)));
	КонецЕсли;
	
	ТекстВСкобкахСтрока = СтрСоединить(ТекстВСкобках, ", ");
		
	Если ЗначениеЗаполнено(ТекстВСкобкахСтрока) Тогда
		Представление = НСтр("ru = '%НаименованиеНоменклатурыДляПечати% (%ТекстВСкобках%)'");
		Представление = СтрЗаменить(Представление, "%ТекстВСкобках%", СокрЛП(ТекстВСкобкахСтрока));
	Иначе
		Представление = НСтр("ru = '%НаименованиеНоменклатурыДляПечати%'");
	КонецЕсли;
	
	Представление = СтрЗаменить(Представление, "%НаименованиеНоменклатурыДляПечати%", СокрЛП(НаименованиеНоменклатурыДляПечати));

КонецПроцедуры

// Проверка, является ли партнер индивидуальным предпринимателем.
// 
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты, СправочникСсылка.Организации - Партнер
//  ЭтоИндивидуальныйПредприниматель - Булево - Истина, если это индивидуальный предприниматель
Процедура ПартнерЭтоИндивидуальныйПредприниматель(Контрагент, ЭтоИндивидуальныйПредприниматель) Экспорт
	
	//++ НЕ ГОСИС
	ЭтоИндивидуальныйПредприниматель = ИнтеграцияИСКЭДОВызовСервера.ПартнерЭтоИндивидуальныйПредприниматель(Контрагент);
	//-- НЕ ГОСИС
	Возврат;
	
КонецПроцедуры

#Область ПодключаемоеОборудование

// Настраивает подключаемое оборудование в форме,
// устанавливает флаг ИспользоватьПодключаемоеОборудование в форме.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, в которой необходимо настроить подключаемое оборудование,
//  ПрефиксыЭлементовФормы - Строка - строка имен табличных частей, разделенных запятыми, в которых нужно настроить видимость команд.
Процедура НастроитьПодключаемоеОборудование(Форма, ПрефиксыЭлементовФормы = "Товары") Экспорт
	
	ИнтеграцияИСКЭДО.НастроитьПодключаемоеОборудование(Форма, ПрефиксыЭлементовФормы);
	
	Если ЗначениеЗаполнено(ПрефиксыЭлементовФормы) Тогда
		МассивПрефиксыЭлементовФормы = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПрефиксыЭлементовФормы, ",");
	Иначе
		МассивПрефиксыЭлементовФормы = Новый Массив;
		МассивПрефиксыЭлементовФормы.Добавить(ПрефиксыЭлементовФормы);
	КонецЕсли;
	
	Если Форма.ИмяФормы <> "Обработка.ПроверкаИПодборПродукцииИС.Форма.ПроверкаИПодбор"
		И Форма.ИмяФормы <> "ОбщаяФорма.ФормаУточненияДанныхИС"
		И Форма.ИмяФормы <> "Обработка.ПроверкаИПодборПродукцииИС.Форма.УточнениеПодобраннойПродукции" Тогда
			
		Для Каждого Префикс Из МассивПрефиксыЭлементовФормы Цикл
			ИнтеграцияИСКЭДОКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Форма.Элементы,
				Префикс + "ВыгрузитьДанныеВТСД",
				"Видимость",
				Ложь);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// При определении обработчика обновления данных.
// 
// Параметры:
//  Обработчик - СтрокаТаблицыЗначений: см. ОбновлениеИнформационнойБазы.НоваяТаблицаОбработчиковОбновления
//  ОбъектМетаданных - ОбъектМетаданных
Процедура ПриОпределенииОбработчикаОбновленияДанных(Обработчик, ОбъектМетаданных) Экспорт
	
	Если ОбъектМетаданных = Метаданные.Справочники.Номенклатура Тогда
		Обработчик.Процедура                           = "ИнтеграцияИСКЭДО.ОбработатьНоменклатуруДляПереходаНаНовуюВерсиюКонструктораНастроек";
		Обработчик.ПроцедураЗаполненияДанныхОбновления = "ИнтеграцияИСКЭДО.ЗарегистрироватьНоменклатуруКОбработкеДляПереходаНаНовуюВерсиюКонструктораНастроек";
	КонецЕсли;
	
КонецПроцедуры

// Заполняет поля номенклатуры для перехода на конструктор настроек. В методе недобходимо для каждой строки номенклатуры:
// - заполнить вид продукции (перечисление) по особенности учета
// - установить Истина в поле ЭтоМернаяЕдиницаИзмерения, если базовая единица измерения мерная (килограмм, литр, метр и т.д.)
// - установить Ложь в поле ЭтоПодакцизнаяПродукцияЕГАИС, если позиция номенклатуры с особенностью учета ЕГАИС и связана с немаркируемым видом алкогольной продукции
//   (реквизит Маркируемый в справочнике ВидыАлкогольнойПродукции)
// В таблице присутствует поле ИндексСтроки для оптимизации заполнения входящей таблицы.
// 
// Параметры:
//  ТаблицаНоменклатуры - см. ОбновлениеИнформационнойБазыГосИС.НоваяТаблицаДляОбработкиНоменклатурыПриПереходеНаКонструкторНастроек
Процедура ПриЗаполненииТаблицыНоменклатурыДляПереходаНаКонструкторНастроекВидовПродукции(ТаблицаНоменклатуры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Источник.ИндексСтроки,
		|	Источник.Номенклатура
		|ПОМЕСТИТЬ Источник
		|ИЗ
		|	&Источник КАК Источник
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Источник.Номенклатура,
		|	Источник.ИндексСтроки,
		|	ЕСТЬNULL(СправочникНоменклатура.ВидАлкогольнойПродукции.Маркируемый, ЛОЖЬ) КАК ЭтоПодакцизнаяПродукцияЕГАИС,
		|	ВЫБОР
		|		КОГДА СправочникНоменклатура.ЕдиницаИзмерения.ТипИзмеряемойВеличины В (&МерныеТипы)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоМернаяЕдиницаИзмерения,
		|	СправочникНоменклатура.УдалитьОсобенностьУчета КАК ВидПродукции,
		|	СправочникНоменклатура.КодТНВЭД КАК КодТНВЭД,
		|	СправочникНоменклатура.ОКПД2 КАК ОКПД2
		|ИЗ
		|	Источник КАК Источник
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|		ПО Источник.Номенклатура = СправочникНоменклатура.Ссылка";
	
	МерныеТипы = Новый Массив;
	МерныеТипы.Добавить(Перечисления.ТипыИзмеряемыхВеличин.Вес);
	МерныеТипы.Добавить(Перечисления.ТипыИзмеряемыхВеличин.Объем);
	
	Запрос.УстановитьПараметр("Источник",   ТаблицаНоменклатуры);
	Запрос.УстановитьПараметр("МерныеТипы", МерныеТипы);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаТаблицы = ТаблицаНоменклатуры[ВыборкаДетальныеЗаписи.ИндексСтроки];
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
КонецПроцедуры

// Определяет наличие в базе данных номенклатуры, относящейся к любой из подсистем БГосИС.
// Используется в обработчике обновления перехода на конструктор настроек видов продукции для определения необходимости
// загрузки классификатора настроек из макета в случае, если ФО использования подсистемы отключена, но номенклатура в базе данных существует и должна быть конвертирована на конструктор настроек.
// 
// Параметры:
//  ЕстьНоменклатура - Булево - Есть номенклатура любой из подсистем БГосИС
Процедура ПриОпределенииНаличияНоменклатурыДляПереходаНаКонструкторНастроекВидовПродукции(ЕстьНоменклатура) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Номенклатура.Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.УдалитьОсобенностьУчета <> &ОсобенностьУчета";
	
	Запрос.УстановитьПараметр("ОсобенностьУчета", Перечисления.ВидыПродукцииИС.ПустаяСсылка());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЕстьНоменклатура = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
