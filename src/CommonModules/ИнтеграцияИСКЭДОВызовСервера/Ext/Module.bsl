//  СправочникСсылка.Организации - Организация по умолчанию
Функция ОрганизацияПоУмолчанию() Экспорт
	Возврат Справочники.Организации.ОрганизацияПоУмолчанию();
КонецФункции

// Создана номенклатура при проверке соответствия требованиям ГИСМТ.
// 
// Параметры:
//  Документ - ДокументСсылка.ЭлектронныйДокументВходящийЭДО
// 
// Возвращаемое значение:
//  Булево - Создана номенклатура при проверке соответствия требованиям ГИСМТ
Функция СозданаНоменклатураПриПроверкеСоответствияТребованиямГИСМТ(Документ) Экспорт
	
	РезультатПроверкиПоДокументу = СоответствиеТребованиямГИСМТ.РезультатПроверкиПоДокументу(Документ);
	Если РезультатПроверкиПоДокументу = Неопределено Тогда
		Возврат Истина;
	Иначе
		Возврат РезультатПроверкиПоДокументу.НоменклатураСоздана;
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Служебная структура "подключенное оборудование"
// 
// Возвращаемое значение:
//  Структура - с полями:
//   * ККТ - Массив Из СправочникСсылка.ПодключаемоеОборудование - ККТ
//   * ОблачныеККТ - Массив Из СправочникСсылка.ПодключаемоеОборудование - облачные ККТ
//   * Терминал - Неопределено, СправочникСсылка.ПодключаемоеОборудование - Данные подключенному термиралу
//
Функция СтруктураПодключенноеОборудование()
	
	Результат = Новый Структура;
	Результат.Вставить("Терминал");
	Результат.Вставить("ККТ");
	Результат.Вставить("ОблачныеККТ");
	Возврат Результат;
	
КонецФункции

#КонецОбласти