	Возврат "КЭДО_ПредставлениеКонфигурации";
КонецФункции

// Имя параметра требуется изменить заголовок приложения.
// 
// Возвращаемое значение:
//  Строка - Имя параметра требуется изменить заголовок приложения
Функция ИмяПараметраТребуетсяИзменитьЗаголовокПриложения() Экспорт
	Возврат "КЭДО_ТребуетсяИзменитьЗаголовокПриложения";
КонецФункции

// Параметры оповещения об изменении списка услуг.
// 
// Возвращаемое значение:
//  Структура - Параметры оповещения об изменении списка услуг:
// * Заголовок - Строка - 
// * ИспользоватьМаркировку - Булево - 
Функция ПараметрыОповещенияОбИзмененииСпискаУслуг() Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Заголовок",              "");
	ВозвращаемоеЗначение.Вставить("ИспользоватьМаркировку", Ложь);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Имя оповещения подключение услуги маркировка.
