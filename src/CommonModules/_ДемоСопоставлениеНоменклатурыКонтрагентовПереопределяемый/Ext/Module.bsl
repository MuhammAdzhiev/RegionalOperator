
#Область ПрограммныйИнтерфейс

// См. СопоставлениеНоменклатурыКонтрагентовПереопределяемый.ПроверитьИспользованиеХарактеристик.
Процедура ПроверитьИспользованиеХарактеристик(ХарактеристикиИспользуются) Экспорт
	
	ХарактеристикиИспользуются = Истина;
	
КонецПроцедуры

// См. СопоставлениеНоменклатурыКонтрагентовПереопределяемый.ЗначениеНаименованияДанныхСопоставленияНоменклатурыБЭД.
Процедура ЗначениеНаименованияДанныхСопоставленияНоменклатурыБЭД(Знач СсылкаНаОбъект, ЗначениеНаименования) Экспорт
	
	Если ЭтоОсновноеСредство(ТипЗнч(СсылкаНаОбъект)) Тогда
		ЗначениеНаименования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "Наименование");
	КонецЕсли;
	
КонецПроцедуры

// См. СопоставлениеНоменклатурыКонтрагентовПереопределяемый.ЗначенияНаименованийДанныхСопоставленияНоменклатурыБЭД.
Процедура ЗначенияНаименованийДанныхСопоставленияНоменклатурыБЭД(Знач НаборСсылокНаОбъекты, 
	СоответствиеЗначенийНаименований) Экспорт
	
	СоответствиеПоИменамРеквизита = Новый Соответствие;
	Для Каждого Элемент Из НаборСсылокНаОбъекты Цикл
		ИмяРеквизита = ИмяРеквизитаСопоставленияНоменклатурыБЭД(ТипЗнч(Элемент));
		Если ПустаяСтрока(ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		СсылкиПоИмениРеквизита = СоответствиеПоИменамРеквизита.Получить(ИмяРеквизита);
		Если СсылкиПоИмениРеквизита = Неопределено Тогда
			СоответствиеПоИменамРеквизита.Вставить(ИмяРеквизита,
				ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Элемент));
		Иначе
			СсылкиПоИмениРеквизита.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	СоответствиеЗначенийНаименований = Новый Соответствие;
	Для Каждого Элемент Из СоответствиеПоИменамРеквизита Цикл
		ЗначениеРеквизита = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Элемент.Значение, Элемент.Ключ);
		ОбщегоНазначенияКлиентСервер.ДополнитьСоответствие(СоответствиеЗначенийНаименований, ЗначениеРеквизита);
	КонецЦикла;
	
КонецПроцедуры

// См. СопоставлениеНоменклатурыКонтрагентовПереопределяемый.ОпределитьНаименованиеТипаОбъектаСопоставленияНоменклатурыБЭД.
Процедура ОпределитьНаименованиеТипаОбъектаСопоставленияНоменклатурыБЭД(Знач СсылкаНаОбъект, НаименованиеТипаОбъекта) Экспорт
	
	ТипСсылкиНаОбъект = ТипЗнч(СсылкаНаОбъект);
	Если ЭтоНоменклатура(ТипСсылкиНаОбъект) Тогда
		НаименованиеТипаОбъекта = "Номенклатура";
	ИначеЕсли ТипСсылкиНаОбъект = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда
		НаименованиеТипаОбъекта = "Характеристика";
	ИначеЕсли ЭтоОсновноеСредство(СсылкаНаОбъект) Тогда
		НаименованиеТипаОбъекта = "Номенклатура";
	КонецЕсли;
	
КонецПроцедуры

// См. СопоставлениеНоменклатурыКонтрагентовПереопределяемый.ПриОпределенииСвойствНоменклатурыИнформационнойБазы.
Процедура ПриОпределенииСвойствНоменклатурыИнформационнойБазы(Знач НаборНоменклатуры, СвойстваНоменклатурИБ) Экспорт
	
	УникальныеЗначения = Новый Соответствие;
	Для Каждого Значение Из НаборНоменклатуры Цикл
		УникальныеЗначения.Вставить(Значение, Истина);
	КонецЦикла;
	
	ПараметрНаборНоменклатуры    = Новый Массив;
	ПараметрНаборОсновныхСредств = Новый Массив;
	Для Каждого Элемент Из УникальныеЗначения Цикл
		ТипОбъекта = ТипЗнч(Элемент.Ключ);
		Если ЭтоНоменклатура(ТипОбъекта) Тогда
			ПараметрНаборНоменклатуры.Добавить(Элемент.Ключ);
		ИначеЕсли ЭтоОсновноеСредство(ТипОбъекта) Тогда
			ПараметрНаборОсновныхСредств.Добавить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос(ТекстЗапросаСвойстваНоменклатурыИнформационнойБазы());
	Запрос.УстановитьПараметр("НаборНоменклатуры", ПараметрНаборНоменклатуры);
	Запрос.УстановитьПараметр("НаборОсновныхСредств", ПараметрНаборОсновныхСредств);
	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл

		СвойстваНоменклатуры = СопоставлениеНоменклатурыКонтрагентовКлиентСервер.НовыеСвойстваНоменклатурыИБ();
		ЗаполнитьЗначенияСвойств(СвойстваНоменклатуры, Выборка);

		СвойстваНоменклатурИБ.Вставить(Выборка.Номенклатура, СвойстваНоменклатуры);

	КонецЦикла;

КонецПроцедуры

// См. СопоставлениеНоменклатурыКонтрагентовПереопределяемый.ПриИзмененииНоменклатурыСопоставления_НоменклатураКонтрагентов.
Процедура ПриИзмененииНоменклатурыСопоставления_НоменклатураКонтрагентов(Форма, ДанныеСопоставления) Экспорт
	
	ТипСсылки = ТипЗнч(ДанныеСопоставления.Номенклатура);
	Если Не ЗначениеЗаполнено(ДанныеСопоставления.Номенклатура) Тогда
		ДанныеСопоставления.ИспользоватьХарактеристики  = Ложь;
		ДанныеСопоставления.Характеристика              = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		ДанныеСопоставления.Упаковка                    = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
		ДанныеСопоставления.ЕдиницаИзмеренияПоУмолчанию = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
		ДанныеСопоставления.ОбязательноеЗаполнениеХарактеристики = Ложь;
	ИначеЕсли ЭтоНоменклатура(ТипСсылки) Тогда
		СопоставлениеНоменклатурыКонтрагентовКЭДО.ПриИзмененииНоменклатурыСопоставления_НоменклатураКонтрагентов(
			Форма, ДанныеСопоставления);
	ИначеЕсли ЭтоОсновноеСредство(ТипСсылки) Тогда
		ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСопоставления.Номенклатура,
			"ЕдиницаИзмерения");
		ДанныеСопоставления.ИспользоватьХарактеристики  = Ложь;
		ДанныеСопоставления.Характеристика              = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		ДанныеСопоставления.Упаковка                    = ЕдиницаИзмерения;
		ДанныеСопоставления.ЕдиницаИзмеренияПоУмолчанию = ЕдиницаИзмерения;
		ДанныеСопоставления.ОбязательноеЗаполнениеХарактеристики = Ложь;
		ДанныеСопоставления.ИмяПараметраСвязиУпаковки = "";
		ДанныеСопоставления.ИмяПараметраСвязиХарактеристики = "";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяРеквизитаСопоставленияНоменклатурыБЭД(ТипОбъекта)
	
	Если ЭтоНоменклатура(ТипОбъекта) Тогда
		Возврат "НаименованиеПолное";
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда
		Возврат "Наименование";
	ИначеЕсли ЭтоОсновноеСредство(ТипОбъекта) Тогда
		Возврат "Наименование";
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ТекстЗапросаСвойстваНоменклатурыИнформационнойБазы()
	
	Возврат "ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	ВЫРАЗИТЬ(ВидыНоменклатуры.ИспользоватьХарактеристики КАК БУЛЕВО) КАК ИспользоватьХарактеристики,
	|	ИСТИНА КАК ИспользоватьУпаковки,
	|	ИСТИНА КАК ОбязательноеЗаполнениеХарактеристики,
	|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмеренияПоУмолчанию
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|		ПО Номенклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка
	|ГДЕ
	|	Номенклатура.Ссылка В (&НаборНоменклатуры)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	_ДемоОсновныеСредства.Ссылка,
	|	ЛОЖЬ,
	|	ЛОЖЬ,
	|	ЛОЖЬ,
	|	_ДемоОсновныеСредства.ЕдиницаИзмерения
	|ИЗ
	|	Справочник._ДемоОсновныеСредства КАК _ДемоОсновныеСредства
	|ГДЕ
	|	_ДемоОсновныеСредства.Ссылка В (&НаборОсновныхСредств)";
	
КонецФункции

Функция ЭтоНоменклатура(Знач ТипДанных)
	Возврат ТипДанных = Тип("СправочникСсылка.Номенклатура");
КонецФункции

Функция ЭтоОсновноеСредство(Знач ТипДанных)
	Возврат ТипДанных = Тип("СправочникСсылка._ДемоОсновныеСредства");
КонецФункции

#КонецОбласти