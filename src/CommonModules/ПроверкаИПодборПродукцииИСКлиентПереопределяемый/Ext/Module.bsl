#Область ОткрытиеФормыПроверкиИПодбора

// Заполняет специфичные параметры открытия форм проверки и подбора маркируемой продукции в зависимости от точки вызова
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма из которой происходит открытие формы проверки и подбора
//  Параметры - (См. ПроверкаИПодборПродукцииИСМПКлиент.ПараметрыОткрытияФормыПроверкиИПодбора)
//
Процедура ПриУстановкеПараметровОткрытияФормыПроверкиИПодбора(Форма, Параметры) Экспорт

	Параметры.ИмяРеквизитаДокументОснование = "";
	
	Если ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.ПоступлениеТоваровУслуг") Тогда
		
		Параметры.ИмяРеквизитаКонтрагент = "Контрагент";
		Параметры.ЕГАИС  = Истина;
		Параметры.ИСМП   = Истина;
		Параметры.Прочее = Ложь;
		Параметры.РежимПодбораСуществующихУпаковок = Ложь;
		Параметры.ИмяРеквизитаСклад                = ""
		
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.РеализацияТоваровУслуг") Тогда
		
		Параметры.ЕГАИС  = Истина;
		Параметры.ИСМП   = Истина;
		Параметры.Прочее = Ложь;
		Параметры.ИмяРеквизитаСклад = ""
		
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.ЭлектронныйДокументВходящийЭДО") Тогда
		
		Параметры.ЕГАИС  = Ложь;
		Параметры.ИСМП   = Истина;
		Параметры.Прочее = Ложь;
		Параметры.ИмяРеквизитаСклад                = "";
		Параметры.РежимПодбораСуществующихУпаковок = Ложь;
		Параметры.ИмяРеквизитаКонтрагент           = "Контрагент";
		
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.ЭлектронныйДокументИсходящийЭДО") Тогда
		
		Параметры.ЕГАИС  = Истина;
		Параметры.ИСМП   = Истина;
		Параметры.Прочее = Ложь;
		Параметры.ИмяРеквизитаСклад = "";
		
	КонецЕсли;
	
КонецПроцедуры

// Выполняет специфичные действия после закрытия форм проверки и подбора маркируемой продукции в зависимости от точки вызова
//
// Параметры:
//  РезультатЗакрытия - Произвольный - результат закрытия формы проверки и подбора
//  ДополнительныеПараметры - Структура - определяет источник вызова:
//   * Форма - ФормаКлиентскогоПриложения - форма из которой происходил вызов.
//
Процедура ПриЗакрытииФормыПроверкиИПодбора(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	ДополнительныеПараметры.Форма.Прочитать();
	
	Если ДополнительныеПараметры.Форма.ИмяФормы = "Документ.ЭлектронныйДокументВходящийЭДО.Форма.ФормаПросмотраЛегкийКлиентЭДО" Тогда
		ИмяСобытия = ЛегкийИнтерфейсДокументовЭДОКлиент.ИмяСобытияИзменениеОбщегоСостоянияДокумента();
		Оповестить(ИмяСобытия, ДополнительныеПараметры.Форма.Объект.Ссылка, ДополнительныеПараметры.Форма);
	КонецЕсли;
	
КонецПроцедуры

// Выполняет специфичные действия перед открытием форм проверки и подбора маркируемой продукции в зависимости от точки вызова
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения       - форма из которой происходит открытие формы проверки и подбора
//  ПараметрыОткрытияФормыПроверки - Структура - параметры открытия формы проверки и подбора для формы-источника
//  ПараметрыФормыПроверки         - Структура - подготовленные параметры открытия формы проверки и подбора
//  Отказ                          - Булево    - отказ от открытия формы
//
Процедура ПередОткрытиемФормыПроверкиПодбора(Форма, ПараметрыОткрытияФормыПроверки, ПараметрыФормыПроверки, Отказ) Экспорт
	
	Если ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.РеализацияТоваровУслуг")
	 ИЛИ ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.ПоступлениеТоваровУслуг") Тогда
		
		ПараметрыИнтеграцииФормыПроверки = Форма.ПараметрыИнтеграцииГосИС.Получить("ФормаПроверкиИПодбора")[0];
		
		СерииИспользуются = ПараметрыИнтеграцииФормыПроверки.СерииИспользуются;
			
		Если СерииИспользуются И (НЕ ЗначениеЗаполнено(ПараметрыФормыПроверки.Склад)
		 ИЛИ ТипЗнч(ПараметрыФормыПроверки.Склад) <> Тип("СправочникСсылка.Склады")) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				НСтр("ru = 'Для проверки и подбора маркируемой продукции укажите склад'"),,
				ПараметрыОткрытияФормыПроверки.ИмяРеквизитаСклад,
				ПараметрыОткрытияФормыПроверки.ИмяРеквизитаФормыОбъект,
				Отказ);
		КонецЕсли;
	
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.ЭлектронныйДокументВходящийЭДО") Тогда
		
		ПараметрыИнтеграции = Форма.ПараметрыИнтеграцииГосИС.Получить("СоответствиеТребованиямГИСМТ");
		Если ПараметрыИнтеграции <> Неопределено
			И Не СтрНачинаетсяС(Форма.Объект.ФорматОсновногоТитула, "ON_NKORSCHFDOPPR_1")
			И Не ПараметрыИнтеграции.НоменклатураСоздана
			И Не ИнтеграцияИСКЭДОВызовСервера.СозданаНоменклатураПриПроверкеСоответствияТребованиямГИСМТ(Форма.Объект.Ссылка) Тогда
			
			Отказ = Истина;
			
			ДополнительныеПараметры = Новый Структура();
			ДополнительныеПараметры.Вставить("ПараметрыОткрытияФормыПроверки", ПараметрыОткрытияФормыПроверки);
			ДополнительныеПараметры.Вставить("ПараметрыФормыПроверки",         ПараметрыФормыПроверки);
			ДополнительныеПараметры.Вставить("Форма",                          Форма);
			
			ПроверкаСоответствияТребованиямГИСМТЗавершение = Новый ОписаниеОповещения(
				"ПроверкаСоответствиеТребованиямПередОткрытиемФормыПроверкиИПодбораЗавершение",
				ИнтеграцияИСКЭДОКлиент,
				ДополнительныеПараметры);
			СоответствиеТребованиямГИСМТКлиент.ОткрытьФормуСРезультатомПроверкиДокументаНаСоответствиеТребованиямГИСМТ(
				Форма,
				ПроверкаСоответствияТребованиямГИСМТЗавершение);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

