#Область ПрограммныйИнтерфейс

// См. КоммерческиеПредложенияДокументыКлиентПереопределяемый.ПриИзмененииНоменклатуры.
//
Процедура ПриИзмененииНоменклатуры(Форма, ТекущаяСтрока, ТекущийЭлемент, ТребуетсяСерверныйВызов) Экспорт
	
	Если ТипЗнч(Форма.Объект.Ссылка) = Тип("ДокументСсылка.КоммерческоеПредложениеКлиенту") Тогда
		
		РеквизитыНоменклатуры = КоммерческиеПредложенияДокументыКЭДОВызовСервера.РеквизитыНоменклатуры(ТекущаяСтрока.Номенклатура, "ЕдиницаИзмерения, СтавкаНДС");
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, РеквизитыНоменклатуры);
		
		НалогообложениеНДС = Форма.Объект.Налогообложение;
		
		Если Не НалогообложениеНДС Тогда
			ТекущаяСтрока.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
		КонецЕсли;
		
		КлиентЭДОКлиентСервер.ПриИзмененииСтавкаНДС(ТекущаяСтрока, Форма.Объект.ЦенаВключаетНДС, НалогообложениеНДС);
		
	Иначе
	
		Если ТипЗнч(ТекущаяСтрока[ТекущийЭлемент]) = Тип("СправочникСсылка.Номенклатура") Тогда 
			
			РеквизитыНоменклатуры = КоммерческиеПредложенияДокументыКЭДОВызовСервера.РеквизитыНоменклатуры(ТекущаяСтрока[ТекущийЭлемент], "ЕдиницаИзмерения");
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, РеквизитыНоменклатуры);
			
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

// См. КоммерческиеПредложенияДокументыКлиентПереопределяемый.ПоказатьФормуИсточника.
//
Процедура ПоказатьФормуИсточника(Знач ТипИсточника,Знач Источник,Знач НомерСтрокиИсточника) Экспорт

	Если ТипЗнч(Источник) = Тип("ДокументСсылка.КоммерческоеПредложениеПоставщика") Тогда 
		ПоказатьЗначение(,Источник);
	КонецЕсли;

КонецПроцедуры

// См. КоммерческиеПредложенияДокументыКлиентПереопределяемый.ОткрытьФормуСпискаЗаказаПоставщику.
//
Процедура ОткрытьФормуСпискаЗаказаПоставщику(Знач МассивСсылок) Экспорт 
	
	ФиксированныеНастройки = Новый НастройкиКомпоновкиДанных;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ФиксированныеНастройки.Отбор,
				"Ссылка",
				МассивСсылок,
				ВидСравненияКомпоновкиДанных.ВСписке);
	
	ПараметрыОткрытия = Новый Структура("ФиксированныеНастройки, ТолькоПросмотр", ФиксированныеНастройки, Истина);
	
	ОткрытьФорму("Документ.ЗаказПоставщику.ФормаСписка", ПараметрыОткрытия);
	
КонецПроцедуры

// См. КоммерческиеПредложенияДокументыКлиентПереопределяемый.ОткрытьФормуЗагрузкиИзВнешнихФайлов.
//
Процедура ОткрытьФормуЗагрузкиИзВнешнихФайлов(Форма, ОповещениеПриЗавершении = Неопределено) Экспорт

	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ЗагружатьЦену", Истина);
	ПараметрыФормы.Вставить("ЗагружатьКоличество", Истина);
	ПараметрыФормы.Вставить("ЗагружатьЕдиницыИзмерения", Истина);
	
	ОткрытьФорму("Обработка.ЗагрузкаДанныхИзВнешнихФайлов.Форма.Форма",
		ПараметрыФормы,,,,,ОповещениеПриЗавершении);
	
КонецПроцедуры

// См. КоммерческиеПредложенияДокументыКлиентПереопределяемый.ПоказатьВводШтрихкода.
//
Процедура ПоказатьВводШтрихкода(ОповещениеУспешногоВвода, Количество = Неопределено, Заголовок = "") Экспорт 
	
	Если НЕ ЗначениеЗаполнено(Заголовок) Тогда
		Заголовок = НСтр("ru = 'Введите штрихкод'");
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура(
		"ОповещениеУспешногоВвода, Количество",
		ОповещениеУспешногоВвода,
		Количество);
		
	Оповещение = Новый ОписаниеОповещения(
		"ПоказатьВводШтрихкодаЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	ПоказатьВводЗначения(Оповещение, "", Заголовок);
	
КонецПроцедуры

// См. КоммерческиеПредложенияДокументыКлиентПереопределяемый.ПриВыполненииКомандыРазбитьСтроку.
//
Процедура ПриВыполненииКомандыРазбитьСтроку(Форма, ТекущаяСтрока, ОповещениеОЗавершении) Экспорт
	
	Заголовок = НСтр("ru = 'Укажите количество в новой строке'");
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма",                 Форма);
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("ТекущаяСтрока",         ТекущаяСтрока);
	
	ОповещениеПослеВводаЧисла = Новый ОписаниеОповещения("ПослеВводаЧислаРазбиениеСтрок", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВводЧисла(ОповещениеПослеВводаЧисла, ТекущаяСтрока.Количество, Заголовок, 15, 3);
	
КонецПроцедуры

