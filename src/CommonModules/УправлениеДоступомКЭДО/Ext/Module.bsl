#Область ПрограммныйИнтерфейс

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииВидовДоступа.
Процедура ПриЗаполненииВидовДоступа(ВидыДоступа) Экспорт
	
	ВидДоступа = ВидыДоступа.Добавить();
	ВидДоступа.Имя = "Организации";
	ВидДоступа.Представление = НСтр("ru = 'Организации'");
	ВидДоступа.ТипЗначений   = Тип("СправочникСсылка.Организации");
	
КонецПроцедуры

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииПоставляемыхПрофилейГруппДоступа.
Процедура ПриЗаполненииПоставляемыхПрофилейГруппДоступа(ОписанияПрофилей, ПараметрыОбновления) Экспорт
	
	ЗаполнитьПрофильПользователь(ОписанияПрофилей);
	ЗаполнитьПрофильОператор(ОписанияПрофилей);
	ЗаполнитьПрофильМенеджер(ОписанияПрофилей);
	
КонецПроцедуры

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа
Процедура ПриЗаполненииСписковСОграничениемДоступа(Списки) Экспорт
	
	Списки.Вставить(Метаданные.Справочники.БанковскиеСчета, Истина);
	Списки.Вставить(Метаданные.Справочники.ДоговорыКонтрагентов, Истина);
	Списки.Вставить(Метаданные.Справочники.Организации, Истина);
	Списки.Вставить(Метаданные.Документы.СчетНаОплатуПокупателю, Истина);
	Списки.Вставить(Метаданные.Документы.СчетНаОплатуПоставщика, Истина);
	Списки.Вставить(Метаданные.Документы.ЗаказПокупателя, Истина);
	Списки.Вставить(Метаданные.Документы.ЗаказПоставщику, Истина);
	Списки.Вставить(Метаданные.Документы.ПоступлениеТоваровУслуг, Истина);
	Списки.Вставить(Метаданные.Документы.РеализацияТоваровУслуг, Истина);
	Списки.Вставить(Метаданные.Документы.СчетФактураВыданный, Истина);
	Списки.Вставить(Метаданные.Документы.СчетФактураПолученный, Истина);
	Списки.Вставить(Метаданные.Документы.АктОРасхожденияхПоОтгрузке, Истина);
	Списки.Вставить(Метаданные.Документы.АктОРасхожденияхПоПриемке, Истина);
	Списки.Вставить(Метаданные.Документы.АктСверкиВзаиморасчетов, Истина);
	Списки.Вставить(Метаданные.ЖурналыДокументов.ИсходящиеДокументы, Истина);
	Списки.Вставить(Метаданные.ЖурналыДокументов.ВходящиеДокументы, Истина);
	
	Списки.Вставить(Метаданные.Документы.ВыводИзОборотаИСМП, Истина);
	Списки.Вставить(Метаданные.Документы.ВозвратВОборотИСМП, Истина);
	Списки.Вставить(Метаданные.Документы.ЗаказНаЭмиссиюКодовМаркировкиСУЗ, Истина);
	Списки.Вставить(Метаданные.Документы.ОтгрузкаТоваровИСМП, Истина);
	Списки.Вставить(Метаданные.Документы.ОтчетИСМП, Истина);
	Списки.Вставить(Метаданные.Документы.МаркировкаТоваровИСМП, Истина);
	Списки.Вставить(Метаданные.Документы.ПеремаркировкаТоваровИСМП, Истина);
	Списки.Вставить(Метаданные.Документы.ПриемкаТоваровИСМП, Истина);
	Списки.Вставить(Метаданные.Документы.СписаниеКодовМаркировкиИСМП, Истина);
	Списки.Вставить(Метаданные.Документы.УточнениеСведенийОКодахМаркировкиИСМП, Истина);
	Списки.Вставить(Метаданные.Документы.ПодключениеКегаКОборудованиюРозливаИСМП, Истина);
	Списки.Вставить(Метаданные.Документы.ПеремещениеМеждуМОДИСМП, Истина);
	Списки.Вставить(Метаданные.Документы.РазрешениеНаОтгрузкуИСМП, Истина);
	
	Списки.Вставить(Метаданные.РегистрыСведений.НастройкиОбменаСУЗ, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.ОчередьСообщенийИСМП, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.ПулКодовМаркировкиСУЗ, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.ВскрытыеПотребительскиеУпаковкиИС, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.СинхронизацияДанныхИСМП, Истина);
	
КонецПроцедуры

