// См. УправлениеДоступомПереопределяемый.ПриОпределенииИнтерфейсаНастройкиДоступа
Процедура ПриОпределенииИнтерфейсаНастройкиДоступа(УпрощенныйИнтерфейс) Экспорт
	
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		УпрощенныйИнтерфейс = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры:
//  ОписанияПрофилей - см. ПриЗаполненииПоставляемыхПрофилейГруппДоступа.ОписанияПрофилей
Процедура ЗаполнитьПрофильПользователь(ОписанияПрофилей)
	
	ОписаниеПрофиля = УправлениеДоступом.НовоеОписаниеПрофиляГруппДоступа();
	ОписаниеПрофиля.Имя           = "Пользователь";
	ОписаниеПрофиля.Идентификатор = "09e56dbf-90a0-11de-862c-001d600d9ad2";
	ОписаниеПрофиля.Наименование  = НСтр("ru = 'Пользователь'");
	ОписаниеПрофиля.Описание      = НСтр("ru = 'Просмотр данных информационной системы.'");
	
	// Использование 1С:Предприятия.
	ОписаниеПрофиля.Роли.Добавить("ЗапускВебКлиента");
	ОписаниеПрофиля.Роли.Добавить("ЗапускТолстогоКлиента");
	ОписаниеПрофиля.Роли.Добавить("ЗапускТонкогоКлиента");
	ОписаниеПрофиля.Роли.Добавить("ВыводНаПринтерФайлБуферОбмена");
	ОписаниеПрофиля.Роли.Добавить("СохранениеДанныхПользователя");
	
	// Использование программы.
	ОписаниеПрофиля.Роли.Добавить("БазовыеПраваБСП");
	ОписаниеПрофиля.Роли.Добавить("БазовыеПраваБТС");
	ОписаниеПрофиля.Роли.Добавить("БазовыеПраваИПП");
	ОписаниеПрофиля.Роли.Добавить("БазовыеПраваЭД");
	ОписаниеПрофиля.Роли.Добавить("БазовыеПраваКЭДО");
	ОписаниеПрофиля.Роли.Добавить("ПросмотрОписанияИзмененийПрограммы");
	ОписаниеПрофиля.Роли.Добавить("РедактированиеПечатныхФорм");
	
	//ГосИС
	ОписаниеПрофиля.Роли.Добавить("БазовыеПраваЕГАИС");
	ОписаниеПрофиля.Роли.Добавить("БазовыеПраваВЕТИС");
	ОписаниеПрофиля.Роли.Добавить("БазовыеПраваИСМП");
	
	// Типовые возможности.
	ОписаниеПрофиля.Роли.Добавить("ЧтениеДополнительныхОтчетовИОбработок");
	ОписаниеПрофиля.Роли.Добавить("ПросмотрСвязанныеДокументы");
	
	// Использование НСИ.
	ОписаниеПрофиля.Роли.Добавить("ЧтениеКурсовВалют");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеНСИ");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеДополнительныхСведений");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеНоменклатурыКонтрагентовБЭД");
	
	// Основные возможности профиля.
	ОписаниеПрофиля.Роли.Добавить("ЧтениеДокументовКЭДО");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеНастроекЭлектронногоВзаимодействия");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеМаршрутовПодписания");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеЭлектронныхДокументов");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеНастроекОбменаСКонтрагентами");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеДанныхСервисаDSS");
	
	// Виды ограничения доступа профиля.
	ОписаниеПрофиля.ВидыДоступа.Добавить("Организации", "ВначалеВсеРазрешены");
	ОписаниеПрофиля.ВидыДоступа.Добавить("ДополнительныеСведения", "ВначалеВсеРазрешены");
	
	// Использование онлайн-поддержки
	ОписаниеПрофиля.Роли.Добавить("ИнтеграцияСКоннект");
	ОписаниеПрофиля.Роли.Добавить("ПодключениеИнтернетПоддержки");
	
	// Работа с 1С:Номенклатурой.
	ОписаниеПрофиля.Роли.Добавить("ЧтениеДанныхРаботаСНоменклатурой");
	
	// Использование подсистем в Клиент ЭДО
	ОписаниеПрофиля.Роли.Добавить("ПодсистемаСправочники");
	ОписаниеПрофиля.Роли.Добавить("ПодсистемаПродажи");
	ОписаниеПрофиля.Роли.Добавить("ПодсистемаЗакупки");
	
	// Работа с 1С:Бизнес-сеть
	ОписаниеПрофиля.Роли.Добавить("ЧтениеНастроекБизнесСеть");
	
	// Работа с 1С:Торговые предложения
	ОписаниеПрофиля.Роли.Добавить("ЧтениеНастроекТорговыхПредложений");
	
	// Работа с 1С:Коммерческие предложения
	ОписаниеПрофиля.Роли.Добавить("ЧтениеОснованияЭДОПоЗапросамКоммерческихПредложенийПоставщиков");
	ОписаниеПрофиля.Роли.Добавить("ПоискЗапросовКоммерческихПредложений");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеЗапросыКоммерческихПредложенийПоставщиков");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеЗапросыКоммерческихПредложенийОтКлиентов");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеКоммерческихПредложенийКлиентам");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеКоммерческихПредложенийПоставщиков");
	
	// Работа с МЧД
	ОписаниеПрофиля.Роли.Добавить("ЧтениеМЧДЭДО");
	
	// Работа с БПО и пробитием в облачных
	ОписаниеПрофиля.Роли.Добавить("БазовыеПраваБПО");
	ОписаниеПрофиля.Роли.Добавить("ЧтениеНастроекПодключенияКОблачнымКассам");
	
	// Работа с новостями
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.Новости") Тогда
		ОписаниеПрофиля.Роли.Добавить("ЧтениеНовостей");
	КонецЕсли;
	
	// Работа с электронным актированием.
	Если ОбщегоНазначения.ПодсистемаСуществует(
			"ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС") Тогда
		ОписаниеПрофиля.Роли.Добавить("ЧтениеНастроекЭлектронногоАктированияЕИС");
		ОписаниеПрофиля.Роли.Добавить("ЧтениеДанныхДокументовЭлектронногоАктированияЕИС");
		ОписаниеПрофиля.Роли.Добавить("ЧтениеДокументовКлиентЭлАкт");
	КонецЕсли;
	
	// Работа с сервисом Share.
	Если ОбщегоНазначения.ПодсистемаСуществует(
			"ЭлектронноеВзаимодействие.СервисShare") Тогда
		ОбщийМодульИнтеграцияShare = ОбщегоНазначения.ОбщийМодуль("ИнтеграцияShare");
		ОбщийМодульИнтеграцияShare.ДобавитьПраваИспользованияСервиса(ОписаниеПрофиля);
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЭлектронноеВзаимодействие.ЦентрЭДО") Тогда
		ОписаниеПрофиля.Роли.Добавить("ИспользованиеЦентраЭДО");
	КонецЕсли;
	
	ОписанияПрофилей.Добавить(ОписаниеПрофиля);
	
КонецПроцедуры

// Параметры:
//  ОписанияПрофилей - см. ПриЗаполненииПоставляемыхПрофилейГруппДоступа.ОписанияПрофилей
Процедура ЗаполнитьПрофильОператор(ОписанияПрофилей)
	
	ОписаниеПрофиля = УправлениеДоступом.НовоеОписаниеПрофиляГруппДоступа();
