// Назначение модуля: Операции биллинга: расчет задолженности и индексируемое сопоставление лицевых счетов по номеру.
// Возвращает задолженность лицевого счета на конец даты как разницу начислений и оплат по регистру остатков.
// Параметры:
//   ЛицевойСчет - ссылка на лицевой счет.
//   ДатаОкончания - дата, на конец которой рассчитывается задолженность.
// Возвращаемое значение:
//   Число — сумма начислений за вычетом оплат на выбранную дату.
Функция ПолучитьЗадолженностьПоЛС(ЛицевойСчет, ДатаОкончания) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Взаиморасчеты.НачисленоОстаток КАК Начислено,
	|	Взаиморасчеты.ОплаченоОстаток КАК Оплачено
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыТКО.Остатки(&ДатаОкончания, ЛицевойСчет = &ЛицевойСчет) КАК Взаиморасчеты";
	
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Начислено - Выборка.Оплачено;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции
// Ищет лицевой счет по нормализованному номеру с использованием индексируемого реквизита; неоднозначный результат считает ошибкой.
// Параметры:
//   Номер - исходный номер лицевого счета или иной искомый номер.
// Возвращаемое значение:
//   СправочникСсылка.ЛицевыеСчета или Неопределено; неоднозначный поиск вызывает исключение.
Функция НайтиЛСПоНомеру(Номер) Экспорт
	
	НормНомер = НормализоватьНомерЛС(Номер);
	
	Если ПустаяСтрока(НормНомер) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	ЛС.Ссылка КАК ЛицевойСчет
	|ИЗ
	|	Справочник.ЛицевыеСчета КАК ЛС
	|ГДЕ
	|	ЛС.НомерЛСДляПоиска = &Номер";
	
	Запрос.УстановитьПараметр("Номер", НормНомер);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Выборка.ЛицевойСчет;
	
	Если Выборка.Следующий() Тогда
		ВызватьИсключение "Найдено несколько лицевых счетов с номером " + НормНомер;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
// Удаляет обычные пробелы и ведущие нули из номера для единого формата поиска.
// Параметры:
//   Номер - исходный номер лицевого счета или иной искомый номер.
// Возвращаемое значение:
//   Строка — номер в едином поисковом формате.
Функция НормализоватьНомерЛС(Номер) Экспорт
	
	Номер = СокрЛП(Строка(Номер));
	Номер = СтрЗаменить(Номер, " ", "");
	
	Пока СтрДлина(Номер) > 1 И Лев(Номер, 1) = "0" Цикл
		
		Номер = Сред(Номер, 2);
		
	КонецЦикла;
	
	Возврат Номер;
	
КонецФункции
