// @strict-types

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик подписки на событие ПередЗаписьюКонстантыКлиентЭДО.
// 
// Параметры:
//  Источник - КонстантаМенеджерЗначения
//  Отказ - Булево
Процедура ПередЗаписьюКонстантыКлиентЭДО(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеКонстанты = Источник.ЭтотОбъект.Метаданные();
	ИмяКонстанты = МетаданныеКонстанты.Имя;
	Синоним = МетаданныеКонстанты.Синоним;

	НедоступныеКонстанты = КонстантыНедоступныеДляВключения();
	Если НедоступныеКонстанты.Найти(ИмяКонстанты) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru='Интерактивное изменение значения константы ""%1"" запрещено'", "ru"), Синоним);
	КонецЕсли;
	
КонецПроцедуры

// Включить отключить легкий клиент ЭДО.
// 
// Параметры:
//  Включить - Булево
Процедура ВключитьОтключитьЛегкийКлиентЭДО(Включить = Истина) Экспорт
	
	КонстантаЛегкийКлиентЭДО = Константы.ИспользоватьЛегкийКлиентЭДО.СоздатьМенеджерЗначения();
	КонстантаЛегкийКлиентЭДО.ОбменДанными.Загрузка = Истина;
	КонстантаЛегкийКлиентЭДО.Значение = Включить;
	КонстантаЛегкийКлиентЭДО.Записать();
	ЛичныйКабинетСервиса.ОбновитьИспользованиеЛичногоКабинета();
	
КонецПроцедуры

// Возвращает информацию о работе ИБ в режиме Легкого Клиента ЭДО.
//
// Возвращаемое значение:
//  Булево
Функция ИспользуетсяЛегкийКлиентЭДО() Экспорт
	
	Возврат КлиентЭДОПовтИсп.ИспользуетсяЛегкийКлиентЭДО();
	
КонецФункции

// Выполняет установку настроек приложения "Электронный документооборот.
//
Процедура НастроитьПриложениеЭлектронныйДокументооборот() Экспорт
	
	Если ИспользуетсяЛегкийКлиентЭДО() Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиПриложения = НастройкиПриложенияЭлектронныйДокументооборот();
	
	УстановитьНастройкиПриложенияЭлектронныйДокументооборот(НастройкиПриложения);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	ЛичныйКабинетСервиса.ОбновитьИспользованиеЛичногоКабинета();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры:
//  НастройкиПриложения - См. НовыеНастройкиПриложенияЭлектронныйДокументооборот
Процедура УстановитьНастройкиПриложенияЭлектронныйДокументооборот(Знач НастройкиПриложения)

	Для Каждого Настройка Из НастройкиПриложения Цикл
			
			КонстантаОбъект = ОбщегоНазначения.ОбъектМетаданныхПоПолномуИмени("Константа." + Настройка.ИмяКонстанты);
			Если КонстантаОбъект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если Настройка.УстанавливатьЗначениеВРежимеОбменаДаннымиЗагрузка Тогда
				УстановитьЗначениеКонстантыВРежимеОбменДаннымиЗагрузка(Настройка.ИмяКонстанты,
					Настройка.Значение);
			Иначе
				Попытка
					Константы[Настройка.ИмяКонстанты].Установить(Настройка.Значение);
				Исключение
					ЗаписьЖурналаРегистрации(
						НСтр("ru = 'Настройка приложения электронный документооборот (Легкий Клиент ЭДО)'"),
						УровеньЖурналаРегистрации.Ошибка,,,
						ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
			КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

// Возвращаемое значение:
//  См. НовыеНастройкиПриложенияЭлектронныйДокументооборот
Функция НастройкиПриложенияЭлектронныйДокументооборот()
	
	НастройкиПриложенияЭДО = НовыеНастройкиПриложенияЭлектронныйДокументооборот();
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьЛегкийКлиентЭДО";
	НоваяНастройка.Значение = Истина;
	НоваяНастройка.УстанавливатьЗначениеВРежимеОбменаДаннымиЗагрузка = Истина;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьВнутренниеДокументыЭДО";
	НоваяНастройка.Значение = Ложь;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьНесколькоОрганизаций";
	НоваяНастройка.Значение = Ложь;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьОбменБизнесСеть";
	НоваяНастройка.Значение = Ложь;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьОбменЭД";
	НоваяНастройка.Значение = Истина;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьОбменЭДМеждуОрганизациями";
	НоваяНастройка.Значение = Ложь;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьПрочтениеДокументовЭДО";
	НоваяНастройка.Значение = Истина;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьПрямойОбменЭлектроннымиДокументами";
	НоваяНастройка.Значение = Ложь;

	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьРазделениеДокументовПоОтветственнымЭДО";
	НоваяНастройка.Значение = Ложь;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьСловарьСопоставленияНоменклатурыБЭД";
	НоваяНастройка.Значение = Ложь;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьСопоставлениеНоменклатуры";
	НоваяНастройка.Значение = Ложь;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьХарактеристикиНоменклатуры";
	НоваяНастройка.Значение = Ложь;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьЭлектронныеПодписи";
	НоваяНастройка.Значение = Истина;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "СоздаватьКонтрагентовАвтоматическиБЭД";
	НоваяНастройка.Значение = Истина;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ОтправлятьВходящиеДокументыНаУтверждение";
	НоваяНастройка.Значение = Ложь;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьКонтрольОтраженияВУчетеЭДО";
	НоваяНастройка.Значение = Ложь;
	НоваяНастройка.УстанавливатьЗначениеВРежимеОбменаДаннымиЗагрузка = Истина;

	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ПриниматьПриглашенияЭДОАвтоматически";
	НоваяНастройка.Значение = Истина;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьАвтоматическоеПолучениеИзСервисаЭДО";
	НоваяНастройка.Значение = Истина;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьСервисDSS";
	НоваяНастройка.Значение = Истина;
	
	НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
	НоваяНастройка.ИмяКонстанты = "ИспользоватьЧерновикиЭлектронныхДокументов";
	НоваяНастройка.Значение = Истина;

	Если ОбщегоНазначения.ПодсистемаСуществует(
		"ЭлектронноеВзаимодействие.КоммерческиеПредложения.КоммерческиеПредложенияДокументы.ЗапросКоммерческихПредложенийПоставщиков") Тогда
		НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
		НоваяНастройка.ИмяКонстанты = "ИспользоватьЗапросыКоммерческихПредложенийПоставщиков";
		НоваяНастройка.Значение = Ложь;	
	КонецЕсли;
	Если ОбщегоНазначения.ПодсистемаСуществует(
		"ЭлектронноеВзаимодействие.КоммерческиеПредложения.КоммерческиеПредложенияДокументы.ЗапросКоммерческогоПредложенияОтКлиента") Тогда
		НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
		НоваяНастройка.ИмяКонстанты = "ИспользоватьЗапросыКоммерческихПредложенийОтКлиента";
		НоваяНастройка.Значение = Ложь;	
	КонецЕсли;
	Если ОбщегоНазначения.ПодсистемаСуществует(
		"ЭлектронноеВзаимодействие.КоммерческиеПредложения.КоммерческиеПредложенияДокументы.КоммерческоеПредложениеКлиенту") Тогда
		НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
		НоваяНастройка.ИмяКонстанты = "ИспользоватьКоммерческиеПредложенияКлиентам";
		НоваяНастройка.Значение = Ложь;	
	КонецЕсли;
	Если ОбщегоНазначения.ПодсистемаСуществует(
		"ЭлектронноеВзаимодействие.КоммерческиеПредложения.КоммерческиеПредложенияДокументы.КоммерческоеПредложениеПоставщика") Тогда
		НоваяНастройка = НастройкиПриложенияЭДО.Добавить();
		НоваяНастройка.ИмяКонстанты = "ИспользоватьКоммерческиеПредложенияПоставщиков";
		НоваяНастройка.Значение = Ложь;	
	КонецЕсли;
	
	Возврат НастройкиПриложенияЭДО;
	
КонецФункции

// Возвращаемое значение:
//  ТаблицаЗначений:
// * ИмяКонстанты - Строка
// * Значение - Булево
// * УстанавливатьЗначениеВРежимеОбменаДаннымиЗагрузка - Булево
Функция НовыеНастройкиПриложенияЭлектронныйДокументооборот()
	
	ОписаниеТипаБулево = Новый ОписаниеТипов("Булево");
	ОписаниеТипаСтрока = ОбщегоНазначения.ОписаниеТипаСтрока(0);
	
	НастройкиПриложенияЭДО = Новый ТаблицаЗначений;
	НастройкиПриложенияЭДО.Колонки.Добавить("ИмяКонстанты", ОписаниеТипаСтрока);
	НастройкиПриложенияЭДО.Колонки.Добавить("Значение", ОписаниеТипаБулево);
	НастройкиПриложенияЭДО.Колонки.Добавить("УстанавливатьЗначениеВРежимеОбменаДаннымиЗагрузка", ОписаниеТипаБулево);
	Возврат НастройкиПриложенияЭДО;
	
КонецФункции

// Параметры:
//  ИмяКонстанты - Строка
//  ЗначениеКонстанты - Произвольный
Процедура УстановитьЗначениеКонстантыВРежимеОбменДаннымиЗагрузка(ИмяКонстанты, ЗначениеКонстанты)
	
	КонстантаДляИзменения = Константы[ИмяКонстанты].СоздатьМенеджерЗначения();
	КонстантаДляИзменения.ОбменДанными.Загрузка = Истина;
	КонстантаДляИзменения.Значение = ЗначениеКонстанты;
	КонстантаДляИзменения.Записать();
	
КонецПроцедуры

// Список констант, которые недоступны для включения в приложении Клиент ЭДО.
// 
// Возвращаемое значение:
//  Массив Из Строка
//
Функция КонстантыНедоступныеДляВключения()
	
	СписокКонстант = Новый Массив; // Массив Из Строка
	СписокКонстант.Добавить(Метаданные.Константы.ИспользоватьЛегкийКлиентЭДО.Имя);
	Возврат СписокКонстант;
	
КонецФункции

#КонецОбласти
