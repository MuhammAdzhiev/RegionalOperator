#Область ЗапросВидПродукцииМаркируемойПродукцииПоДокумента

// Текст запроса маркируемая продукция документа.
// 
// Параметры:
//  ДокументСсылка - ДокументСсылка
//  ИмяТабЧастиТовары - Строка
// 
// Возвращаемое значение:
//  Строка
Функция ТекстЗапросаМаркируемаяПродукцияДокумента(ДокументСсылка, ИмяТабЧастиТовары = Неопределено)
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	Товары.Номенклатура                       КАК Номенклатура,
	|	Товары.Характеристика                     КАК Характеристика,
	|	ОписаниеНоменклатурыИС.КлючВидовПродукции КАК ВидПродукции
	|ИЗ
	|	Документ.%1.%2 КАК Товары
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|		ПО Товары.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
	|ГДЕ
	|	Товары.Ссылка = &ДокументСсылка
	|	И ОписаниеНоменклатурыИС.КлючВидовПродукции.ВидПродукцииГИСМТ <> ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка)";
	
	МетаданныеДокумента = ДокументСсылка.Метаданные();
	Если ИмяТабЧастиТовары = Неопределено Тогда
		ИмяТабЧастиТовары = "Товары";
	КонецЕсли;
	
	ТекстЗапроса = СтрШаблон(ТекстЗапроса, МетаданныеДокумента.Имя, ИмяТабЧастиТовары);
	
	Возврат ТекстЗапроса;
	
	
КонецФункции

#КонецОбласти

#КонецОбласти
