// См. ОбновлениеИнформационнойБазыПереопределяемый.ПриПодготовкеМакетаОписанияОбновлений.
Процедура ПриПодготовкеМакетаОписанияОбновлений(Макет) Экспорт
	
	Если Не НастройкиКлиентЭДО.ИспользуетсяЛегкийКлиентЭДО() Тогда
		Возврат;
	КонецЕсли;
	
	РазделыДляВывода = Новый Массив;
	Для Каждого Область Из Макет.Области Цикл
		НачалоИмениОбласти = "Версия";
		Если СтрНайти(Область.Имя, НачалоИмениОбласти) = 0 Тогда
			Продолжить;
		КонецЕсли;
		НомерРаздела = Прав(Область.Имя, СтрДлина(Область.Имя) - СтрДлина(НачалоИмениОбласти));
		// _Демо начало примера
		НомерРаздела = СтрЗаменить(Лев(НомерРаздела, 1), 1, 2) + Сред(НомерРаздела, 2, СтрДлина(НомерРаздела));
		// _Демо конец примера
		РазделыДляВывода.Вставить(0, НомерРаздела);
	КонецЦикла;
	
	ДокументОписаниеОбновлений = Новый ТабличныйДокумент();
	МакетЛегкийКлиентЭДО = ПолучитьОбщийМакет("ОписаниеИзмененийСистемыЛегкийКлиентЭДО");
	
	Для Каждого Номер Из РазделыДляВывода Цикл
		
		Если МакетЛегкийКлиентЭДО.Области.Найти("Шапка" + Номер) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументОписаниеОбновлений.Вывести(МакетЛегкийКлиентЭДО.ПолучитьОбласть("Шапка" + Номер));
		ДокументОписаниеОбновлений.НачатьГруппуСтрок("Версия" + Номер);
		ДокументОписаниеОбновлений.Вывести(МакетЛегкийКлиентЭДО.ПолучитьОбласть("Версия" + Номер));
		ДокументОписаниеОбновлений.ЗакончитьГруппуСтрок();
		ДокументОписаниеОбновлений.Вывести(МакетЛегкийКлиентЭДО.ПолучитьОбласть("Отступ"));
		
	КонецЦикла;
	
	Если ДокументОписаниеОбновлений.ВысотаТаблицы = 0 Тогда
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Конфигурация успешно обновлена на версию %1'"), Метаданные.Версия);
		ДокументОписаниеОбновлений.Область("R1C1:R1C1").Текст = Текст;
	КонецЕсли;
	
	Макет.Очистить();
	Макет.Вывести(ДокументОписаниеОбновлений);
	
КонецПроцедуры

