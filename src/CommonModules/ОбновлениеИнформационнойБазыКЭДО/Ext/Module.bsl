// Включает использование сопоставления номенклатуры при отражении электронных документов.
// 
// Параметры:
//  Параметры - Структура - параметры.
//
Процедура ВключитьИспользованиеСопоставленияНоменклатуры() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	МетаданныеОбъекта = Метаданные.Константы.ИспользоватьСопоставлениеНоменклатуры;
	ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
	ИмяОбъекта = МетаданныеОбъекта.Имя;
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		Записать = Ложь;
		
		Менеджер = Константы[ИмяОбъекта].СоздатьМенеджерЗначения();
		Менеджер.Прочитать();
		
		Если Не Менеджер.Значение Тогда
			Менеджер.Значение = Истина;
			Записать = Истина;
		КонецЕсли;
		
		Если Записать Тогда
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(Менеджер);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
