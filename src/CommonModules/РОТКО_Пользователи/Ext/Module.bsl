// Назначение модуля: Получение текущего пользователя информационной базы и сопоставленного сотрудника.
// Возвращает имя пользователя информационной базы; при недоступности данных возвращает пустую строку.
// Возвращаемое значение:
//   Строка — имя пользователя ИБ либо пустая строка.
Функция ПолучитьЛогинТекущегоПользователя() Экспорт
	Попытка
		Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
		Если Пользователь <> Неопределено Тогда
			Возврат Пользователь.Имя;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат "";
КонецФункции
// Находит сотрудника по логину текущего пользователя в регистре соответствий.
// Возвращаемое значение:
//   Ссылка на сотрудника или Неопределено.
Функция ПолучитьТекущегоСотрудника() Экспорт
	
	Логин = ПолучитьЛогинТекущегоПользователя();
	Если ПустаяСтрока(Логин) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Соотв.Сотрудник КАК Сотрудник
	|ИЗ
	|	РегистрСведений.СоответствиеЛогиновИСотрудников КАК Соотв
	|ГДЕ
	|	Соотв.ЛогинИБ = &Логин";
	
	Запрос.УстановитьПараметр("Логин", Логин);
	
	В = Запрос.Выполнить().Выбрать();
	Если В.Следующий() Тогда
		Возврат В.Сотрудник;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции
