// Возвращает признак является ли организация "ИП", убирает из наименования организационно-правовую форму
// 
// Параметры:
//  Наименование - Строка - Полное или сокращенное наименование организации.
// 
// Возвращаемое значение:
//  Булево - правовая форма "ИП"
//
Функция ЭтоИП(Наименование)
	
	Результат = Ложь;
	
	ОрганизационнаяФорма = "";
	ПоложениеОФ = 0;
	ДопЧастьОтчества = "";
	ШаблонНаименования = "%1 %2 %3";
	
	ВариантыОФ = Новый Массив;
	ВариантыОФ.Добавить(НСтр("ru='ИП ГКФХ'"));
	ВариантыОФ.Добавить(НСтр("ru='ИП Глава КФХ'"));
	ВариантыОФ.Добавить(НСтр("ru='ГКФХ'"));
	ВариантыОФ.Добавить(НСтр("ru='Глава КФХ'"));
	ВариантыОФ.Добавить(НСтр("ru='Индивидуальный предприниматель Глава крестьянского фермерского хозяйства'"));
	ВариантыОФ.Добавить(НСтр("ru='Глава крестьянского фермерского хозяйства'"));
	ВариантыОФ.Добавить(НСтр("ru='ИП'"));
	ВариантыОФ.Добавить(НСтр("ru='Индивидуальный предприниматель'"));
	
	ЧастиОтчества = Новый Массив;
	ЧастиОтчества.Добавить(НСтр("ru = 'оглы'"));
	ЧастиОтчества.Добавить(НСтр("ru = 'улы'"));
	ЧастиОтчества.Добавить(НСтр("ru = 'уулу'"));
	ЧастиОтчества.Добавить(НСтр("ru = 'кызы'"));
	ЧастиОтчества.Добавить(НСтр("ru = 'гызы'"));
	ЧастиОтчества.Добавить(НСтр("ru = 'угли'"));

	ОбработанноеНаименование = СтроковыеФункцииКлиентСервер.ЗаменитьОдниСимволыДругими(
		"-/–*—)(", Наименование, "     "); // АПК:217 не проверять кодировку символа "минус".
	Пока СтрНайти(ОбработанноеНаименование, "  ") Цикл
		ОбработанноеНаименование = СтрЗаменить(ОбработанноеНаименование, "  ", " ");
	КонецЦикла;
	ОбработанноеНаименование = СокрЛП(ОбработанноеНаименование);
	
	Для Каждого Элемент Из ВариантыОФ Цикл
		ПоложениеОФ = СтрНайти(НРег(ОбработанноеНаименование), НРег(Элемент));
		Если ПоложениеОФ <> 0 Тогда
			ОрганизационнаяФорма = Элемент;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ДлинаНаименования = СтрДлина(Наименование);
	Для ТекСимвол = 1 По ДлинаНаименования Цикл
		Дефис = СтрНайти("-–—", Сред(Наименование, ТекСимвол, 1)); // АПК:217 не проверять кодировку символа "минус".
		ПробелДо = ТекСимвол - 1;
		Если Дефис <> 0 И Сред(Наименование, ПробелДо, 1) = " " Тогда
			Наименование = Лев(Наименование, ПробелДо - 1) + Прав(Наименование, ДлинаНаименования - ТекСимвол + 1);
			ДлинаНаименования = ДлинаНаименования - 1;
			ТекСимвол = ТекСимвол - 1;
		КонецЕсли;
		ПробелПосле = ТекСимвол + 1;
		Если Дефис <> 0 И Сред(Наименование, ПробелПосле, 1) = " " Тогда
			Наименование = Лев(Наименование, ТекСимвол) + Прав(Наименование, ДлинаНаименования - ТекСимвол - 1);
			ДлинаНаименования = ДлинаНаименования - 1;
			ТекСимвол = ТекСимвол - 1;
		КонецЕсли;
	КонецЦикла;	

	МассивСловНаименования = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
		Наименование, " ", Истина);
	КоличествоСловНаименования = МассивСловНаименования.Количество(); 
	МассивСловОФ = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
		ОрганизационнаяФорма, " ", Истина);
	КоличествоСловОФ = МассивСловОФ.Количество();
	
	Для Каждого Элемент Из МассивСловНаименования Цикл
		Если ЧастиОтчества.Найти(НРег(Элемент)) <> Неопределено Тогда
			ДопЧастьОтчества = " " + Элемент;
		КонецЕсли;
	КонецЦикла;
		
	Если НЕ ПустаяСтрока(ДопЧастьОтчества) Тогда
		КоличествоСловВФИО = 4;
		ПоложениеИмя = 3;
		ПоложениеОтчество = 2;
	Иначе
		КоличествоСловВФИО = 3;
		ПоложениеИмя = 2;
		ПоложениеОтчество = 1;
	КонецЕсли;
	
	Если ПоложениеОФ = 1 
		И КоличествоСловНаименования - КоличествоСловВФИО >= 0 Тогда
		Наименование = СтрШаблон(ШаблонНаименования, 
			МассивСловНаименования[КоличествоСловНаименования - КоличествоСловВФИО], 
			МассивСловНаименования[КоличествоСловНаименования - ПоложениеИмя], 
			МассивСловНаименования[КоличествоСловНаименования - ПоложениеОтчество]
			+ ДопЧастьОтчества);
		Результат = Истина;
	ИначеЕсли ПоложениеОФ > 1
		И КоличествоСловНаименования - КоличествоСловОФ - КоличествоСловВФИО >= 0 Тогда
		Наименование = СтрШаблон(ШаблонНаименования,
			МассивСловНаименования[КоличествоСловНаименования - КоличествоСловОФ - КоличествоСловВФИО], 
			МассивСловНаименования[КоличествоСловНаименования - КоличествоСловОФ - ПоложениеИмя], 
			МассивСловНаименования[КоличествоСловНаименования - КоличествоСловОФ - ПоложениеОтчество]
			+ ДопЧастьОтчества);
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает имена полей дерева данных и соответствующие им имена таблиц содержащих
//  коды маркировки для документов Акт о расхождении.
//
// Возвращаемое значение:
//  Массив - структура, где Ключ - имя поля дерева данных, Значение - имя таблицы маркировки.
//
Функция ИменаПолейДереваДанныхИТаблицМаркировкиАктаОРасхождениях() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ПоДокументу", "КодыМаркировкиПоДокументу");
	Результат.Вставить("ПоФакту", "КодыМаркировкиПоФакту");
	Результат.Вставить("Недостача", "КодыМаркировкиНедостачи");
	Результат.Вставить("Излишки", "КодыМаркировкиИзлишки");
	Результат.Вставить("Брак", "КодыМаркировкиБрак");
	Результат.Вставить("Бой", "КодыМаркировкиБой");
	
	Возврат Результат;
	
КонецФункции

// Возвращает имена таблиц содержащих коды маркировки для документов Акт о расхождении.
//
// Возвращаемое значение:
//  Массив - имена таблиц.
//
Функция ИменаТаблицМаркировкиАктаОРасхождениях() Экспорт
	
	Результат = Новый Массив;
	
	ИменаПолейИТаблиц = ИменаПолейДереваДанныхИТаблицМаркировкиАктаОРасхождениях();
	Для Каждого ПараИмен Из ИменаПолейИТаблиц Цикл
		Результат.Добавить(ПараИмен.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#Область ОбработкаТабличныхЧастей

Процедура РассчитатьКоличествоБазовыхЕдиниц(СтрокаТаблицы)
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.Коэффициент) Тогда
		СтрокаТаблицы.Коэффициент =
			КлиентЭДОВызовСервера.КоэффициентПересчетаВБазовыеЕдиницы(СтрокаТаблицы.ЕдиницаИзмерения);
	КонецЕсли;
	
	СтрокаТаблицы.Количество =
		СтрокаТаблицы.КоличествоУпаковок * СтрокаТаблицы.Коэффициент;
	
КонецПроцедуры

Процедура РассчитатьЦенуЗаУпаковку(СтрокаТаблицы, КоличествоБаза)
	
	Если КоличествоБаза = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы.Цена = СтрокаТаблицы.Цена
		/ КоличествоБаза
		* СтрокаТаблицы.Количество;
	
КонецПроцедуры

Процедура РассчитатьСуммуПоСтроке(СтрокаТаблицы)
	
	Количество = СтрокаТаблицы.КоличествоУпаковок; 
	Если Количество = 0 И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, "ТипНоменклатуры") 
		И (СтрокаТаблицы.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга")
		Или СтрокаТаблицы.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа")) Тогда
		Количество = 1;
	КонецЕсли;
	
	Сумма = СтрокаТаблицы.Цена * Количество;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, "СуммаСкидки")
		И СтрокаТаблицы.СуммаСкидки <> 0 Тогда
		
		СтрокаТаблицы.СуммаСкидки = ?(СтрокаТаблицы.СуммаСкидки > Сумма, Сумма, СтрокаТаблицы.СуммаСкидки);
		Сумма = Сумма - СтрокаТаблицы.СуммаСкидки;
	КонецЕсли;
	
	СтрокаТаблицы.Сумма = Сумма;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти