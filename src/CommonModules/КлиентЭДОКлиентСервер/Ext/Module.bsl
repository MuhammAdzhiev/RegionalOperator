// Формирует представление номенклатуры для ЭД.
//
// Параметры:
//  СвойстваНоменклатуры - Структура - Данные для формирования представления номенклатуры:
//     * Наименование - Строка - Наименование номенклатуры.
//     * ХарактеристикаНаименование - Строка - Наименование характеристики.
// 
// Возвращаемое значение:
//  Строка - представление номенклатуры.
//
Функция ПредставлениеНоменклатурыДляЭД(СвойстваНоменклатуры) Экспорт
	
	Если ЗначениеЗаполнено(СвойстваНоменклатуры.ХарактеристикаНаименование) Тогда
		ПредставлениеНоменклатуры = СтрШаблон(НСтр("ru = '%1 (%2)'"),
			СвойстваНоменклатуры.НаименованиеПолное, СвойстваНоменклатуры.ХарактеристикаНаименование);
	Иначе
		ПредставлениеНоменклатуры = СвойстваНоменклатуры.НаименованиеПолное;
	КонецЕсли;
	
	Возврат ПредставлениеНоменклатуры;
	
КонецФункции

// Формирует представление содержания товара/услуги.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - Номенклатура.
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - Характеристика.
// 
// Возвращаемое значение:
//  Строка - представление содержания товара/услуги.
//
Функция ПолучитьПредставлениеСодержания(Номенклатура, Характеристика) Экспорт

	Если ЗначениеЗаполнено(Номенклатура) Тогда
		НаименованиеНоменклатуры = КлиентЭДОВызовСервера.ЗначениеРеквизитаОбъекта(Номенклатура, "НаименованиеПолное");
		Если ЗначениеЗаполнено(Характеристика) Тогда
			НаименованиеХарактеристики = КлиентЭДОВызовСервера.ЗначениеРеквизитаОбъекта(Характеристика, "Наименование");
		КонецЕсли;
	КонецЕсли;
	
	СвойстваНоменклатуры = Новый Структура;
	СвойстваНоменклатуры.Вставить("НаименованиеПолное", НаименованиеНоменклатуры);
	СвойстваНоменклатуры.Вставить("ХарактеристикаНаименование", НаименованиеХарактеристики);
	
	ПредставлениеНоменклатуры = ПредставлениеНоменклатурыДляЭД(СвойстваНоменклатуры);
	
	Возврат ПредставлениеНоменклатуры;

КонецФункции

#Область ОбработкаТабличныхЧастей

Процедура ПриИзмененииНоменклатуры(СтрокаТаблицы, Знач ЗависимыеРеквизиты, Знач ЦенаВключаетНДС = Ложь,
	Знач НалогообложениеНДС = Неопределено) Экспорт
	
	НужноОпределениеПродукцииВЕТИС = Ложь;
	НуженПересчетКоличестваВЕТИС = Неопределено;
	Если Не ЗначениеЗаполнено(ЗависимыеРеквизиты) Тогда
		ЗависимыеРеквизиты = "";
	КонецЕсли;
	ЗависимыеРеквизиты = СтрРазделить(ЗависимыеРеквизиты, ",");
	Если ЗависимыеРеквизиты.Найти("Продукция") <> Неопределено Тогда
		НужноОпределениеПродукцииВЕТИС = Истина;
		ЗависимыеРеквизиты.Удалить(ЗависимыеРеквизиты.Найти("Продукция"));
	КонецЕсли;
	Если ЗависимыеРеквизиты.Найти("ЕдиницаИзмеренияВЕТИС") <> Неопределено Тогда
		НуженПересчетКоличестваВЕТИС = Ложь;
		ЗависимыеРеквизиты.Удалить(ЗависимыеРеквизиты.Найти("ЕдиницаИзмеренияВЕТИС"));
		Если ЗависимыеРеквизиты.Найти("Количество") <> Неопределено Тогда
			НуженПересчетКоличестваВЕТИС = Истина;
			ЗависимыеРеквизиты.Удалить(ЗависимыеРеквизиты.Найти("Количество"));
		КонецЕсли;
	КонецЕсли;
	
	ЗависимыеРеквизиты = СтрСоединить(ЗависимыеРеквизиты, ",");
	
	СтруктураРеквизитов = КлиентЭДОВызовСервера.РеквизитыНоменклатуры(
		СтрокаТаблицы.Номенклатура, ЗависимыеРеквизиты);
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтруктураРеквизитов);
	
	Если НужноОпределениеПродукцииВЕТИС Тогда
		Реквизиты = Новый Структура("Номенклатура,Характеристика,Серия");
		ЗаполнитьЗначенияСвойств(Реквизиты,СтрокаТаблицы);
		//продукция, единица измерения, коэффициент пересчета
		ДанныеСопоставления = КлиентЭДОВызовСервера.СопоставленнаяПродукцияВЕТИС(Реквизиты);
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеСопоставления);
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы,"КоличествоВЕТИС") Тогда
			Если ДанныеСопоставления.Коэффициент > 1 Тогда
				СтрокаТаблицы.КоличествоВЕТИС = СтрокаТаблицы.Количество / ДанныеСопоставления.Коэффициент;
			Иначе
				СтрокаТаблицы.КоличествоВЕТИС = СтрокаТаблицы.Количество * Окр(1 / ДанныеСопоставления.Коэффициент, 6);
			КонецЕсли;
		КонецЕсли;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы,"КоличествоИзменениеВЕТИС") Тогда
			Если ДанныеСопоставления.Коэффициент > 1 Тогда
				СтрокаТаблицы.КоличествоИзменениеВЕТИС = СтрокаТаблицы.КоличествоИзменение / ДанныеСопоставления.Коэффициент;
			Иначе
				СтрокаТаблицы.КоличествоИзменениеВЕТИС = СтрокаТаблицы.КоличествоИзменение * Окр(1 / ДанныеСопоставления.Коэффициент, 6);
			КонецЕсли;
		КонецЕсли;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы,"КоличествоСтароеВЕТИС") Тогда
			Если ДанныеСопоставления.Коэффициент > 1 Тогда
				СтрокаТаблицы.КоличествоСтароеВЕТИС = СтрокаТаблицы.КоличествоСтарое / ДанныеСопоставления.Коэффициент;
			Иначе
				СтрокаТаблицы.КоличествоСтароеВЕТИС = СтрокаТаблицы.КоличествоСтарое * Окр(1 / ДанныеСопоставления.Коэффициент, 6);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли НуженПересчетКоличестваВЕТИС = Ложь Тогда
		Реквизиты = Новый Структура("Номенклатура,ЕдиницаИзмеренияВЕТИС",, ПредопределенноеЗначение("Справочник.ЕдиницыИзмеренияВЕТИС.ПустаяСсылка"));
		ЗаполнитьЗначенияСвойств(Реквизиты,СтрокаТаблицы);
		ДанныеСопоставления = КлиентЭДОВызовСервера.КоэффициентПересчетаВЕТИС(Реквизиты);
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы,"КоличествоВЕТИС") Тогда
			СтрокаТаблицы.Количество = СтрокаТаблицы.КоличествоВЕТИС * ДанныеСопоставления.Коэффициент;
		КонецЕсли;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы,"КоличествоИзменениеВЕТИС") Тогда
			СтрокаТаблицы.КоличествоИзменение = СтрокаТаблицы.КоличествоИзменениеВЕТИС * ДанныеСопоставления.Коэффициент;
		КонецЕсли;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы,"КоличествоСтароеВЕТИС") Тогда
			СтрокаТаблицы.КоличествоСтарое = СтрокаТаблицы.КоличествоСтароеВЕТИС * ДанныеСопоставления.Коэффициент;
		КонецЕсли;
	ИначеЕсли НуженПересчетКоличестваВЕТИС = Истина Тогда
		Реквизиты = Новый Структура("Номенклатура,ЕдиницаИзмеренияВЕТИС");
		ЗаполнитьЗначенияСвойств(Реквизиты,СтрокаТаблицы);
		ДанныеСопоставления = КлиентЭДОВызовСервера.КоэффициентПересчетаВЕТИС(Реквизиты);
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы,"КоличествоВЕТИС") Тогда
			Если ДанныеСопоставления.Коэффициент > 1 Тогда
				СтрокаТаблицы.КоличествоВЕТИС = СтрокаТаблицы.Количество / ДанныеСопоставления.Коэффициент;
			Иначе
				СтрокаТаблицы.КоличествоВЕТИС = СтрокаТаблицы.Количество * Окр(1 / ДанныеСопоставления.Коэффициент, 6);
			КонецЕсли;
		КонецЕсли;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы,"КоличествоИзменениеВЕТИС") Тогда
			Если ДанныеСопоставления.Коэффициент > 1 Тогда
				СтрокаТаблицы.КоличествоИзменениеВЕТИС = СтрокаТаблицы.КоличествоИзменение / ДанныеСопоставления.Коэффициент;
			Иначе
				СтрокаТаблицы.КоличествоИзменениеВЕТИС = СтрокаТаблицы.КоличествоИзменение * Окр(1 / ДанныеСопоставления.Коэффициент, 6);
			КонецЕсли;
		КонецЕсли;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы,"КоличествоСтароеВЕТИС") Тогда
			Если ДанныеСопоставления.Коэффициент > 1 Тогда
				СтрокаТаблицы.КоличествоСтароеВЕТИС = СтрокаТаблицы.КоличествоСтарое / ДанныеСопоставления.Коэффициент;
			Иначе
				СтрокаТаблицы.КоличествоСтароеВЕТИС = СтрокаТаблицы.КоличествоСтарое * Окр(1 / ДанныеСопоставления.Коэффициент, 6);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПриИзмененииСтавкаНДС(СтрокаТаблицы, ЦенаВключаетНДС, НалогообложениеНДС);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, "Коэффициент") Тогда
		СтрокаТаблицы.Коэффициент = 1;
		РассчитатьКоличествоБазовыхЕдиниц(СтрокаТаблицы);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриИзмененииУпаковкиЕдиницыИзмерения(СтрокаТаблицы, ЦенаВключаетНДС = Ложь,
	НалогообложениеНДС = Неопределено) Экспорт
	
	КоличествоДоПересчета = ?(СтрокаТаблицы.Количество = 0,
		СтрокаТаблицы.КоличествоУпаковок, СтрокаТаблицы.Количество);
	
	СтрокаТаблицы.Коэффициент =
		КлиентЭДОВызовСервера.КоэффициентПересчетаВБазовыеЕдиницы(СтрокаТаблицы.ЕдиницаИзмерения);
		
	РассчитатьКоличествоБазовыхЕдиниц(СтрокаТаблицы);
	
	РассчитатьЦенуЗаУпаковку(СтрокаТаблицы,
		?(КоличествоДоПересчета = 0, СтрокаТаблицы.Количество, КоличествоДоПересчета));
	
	РассчитатьСуммуПоСтроке(СтрокаТаблицы);
	
	ПриИзмененииСтавкаНДС(СтрокаТаблицы, ЦенаВключаетНДС, НалогообложениеНДС);

КонецПроцедуры

// Рассчитывает сумму при изменении количества или цены в строке табличной части документа.
//
// Параметры:
//  СтрокаТаблицы	   - ДанныеФормыЭлементКоллекции - Строка таблицы.
//  ЦенаВключаетНДС    - Булево - Признак включения НДС в цену и сумму документа.
//  НалогообложениеНДС - Булево - Признак того, что выполняемая операция подлежит налогообложению НДС.
//
Процедура ПриИзмененииКоличествоЦена(СтрокаТаблицы, ЦенаВключаетНДС = Ложь, НалогообложениеНДС = Неопределено) Экспорт
	
	РассчитатьКоличествоБазовыхЕдиниц(СтрокаТаблицы);
	
	РассчитатьСуммуПоСтроке(СтрокаТаблицы);
	
	ПриИзмененииСтавкаНДС(СтрокаТаблицы, ЦенаВключаетНДС, НалогообложениеНДС);
	
КонецПроцедуры

// Рассчитывает сумму при изменении количества, цены, скидки в строке табличной части документа.
//
// Параметры:
//  СтрокаТаблицы	 - ДанныеФормыЭлементКоллекции - Строка таблицы.
//  ЦенаВключаетНДС  - Булево - Признак включения НДС в цену и сумму документа.
//  НалогообложениеНДС - Булево - Признак того, что выполняемая операция подлежит налогообложению НДС.
//
Процедура ПриИзмененииКоличествоЦенаСкидка(СтрокаТаблицы, ЦенаВключаетНДС = Ложь, НалогообложениеНДС = Неопределено) Экспорт
	
	РассчитатьКоличествоБазовыхЕдиниц(СтрокаТаблицы);
	
	РассчитатьСуммуПоСтроке(СтрокаТаблицы);
	
	ПриИзмененииСтавкаНДС(СтрокаТаблицы, ЦенаВключаетНДС, НалогообложениеНДС);
	
КонецПроцедуры

// Рассчитывает цену при изменении суммы в строке табличной части документа.
//
// Параметры:
//  СтрокаТаблицы      - ДанныеФормыЭлементКоллекции - Строка таблицы.
//  ЦенаВключаетНДС    - Булево - Признак включения НДС в цену и сумму документа.
//  НалогообложениеНДС - Булево - Признак того, что выполняемая операция подлежит налогообложению НДС.
//
Процедура ПриИзмененииСумма(СтрокаТаблицы, ЦенаВключаетНДС = Ложь, НалогообложениеНДС = Неопределено) Экспорт
	
	Если СтрокаТаблицы.КоличествоУпаковок = 0 Тогда
		СтрокаТаблицы.Цена = СтрокаТаблицы.Сумма;
	Иначе
		СтрокаТаблицы.Цена = СтрокаТаблицы.Сумма / СтрокаТаблицы.КоличествоУпаковок;
	КонецЕсли;
	
	ПриИзмененииСтавкаНДС(СтрокаТаблицы, ЦенаВключаетНДС, НалогообложениеНДС);
	
КонецПроцедуры

// Рассчитывает сумму при изменении ставки НДС в строке табличной части документа.
//
// Параметры:
//  СтрокаТаблицы      - ДанныеФормыЭлементКоллекции - Строка таблицы.
//  ЦенаВключаетНДС    - Булево - Признак включения НДС в цену и сумму документа.
//  НалогообложениеНДС - Булево - Признак того, что выполняемая операция подлежит налогообложению НДС.
//
Процедура ПриИзмененииСтавкаНДС(СтрокаТаблицы, ЦенаВключаетНДС = Ложь, НалогообложениеНДС = Неопределено) Экспорт
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, "СуммаНДС") Тогда
		Возврат;
	КонецЕсли;
	
	Если НалогообложениеНДС = Ложь Тогда
		СтрокаТаблицы.СуммаНДС  = 0;
		СтрокаТаблицы.СуммаСНДС = СтрокаТаблицы.Сумма;
		Возврат;
	КонецЕсли;
	
	ЗначениеСтавки = ПолучитьСтавкуНДСЧислом(СтрокаТаблицы.СтавкаНДС);
	Если ЦенаВключаетНДС Тогда
		СтрокаТаблицы.СуммаНДС  = СтрокаТаблицы.Сумма - СтрокаТаблицы.Сумма / (1 + ЗначениеСтавки);
		СтрокаТаблицы.СуммаСНДС = СтрокаТаблицы.Сумма;
	Иначе
		СтрокаТаблицы.СуммаНДС  = СтрокаТаблицы.Сумма * ЗначениеСтавки;
		СтрокаТаблицы.СуммаСНДС = СтрокаТаблицы.Сумма + СтрокаТаблицы.СуммаНДС;
	КонецЕсли;
	
КонецПроцедуры

// См. КоммерческиеПредложенияДокументыКлиентПереопределяемый.ПриИзмененииЦенаВключаетНДС.
//
Процедура ПриИзмененииЦенаВключаетНДС(Форма, НалогообложениеНДС = Неопределено, ТребуетсяСерверныйВызов = Ложь) Экспорт
	
	ЦенаВключаетНДС = Форма.Объект.ЦенаВключаетНДС;
	Для Каждого СтрокаТаблицы Из Форма.Объект.Товары Цикл
		ПриИзмененииСтавкаНДС(СтрокаТаблицы, ЦенаВключаетНДС, НалогообложениеНДС);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область КомпоновкаДанных

// Добавляет в коллекцию оформляемых полей компоновки данных новое поле
//
// Параметры:
//  КоллекцияОформляемыхПолей 	- КоллекцияОформляемыхПолейКомпоновкиДанных - Коллекция оформляемых полей.
//  ИмяПоля						- Строка - Имя поля.
//
// Возвращаемое значение:
//  ОформляемоеПолеКомпоновкиДанных - Созданное поле.
//
// Пример:
//  Форма.УсловноеОформление.Элементы[0].Поля;
//
Процедура ДобавитьОформляемоеПоле(КоллекцияОформляемыхПолей, ИмяПоля) Экспорт
	
	ОформляемоеПоле = КоллекцияОформляемыхПолей.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	
КонецПроцедуры

// Добавляет в коллекцию отбора новую группу указанного типа.
//
// Параметры:
//  КоллекцияЭлементовОтбора - КоллекцияЭлементовОтбораКомпоновкиДанных - Коллекция элементов отбора.
//  ТипГруппы - ГруппаЭлементовОтбораКомпоновкиДанных - ГруппаИ или ГруппаИли.
//
// Возвращаемое значение:
//  ГруппаЭлементовОтбораКомпоновкиДанных - Добавленная группа.
//
Функция ДобавитьГруппуОтбора(КоллекцияЭлементовОтбора, ТипГруппы) Экспорт
	
	ГруппаЭлементовОтбора            = КоллекцияЭлементовОтбора.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаЭлементовОтбора.ТипГруппы  = ТипГруппы;
	
	Возврат ГруппаЭлементовОтбора;
	
КонецФункции

#КонецОбласти

// Формирует представление списков кодов маркировки.
//
// Параметры:
//  КодыУпаковок - Массив - содержит коды упаковок, для которых необходимо сформировать представление.
// 
// Возвращаемое значение:
//  Строка - представление переданных кодов маркировки в виде строки.
//
Функция ПредставлениеКодовМаркировки(Знач КодыУпаковок) Экспорт

	Возврат СтрСоединить(КодыУпаковок, "; ");

КонецФункции

// Функция возвращает значение ставки НДС.
//
// Параметры:
//  СтавкаНДС - ПеречислениеСсылка.СтавкиНДС - ставка НДС.
//
// Возвращаемое значение:
//  Число - значение ставки.
//
Функция ПолучитьСтавкуНДСЧислом(СтавкаНДС) Экспорт
	
	Результат = 0;
	
	Если СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22")
		ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22_122") Тогда
		
		Результат = 0.22;
	
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20")
		ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20_120") Тогда
		
		Результат = 0.2;
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10")
		ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10_110") Тогда
		
		Результат = 0.1;
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18")
		ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18_118") Тогда
		
		Результат = 0.18;
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5")
		ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5_105") Тогда
		
		Результат = 0.05;
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7")
		ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7_107") Тогда
		
		Результат = 0.07;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает наименование организации без организационно-правовой Формы.
//
// Параметры:
//  Наименование - Строка - полное или сокращенное наименование организации.
//  ЮрФизЛицо - ПеречислениеСсылка.ЮрФизЛицо - вид лица.
//
// Возвращаемое значение:
//  Структура - части наименования организации:
//     * Наименование - Строка - наименование организации без организационно-правовой Формы.
//     * ОрганизационноПравоваяФорма - Строка - организационно-правовая форма предприятия.
//     * ОрганизационноПравоваяФормаСокращенно - Строка - организационно-правовая форма предприятия сокращенно.
//
Функция РазложитьСтрокуНаименованияОрганизации(Знач Наименование, ЮрФизЛицо) Экспорт
	
	Результат = Новый Структура("Наименование,ОрганизационноПравоваяФорма,ОрганизационноПравоваяФормаСокращенно");
	
	Наименование = СокрЛП(Наименование);
	
	Если ЭтоООО(Наименование) Тогда
		ОрганизационноПравоваяФорма           = НСтр("ru='Общество с ограниченной ответственностью'");
		ОрганизационноПравоваяФормаСокращенно = НСтр("ru='ООО'");
	ИначеЕсли ЭтоОАО(Наименование) Тогда
		ОрганизационноПравоваяФорма           = НСтр("ru='Открытое акционерное общество'");
		ОрганизационноПравоваяФормаСокращенно = НСтр("ru='ОАО'");
	ИначеЕсли ЭтоЗАО(Наименование) Тогда
		ОрганизационноПравоваяФорма           = НСтр("ru='Закрытое акционерное общество'");
		ОрганизационноПравоваяФормаСокращенно = НСтр("ru='ЗАО'");
	ИначеЕсли ЭтоПАО(Наименование) Тогда
		ОрганизационноПравоваяФорма           = НСтр("ru='Публичное акционерное общество'");
		ОрганизационноПравоваяФормаСокращенно = НСтр("ru='ПАО'");
	ИначеЕсли ЭтоИП(Наименование) Тогда
		ОрганизационноПравоваяФорма           = НСтр("ru='Индивидуальный предприниматель'");
		ОрганизационноПравоваяФормаСокращенно = НСтр("ru='ИП'");
	Иначе
		ОрганизационноПравоваяФорма           = "";
		ОрганизационноПравоваяФормаСокращенно = "";
	КонецЕсли;
	
	Если ЮрФизЛицо = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо")
		И ЗначениеЗаполнено(ОрганизационноПравоваяФорма) Тогда
		КоличествоКавычек = СтрЧислоВхождений(Наименование, """");
		Если КоличествоКавычек > 1 Тогда
			// Наименование организации внутри внешних кавычек
			ПозицияПервойКавычки = Найти(Наименование, """");
			ПозицияПоследнейКавычки = 0;
			
			ВремНаименование = Наименование;
			
			ПозицияКавычки = ПозицияПервойКавычки;
			Пока ПозицияКавычки > 0 Цикл
				ПозицияПоследнейКавычки = ПозицияПоследнейКавычки + ПозицияКавычки;
				ВремНаименование = Сред(ВремНаименование, ПозицияКавычки + 1);
				ПозицияКавычки = Найти(ВремНаименование, """");
			КонецЦикла;
			
			Наименование = Сред(Наименование, ПозицияПервойКавычки + 1, ПозицияПоследнейКавычки - ПозицияПервойКавычки - 1);
			Если НЕ КоличествоКавычек % 2 = 0 Тогда
				Наименование = Наименование + """";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Результат.Наименование = СокрЛП(Наименование);
	Результат.ОрганизационноПравоваяФорма = ОрганизационноПравоваяФорма;
	Результат.ОрганизационноПравоваяФормаСокращенно = ОрганизационноПравоваяФормаСокращенно;
	
	Возврат Результат;
	
КонецФункции

// Изменяет заголовок группы "валюты и варианты расчета НДС" при изменении валюты.
//
