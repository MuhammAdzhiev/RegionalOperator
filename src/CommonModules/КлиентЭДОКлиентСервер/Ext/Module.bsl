// Убирает из наименования организационно-правовую форму, 
// возвращает результат наличия организационно-правовой формы в наименовании
// 
// Параметры:
//  Наименование - Строка - Полное или сокращенное наименование организации.
//  ИмяОрганизационнойФормы - Строка - организационно-правовая формы
// 
// Возвращаемое значение:
//  Булево - Наличие организационно-правовой формы в наименовании
//
Функция УбратьИзНаименованияОрганизационнуюФорму(Наименование, ИмяОрганизационнойФормы)

	Результат = Ложь;
	
	Наименование = СокрЛП(Наименование);
	
	ДлинаНаименования         = СтрДлина(Наименование);
	ДлинаОрганизационнойФормы = СтрДлина(ИмяОрганизационнойФормы);
	
	Если НРег(Лев(Наименование, ДлинаОрганизационнойФормы)) = НРег(ИмяОрганизационнойФормы) Тогда
		Наименование = СокрЛ(Сред(Наименование, ДлинаОрганизационнойФормы + 1));
		Результат = Истина;
	КонецЕсли;
	
	Если НРег(Прав(Наименование, ДлинаОрганизационнойФормы)) = НРег(ИмяОрганизационнойФормы) Тогда
		Наименование = СокрП(Лев(Наименование, ДлинаНаименования - ДлинаОрганизационнойФормы - 1));
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает признак является ли организация "ООО", убирает из наименования организационно-правовую форму
// 
// Параметры:
//  Наименование - Строка - Полное или сокращенное наименование организации.
// 
// Возвращаемое значение:
//  Булево - правовая форма "ООО"
//
Функция ЭтоООО(Наименование)
	
	ВариантыОФ = Новый Массив;
	ВариантыОФ.Добавить(НСтр("ru='ООО'"));
	ВариантыОФ.Добавить(НСтр("ru='Общество с ограниченной ответственностью'"));
	
	Для Каждого Элемент Из ВариантыОФ Цикл
		ПоложениеОФ = СтрНайти(НРег(Наименование), НРег(Элемент));
		Если ПоложениеОФ <> 0 Тогда
			УбратьИзНаименованияОрганизационнуюФорму(Наименование, Элемент);
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции
	
