// См. ЭлектроннаяПодписьПереопределяемый.ПриЗаполненииРеквизитовОрганизацииВЗаявленииНаСертификат.
Процедура ПриЗаполненииРеквизитовОрганизацииВЗаявленииНаСертификат(Параметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Параметры.Организация) Тогда
		Параметры.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		Если НЕ ЗначениеЗаполнено(Параметры.Организация) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Сведения = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(Параметры.Организация, Сведения);
	
	Параметры.ЭтоИндивидуальныйПредприниматель = Сведения.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель
		ИЛИ Сведения.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;
	
	Параметры.НаименованиеСокращенное = Сведения.СокращенноеНаименование;
	Параметры.НаименованиеПолное      = Сведения.ОфициальноеНаименование;
	Параметры.ИНН                     = Сведения.ИНН;
	Параметры.КПП                     = Сведения.КПП;
	Параметры.ОГРН                    = Сведения.ОГРН;
	Параметры.РасчетныйСчет           = Сведения.НомерСчета;
	Параметры.БИК                     = Сведения.БИК;
	Параметры.КорреспондентскийСчет   = Сведения.КоррСчет;
	Параметры.ЮридическийАдрес        = Сведения.ЮридическийАдресXML;
	Параметры.ФактическийАдрес        = ?(ЗначениеЗаполнено(Сведения.ФактическийАдресXML),
		Сведения.ФактическийАдресXML, Сведения.ЮридическийАдресXML);
	Параметры.Телефон                 = Сведения.ТелефоныXML;
	
КонецПроцедуры

// См. ЭлектроннаяПодписьПереопределяемый.ПередНачаломРедактированияСертификатаКлюча.
Процедура ПередНачаломРедактированияСертификатаКлюча(Ссылка, Сертификат, ПараметрыРеквизитов) Экспорт
	
	Свойства = ЭлектроннаяПодпись.СвойстваСубъектаСертификата(Сертификат);
	
	ИНН = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Свойства, "ИННЮЛ", "");
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		ИНН = Свойства.ИНН;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Свойства.Организация)
		Или Не ЗначениеЗаполнено(ИНН) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитОрганизация = ПараметрыРеквизитов.Добавить();
	РеквизитОрганизация.ИмяРеквизита = "Организация";
	РеквизитОрганизация.Видимость = Истина;
	РеквизитОрганизация.ПроверкаЗаполнения = Истина;
	
	Если СтрНачинаетсяС(ИНН, "00") Тогда
		ИНН = Сред(ИНН, 3);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ИНН = &ИНН";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		РеквизитОрганизация.ЗначениеЗаполнения = Выборка.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

// См. КоммерческиеПредложенияДокументыПереопределяемый.ПриЧтенииНаСервере.
//
Процедура ПриЧтенииНаСервере(Форма, ТекущийОбъект) Экспорт
	
	Если ТипЗнч(ТекущийОбъект) = Тип("ДокументОбъект.ЗапросКоммерческихПредложенийПоставщиков")
		Или ТипЗнч(ТекущийОбъект) = Тип("ДокументОбъект.КоммерческоеПредложениеКлиенту")
		Или ТипЗнч(ТекущийОбъект) = Тип("ДокументОбъект.КоммерческоеПредложениеПоставщика") Тогда
		
		ЗаполнитьПризнакИспользованияХарактеристик(Форма.Объект.Товары);
		
	ИначеЕсли (ТипЗнч(ТекущийОбъект) = Тип("ДокументОбъект.ЭлектронныйДокументВходящийЭДО")
		Или ТипЗнч(ТекущийОбъект) = Тип("ДокументОбъект.ЭлектронныйДокументИсходящийЭДО"))
		И КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		
		СобытияФормИС.ПриЧтенииНаСервере(Форма, ТекущийОбъект);
		ПодключаемоеОборудованиеКЭДО.ПриЧтенииНаСервере(Форма, ТекущийОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

// См. КоммерческиеПредложенияДокументыПереопределяемый.ПослеЗаписиНаСервере.
//
Процедура ПослеЗаписиНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи) Экспорт
	
	Если ТипЗнч(ТекущийОбъект) = Тип("ДокументОбъект.ЗапросКоммерческихПредложенийПоставщиков")
		Или ТипЗнч(ТекущийОбъект) = Тип("ДокументОбъект.КоммерческоеПредложениеКлиенту")
		Или ТипЗнч(ТекущийОбъект) = Тип("ДокументОбъект.КоммерческоеПредложениеПоставщика") Тогда
		
		ЗаполнитьПризнакИспользованияХарактеристик(Форма.Объект.Товары);
		
		Если ТипЗнч(ТекущийОбъект) = Тип("ДокументОбъект.ЗапросКоммерческихПредложенийПоставщиков") Тогда
			
			Если ПравоДоступа("Добавление", Метаданные.Справочники.НоменклатураПрисоединенныеФайлы) 
				И ПравоДоступа("Изменение", Метаданные.Справочники.НоменклатураПрисоединенныеФайлы) Тогда		
				
				ОбщегоНазначения.УстановитьЗначениеРеквизита(Форма,
					 "ПозволятьДобавлениеФайлаИзСистемыДляВнутреннейНоменклатуры", Истина);
	
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ТекущийОбъект) = Тип("ДокументОбъект.ЭлектронныйДокументВходящийЭДО")
		И КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		
		СобытияФормИС.ПослеЗаписиНаСервере(Форма);
		
	КонецЕсли;
	
КонецПроцедуры

// Соответствие требованиям ГИСМТПри записи документа.
// 
// Параметры:
//  Источник - ДокументОбъект
//  Отказ - Булево
Процедура СоответствиеТребованиямГИСМТПриЗаписиДокумента(Источник, Отказ) Экспорт
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваровУслуг")
		И Источник.ВидДокумента <> Перечисления.ВидыДокументов.ТоварнаяНакладная Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеТребованиямГИСМТ.СоответствиеТребованиямГИСМТПриЗаписиДокумента(Источник, Отказ);
	
КонецПроцедуры

// см. ПроверкаИПодборПродукцииИСМППереопределяемый.ПриПримененииПараметровИнтеграцииФормыПроверкиИПодбора
Процедура ПриПримененииПараметровИнтеграцииФормыПроверкиИПодбора(Форма) Экспорт
	
	#Если Не ВнешнееСоединение Тогда
	
	Если ИнтеграцияИСКЭДОКлиентСервер.ЭтоДокументПоНаименованию(Форма, "РеализацияТоваровУслуг")
		И Не КлиентЭДОКлиентСервер.ИспользоватьМаркировкуВДокументеРеализацияТоваровУслуг(Форма.Объект) Тогда
		Колонка = Форма.Элементы.Найти("ТоварыСтатусПроверкиГосИС");
		Если Колонка <> Неопределено Тогда
			Колонка.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	#КонецЕсли
	
КонецПроцедуры

// При определении дополнительного состояния электронного документа.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ДополнительноеСостояние - Неопределено, ФорматированнаяСтрока -
//  ДанныеСостояния - Произвольный
Процедура ПриОпределенииДополнительногоСостоянияЭлектронногоДокумента(Форма, ДополнительноеСостояние, ДанныеСостояния = Неопределено) Экспорт
	
	Если Не КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФормы = Форма.ИмяФормы;
	
	Если ИмяФормы = "Документ.ЭлектронныйДокументВходящийЭДО.Форма.ФормаПросмотра" Тогда
		
		Объект          = Форма.Объект;
		ДанныеСостояния = СоответствиеТребованиямГИСМТ.СостояниеКомандыСоответствиеТребованиямГИСМТ(Объект.Ссылка);
		
		Если ДанныеСостояния.Видимость Тогда
			
			Если ДанныеСостояния.ЦветТекста = ЦветаСтиля.ЦветГиперссылкиГосИС Тогда
				ЦветТекста = ЦветаСтиля.ЦветТекстаГиперссылкаДополнительногоСостоянияКЭДО;
			Иначе
				ЦветТекста = ДанныеСостояния.ЦветТекста;
			КонецЕсли;
			
			ДополнительноеСостояние = Новый ФорматированнаяСтрока(
				ДанныеСостояния.Заголовок,,
				ЦветТекста,,
				"СоответствиеТребованиямГИСМТГосИС");
		
		КонецЕсли;
		
	ИначеЕсли ИмяФормы = "Документ.ЭлектронныйДокументВходящийЭДО.Форма.ФормаПросмотраЛегкийИнтерфейс"
		Или ИмяФормы = "Документ.ЭлектронныйДокументВходящийЭДО.Форма.ФормаПросмотраЛегкийКлиентЭДО"
		Или ИмяФормы = "Документ.ЭлектронныйДокументИсходящийЭДО.Форма.ФормаПросмотраЛегкийКлиентЭДО" Тогда
		
		Если ДанныеСостояния <> Неопределено
			И ДанныеСостояния.Видимость Тогда
			ДополнительноеСостояние = Новый ФорматированнаяСтрока(
				ДанныеСостояния.Заголовок,,,,
				"СоответствиеТребованиямГИСМТГосИС");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает признак, что лицензионное соглашение принято.
//
Процедура УстановитьЛицензионноеСоглашениеПринято() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Константы.ЛицензионноеСоглашениеПринято.Установить(Истина);
	
КонецПроцедуры

// Возвращает индекс текущего статуса документа.
//
// Параметры:
//  Объект	 - ДокументОбъект.* - Документ, для которого вычисляется статус.
// 
// Возвращаемое значение:
//  Число - индекс статуса документа.
//
Функция СтатусДокумента(Объект) Экспорт
	
	Если Объект.ПометкаУдаления Тогда
		СтатусДокумента = 3;
	ИначеЕсли Объект.Проведен Тогда
		СтатусДокумента = 1;
	Иначе
		СтатусДокумента = 0;
	КонецЕсли;
	
	Возврат СтатусДокумента;
	
КонецФункции

// Проверка заполнения реквизитов без вывода сообщений пользователю.
//
// Параметры:
//  Объект				 - Документ.Объект.* - Документ, для которого необходимо выполнить проверку заполнения.
//  ПроверяемыеРеквизиты - Массив - Список путей к реквизитам, для которых будет выполнена проверка заполнения.
//  Отказ				 - Булево - Признак отказа от выполнения операции.
//
Процедура ОбработкаПроверкиЗаполнения(Объект, ПроверяемыеРеквизиты, Отказ) Экспорт
	
	Если НЕ Объект.ДополнительныеСвойства.Свойство("ПроверитьЗаполнениеБезВыводаОшибок") Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда
		ПроверяемыеРеквизиты.Очистить();
		Возврат;
	КонецЕсли;
	
	РеквизитыТабличныхЧастей = Новый Соответствие;
	
	Для Каждого ПроверяемыйРеквизит Из ПроверяемыеРеквизиты Цикл
		ПозицияРазделителя = СтрНайти(ПроверяемыйРеквизит, ".");
		Если ПозицияРазделителя > 0 Тогда
			ИмяТабличнойЧасти = Лев(ПроверяемыйРеквизит, ПозицияРазделителя - 1);
			ИмяРеквизита = Сред(ПроверяемыйРеквизит, ПозицияРазделителя + 1);
			МассивРеквизитов = РеквизитыТабличныхЧастей.Получить(ИмяТабличнойЧасти);
			Если МассивРеквизитов = Неопределено Тогда
				МассивРеквизитов = Новый Массив;
				МассивРеквизитов.Добавить(ИмяРеквизита);
				РеквизитыТабличныхЧастей.Вставить(ИмяТабличнойЧасти, МассивРеквизитов);
			Иначе
				МассивРеквизитов.Добавить(ИмяРеквизита);
			КонецЕсли;
		ИначеЕсли НЕ ЗначениеЗаполнено(Объект[ПроверяемыйРеквизит]) Тогда
			Отказ = Истина;
			ПроверяемыеРеквизиты.Очистить();
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого РеквизитыТабличнойЧасти Из РеквизитыТабличныхЧастей Цикл
		ТабличнаяЧасть   = Объект[РеквизитыТабличнойЧасти.Ключ];
		МассивРеквизитов = РеквизитыТабличнойЧасти.Значение;
		Для Каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
			Для Каждого ИмяРеквизита Из МассивРеквизитов Цикл
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы[ИмяРеквизита]) Тогда
					Отказ = Истина;
					ПроверяемыеРеквизиты.Очистить();
					Возврат;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ПроверяемыеРеквизиты.Очистить();
	
КонецПроцедуры

// Находит ссылку на справочник по переданному реквизиту.
//
// Параметры:
//  ИмяСправочника - Строка - Имя справочника, объект которого надо найти.
//  ИмяРеквизита - Строка - Имя реквизита, по которому будет проведен поиск.
//  ЗначРеквизита - Произвольный - значение реквизита, по которому будет проведен поиск.
//  Результат - СправочникСсылка - Ссылка на найденный объект.
//  Владелец - СправочникСсылка - Ссылка на владельца для поиска в иерархическом справочнике.
//  ТолькоНеПомеченные - Булево - Исключить из поиска помеченные на удаление.
//
Процедура НайтиСсылкуНаОбъектПоРеквизиту(ИмяСправочника, ИмяРеквизита, ЗначРеквизита, Результат, 
	Владелец = Неопределено,
	ТолькоНеПомеченные = Ложь) Экспорт
	
	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(ЗначРеквизита) Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.Справочники[ИмяСправочника];
	Если НЕ ОбщегоНазначения.ЭтоСтандартныйРеквизит(ОбъектМетаданных.СтандартныеРеквизиты, ИмяРеквизита)
		И НЕ ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИскСправочник.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК ИскСправочник
	|ГДЕ
	|	ИскСправочник." + ИмяРеквизита + " = &ЗначРеквизита";
	
	Если ЗначениеЗаполнено(Владелец) Тогда
		Запрос.Текст = Запрос.Текст + " И ИскСправочник.Владелец = &Владелец";
		Запрос.УстановитьПараметр("Владелец", Владелец);
	КонецЕсли;
	
	Если ТолькоНеПомеченные Тогда
		Запрос.Текст = Запрос.Текст + " И ИскСправочник.ПометкаУдаления = Ложь";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ЗначРеквизита", ЗначРеквизита);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

// Представление организации в печатных формах.
//
// Параметры:
//  СписокСведений	 - Структура - Данные по организации.
//  Список			 - Строка - Список полей представления.
//  СПрефиксом		 - Булево - Признак наличия префикса.
// 
// Возвращаемое значение:
//  Строка - представление организации.
//
Функция ОписаниеОрганизации(СписокСведений, Список = "", СПрефиксом = Истина) Экспорт

	Если ПустаяСтрока(Список) Тогда
		Список = "ПолноеНаименование,ИНН,ЮридическийАдрес,Телефоны,НомерСчета,Банк,БИК,КоррСчет";
	КонецЕсли;

	Результат = "";

	СоответствиеПараметров = Новый Соответствие();
	СоответствиеПараметров.Вставить("ПолноеНаименование", "");
	СоответствиеПараметров.Вставить("ИНН",                НСтр("ru = 'ИНН'"));
	СоответствиеПараметров.Вставить("КПП",                НСтр("ru = 'КПП'"));
	СоответствиеПараметров.Вставить("ЮридическийАдрес",   "");
	СоответствиеПараметров.Вставить("ФактическийАдрес",   "");
	СоответствиеПараметров.Вставить("Телефоны",           НСтр("ru = 'тел.:'"));
	СоответствиеПараметров.Вставить("НомерСчета",         НСтр("ru = 'р/с'"));
	СоответствиеПараметров.Вставить("Банк",               НСтр("ru = 'в банке'"));
	СоответствиеПараметров.Вставить("БИК",                НСтр("ru = 'БИК'"));
	СоответствиеПараметров.Вставить("КоррСчет",           НСтр("ru = 'к/с'"));
	СоответствиеПараметров.Вставить("КодПоОКПО",          НСтр("ru = 'Код по ОКПО'"));

	Список          = Список + ?(Прав(Список, 1) = ",", "", ",");
	ЧислоПараметров = СтрЧислоВхождений(Список, ",");

	Для Счетчик = 1 По ЧислоПараметров Цикл

		ПозЗапятой = СтрНайти(Список, ",");

		Если ПозЗапятой > 0  Тогда
			
			ИмяПараметра = Лев(Список, ПозЗапятой - 1);
			Список       = Сред(Список, ПозЗапятой + 1, СтрДлина(Список));

			Попытка
				СтрокаДополнения = "";
				СписокСведений.Свойство(ИмяПараметра, СтрокаДополнения);

				Если ПустаяСтрока(СтрокаДополнения) Тогда
					Продолжить;
				КонецЕсли;

				Префикс = СоответствиеПараметров[ИмяПараметра];
				Если Не ПустаяСтрока(Результат)  Тогда
					Результат = Результат + ",";
				КонецЕсли; 

				Результат = Результат + ?(СПрефиксом = Истина, " " + Префикс + " ", "") + СтрокаДополнения;
			Исключение
				
				ТекстСообщения  = НСтр("ru='Не удалось определить значение параметра организации: %ИмяПараметра%'");
				ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%ИмяПараметра%",ИмяПараметра);
				Сообщение       = Новый СообщениеПользователю();
				Сообщение.Текст = ТекстСообщения;
				Сообщение.Сообщить();
				
			КонецПопытки;

		КонецЕсли;

	КонецЦикла;

	Возврат СокрЛП(Результат);

КонецФункции // ОписаниеОрганизации()

// Заполняет параметры исходного документа.
//
// Параметры:
//  Объект - ДокументОбъект.РеализацияТоваровУслуг, ДокументОбъект.СчетФактураВыданный - Объект для заполнения.
//  РеквизитыОснования - Структура - Реквизиты документа основания.
//     * ВидОперации - ПеречислениеСсылка.ВидыОпераций
//     * НомерЭД - Строка - Исходящий номер электронного документа основания.
//     * Дата    - Дата   - Дата документа основания.
//     * НомерИсходногоДокумента - Строка - Номер корректируемого документа.
//     * ДатаИсходногоДокумента  - Дата   - Дата корректируемого документа.
//     * НомерИсправленияИсходногоДокумента - Строка - Номер исправления корректируемого документа.
//     * ДатаИсправленияИсходногоДокумента  - Дата   - Дата исправления корректируемого документа.
//     * НомерИсправляемогоКорректировочногоДокумента - Строка - Номер корректировочного документа,
//          для которого вводится исправление.
//     * ДатаИсправляемогоКорректировочногоДокумента  - Дата   - Дата корректировочного документа,
//          для которого вводится исправление.
//
Процедура ЗаполнитьНомерДатуИсходногоДокумента(Объект, РеквизитыОснования) Экспорт
	
	Если РеквизитыОснования.ВидОперации = Перечисления.ВидыОпераций.Реализация Тогда
		Объект.НомерИсходногоДокумента = РеквизитыОснования.НомерЭД;
		Объект.ДатаИсходногоДокумента  = РеквизитыОснования.Дата;
		Если Объект.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
			Объект.НомерЭД = Объект.НомерИсходногоДокумента;
			Объект.НомерИсправления = 1;
		КонецЕсли;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОпераций.Исправление
		И РеквизитыОснования.ВидОперации = Перечисления.ВидыОпераций.Корректировка Тогда
		
		Объект.НомерИсходногоДокумента = РеквизитыОснования.НомерИсходногоДокумента;
		Объект.ДатаИсходногоДокумента  = РеквизитыОснования.ДатаИсходногоДокумента;
		Объект.НомерИсправленияИсходногоДокумента = РеквизитыОснования.НомерИсправленияИсходногоДокумента;
		Объект.ДатаИсправленияИсходногоДокумента  = РеквизитыОснования.ДатаИсправленияИсходногоДокумента;
		Объект.НомерИсправляемогоКорректировочногоДокумента = РеквизитыОснования.НомерЭД;
		Объект.ДатаИсправляемогоКорректировочногоДокумента  = РеквизитыОснования.Дата;
		Объект.НомерЭД = Объект.НомерИсправляемогоКорректировочногоДокумента;
		Объект.НомерИсправления = 1;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОпераций.Исправление
		И РеквизитыОснования.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		
		Объект.НомерИсходногоДокумента = РеквизитыОснования.НомерИсходногоДокумента;
		Объект.ДатаИсходногоДокумента  = РеквизитыОснования.ДатаИсходногоДокумента;
		Объект.НомерИсправляемогоКорректировочногоДокумента = РеквизитыОснования.НомерИсправляемогоКорректировочногоДокумента;
		Объект.ДатаИсправляемогоКорректировочногоДокумента  = РеквизитыОснования.ДатаИсправляемогоКорректировочногоДокумента;
		Объект.НомерИсправления = РеквизитыОснования.НомерИсправления + 1;
		
		Если ЗначениеЗаполнено(РеквизитыОснования.НомерИсправляемогоКорректировочногоДокумента)
			И ЗначениеЗаполнено(РеквизитыОснования.ДатаИсправляемогоКорректировочногоДокумента) Тогда
			Объект.НомерИсправленияИсходногоДокумента = РеквизитыОснования.НомерИсправленияИсходногоДокумента;
			Объект.ДатаИсправленияИсходногоДокумента  = РеквизитыОснования.ДатаИсправленияИсходногоДокумента;
			Объект.НомерЭД = Объект.НомерИсправляемогоКорректировочногоДокумента;
		Иначе
			Объект.НомерИсправленияИсходногоДокумента = РеквизитыОснования.НомерИсправления;
			Объект.ДатаИсправленияИсходногоДокумента  = РеквизитыОснования.Дата;
			Объект.НомерЭД = Объект.НомерИсходногоДокумента;
		КонецЕсли;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОпераций.Корректировка
		И РеквизитыОснования.ВидОперации = Перечисления.ВидыОпераций.Корректировка Тогда
		
		Объект.НомерИсходногоДокумента = РеквизитыОснования.НомерЭД;
		Объект.ДатаИсходногоДокумента  = РеквизитыОснования.Дата;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОпераций.Корректировка
		И РеквизитыОснования.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		
		Если ЗначениеЗаполнено(РеквизитыОснования.НомерИсправляемогоКорректировочногоДокумента)
			И ЗначениеЗаполнено(РеквизитыОснования.ДатаИсправляемогоКорректировочногоДокумента) Тогда
			Объект.НомерИсходногоДокумента = РеквизитыОснования.НомерИсправляемогоКорректировочногоДокумента;
			Объект.ДатаИсходногоДокумента  = РеквизитыОснования.ДатаИсправляемогоКорректировочногоДокумента;
		Иначе
			Объект.НомерИсходногоДокумента = РеквизитыОснования.НомерИсходногоДокумента;
			Объект.ДатаИсходногоДокумента  = РеквизитыОснования.ДатаИсходногоДокумента;
		КонецЕсли;
		Объект.НомерИсправленияИсходногоДокумента = РеквизитыОснования.НомерИсправления;
		Объект.ДатаИсправленияИсходногоДокумента  = РеквизитыОснования.Дата;
		
	КонецЕсли;
	
КонецПроцедуры

// См. КоммерческиеПредложенияДокументыПереопределяемый.УстановитьУсловноеОформлениеХарактеристикНоменклатуры.
//
Процедура УстановитьУсловноеОформлениеХарактеристикНоменклатуры(Форма,
	ИмяПоляВводаХарактеристики = "ТоварыХарактеристика", ПутьКПолюОтбора = "Объект.Товары.ХарактеристикиИспользуются") Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры") Тогда
		Возврат;
	КонецЕсли;
	
	УсловноеОформление = Форма.УсловноеОформление;
	ЭлементыФормы = Форма.Элементы;
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ЭлементыФормы[ИмяПоляВводаХарактеристики].Имя);
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКПолюОтбора);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;

	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<характеристики не используются>'"));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры

// Устанавливает условное оформление для содержания товара/услуги.
//
// Параметры:
//  Форма - Форма - Содержит данную форму. 
//  ИмяПоляВводаСодержания - Строка - Наименование элемента формы, содержащего содержание товара/услуги.
//  ИмяПоляВводаПредставленияСодержания - Строка - Имя поля, в котором храниться представление содержания.
//  ПутьКПолюСодержания - Строка - Полный путь к реквизиту "Содержание".
//  ПутьКПолюНоменклатуры - Строка - Полный путь к реквизиту "Номенклатура".
//  ТекстПустогоПоля - Строка - Текст оформляемого поля если содержание не заполнено.
//
Процедура УстановитьУсловноеОформлениеПредставленияСодержания(Форма, ИмяПоляВводаСодержания,
	ИмяПоляВводаПредставленияСодержания, ПутьКПолюСодержания, 
	ПутьКПолюНоменклатуры, ТекстПустогоПоля = "Пусто") Экспорт
	
	УсловноеОформление = Форма.УсловноеОформление;
	ЭлементыФормы = Форма.Элементы;	
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, ИмяПоляВводаСодержания);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		ПутьКПолюСодержания, ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		ПутьКПолюНоменклатуры, ВидСравненияКомпоновкиДанных.НеЗаполнено); 
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", ТекстПустогоПоля);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, ИмяПоляВводаСодержания);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		ПутьКПолюСодержания, ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		ПутьКПолюНоменклатуры, ВидСравненияКомпоновкиДанных.Заполнено); 
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", Новый ПолеКомпоновкиДанных(ИмяПоляВводаПредставленияСодержания));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);

КонецПроцедуры

// Устанавливает условное оформление для полей-надписей табличных частей акта о расхождениях.
//
// Параметры:
//  Форма - Форма - Содержит данную форму. 
//
Процедура УстановитьУсловноеОформлениеНадписейАктаОРасхождениях(Форма) Экспорт
	
	ОписаниеОформляемыхПолей = Новый Структура;
	ОписаниеОформляемыхПолей.Вставить("ТоварыНадписьПоДокументу", НСтр("ru = 'По документу:'"));
	ОписаниеОформляемыхПолей.Вставить("ТоварыНадписьПоФакту", НСтр("ru = 'По факту:'"));
	ОписаниеОформляемыхПолей.Вставить("ТоварыНадписьРасхождение", НСтр("ru = 'Расхождение:'"));
	ОписаниеОформляемыхПолей.Вставить("ТоварыНадписьПоДоговоруЦена", НСтр("ru = 'Цена:'"));
	ОписаниеОформляемыхПолей.Вставить("ТоварыНадписьПоДоговоруСуммаНДС", НСтр("ru = 'Сумма НДС:'"));
	ОписаниеОформляемыхПолей.Вставить("ТоварыНадписьПоДоговоруСуммаСНДС", НСтр("ru = 'Сумма с НДС:'"));
	
	Для Каждого ОписаниеПоля Из ОписаниеОформляемыхПолей Цикл
		
		ЭлементОформления = Форма.УсловноеОформление.Элементы.Добавить();
		ЗаполнитьЭлементОформленияНадписиВАктеОРасхождениях(ЭлементОформления, ОписаниеПоля.Ключ,
			"Товары", ОписаниеПоля.Значение);
		
	КонецЦикла;
	
	ОписаниеОформляемыхПолей = Новый Структура;
	ОписаниеОформляемыхПолей.Вставить("СведенияОГрузеНадписьПоДокументу", НСтр("ru = 'По документу:'"));
	ОписаниеОформляемыхПолей.Вставить("СведенияОГрузеНадписьПоФакту", НСтр("ru = 'По факту:'"));
	ОписаниеОформляемыхПолей.Вставить("СведенияОГрузеНадписьРасхождение", НСтр("ru = 'Расхождение:'"));
	
	Для Каждого ОписаниеПоля Из ОписаниеОформляемыхПолей Цикл
		
		ЭлементОформления = Форма.УсловноеОформление.Элементы.Добавить();
		ЗаполнитьЭлементОформленияНадписиВАктеОРасхождениях(ЭлементОформления, ОписаниеПоля.Ключ,
			"СведенияОГрузе", ОписаниеПоля.Значение);
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет колонку "ХарактеристикиИспользуются" в формах.
//
// Параметры:
//   КоллекцияДанных - ДанныеФормыКоллекция, ТаблицаЗначений - Таблица, в которой необходимо заполнить
//      колонку "ХарактеристикиИспользуются".
//
Процедура ЗаполнитьПризнакИспользованияХарактеристик(КоллекцияДанных) Экспорт
	
	Если КоллекцияДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(КоллекцияДанных) = Тип("ТаблицаЗначений") Тогда
		ПараметрКоллекция = КоллекцияДанных;
	Иначе
		Колонки = "НомерСтроки,Номенклатура";
		ПараметрКоллекция = КоллекцияДанных.Выгрузить(, Колонки);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КоллекцияДанных.НомерСтроки КАК НомерСтроки,
		|	КоллекцияДанных.Номенклатура КАК Ссылка
		|ПОМЕСТИТЬ ВТ_Номенклатура
		|ИЗ
		|	&КоллекцияДанных КАК КоллекцияДанных
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Номенклатура.НомерСтроки КАК НомерСтроки,
		|	ЕСТЬNULL(ВидыНоменклатуры.ИспользоватьХарактеристики, ЛОЖЬ) КАК ИспользоватьХарактеристики
		|ИЗ
		|	ВТ_Номенклатура КАК ВТ_Номенклатура
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО ВТ_Номенклатура.Ссылка = Номенклатура.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|		ПО (Номенклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка)";
	Запрос.УстановитьПараметр("КоллекцияДанных", ПараметрКоллекция);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КоллекцияДанных[Выборка.НомерСтроки - 1].ХарактеристикиИспользуются = Выборка.ИспользоватьХарактеристики;
	КонецЦикла;
	
КонецПроцедуры

// Заполняет колонку "ПредставлениеСодержания" в формах.
//
// Параметры:
//   КоллекцияДанных - ДанныеФормыКоллекция, ТаблицаЗначений - Таблица, в которой необходимо заполнить
//      колонку "ПредставлениеСодержания".
//
Процедура ЗаполнитьПредставленияСодержаний(КоллекцияДанных) Экспорт
	
	Если КоллекцияДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
		
	Если ТипЗнч(КоллекцияДанных) = Тип("ТаблицаЗначений") Тогда
		ПараметрКоллекция = КоллекцияДанных;
	Иначе
		Колонки = "НомерСтроки, Номенклатура, Характеристика";
		ПараметрКоллекция = КоллекцияДанных.Выгрузить(, Колонки);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КоллекцияДанных.НомерСтроки КАК НомерСтроки,
		|	КоллекцияДанных.Номенклатура КАК Ссылка,
		|	КоллекцияДанных.Характеристика КАК Характеристика
		|ПОМЕСТИТЬ ВТ_Номенклатура
		|ИЗ
		|	&КоллекцияДанных КАК КоллекцияДанных
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Номенклатура.НомерСтроки КАК НомерСтроки,
		|	ВТ_Номенклатура.Ссылка.НаименованиеПолное КАК НоменклатураНаименование,
		|	ВЫБОР
		|		КОГДА &ХарактеристикиИспользуются
		|			ТОГДА ВТ_Номенклатура.Характеристика.Наименование
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ХарактеристикаНаименование
		|ИЗ
		|	ВТ_Номенклатура КАК ВТ_Номенклатура
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО ВТ_Номенклатура.Ссылка = Номенклатура.Ссылка";
	
	Запрос.УстановитьПараметр("КоллекцияДанных", ПараметрКоллекция);
	Запрос.УстановитьПараметр("ХарактеристикиИспользуются", ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры"));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ПредставлениеСодержания = Выборка.НоменклатураНаименование;
		
		Если ЗначениеЗаполнено(Выборка.ХарактеристикаНаименование) Тогда
			ПредставлениеСодержания = ПредставлениеСодержания + " (" + Выборка.ХарактеристикаНаименование + ")"; 	
		КонецЕсли;
		
		КоллекцияДанных[Выборка.НомерСтроки - 1].ПредставлениеСодержания = ПредставлениеСодержания;
		
	КонецЦикла;
	
КонецПроцедуры

// Устанавливает условное оформление для количества и единицы измерения.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, в которой устанавливается условное оформление.
//  ИмяПоляВводаКоличества - Строка - наименование элемента формы, содержащего количество,
//     если оно отличается от "ТоварыКоличество".
//  ИмяПоляВводаЕдиницыИзмерения - Строка - наименование элемента формы, содержащего единицу
//     измерения, если оно отличается от "ТоварыЕдиницаИзмерения".
//  ПутьКПолюОтбора - Строка - полный путь к реквизиту "ТипНоменклатуры",
//     если он отличается от "Объект.Товары.ТипНоменклатуры".
//
Процедура УстановитьУсловноеОформлениеКоличестваИЕдиницыИзмерения(Форма,
	ИмяПоляВводаКоличества = "ТоварыКоличество", ИмяПоляВводаЕдиницыИзмерения = "ТоварыЕдиницаИзмерения",
	ПутьКПолюОтбора = "Объект.Товары.ТипНоменклатуры") Экспорт
	
	УсловноеОформление = Форма.УсловноеОформление;
	ЭлементыФормы = Форма.Элементы;
	
	СписокТиповНоменклатуры = Новый СписокЗначений;
	СписокТиповНоменклатуры.ЗагрузитьЗначения(ТипыНоменклатурыБезПроверкиКоличестваИЕдиницыИзмерения());
	
	#Область Количество
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ЭлементыФормы[ИмяПоляВводаКоличества].Имя);
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКПолюОтбора);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ОтборЭлемента.ПравоеЗначение = СписокТиповНоменклатуры;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	#КонецОбласти
	
	#Область ЕдиницаИзмерения
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ЭлементыФормы[ИмяПоляВводаЕдиницыИзмерения].Имя);
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКПолюОтбора);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ОтборЭлемента.ПравоеЗначение = СписокТиповНоменклатуры;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	#КонецОбласти
	
КонецПроцедуры

// Заполняет колонку "ТипНоменклатуры" в формах.
//
// Параметры:
//   КоллекцияДанных - ДанныеФормыКоллекция, ТаблицаЗначений - Таблица, в которой необходимо заполнить
//      колонку "ТипНоменклатуры".
//
Процедура ЗаполнитьТипНоменклатуры(КоллекцияДанных) Экспорт
	
	Если КоллекцияДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	Если ТипЗнч(КоллекцияДанных) = Тип("ТаблицаЗначений") Тогда
		ПараметрКоллекция = КоллекцияДанных;
	Иначе
		Колонки = "НомерСтроки,Номенклатура";
		ПараметрКоллекция = КоллекцияДанных.Выгрузить(, Колонки);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КоллекцияДанных.НомерСтроки КАК НомерСтроки,
		|	КоллекцияДанных.Номенклатура КАК Ссылка
		|ПОМЕСТИТЬ ВТ_Номенклатура
		|ИЗ
		|	&КоллекцияДанных КАК КоллекцияДанных
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Номенклатура.НомерСтроки КАК НомерСтроки,
		|	ЕСТЬNULL(ВидыНоменклатуры.ТипНоменклатуры, ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПустаяСсылка)) КАК ТипНоменклатуры
		|ИЗ
		|	ВТ_Номенклатура КАК ВТ_Номенклатура
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО ВТ_Номенклатура.Ссылка = Номенклатура.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
		|		ПО (Номенклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка)";
	Запрос.УстановитьПараметр("КоллекцияДанных", ПараметрКоллекция);
	
	ПараметрыПоиска = Новый Структура("НомерСтроки");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПараметрыПоиска.Вставить("НомерСтроки", Выборка.НомерСтроки);
		НайденныеСтроки = КоллекцияДанных.НайтиСтроки(ПараметрыПоиска);
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.ТипНоменклатуры = Выборка.ТипНоменклатуры;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Заполняет колонки: "ЕдиницаИзмерения", "ТипНоменклатуры", "ХарактеристикиИспользуются" в формах.
//
// Параметры:
//   КоллекцияДанных - ДанныеФормыКоллекция, ТаблицаЗначений - Таблица, в которой необходимо заполнить данные.
//
Процедура ЗаполнитьСлужебныеРеквизитыВКоллекции(КоллекцияДанных) Экспорт
	
	Если КоллекцияДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(КоллекцияДанных) = Тип("ТаблицаЗначений") Тогда
		ПараметрКоллекция = КоллекцияДанных;
	Иначе
		Колонки = "НомерСтроки,Номенклатура";
		ПараметрКоллекция = КоллекцияДанных.Выгрузить(, Колонки);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КоллекцияДанных",                        ПараметрКоллекция);
	Запрос.УстановитьПараметр("ИспользоватьХарактеристикиНоменклатуры", ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры"));
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	КоллекцияДанных.НомерСтроки КАК НомерСтроки,
	|	КоллекцияДанных.Номенклатура КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	&КоллекцияДанных КАК КоллекцияДанных
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.НомерСтроки КАК НомерСтроки,
	|	СпрНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(ВидыНоменклатуры.ТипНоменклатуры, ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПустаяСсылка)) КАК ТипНоменклатуры,
	|	&ИспользоватьХарактеристикиНоменклатуры
	|		И ЕСТЬNULL(ВидыНоменклатуры.ИспользоватьХарактеристики, ЛОЖЬ) КАК ХарактеристикиИспользуются,
	|	&ПроизвольнаяЕдиницаУчета                                         КАК ПроизвольнаяЕдиницаУчета,
	|	&ТребуетВзвешивания                                               КАК ТребуетВзвешивания
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ВТ_Номенклатура.Ссылка = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|		ПО (СпрНоменклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка)
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|		ПО &ТоварыОписаниеНоменклатурыИС";
	
	ОбщегоНазначенияИС.ОбновитьТекстЗапросаСРегистромОписаниеНоменклатурыИС(ТекстЗапроса, "ОписаниеНоменклатурыИС", "СпрНоменклатура.Ссылка");
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(КоллекцияДанных[Выборка.НомерСтроки - 1], Выборка, , "НомерСтроки");
	КонецЦикла;
	
КонецПроцедуры

// Кэширует значения колонок "НомерСтроки, ХарактеристикиИспользуются" из коллекции данных.
//
// Параметры:
//  КоллекцияДанных - ДанныеФормыКоллекция, ТаблицаЗначений - Таблица, из которой кэшируются значения колонок.
//  Кэш - Структура - объект, в котором кэшируются данные.
//
Процедура КэшироватьПризнакИспользованияХарактеристик(КоллекцияДанных, Кэш) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры") Тогда
		Возврат;
	КонецЕсли;
	
	ИспользованиеХарактеристик = КоллекцияДанных.Выгрузить(,"НомерСтроки, ХарактеристикиИспользуются");
	Кэш.Вставить("ИспользованиеХарактеристик", ИспользованиеХарактеристик);
	
КонецПроцедуры

// Восстанавливает из кэша значения колонок "НомерСтроки, ХарактеристикиИспользуются" в коллекцию данных.
//
// Параметры:
//  КоллекцияДанных - ДанныеФормыКоллекция, ТаблицаЗначений - Таблица, из которой кэшируются значения колонок.
//  Кэш - Структура - объект, в котором кэшируются данные.
//
Процедура ВосстановитьПризнакИспользованияХарактеристик(КоллекцияДанных, Кэш) Экспорт
	
	ИспользованиеХарактеристик = Неопределено;
	Если Кэш.Свойство("ИспользованиеХарактеристик", ИспользованиеХарактеристик) Тогда
		Для Каждого СтрокаКоллекции Из КоллекцияДанных Цикл
			СтрокаКоллекции.ХарактеристикиИспользуются = 
				ИспользованиеХарактеристик[СтрокаКоллекции.НомерСтроки-1].ХарактеристикиИспользуются;
		КонецЦикла;
		Кэш.Удалить("ИспользованиеХарактеристик");
	КонецЕсли;
	
КонецПроцедуры

Функция КолонкиИспользованияХарактеристик() Экспорт
	Возврат ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("ХарактеристикиИспользуются");
КонецФункции

// Кэширует значения колонок "НомерСтроки, ПредставлениеСодержания" из коллекции данных.
