// См. ОбщегоНазначенияПереопределяемый.ПриДобавленииПараметровРаботыКлиентаПриЗапуске.
Процедура ПараметрыРаботыКлиентаПриЗапуске(Параметры) Экспорт
	
	// _Демо начало примера
	Параметры.Вставить("ПоказатьНачалоРаботы", Ложь);
	Возврат;
	// _Демо конец примера
	
	ПоказыватьСтартовыйПомощникКЭДО = Ложь;
	Если НЕ ОбщегоНазначения.ЭтоМобильныйКлиент()
		И ПравоДоступа("Изменение", Метаданные.Справочники.Организации)
		И ОбменСКонтрагентами.ЕстьПравоНастройкиОбмена()
		И БизнесСеть.ПравоНастройкиОбменаДокументами()
		И НЕ СинхронизацияЭДО.ЕстьУчетныеЗаписи() Тогда
		
		ИспользоватьСервисЭДО = Константы.ИспользоватьОбменЭД.Получить();
		НастройкиСтартовогоПомощникаКЭДО = ПолучитьНастройкиСтартовогоПомощникаКЭДО();
		
		БольшеНеПоказывать = Ложь;
		УслугаOnboarding   = Ложь;
		Если ЗначениеЗаполнено(НастройкиСтартовогоПомощникаКЭДО) Тогда
			Если НастройкиСтартовогоПомощникаКЭДО.Свойство("БольшеНеПоказывать") Тогда
				БольшеНеПоказывать = НастройкиСтартовогоПомощникаКЭДО.БольшеНеПоказывать;
			КонецЕсли;
			Если НастройкиСтартовогоПомощникаКЭДО.Свойство("УслугаOnboarding") Тогда
				УслугаOnboarding = НастройкиСтартовогоПомощникаКЭДО.УслугаOnboarding;
			КонецЕсли;
		КонецЕсли;
		
		ЕстьОрганизации = ЕстьОрганизацииВБазе();
		
		Если НЕ БольшеНеПоказывать И ((ЕстьОрганизации И УслугаOnboarding
			ИЛИ ИспользоватьСервисЭДО) ИЛИ НЕ ЕстьОрганизации) Тогда
			ПоказыватьСтартовыйПомощникКЭДО = Истина;
		КонецЕсли;
		
		Параметры.Вставить("ПоказыватьСтартовыйПомощникКЭДО", ПоказыватьСтартовыйПомощникКЭДО);
		
	КонецЕсли;
		
	Если НЕ ПоказыватьСтартовыйПомощникКЭДО Тогда
		ПоказатьНачалоРаботы = Не ОбщегоНазначения.РазделениеВключено()
			И НЕ Константы.ЛицензионноеСоглашениеПринято.Получить();
		Параметры.Вставить("ПоказатьНачалоРаботы", ПоказатьНачалоРаботы);
	КонецЕсли;
	
КонецПроцедуры

