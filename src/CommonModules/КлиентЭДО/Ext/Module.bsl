//  Кэш - Структура - объект, в котором кэшируются данные.
//
Процедура КэшироватьПредставленияСодержаний(КоллекцияДанных, Кэш) Экспорт
	
	ИспользованиеХарактеристик = КоллекцияДанных.Выгрузить(,"НомерСтроки, ПредставлениеСодержания");
	Кэш.Вставить("ПредставленияСодержаний", ИспользованиеХарактеристик);
	
КонецПроцедуры

// Восстанавливает из кэша значения колонок "НомерСтроки, ПредставлениеСодержания" в коллекцию данных.
//
// Параметры:
//  КоллекцияДанных - ДанныеФормыКоллекция, ТаблицаЗначений - Таблица, из которой кэшируются значения колонок.
//  Кэш - Структура - объект, в котором кэшируются данные.
//
Процедура ВосстановитьПредставленияСодержаний(КоллекцияДанных, Кэш) Экспорт
	
	ПредставленияСодержаний = Неопределено;
	Если Кэш.Свойство("ПредставленияСодержаний", ПредставленияСодержаний) Тогда
