КонецФункции

// Возвращает организацию по ИНН или создает новую, заполняя только ИНН и наименование "Моя организация"
//
// Параметры:
//  ИНН - Строка
//
// Возвращаемое значение:
//  ОпределяемыйТип.Организация
//
Функция НайтиСоздатьНачальнуюОрганизацию(ИНН = "") Экспорт
	
	Организация = ОбщегоНазначенияБЭД.НайтиСсылку("Организации", , Новый Структура("ИНН", ИНН));
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления";
		ВыборкаОрганизаций = Запрос.Выполнить().Выбрать();
		Если ВыборкаОрганизаций.Следующий() Тогда
			Организация = ВыборкаОрганизаций.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		НаименованиеОрганизации = "Моя организация";
		РеквизитыОрганизации = ОбменСКонтрагентамиКлиентСервер.НовыйДанныеОрганизации();
		РеквизитыОрганизации.ИНН = ИНН;
		РеквизитыОрганизации.НаименованиеСокращенное = НаименованиеОрганизации;
		
		ОбменСКонтрагентамиКЭДО.СоздатьОрганизацию(РеквизитыОрганизации, Организация);
		
	КонецЕсли;
	
	Возврат Организация;
	
КонецФункции

