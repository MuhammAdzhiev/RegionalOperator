КонецПроцедуры

Функция КолонкиПредставленияСодержаний() Экспорт
	Возврат ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("ПредставлениеСодержания");
КонецФункции

// Процедура проверки заполнения колонок "Характеристика" в объектах.
//
// Параметры:
//  ПараметрыПроверки - Структура - параметры, используемые при выполнении проверки.
//     * Объект - ДокументОбъект - объект, для которого требуется проверить заполнение.
//     * ИмяТабличнойЧасти - Строка - имя табличной части, для которой выполняется проверка. Значение по умолчанию "Товары".
//     * МассивНепроверяемыхРеквизитов - Массив - реквизиты, которые не нужно проверять платформенной проверкой.
//  Отказ - Булево - признак отказа продолжения операции.
//
Процедура ПроверитьЗаполнениеХарактеристик(ПараметрыПроверки, Отказ) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТабличнойЧасти = Неопределено;
	Если НЕ (ПараметрыПроверки.Свойство("ИмяТабличнойЧасти", ИмяТабличнойЧасти) И ЗначениеЗаполнено(ИмяТабличнойЧасти)) Тогда
		ИмяТабличнойЧасти = "Товары";
	КонецЕсли;
	
	ПараметрыПроверки.МассивНепроверяемыхРеквизитов.Добавить(ИмяТабличнойЧасти + ".Характеристика" );
	
	Объект = ПараметрыПроверки.Объект;
	ТаблицаДляПроверки = Объект[ИмяТабличнойЧасти].Выгрузить(, "НомерСтроки, Номенклатура, Характеристика");
	ТаблицаДляПроверки.Колонки.Добавить("ХарактеристикиИспользуются", Новый ОписаниеТипов("Булево"));
	
	ЗаполнитьПризнакИспользованияХарактеристик(ТаблицаДляПроверки);
	
	Для Каждого СтрокаТаблицы Из ТаблицаДляПроверки Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.Характеристика)
			И НЕ СтрокаТаблицы.ХарактеристикиИспользуются Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Для номенклатуры в строке %1 отключено использование характеристик'"),
				СтрокаТаблицы.НомерСтроки);
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
				ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, "Характеристика");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, Поле, "Объект", Отказ);
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаТаблицы.Характеристика)
			И СтрокаТаблицы.ХарактеристикиИспользуются Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не заполнена колонка ""Характеристика"" в строке %1 списка ""%2""'"),
				СтрокаТаблицы.НомерСтроки, ИмяТабличнойЧасти);
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
				ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, "Характеристика");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, Поле, "Объект", Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Проверяет заполнение колонок "Количество" и "ЕдиницаИзмерения" в объектах.
//
// Параметры:
//  ПараметрыПроверки - Структура - см. ПараметрыПроверкиЗаполненияКоличестваИЕдиницыИзмерения.
//  Отказ - Булево - признак отказа продолжения операции.
//
Процедура ПроверитьЗаполнениеКоличестваИЕдиницыИзмерения(ПараметрыПроверки, Отказ) Экспорт
	
	ИмяТабличнойЧасти = Неопределено;
	Если НЕ (ПараметрыПроверки.Свойство("ИмяТабличнойЧасти") И ЗначениеЗаполнено(ИмяТабличнойЧасти)) Тогда
		ИмяТабличнойЧасти = "Товары";
	КонецЕсли;
	
	ПараметрыПроверки.МассивНепроверяемыхРеквизитов.Добавить(ИмяТабличнойЧасти + ".Количество");
	ПараметрыПроверки.МассивНепроверяемыхРеквизитов.Добавить(ИмяТабличнойЧасти + ".КоличествоУпаковок");
	ПараметрыПроверки.МассивНепроверяемыхРеквизитов.Добавить(ИмяТабличнойЧасти + ".ЕдиницаИзмерения");
	ПараметрыПроверки.МассивНепроверяемыхРеквизитов.Добавить(ИмяТабличнойЧасти + ".Цена");
	
	Объект = ПараметрыПроверки.Объект;
	ТаблицаДляПроверки = Объект[ИмяТабличнойЧасти].ВыгрузитьКолонки(
		"НомерСтроки, Номенклатура, КоличествоУпаковок, ЕдиницаИзмерения, Цена");
	ТаблицаДляПроверки.Колонки.Добавить("ТипНоменклатуры", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыНоменклатуры"));
	Для Каждого СтрокаТаблицы Из Объект[ИмяТабличнойЧасти] Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			ЗаполнитьЗначенияСвойств(ТаблицаДляПроверки.Добавить(), СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ТаблицаДляПроверки) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТипНоменклатуры(ТаблицаДляПроверки);
	
	ТипыБезПроверки = ТипыНоменклатурыБезПроверкиКоличестваИЕдиницыИзмерения();
	
	Для Каждого СтрокаТаблицы Из ТаблицаДляПроверки Цикл
		Если ТипыБезПроверки.Найти(СтрокаТаблицы.ТипНоменклатуры) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.КоличествоУпаковок) Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не заполнена колонка ""Количество"" в строке %1 списка ""%2""'"),
				СтрокаТаблицы.НомерСтроки, ИмяТабличнойЧасти);
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
				ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, "КоличествоУпаковок");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, Поле, "Объект", Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не заполнена колонка ""Единица измерения"" в строке %1 списка ""%2""'"),
				СтрокаТаблицы.НомерСтроки, ИмяТабличнойЧасти);
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
				ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, "ЕдиницаИзмерения");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, Поле, "Объект", Отказ);
		КонецЕсли;
		
		ЦенаЗаполнена = ЗначениеЗаполнено(СтрокаТаблицы.Цена);
		Если Не ЦенаЗаполнена И ЗначениеЗаполнено(ПараметрыПроверки.МинимальноеЗначениеЦены) Тогда
			ЦенаЗаполнена = (ТипЗнч(СтрокаТаблицы.Цена) = Тип("Число")
				И СтрокаТаблицы.Цена >= ПараметрыПроверки.МинимальноеЗначениеЦены);
		КонецЕсли;
		Если Не ЦенаЗаполнена И ЗначениеЗаполнено(СтрокаТаблицы.КоличествоУпаковок) Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не заполнена колонка ""Цена"" в строке %1 списка ""%2""'"),
				СтрокаТаблицы.НомерСтроки, ИмяТабличнойЧасти);
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
				ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, "Цена");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, Поле, "Объект", Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Проверяет заполнение колонок "КодОКОФ", "СрокПолезногоИспользования", "ФактСрокПолезногоИспользования" и "АмортизационнаяГруппа".
// Параметры:
//  ПараметрыПроверки - Структура - параметры, используемые при выполнении проверки:
//     * Объект - ДокументОбъект - объект, для которого требуется проверить заполнение.
//     * ИмяТабличнойЧасти - Строка - имя табличной части, для которой выполняется проверка. Значение по умолчанию "Товары".
//     * МассивНепроверяемыхРеквизитов - Массив из Строка- реквизиты, которые не нужно проверять платформенной проверкой.
//  Отказ - Булево - признак отказа продолжения операции.
//
Процедура ПроверитьЗаполнениеДанныхАмортизации(ПараметрыПроверки, Отказ) Экспорт
	
	ИмяТабличнойЧасти = Неопределено;
	Если Не (ПараметрыПроверки.Свойство("ИмяТабличнойЧасти") И ЗначениеЗаполнено(ИмяТабличнойЧасти)) Тогда
		ИмяТабличнойЧасти = "Товары";
	КонецЕсли;
	
	Объект = ПараметрыПроверки.Объект;
	
	ТаблицаДляПроверки = Объект[ИмяТабличнойЧасти].Выгрузить(, "НомерСтроки ,АмортизационнаяГруппа, КодОКОФ,
		|СрокПолезногоИспользования, ФактСрокПолезногоИспользования");
	
	Для Каждого СтрокаТаблицы Из ТаблицаДляПроверки Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.КодОКОФ) Тогда
			
			ЧислоЦифрВГруппировке = СтрНайти(СтрокаТаблицы.КодОКОФ, ".") - 1;
			ГруппировкаОКОФ = Лев(СтрокаТаблицы.КодОКОФ, ЧислоЦифрВГруппировке);
			ЧислоГруппировки = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ГруппировкаОКОФ);
			СоответствуетДиапазону = 100 <= ЧислоГруппировки И ЧислоГруппировки <= 790;
			Если Не СоответствуетДиапазону Тогда
				ТекстСообщения = СтрШаблон(НСтр("ru = 'Код группировки ОКОФ в строке %1 не соответствует диапазону от 100 до 790'"),
					СтрокаТаблицы.НомерСтроки);
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
					ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, "КодОКОФ");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, Поле, "Объект", Отказ);
			КонецЕсли;
			
			МассивРазрядовКодОКОФ = СтрРазделить(СтрокаТаблицы.КодОКОФ, ".");
			ШаблонСообщения = НСтр("ru = 'Код ОКОФ в строке %1 не соответствует шаблону ""%2"" в %3 разряде'");
			НомерРазряда = 0;
			Для Каждого РазрядКодаОКОФ Из МассивРазрядовКодОКОФ Цикл
				НомерРазряда = НомерРазряда + 1;
				Если Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(РазрядКодаОКОФ) Тогда
					ШаблонРазряда = СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов("X", СтрДлина(РазрядКодаОКОФ));
					ТекстСообщения = СтрШаблон(ШаблонСообщения, СтрокаТаблицы.НомерСтроки, ШаблонРазряда, НомерРазряда);
					Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
						ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, "КодОКОФ");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, Поле, "Объект", Отказ);
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.АмортизационнаяГруппа) Тогда
			
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.КодОКОФ) Тогда
				ТекстСообщения = СтрШаблон(НСтр("ru = 'В строке %1 не заполнено значение поля ""Код ОКОФ""'"),
					СтрокаТаблицы.НомерСтроки);
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
					ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, "КодОКОФ");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, Поле, "Объект", Отказ);
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.СрокПолезногоИспользования) Тогда
				ТекстСообщения = СтрШаблон(НСтр("ru = 'В строке %1 не заполнено значение поля ""Срок полезного использования""'"),
					СтрокаТаблицы.НомерСтроки);
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
					ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, "СрокПолезногоИспользования");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, Поле, "Объект", Отказ);
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.ФактСрокПолезногоИспользования) Тогда
				ТекстСообщения = СтрШаблон(НСтр("ru = 'В строке %1 не заполнено значение поля ""Фактический срок полезного использования""'"),
					СтрокаТаблицы.НомерСтроки);
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
					ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, "ФактСрокПолезногоИспользования");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, Поле, "Объект", Отказ);
			КонецЕсли;
		
		ИначеЕсли ЗначениеЗаполнено(СтрокаТаблицы.КодОКОФ) 
			Или ЗначениеЗаполнено(СтрокаТаблицы.СрокПолезногоИспользования)
			Или ЗначениеЗаполнено(СтрокаТаблицы.ФактСрокПолезногоИспользования) Тогда
			
			ТекстСообщения = СтрШаблон(НСтр("ru = 'В строке %1 не заполнено значение поля ""Амортизационная группа""'"),
				СтрокаТаблицы.НомерСтроки);
			Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
				ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, "АмортизационнаяГруппа");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, Поле, "Объект", Отказ);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает типы номенклатуры для которых не выполняется проверка заполнения реквизитов "Количество" и "Единица измерения".
//
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.ТипыНоменклатуры - типы номенклатуры без проверки.
Функция ТипыНоменклатурыБезПроверкиКоличестваИЕдиницыИзмерения() Экспорт
	
	ТипыНоменклатуры = Новый Массив;
	ТипыНоменклатуры.Добавить(Перечисления.ТипыНоменклатуры.Работа);
	ТипыНоменклатуры.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
	ТипыНоменклатуры.Добавить(Перечисления.ТипыНоменклатуры.Право);
	
	Возврат ТипыНоменклатуры;
	
КонецФункции

// Кэширует значения колонок "НомерСтроки, ТипНоменклатуры" из коллекции данных.
//
// Параметры:
//  КоллекцияДанных - ДанныеФормыКоллекция, ТаблицаЗначений - Таблица, из которой кэшируются значения колонок.
//  Кэш - Структура - объект, в котором кэшируются данные.
//
Процедура КэшироватьТипыНоменклатуры(КоллекцияДанных, Кэш) Экспорт
	
	ТипыНоменклатуры = КоллекцияДанных.Выгрузить(,"НомерСтроки, ТипНоменклатуры");
	Кэш.Вставить("ТипыНоменклатуры", ТипыНоменклатуры);
	
КонецПроцедуры

// Восстанавливает из кэша значения колонок "НомерСтроки, ТипНоменклатуры" в коллекцию данных.
//
// Параметры:
//  КоллекцияДанных - ДанныеФормыКоллекция, ТаблицаЗначений - Таблица, из которой кэшируются значения колонок.
//  Кэш - Структура - объект, в котором кэшируются данные.
//
Процедура ВосстановитьТипыНоменклатуры(КоллекцияДанных, Кэш) Экспорт
	
	ТипыНоменклатуры = Неопределено;
	Если Кэш.Свойство("ТипыНоменклатуры", ТипыНоменклатуры) Тогда
		Для Каждого СтрокаКоллекции Из КоллекцияДанных Цикл
			СтрокаКоллекции.ТипНоменклатуры = 
				ТипыНоменклатуры[СтрокаКоллекции.НомерСтроки-1].ТипНоменклатуры;
		КонецЦикла;
		Кэш.Удалить("ТипыНоменклатуры");
	КонецЕсли;
	
КонецПроцедуры

Функция КолонкиТиповНоменклатуры() Экспорт
	Возврат ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("ТипНоменклатуры");
КонецФункции

Процедура КэшироватьЗначенияКолонок(КоллекцияДанных, Колонки, Кэш) Экспорт
	Колонки.Добавить("НомерСтроки");
	ЗначенияКолонок = КоллекцияДанных.Выгрузить(, СтрСоединить(Колонки, ","));
	Кэш.Вставить("ЗначенияКолонок", ЗначенияКолонок);
КонецПроцедуры

Процедура ВосстановитьЗначенияКолонок(КоллекцияДанных, Кэш) Экспорт
	
	ЗначенияКолонок = Неопределено;
	Если Кэш.Свойство("ЗначенияКолонок", ЗначенияКолонок) Тогда
		Для Каждого СтрокаКоллекции Из КоллекцияДанных Цикл
			ЗаполнитьЗначенияСвойств(СтрокаКоллекции, ЗначенияКолонок[СтрокаКоллекции.НомерСтроки-1],,"НомерСтроки");
		КонецЦикла;
		Кэш.Удалить("ЗначенияКолонок");
	КонецЕсли;
	
КонецПроцедуры

// Проверка заполнения колонок "Количество, Цена, Сумма, СтавкаНДС" при корректировке или исправлении корректировки.
//
// Параметры:
//  ПараметрыПроверки - Структура - параметры, используемые при выполнении проверки.
//     * Объект - ДокументОбъект - объект, для которого требуется проверить заполнение.
//     * ИмяТабличнойЧасти - Строка - имя табличной части, для которой выполняется проверка. Значение по умолчанию "Товары".
//     * МассивНепроверяемыхРеквизитов - Массив - реквизиты, которые не нужно проверять платформенной проверкой.
//  Отказ - Булево - признак отказа продолжения операции.
//
Процедура ПроверитьЗаполнениеЗначенийПриКорректировке(ПараметрыПроверки, Отказ) Экспорт
	
	ИмяТабличнойЧасти = Неопределено;
	Если НЕ (ПараметрыПроверки.Свойство("ИмяТабличнойЧасти") И ЗначениеЗаполнено(ИмяТабличнойЧасти)) Тогда
		ИмяТабличнойЧасти = "Товары";
	КонецЕсли;
	
	ПроверяемыеРеквизиты = Новый Массив;
	ПроверяемыеРеквизиты.Добавить("Сумма");
	ПроверяемыеРеквизиты.Добавить("СтавкаНДС");
	
	Объект = ПараметрыПроверки.Объект;
	
	ШаблонСообщения = НСтр("ru = 'Не заполнена колонка ""%1"" в строке %2 списка ""%3""'");
	МассивСтрок = Объект[ИмяТабличнойЧасти].НайтиСтроки(Новый Структура("КоличествоУпаковокДоКорректировки", 0));
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Для Каждого Реквизит Из ПроверяемыеРеквизиты Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы[Реквизит]) Тогда
				ТекстСообщения = СтрШаблон(ШаблонСообщения, Реквизит, СтрокаТаблицы.НомерСтроки, ИмяТабличнойЧасти);
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧасти, СтрокаТаблицы.НомерСтроки, Реквизит);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, Поле, "Объект", Отказ);
			КонецЕсли;
			ПараметрыПроверки.МассивНепроверяемыхРеквизитов.Добавить(ИмяТабличнойЧасти + "." + Реквизит);
		КонецЦикла;
	КонецЦикла;
	
	// При корректировке товар может вычеркиваться - в этом случае некоторые реквизиты могут не заполняться.
	ПараметрыПроверки.МассивНепроверяемыхРеквизитов.Добавить("Товары.Сумма");
	ПараметрыПроверки.МассивНепроверяемыхРеквизитов.Добавить("Товары.СтавкаНДС");
	
КонецПроцедуры

// Получает реквизиты номенклатуры и значение признака "ХарактеристикиИспользуются".
//
// Параметры:
//  СсылкаНаОбъект - СправочникСсылка.Номенклатура - объект, значения реквизитов которого необходимо получить.
//  Реквизиты - Строка - имена реквизитов, перечисленные через запятую.
//
// Возвращаемое значение:
//  Структура - содержит имена (ключи) и значения затребованных реквизитов.
//     Если используются характеристики, то дополнительно содержит
//     значение признака "ХарактеристикиИспользуются".
//
Функция РеквизитыНоменклатурыПриИзменении(СсылкаНаОбъект, Знач Реквизиты = "") Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Реквизиты,
	|	&ХарактеристикиИспользуются,
	|	ЕСТЬNULL(ВидыНоменклатуры.ТипНоменклатуры, ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПустаяСсылка)) КАК ТипНоменклатуры,
	|	ЛОЖЬ КАК ИспользоватьСерии
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|		ПО СпрНоменклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|		ПО СпрНоменклатура.Ссылка = ОписаниеНоменклатурыИС.Номенклатура
	|ГДЕ
	|	СпрНоменклатура.Ссылка = &Ссылка";
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры") Тогда
		ТекстХарактеристикиИспользуются = "ЕСТЬNULL(ВидыНоменклатуры.ИспользоватьХарактеристики, ЛОЖЬ) КАК ХарактеристикиИспользуются,";
	Иначе
		ТекстХарактеристикиИспользуются = "";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ХарактеристикиИспользуются,", ТекстХарактеристикиИспользуются);
	
	Если ЗначениеЗаполнено(Реквизиты) Тогда
		Результат = Новый Структура(Реквизиты);
		Реквизиты = СтрЗаменить(Реквизиты, " ", "");
		Если СтрНайти(Реквизиты, "ЗаполнитьПризнакТребуетВзвешивания") Тогда
			Реквизиты = СтрЗаменить(Реквизиты, ",ЗаполнитьПризнакТребуетВзвешивания", "");
			Результат.Вставить("ТребуетВзвешивания");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Реквизиты", "
			|	ЕСТЬNULL(ОписаниеНоменклатурыИС.КоличествоВПотребительскойУпаковке,1) = 0 КАК ТребуетВзвешивания," + "&Реквизиты");
		КонецЕсли;
		
		Если СтрНайти(Реквизиты, "ЗаполнитьПризнакПроизвольнаяЕдиницаУчета") Тогда
			Реквизиты = СтрЗаменить(Реквизиты, ",ЗаполнитьПризнакПроизвольнаяЕдиницаУчета", "");
			Результат.Вставить("ПроизвольнаяЕдиницаУчета");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Реквизиты", "
			|	ЕСТЬNULL(ОписаниеНоменклатурыИС.КоличествоВПотребительскойУпаковке,1) <> 1
			|		Или ЕСТЬNULL(ОписаниеНоменклатурыИС.ЕмкостьПотребительскойУпаковки,1) > 1 КАК ПроизвольнаяЕдиницаУчета," + "&Реквизиты");
		КонецЕсли;
		
		Если СтрНайти(Реквизиты, "ЗаполнитьВидПродукцииИС") Или СтрНайти(Реквизиты, "ЗаполнитьПризнакМаркируемаяПродукция") Тогда
			Реквизиты = СтрЗаменить(Реквизиты, ",ЗаполнитьВидПродукцииИС", "");
			Реквизиты = СтрЗаменить(Реквизиты, ",ЗаполнитьПризнакМаркируемаяПродукция", "");
			Результат.Вставить("ВидПродукцииИС");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Реквизиты", "ЕСТЬNULL(ОписаниеНоменклатурыИС.КлючВидовПродукции, ЗНАЧЕНИЕ(Справочник.КлючиВидовПродукцииИС.ПустаяСсылка)) КАК ВидПродукцииИС," + "&Реквизиты");
		КонецЕсли;
		
		Реквизиты = "СпрНоменклатура." + СтрЗаменить(Реквизиты, ",", ",СпрНоменклатура.");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Реквизиты", Реквизиты);
	Иначе
		Результат = Новый Структура;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Реквизиты,", "");
	КонецЕсли;
	
	Результат.Вставить("ХарактеристикиИспользуются", Ложь);
	Результат.Вставить("ИспользоватьСерии",          Ложь);
	Результат.Вставить("ТипНоменклатуры",            Перечисления.ТипыНоменклатуры.ПустаяСсылка());
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заполняет список выбора вариантов расчета НДС и устанавливает текущий вариант.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, в которой заполняется список выбора.
//  ИспользоватьОблагаетсяНДСУПокупателя - Булево - признак использования варианта "Облагается НДС у покупателя".
//
Процедура ЗаполнитьВариантыРасчетаНДС(Форма, ИспользоватьОблагаетсяНДСУПокупателя = Истина) Экспорт
	
	ГруппаВалютаВариантРасчетаНДС = Форма.Элементы.ГруппаВалютаВариантРасчетаНДС;
	ГруппаВалютаВариантРасчетаНДС.Заголовок = "";
	Если Не ЗначениеЗаполнено(ГруппаВалютаВариантРасчетаНДС.ПутьКДаннымЗаголовка) Тогда
		ГруппаВалютаВариантРасчетаНДС.ПутьКДаннымЗаголовка = "ЗаголовокГруппыВалютаВариантРасчетаНДС";
	КонецЕсли;
	
	СписокВариантовРасчета = Форма.Элементы.ВариантРасчетаНДС.СписокВыбора;
	СписокВариантовРасчета.Очистить();
	СписокВариантовРасчета.Добавить("НДСВСумме", НСтр("ru = 'В сумме'"));
	СписокВариантовРасчета.Добавить("НДССверху", НСтр("ru = 'Сверху'"));
	Если ИспользоватьОблагаетсяНДСУПокупателя Тогда
		СписокВариантовРасчета.Добавить("ОблагаетсяНДСУПокупателя", НСтр("ru = 'Облагается у покупателя'"));
	КонецЕсли;
	
	Если ИспользоватьОблагаетсяНДСУПокупателя
		И Форма.Объект.ОблагаетсяНДСУПокупателя Тогда
		Форма.ВариантРасчетаНДС = "ОблагаетсяНДСУПокупателя";
	ИначеЕсли Форма.Объект.ЦенаВключаетНДС Тогда
		Форма.ВариантРасчетаНДС = "НДСВСумме";
	Иначе
		Форма.ВариантРасчетаНДС = "НДССверху";
	КонецЕсли;
	
	КлиентЭДОКлиентСервер.УстановитьЗаголовокГруппыВалютаВариантыРасчетаНДС(Форма);
	
КонецПроцедуры

// Возвращает документы-основания по счету-фактуре для создания корректировки.
//
// Параметры:
//  СчетФактура - СправочникСсылка.СчетФактураВыданный - исправляемый документ счет-фактура.
//  ВидОперации - ПеречислениеСсылка.ВидыОпераций - операция корректировки счета-фактуры.
// 
// Возвращаемое значение:
//  Массив - параметры открытия формы объекта счета-фактуры.
//     * - ДокументСсылка.РеализацияТоваровУслуг - основание счета-фактуры.
//
Функция ОснованияСчетаФактурыВыданногоДляКорректировки(СчетФактура, ВидОперации) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураОснованиеДокументыОснования
		|		ПО РеализацияТоваровУслуг.ДокументОснование = СчетФактураОснованиеДокументыОснования.ДокументОснование
		|			И (СчетФактураОснованиеДокументыОснования.Ссылка = &СчетФактура)
		|			И (НЕ РеализацияТоваровУслуг.ПометкаУдаления)
		|			И (РеализацияТоваровУслуг.ВидОперации = &ВидОперации)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
		|		ПО РеализацияТоваровУслуг.Ссылка = СчетФактураВыданныйДокументыОснования.ДокументОснование
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|		ПО (СчетФактураВыданныйДокументыОснования.Ссылка = СчетФактураВыданный.Ссылка)
		|			И (НЕ СчетФактураВыданный.ПометкаУдаления)
		|ГДЕ
		|	СчетФактураВыданный.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СчетФактураВыданныйДокументыОснования.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
		|ГДЕ
		|	СчетФактураВыданныйДокументыОснования.Ссылка = &СчетФактура
		|	И НЕ СчетФактураВыданныйДокументыОснования.ДокументОснование.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	МассивДокументов = Новый Массив;
	
	Если Не РезультатыЗапроса[0].Пустой()
		ИЛИ РезультатыЗапроса[1].Пустой() Тогда
		Возврат МассивДокументов;
	КонецЕсли;
	
	Выборка = РезультатыЗапроса[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивДокументов.Добавить(Выборка.ДокументОснование);
	КонецЦикла;
	
	Возврат МассивДокументов;
	
КонецФункции

// Получает реквизиты организации для регистрации у оператора ЭДО.
// Параметры:
//  Организация - СправочникСсылка.Организации - организация, по которой необходимо получить данные для регистрации ЭДО.
//
// Возвращаемое значение:
//  Структура - содержит реквизиты организации:
//   * ЮрАдрес             - Строка - юридический адрес организации,
//   * ЗначениеПолейАдреса - Строка - содержит полные данные адреса в формате json.
//   * КодНалоговогоОргана - Строка - код ФНС, в котором зарегистрирована организация.
//
Функция ПолучитьРеквизитыОрганизацииДляРегистрационногоПакета(Знач Организация) Экспорт
	
	КодНалоговогоОргана = "";
	ЮрАдрес             = "";
	ЗначениеПолейАдреса = "";

	ДанныеОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "КПП, ОГРН");
	
	Если ДанныеОрганизации.Свойство("КПП") И ЗначениеЗаполнено(ДанныеОрганизации.КПП) Тогда
		КодНалоговогоОргана = Лев(ДанныеОрганизации.КПП, 4);
	КонецЕсли;
	
	КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация,
		Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации, ТекущаяДатаСеанса(), Ложь);
		
	НайденныеСтроки      = КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации));
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		ЮрАдрес             = НайденныеСтроки[0].Представление;
		ЗначениеПолейАдреса = НайденныеСтроки[0].Значение;
	КонецЕсли;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ЮрАдрес"             , ЮрАдрес);
	СтруктураДанных.Вставить("ЗначениеПолейАдреса" , ЗначениеПолейАдреса);
	СтруктураДанных.Вставить("КодНалоговогоОргана" , КодНалоговогоОргана);
	СтруктураДанных.Вставить("ОГРН"                , ДанныеОрганизации.ОГРН);
	
	Возврат СтруктураДанных;
	
КонецФункции

// См. ПоставляемыеДанныеАбонентовПереопределяемый.ОбработатьПолученныеДанныеОбласти.
//
Процедура ОбработатьПолученныеДанныеОбласти(ПотокДанных, Обработчик, ДанныеОбработаны, КодВозврата, ОписаниеОшибки) Экспорт
	
	ОбработатьПолученныеДанныеОбластиИзСервиса1СЭДО(ПотокДанных, Обработчик, ДанныеОбработаны, КодВозврата, ОписаниеОшибки);
	
КонецПроцедуры

// Получает содержимое константы НастройкиСтартовогоПомощникаКЭДО.
//
// Возвращаемое значение:
//  Структура    - возвращает значение, если константа заполнена, иначе Неопределено.
//  См. КлиентЭДОКлиентСервер.НоваяСтруктураНастроекПомощникаЭДО.
//
Функция ПолучитьНастройкиСтартовогоПомощникаКЭДО() Экспорт
	
	ХранилищеНастроекПомощника = Константы.НастройкиСтартовогоПомощникаКЭДО.Получить();
	
	Возврат ХранилищеНастроекПомощника.Получить();
	
КонецФункции

// Восстанавливает интерфейс начальной страницы, если был установлен стартовый помощник ЭДО.
//
// Возвращаемое значение:
//  Булево - признак восстановления системных настроек. Истина - настройки восстановлены.
//
Функция ВосстановитьСистемныеНастройки() Экспорт
	
	Форма = ФормаСтартовыйПомощникКЭДО();
	
	НачальнаяСтраницаНастройки = ХранилищеСистемныхНастроек.Загрузить("Общее/НастройкиНачальнойСтраницы", "");
	Если ФормаУстановленаНаНачальнойСтранице(НачальнаяСтраницаНастройки, Форма) Тогда

		НастройкиХранилища = ХранилищеСистемныхНастроек.Загрузить("НастройкиИнтерфейсаКлиентскогоПриложенияКЭДО", "");
		ХранилищеСистемныхНастроек.Сохранить("Общее/НастройкиИнтерфейсаКлиентскогоПриложения", "", НастройкиХранилища);
		
		НастройкиХранилища = ХранилищеСистемныхНастроек.Загрузить("НастройкиНачальнойСтраницыКЭДО", "");
		
		Если Не ФормаУстановленаНаНачальнойСтранице(НастройкиХранилища,
			ФормаОбменСКонтрагентамиТекущиеДелаПоЭДО()) Тогда
			НастройкиХранилища = Новый НастройкиНачальнойСтраницы;
			СоставФорм = Новый СоставФормНачальнойСтраницы;
			Если КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
				СоставФорм.ЛеваяКолонка.Добавить(ФормаНачальнаяСтраницаГосИС());
			Иначе
				СоставФорм.ЛеваяКолонка.Добавить(ФормаОбменСКонтрагентамиТекущиеДелаПоЭДО());
			КонецЕсли;
			НастройкиХранилища.УстановитьСоставФорм(СоставФорм);
		КонецЕсли;
		
		ХранилищеСистемныхНастроек.Сохранить("Общее/НастройкиНачальнойСтраницы", "", НастройкиХранилища);
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// См. ЭлектроннаяПодписьПереопределяемый.ПриЗаполненииРеквизитовВладельцаВЗаявленииНаСертификат.
Процедура ПриЗаполненииРеквизитовВладельцаВЗаявленииНаСертификат(Параметры) Экспорт
	
	Параметры.ТипВладельца = Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица");
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.Организация, "ЮрФизЛицо,Руководитель,ГлавныйБухгалтер");
	
	Если РеквизитыОрганизации.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		Если Не ЗначениеЗаполнено(Параметры.Сотрудник) Тогда
			Параметры.Сотрудник = РеквизитыОрганизации.Руководитель;
		КонецЕсли;
	Иначе
		Параметры.Директор = РеквизитыОрганизации.Руководитель;
		Параметры.ГлавныйБухгалтер = РеквизитыОрганизации.ГлавныйБухгалтер;
	КонецЕсли;
	
	ТекущийВладелец = Неопределено;
	
	Если ЗначениеЗаполнено(Параметры.Сотрудник) Тогда
		ТекущийВладелец = Параметры.Сотрудник;
		ОснованиеПолномочийФизлица = ОснованияПолномочийФизическихЛиц(Параметры.Организация, Параметры.Сотрудник).Получить(Параметры.Сотрудник);
		Параметры.Должность = ОснованиеПолномочийФизлица.Должность;
	ИначеЕсли ЗначениеЗаполнено(Параметры.Директор) Тогда
		ТекущийВладелец = Параметры.Директор;
		Параметры.Сотрудник = Параметры.Директор;
		ОснованиеПолномочийФизлица = ОснованияПолномочийФизическихЛиц(Параметры.Организация, Параметры.Директор).Получить(Параметры.Директор);
		Параметры.Должность = ОснованиеПолномочийФизлица.Должность;
	ИначеЕсли ЗначениеЗаполнено(Параметры.ГлавныйБухгалтер) Тогда
		ТекущийВладелец = Параметры.ГлавныйБухгалтер;
		Параметры.Сотрудник = Параметры.ГлавныйБухгалтер;
		ОснованиеПолномочийФизлица = ОснованияПолномочийФизическихЛиц(Параметры.Организация, Параметры.ГлавныйБухгалтер).Получить(Параметры.ГлавныйБухгалтер);
		Параметры.Должность = ОснованиеПолномочийФизлица.Должность;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущийВладелец) Тогда
		Возврат; // Поля можно заполнить только, если сотрудник указан.
	КонецЕсли;
	
	ДанныеФизическогоЛица = ДанныеФизическогоЛица(ТекущийВладелец);
	
	Параметры.Фамилия = ДанныеФизическогоЛица.Фамилия;
	Параметры.Имя = ДанныеФизическогоЛица.Имя;
	Параметры.Отчество = ДанныеФизическогоЛица.Отчество;
	
	Параметры.ДатаРождения  = ДанныеФизическогоЛица.ДатаРождения;
	Параметры.Пол = ?(ДанныеФизическогоЛица.Пол = Перечисления.ПолФизическогоЛица.Женский, "Женский", "Мужской");
	Параметры.МестоРождения = ДанныеФизическогоЛица.МестоРождения;
	Параметры.Гражданство = ДанныеФизическогоЛица.Гражданство;
	
	Параметры.СтраховойНомерПФР = ДанныеФизическогоЛица.СтраховойНомерПФР;
	Если ЗначениеЗаполнено(ДанныеФизическогоЛица.ВидДокумента) Тогда
		Параметры.ДокументВид = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеФизическогоЛица.ВидДокумента, "КодМВД");
	КонецЕсли;
	Параметры.ДокументНомер = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '%1 %2'"), ДанныеФизическогоЛица.Серия, ДанныеФизическогоЛица.Номер);
		
	Параметры.ДокументКемВыдан = ДанныеФизическогоЛица.КемВыдан;
	Параметры.ДокументДатаВыдачи = ДанныеФизическогоЛица.ДатаВыдачи;
	Параметры.ДокументКодПодразделения = ДанныеФизическогоЛица.КодПодразделения;
	
	АдресаЭлектроннойПочты = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		ТекущийВладелец, Справочники.ВидыКонтактнойИнформации.EMailФизлица, , Ложь);
	
	Если ЗначениеЗаполнено(АдресаЭлектроннойПочты) Тогда
		АдресЭлектроннойПочты = АдресаЭлектроннойПочты[0];
		Параметры.ЭлектроннаяПочта = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияВXML(
			АдресЭлектроннойПочты.Значение, АдресЭлектроннойПочты.Представление);
	КонецЕсли;
	
	Параметры.ИНН = ДанныеФизическогоЛица.ИНН;
	
	Если Не Параметры.ЭтоФизическоеЛицо Тогда
		Возврат;
	КонецЕсли;
	
	ВидАдреса = УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени("АдресПоПропискеФизлица");
	ВидТелефона = УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени("ТелефонРабочийФизлица");
	
	ВидыКонтактнойИнформации = Новый Массив;
	ВидыКонтактнойИнформации.Добавить(ВидАдреса);
	ВидыКонтактнойИнформации.Добавить(ВидТелефона);
	
	Объекты = Новый Массив;
	Объекты.Добавить(Параметры.Сотрудник);
	
	КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(
		Объекты, , ВидыКонтактнойИнформации);
	
	НайденнаяИнформация = КонтактнаяИнформация.Найти(ВидАдреса, "Вид");
	Если НайденнаяИнформация <> Неопределено Тогда
		Параметры.АдресРегистрации = НайденнаяИнформация.Значение;
	КонецЕсли;
	
	НайденнаяИнформация = КонтактнаяИнформация.Найти(ВидТелефона, "Вид");
	Если НайденнаяИнформация <> Неопределено Тогда
		Параметры.Телефон = НайденнаяИнформация.Значение;
	КонецЕсли;
	
КонецПроцедуры

// См. ЭлектроннаяПодписьПереопределяемый.ПриЗаполненииРеквизитовРуководителяВЗаявленииНаСертификат.
Процедура ПриЗаполненииРеквизитовРуководителяВЗаявленииНаСертификат(Параметры) Экспорт
	
	Параметры.ТипРуководителя = Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица");
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.Организация, "Руководитель");
	
	Если Не ЗначениеЗаполнено(Параметры.Руководитель) Тогда
		Параметры.Руководитель = РеквизитыОрганизации.Руководитель;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Параметры.Руководитель) Тогда
		Возврат; // Поля можно заполнить только, если руководитель указан.
	КонецЕсли;
	
	ОснованиеПолномочийФизлица = ОснованияПолномочийФизическихЛиц(Параметры.Организация, Параметры.Руководитель).Получить(Параметры.Руководитель);
	Параметры.Должность = ОснованиеПолномочийФизлица.Должность;
	Параметры.Основание = ОснованиеПолномочийФизлица.ОснованиеПолномочий;
	
КонецПроцедуры

// См. ЭлектроннаяПодписьПереопределяемый.ПриЗаполненииРеквизитовПартнераВЗаявленииНаСертификат.
Процедура ПриЗаполненииРеквизитовПартнераВЗаявленииНаСертификат(Параметры) Экспорт
	
	Параметры.ТипПартнера = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
	
	Если Не ЗначениеЗаполнено(Параметры.Партнер) Тогда
		Возврат; // Поля можно заполнить только, если партнер указан.
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.Партнер, "ИНН, КПП, ЮрФизЛицо");
	
	Параметры.ЭтоИндивидуальныйПредприниматель =
		(Реквизиты.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель);
		
	Параметры.ИНН = Реквизиты.ИНН;
	Параметры.КПП = Реквизиты.КПП;
	
КонецПроцедуры

// См. СервисМобильнойПодписиПереопределяемый.ПриЗаполненииРеквизитовФизическогоЛица
Процедура ПриЗаполненииРеквизитовФизическогоЛица(РеквизитыФизическогоЛица) Экспорт

	ДанныеФизическогоЛица = ДанныеФизическогоЛица(РеквизитыФизическогоЛица.ФизическоеЛицо);
	ЗаполнитьЗначенияСвойств(РеквизитыФизическогоЛица, ДанныеФизическогоЛица);
	
	РеквизитыФизическогоЛица.ИННФЛ = ДанныеФизическогоЛица.ИНН;
	
	ВидТелефона = УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени("ТелефонРабочийФизлица");
	
	НомерТелефона = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		РеквизитыФизическогоЛица.ФизическоеЛицо,
		ВидТелефона);
	
	РеквизитыФизическогоЛица.Телефон = НомерТелефона;

КонецПроцедуры

// Пересчитывает стоимость товаров в новую валюту.
// 
// Параметры:
//  Товары - ДанныеФормыКоллекция
//  ИсходнаяВалюта - СправочникСсылка.Валюты
//  НоваяВалюта - СправочникСсылка.Валюты
//  Дата - Дата
//  ЦенаВключаетНДС - Булево
//  ПересчитыватьСкидки - Булево
//
Процедура ПересчитатьСтоимостьТоваровВВалюту(Товары, ИсходнаяВалюта, НоваяВалюта, Дата, ЦенаВключаетНДС, ПересчитыватьСкидки = Ложь) Экспорт
	
	КурсИсходнойВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ИсходнаяВалюта, Дата);
	КурсНовойВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(НоваяВалюта, Дата);
	
	ПересчитатьСтоимостьТоваровВВалютуПоКурсу(Товары, КурсИсходнойВалюты, КурсНовойВалюты, ЦенаВключаетНДС,
		ПересчитыватьСкидки);
	
КонецПроцедуры

// Пересчитывает стоимость товаров в новую валюту по курсу.
// 
// Параметры:
//  Товары - ДанныеФормыКоллекция
//  КурсИсходнойВалюты - См. РаботаСКурсамиВалют.ПолучитьКурсВалюты
//  КурсНовойВалюты - См. РаботаСКурсамиВалют.ПолучитьКурсВалюты
//  ЦенаВключаетНДС - Булево
//  ПересчитыватьСкидки - Булево
//
Процедура ПересчитатьСтоимостьТоваровВВалютуПоКурсу(Товары, КурсИсходнойВалюты, КурсНовойВалюты, ЦенаВключаетНДС, ПересчитыватьСкидки = Ложь) Экспорт
	
	ИменаПолей = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("Цена");
	Если ПересчитыватьСкидки Тогда
		ИменаПолей.Добавить("СуммаСкидки");
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Товары Цикл
		
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			СтрокаТаблицы[ИмяПоля] = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
				СтрокаТаблицы[ИмяПоля], КурсИсходнойВалюты, КурсНовойВалюты);
		КонецЦикла;
		
		КлиентЭДОКлиентСервер.ПриИзмененииКоличествоЦена(СтрокаТаблицы, ЦенаВключаетНДС);
		
	КонецЦикла;
	
КонецПроцедуры

// См. СервисЭДОСобытия.ПриФормированииРегистрационнойИнформации
Процедура ПриФормированииРегистрационнойИнформации(РеквизитыПакета) Экспорт
	
	Если БазаСозданаЧерезOnboarding() Тогда
		РеквизитыПакета.Вставить("ПодключенПоOnboarding", Истина);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает настройки рабочей области начальной страницы текущего пользователя.
// 
// Возвращаемое значение:
//  Неопределено,НастройкиНачальнойСтраницы
Функция НастройкиНачальнойСтраницы() Экспорт
	
	КлючНастроек = КлючНастройкиРабочейОбластиНачальнойСтраницы();
	Возврат ХранилищеСистемныхНастроек.Загрузить(КлючНастроек);
	 
КонецФункции

// Сохраняет настройки начальной страницы в системном хранилище для текущего пользователя.
// 
// Параметры:
//  Настройки - НастройкиНачальнойСтраницы
Процедура СохранитьНастройкиНачальнойСтраницы(Настройки) Экспорт
	
	КлючНастроек = КлючНастройкиРабочейОбластиНачальнойСтраницы();
	ХранилищеСистемныхНастроек.Сохранить(КлючНастроек, "", Настройки);
	
КонецПроцедуры

#Если Не ВнешнееСоединение Тогда
	
// Устанавливает видимость элемента Организация по переданному имени в форме в зависимости от настройки
// использования нескольких организаций.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения 
//  ИмяЭлементаФормы - Строка
Процедура НастроитьВидимостьОрганизацииВФорме(Форма, ИмяЭлементаФормы) Экспорт
	
	ОрганизацияВидна = Справочники.Организации.ИспользуетсяНесколькоОрганизаций();
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, ИмяЭлементаФормы,
		"Видимость", ОрганизацияВидна);
		
КонецПроцедуры

#КонецЕсли // ВнешнееСоединение

#Область ЭтапыГрафикаОплат

Процедура ПередЗаписьюНаСервереГрафикаОплат(Форма, Объект, ПланируемаяДатаПоставки) Экспорт
	
	Если Не Форма.ИспользуетсяМногоэтапныйГрафикОплаты Тогда
		КлиентЭДОКлиентСервер.ПеренестиГрафикОплатИзРеквизитовФормыВТаблицу(
			Форма, Объект, ПланируемаяДатаПоставки);
			
		Объект.ДополнительныеСвойства.Вставить("ТребуетсяПеречитатьГрафикОплат", Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЧтенииНаСервереГрафикаОплат(Форма, ПланируемаяДатаПоставки) Экспорт
	
	ОпределитьВариантУказанияГрафикаОплат(Форма);
	УстановитьОформлениеЭтаповГрафикаОплат(Форма);
		
	Если Не Форма.ИспользуетсяМногоэтапныйГрафикОплаты Тогда
		КлиентЭДОКлиентСервер.ПрочитатьГрафикОплатИзТаблицыВРеквизитыФорма(Форма, ПланируемаяДатаПоставки);
	КонецЕсли;
	
	КлиентЭДОКлиентСервер.РассчитатьИтогиГрафикаОплат(Форма);
	
КонецПроцедуры

Процедура УстановитьУсловноеОформлениеГрафикаОплат(Форма) Экспорт
	
	УсловноеОформление = Форма.УсловноеОформление;
	Элементы = Форма.Элементы;
	
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ЭтапыГрафикаОплатыСдвиг.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ЭтапыГрафикаОплаты.ВариантОплаты");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = ПредопределенноеЗначение("Перечисление.ВариантыОплатыПоГрафику.ОтсрочкаПлатежа");

	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ПредоплатаСуммаПлатежа.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ОтсрочкаСуммаПлатежа.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроцентПлатежейОбщий");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = 100;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.FireBrick);


КонецПроцедуры

Процедура ПослеЗаписиНаСервереГрафикаОплат(Форма, Объект, ПланируемаяДатаПоставки) Экспорт

	Если Объект.ДополнительныеСвойства.Свойство("ТребуетсяПеречитатьГрафикОплат") Тогда
		ПриЧтенииНаСервереГрафикаОплат(Форма, ПланируемаяДатаПоставки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьГрафикОплатПередЗаписью(Объект, Знач ПланируемаяДатаПоставки, Знач СуммаДокумента) Экспорт
	
	Если Объект.ЭтапыГрафикаОплаты.Количество() = 0 Тогда
		ДобавитьЭтапОплатыПоУмолчанию(
			Объект, ПланируемаяДатаПоставки, СуммаДокумента);
	Иначе
		РаспределитьСуммуПоЭтапамГрафикаОплаты(
			Объект.ЭтапыГрафикаОплаты,
			СуммаДокумента);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

// Возвращает сведения для пересчета единиц измерения ВЕТИС.
//
// Параметры:
//   ДанныеСтрокВЕТИС - Массив Из Структура - элементы массива должны содержать свойства Номенклатура и ЕдиницаИзмеренияВЕТИС.
//
// Возвращаемое значение:
//  Соответствие Из Справочникссылка.Номенклатура - ключ ссылка на номенклатуру, значение соответствие единица измерения ВЕТИС и структура:
//   * КодОшибки - Число  - Код ошибки получения коэффициента:
//        0 - Нет ошибок;
//        1 - Не заполнена единица измерения в справочнике 'ЕдиницыИзмеренияВЕТИС';
//        2 - В справочнике 'Номенклатура' выключена возможность пересчета количества в соответствующую мерную единицу измерения;
//        3 - Не удалось сопоставить единицу хранения справочника 'Номенклатура' с единицей измерения справочника 'ЕдиницыИзмеренияВЕТИС'.
//   * Коэффициент                   - Число  - Коэффициент пересчета единицы измерения ВЕТИС.
//   * ТипИзмеряемойВеличины         - ПеречислениеСсылка.ТипыИзмеряемыхВеличин - Тип измеряемой величины единицы измерения
//       справочника 'ЕдиницыИзмеренияВЕТИС'.
//   * НужноОкруглятьКоличество      - Булево - Признак необходимости округления количества при пересчете.
//   * НужноОкруглятьКоличествоВЕТИС - Булево - Признак необходимости округления количества ВетИС при пересчете.
Функция КоэффициентыЕдиницИзмеренияПоВЕТИС(ДанныеСтрокВЕТИС) Экспорт
	
	Если ДанныеСтрокВЕТИС.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	
	ШаблонРезультата = Новый Структура;
	ШаблонРезультата.Вставить("КодОшибки",                     0);
	ШаблонРезультата.Вставить("Коэффициент",                   1);
	ШаблонРезультата.Вставить("ТипИзмеряемойВеличины",         Неопределено);
	ШаблонРезультата.Вставить("НужноОкруглятьКоличество",      Ложь);
	ШаблонРезультата.Вставить("НужноОкруглятьКоличествоВЕТИС", Ложь);
	
	ДанныеУпаковокТаблица = Новый ТаблицаЗначений;
	ДанныеУпаковокТаблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ДанныеУпаковокТаблица.Колонки.Добавить("ЕдиницаИзмеренияВЕТИС", Новый ОписаниеТипов("СправочникСсылка.ЕдиницыИзмеренияВЕТИС"));
	Для каждого СтрокаИсточника Из ДанныеСтрокВЕТИС Цикл
		НоваяСтрока = ДанныеУпаковокТаблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточника);
	КонецЦикла;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДанныеЕдиницИзмеренияВЕТИС.Номенклатура,
	|	ДанныеЕдиницИзмеренияВЕТИС.ЕдиницаИзмеренияВЕТИС
	|ПОМЕСТИТЬ ДанныеЕдиницИзмеренияВЕТИС
	|ИЗ
	|	&ДанныеЕдиницИзмеренияВЕТИС КАК ДанныеЕдиницИзмеренияВЕТИС
	|ИНДЕКСИРОВАТЬ ПО
	|	ЕдиницаИзмеренияВЕТИС
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеЕдиницИзмеренияВЕТИС.Номенклатура,
	|	ДанныеЕдиницИзмеренияВЕТИС.ЕдиницаИзмеренияВЕТИС,
	|	ЕСТЬNULL(ЕдиницыИзмеренияВЕТИС.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)) КАК
	|		Упаковка,
	|	ЕСТЬNULL(ЕдиницыИзмеренияВЕТИС.БазоваяЕдиницаИзмерения.ЕдиницаИзмерения, НЕОПРЕДЕЛЕНО) КАК Базовая,
	|	ЕСТЬNULL(ЕдиницыИзмеренияВЕТИС.Коэффициент, 1) КАК КоэффициентВЕТИС
	|ПОМЕСТИТЬ ДанныеУпаковок
	|ИЗ
	|	ДанныеЕдиницИзмеренияВЕТИС КАК ДанныеЕдиницИзмеренияВЕТИС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмеренияВЕТИС КАК ЕдиницыИзмеренияВЕТИС
	|		ПО ЕдиницыИзмеренияВЕТИС.Ссылка = ДанныеЕдиницИзмеренияВЕТИС.ЕдиницаИзмеренияВЕТИС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеУпаковок.Номенклатура КАК Номенклатура,
	|	ДанныеУпаковок.Упаковка КАК Упаковка,
	|	ДанныеУпаковок.ЕдиницаИзмеренияВЕТИС КАК ЕдиницаИзмеренияВЕТИС,
	|	ВЫБОР
	|		КОГДА ДанныеУпаковок.ЕдиницаИзмеренияВЕТИС = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмеренияВЕТИС.ПустаяСсылка)
	|			ТОГДА 1
	|		КОГДА ДанныеУпаковок.Упаковка = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА 1
	|		КОГДА ДанныеУпаковок.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки, 1)
	|		КОГДА ДанныеУпаковок.Упаковка.ТипИзмеряемойВеличины <> ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.КоличествоШтук)
	|			ТОГДА ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки, 0)
	|		КОГДА ДанныеУпаковок.Упаковка = Номенклатура.ЕдиницаИзмерения
	|			ТОГДА 1
	|		КОГДА ДанныеУпаковок.Базовая = Номенклатура.ЕдиницаИзмерения
	|			ТОГДА ДанныеУпаковок.КоэффициентВЕТИС
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Коэффициент,
	|	ВЫБОР
	|		КОГДА ДанныеУпаковок.ЕдиницаИзмеренияВЕТИС = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмеренияВЕТИС.ПустаяСсылка)
	|			ТОГДА Неопределено
	|		КОГДА ДанныеУпаковок.Упаковка = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА -1
	|		ИНАЧЕ ДанныеУпаковок.Упаковка.ТипИзмеряемойВеличины
	|	КОНЕЦ КАК ТипИзмеряемойВеличиныДляПроверки,
	|	ВЫБОР
	|		КОГДА ДанныеУпаковок.ЕдиницаИзмеренияВЕТИС = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмеренияВЕТИС.ПустаяСсылка)
	|			ТОГДА Неопределено
	|		КОГДА ДанныеУпаковок.Упаковка = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА Неопределено
	|		КОГДА ДанныеУпаковок.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА Неопределено
	|		ИНАЧЕ ЕСТЬNULL(ЕдиницыХранения.ТипИзмеряемойВеличины, НЕОПРЕДЕЛЕНО)
	|	КОНЕЦ КАК ТипИзмеряемойВеличиныНоменклатуры
	|ИЗ
	|	ДанныеУпаковок КАК ДанныеУпаковок
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыХранения
	|		ПО Номенклатура.ЕдиницаИзмерения = ЕдиницыХранения.Ссылка";

	ИсточникНоменклатуры = "Номенклатура";
	ИсточникУпаковки     = "Упаковка";
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&ТекстЗапросаКоэффициентУпаковки",
		Справочники.ЕдиницыИзмерения.ТекстЗапросаКоэффициентУпаковки(ИсточникУпаковки, ИсточникНоменклатуры));

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДанныеЕдиницИзмеренияВЕТИС", ДанныеУпаковокТаблица);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	МерныеТипыЕдиницИзмерений = Справочники.ЕдиницыИзмерения.МерныеТипыЕдиницИзмерений();
	
	КоэффициентыУпаковокНоменклатуры = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		ПолеСоответствияНоменклатуры = КоэффициентыУпаковокНоменклатуры.Получить(Выборка.Номенклатура);
		Если ПолеСоответствияНоменклатуры = Неопределено Тогда
			ПолеСоответствияНоменклатуры = Новый Соответствие;
		КонецЕсли;
		
		Результат = ОбщегоНазначения.СкопироватьРекурсивно(ШаблонРезультата);
		
		Если Выборка.ТипИзмеряемойВеличиныДляПроверки = -1 Тогда
			Результат.КодОшибки = 1;
		ИначеЕсли НЕ ЗначениеЗаполнено(Выборка.ЕдиницаИзмеренияВЕТИС) Тогда
		Иначе
			Результат.НужноОкруглятьКоличество = ЗначениеЗаполнено(Выборка.Номенклатура)
				И Выборка.ТипИзмеряемойВеличиныНоменклатуры = Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук
				И МерныеТипыЕдиницИзмерений.Найти(Выборка.ТипИзмеряемойВеличиныДляПроверки) <> Неопределено;
			Результат.НужноОкруглятьКоличествоВЕТИС = ЗначениеЗаполнено(Выборка.Номенклатура)
				И Выборка.ТипИзмеряемойВеличиныДляПроверки = Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук
				И МерныеТипыЕдиницИзмерений.Найти(Выборка.ТипИзмеряемойВеличиныНоменклатуры) <> Неопределено;
			Если Выборка.Коэффициент = 0 Тогда
				Результат.Коэффициент = 1;
				Если МерныеТипыЕдиницИзмерений.Найти(Выборка.ТипИзмеряемойВеличиныДляПроверки) <> Неопределено Тогда
					Результат.КодОшибки = 2;
					Результат.ТипИзмеряемойВеличины = Выборка.ТипИзмеряемойВеличиныДляПроверки;
				Иначе
					Результат.КодОшибки = 3;
				КонецЕсли;
			Иначе
				Результат.Коэффициент = Выборка.Коэффициент;
			КонецЕсли;
		КонецЕсли;
		
		ПолеСоответствияНоменклатуры.Вставить(Выборка.ЕдиницаИзмеренияВЕТИС, Результат);
		КоэффициентыУпаковокНоменклатуры.Вставить(Выборка.Номенклатура, ПолеСоответствияНоменклатуры);
		
	КонецЦикла;
	
	Возврат КоэффициентыУпаковокНоменклатуры;
	
КонецФункции

// Параметры:
//  ДополнительноеСостояние - См. ЛегкийИнтерфейсДокументовЭДОСлужебный.ПриЗаполненииДополнительногоСостоянияДанныхКомпонентаПанельСостоянияЛегкийКлиентЭДО.ДополнительноеСостояние
//  СвойстваДокумента - См. ЛегкийИнтерфейсДокументовЭДОСлужебный.ПриЗаполненииДополнительногоСостоянияДанныхКомпонентаПанельСостоянияЛегкийКлиентЭДО.СвойстваДокумента
Процедура ПриЗаполненииДополнительногоСостоянияДанныхКомпонентаПанельСостоянияЛегкийКлиентЭДО(ДополнительноеСостояние,
	СвойстваДокумента) Экспорт

	Если Не КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		Возврат;
	КонецЕсли;
	
	Если ИнтерфейсДокументовЭДО.ЭтоВходящийЭДО(СвойстваДокумента.Ссылка)
		Или ИнтеграцияИСМП.ЭтоИсходящийЭлектронныйДокумент(СвойстваДокумента.Ссылка) Тогда
		
		ДанныеСостояния = СоответствиеТребованиямГИСМТ.СостояниеКомандыСоответствиеТребованиямГИСМТ(СвойстваДокумента.Ссылка);
		
		Если ДанныеСостояния.Статус = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ДополнительноеСостояние = ОбменСКонтрагентами.НовоеДополнительноеСостояние();
		НовыйЭлемент = ДополнительноеСостояние.ЭлементыДополнительногоСостояния.Добавить();
		НовыйЭлемент.Представление = ДанныеСостояния.Заголовок;
		НовыйЭлемент.Идентификатор = "СоответствиеТребованиямГИСМТГосИС";
		НовыйЭлемент.Обработчик    = "КлиентЭДОКлиент.ОбработчикГиперссылкиПанелиДополнительногоСостоянияЛекгийКлиентЭДО";
		НовыйЭлемент.Значение      = НовыйЭлемент.Идентификатор;
		
		ДополнительноеСостояние.ЦветПанелиСостояния = ИнтерфейсКлиентЭДО.ЦветПанелиПоСостояниюПроверкиГИСМП(ДанныеСостояния);
		
	КонецЕсли;
	
КонецПроцедуры

#Область УстаревшиеПроцедурыИФункции

// См. УправлениеПечатьюПереопределяемый.ПриОпределенииОбъектовСКомандамиПечати.
Процедура ПриОпределенииОбъектовСКомандамиПечати(СписокОбъектов) Экспорт
	
	// ЭлектронноеВзаимодействие.КоммерческиеПредложения
	Если ОбщегоНазначения.ПодсистемаСуществует("ЭлектронноеВзаимодействие.КоммерческиеПредложения.КоммерческиеПредложенияДокументы.ЗапросКоммерческихПредложенийПоставщиков") Тогда
		МенеджерДокумента = ОбщегоНазначения.ОбщийМодуль("Документы.ЗапросКоммерческихПредложенийПоставщиков");
		СписокОбъектов.Добавить(МенеджерДокумента);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.КоммерческиеПредложения
	
	// ЭлектронноеВзаимодействие.КоммерческиеПредложения
	Если ОбщегоНазначения.ПодсистемаСуществует("ЭлектронноеВзаимодействие.КоммерческиеПредложения.КоммерческиеПредложенияДокументы.ЗапросКоммерческогоПредложенияОтКлиента") Тогда
		МенеджерДокумента = ОбщегоНазначения.ОбщийМодуль("Документы.ЗапросКоммерческогоПредложенияОтКлиента");
		СписокОбъектов.Добавить(МенеджерДокумента);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.КоммерческиеПредложения
	
	// ЭлектронноеВзаимодействие.КоммерческиеПредложения
	Если ОбщегоНазначения.ПодсистемаСуществует("ЭлектронноеВзаимодействие.КоммерческиеПредложения.КоммерческиеПредложенияДокументы.КоммерческоеПредложениеКлиенту") Тогда
		МенеджерДокумента = ОбщегоНазначения.ОбщийМодуль("Документы.КоммерческоеПредложениеКлиенту");
		СписокОбъектов.Добавить(МенеджерДокумента);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.КоммерческиеПредложения
	
	// ЭлектронноеВзаимодействие.КоммерческиеПредложения
	Если ОбщегоНазначения.ПодсистемаСуществует("ЭлектронноеВзаимодействие.КоммерческиеПредложения.КоммерческиеПредложенияДокументы.КоммерческоеПредложениеПоставщика") Тогда
		МенеджерДокумента = ОбщегоНазначения.ОбщийМодуль("Документы.КоммерческоеПредложениеПоставщика");
		СписокОбъектов.Добавить(МенеджерДокумента);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.КоммерческиеПредложения
	
	// ГосИС
	ИнтеграцияИС.ПриОпределенииОбъектовСКомандамиПечати(СписокОбъектов);
	// Конец ГосИС
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Заполняет представление указанных в документе кодов маркировки в колонке "Маркируемые упаковки" табличной части.
//
// Параметры:
//  ВладелецКоллекции - ДанныеФормыСтруктура
//  ИмяКоллекции      - Строка - имя табличной части, в которой заполняется реквизит "МаркируемыеУпаковки".
//     Таблица должна содержать колонки: "ИдентификаторСтроки, МаркируемыеУпаковки".
//
Процедура ЗаполнитьРеквизитыМаркировкиАктаОРасхождении(ВладелецКоллекции, ИмяКоллекции = "Товары") Экспорт
	
	Если Не ВладелецКоллекции.Свойство(ИмяКоллекции) Тогда
		Возврат;
	КонецЕсли;
	
	КоллекцияДанных = ВладелецКоллекции[ИмяКоллекции];
	ИменаТаблиц = КлиентЭДОКлиентСервер.ИменаТаблицМаркировкиАктаОРасхождениях();
	
	Для Каждого СтрокаКоллекции Из КоллекцияДанных Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаКоллекции.ИдентификаторСтроки) Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыОтбораУпаковок = Новый Структура("ИдентификаторСтроки", СтрокаКоллекции.ИдентификаторСтроки);
		ВсеКодыМаркировки = Новый Массив;// Массив из Строка
		
		Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
			Если Не СтрокаКоллекции.Свойство(ИмяТаблицы) И Не ВладелецКоллекции.Свойство(ИмяТаблицы) Тогда
				Продолжить;
			КонецЕсли;
			КодыМаркировки = ВладелецКоллекции[ИмяТаблицы].Выгрузить(
				ПараметрыОтбораУпаковок, "НомерУпаковки").ВыгрузитьКолонку("НомерУпаковки");
			Если ЗначениеЗаполнено(КодыМаркировки) Тогда
				ВсеКодыМаркировки.Добавить(КлиентЭДОКлиентСервер.ПредставлениеКодовМаркировки(КодыМаркировки));
			КонецЕсли;
			СтрокаКоллекции[ИмяТаблицы].ЗагрузитьЗначения(КодыМаркировки);
		КонецЦикла;
		
		СтрокаКоллекции.МаркируемыеУпаковки = КлиентЭДОКлиентСервер.ПредставлениеКодовМаркировки(ВсеКодыМаркировки);
		
	КонецЦикла;
	
КонецПроцедуры

// Запускает фоновое задание, см. КлиентЭДО.СозданиеЭлектронныхДокументовФоновоеЗадание
//
Процедура СозданиеЭлектронныхДокументов() Экспорт
	
	ФоновыеЗадания.Выполнить("КлиентЭДО.СозданиеЭлектронныхДокументовФоновоеЗадание",,,
		НСтр("ru = 'Создание электронных документов'"));
	
КонецПроцедуры

// Возвращаемое значение:
//  ТаблицаЗначений:
// * Имя - Строка
// * Заголовок - Строка
// * Обработчик - Строка
Функция НовоеОписаниеКомандВводаНаОсновании() Экспорт
	ОписаниеКоманд = Новый ТаблицаЗначений;
	ОписаниеКоманд.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	ОписаниеКоманд.Колонки.Добавить("Заголовок", Новый ОписаниеТипов("Строка"));
	ОписаниеКоманд.Колонки.Добавить("Обработчик", Новый ОписаниеТипов("Строка"));
	Возврат ОписаниеКоманд;
КонецФункции

