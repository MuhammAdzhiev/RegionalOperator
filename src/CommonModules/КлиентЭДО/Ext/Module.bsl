Процедура ЗаполнитьПредставленияРНПТ(Товары, СведенияПрослеживаемости) Экспорт
	
	Если Не ЗначениеЗаполнено(Товары)
		ИЛИ Не ЗначениеЗаполнено(СведенияПрослеживаемости) Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("ИдентификаторСтроки", "");
	Для Каждого СтрокаТаблицы Из Товары Цикл
		Отбор.ИдентификаторСтроки = СтрокаТаблицы.ИдентификаторСтроки;
		НаборСведенийПоОтбору = СведенияПрослеживаемости.НайтиСтроки(Отбор);
		Если ЗначениеЗаполнено(НаборСведенийПоОтбору) Тогда
			СтрокаТаблицы.РНПТ = КлиентЭДОКлиентСервер.ПредставлениеРНПТ(НаборСведенийПоОтбору);
		Иначе
			СтрокаТаблицы.РНПТ = "";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция КолонкиРНПТ() Экспорт
	Возврат ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("РНПТ");
КонецФункции

Процедура ПроверитьЗаполнениеСведенийПрослеживаемости(ПараметрыПроверки, Отказ) Экспорт
	
	ИмяТабличнойЧасти = Неопределено;
	Если НЕ (ПараметрыПроверки.Свойство("ИмяТабличнойЧасти") И ЗначениеЗаполнено(ИмяТабличнойЧасти)) Тогда
		ИмяТабличнойЧасти = "Товары";
	КонецЕсли;
	
	Объект = ПараметрыПроверки.Объект;
	Товары = Объект[ИмяТабличнойЧасти];
	СведенияПрослеживаемости = Объект.СведенияПрослеживаемости;
	
	Если Не ЗначениеЗаполнено(СведенияПрослеживаемости)
		Или Не ЗначениеЗаполнено(Товары) Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоПоТовару = Новый Соответствие();
	
	Для Каждого СтрокаСведений Из СведенияПрослеживаемости Цикл
		
		Количество = КоличествоПоТовару[СтрокаСведений.ИдентификаторСтроки];
		Если Количество = Неопределено Тогда
			Количество = 0;
		КонецЕсли;
		
		Количество = Количество + СтрокаСведений.КоличествоУпаковок;
		
		КоличествоПоТовару.Вставить(СтрокаСведений.ИдентификаторСтроки, Количество);
		
	КонецЦикла;
	
	Для Каждого СтрокаТовара Из Товары Цикл
		
		Количество = КоличествоПоТовару[СтрокаТовара.ИдентификаторСтроки];
		Если Количество = Неопределено
			ИЛИ СтрокаТовара.КоличествоУпаковок = Количество Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Для номенклатуры в строке %1 количество отличается от количества введенных РНПТ'"),
			СтрокаТовара.НомерСтроки);
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
			ИмяТабличнойЧасти, СтрокаТовара.НомерСтроки, "КоличествоУпаковок");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, Поле, "Объект", Отказ);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

// Инициализирует кэш строк на форме для для указанной таблицы.
// Для использования кэширования строк необходимо добавить на форму реквизит "КэшированныеСтроки" с типом "Произвольный".
//
// Параметры:
//  ТаблицаФормы - ТаблицаФормы - элемент формы, содержащий табличную часть.
//
Процедура ИнициализироватьКэшСтрок(ТаблицаФормы) Экспорт
	
	Форма = ТаблицаФормы.Родитель;
	Пока ТипЗнч(Форма) <> Тип("ФормаКлиентскогоПриложения") Цикл
		Форма = Форма.Родитель;
	КонецЦикла;
	
	КэшСтроки = Новый Структура;
	
	РеквизитыТаблицы = Форма.ПолучитьРеквизиты(ТаблицаФормы.ПутьКДанным);
	Для Каждого Реквизит Из РеквизитыТаблицы Цикл
		КэшСтроки.Вставить(Реквизит.Имя, Неопределено);
	КонецЦикла;
	
	Если Форма.КэшированныеСтроки = Неопределено Тогда
		Форма.КэшированныеСтроки = Новый Структура;
	КонецЕсли;
	Форма.КэшированныеСтроки.Вставить(ТаблицаФормы.Имя, Новый ФиксированнаяСтруктура(КэшСтроки));
	
КонецПроцедуры

#Область ПроверкаЗаполнения

// Возвращает структуру с параметрами для проверки заполнения количества и единицы измерения.
//
// Возвращаемое значение:
//  Структура - содержит параметры для проверки:
//   * Объект
//   * ИмяТабличнойЧасти
//   * МассивНепроверяемыхРеквизитов
//   * МинимальноеЗначениеЦены
//
Функция ПараметрыПроверкиЗаполненияКоличестваИЕдиницыИзмерения() Экспорт
	
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("Объект");
	ПараметрыПроверки.Вставить("ИмяТабличнойЧасти");
	ПараметрыПроверки.Вставить("МассивНепроверяемыхРеквизитов");
	ПараметрыПроверки.Вставить("МинимальноеЗначениеЦены");
	Возврат ПараметрыПроверки;
	
КонецФункции

