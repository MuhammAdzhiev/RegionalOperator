// Обработчик события динамического списка для документов, подлежащих проверке в ГИС МТ
// 
// Параметры:
//  Строки - СтрокиДинамическогоСписка
//  ИмяПоляСсылка - Строка
Процедура ПриПолученииДанныхДинамическогоСпискаСтатусаФискализации(Строки, ИмяПоляСсылка = "Ссылка") Экспорт
	
	ДокументыСписка = Новый Массив;
	
	Для Каждого Строка Из Строки Цикл
		
		ДанныеСтроки = Строка.Значение.Данные;
		Документ     = ДанныеСтроки[ИмяПоляСсылка];
		
		КолонкиДоступны = ДанныеСтроки.Свойство(ИмяПоляСсылка) И ДанныеСтроки.Свойство("СтатусФискализации");
		
		Если Не КолонкиДоступны Тогда
			Возврат;
		КонецЕсли;
		
		ДокументыСписка.Добавить(Документ);
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент  КАК ДокументСписка,
		|	ВЫРАЗИТЬ(ОбъектыУчетаДокументовЭДО.ОбъектУчета КАК Документ.РеализацияТоваровУслуг).СтатусФискализацииДокумента КАК
		|		СтатусФискализации
		|ИЗ
		|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК ОбъектыУчетаДокументовЭДО
		|ГДЕ
		|	ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент В (&ДокументыСписка)
		|	И ОбъектыУчетаДокументовЭДО.ОбъектУчета ССЫЛКА Документ.РеализацияТоваровУслуг
		|	И НЕ ВЫРАЗИТЬ(ОбъектыУчетаДокументовЭДО.ОбъектУчета КАК
		|		Документ.РеализацияТоваровУслуг).СтатусФискализацииДокумента В (&НачальныеСтатусыФискализации)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДокументРеализацияТоваровУслуг.Ссылка,
		|	ДокументРеализацияТоваровУслуг.СтатусФискализацииДокумента
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК ДокументРеализацияТоваровУслуг
		|ГДЕ
		|	ДокументРеализацияТоваровУслуг.Ссылка В (&ДокументыСписка)
		|	И НЕ ДокументРеализацияТоваровУслуг.СтатусФискализацииДокумента В (&НачальныеСтатусыФискализации)
		|";
	
	НачальныеСтатусыФискализации = Новый Массив;
	НачальныеСтатусыФискализации.Добавить(Перечисления.СтатусФискализацииДокумента.ПустаяСсылка());
	НачальныеСтатусыФискализации.Добавить(Перечисления.СтатусФискализацииДокумента.Новый);
	
	Запрос.УстановитьПараметр("НачальныеСтатусыФискализации", НачальныеСтатусыФискализации);
	Запрос.УстановитьПараметр("ДокументыСписка",              ДокументыСписка);
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СтатусыФискализации = Новый Соответствие();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтатусыФискализации.Вставить(ВыборкаДетальныеЗаписи.ДокументСписка, ВыборкаДетальныеЗаписи.СтатусФискализации);
	КонецЦикла;
	
	Для Каждого Строка Из Строки Цикл
		
		ДанныеСтроки = Строка.Значение.Данные;
		Документ     = ДанныеСтроки[ИмяПоляСсылка];
		
		ДанныеСтроки["СтатусФискализации"] = СтатусыФискализации[Документ];
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоПодмножество(Знач Множество, Знач Подмножество)
	
	Если Множество.Количество() < Подмножество.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 0 По Подмножество.Количество() - 1 Цикл
		Если Множество[Индекс] <> Подмножество[Индекс] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

