Функция ФормаУстановленаНаНачальнойСтранице(НачальнаяСтраницаНастройки, Форма) Экспорт
	
	Если НачальнаяСтраницаНастройки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(НачальнаяСтраницаНастройки) = Тип("ХранилищеЗначения") Тогда
		НачальнаяСтраницаНастройки = НачальнаяСтраницаНастройки.Получить();
	КонецЕсли;
	
	Если НачальнаяСтраницаНастройки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СоставФормНачальнойСтраницы = НачальнаяСтраницаНастройки.ПолучитьСоставФорм();
	
	Если СоставФормНачальнойСтраницы.ЛеваяКолонка.Количество() = 0
		Или СоставФормНачальнойСтраницы.ЛеваяКолонка.Количество() > 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СоставФормНачальнойСтраницы.ЛеваяКолонка[0] = Форма;

КонецФункции

Функция КэшируемыеРеквизитыМаркировки()

	Возврат "МаркируемыеУпаковки,КодыУпаковокМаркируемойПродукции,МаркируемыеУпаковкиДоКорректировки,КодыУпаковокМаркируемойПродукцииДоКорректировки";

КонецФункции

Процедура ОбновитьКодыМаркировкиВОбъекте(ТаблицаАктуальныхКодов, Объект, ИмяТаблицыКодов)
	
	ТаблицаСохраненныхКодов = Объект[ИмяТаблицыКодов];
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("АктуальнаяТаблицаКодовУпаковок",  ТаблицаАктуальныхКодов);
	Запрос.УстановитьПараметр("СохраненнаяТаблицаКодовУпаковок", ТаблицаСохраненныхКодов.Выгрузить());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаУпаковок.НомерСтроки КАК НомерСтроки,
	|	ТаблицаУпаковок.НомерУпаковки КАК НомерУпаковки,
	|	ТаблицаУпаковок.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ТекущиеКодыУпаковок
	|ИЗ
	|	&АктуальнаяТаблицаКодовУпаковок КАК ТаблицаУпаковок
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерУпаковки,
	|	ИдентификаторСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаУпаковок.НомерСтроки КАК НомерСтроки,
	|	ТаблицаУпаковок.НомерУпаковки КАК НомерУпаковки,
	|	ТаблицаУпаковок.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ СохраненныеКодыУпаковок
	|ИЗ
	|	&СохраненнаяТаблицаКодовУпаковок КАК ТаблицаУпаковок
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерУпаковки,
	|	ИдентификаторСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СохраненныеКодыУпаковок.НомерСтроки, 0) КАК НомерСтроки,
	|	ЕСТЬNULL(ТекущиеКодыУпаковок.ИдентификаторСтроки, СохраненныеКодыУпаковок.ИдентификаторСтроки) КАК ИдентификаторСтроки,
	|	ЕСТЬNULL(ТекущиеКодыУпаковок.НомерУпаковки, СохраненныеКодыУпаковок.НомерУпаковки) КАК НомерУпаковки,
	|	ВЫБОР
	|		КОГДА СохраненныеКодыУпаковок.НомерУпаковки ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Добавить,
	|	ЕСТЬNULL(ТекущиеКодыУпаковок.НомерСтроки, 0) КАК НомерСтрокиИсходный
	|ИЗ
	|	ТекущиеКодыУпаковок КАК ТекущиеКодыУпаковок
	|		ПОЛНОЕ СОЕДИНЕНИЕ СохраненныеКодыУпаковок КАК СохраненныеКодыУпаковок
	|		ПО ТекущиеКодыУпаковок.НомерУпаковки = СохраненныеКодыУпаковок.НомерУпаковки
	|			И ТекущиеКодыУпаковок.ИдентификаторСтроки = СохраненныеКодыУпаковок.ИдентификаторСтроки
	|ГДЕ
	|	(СохраненныеКодыУпаковок.НомерУпаковки ЕСТЬ NULL
	|			ИЛИ ТекущиеКодыУпаковок.НомерУпаковки ЕСТЬ NULL)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Добавить,
	|	НомерСтроки УБЫВ,
	|	НомерСтрокиИсходный
	|ИТОГИ ПО
	|	Добавить";
	ВыборкаДействий = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДействий.Следующий() Цикл
		Если ВыборкаДействий.Добавить Тогда
			ВыборкаДанныхУпаковок = ВыборкаДействий.Выбрать();
			Пока ВыборкаДанныхУпаковок.Следующий() Цикл
				НоваяСтрока = ТаблицаСохраненныхКодов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДанныхУпаковок,, "НомерСтроки");
			КонецЦикла;
		Иначе
			// удаляем упаковки в обратном порядке следования строк.
			ВыборкаДанныхУпаковок = ВыборкаДействий.Выбрать();
			
			Пока ВыборкаДанныхУпаковок.Следующий() Цикл
				ТаблицаСохраненныхКодов.Удалить(ВыборкаДанныхУпаковок.НомерСтроки - 1);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ТаблицаКодовМаркировкиПоТаблицеТоваров(КоллекцияДанных, Объект, ИмяТаблицыКодов)
	
	ТаблицаКодов = Объект[ИмяТаблицыКодов].Выгрузить();
	ТаблицаКодов.Очистить();
	
	НомерСтроки = 1;
	Для Каждого СтрокаКоллекции Из КоллекцияДанных Цикл
		Для Каждого ЭлементСписка Из СтрокаКоллекции[ИмяТаблицыКодов] Цикл
			НоваяСтрока = ТаблицаКодов.Добавить();
			НоваяСтрока.ИдентификаторСтроки = СтрокаКоллекции.ИдентификаторСтроки;
			НоваяСтрока.НомерУпаковки       = ЭлементСписка.Значение;
			НоваяСтрока.НомерСтроки         = НомерСтроки;
			
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаКодов;

КонецФункции

// Обрабатывает полученные данные из сервиса 1С:ЭДО по услуге Onboarding.
//
Процедура ОбработатьПолученныеДанныеОбластиИзСервиса1СЭДО(ПотокДанных, Обработчик, ДанныеОбработаны, КодВозврата, ОписаниеОшибки)
	
	Если НРег(Обработчик) = "onboarding" И НЕ ДанныеОбработаны Тогда
		
		ДанныеОтАбонента = Неопределено;
		
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.ОткрытьПоток(ПотокДанных);
			ДанныеОтАбонента = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
		Исключение
			ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ВыполнитьЗаписьСобытияПоКЭДОВЖурналРегистрации(ОписаниеОшибки);
			Возврат;
		КонецПопытки;
		
		Если ЗначениеЗаполнено(ДанныеОтАбонента) Тогда
			
			Если ПолучитьНастройкиСтартовогоПомощникаКЭДО() <> Неопределено Тогда
				ДанныеОбработаны = Истина;
				Возврат;
			КонецЕсли;
			
			// Необходимо, чтобы все данные записались сразу.
			НачатьТранзакцию();
			
			Попытка
				
				Если ДанныеОтАбонента.Свойство("OrganizationInitiator") Тогда
					
					ДанныеКонтрагента = ДанныеОтАбонента.OrganizationInitiator;
					
					ИННКонтрагента = СокрЛП(ДанныеКонтрагента.inn);
					КППКонтрагента = СокрЛП(ДанныеКонтрагента.kpp);
					
					СсылкаКонтрагента = ПроверитьСуществованиеЭлементаВСправочнике("Контрагенты", ИННКонтрагента, КППКонтрагента);
					
					Если СсылкаКонтрагента = Неопределено Тогда
						
						ОбъектКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
						
						ОбъектКонтрагент.Наименование       = СокрЛП(ДанныеКонтрагента.name);
						ОбъектКонтрагент.НаименованиеПолное = СокрЛП(ДанныеКонтрагента.name);
						ОбъектКонтрагент.ИНН                = ИННКонтрагента;
						ОбъектКонтрагент.КПП                = КППКонтрагента;
						
						ОбъектКонтрагент.ЮрФизЛицо          = ?(СтрДлина(ОбъектКонтрагент.ИНН) = 12, Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель,
															Перечисления.ЮрФизЛицо.ЮрЛицо);
						
						УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ОбъектКонтрагент, СокрЛП(ДанныеКонтрагента.legalAddress),
							ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ЮрАдресКонтрагента"), ТекущаяДатаСеанса(), Истина);
						
						УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ОбъектКонтрагент, СокрЛП(ДанныеКонтрагента.actualAddress),
							ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента"), ТекущаяДатаСеанса(), Истина);
						
						ОбъектКонтрагент.Записать();
						
						СсылкаКонтрагента = ОбъектКонтрагент.Ссылка;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если ДанныеОтАбонента.Свойство("ConnectedOrganization") Тогда
					
					ДанныеОрганизации = ДанныеОтАбонента.ConnectedOrganization;
					
					ИННОрганизации = СокрЛП(ДанныеОрганизации.inn);
					КППОрганизации = СокрЛП(ДанныеОрганизации.kpp);
					
					СсылкаОрганизации = ПроверитьСуществованиеЭлементаВСправочнике("Организации", ИННОрганизации, КППОрганизации, Истина);
					
					Если СсылкаОрганизации = Неопределено Тогда
						
						ОбъектОрганизация = Справочники.Организации.СоздатьЭлемент();
						
						ОбъектОрганизация.НаименованиеСокращенное = СокрЛП(ДанныеОрганизации.name);
						ОбъектОрганизация.ИНН                     = СокрЛП(ДанныеОрганизации.inn);
						ОбъектОрганизация.КПП                     = СокрЛП(ДанныеОрганизации.kpp);
						ОбъектОрганизация.ЮрФизЛицо               = ?(СтрДлина(ОбъектОрганизация.ИНН) = 12, Перечисления.ЮрФизЛицо.ФизЛицо, Перечисления.ЮрФизЛицо.ЮрЛицо);
						
						СтруктураНаименования = КлиентЭДОКлиентСервер.РазложитьСтрокуНаименованияОрганизации(
							ОбъектОрганизация.НаименованиеСокращенное, ОбъектОрганизация.ЮрФизЛицо);
						
						ОбъектОрганизация.НаименованиеПолное      = КлиентЭДОКлиентСервер.СформироватьНаименованиеПолное(ОбъектОрганизация.ЮрФизЛицо, СтруктураНаименования);
						ОбъектОрганизация.Наименование            = КлиентЭДОКлиентСервер.СформироватьНаименование(СтруктураНаименования);
						
						УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ОбъектОрганизация, СокрЛП(ДанныеОрганизации.email),
							ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.EmailОрганизации"), ТекущаяДатаСеанса(), Истина);
						
						ОбъектОрганизация.Записать();
						
						СсылкаОрганизации = ОбъектОрганизация.Ссылка;
						
					КонецЕсли;
					
				КонецЕсли;
				
				НастройкиПомощникаКЭДО = КлиентЭДОКлиентСервер.НоваяСтруктураНастроекПомощникаЭДО();
				НастройкиПомощникаКЭДО.Организация                    = СсылкаОрганизации;
				НастройкиПомощникаКЭДО.ПригласившийКонтрагент         = СсылкаКонтрагента;
				НастройкиПомощникаКЭДО.УслугаOnboarding               = Истина;
				НастройкиПомощникаКЭДО.ОбменДокументамиСКонтрагентами = Истина;
				НастройкиПомощникаКЭДО.ОбменЭДО                       = Истина;
				
				КлиентЭДОВызовСервера.СохранитьНастройкиСтартовогоПомощникаКЭДО(НастройкиПомощникаКЭДО);
				
				ДанныеОбработаны = Истина;
				
				ЗафиксироватьТранзакцию();
				
			Исключение
				ОтменитьТранзакцию();
				ДанныеОбработаны = Ложь;
				КодВозврата      = ПоставляемыеДанныеАбонентовСловарь.КодВозвратаОшибкаДанных();
				ОписаниеОшибки   = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ВыполнитьЗаписьСобытияПоКЭДОВЖурналРегистрации(ОписаниеОшибки);
				Возврат;
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Данная процедура используется для стандартизации всех записей событий подсистемы КлиентЭДО
// в журнал регистрации.
//
// Параметры:
//   ОписаниеСобытия         - Строка    - описание содержания события, которое требуется записать в журнал регистрации.
//   ДополнительныеПараметры - Структура - содержит дополнительные параметры для записи в журнал регистрации:
//    *УровеньВажности  - УровеньЖурналаРегистрации               - уровень журнала регистрации (Ошибка, Информация, и т.д.).
//    *ОбъектМетаданных - ОбъектМетаданных                        - объект метаданных, к которому относится событие.
//    *ДанныеСсылка     - Произвольный                            - данные, с которыми связано событие. Рекомендуется указывать ссылки
//                                                                на объекты данных (элементы справочников, документы, к которым относится событие).
//    *РежимТранзакции  - РежимТранзакцииЗаписиЖурналаРегистрации - указывает отношение записи к текущей транзакции.
//
Процедура ВыполнитьЗаписьСобытияПоКЭДОВЖурналРегистрации(ОписаниеСобытия, ДополнительныеПараметры = Неопределено)
	
	УровеньВажности  = Неопределено;
	ОбъектМетаданных = Неопределено;
	ДанныеСсылка     = Неопределено;
	РежимТранзакции  = Неопределено;
	
	Если ДополнительныеПараметры <> Неопределено Тогда
		ДополнительныеПараметры.Свойство("УровеньВажности",  УровеньВажности);
		ДополнительныеПараметры.Свойство("ОбъектМетаданных", ОбъектМетаданных);
		ДополнительныеПараметры.Свойство("ДанныеСсылка",     ДанныеСсылка);
		ДополнительныеПараметры.Свойство("РежимТранзакции",  РежимТранзакции);
	КонецЕсли;
	
	Подсистема = НСтр("ru = 'Общая подсистема'", ОбщегоНазначения.КодОсновногоЯзыка());

	УровеньВажностиСобытия = ?(ТипЗнч(УровеньВажности) = Тип("УровеньЖурналаРегистрации"),
		УровеньВажности, УровеньЖурналаРегистрации.Ошибка);
		
	ИмяСобытия = СтрЗаменить(НСтр("ru = 'Клиент ЭДО.%1'", ОбщегоНазначения.КодОсновногоЯзыка()),
		"%1", Подсистема);
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньВажностиСобытия, ОбъектМетаданных, ДанныеСсылка, ОписаниеСобытия,
		РежимТранзакции);
	
КонецПроцедуры

Функция ПроверитьСуществованиеЭлементаВСправочнике(ИмяСправочника, ИНН, КПП, УчитыватьПометкуУдаления = Ложь)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);

	ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПроверяемыйСправочник.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник."+ИмяСправочника+" КАК ПроверяемыйСправочник
		|ГДЕ
		|	ПроверяемыйСправочник.КПП = &КПП
		|	И ПроверяемыйСправочник.ИНН = &ИНН
		|	И &УсловиеНаПометкуУдаления";
	
	Если НЕ УчитыватьПометкуУдаления Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеНаПометкуУдаления", "НЕ ПроверяемыйСправочник.ПометкаУдаления");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеНаПометкуУдаления", "Истина");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ЕстьОрганизацииВБазе()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Организации.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

// Возвращает основания полномочий физических лиц организации.
// 
// Параметры:
//  Организация - СправочникСсылка.Организации
//  ФизическиеЛица - Массив из СправочникСсылка.ФизическиеЛица
// 
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - СправочникСсылка.ФизическиеЛица
//   * Значение - Структура:
//    ** ОснованиеПолномочий - Строка
//    ** Должность - СправочникСсылка.Должности
//   
Функция ОснованияПолномочийФизическихЛиц(Организация, ФизическиеЛица) Экспорт 
	
	ВозвращаемоеСоответствие = Новый Соответствие;
	
	Если ТипЗнч(ФизическиеЛица) <> Тип("Массив") Тогда
		Если ЗначениеЗаполнено(ФизическиеЛица) Тогда
			ФизическиеЛицаМассив = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ФизическиеЛица);
		Иначе
			ФизическиеЛицаМассив = Новый Массив;
		КонецЕсли;
	Иначе
		ФизическиеЛицаМассив = ФизическиеЛица;
	КонецЕсли;
	
	Если ФизическиеЛицаМассив.Количество() = 0 Тогда
		Возврат ВозвращаемоеСоответствие;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФизическиеЛица.Ссылка КАК ФизическоеЛицо,
		|	ЕСТЬNULL(ОснованияПолномочийОтветственныхЛиц.ОснованиеПолномочий, """") КАК ОснованиеПолномочий,
		|	ЕСТЬNULL(ОснованияПолномочийОтветственныхЛиц.Должность, ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК Должность
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОснованияПолномочийОтветственныхЛиц КАК ОснованияПолномочийОтветственныхЛиц
		|		ПО ФизическиеЛица.Ссылка = ОснованияПолномочийОтветственныхЛиц.ФизическоеЛицо
		|			И (ОснованияПолномочийОтветственныхЛиц.Организация = &Организация)
		|ГДЕ
		|	ФизическиеЛица.Ссылка В(&ФизическиеЛица)";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ФизическиеЛица", ФизическиеЛицаМассив);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураРеквизитов = Новый Структура("Должность, ОснованиеПолномочий");
		СтруктураРеквизитов.Должность = Выборка.Должность;
		СтруктураРеквизитов.ОснованиеПолномочий = Выборка.ОснованиеПолномочий;
		
		ВозвращаемоеСоответствие.Вставить(Выборка.ФизическоеЛицо, СтруктураРеквизитов);
	КонецЦикла;
	
	Возврат ВозвращаемоеСоответствие;
	
КонецФункции

Функция ДанныеФизическогоЛица(Физлицо) 
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ФизическиеЛица.Фамилия КАК Фамилия,
	|	ФизическиеЛица.Имя КАК Имя,
	|	ФизическиеЛица.Отчество КАК Отчество,
	|	ФизическиеЛица.ДатаРождения КАК ДатаРождения,
	|	ФизическиеЛица.Пол КАК Пол,
	|	ФизическиеЛица.МестоРождения КАК МестоРождения,
	|	ФизическиеЛица.Гражданство КАК Гражданство,
	|	ФизическиеЛица.СтраховойНомерПФР КАК СтраховойНомерПФР,
	|	ФизическиеЛица.ИНН КАК ИНН,
	|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.ВидДокумента, ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПустаяСсылка)) КАК ВидДокумента,
	|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Серия, """") КАК Серия,
	|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Номер, """") КАК Номер,
	|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.КемВыдан, """") КАК КемВыдан,
	|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.ДатаВыдачи, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаВыдачи,
	|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.КодПодразделения, """") КАК КодПодразделения
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних КАК ДокументыФизическихЛицСрезПоследних
	|		ПО (ДокументыФизическихЛицСрезПоследних.Физлицо = ФизическиеЛица.Ссылка)
	|			И (ДокументыФизическихЛицСрезПоследних.ЯвляетсяДокументомУдостоверяющимЛичность
	|				ИЛИ ДокументыФизическихЛицСрезПоследних.ВидДокумента = &ПаспортРФ)
	|ГДЕ
	|	ФизическиеЛица.Ссылка = &Физлицо";
	
	Запрос.УстановитьПараметр("ПаспортРФ", Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ);
	Запрос.УстановитьПараметр("Физлицо", Физлицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		
		Результат = Новый Структура;
		Результат.Вставить("Фамилия", ВыборкаДетальныеЗаписи.Фамилия);
		Результат.Вставить("Имя", ВыборкаДетальныеЗаписи.Имя);
		Результат.Вставить("Отчество", ВыборкаДетальныеЗаписи.Отчество);
		Результат.Вставить("ДатаРождения", ВыборкаДетальныеЗаписи.ДатаРождения);
		Результат.Вставить("Пол", ВыборкаДетальныеЗаписи.Пол);
		Результат.Вставить("МестоРождения", ВыборкаДетальныеЗаписи.МестоРождения);
		Результат.Вставить("Гражданство", ВыборкаДетальныеЗаписи.Гражданство);
		Результат.Вставить("СтраховойНомерПФР", ВыборкаДетальныеЗаписи.СтраховойНомерПФР);
		Результат.Вставить("ИНН", ВыборкаДетальныеЗаписи.ИНН);
		Результат.Вставить("ВидДокумента", ВыборкаДетальныеЗаписи.ВидДокумента);
		Результат.Вставить("Серия", ВыборкаДетальныеЗаписи.Серия);
		Результат.Вставить("Номер", ВыборкаДетальныеЗаписи.Номер);
		Результат.Вставить("КемВыдан", ВыборкаДетальныеЗаписи.КемВыдан);
		Результат.Вставить("ДатаВыдачи", ВыборкаДетальныеЗаписи.ДатаВыдачи);
		Результат.Вставить("КодПодразделения", ВыборкаДетальныеЗаписи.КодПодразделения);
		
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Возвращает версию режима совместимости в формате нумерации редакций и версий, например, 8.3.15.0.
//
// Возвращаемое значение:
//   Строка - версия режима совместимости в формате нумерации редакций и версий.
//
Функция ВерсияРежимаСовместимости() Экспорт
	
	Если Метаданные.РежимСовместимости = Метаданные.СвойстваОбъектов.РежимСовместимости.НеИспользовать Тогда 
		
		Информация = Новый СистемнаяИнформация;
		Возврат Информация.ВерсияПриложения;
		
	КонецЕсли;
	
	ОписаниеРежимаСовместимости = СтрРазделить(Метаданные.РежимСовместимости, "_");
	Символов = СтрДлина(ОписаниеРежимаСовместимости[0]);
	
	НомерРедакции = "";
	
	Для НомерСимвола = 1 По Символов Цикл 
		
		ТекущийСимвол = Сред(ОписаниеРежимаСовместимости[0], НомерСимвола, 1);
		
		Если СтрНайти("0123456789", ТекущийСимвол) > 0 Тогда 
			НомерРедакции = НомерРедакции + ТекущийСимвол;
		КонецЕсли;
		
	КонецЦикла;
	
	ОписаниеРежимаСовместимости.Установить(0, НомерРедакции);
	
	Для Индекс = ОписаниеРежимаСовместимости.Количество() По 3 Цикл 
		ОписаниеРежимаСовместимости.Добавить("0");
	КонецЦикла;
	
	Возврат СтрСоединить(ОписаниеРежимаСовместимости, ".");
	
КонецФункции

Процедура ЗаполнитьЭлементОформленияНадписиВАктеОРасхождениях(ЭлементОформления, ИмяПоля, ИмяТабличнойЧасти, ТекстПоля)
	
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, ИмяПоля);
	ПолноеИмяПоля = СтрШаблон("Объект.%1.%2", ИмяТабличнойЧасти, ИмяПоля);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор, ПолноеИмяПоля, ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", ТекстПоля);
	
КонецПроцедуры

// Выполняет попытку создания электронного документа исходящего, на основании учетного документа. В случае ошибки,
//  оповещает о ней ответственного.
Процедура СозданиеЭлектронныхДокументовФоновоеЗадание() Экспорт
	
	Попытка
		Менеджер = Обработки.МенеджерАвтоматическогоСозданияЭлектронныхДокументов.Создать();
		Менеджер.СоздатьЭлектронныеДокументы();
	Исключение
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоКЭДОВЖурналРегистрации(ОписаниеОшибки);
	КонецПопытки;
	
КонецПроцедуры

// Возвращает признак создания базы через механизм Onboarding`а
// 
// Возвращаемое значение:
// 	Булево - Истина, если информационная база была создана через механизм Onboarding`а. 
Функция БазаСозданаЧерезOnboarding()
	
	ПодключенПоOnboarding = Ложь;
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		НастройкиСтартовогоПомощникаКЭДО = ПолучитьНастройкиСтартовогоПомощникаКЭДО();
		Если НастройкиСтартовогоПомощникаКЭДО <> Неопределено
			И НастройкиСтартовогоПомощникаКЭДО.Свойство("УслугаOnboarding") Тогда
			ПодключенПоOnboarding = НастройкиСтартовогоПомощникаКЭДО.УслугаOnboarding;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПодключенПоOnboarding;
	
КонецФункции

// Возвращает ключ настройки рабочей области начальной страницы из системного хранилища.
// 
// Возвращаемое значение:
//  Строка
Функция КлючНастройкиРабочейОбластиНачальнойСтраницы()
	Возврат "Общее/НастройкиНачальнойСтраницы";
КонецФункции

// Возвращаемое значение:
//  Массив Из ОбъектМетаданных
Функция ОбъектыМетаданныхДляКоторыхОпределеныКомандыВводаНаОсновании()
	ОбъектыДляКоторыхОпределеныКомандыВводаНаОсновании = Новый Массив; // Массив Из ОбъектМетаданных
	ОбъектыДляКоторыхОпределеныКомандыВводаНаОсновании.Добавить(Метаданные.Документы.РеализацияТоваровУслуг);
	ОбъектыДляКоторыхОпределеныКомандыВводаНаОсновании.Добавить(Метаданные.Документы.ЗаказПокупателя);
	ОбъектыДляКоторыхОпределеныКомандыВводаНаОсновании.Добавить(Метаданные.Документы.СчетФактураВыданный);
	ОбъектыДляКоторыхОпределеныКомандыВводаНаОсновании.Добавить(Метаданные.Документы.АктОРасхожденияхПоПриемке);
	ОбъектыДляКоторыхОпределеныКомандыВводаНаОсновании.Добавить(Метаданные.Документы.ПоступлениеТоваровУслуг);
	Возврат ОбъектыДляКоторыхОпределеныКомандыВводаНаОсновании;
КонецФункции

// Возвращаемое значение:
//  Массив Из ОбъектМетаданных
Функция ОбъектыМетаданныхДляКоторыхОпределеныКомандыСозданияУчетныхДокументов()
	ОбъектыДляКоторыхОпределеныКомандыВводаНаОсновании = Новый Массив; // Массив Из ОбъектМетаданных
	ОбъектыДляКоторыхОпределеныКомандыВводаНаОсновании.Добавить(Метаданные.Документы.ЭлектронныйДокументИсходящийЭДО);
	Возврат ОбъектыДляКоторыхОпределеныКомандыВводаНаОсновании;
КонецФункции

// Возвращаемое значение:
//  Массив Из ОбъектМетаданных
Функция ОбъектыМетаданныхДляКоторыхОпределеныПодключаемыеКомандыКонтрагентов()
	ОбъектыДляКоторыхОпределеныПодключаемыеКомандыКонтрагентов = Новый Массив; // Массив Из ОбъектМетаданных
	ОбъектыДляКоторыхОпределеныПодключаемыеКомандыКонтрагентов.Добавить(Метаданные.Справочники.Контрагенты);
	Возврат ОбъектыДляКоторыхОпределеныПодключаемыеКомандыКонтрагентов;
КонецФункции

Процедура ЗаполнитьСоответствиеШапкиДляИсходящейТранспортнойОперацииВЕТИС(ДокументОснование, ДокументОбъект) Экспорт
	
	ЗаписьДокументаВЕТИС = ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ИсходящаяТранспортнаяОперацияВЕТИС");
	РеквизитыВЕТИС = Реквизиты(ДокументОбъект,
		"ГрузоотправительПредприятие,ГрузоотправительХозяйствующийСубъект,ГрузополучательПредприятие,ГрузополучательХозяйствующийСубъект",
		ЗаписьДокументаВЕТИС);
	ТипОснования = ТипЗнч(ДокументОснование);
	Если ТипОснования = Тип("ДокументСсылка.РеализацияТоваровУслуг")
		Или ТипОснования = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		РеквизитыШапки = Реквизиты(ДокументОснование,
			"Контрагент,Организация",
			Не ЗаписьДокументаВЕТИС);
		Справочники.ХозяйствующиеСубъектыВЕТИС.СопоставитьСПрикладнымиРеквизитами(
			РеквизитыВЕТИС.ГрузополучательХозяйствующийСубъект,
			РеквизитыВЕТИС.ГрузополучательПредприятие,
			РеквизитыШапки.Контрагент,,
			Ложь);
		Справочники.ХозяйствующиеСубъектыВЕТИС.СопоставитьСПрикладнымиРеквизитами(
			РеквизитыВЕТИС.ГрузоотправительХозяйствующийСубъект,
			РеквизитыВЕТИС.ГрузоотправительПредприятие,
			РеквизитыШапки.Организация,,
			Истина);
	КонецЕсли;
	
КонецПроцедуры

Функция Реквизиты(СсылкаИлиОбъект, ИменаРеквизитов, ЭтоОбъект)
	
	Если ЭтоОбъект Тогда
		Результат = Новый Структура(ИменаРеквизитов);
		ЗаполнитьЗначенияСвойств(Результат, СсылкаИлиОбъект);
	Иначе
		Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаИлиОбъект, ИменаРеквизитов);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// См. ЛегкийИнтерфейсДокументовЭДОСлужебный.ПриЗаполненииДанныхКомпонентаПанельСвязанныхДокументовЛегкийКлиентЭДО
//
// Параметры:
//  ДанныеКомпонента - См. ЛегкийИнтерфейсДокументовЭДОСлужебный.ПриЗаполненииДанныхКомпонентаПанельСвязанныхДокументовЛегкийКлиентЭДО.ДанныеКомпонента
//  СсылкаНаОбъект - ДокументСсылка
//  ОбъектыУчета - См. ЛегкийИнтерфейсДокументовЭДОСлужебный.ПриЗаполненииДанныхКомпонентаПанельСвязанныхДокументовЛегкийКлиентЭДО.ОбъектыУчета
Процедура ПриЗаполненииДанныхКомпонентаПанельСвязанныхДокументовМаркировка(ДанныеКомпонента, СсылкаНаОбъект, ОбъектыУчета = Неопределено) Экспорт
	
	Если Не КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		Возврат;
	КонецЕсли;
	
	ИсточникиОписания = Новый Массив;
	ВсеОписания       = Новый Массив;
	
	Если ИнтеграцияИСМП.ЭтоИсходящийЭлектронныйДокумент(СсылкаНаОбъект)
		И ОбъектыУчета <> Неопределено Тогда
		ИсточникиОписания = ОбъектыУчета;
	Иначе
		ИсточникиОписания.Добавить(СсылкаНаОбъект);
	КонецЕсли;
	
	Если ИсточникиОписания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ИстоникОписания Из ИсточникиОписания Цикл
		ОписаниеСтатусовЕГАИС = ИнтеграцияЕГАИСВызовСервера.ДанныеПоляИнтеграцииВФормеДокументаОснования(ИстоникОписания);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеОписания, ОписаниеСтатусовЕГАИС.ДанныеОписания);
		ОписаниеСтатусовВЕТИС = ИнтеграцияВЕТИСВызовСервера.ДанныеПоляИнтеграцииВФормеДокументаОснования(ИстоникОписания);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеОписания, ОписаниеСтатусовВЕТИС.ДанныеОписания);
		ОписаниеСтатусовИСМП  = ИнтеграцияИСМПВызовСервера.ДанныеПоляИнтеграцииВФормеДокументаОснования(ИстоникОписания);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеОписания, ОписаниеСтатусовИСМП.ДанныеОписания);
	КонецЦикла;
	
	Для Каждого ОписаниеСтатуса Из ВсеОписания Цикл
		
		Если ОписаниеСтатуса.СтатусОформления = Перечисления.СтатусыОформленияДокументовГосИС.НеОформлено
			Или ОписаниеСтатуса.СтатусОформления = Перечисления.СтатусыОформленияДокументовГосИС.ОформленоЧастично
			Или ОписаниеСтатуса.СтатусОформления = Перечисления.СтатусыОформленияДокументовГосИС.ЕстьОшибкиОформления
			Или ОписаниеСтатуса.СтатусОформления = Перечисления.СтатусыОформленияДокументовЕГАИС.НеОформлено
			Или ОписаниеСтатуса.СтатусОформления = Перечисления.СтатусыОформленияДокументовЕГАИС.ЕстьОшибкиОформления
			Или ОписаниеСтатуса.СтатусОформления = Перечисления.СтатусыОформленияДокументовЕГАИС.ОформленоЧастично Тогда
			
			НоваяКоманда = ДанныеКомпонента.КомандыСоздания.Добавить();
			НоваяКоманда.Представление = ОписаниеСтатуса.ТекстНадписи;
			НоваяКоманда.Обработчик    = "КлиентЭДОКлиент.ОбработчикКомандыСоздатьСвязанныйДокументЛекгийКлиентЭДО";
			НоваяКоманда.Идентификатор = СтрЗаменить(ОписаниеСтатуса.ИмяКоманды, "#", "_");
			НоваяКоманда.Идентификатор = СтрЗаменить(НоваяКоманда.Идентификатор, ".", "_");
			НоваяКоманда.Значение      = ОписаниеСтатуса.ИмяКоманды;
		
		Иначе
			
			Для Каждого СвязанныйДокумент Из ОписаниеСтатуса.МассивДокументов Цикл
				НовыйСвязанныйДокумент = ДанныеКомпонента.СвязанныеДокументы.Добавить();
				НовыйСвязанныйДокумент.Ссылка        = СвязанныйДокумент.Ссылка;
				НовыйСвязанныйДокумент.Представление = Строка(СвязанныйДокумент.Ссылка);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#Область ЭтапыГрафикаОплат

Процедура ОпределитьВариантУказанияГрафикаОплат(Форма)
	
	ЭтапыГрафикаОплаты = Форма.Объект.ЭтапыГрафикаОплаты.Выгрузить(,"ВариантОплаты").ВыгрузитьКолонку(0);

	ЭтапыУпрощенногоВвода = Новый Массив;
	ЭтапыУпрощенногоВвода.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыОплатыПоГрафику.Предоплата"));
	ЭтапыУпрощенногоВвода.Добавить(ПредопределенноеЗначение("Перечисление.ВариантыОплатыПоГрафику.ОтсрочкаПлатежа"));
	
	Форма.ИспользуетсяМногоэтапныйГрафикОплаты = Не ЭтоПодмножество(ЭтапыУпрощенногоВвода, ЭтапыГрафикаОплаты);

КонецПроцедуры

Процедура УстановитьОформлениеЭтаповГрафикаОплат(Форма)
	
	ИспользуетсяМногоэтапныйГрафикОплаты = Форма.ИспользуетсяМногоэтапныйГрафикОплаты;
	Элементы = Форма.Элементы;
	
	ШаблонГрафикОплатыСписком = НСтр("ru = 'График оплаты, <a href = ""%1"">списком</a>'");
	ШаблонГрафикОплатыПростой = НСтр("ru = 'График оплаты, <a href = ""%1"">простой</a>'");
	ШаблонГрафикаОплаты = ?(ИспользуетсяМногоэтапныйГрафикОплаты, ШаблонГрафикОплатыСписком, ШаблонГрафикОплатыПростой);
	ТекстHTML = СтрШаблон(ШаблонГрафикаОплаты, "ИзменитьРежимРедактированияГрафикаОплаты");
	ТекстЗаголовкаГрафикаОплат = СтроковыеФункции.ФорматированнаяСтрока(ТекстHTML);
	
	// Пометка кнопки "Список" графика оплат
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, "ДекорацияЗаголовокГрафикОплаты", "Заголовок", ТекстЗаголовкаГрафикаОплат);
	
	КлиентЭДОКлиентСервер.УстановитьОформлениеЭтаповГрафикаОплат(Форма);
	
КонецПроцедуры

// Распределяет сумму по этапам оплаты
//
// Параметры:
// ЭтапыГрафика
//   ЭтапыГрафикаОплаты -ТаблицаЗначений - таблица этапов оплаты, в которой необходимо распределить сумму
//   СуммаКРаспределениюОплаты - Число - сумма платежей, которую необходимо распределить по этапам
//
Процедура РаспределитьСуммуПоЭтапамГрафикаОплаты(ЭтапыГрафикаОплаты, Знач СуммаДокумента)
	
	КоличествоЭтапов = ЭтапыГрафикаОплаты.Количество();
	ИтоговыйПроцент = ЭтапыГрафикаОплаты.Итог("ПроцентПлатежа");
	
	Если КоличествоЭтапов = 1 И ИтоговыйПроцент = 100 Тогда
		ЭтапыГрафикаОплаты[0].СуммаПлатежа = СуммаДокумента;
		
		Возврат;
	КонецЕсли;
	
	КРаспределениюСумма = СуммаДокумента;
	КРаспределениюПроцент = 100;
	ТекущийЭтап = 1;
	ЭтапыКУдалению = Новый Массив;
	Для Каждого Этап Из ЭтапыГрафикаОплаты Цикл
		Если ТекущийЭтап = КоличествоЭтапов Тогда
			Этап.ПроцентПлатежа = КРаспределениюПроцент;
			Этап.СуммаПлатежа = КРаспределениюСумма;
		Иначе
			КлиентЭДОКлиентСервер.ЭтапыГрафикаОплатПриИзмененииПроцентаПлатежа(
				Этап.СуммаПлатежа, Этап.ПроцентПлатежа, СуммаДокумента);
			
			Если Этап.ПроцентПлатежа = 0 Тогда
				ЭтапыКУдалению.Добавить(Этап);
			КонецЕсли;
		КонецЕсли;
		
		КРаспределениюПроцент = КРаспределениюПроцент - Этап.ПроцентПлатежа;
		КРаспределениюСумма = КРаспределениюСумма - Этап.СуммаПлатежа;
		ТекущийЭтап = ТекущийЭтап + 1;
	КонецЦикла;
	
	Для Каждого Этап Из ЭтапыКУдалению Цикл
		ЭтапыГрафикаОплаты.Удалить(Этап);
	КонецЦикла;
	
КонецПроцедуры

// Добавляет один этап оплаты по умолчанию
//
// Параметры:
//   ЭтапыГрафикаОплаты -ТаблицаЗначений - таблица этапов оплаты, в которой необходимо распределить сумму
//   ПлановаяДатаПоставки - Дата - Дата поставки по документу.
//
Процедура ДобавитьЭтапОплатыПоУмолчанию(Объект, Знач ПлановаяДатаПоставки, Знач СуммаДокумента)
	
	Объект.ЭтапыГрафикаОплаты.Очистить();
	
	Если ЗначениеЗаполнено(ПлановаяДатаПоставки) Тогда
		ДатаПлатежа = ПлановаяДатаПоставки;
	ИначеЕсли ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаПлатежа = Объект.Дата;
	Иначе
	#Если Клиент Тогда
		ДатаПлатежа = ОбщегоНазначенияКлиент.ДатаСеанса();
	#Иначе
		ДатаПлатежа = ТекущаяДатаСеанса();
	#КонецЕсли
	КонецЕсли;
	
	ДанныеЭтапа = Новый Структура;
	ДанныеЭтапа.Вставить("ДатаПлатежа", ДатаПлатежа);
	ДанныеЭтапа.Вставить("ВариантОплаты", ПредопределенноеЗначение("Перечисление.ВариантыОплатыПоГрафику.Предоплата"));
	ДанныеЭтапа.Вставить("ПроцентПлатежа", ?(СуммаДокумента = 0, 0, 100));
	ДанныеЭтапа.Вставить("СуммаПлатежа", СуммаДокумента);
	
	ЗаполнитьЗначенияСвойств(Объект.ЭтапыГрафикаОплаты.Добавить(), ДанныеЭтапа);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
