#Область ПрограммныйИнтерфейс

#Область СопоставлениеНоменклатуры

// Процедура-обработчик события "ПередЗаписью" регистра для механизма сопоставления номенклатуры.
//
// Параметры:
//  Источник       - НаборЗаписейРегистра - источник события.
//  Отказ          - Булево - флаг отказа от выполнения обработчика.
//  Замещение      - Булево - признак замещения существующего набора записей.
// 
Процедура КонтрольСопоставленияНоменклатурыПередЗаписью(Источник, Отказ, Замещение) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда 
		Возврат;
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры") Тогда
		Возврат;
	КонецЕсли;
	
	Источник.Очистить();
	
КонецПроцедуры

#КонецОбласти

#Область РеквизитыМаркировки

// Заполняет представление указанных в документе кодов маркировки в колонке "Маркируемые упаковки" табличной части.
//
// Параметры:
//  ВладелецКоллекции - ДанныеФормыСтруктура - объект документа-владельца формы, либо сама форма.
//     Форма указывается в том случае, если таблица-коллекция является реквизитом формы, а не объекта.
//  ИмяКоллекции      - Строка - имя табличной части, в которой заполняется реквизит "МаркируемыеУпаковки".
//     Таблица должна содержать колонки: "НомерСтроки, ИдентификаторСтроки, МаркируемыеУпаковки". 
//
Процедура ЗаполнитьРеквизитыМаркировки(ВладелецКоллекции, ИмяКоллекции = "Товары") Экспорт
	
	КоллекцияДанных = ВладелецКоллекции[ИмяКоллекции];
	Если ТипЗнч(ВладелецКоллекции) = Тип("ФормаКлиентскогоПриложения") Тогда
		Корректировка = ВладелецКоллекции.Объект.ВидОперации = Перечисления.ВидыОпераций.Корректировка;
		
	Иначе
		Корректировка = ВладелецКоллекции.ВидОперации = Перечисления.ВидыОпераций.Корректировка;
		
	КонецЕсли;
	
	Для Каждого СтрокаКоллекции Из КоллекцияДанных Цикл
		Если ЗначениеЗаполнено(СтрокаКоллекции.ИдентификаторСтроки) Тогда
			ПараметрыОтбораУпаковок = Новый Структура("ИдентификаторСтроки", СтрокаКоллекции.ИдентификаторСтроки);
			
			КодыУпаковок = ВладелецКоллекции.КодыУпаковокМаркируемойПродукции.Выгрузить(ПараметрыОтбораУпаковок, "НомерУпаковки").ВыгрузитьКолонку("НомерУпаковки");
			
			СтрокаКоллекции.КодыУпаковокМаркируемойПродукции.ЗагрузитьЗначения(КодыУпаковок);
			СтрокаКоллекции.МаркируемыеУпаковки = КлиентЭДОКлиентСервер.ПредставлениеКодовМаркировки(КодыУпаковок);
			
			Если Корректировка Тогда
				КодыУпаковок = ВладелецКоллекции.КодыУпаковокМаркируемойПродукцииДоКорректировки.Выгрузить(ПараметрыОтбораУпаковок, "НомерУпаковки").ВыгрузитьКолонку("НомерУпаковки");
				
				СтрокаКоллекции.КодыУпаковокМаркируемойПродукцииДоКорректировки.ЗагрузитьЗначения(КодыУпаковок);
				СтрокаКоллекции.МаркируемыеУпаковкиДоКорректировки = КлиентЭДОКлиентСервер.ПредставлениеКодовМаркировки(КодыУпаковок);
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Кэширует значения колонок "НомерСтроки, МаркируемыеУпаковки" из коллекции данных.
//
// Параметры:
//  КоллекцияДанных - ДанныеФормыКоллекция, ТаблицаЗначений - Таблица, из которой кэшируются значения колонок.
//  Кэш - Структура - объект, в котором кэшируются данные.
//
Процедура КэшироватьРеквизитыМаркировки(КоллекцияДанных, Кэш) Экспорт
	
	РеквизитыМаркировки = КоллекцияДанных.Выгрузить(, КэшируемыеРеквизитыМаркировки());
	Кэш.Вставить("РеквизитыМаркировки", РеквизитыМаркировки);
	
КонецПроцедуры

// Восстанавливает из кэша значения колонок "НомерСтроки, МаркируемыеУпаковки" в коллекцию данных.
//
// Параметры:
//  КоллекцияДанных - ДанныеФормыКоллекция, ТаблицаЗначений - таблица, из которой кэшируются значения колонок.
//  Кэш - Структура - объект, в котором кэшируются данные.
//
Процедура ВосстановитьРеквизитыМаркировки(КоллекцияДанных, Кэш) Экспорт
	
	КэшируемыеРеквизиты = КэшируемыеРеквизитыМаркировки();
	
	РеквизитыМаркировки = Неопределено;
	Если Кэш.Свойство("РеквизитыМаркировки", РеквизитыМаркировки) Тогда
		Для Каждого СтрокаКоллекции Из КоллекцияДанных Цикл
			СтрокаКэша = РеквизитыМаркировки[СтрокаКоллекции.НомерСтроки-1];
			
			ЗаполнитьЗначенияСвойств(СтрокаКоллекции, СтрокаКэша, КэшируемыеРеквизиты);
		КонецЦикла;
		Кэш.Удалить("РеквизитыМаркировки");
	КонецЕсли;
	
КонецПроцедуры

Функция КолонкиМаркируемыхУпаковок() Экспорт
	Возврат СтрРазделить(КэшируемыеРеквизитыМаркировки(), ",", Ложь);
КонецФункции

// Сохраняет данные по маркировке в документе, извлекая их из данных формы.
//
// Параметры:
//  КоллекцияДанных		 - ДанныеФормыКоллекция, ТаблицаЗначений - таблица, из которой будут получены данные по маркировке.
//  ЗаписываемыйОбъект	 - ДокументОбъект - объект документа, в котором хранятся сведения по маркировке.
//
Процедура СохранитьКодыМаркировки(КоллекцияДанных, ЗаписываемыйОбъект) Экспорт
	
	ЗаписываемыйОбъект.КодыУпаковокМаркируемойПродукции.Очистить();
	Для Каждого СтрокаТовары Из КоллекцияДанных Цикл
		Для Каждого СтрокаМаркировка Из СтрокаТовары.КодыУпаковокМаркируемойПродукции Цикл
			НоваяСтрока = ЗаписываемыйОбъект.КодыУпаковокМаркируемойПродукции.Добавить();
			НоваяСтрока.ИдентификаторСтроки = СтрокаТовары.ИдентификаторСтроки;
			НоваяСтрока.НомерУпаковки = СтрокаМаркировка.Значение;
		КонецЦикла;
	КонецЦикла;
	
	Если ЗаписываемыйОбъект.ВидОперации = Перечисления.ВидыОпераций.Корректировка Тогда
		НовыеКодыУпаковок = ТаблицаКодовМаркировкиПоТаблицеТоваров(КоллекцияДанных, ЗаписываемыйОбъект,
			"КодыУпаковокМаркируемойПродукцииДоКорректировки");
		ОбновитьКодыМаркировкиВОбъекте(НовыеКодыУпаковок, ЗаписываемыйОбъект,
			"КодыУпаковокМаркируемойПродукцииДоКорректировки");

	КонецЕсли;
КонецПроцедуры

// Заполняет идентификаторы строк товаров перед записью объекта документа.
//
// Параметры:
//  Объект					 - ДокументОбъект - объект документа, в котором хранятся сведения по маркировке.
//  ТаблицыСИдентификаторами - Строка - имена таблиц, хранящих идентификаторы строк, перечисленные через запятую.
//
Процедура ИдентификаторыСтрокПередЗаписьюОбъекта(Объект, ТаблицыСИдентификаторами = "Товары") Экспорт
	
	ИменаТаблиц = СтрРазделить(ТаблицыСИдентификаторами, ",");
	ПараметрыПоиска = Новый Структура("ИдентификаторСтроки", "");
	
	Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
		Таблица = Объект[ИмяТаблицы];
		
		СтрокиСПустымиИдентификаторами = Таблица.НайтиСтроки(ПараметрыПоиска);
		Для Каждого СтрокаТаблицы Из СтрокиСПустымиИдентификаторами Цикл
			КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(СтрокаТаблицы);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеДоступом

// См. КоммерческиеПредложенияДокументыПереопределяемый.ПриЗаполненииВидовОграниченийПравОбъектовМетаданных.
//
Процедура ПриЗаполненииВидовОграниченийПравОбъектовМетаданных(ИмяОбъекта, Описание) Экспорт
	
	Если ИмяОбъекта = "Документ.КоммерческоеПредложениеКлиенту" Тогда
		
		Описание = Описание + "
		|Документ.КоммерческоеПредложениеКлиенту.Чтение.Организации
		|Документ.КоммерческоеПредложениеКлиенту.Изменение.Организации
		|";
		
	ИначеЕсли ИмяОбъекта = "Документ.КоммерческоеПредложениеПоставщика"  Тогда

		Описание = Описание + "
		|Документ.КоммерческоеПредложениеПоставщика.Чтение.Организации
		|Документ.КоммерческоеПредложениеПоставщика.Изменение.Организации
		|";
		
	ИначеЕсли ИмяОбъекта = "Документ.ЗапросКоммерческихПредложенийПоставщиков"  Тогда

		Описание = Описание + "
		|Документ.ЗапросКоммерческихПредложенийПоставщиков.Чтение.Организации
		|Документ.ЗапросКоммерческихПредложенийПоставщиков.Изменение.Организации
		|";
		
	ИначеЕсли ИмяОбъекта = "Документ.ЗапросКоммерческогоПредложенияОтКлиента"  Тогда
		
		Описание = Описание + "
		|Документ.ЗапросКоммерческогоПредложенияОтКлиента.Чтение.Организации
		|Документ.ЗапросКоммерческогоПредложенияОтКлиента.Изменение.Организации
		|";
		
	ИначеЕсли ИмяОбъекта = "Справочник.КоммерческоеПредложениеКлиентуПрисоединенныеФайлы" Тогда
		
		Описание = Описание + "
		|Справочник.КоммерческоеПредложениеКлиентуПрисоединенныеФайлы.Чтение.Организации
		|Справочник.КоммерческоеПредложениеКлиентуПрисоединенныеФайлы.Изменение.Организации
		|";
		
	ИначеЕсли ИмяОбъекта = "Справочник.КоммерческоеПредложениеПоставщикаПрисоединенныеФайлы" Тогда
		
		Описание = Описание + "
		|Справочник.КоммерческоеПредложениеПоставщикаПрисоединенныеФайлы.Чтение.Организации
		|Справочник.КоммерческоеПредложениеПоставщикаПрисоединенныеФайлы.Изменение.Организации
		|";
		
	ИначеЕсли ИмяОбъекта = "Справочник.ЗапросКоммерческихПредложенийПоставщиковПрисоединенныеФайлы" Тогда
		
		Описание = Описание + "
		|Справочник.ЗапросКоммерческихПредложенийПоставщиковПрисоединенныеФайлы.Чтение.Организации
		|Справочник.ЗапросКоммерческихПредложенийПоставщиковПрисоединенныеФайлы.Изменение.Организации
		|";
		
	ИначеЕсли ИмяОбъекта = "Справочник.ЗапросКоммерческогоПредложенияОтКлиентаПрисоединенныеФайлы" Тогда
		
		Описание = Описание + "
		|Справочник.ЗапросКоммерческогоПредложенияОтКлиентаПрисоединенныеФайлы.Чтение.Организации
		|";
		
	ИначеЕсли ИмяОбъекта = "Справочник.ОснованияЭлектронныхДокументовПоЗапросамКоммерческихПредложений" Тогда
		
		Описание = Описание + "
		|Справочник.ОснованияЭлектронныхДокументовПоЗапросамКоммерческихПредложений.Чтение.Организации
		|Справочник.ОснованияЭлектронныхДокументовПоЗапросамКоммерческихПредложений.Изменение.Организации
		|";
		
	КонецЕсли;
	
КонецПроцедуры

// См. КоммерческиеПредложенияДокументыПереопределяемый.ПриЗаполненииОграниченияДоступа.
//
Процедура ПриЗаполненииОграниченияДоступа(ИмяОбъекта, Ограничение) Экспорт
	
	Если ИмяОбъекта = "Документ.КоммерческоеПредложениеКлиенту" Тогда
		
		Ограничение.Текст =
		"РазрешитьЧтениеИзменение
		|ГДЕ
		|	ЗначениеРазрешено(Организация)";
		
	ИначеЕсли ИмяОбъекта = "Справочник.КоммерческоеПредложениеКлиентуПрисоединенныеФайлы" Тогда
		
		Ограничение.Текст =
		"РазрешитьЧтение
		|ГДЕ
		|	ЧтениеОбъектаРазрешено(ВладелецФайла)
		|;
		|РазрешитьИзменениеЕслиРазрешеноЧтение
		|ГДЕ
		|	ИзменениеОбъектаРазрешено(ВладелецФайла)";

		
	ИначеЕсли ИмяОбъекта = "Документ.КоммерческоеПредложениеПоставщика" Тогда
		
		Ограничение.Текст =
		"РазрешитьЧтениеИзменение
		|ГДЕ
		|	ЗначениеРазрешено(Организация)";
		
	ИначеЕсли ИмяОбъекта = "Справочник.КоммерческоеПредложениеПоставщикаПрисоединенныеФайлы" Тогда
		
		Ограничение.Текст =
		"РазрешитьЧтение
		|ГДЕ
		|	ЧтениеОбъектаРазрешено(ВладелецФайла)
		|;
		|РазрешитьИзменениеЕслиРазрешеноЧтение
		|ГДЕ
		|	ИзменениеОбъектаРазрешено(ВладелецФайла)";
		
	ИначеЕсли ИмяОбъекта = "Документ.ЗапросКоммерческихПредложенийПоставщиков"  Тогда
		
		Ограничение.Текст =
		"РазрешитьЧтениеИзменение
		|ГДЕ
		|	ЗначениеРазрешено(Организация)";
		
	ИначеЕсли ИмяОбъекта = "Справочник.ЗапросКоммерческихПредложенийПоставщиковПрисоединенныеФайлы"  Тогда
		
		Ограничение.Текст =
		"РазрешитьЧтение
		|ГДЕ
		|	ЧтениеОбъектаРазрешено(ВладелецФайла)
		|;
		|РазрешитьИзменениеЕслиРазрешеноЧтение
		|ГДЕ
		|	ИзменениеОбъектаРазрешено(ВладелецФайла)";
		
	ИначеЕсли ИмяОбъекта = "Документ.ЗапросКоммерческогоПредложенияОтКлиента"  Тогда
		
		Ограничение.Текст =
		"РазрешитьЧтениеИзменение
		|ГДЕ
		|	ЗначениеРазрешено(Организация)";
		
	ИначеЕсли ИмяОбъекта = "Справочник.ЗапросКоммерческогоПредложенияОтКлиентаПрисоединенныеФайлы" Тогда
		
		Ограничение.Текст =
		"РазрешитьЧтение
		|ГДЕ
		|	ЧтениеОбъектаРазрешено(ВладелецФайла)
		|;
		|РазрешитьИзменениеЕслиРазрешеноЧтение
		|ГДЕ
		|	ИзменениеОбъектаРазрешено(ВладелецФайла)";
		
	ИначеЕсли ИмяОбъекта = "Справочник.ОснованияЭлектронныхДокументовПоЗапросамКоммерческихПредложений" Тогда
		
		Ограничение.Текст =
		"РазрешитьЧтение
		|ГДЕ
		|	ЧтениеОбъектаРазрешено(ДокументВладелец)
		|;
		|РазрешитьИзменениеЕслиРазрешеноЧтение
		|ГДЕ
		|	ИзменениеОбъектаРазрешено(ДокументВладелец)";
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ГрупповоеИзменениеОбъектов

// См. ГрупповоеИзменениеОбъектовПереопределяемый.ПриОпределенииОбъектовСРедактируемымиРеквизитами.
Процедура ПриОпределенииОбъектовСРедактируемымиРеквизитами(Объекты) Экспорт
	
	Объекты.Вставить(Метаданные.Документы.СчетФактураПолученный.ПолноеИмя(), "РеквизитыНеРедактируемыеВГрупповойОбработке");
	Объекты.Вставить(Метаданные.Документы.СчетФактураВыданный.ПолноеИмя(), "РеквизитыНеРедактируемыеВГрупповойОбработке");
	Объекты.Вставить(Метаданные.Документы.СчетНаОплатуПоставщика.ПолноеИмя(), "РеквизитыНеРедактируемыеВГрупповойОбработке");
	Объекты.Вставить(Метаданные.Документы.СчетНаОплатуПокупателю.ПолноеИмя(), "РеквизитыНеРедактируемыеВГрупповойОбработке");
	Объекты.Вставить(Метаданные.Документы.РеализацияТоваровУслуг.ПолноеИмя(), "РеквизитыНеРедактируемыеВГрупповойОбработке");
	Объекты.Вставить(Метаданные.Документы.ПоступлениеТоваровУслуг.ПолноеИмя(), "РеквизитыНеРедактируемыеВГрупповойОбработке");
	Объекты.Вставить(Метаданные.Документы.ЗаказПоставщику.ПолноеИмя(), "РеквизитыНеРедактируемыеВГрупповойОбработке");
