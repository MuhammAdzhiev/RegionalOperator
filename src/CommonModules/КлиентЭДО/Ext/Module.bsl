// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных
// 
// Возвращаемое значение:
//  Булево
Функция ДляОбъектаМетаданныхОпределеныПодключаемыеКомандыКонтрагентов(ОбъектМетаданных) Экспорт
	Возврат ОбъектыМетаданныхДляКоторыхОпределеныПодключаемыеКомандыКонтрагентов().Найти(ОбъектМетаданных) <> Неопределено;
КонецФункции

// Обработчик при создании формы
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Параметры - Структура
//  Отказ - Булево
//  СтандартнаяОбработка - Булево
Процедура ПриСозданииНаСервере(Форма, Параметры, Отказ, СтандартнаяОбработка) Экспорт
	
	Если Не КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Обработка.ИнтерфейсДокументовЭДО.Форма.ТекущиеДелаПоЭДО" Тогда
		ИнтеграцияИСКЭДО.СостояниеГИСМТНастроитьФормуПриСоздании(
			Форма, "ВходящиеЭД", "ВходящиеЭДСостояниеЭДО", "ВходящиеЭДОтветственный");
	ИначеЕсли Форма.ИмяФормы = "Обработка.ИнтерфейсДокументовЭДО.Форма.ТекущиеДелаПоЭДОЛегкийИнтерфейс" Тогда
		ИнтеграцияИСКЭДО.СостояниеГИСМТНастроитьФормуПриСоздании(
			Форма, "ВходящиеЭлектронныеДокументы",
			"ВходящиеЭлектронныеДокументыСостояние", "ВходящиеЭлектронныеДокументыОтражениеВУчете");
	ИначеЕсли Форма.ИмяФормы = "Обработка.ИнтерфейсДокументовЭДО.Форма.ТекущиеДелаПоЭДОЛегкийКлиентЭДО" Тогда
		
		ИнтеграцияИСКЭДО.СостояниеГИСМТНастроитьФормуПриСоздании(
			Форма, "ВходящиеЭлектронныеДокументы", "ВходящиеЭлектронныеДокументыСостояние");
		ИнтеграцияИСКЭДО.СостояниеГИСМТНастроитьФормуПриСоздании(
			Форма, "ИсходящиеЭлектронныеДокументы", "ИсходящиеЭлектронныеДокументыСостояние");
		
		НовыйЭлемент = Форма.Элементы.Добавить("ЧерновикиСостояние", Тип("ПолеФормы"), Форма.Элементы.Черновики);
		НовыйЭлемент.ПутьКДанным = "Черновики.СостояниеЭДО";
		НовыйЭлемент.Заголовок = НСтр("ru = 'Состояние'");
		ИнтеграцияИСКЭДО.СостояниеГИСМТНастроитьФормуПриСоздании(
			Форма, "Черновики", "ЧерновикиСостояние");
		
		Если ЗначениеЗаполнено(Параметры.ТекущийРаздел) Тогда
			
			Форма.Элементы.ГруппаПанельНавигации.Видимость = Ложь;
			
			Если Параметры.ТекущийРаздел = "ВходящиеЭлектронныеДокументы" Тогда
				Форма.Заголовок = НСтр("ru = 'Входящие'");
			ИначеЕсли Параметры.ТекущийРаздел = "ИсходящиеЭлектронныеДокументы" Тогда
				Форма.Заголовок = НСтр("ru = 'Исходящие'");
			ИначеЕсли Параметры.ТекущийРаздел = "Черновики" Тогда
				Форма.Заголовок = НСтр("ru = 'Черновики'");
			КонецЕсли;
			
			Форма.НавигационнаяСсылка = "";
			
		КонецЕсли;
		
		Форма.Элементы.ВходящиеЭлектронныеДокументыСостояние.Заголовок  = НСтр("ru = 'Состояние'");
		Форма.Элементы.ИсходящиеЭлектронныеДокументыСостояние.Заголовок = НСтр("ru = 'Состояние'");
		
	КонецЕсли;
	
	СобытияФормИС.ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка, Неопределено);
	
КонецПроцедуры

Процедура ДинамическийСписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки) Экспорт
	
	Если Не КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяЭлемента = "ВходящиеЭД"
		Или ИмяЭлемента = "ВходящиеЭлектронныеДокументы"
		Или ИмяЭлемента = "ИсходящиеЭлектронныеДокументы" Тогда
		СоответствиеТребованиямГИСМТ.ПриПолученииДанныхНаСервереДокумента(Строки, "ЭлектронныйДокумент");
		ПриПолученииДанныхДинамическогоСпискаСтатусаФискализации(Строки, "ЭлектронныйДокумент");
	ИначеЕсли ИмяЭлемента = "Черновики" Тогда
		СоответствиеТребованиямГИСМТ.ПриПолученииДанныхНаСервереДокумента(Строки, "Документ");
		ПриПолученииДанныхДинамическогоСпискаСтатусаФискализации(Строки, "Документ");
	КонецЕсли;
	
КонецПроцедуры

#Область РегламентныеЗадания

// Устанавливает использование регламентного задания
// 
// Параметры:
//  РегламентноеЗадание - ОбъектМетаданных - Метаданные регламентного задания.
//  Использование       - Булево           - Признак использования регламентного задания.
Процедура УстановитьАктивностьРегламентногоЗадания(Знач РегламентноеЗадание, Знач Использование) Экспорт
	
	// Изменяемые параметры
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("Использование", Использование);
	
	// Параметры поиска
	ОтборЗаданий = Новый Структура;
	ОтборЗаданий.Вставить("Метаданные", РегламентноеЗадание);
	
	// Найденные задания
	Задания = РегламентныеЗаданияСервер.НайтиЗадания(ОтборЗаданий);
	
	Для Каждого Задание Из Задания Цикл
		Если Задание.Использование = Использование Тогда
			Продолжить;
		КонецЕсли;
		
		РегламентныеЗаданияСервер.ИзменитьЗадание(Задание.УникальныйИдентификатор, ПараметрыЗадания);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Если Не ВнешнееСоединение Тогда

// Параметры:
//  ФормаДляУстановки - Строка
//  ТребуетсяОбновлениеИнтерфейса - Булево
Процедура УстановитьФормуНачальнойСтраницейПриложения(Знач ФормаДляУстановки, ТребуетсяОбновлениеИнтерфейса) Экспорт
	
	КлючОбъектаХраненияНачальнойСтраницы = "НастройкиНачальнойСтраницыКЭДО";
	КлючОбъектаНачальнойСтраницы = "Общее/НастройкиНачальнойСтраницы";
	НачальнаяСтраницаНастройки = ХранилищеСистемныхНастроек.Загрузить(КлючОбъектаНачальнойСтраницы);

	Если ФормаУстановленаНаНачальнойСтранице(НачальнаяСтраницаНастройки, ФормаДляУстановки) Тогда
		Возврат;
	КонецЕсли;
	
	ТребуетсяОбновлениеИнтерфейса = Истина;
	
	ПустаяФорма = ФормаПустойРабочийСтол();
	
	КлючОбъектаНачальнойСтраницыПередОчисткой = "Общее/НастройкиНачальнойСтраницыПередОчисткой";
	КлючОбъектаХраненияПриложения = "НастройкиИнтерфейсаКлиентскогоПриложенияКЭДО";
	КлючОбъектаПриложения = КлючОбъектаПриложения();
	
	СохраненныеНастройкиНачальнойСтраницы = ХранилищеСистемныхНастроек.Загрузить(
		КлючОбъектаХраненияНачальнойСтраницы);
	
	НастройкиПриложения = ХранилищеСистемныхНастроек.Загрузить(КлючОбъектаПриложения, "");
	СохраненныеНастройкиПриложения = ХранилищеСистемныхНастроек.Загрузить(КлючОбъектаХраненияПриложения, "");

	Если Не ФормаУстановленаНаНачальнойСтранице(НачальнаяСтраницаНастройки, ПустаяФорма) Тогда
		ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаХраненияНачальнойСтраницы, "", НачальнаяСтраницаНастройки);
		ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаХраненияПриложения, "", НастройкиПриложения);
	Иначе
		ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаНачальнойСтраницыПередОчисткой, "",
			СохраненныеНастройкиНачальнойСтраницы);
		ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаХраненияНачальнойСтраницы, "",
			СохраненныеНастройкиНачальнойСтраницы);
		Если СохраненныеНастройкиПриложения = Неопределено Тогда
			ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаХраненияПриложения, "", НастройкиПриложения);
		Иначе
			ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаХраненияПриложения, "", СохраненныеНастройкиПриложения);
		КонецЕсли;
	КонецЕсли;

	НачальнаяСтраница = Новый НастройкиНачальнойСтраницы;
	СоставФорм = Новый СоставФормНачальнойСтраницы;
	СоставФорм.ЛеваяКолонка.Добавить(ФормаДляУстановки);
	НачальнаяСтраница.УстановитьСоставФорм(СоставФорм);

	ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаНачальнойСтраницы, "", НачальнаяСтраница);

КонецПроцедуры

// Сбросить настройки интерфейса приложения.
//
Процедура СброситьНастройкиИнтерфейсаПриложения() Экспорт
	
	КлючОбъектаПриложения = КлючОбъектаПриложения();
	
	Настройки = Новый НастройкиИнтерфейсаКлиентскогоПриложения;
	НастройкиСостава = Новый НастройкиСоставаИнтерфейсаКлиентскогоПриложения;
	Настройки.УстановитьСостав(НастройкиСостава);

	ХранилищеСистемныхНастроек.Сохранить(КлючОбъектаПриложения, "", Настройки);
	
КонецПроцедуры
	
// Возвращаемое значение:
//  НастройкиИнтерфейсаКлиентскогоПриложения
Функция НастройкиИнтерфейсаПоУмолчанию()
	
	Настройки = Новый НастройкиИнтерфейсаКлиентскогоПриложения;
	НастройкиСостава = Новый НастройкиСоставаИнтерфейсаКлиентскогоПриложения;
	
	Если НастройкиКлиентЭДО.ИспользуетсяЛегкийКлиентЭДО() Тогда
		
		Если КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
			НастройкиСостава.Верх.Добавить(Новый ЭлементНастройкиСоставаИнтерфейсаКлиентскогоПриложения("ПанельОткрытых"));
			Лево = Новый ГруппаНастройкиСоставаИнтерфейсаКлиентскогоПриложения;
			Лево.Добавить(Новый ЭлементНастройкиСоставаИнтерфейсаКлиентскогоПриложения("ПанельРазделов"));
			НастройкиСостава.Лево.Добавить(Лево);
		Иначе
			НастройкиСостава.Низ.Добавить(Новый ЭлементНастройкиСоставаИнтерфейсаКлиентскогоПриложения("ПанельОткрытых"));
		КонецЕсли;
		
	Иначе
		
		НастройкиСостава.Верх.Добавить(Новый ЭлементНастройкиСоставаИнтерфейсаКлиентскогоПриложения("ПанельОткрытых"));
		Лево = Новый ГруппаНастройкиСоставаИнтерфейсаКлиентскогоПриложения;
		Лево.Добавить(Новый ЭлементНастройкиСоставаИнтерфейсаКлиентскогоПриложения("ПанельРазделов"));
		Лево.Добавить(Новый ЭлементНастройкиСоставаИнтерфейсаКлиентскогоПриложения("ПанельФункцийТекущегоРаздела"));
		
		НастройкиСостава.Лево.Добавить(Лево);
		
	КонецЕсли;
	
	Настройки.УстановитьСостав(НастройкиСостава);
	
	Возврат Настройки;
	
КонецФункции

#КонецЕсли // ВнешнееСоединение

