// См. КлассификаторКТРУКлиентПереопределяемый.ВыполнитьПереопределяемуюКоманду
Процедура ВыполнитьПереопределяемуюКоманду(Форма, Команда) Экспорт
	
	Если Форма.ИмяФормы = "Справочник.КТРУ.Форма.ДобавлениеЭлементовВКлассификатор"
		И Команда = Форма.Команды.ЗагрузитьОКПД2 Тогда
		
		ТекущиеДанные = Форма.Элементы.КодыОКПД2.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Или ЗначениеЗаполнено(ТекущиеДанные.ОКПД2) Тогда
			Возврат;
		КонецЕсли;
		
		// Реализация выполнения команды ЗагрузитьОКПД2.
		
	КонецЕсли;
	
КонецПроцедуры

