#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

#Область ИнтерфейсДокументовЭДО

// Вызывает оповещение форм учетных документов о событии изменения связанных документов. 
// 
// Параметры:
//  СвязанныеДокументы - Массив Из ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО
Процедура ОповеститьОбИзмененииСвязанныхДокументовОснованийЭлектронныхДокументов(СвязанныеДокументы) Экспорт
	
	Для Каждого СвязанныйДокумент Из СвязанныеДокументы Цикл
		Оповестить(ИмяСобытияИзменениеСвязанныхДокументов(), СвязанныйДокумент);
	КонецЦикла;

КонецПроцедуры

// Определяет открываемую форму ручного формирования ответного титула.
// 
// Параметры:
//  ФормаРучногоФормированияОтветногоТитула - Строка - См. ИнтерфейсДокументовЭДОКлиентСервер.ФормыРучногоФормированияТитула
Процедура ПриОпределенииОткрываемойФормыРучногоФормированияОтветногоТитула(
	ФормаРучногоФормированияОтветногоТитула) Экспорт
	
	Если КлиентЭДОВызовСервера.ИспользуетсяЛегкийКлиентЭДО() Тогда
		ФормаРучногоФормированияОтветногоТитула =
			ОбменСКонтрагентамиКлиент.ФормыРучногоФормированияТитула().ЛегкийКлиентЭДО;
	КонецЕсли;
	
КонецПроцедуры

#Область ПакетыДокументовЭДО

// Oпределяет необходимость вывода окна с заполнением реквизитов произвольного документа при добавлении в пакет
// файла с компьютера.
// 
// Параметры:
//  ЗаполнятьЗначениямиПоУмолчанию - Булево
//
Процедура ПриОпределенииСпособаВводаРеквизитовПриДобавленииВПакетФайлаСКомпьютера(
	ЗаполнятьЗначениямиПоУмолчанию) Экспорт
	
	Если КлиентЭДОВызовСервера.ИспользуетсяЛегкийКлиентЭДО() Тогда
		ЗаполнятьЗначениямиПоУмолчанию = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти // ПакетыДокументовЭДО

#КонецОбласти // ИнтерфейсДокументовЭДО

#КонецОбласти // ДляВызоваИзДругихПодсистем

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныйПрограммныйИнтерфейс

// Определяет использовать ли новую форму подключения учетной записи
//
// Параметры:
//  ИспользоватьЛегкийКлиентЭДО - Булево
Процедура ПриОпределенииИнтерфейсаПомощникаПодключения(ИспользоватьЛегкийКлиентЭДО) Экспорт
	
	Если КлиентЭДОВызовСервера.ИспользуетсяЛегкийКлиентЭДО() Тогда
		ИспользоватьЛегкийКлиентЭДО = Истина;
	КонецЕсли;
	
КонецПроцедуры

#Область ПанельДополнительногоСостояния

// Возвращаемое значение:
//  Строка
Функция ИмяСобытияИзменениеОбщегоСостоянияДокумента() Экспорт
	Возврат "ОбновитьОбщееСостояниеДокументаКЭДО";
КонецФункции

// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * КомандыДополнительногоСостояния - Неопределено
//                                    - ФиксированныйМассив Из Структура:
//                                      * Идентификатор - Строка
//                                      * Представление - Строка
//                                      * Обработчик - Строка
//                                      * Порядок - Число
Процедура ДополнительноеСостояниеОбработкаНажатия(Форма) Экспорт
	
	Если Не ЗначениеЗаполнено(Форма.КомандыДополнительногоСостояния) Тогда
		Возврат;
	КонецЕсли;
	
	ОбработчикКоманды = Неопределено;
	Значение          = Неопределено;
	ИдентификаторКоманды = СтрЗаменить(Форма.ТекущийЭлемент.Имя, "ДополнительноеСостояние_", "");
	Для Каждого СвязаннаяКоманда Из Форма.КомандыДополнительногоСостояния Цикл
		Если СвязаннаяКоманда.Идентификатор = ИдентификаторКоманды Тогда
			ОбработчикКоманды = СвязаннаяКоманда.Обработчик;
			Значение          = СвязаннаяКоманда.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(ОбработчикКоманды) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОповещения = Новый Структура("Форма", Форма);
	Оповещение = ОбщегоНазначенияБЭДКлиент.ОписаниеОповещенияПоПутиКОбработчику(ОбработчикКоманды, ПараметрыОповещения);
	ВыполнитьОбработкуОповещения(Оповещение, Значение);
	
КонецПроцедуры

#КонецОбласти // ПанельДополнительногоСостояния

#Область ПанельСвязанныхДокументов

// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  Объект - ДанныеФормыСтруктура:
//  * ДокументОснование - ДокументСсылка
//  * Основание - ДокументСсылка
//  * СчетФактураОснование - ДокументСсылка
//  * ДокументыОснования - ТабличнаяЧасть:
//  ** ДокументОснование - ДокументСсылка
Процедура ОповеститьОбИзмененииСвязанныхДокументов(Форма) Экспорт
	
	Объект = Форма.Объект;
	СвязанныеДокументы = Новый Массив; // Массив Из ДокументСсылка
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "Основание")
		И ЗначениеЗаполнено(Объект.Основание) Тогда
		СвязанныеДокументы.Добавить(Объект.Основание);
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ДокументОснование")
		И ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		СвязанныеДокументы.Добавить(Объект.ДокументОснование);
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "СчетФактураОснование")
		И ЗначениеЗаполнено(Объект.СчетФактураОснование) Тогда
		СвязанныеДокументы.Добавить(Объект.СчетФактураОснование);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ДокументыОснования") Тогда
		Для Каждого ДанныеОснования Из Объект.ДокументыОснования Цикл
			СвязанныеДокументы.Добавить(ДанныеОснования.ДокументОснование);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого СвязанныйДокумент Из СвязанныеДокументы Цикл
		Оповестить(ИмяСобытияИзменениеСвязанныхДокументов(), СвязанныйДокумент);
	КонецЦикла;
	
	ОбменСКонтрагентамиКлиент.ОповеститьОбИзмененииСвязанныхДокументовОснованийЭлектронныхДокументов(СвязанныеДокументы);
	
КонецПроцедуры

// Возвращаемое значение:
//  Строка
Функция ИмяСобытияИзменениеСвязанныхДокументов() Экспорт
	Возврат "ОбновитьСвязанныеДокументыКЭДО";
КонецФункции

// Параметры:
//  СвязанныйДокумент - ЛюбаяСсылка
Процедура ОткрытьСвязанныйДокумент(СвязанныйДокумент) Экспорт
	
	ПоказатьЗначение(, СвязанныйДокумент);
	
КонецПроцедуры

// Параметры:
//  СвязанныеДокументы - СписокЗначений Из ЛюбаяСсылка
Процедура ОткрытьСписокСвязанныхДокументов(СвязанныеДокументы) Экспорт
	
	ПараметрыФормы = Новый Структура("СвязанныеДокументы", СвязанныеДокументы);
	ОткрытьФорму("ОбщаяФорма.СвязанныеДокументыБЭД", ПараметрыФормы);
	
КонецПроцедуры

// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * КомандыСозданияСвязанныхДокументов - Неопределено
//                                       - ФиксированныйМассив Из Структура:
//                                         * Идентификатор - Строка
//                                         * Представление - Строка
//                                         * Обработчик - Строка
//                                         * Порядок - Число
Процедура СоздатьСвязанныйДокумент(Форма) Экспорт

	Если Не ЗначениеЗаполнено(Форма.КомандыСозданияСвязанныхДокументов) Тогда
		Возврат;
	КонецЕсли;
	
	ОбработчикКоманды = Неопределено;
	Значение          = Неопределено;
	ИдентификаторКоманды = СтрЗаменить(Форма.ТекущийЭлемент.Имя, "СоздатьСвязанныйДокумент_", "");
	Для Каждого СвязаннаяКоманда Из Форма.КомандыСозданияСвязанныхДокументов Цикл
		Если СвязаннаяКоманда.Идентификатор = ИдентификаторКоманды Тогда
			ОбработчикКоманды = СвязаннаяКоманда.Обработчик;
			Значение          = СвязаннаяКоманда.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(ОбработчикКоманды) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОповещения = Новый Структура("Форма", Форма);
	Оповещение = ОбщегоНазначенияБЭДКлиент.ОписаниеОповещенияПоПутиКОбработчику(ОбработчикКоманды, ПараметрыОповещения);
	ВыполнитьОбработкуОповещения(Оповещение, Значение);
	
КонецПроцедуры

#КонецОбласти // ПанельСвязанныхДокументов

#КонецОбласти