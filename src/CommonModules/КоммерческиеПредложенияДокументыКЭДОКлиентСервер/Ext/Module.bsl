////////////////////////////////////////////////////////////////////////////////
// Подсистема "Клиент ЭДО".
// ОбщийМодуль.КоммерческиеПредложенияДокументыКЭДОКлиентСервер.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// См. КоммерческиеПредложенияДокументыКлиентПереопределяемый.ПриИзмененииСуммыНДС.
//
Процедура ПриИзмененииСуммыНДС(Форма, ТекущаяСтрока, ЦенаВключаетНДС, ТребуетсяСерверныйВызов) Экспорт
	
	ТекущаяСтрока.СуммаСНДС = ТекущаяСтрока.Сумма + ?(ЦенаВключаетНДС, 0, ТекущаяСтрока.СуммаНДС);
	
КонецПроцедуры

// См. КоммерческиеПредложенияДокументыКлиентПереопределяемый.ПриИзмененииНалогообложенияНДС.
//
Процедура ПриИзмененииНалогообложенияНДС(Форма, ТребуетсяСерверныйВызов) Экспорт
	
	Если ТипЗнч(Форма.Объект.Ссылка) = Тип("ДокументСсылка.КоммерческоеПредложениеКлиенту") Тогда
		
		Если Форма.Объект.Налогообложение Тогда
			
			Если Форма.Объект.Товары.Количество() > 0 Тогда
				
				МассивНоменклатуры = Новый Массив;
				Для Каждого СтрокаТовары Из Форма.Объект.Товары Цикл
					Если ЗначениеЗаполнено(СтрокаТовары.Номенклатура) Тогда
						МассивНоменклатуры.Добавить(СтрокаТовары.Номенклатура);
					КонецЕсли;
				КонецЦикла;
				
				ДанныеПоСтавкамНДС = КоммерческиеПредложенияДокументыКЭДОВызовСервера.СтавкиНДСДляМассиваНоменклатуры(МассивНоменклатуры);
				
				Для Каждого СтрокаТовары Из Форма.Объект.Товары Цикл
					
					Если Не ЗначениеЗаполнено(СтрокаТовары.Номенклатура) Тогда
						Продолжить;
					КонецЕсли;
					
					СтрокаТовары.СтавкаНДС = ДанныеПоСтавкамНДС.Получить(СтрокаТовары.Номенклатура);
					КлиентЭДОКлиентСервер.ПриИзмененииСтавкаНДС(СтрокаТовары, Форма.Объект.ЦенаВключаетНДС, Форма.Объект.Налогообложение);
					
				КонецЦикла;
				
			КонецЕсли;
			
		Иначе
			
			Для Каждого СтрокаТовары Из Форма.Объект.Товары Цикл
				
				СтрокаТовары.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
				КлиентЭДОКлиентСервер.ПриИзмененииСтавкаНДС(СтрокаТовары, Форма.Объект.ЦенаВключаетНДС, Форма.Объект.Налогообложение);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 

// См. КоммерческиеПредложенияДокументыКлиентПереопределяемый.ПриИзмененииПроцентаРучнойСкидки.
//
Процедура ПриИзмененииПроцентаРучнойСкидки(Форма, ТекущаяСтрока, ЦенаВключаетНДС, НалогообложениеНДС, ТребуетсяСерверныйВызов = Ложь) Экспорт
	
	ТекущаяСтрока.СуммаРучнойСкидки = Окр(ТекущаяСтрока.Количество *ТекущаяСтрока.Цена * ТекущаяСтрока.ПроцентРучнойСкидки / 100, 2);
	ТекущаяСтрока.Сумма             = ТекущаяСтрока.Цена * ТекущаяСтрока.Количество;
	ТекущаяСтрока.Сумма             = ТекущаяСтрока.Сумма - ТекущаяСтрока.СуммаРучнойСкидки;
	КлиентЭДОКлиентСервер.ПриИзмененииСтавкаНДС(ТекущаяСтрока, ЦенаВключаетНДС, НалогообложениеНДС);
	
КонецПроцедуры

// См. КоммерческиеПредложенияДокументыКлиентПереопределяемый.ПриВыполненииКомандыОтменитьРучныеСкидки.
//
Процедура ПриВыполненииКомандыОтменитьРучныеСкидки(Форма, ВыделенныеСтроки, ЦенаВключаетНДС, НалогообложениеНДС, ТребуетсяСерверныйВызов) Экспорт
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		
		ДанныеСтроки = Форма.Элементы.Товары.ДанныеСтроки(ВыделеннаяСтрока);
		Если ДанныеСтроки.ПроцентРучнойСкидки <> 0 Тогда
			ДанныеСтроки.ПроцентРучнойСкидки = 0;
			ПриИзмененииПроцентаРучнойСкидки(Форма, ДанныеСтроки, ЦенаВключаетНДС, НалогообложениеНДС, Ложь);
		КонецЕсли;
		
	КонецЦикла;
	
	Форма.ПодключитьОбработчикОжидания("Подключаемый_РассчитатьИтоговыеПоказателиФормы", 0.1, Истина);
	
КонецПроцедуры

// См. КоммерческиеПредложенияДокументыКлиентПереопределяемый.ПриИзмененииСуммыРучнойСкидки.
//
Процедура ПриИзмененииСуммыРучнойСкидки(Форма, ТекущаяСтрока, ЦенаВключаетНДС, НалогообложениеНДС, ТребуетсяСерверныйВызов) Экспорт
	
	ТекущаяСтрока.Сумма               = ТекущаяСтрока.Цена * ТекущаяСтрока.Количество;
	Если ТекущаяСтрока.СуммаРучнойСкидки > ТекущаяСтрока.Сумма Тогда
		ТекущаяСтрока.СуммаРучнойСкидки = ТекущаяСтрока.Сумма;
	КонецЕсли;
	Если ТекущаяСтрока.Сумма <> 0 Тогда
		ТекущаяСтрока.ПроцентРучнойСкидки = Окр(100 * ТекущаяСтрока.СуммаРучнойСкидки / (ТекущаяСтрока.Количество *ТекущаяСтрока.Цена), 2);
	Иначе
		ТекущаяСтрока.ПроцентРучнойСкидки = 0;
	КонецЕсли;
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Сумма - ТекущаяСтрока.СуммаРучнойСкидки;
	КлиентЭДОКлиентСервер.ПриИзмененииСтавкаНДС(ТекущаяСтрока, ЦенаВключаетНДС, НалогообложениеНДС);
	
КонецПроцедуры

// См. КоммерческиеПредложенияДокументыКлиентСерверПереопределяемый.СформироватьПредставлениеСостоянияПоСтатусу.
//
Процедура СформироватьПредставлениеСостоянияПоСтатусу(Форма, Статус, ТекущаяДата, ТребуетсяСерверныйВызов = Ложь) Экспорт
	
	Состояние = "";
	СрокДействия = Форма.Объект.СрокДействия;
	
	Если Статус = ПредопределенноеЗначение("Перечисление.СтатусыКоммерческихПредложенийКлиентам.НеСогласовано") Тогда
		Состояние = НСтр("ru = 'На согласовании.'");
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыКоммерческихПредложенийКлиентам.Черновик") Тогда
		Состояние = НСтр("ru = 'Подготавливается.'");
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыКоммерческихПредложенийКлиентам.Действует") Тогда
		
		Если СрокДействия >= ТекущаяДата Тогда
			Состояние = НСтр("ru = 'Действует.'");
		Иначе
			Состояние = НСтр("ru = 'Срок действия окончен.'");
		КонецЕсли;
		
	КонецЕсли;
	
	Форма.Элементы.Состояние.Заголовок = Состояние;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Обрабатывает изменение цены или количества в строке табличной части документа.
//
// Параметры:
//  Форма           - ФормаКлиентскогоПриложения - форма, в которой произошло событие,
//  ТекущаяСтрока   - СтрокаТабличнойЧасти - строка, в которой происходят изменения,
//  ЦенаВключаетНДС - Булево - признак включения в цену НДС,
//  Булево          - НалогообложениеНДС - признак того, что продажа облагается НДС,
//
Процедура ПриИзмененииКоличествоЦенаСУчетомРучнойСкидки(Форма, ТекущаяСтрока, ЦенаВключаетНДС, НалогообложениеНДС) Экспорт

	ТекущаяСтрока.Сумма = ТекущаяСтрока.Цена * ТекущаяСтрока.Количество;
	ПриИзмененииПроцентаРучнойСкидки(Форма, ТекущаяСтрока, ЦенаВключаетНДС, НалогообложениеНДС);
	
КонецПроцедуры

#КонецОбласти


