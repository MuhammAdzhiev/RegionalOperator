#Область СлужебныйПрограммныйИнтерфейс

// Замена ставки НДС 20% на 22% для России с 01.01.2026
Процедура УстановкаСтавкиНДС22() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ЗаменаСтавкиНДС);
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
		УровеньЖурналаРегистрации.Информация, , ,
		НСтр("ru = 'Начат процесс замены ставки НДС 20% на 22% с 01.01.2026 г.'"));
		
	СписокСправочников = Новый СписокЗначений();
	СписокСправочников.Добавить("Номенклатура"); 
	СписокСправочников.Добавить("ВидыНоменклатуры");
	СписокСправочников.Добавить("ДоговорыКонтрагентов");
	
	ПараметрыПолученияДанных = Обработки.ЗаменаСтавокНДС.ПараметрыПолученияДанных();
	ПараметрыПолученияДанных.ТекущаяСтавка = Перечисления.СтавкиНДС.НДС20;
	ПараметрыПолученияДанных.НоваяСтавка   = Перечисления.СтавкиНДС.НДС22;
	ПараметрыПолученияДанных.СписокСправочников = СписокСправочников;
	ПараметрыПолученияДанных.ЭтоПолныйПереход = Истина;
	
	ЗаменитьСтавкуНДС(ПараметрыПолученияДанных);
		
	ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
		УровеньЖурналаРегистрации.Информация, , ,
		НСтр("ru = 'Закончено выполнение регламентной операции Замена ставки НДС 20% на 22% с 01.01.2026 г.'"));
		
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Процедура - заменяет ставку НДС в справочниках
// Параметры:
//  ПараметрыПолученияДанных - см. Обработки.ЗаменаСтавокНДС.ПараметрыПолученияДанных
//
Процедура ЗаменитьСтавкуНДС(ПараметрыПолученияДанных) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущаяСтавка", ПараметрыПолученияДанных.ТекущаяСтавка);
	
	МассивТекстовЗапросов = Новый Массив;
	
	Для Каждого Справочник Из ПараметрыПолученияДанных.СписокСправочников Цикл
		
		ТекстЗапросДляСправочников = ТекстЗапросаОбъектыДляЗамены();
		ТекстЗапросДляСправочников = СтрЗаменить(ТекстЗапросДляСправочников, "%Параметр%", Справочник.Значение);
		МассивТекстовЗапросов.Добавить(ТекстЗапросДляСправочников); 

	КонецЦикла;
	
	Если МассивТекстовЗапросов.Количество() Тогда
		
		Соединитель = "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|";
		
		ТекстЗапроса = СтрСоединить(МассивТекстовЗапросов, Соединитель);
		Запрос.Текст = ТекстЗапроса;
		РезультатЗапроса = Запрос.Выполнить();
		
		Если ПараметрыПолученияДанных.ЭтоПолныйПереход И РезультатЗапроса.Пустой() Тогда
			ВыполняемоеЗадание = Метаданные.РегламентныеЗадания.ЗаменаСтавкиНДС;
			КлиентЭДО.УстановитьАктивностьРегламентногоЗадания(ВыполняемоеЗадание, Ложь);
			Возврат;
		КонецЕсли;
		
		ВыборкаЭлементов = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаЭлементов.Следующий() Цикл
			
			Если Не ЗначениеЗаполнено(ВыборкаЭлементов.Ссылка) Тогда
				Продолжить;
			КонецЕсли;
			
			НачатьТранзакцию();
			
			Попытка
				
				СменитьСтавкуНДСЭлементаСправочника(
					ВыборкаЭлементов.Ссылка, ПараметрыПолученияДанных.НоваяСтавка, ПараметрыПолученияДанных.ТекущаяСтавка);
				ЗафиксироватьТранзакцию();
				
			Исключение
				
				ОтменитьТранзакцию();
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Замена ставок НДС.'", ОбщегоНазначения.КодОсновногоЯзыка()),
					УровеньЖурналаРегистрации.Ошибка, , , ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстЗапросаОбъектыДляЗамены()
		
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	Справочник.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.%Параметр% КАК Справочник
	|ГДЕ
	|	Справочник.СтавкаНДС = &ТекущаяСтавка
	|	И НЕ Справочник.ПометкаУдаления
	|";
		
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура СменитьСтавкуНДСЭлементаСправочника(ЭлементСправочника, СтавкаНДС, ТекущаяСтавкаНДС)
	
	Если ЭлементСправочника.СтавкаНДС <> ТекущаяСтавкаНДС Тогда
		Возврат;
	КонецЕсли;
	
	ЗаблокироватьДанныеДляРедактирования(ЭлементСправочника);
	ОбъектСправочника = ОбщегоНазначенияБЭД.ОбъектПоСсылкеДляИзменения(ЭлементСправочника);
	ОбъектСправочника.СтавкаНДС = СтавкаНДС;
	ОбъектСправочника.ОбменДанными.Загрузка = Истина;
	
	ОбъектСправочника.Записать();
	
КонецПроцедуры

#КонецОбласти