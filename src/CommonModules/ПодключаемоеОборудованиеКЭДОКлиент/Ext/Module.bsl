#Область ПрограммныйИнтерфейс

Процедура ПробитьЧекПодключаемый(ПараметрКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	Если НЕ ПараметрыВыполненияКоманды.Форма.Объект.Проведен ИЛИ ПараметрыВыполненияКоманды.Форма.Модифицированность Тогда
		ТекстВопроса = НСтр("ru = 'Пробитие чека возможно только после проведения документа,
		|Выполнить проведение документа и продолжить?'");
		Контекст = Новый Структура("ПараметрКоманды,ПараметрыВыполненияКоманды", ПараметрКоманды,ПараметрыВыполненияКоманды);
		Обработчик = Новый ОписаниеОповещения(
		"ПробитьЧекПослеПодтверждениеПроведения", ПодключаемоеОБорудованиеКЭДОКлиент, Контекст);
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		ПоказатьВопрос(Обработчик, ТекстВопроса, Кнопки);
	Иначе
		ПробитьЧекПослеПроведения(ПараметрКоманды, ПараметрыВыполненияКоманды);
	КонецЕсли;
	
КонецПроцедуры 

Процедура ПробитьЧекПослеПодтверждениеПроведения(Результат, Контекст) Экспорт
	
	ДокументПроведен = Ложь;
	Если Результат = КодВозвратаДиалога.Да Тогда
		Попытка
			ДокументПроведен = Контекст.ПараметрыВыполненияКоманды.Форма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
		Исключение
			ПоказатьПредупреждение(,НСтр("ru = 'Не удалось выполнить проведение документа'"));
		КонецПопытки;
		
		Если ДокументПроведен Тогда
			Если Контекст.ПараметрКоманды.Количество() > 0 Тогда
				Если Не ЗначениеЗаполнено(Контекст.ПараметрКоманды[0]) Тогда
					Контекст.ПараметрКоманды[0] = Контекст.ПараметрыВыполненияКоманды.Форма.Объект.Ссылка;
				КонецЕсли;
			КонецЕсли;
			ПробитьЧекПослеПроведения(Контекст.ПараметрКоманды, Контекст.ПараметрыВыполненияКоманды);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПробитьЧекПослеПроведения(ПараметрКоманды, ПараметрыВыполненияКоманды) Экспорт

	ПараметрыФискализации = Новый Структура;
	ПараметрыФискализации.Вставить("УникальныйИдентификаторФормы", ПараметрыВыполненияКоманды.Форма.УникальныйИдентификатор);
	ПараметрыФискализации.Вставить("ИдентификаторОборудования", ПараметрыВыполненияКоманды.Форма.Устройство);
	ПараметрыФискализации.Вставить("ДокументОснование", ПараметрКоманды[0]);
	Если ПараметрыВыполненияКоманды.Свойство("СостояниеДокументаОснования") Тогда
		ПараметрыФискализации.Вставить("СостояниеДокументаОснования", ПараметрыВыполненияКоманды.СостояниеДокументаОснования);
	КонецЕсли;
	
	ОбщиеПараметры = ПодключаемоеОборудованиеКЭДОВызовСервера.ДанныеДляФискализацииДокумента(ПараметрыФискализации);
	
	Если Не ЗначениеЗаполнено(ОбщиеПараметры) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ОбщиеПараметры", ОбщиеПараметры);
	ПараметрыОповещения.Вставить("Форма", ПараметрыВыполненияКоманды.Форма);
	ПараметрыОповещения.Вставить("ДокументОснование", ПараметрКоманды[0]);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ФискализироватьЧекПослеПроверкиКодовМаркировки", ЭтотОбъект, ПараметрыОповещения);
	
	ПроверитьКодыМаркировки(ОбщиеПараметры, ПараметрыВыполненияКоманды.Форма, ОповещениеОЗавершении);
	
КонецПроцедуры

Процедура ФискализироватьЧекПослеПроверкиКодовМаркировки(Результат, ПараметрыВыполненияКоманды) Экспорт
	
	Если НЕ Результат.ВыполнитьФискализацию Тогда
		
		ТекстСообщения = НСтр(
		"ru = 'При фискализации документа возникла ошибка.
		|Чек не фискализирован.
		|Дополнительное описание:
		|%ДополнительноеОписание%'");
		
		ТекстСообщения = СтрЗаменить(
		ТекстСообщения,
		"%ДополнительноеОписание%",
		Результат.ТекстОшибки);
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
		Возврат;
		
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ПараметрыВыполненияКоманды.Форма);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина; 
	
	ПараметрыФискализации = Новый Структура;
	ПараметрыФискализации.Вставить("ДокументОснование", ПараметрыВыполненияКоманды.ДокументОснование);
	ПараметрыФискализации.Вставить("ПараметрыОперации", ПараметрыВыполненияКоманды.ОбщиеПараметры); 
	ПараметрыФискализации.Вставить("УникальныйИдентификатор", ПараметрыВыполненияКоманды.Форма.УникальныйИдентификатор);
	ПараметрыФискализации.Вставить("ИдентификаторУстройства", ПараметрыВыполненияКоманды.Форма.Устройство);
	
	РезультатВыполнения = ПодключаемоеОборудованиеКЭДОВызовСервера.ФискализироватьЧекВОблаке(ПараметрыФискализации);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", ПараметрыВыполненияКоманды.Форма);
	ДополнительныеПараметры.Вставить("ДокументОснование", ПараметрыВыполненияКоманды.ДокументОснование);
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения(
	"ФискализироватьЧекЗавершение", 
	ЭтотОбъект,
	ДополнительныеПараметры);
	
	Если РезультатВыполнения.Статус <> "Выполняется" Тогда
		ФискализироватьЧекЗавершение(РезультатВыполнения, ДополнительныеПараметры);
		Возврат;
	КонецЕсли;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
	РезультатВыполнения,
	ОповещениеОЗавершении,
	ПараметрыОжидания);
	
КонецПроцедуры

Процедура ФискализироватьЧекЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатВыполнения.Статус = "Выполнено" Тогда
		
		Результат = ПолучитьИзВременногоХранилища(РезультатВыполнения.АдресРезультата);
		Если НЕ Результат.Результат Тогда
			
			ТекстСообщения = НСтр(
			"ru = 'При фискализации документа возникла ошибка.
			|Чек не фискализирован.
			|Дополнительное описание:
			|%ДополнительноеОписание%'");
			
			ТекстСообщения = СтрЗаменить(
			ТекстСообщения,
			"%ДополнительноеОписание%",
			РезультатВыполнения.ОписаниеОшибки);
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			
		Иначе
			Если ДополнительныеПараметры.Форма.ИмяФормы = "Документ.ЭлектронныйДокументИсходящийЭДО.Форма.ФормаПросмотраЛегкийКлиентЭДО" Тогда
				ДополнительныеПараметры.Форма.Элементы.ПробитьЧек.Заголовок = НСтр("ru = 'Чек пробит'");
			Иначе
				ДополнительныеПараметры.Форма.ТолькоПросмотр = Истина;
				ДополнительныеПараметры.Форма.Элементы.Товары.Доступность = Ложь;
				ДополнительныеПараметры.Форма.Элементы.ДекорацияФискализация.Заголовок = НСтр("ru = 'Чек пробит'");
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли РезультатВыполнения.Статус = "Ошибка" Тогда
		
		ТекстСообщения = НСтр(
		"ru = 'При фискализации документа возникла ошибка.
		|Чек не фискализирован.
		|Дополнительное описание:
		|%ДополнительноеОписание%'");
		
		ТекстСообщения = СтрЗаменить(
		ТекстСообщения,
		"%ДополнительноеОписание%",
		РезультатВыполнения.ПодробноеПредставлениеОшибки);
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьФормуРеквизитовОблачнойКассы(ПараметрыФискализации, СостояниеДокументаОснования) Экспорт
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатЗаполненияДополнительныхРеквизитов", ЭтотОбъект, ПараметрыФискализации);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СостояниеДокументаОснования", СостояниеДокументаОснования);
	
	ОткрытьФорму("Документ.РеализацияТоваровУслуг.Форма.ФормаДополнительныхРеквизитов", ПараметрыФормы,,,,,ОповещениеОЗавершении);
	
КонецПроцедуры

Процедура ОбработатьРезультатЗаполненияДополнительныхРеквизитов(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Массив = Новый Массив();
	Массив.Добавить(ДополнительныеПараметры.РеализацияОснованиеУПД);
	
	ПараметрыФискализации = Новый Структура;
	ПараметрыФискализации.Вставить("Форма", ДополнительныеПараметры.Форма);
	ПараметрыФискализации.Вставить("СостояниеДокументаОснования", Результат);
	
	ПробитьЧекПослеПроведения(Массив, ПараметрыФискализации);
	
КонецПроцедуры

Процедура ВыполнитьПереопределяемуюКоманду(Форма, Команда, ДополнительныеПараметры) Экспорт
	
	Если СтрНачинаетсяС(Команда.Имя, "ПробитьЧекЭлектронныйДокументИсходящий") Тогда
		
		Если Не ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
			
			ТекстСообщения = НСтр("ru='Для фискализации товарной накладной необходимо подписать документ.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			
			Возврат;
			
		КонецЕсли;
		
		СостояниеДокументаОснования = ПодключаемоеОборудованиеКЭДОВызовСервера.СостояниеДокументаОснования(Форма.Объект.Ссылка); 
		
		Если СостояниеДокументаОснования.ДокументОснованиеФискализирован Тогда
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("ДокументОснование", СостояниеДокументаОснования.РеализацияОснованиеУПД);
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Отбор", СтруктураОтбора);
			ОткрытьФорму("РегистрСведений.ФискальныеОперации.ФормаСписка", СтруктураПараметров, ЭтотОбъект);
			
			Возврат;
			
		КонецЕсли;
		
		Если СостояниеДокументаОснования.ТребуетсяЗаполнениеРеквизитовДокумента Тогда
			
			ПараметрыФискализации = Новый Структура;
			ПараметрыФискализации.Вставить("Форма", Форма);
			ПараметрыФискализации.Вставить("РеализацияОснованиеУПД", СостояниеДокументаОснования.РеализацияОснованиеУПД); 
			
			ОткрытьФормуРеквизитовОблачнойКассы(ПараметрыФискализации, СостояниеДокументаОснования);
			
		Иначе
			
			Массив = Новый Массив();
			Массив.Добавить(СостояниеДокументаОснования.РеализацияОснованиеУПД);
			
			ПараметрыФискализации = Новый Структура;
			ПараметрыФискализации.Вставить("Форма", Форма);
			
			ПробитьЧекПослеПроведения(Массив, ПараметрыФискализации);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область ПрограммныйИнтерфейсСлужебный

Процедура ПроверитьКодыМаркировки(ПараметрыЧекаККТ, ФормаВладелец, ОповещениеОЗавершении) Экспорт
	
	ПозицииЧека = ПараметрыЧекаККТ.ПозицииЧека;
	ПараметрыСканирования = ШтрихкодированиеОбщегоНазначенияИСКлиент.ПараметрыСканирования(ФормаВладелец);
	ПараметрыСканирования.Вставить("ТребуетсяПроверкаСредствамиККТ", Ложь);
		
	ДанныеДляПроверки = Новый Массив;
	РезультатРаспределенияШтрихкодов = Неопределено;
	Для Каждого ПозицияЧека Из ПозицииЧека Цикл
		ПозицияЧека.Свойство("РезультатРаспределенияШтрихкодов", РезультатРаспределенияШтрихкодов);
		Если РезультатРаспределенияШтрихкодов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементДанныхДляПроверки = ШтрихкодированиеИСМПКлиент.НовыйЭлементПроверкиСредствамиККТПоДаннымРаспределения(
			РезультатРаспределенияШтрихкодов);
		Если Не ЗначениеЗаполнено(ЭлементДанныхДляПроверки.ПредставлениеНоменклатуры) Тогда
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПозицияЧека, "Наименование")
				И ЗначениеЗаполнено(ПозицияЧека.Наименование) Тогда
				ЭлементДанныхДляПроверки.ПредставлениеНоменклатуры = ПозицияЧека.Наименование;
			ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПозицияЧека, "Номенклатура")
				И ЗначениеЗаполнено(ПозицияЧека.Номенклатура) Тогда
				ЭлементДанныхДляПроверки.ПредставлениеНоменклатуры = ПозицияЧека.Номенклатура;
			КонецЕсли;
		КонецЕсли;
		
		ДанныеДляПроверки.Добавить(ЭлементДанныхДляПроверки);
		
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	ОповещениеЗавершенииПроверки = Новый ОписаниеОповещения("ПроверитьКодыМаркировкиЗавершение", ЭтотОбъект,
		ДополнительныеПараметры);
	
	ПараметрыПроверкиКМСредствамиККТ = ШтрихкодированиеОбщегоНазначенияИСМПКлиент.ПараметрыНачалаПроверкиКодовМаркировкиСредствамиККТ();
	ПараметрыПроверкиКМСредствамиККТ.ОповещениеОЗавершении       = ОповещениеЗавершенииПроверки;
	ПараметрыПроверкиКМСредствамиККТ.ДанныеДляПроверки           = ДанныеДляПроверки;
	ПараметрыПроверкиКМСредствамиККТ.ПараметрыСканирования       = ПараметрыСканирования;
	ПараметрыПроверкиКМСредствамиККТ.ФормаОсновногоОбъекта       = ФормаВладелец;
	ПараметрыПроверкиКМСредствамиККТ.ЗаголовокКнопкиИгнорировать = НСтр("ru = 'Пробить чек'");
	ПараметрыПроверкиКМСредствамиККТ.ПроверятьЗапросыГИСМТ       = ОбщегоНазначенияИСМПКлиентСерверПовтИсп.ПроверкаТоварныхГруппПриРозничнойПродажеГИСМТ();
	ПараметрыПроверкиКМСредствамиККТ.ЭтоДокументОплаты           = Ложь;;
	
	ШтрихкодированиеОбщегоНазначенияИСМПКлиент.НачатьПроверкуКодовМаркировкиСредствамиККТ(ПараметрыПроверкиКМСредствамиККТ);
	
КонецПроцедуры

Процедура ПроверитьКодыМаркировкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ШтрихкодированиеИСМПКлиент.РезультатПроверкиСредствамиККТТребуетФискализации(Результат)
		И ТипЗнч(ДополнительныеПараметры.ОповещениеОЗавершении.ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.ОповещениеОЗавершении.ДополнительныеПараметры.Свойство("ОбщиеПараметры") Тогда
		
		// Перенесем результат проверки ГИС МТ в параметры фискализации.
		Для Каждого ЭлементПроверки Из Результат.ЭлементыПроверки Цикл
			
			Если Не (ЗначениеЗаполнено(ЭлементПроверки.РазрешительныйРежимИдентификаторЗапросаГИСМТ)
				И ОбщегоНазначенияИСМПКлиентСерверПовтИсп.ПродукцияПодлежитОбязательнойОнлайнПроверкеПередРозничнойПродажей(ЭлементПроверки.ВидПродукции)) Тогда
				Продолжить;
			КонецЕсли;
			
			РезультатРаспределенияШтрихкодов = Неопределено;
			Для Каждого ПозицияЧека Из ДополнительныеПараметры.ОповещениеОЗавершении.ДополнительныеПараметры.ОбщиеПараметры.ПозицииЧека Цикл
				ПозицияЧека.Свойство("РезультатРаспределенияШтрихкодов", РезультатРаспределенияШтрихкодов);
				Если РезультатРаспределенияШтрихкодов = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если РезультатРаспределенияШтрихкодов.ПолныйКодМаркировки = ЭлементПроверки.ПолныйКодМаркировки Тогда
					
					Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПозицияЧека, "ЗапросПроверкиКода") Тогда
						ПозицияЧека.ЗапросПроверкиКода.ИдентификаторЗапроса
							= ЭлементПроверки.РазрешительныйРежимИдентификаторЗапросаГИСМТ;
						ПозицияЧека.ЗапросПроверкиКода.ВременнаяМетка
							= ЭлементПроверки.РазрешительныйРежимДатаЗапросаГИСМТ;
					Иначе
						ПозицияЧека.РезультатРаспределенияШтрихкодов.РазрешительныйРежимИдентификаторЗапросаГИСМТ
							= ЭлементПроверки.РазрешительныйРежимИдентификаторЗапросаГИСМТ;
						ПозицияЧека.РезультатРаспределенияШтрихкодов.РазрешительныйРежимДатаЗапросаГИСМТ
							= ЭлементПроверки.РазрешительныйРежимДатаЗапросаГИСМТ;
					КонецЕсли;
					
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеОЗавершении, Результат);
	
КонецПроцедуры

#КонецОбласти
