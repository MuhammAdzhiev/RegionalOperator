	КонецЕсли;
	
	
	// Результаты приемки.
	РезультатыПриемки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
		ДеревоДанных, "РезультатыПриемки");
	РезультатыПриемки.Колонки.Добавить("ЕдиницаИзмерения");
		
	ВыборкаТовары = СтруктураДанных.ВыборкаТовары;
	
	ШтрихкодыКомбинаций   = Неопределено;
	ШтрихкодыНоменклатуры = Неопределено;
	Если НЕ СтруктураДанных.Свойство("ШтрихкодыНоменклатуры", ШтрихкодыНоменклатуры)
		ИЛИ НЕ СтруктураДанных.Свойство("ШтрихкодыКомбинаций", ШтрихкодыКомбинаций) Тогда
		ШтрихкодыПоТоварам(ВыборкаТовары, ШтрихкодыКомбинаций, ШтрихкодыНоменклатуры);
	КонецЕсли;

	Пока ВыборкаТовары.Следующий() Цикл
		
		НоваяСтрока = РезультатыПриемки.Добавить();
		НоваяСтрока.ЕдиницаИзмерения = ВыборкаТовары.ЕдиницаИзмерения;
		НоваяСтрока.ЕдиницаИзмеренияНаименование = ВыборкаТовары.ЕдиницаИзмеренияНаименование;
		НоваяСтрока.ЕдиницаИзмеренияКод = ВыборкаТовары.ЕдиницаИзмеренияКод;
		НоваяСтрока.ИнформацияОРасхождениях = ВыборкаТовары.Пояснение;
		
		НоваяСтрока.Товар = Новый Структура;
		НоваяСтрока.Товар.Вставить("Наименование", ВыборкаТовары.Наименование);
		НоваяСтрока.Товар.Вставить("Характеристика", ВыборкаТовары.ХарактеристикаНаименование);
		НоваяСтрока.Товар.Вставить("Артикул", ВыборкаТовары.НоменклатураАртикул);
		НоваяСтрока.Товар.Вставить("Код", ВыборкаТовары.НоменклатураКод);
		НоваяСтрока.Товар.Вставить("Паспорт", ВыборкаТовары.НомерПаспорта);
		
		Если ЗначениеЗаполнено(ВыборкаТовары.КоличествоПоДокументу) Тогда
			НоваяСтрока.ПоДокументу = Новый Структура;
			НоваяСтрока.ПоДокументу.Вставить("Количество", ВыборкаТовары.КоличествоПоДокументу);
			НоваяСтрока.ПоДокументу.Вставить("Цена", ВыборкаТовары.ЦенаПоДокументу);
			НоваяСтрока.ПоДокументу.Вставить("СтавкаНДС", ВыборкаТовары.СтавкаНДСПоДокументу);
			НоваяСтрока.ПоДокументу.Вставить("СуммаНДС", ВыборкаТовары.СуммаНДСПоДокументу);
			НоваяСтрока.ПоДокументу.Вставить("СуммаСНДС", ВыборкаТовары.СуммаСНДСПоДокументу);
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаТовары.Количество) Тогда
			НоваяСтрока.ПоФакту = Новый Структура;
			НоваяСтрока.ПоФакту.Вставить("Количество", ВыборкаТовары.Количество);
			НоваяСтрока.ПоФакту.Вставить("Цена", ВыборкаТовары.Цена);
			НоваяСтрока.ПоФакту.Вставить("СтавкаНДС", ВыборкаТовары.СтавкаНДС);
			НоваяСтрока.ПоФакту.Вставить("СуммаНДС", ВыборкаТовары.СуммаНДС);
			НоваяСтрока.ПоФакту.Вставить("СуммаСНДС", ВыборкаТовары.СуммаСНДС);
		КонецЕсли;
		КоэффициентСтавкиНДС = КлиентЭДОКлиентСервер.ПолучитьСтавкуНДСЧислом(ВыборкаТовары.СтавкаНДСПоДокументу);
		Если ЗначениеЗаполнено(ВыборкаТовары.КоличествоБрак) Тогда
			Сумма = Окр(ВыборкаТовары.КоличествоБрак * ВыборкаТовары.ЦенаПоДокументу, 2);
			СуммаНДС = Окр(Сумма * КоэффициентСтавкиНДС, 2);
			СуммаСНДС = Сумма + СуммаНДС;
			НоваяСтрока.Брак = Новый Структура;
			НоваяСтрока.Брак.Вставить("Количество", ВыборкаТовары.КоличествоБрак);
			НоваяСтрока.Брак.Вставить("СуммаНДС", СуммаНДС);
			НоваяСтрока.Брак.Вставить("СуммаСНДС", СуммаСНДС);
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаТовары.КоличествоБой) Тогда
			Сумма = Окр(ВыборкаТовары.КоличествоБой * ВыборкаТовары.ЦенаПоДокументу, 2);
			СуммаНДС = Окр(Сумма * КоэффициентСтавкиНДС, 2);
			СуммаСНДС = Сумма + СуммаНДС;
			НоваяСтрока.Бой = Новый Структура;
			НоваяСтрока.Бой.Вставить("Количество", ВыборкаТовары.КоличествоБой);
			НоваяСтрока.Бой.Вставить("СуммаНДС", СуммаНДС);
			НоваяСтрока.Бой.Вставить("СуммаСНДС", СуммаСНДС);
		КонецЕсли;
		НоваяСтрока.Излишки = Новый Структура;
		НоваяСтрока.Недостача = Новый Структура;
		Если ВыборкаТовары.Количество > ВыборкаТовары.КоличествоПоДокументу Тогда
			НоваяСтрока.Излишки.Вставить("Количество", ВыборкаТовары.Количество - ВыборкаТовары.КоличествоПоДокументу);
		ИначеЕсли ВыборкаТовары.Количество < ВыборкаТовары.КоличествоПоДокументу Тогда
			НоваяСтрока.Недостача.Вставить("Количество", ВыборкаТовары.КоличествоПоДокументу - ВыборкаТовары.Количество);
		КонецЕсли;
		Если ВыборкаТовары.СуммаНДС > ВыборкаТовары.СуммаНДСПоДокументу Тогда
			НоваяСтрока.Излишки.Вставить("СуммаНДС", ВыборкаТовары.СуммаНДС - ВыборкаТовары.СуммаНДСПоДокументу);
		ИначеЕсли ВыборкаТовары.СуммаНДС < ВыборкаТовары.СуммаНДСПоДокументу Тогда
			НоваяСтрока.Недостача.Вставить("СуммаНДС", ВыборкаТовары.СуммаНДСПоДокументу - ВыборкаТовары.СуммаНДС);
		КонецЕсли;
		Если ВыборкаТовары.СуммаСНДС > ВыборкаТовары.СуммаСНДСПоДокументу Тогда
			НоваяСтрока.Излишки.Вставить("СуммаСНДС", ВыборкаТовары.СуммаСНДС - ВыборкаТовары.СуммаСНДСПоДокументу);
		ИначеЕсли ВыборкаТовары.СуммаСНДС < ВыборкаТовары.СуммаСНДСПоДокументу Тогда
			НоваяСтрока.Недостача.Вставить("СуммаСНДС", ВыборкаТовары.СуммаСНДСПоДокументу - ВыборкаТовары.СуммаСНДС);
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаТовары.ЦенаПоДоговору)
			ИЛИ ЗначениеЗаполнено(ВыборкаТовары.СуммаНДСПоДоговору)
			ИЛИ ЗначениеЗаполнено(ВыборкаТовары.СуммаСНДСПоДоговору) Тогда
			НоваяСтрока.ЦеновыеОтклонения = Новый Структура;
			НоваяСтрока.ЦеновыеОтклонения.Вставить("Цена", ВыборкаТовары.ЦенаПоДокументу - ВыборкаТовары.ЦенаПоДоговору);
			НоваяСтрока.ЦеновыеОтклонения.Вставить("СуммаНДС", ВыборкаТовары.СуммаНДСПоДокументу - ВыборкаТовары.СуммаНДСПоДоговору);
			НоваяСтрока.ЦеновыеОтклонения.Вставить("СуммаСНДС", ВыборкаТовары.СуммаСНДСПоДокументу - ВыборкаТовары.СуммаСНДСПоДоговору);
		КонецЕсли;
		
		// Сопоставление.
		Сопоставление = Новый Структура;
		Если ЗначениеЗаполнено(ВыборкаТовары.ИдентификаторКонтрагента) Тогда
			Сопоставление.Вставить("Идентификатор", ВыборкаТовары.ИдентификаторКонтрагента);
		КонецЕсли;
		Сопоставление.Вставить("НоменклатураИБ", ВыборкаТовары.Номенклатура);
		Сопоставление.Вставить("ХарактеристикаИБ", ВыборкаТовары.Характеристика);
		Сопоставление.Вставить("УпаковкаИБ", ВыборкаТовары.ЕдиницаИзмерения);
		
		Сопоставление.Вставить("Наименование", ВыборкаТовары.НаименованиеПолное);
		Сопоставление.Вставить("Характеристика", ВыборкаТовары.ХарактеристикаНаименование);
		Сопоставление.Вставить("ЕдиницаИзмерения", ВыборкаТовары.ЕдиницаИзмеренияНаименование);
		Сопоставление.Вставить("ЕдиницаИзмеренияКод", ВыборкаТовары.ЕдиницаИзмеренияКод);
		Сопоставление.Вставить("Артикул", ВыборкаТовары.НоменклатураАртикул);
		Сопоставление.Вставить("СтавкаНДС", ВыборкаТовары.СтавкаНДСПоДокументу);
		
		ЗаполнитьШтрихкодыТоваровВСопоставление(Сопоставление, ШтрихкодыНоменклатуры, ШтрихкодыКомбинаций,
			ВыборкаТовары.Номенклатура, ВыборкаТовары.Характеристика, ВыборкаТовары.ЕдиницаИзмерения);
		
		НоваяСтрока.Сопоставление = Сопоставление;
		
		// Маркировка
		ИменаПолейИТаблиц = КлиентЭДОКлиентСервер.ИменаПолейДереваДанныхИТаблицМаркировкиАктаОРасхождениях();
		Для Каждого ПараИмен Из ИменаПолейИТаблиц Цикл
			ТекущаяГрафа = НоваяСтрока[ПараИмен.Ключ];
			Если ТекущаяГрафа = Неопределено Тогда
				НоваяСтрока[ПараИмен.Ключ] = Новый Структура;
				ТекущаяГрафа = НоваяСтрока[ПараИмен.Ключ];
				ТекущаяГрафа.Вставить("Маркировка");
			ИначеЕсли Не ТекущаяГрафа.Свойство("Маркировка") Тогда
				ТекущаяГрафа.Вставить("Маркировка");
			КонецЕсли;
			
			ЗаполнитьСведенияОМаркировкеВДеревеДанныхАктаОРасхождениях(ТекущаяГрафа, СтруктураДанных[ПараИмен.Значение],
				"Маркировка", ВыборкаТовары.ИдентификаторСтроки);
		КонецЦикла;
	КонецЦикла;
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(РезультатыПриемки,
		"ЕдиницаИзмеренияКод", "ЕдиницаИзмерения", "Объект.Код");
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, РезультатыПриемки, "РезультатыПриемки");
	
	// Прилагаемые документы.
	ПрилагаемыеДокументы = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
		ДеревоДанных, "ПрилагаемыеДокументы");
	ВыборкаПрилагаемыеДокументы = СтруктураДанных.ВыборкаПрилагаемыеДокументы;
	Пока ВыборкаПрилагаемыеДокументы.Следующий() Цикл
		НоваяСтрока = ПрилагаемыеДокументы.Добавить();
		НоваяСтрока.Наименование = ВыборкаПрилагаемыеДокументы.Наименование;
		НоваяСтрока.Номер = ВыборкаПрилагаемыеДокументы.Номер;
		НоваяСтрока.Дата = ВыборкаПрилагаемыеДокументы.Дата;
	КонецЦикла;
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ПрилагаемыеДокументы, "ПрилагаемыеДокументы");
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, "ФормированиеДополнительныхСведений", ВыборкаШапка.ФормированиеДополнительныхСведений);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, "СодержаниеДополнительныхСведений", ВыборкаШапка.СодержаниеДополнительныхСведений);
	
КонецПроцедуры

// Заполняет атрибуты дерева значений, содержащего данные для формирования дополнительных сведений по результатам приемки.
//
// Параметры:
//  СсылкаНаОбъект - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - основание для электронного документа.
//  ДеревоДанных - ДеревоЗначений - данные для заполнения электронного документа. Строится по макету 
//                                  см. Обработка.ОбменСКонтрагентами.Макет.АктОРасхождениях_ДополнительныеСведения_5_01.
//  Отказ - Булево - признак отказа от дальнейшего формирования электронного документа.
//                   Информационное сообщение пользователю необходимо формировать самостоятельно.
//
Процедура ЗаполнитьДанныеДополнительныхСведенийДляАктОРасхождениях(Знач СсылкаНаОбъект, ДеревоДанных, Отказ)
	
	СтруктураДанных = Документы[СсылкаНаОбъект.Метаданные().Имя].ПолучитьДанныеДляЭД(СсылкаНаОбъект);
		
	ВыборкаШапка = СтруктураДанных.ВыборкаШапка;
	ВыборкаШапка.Следующий();
	
	Покупатель = Неопределено; 
	Если ЗначениеЗаполнено(ВыборкаШапка.Организация) Тогда
		Покупатель = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапка.Организация, Покупатель);
		СоставительДокументаНаименование = Покупатель.ПолноеНаименование
			+ ?(ЗначениеЗаполнено(Покупатель.КПП),
			СтрШаблон(НСтр("ru = ', ИНН/КПП %1/%2'"), Покупатель.ИНН, Покупатель.КПП),
			СтрШаблон(НСтр("ru = ', ИНН %1'"), Покупатель.ИНН));
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			ВыборкаШапка.Ссылка, "Объект.Организация");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, "СоставительДокументаНаименование", СоставительДокументаНаименование, ПараметрыОбработкиОшибок);
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			ВыборкаШапка.Ссылка, "Объект.Организация");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, "Покупатель", Покупатель, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, "ЕстьМаркировка", ВыборкаШапка.ЕстьМаркировка); 
			
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, "ФормированиеДополнительныхСведений", ВыборкаШапка.ФормированиеДополнительныхСведений);
	
	ТекстОшибки = "";
	Если Не ЗначениеЗаполнено(ВыборкаШапка.СодержаниеДополнительныхСведений) Тогда
		ТекстОшибки = НСтр("ru = 'Содержание итогов приемки: значение не заполнено'");
	КонецЕсли;
	
	ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			ВыборкаШапка.Ссылка, "Объект.СодержаниеДополнительныхСведений",,,,ТекстОшибки);
			
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеДополнительныхСведений", 
		ВыборкаШапка.СодержаниеДополнительныхСведений, ПараметрыОбработкиОшибок);
	
КонецПроцедуры

Функция ПоддержанЭлектронныйАктОРасхождениях() Экспорт
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	АктуальныеВидыЭД = Новый Соответствие;
	ПриОпределенииИспользуемыхТиповЭлектронныхДокументов(АктуальныеВидыЭД);
	
	Возврат (АктуальныеВидыЭД[ТипыДокументов.АктОРасхождениях] <> Неопределено);
	
КонецФункции

Функция НайтиАктОРасхожденияхПоОтгрузке(Знач НомерДокумента, Знач ДатаДокумента, Знач НомерИсправления, Знач Организация, Знач Контрагент)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	АктОРасхожденияхПоОтгрузке.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.АктОРасхожденияхПоОтгрузке КАК АктОРасхожденияхПоОтгрузке
	|ГДЕ
	|	АктОРасхожденияхПоОтгрузке.НомерЭД = &НомерДокумента
	|	И АктОРасхожденияхПоОтгрузке.ДатаЭД = &ДатаДокумента
	|	И АктОРасхожденияхПоОтгрузке.НомерИсправления <= &НомерИсправления
	|	И АктОРасхожденияхПоОтгрузке.Организация = &Организация
	|	И АктОРасхожденияхПоОтгрузке.Контрагент = &Контрагент
	|
	|УПОРЯДОЧИТЬ ПО
	|	АктОРасхожденияхПоОтгрузке.НомерИсправления УБЫВ";
	Запрос.УстановитьПараметр("НомерДокумента", НомерДокумента);
	Запрос.УстановитьПараметр("ДатаДокумента", НачалоДня(ДатаДокумента));
	Запрос.УстановитьПараметр("НомерИсправления", НомерИсправления);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыУчастникаАктаОРасхождениях(Знач Участник)
	
	Реквизиты = Новый Структура("ИНН,КПП,Наименование");
	
	Если Участник.ТипУчастника.Свойство("ЮЛ") Тогда
		
		Реквизиты.ИНН = Участник.ТипУчастника.ЮЛ.ИНН;
		Реквизиты.КПП = Участник.ТипУчастника.ЮЛ.КПП;
		Реквизиты.Наименование = Участник.ТипУчастника.ЮЛ.НаименованиеОрганизации;
		
	ИначеЕсли Участник.ТипУчастника.Свойство("ИЛ") Тогда
		
		Реквизиты.Наименование = Участник.ТипУчастника.ИЛ.НаименованиеОрганизации;
		
	ИначеЕсли Участник.ТипУчастника.Свойство("ИП") Тогда
		
		Реквизиты.ИНН = Участник.ТипУчастника.ИП.ИНН;
		
	ИначеЕсли Участник.ТипУчастника.Свойство("ФЛ") Тогда
		
		Реквизиты.ИНН = Участник.ТипУчастника.ФЛ.ИНН;
		ЧастиФИО = Новый Массив;
		Если ЗначениеЗаполнено(Участник.ТипУчастника.ФЛ.Фамилия) Тогда
			ЧастиФИО.Добавить(Участник.ТипУчастника.ФЛ.Фамилия);
		КонецЕсли;
		Если ЗначениеЗаполнено(Участник.ТипУчастника.ФЛ.Имя) Тогда
			ЧастиФИО.Добавить(Участник.ТипУчастника.ФЛ.Имя);
		КонецЕсли;
		Если ЗначениеЗаполнено(Участник.ТипУчастника.ФЛ.Отчество) Тогда
			ЧастиФИО.Добавить(Участник.ТипУчастника.ФЛ.Отчество);
		КонецЕсли;
		Реквизиты.Наименование = СтрСоединить(ЧастиФИО);
		
	КонецЕсли;
	
	Возврат Реквизиты;
	
КонецФункции

Функция РеквизитыПриемщикаАктаОРасхождениях(Знач Приемщик)
	
	Реквизиты = Новый Структура("ФИО,Должность");
	Реквизиты.ФИО = Новый Структура("Фамилия,Имя,Отчество,Представление");
	
	Если Приемщик.Свойство("РаботникОрганизацииПокупателя") Тогда
		
		Работник = Приемщик.РаботникОрганизацииПокупателя;
		Реквизиты.ФИО.Фамилия = Работник.Фамилия;
		Реквизиты.ФИО.Имя = Работник.Имя;
		Реквизиты.ФИО.Отчество = Работник.Отчество;
		Реквизиты.ФИО.Представление = ПредставлениеФИО(Реквизиты.ФИО);
		Реквизиты.Должность = Работник.Должность;
		
	ИначеЕсли Приемщик.Свойство("ИноеЛицо") Тогда
		
		Если Приемщик.ИноеЛицо.Свойство("ПредставительОрганизации") Тогда
			
			Представитель = Приемщик.ИноеЛицо.ПредставительОрганизации;
			Реквизиты.ФИО.Фамилия = Представитель.Фамилия;
			Реквизиты.ФИО.Имя = Представитель.Имя;
			Реквизиты.ФИО.Отчество = Представитель.Отчество;
			Реквизиты.ФИО.Представление = ПредставлениеФИО(Реквизиты.ФИО);
			Реквизиты.Должность = Представитель.Должность;
			
		ИначеЕсли Приемщик.ИноеЛицо.Свойство("ФизическоеЛицо") Тогда
			
			ФизическоеЛицо = Приемщик.ИноеЛицо.ФизическоеЛицо;
			Реквизиты.ФИО.Фамилия = ФизическоеЛицо.Фамилия;
			Реквизиты.ФИО.Имя = ФизическоеЛицо.Имя;
			Реквизиты.ФИО.Отчество = ФизическоеЛицо.Отчество;
			Реквизиты.ФИО.Представление = ПредставлениеФИО(Реквизиты.ФИО);
			Реквизиты.Должность = ФизическоеЛицо.ОснованиеПолномочий;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Реквизиты;
	
КонецФункции

Функция НайтиАктОРасхожденияхПоОснованию(Знач ДокументОснование)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	АктОРасхожденияхПоПриемке.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.АктОРасхожденияхПоПриемке КАК АктОРасхожденияхПоПриемке
	|ГДЕ
	|	АктОРасхожденияхПоПриемке.ДокументОснование = &ДокументОснование
	|
	|УПОРЯДОЧИТЬ ПО
	|	АктОРасхожденияхПоПриемке.НомерИсправления УБЫВ";
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	Результат = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область УКД

Процедура НайтиСоздатьУКДДокументОбИзмененииСтоимости(ДеревоДанных, СсылкаНаВладельца = Неопределено, СпособОбработки = "")
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	ДокументОбъект.НомерЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
	ДокументОбъект.НомерИсправления = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления");
	Если ЗначениеЗаполнено(ДокументОбъект.НомерИсправления) Тогда
		ВидОперации = Перечисления.ВидыОпераций.Исправление;
		ДокументОбъект.ДатаЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления");
		ДокументОбъект.НомерИсправляемогоКорректировочногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "НомерДокумента");
		ДокументОбъект.ДатаИсправляемогоКорректировочногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаДокумента");
	Иначе
		ВидОперации = Перечисления.ВидыОпераций.Корректировка;
		ДокументОбъект.ДатаЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента");
	КонецЕсли;
		
	ДокументОбъект.ВидОперации = ВидОперации;
	
	ДокументОбъект.НомерИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "НомерИсходногоДокумента");
	ДокументОбъект.ДатаИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДатаИсходногоДокумента");
	ДокументОбъект.НомерИсправленияИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "НомерИсправленияИсходногоДокумента");
	ДокументОбъект.ДатаИсправленияИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДатаИсправленияИсходногоДокумента");
	
	ДокументОбъект.Валюта = ЭлектронноеВзаимодействие.НайтиСсылку("Валюты",
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод"));
	
	ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(ДеревоДанных, "СведенияОПокупателе");
	ДокументОбъект.Контрагент  = КонтрагентПоДаннымЭД(ДеревоДанных, "СведенияОПродавце");
	
	ДокументОбъект.ИдентификаторГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта");
	
	// Поиск и заполнения договора контрагента.
	ОснованиеКорректировки = ДеревоДанных.Строки.Найти("ОснованиеКорректировки", "ПолныйПуть");
	Если ОснованиеКорректировки <> Неопределено Тогда
		Для Каждого СтрокаОснованиеКорректировки Из ОснованиеКорректировки.Строки Цикл
			ДоговорНомер = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеКорректировки, "ОснованиеКорректировки.НомерСтроки.ДокументНомер");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				ДоговорДата = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СтрокаОснованиеКорректировки, "ОснованиеКорректировки.НомерСтроки.ДокументДата");
				
				СвойстваДоговора = Новый Структура;
				СвойстваДоговора.Вставить("НомерДоговора", ДоговорНомер);
				СвойстваДоговора.Вставить("ДатаДоговора", ДоговорДата);
				СвойстваДоговора.Вставить("Организация", ДокументОбъект.Организация);
				СвойстваДоговора.Вставить("Владелец", ДокументОбъект.Контрагент);
				
				ДоговорКонтрагента = ЭлектронноеВзаимодействие.НайтиСсылку("ДоговорыКонтрагентов",, СвойстваДоговора);
				ДокументОбъект.ДоговорКонтрагента = ДоговорКонтрагента;
				
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	// Поиск и заполнение банковского счета контрагента.
	НомерСчета = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияОПродавце.БанковскиеРеквизиты.НомерСчета");
	БИКБанка = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияОПродавце.БанковскиеРеквизиты.БИКБанка");
	ДокументОбъект.БанковскийСчетКонтрагента = БанковскийСчетКонтрагента(
		ДокументОбъект.Контрагент, БИКБанка, НомерСчета, ДокументОбъект.Валюта);
	
	ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
	Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		Для Каждого СтрокаСФ Из ДокументыОснованияСчетаФактуры Цикл
			Если ТипЗнч(СтрокаСФ) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				Для Каждого Строка Из СтрокаСФ.ДокументыОснования Цикл
					Если ЗначениеЗаполнено(Строка.ДокументОснование) Тогда
						ДокументОбъект.ДокументОснование = Строка.ДокументОснование;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			Иначе
				ДокументОбъект.ДокументОснование = СтрокаСФ;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОбъект.ДокументОснование) 
		И ТипЗнч(ДокументОбъект.ДокументОснование) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		
		СписокРеквизитов = "ЭтоГосЗакупка";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОбъект.ДокументОснование, СписокРеквизитов, Истина);
		ДокументОбъект.ЭтоГосЗакупка = ЗначенияРеквизитов.ЭтоГосЗакупка;
		
	КонецЕсли;
	
	ДокументОбъект.Товары.Очистить();
	ОблагаетсяНДСУПокупателя = Ложь;
	ИспользоватьСопоставлениеНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	СуммаДокумента = 0;
	
	КоличествоТовараНеУказано = Истина;
	
	ТаблицаТоваров = ДокументОбъект.Товары.ВыгрузитьКолонки();
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(ТаблицаТоваров);
	
	// Сведения таблицы.
	СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
	Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		НоваяСтрока.КоличествоУпаковокДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.КоличествоДоКорректировки");
		НоваяСтрока.КоличествоУпаковок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.Количество");
		НоваяСтрока.ЦенаДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмеренияДоКорректировки");
		НоваяСтрока.Цена = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмерения");
		НоваяСтрока.СуммаДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалогаДоКорректировки");
		НоваяСтрока.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
		НоваяСтрока.СуммаАкцизаДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.СуммаАкцизаДоКорректировки");
		НоваяСтрока.СуммаАкциза = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.СуммаАкциза");
		
		СтавкаНДСДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.НалоговаяСтавкаДоКорректировки");
		СтавкаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
		Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
			НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
			ОблагаетсяНДСУПокупателя = Истина;
		Иначе
			НоваяСтрока.СтавкаНДСДоКорректировки = СтавкаНДСДоКорректировки;
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаСНДСДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогомДоКорректировки");
			НоваяСтрока.СуммаСНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
			НоваяСтрока.СуммаНДСДоКорректировки  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СуммаНалогаДоКорректировки");
			НоваяСтрока.СуммаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СуммаНалога");
		КонецЕсли;
		
		СуммаДокумента = СуммаДокумента + НоваяСтрока.СуммаСНДС;
		
		КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(НоваяСтрока);
		
		ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокумента_ГИСМТ(ДокументОбъект, НоваяСтрока, СведенияОТоваре);
		
		Сопоставление = СведенияОТоваре.Строки.Найти(
			"СведенияОТоварах.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
		Если Сопоставление <> Неопределено Тогда
			
			Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.Сопоставление.Идентификатор");
			Если ЗначениеЗаполнено(Идентификатор) Тогда
				НоваяСтрока.ИдентификаторКонтрагента = Идентификатор;
			КонецЕсли;
			
			Если ИспользоватьСопоставлениеНоменклатуры Тогда
			
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
				КонецЕсли;
				
				Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.ХарактеристикаИБ");
				Если ЗначениеЗаполнено(Характеристика) Тогда
					НоваяСтрока.Характеристика = Характеристика;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
			
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
			ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод");
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
				НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.УпаковкаНоменклатуры(
					НоваяСтрока.Номенклатура, ЕдиницаИзмеренияКод);
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.НаименованиеКонтрагента = ПредставлениеНоменклатурыПоставщика(
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ТоварНаименование"));
		
		Если НоваяСтрока.КоличествоУпаковокДоКорректировки ИЛИ НоваяСтрока.КоличествоУпаковок Тогда
			КоличествоТовараНеУказано = Ложь
		КонецЕсли;
		
		ЗаполнитьВидДеятельностиРаздельногоУчетаНДС(НоваяСтрока);
		
		РассчитатьКоличествоБазовыхЕдиниц(НоваяСтрока);
	КонецЦикла;
	
	СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(ТаблицаТоваров, ДокументОбъект.Контрагент);
	ДокументОбъект.Товары.Загрузить(ТаблицаТоваров);
	
	ДокументОбъект.СуммаДокумента = СуммаДокумента;
	
	ДокументОбъект.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;
	
	Если ЗначениеЗаполнено(ДокументОбъект.ДокументОснование) 
		И ТипЗнч(ДокументОбъект.ДокументОснование) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		ВидДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.ДокументОснование, "ВидДокумента");
		
	ИначеЕсли ИспользоватьСопоставлениеНоменклатуры Тогда
		МассивНоменклатуры = ОбщегоНазначения.ВыгрузитьКолонку(ДокументОбъект.Товары, "Номенклатура", Истина);
		ВидДокумента = ВидДокументаПоНоменклатуре(МассивНоменклатуры);
		
	ИначеЕсли ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", Ложь) = Истина
		ИЛИ КоличествоТовараНеУказано Тогда
		ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот;
		
	Иначе
		ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная;
	КонецЕсли;
	
	ДокументОбъект.ВидДокумента = ВидДокумента;
	
	РежимЗаписиПроведение = ЗначениеЗаполнено(ДокументОбъект.ДокументОснование);
	
	ЗаписатьДокумент(ДокументОбъект, РежимЗаписиПроведение);
	СсылкаНаВладельца = ДокументОбъект.Ссылка;
	
КонецПроцедуры

Процедура НайтиСоздатьУКДСчетФактуру(ДеревоДанных, СсылкаНаВладельца = Неопределено, СпособОбработки = "")
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.СчетФактураПолученный.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.СчетФактура;
	
	ДокументОбъект.НомерЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
	ДокументОбъект.НомерИсправления = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления");
	Если ЗначениеЗаполнено(ДокументОбъект.НомерИсправления) Тогда
		ВидОперации = Перечисления.ВидыОпераций.Исправление;
		ДокументОбъект.ДатаЭД  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаИсправления");
		ДокументОбъект.НомерИсправляемогоКорректировочногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "НомерДокумента");
		ДокументОбъект.ДатаИсправляемогоКорректировочногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаДокумента");
	Иначе
		ВидОперации = Перечисления.ВидыОпераций.Корректировка;
		ДокументОбъект.ДатаЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаДокумента");
	КонецЕсли;
	ДокументОбъект.ВидОперации = ВидОперации;
	
	ДокументОбъект.НомерИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "НомерИсходногоДокумента");
	ДокументОбъект.ДатаИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДатаИсходногоДокумента");
	ДокументОбъект.НомерИсправленияИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "НомерИсправленияИсходногоДокумента");
	ДокументОбъект.ДатаИсправленияИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДатаИсправленияИсходногоДокумента");
	
	ДокументОбъект.Валюта = ЭлектронноеВзаимодействие.НайтиСсылку("Валюты",
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод"));
	
	ДокументОбъект.Контрагент  = КонтрагентПоДаннымЭД(ДеревоДанных, "СведенияОПродавце");
	ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(ДеревоДанных, "СведенияОПокупателе");
	
	ДокументОбъект.ИдентификаторГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта");
	
	// Поиск и заполнения договора контрагента.
	ОснованиеКорректировки = ДеревоДанных.Строки.Найти("ОснованиеКорректировки", "ПолныйПуть");
	Если ОснованиеКорректировки <> Неопределено Тогда
		Для Каждого СтрокаОснованиеКорректировки Из ОснованиеКорректировки.Строки Цикл
			ДоговорНомер = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеКорректировки, "ОснованиеКорректировки.НомерСтроки.ДокументНомер");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				ДоговорДата = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СтрокаОснованиеКорректировки, "ОснованиеКорректировки.НомерСтроки.ДокументДата");
				
				СвойстваДоговора = Новый Структура;
				СвойстваДоговора.Вставить("НомерДоговора", ДоговорНомер);
				СвойстваДоговора.Вставить("ДатаДоговора", ДоговорДата);
				СвойстваДоговора.Вставить("Организация", ДокументОбъект.Организация);
				СвойстваДоговора.Вставить("Владелец", ДокументОбъект.Контрагент);
				
				ДоговорКонтрагента = ЭлектронноеВзаимодействие.НайтиСсылку("ДоговорыКонтрагентов",, СвойстваДоговора);
				ДокументОбъект.ДоговорКонтрагента = ДоговорКонтрагента;
				
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	ДокументОбъект.ДокументыОснования.Очистить();
	ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
	Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		ТаблицаОснований = Документы.СчетФактураПолученный.ПустаяСсылка().ДокументыОснования.ВыгрузитьКолонки();
		Для Каждого ДокументОснования Из ДокументыОснованияСчетаФактуры Цикл
			Если ТипЗнч(ДокументОснования) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				ДокументОбъект.СчетФактураОснование = ДокументОснования;
			Иначе
				СтрокаТаблицы = ДокументОбъект.ДокументыОснования.Добавить();
				СтрокаТаблицы.ДокументОснование = ДокументОснования;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ДокументОбъект.Товары.Очистить();
	ОблагаетсяНДСУПокупателя = Ложь;
	ИспользоватьСопоставлениеНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	СуммаДокумента = 0;
	
	Если ДокументОбъект.ДокументыОснования.Количество() = 0 Тогда
		
		ТаблицаТоваров = ДокументОбъект.Товары.ВыгрузитьКолонки();
		СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(ТаблицаТоваров);
		
		// Сведения таблицы.
		СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
		Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
			
			НоваяСтрока = ТаблицаТоваров.Добавить();
			
			НоваяСтрока.КоличествоУпаковокДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.КоличествоДоКорректировки");
			НоваяСтрока.КоличествоУпаковок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.Количество");
			НоваяСтрока.ЦенаДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмеренияДоКорректировки");
			НоваяСтрока.Цена = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмерения");
			НоваяСтрока.СуммаДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалогаДоКорректировки");
			НоваяСтрока.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
			НоваяСтрока.СуммаАкцизаДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СуммаАкцизаДоКорректировки");
			НоваяСтрока.СуммаАкциза = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СуммаАкциза");
			
			СтавкаНДСДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.НалоговаяСтавкаДоКорректировки");
			СтавкаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
			Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
				НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
				ОблагаетсяНДСУПокупателя = Истина;
			Иначе
				НоваяСтрока.СтавкаНДСДоКорректировки = СтавкаНДСДоКорректировки;
				НоваяСтрока.СтавкаНДС = СтавкаНДС;
				НоваяСтрока.СуммаСНДСДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогомДоКорректировки");
				НоваяСтрока.СуммаСНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
				НоваяСтрока.СуммаНДСДоКорректировки  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.СуммаНалогаДоКорректировки");
				НоваяСтрока.СуммаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.СуммаНалога");
			КонецЕсли;
			
			СуммаДокумента = СуммаДокумента + НоваяСтрока.СуммаСНДС;
			
			КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(НоваяСтрока);
			
			ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокумента_ГИСМТ(ДокументОбъект, НоваяСтрока, СведенияОТоваре);
			
			Сопоставление = СведенияОТоваре.Строки.Найти(
			"СведенияОТоварах.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
			Если Сопоставление <> Неопределено Тогда
			
				Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.Идентификатор");
				Если ЗначениеЗаполнено(Идентификатор) Тогда
					НоваяСтрока.ИдентификаторКонтрагента = Идентификатор;
				КонецЕсли;
				
				Если ИспользоватьСопоставлениеНоменклатуры Тогда
				
					Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
					Если ЗначениеЗаполнено(Номенклатура) Тогда
						НоваяСтрока.Номенклатура = Номенклатура;
					КонецЕсли;
					
					Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.ХарактеристикаИБ");
					Если ЗначениеЗаполнено(Характеристика) Тогда
						НоваяСтрока.Характеристика = Характеристика;
					КонецЕсли;
					
					ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.УпаковкаИБ");
					Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
						НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
					КонецЕсли;

				КонецЕсли;
				
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
				ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод");
				Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
					НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.УпаковкаНоменклатуры(
						НоваяСтрока.Номенклатура, ЕдиницаИзмеренияКод);
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока.НаименованиеКонтрагента = ПредставлениеНоменклатурыПоставщика(
				ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ТоварНаименование"));
				
			РассчитатьКоличествоБазовыхЕдиниц(НоваяСтрока);
		КонецЦикла;
		
		СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(ТаблицаТоваров, ДокументОбъект.Контрагент);
		ДокументОбъект.Товары.Загрузить(ТаблицаТоваров);
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	СУММА(ПоступлениеТоваровУслуг.СуммаДокумента) КАК СуммаДокумента
			|ИЗ
			|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
			|ГДЕ
			|	ПоступлениеТоваровУслуг.Ссылка В(&Ссылка)";
		
		Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.ДокументыОснования.ВыгрузитьКолонку("ДокументОснование"));
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			СуммаДокумента = Выборка.СуммаДокумента;
		КонецЕсли;
		
		ОблагаетсяНДСУПокупателя = ДеревоДанных.Строки.Найти("НДС исчисляется налоговым агентом", "Значение", Истина) <> Неопределено;
		
	КонецЕсли;
	
	ДокументОбъект.СуммаДокумента = СуммаДокумента;
	
	ДокументОбъект.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;
	
	РежимЗаписиПроведение = ЗначениеЗаполнено(ДокументОбъект.СчетФактураОснование);
	
	ЗаписатьДокумент(ДокументОбъект, РежимЗаписиПроведение);
	СсылкаНаВладельца = ДокументОбъект.Ссылка;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеУКДИнформацияПродавцаФНС_2020(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ)
	СсылкаНаТекущийДокумент = СсылкаНаОбъект;
	Если СтруктураЭД.Функция = "КСЧФДИС" Тогда
		Если ТипЗнч(СсылкаНаТекущийДокумент) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	СчетФактураВыданныйДокументыОснования.ДокументОснование КАК ДокументОснование
			|ИЗ
			|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
			|ГДЕ
			|	СчетФактураВыданныйДокументыОснования.Ссылка = &Ссылка";
			
			Запрос.УстановитьПараметр("Ссылка", СсылкаНаТекущийДокумент);
			Выборка = Запрос.Выполнить().Выбрать();
			
			ДокументСсылкаДИС = Неопределено;
			Если Выборка.Следующий() Тогда
				ДокументСсылкаДИС = Выборка.ДокументОснование;
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ДокументСсылкаДИС) Тогда
				ШаблонСообщения = НСтр("ru = 'Для %1 универсальный корректировочный документ не применяется.'");
				ТекстСообщения = СтрШаблон(ШаблонСообщения, СсылкаНаТекущийДокумент);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				
				Возврат;
			КонецЕсли;
		Иначе
			СсылкаНаТекущийДокумент = Документы.СчетФактураВыданный.СчетФактураДокумента(СсылкаНаОбъект);
			Если Не ЗначениеЗаполнено(СсылкаНаТекущийДокумент) Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ИспользуетсяГосИС = КлиентЭДОВызовСервера.ИспользуетсяГосИС();
	Если ИспользуетсяГосИС Тогда
		СтруктураДанных = Документы[СсылкаНаТекущийДокумент.Метаданные().Имя].ПолучитьДанныеДляЭД(СсылкаНаТекущийДокумент, ИспользуетсяГосИС);
	Иначе
		СтруктураДанных = Документы[СсылкаНаТекущийДокумент.Метаданные().Имя].ПолучитьДанныеДляЭД(СсылкаНаТекущийДокумент);
	КонецЕсли;
	
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СсылкаКорректировочногоСчетаФактуры", СсылкаНаТекущийДокумент);
	
	Если ВыборкаШапки.ВидОперации = Перечисления.ВидыОпераций.Исправление 
		И ЗначениеЗаполнено(ВыборкаШапки.НомерИсправляемогоКорректировочногоДокумента)
		И ЗначениеЗаполнено(ВыборкаШапки.ДатаИсправляемогоКорректировочногоДокумента) Тогда
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			ВыборкаШапки.Ссылка, "Объект.НомерИсправляемогоКорректировочногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"НомерДокумента", ВыборкаШапки.НомерИсправляемогоКорректировочногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			ВыборкаШапки.Ссылка, "Объект.ДатаИсправляемогоКорректировочногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДатаДокумента",  ВыборкаШапки.ДатаИсправляемогоКорректировочногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаТекущийДокумент, "Объект.НомерИсправления");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления",
			ВыборкаШапки.НомерИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаТекущийДокумент, "Объект.ДатаИсправления");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления",
			ВыборкаШапки.ДатаИсправления, ПараметрыОбработкиОшибок);
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаТекущийДокумент, "Объект.НомерЭД");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента",
			ВыборкаШапки.Номер, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаТекущийДокумент, "Объект.Дата");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",
			ВыборкаШапки.Дата, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	ИсходныеДокументы = Новый ТаблицаЗначений;
	ИсходныеДокументы.Колонки.Добавить("НомерИсходногоДокумента");
	ИсходныеДокументы.Колонки.Добавить("ДатаИсходногоДокумента");
	ИсходныеДокументы.Колонки.Добавить("ИсправленияИсходногоДокумента");
	
	Если ЗначениеЗаполнено(ВыборкаШапки.НомерИсходногоДокумента)
		И ЗначениеЗаполнено(ВыборкаШапки.ДатаИсходногоДокумента) Тогда
		
		ИсходныйДокумент = ИсходныеДокументы.Добавить();
		ИсходныйДокумент.НомерИсходногоДокумента = ВыборкаШапки.НомерИсходногоДокумента;
		ИсходныйДокумент.ДатаИсходногоДокумента = ВыборкаШапки.ДатаИсходногоДокумента;
		
		ИсправленияИсходногоДокумента = Новый ТаблицаЗначений;
		ИсправленияИсходногоДокумента.Колонки.Добавить("НомерИсправленияИсходногоДокумента");
		ИсправленияИсходногоДокумента.Колонки.Добавить("ДатаИсправленияИсходногоДокумента");
		
		Если ЗначениеЗаполнено(ВыборкаШапки.НомерИсправленияИсходногоДокумента)
			И ЗначениеЗаполнено(ВыборкаШапки.ДатаИсправленияИсходногоДокумента) Тогда
			
			ИсправлениеИсходногоДокумента = ИсправленияИсходногоДокумента.Добавить();
			ИсправлениеИсходногоДокумента.НомерИсправленияИсходногоДокумента =
				ВыборкаШапки.НомерИсправленияИсходногоДокумента;
			ИсправлениеИсходногоДокумента.ДатаИсправленияИсходногоДокумента =
				ВыборкаШапки.ДатаИсправленияИсходногоДокумента;
			
		КонецЕсли;
		
		Если ИсправленияИсходногоДокумента.Количество() > 0 Тогда
			ИсходныйДокумент.ИсправленияИсходногоДокумента = ИсправленияИсходногоДокумента;
		КонецЕсли;
		
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ИсходныеДокументы, "ИсходныеДокументы");
	
	Если СтруктураЭД.Функция = "КСЧФ"
		Или СтруктураЭД.Функция = "КСЧФДИС" Тогда
		
		МассивОснований = Новый Массив;
		Если СтруктураДанных.Свойство("ВыборкаОснований") Тогда
			ВыборкаОснований = СтруктураДанных.ВыборкаОснований;
			Пока ВыборкаОснований.Следующий() Цикл
				МассивОснований.Добавить(ВыборкаОснований.ДокументОснование);
				
			КонецЦикла;
			
			Если ИспользуетсяГосИС Тогда
				СтруктураДанныхОснований = Документы[МассивОснований[0].Метаданные().Имя].ПолучитьДанныеДляЭД(МассивОснований, ИспользуетсяГосИС);
			Иначе
				СтруктураДанныхОснований = Документы[МассивОснований[0].Метаданные().Имя].ПолучитьДанныеДляЭД(МассивОснований);
			КонецЕсли;
			
			Если СтруктураДанныхОснований.ВыборкаШапки.Следующий() Тогда
				ЗаполнитьДеревоДанныхУКД_2020(СтруктураДанныхОснований, СтруктураЭД, ДеревоДанных);
				
			КонецЕсли;
		Иначе
			ЗаполнитьДеревоДанныхУКД_2020(СтруктураДанных, СтруктураЭД, ДеревоДанных);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаШапки.СчетФактураОснование) Тогда
			МассивОснований.Добавить(ВыборкаШапки.СчетФактураОснование);
			
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДокументыОснованияСчетаФактуры", МассивОснований);
		
	ИначеЕсли СтруктураЭД.Функция = "ДИС" ИЛИ СтруктураЭД.Функция = "СвИСРК" Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДокументыОснованияСчетаФактуры", ВыборкаШапки.ДокументОснование);
		
		ЗаполнитьДеревоДанныхУКД_2020(СтруктураДанных, СтруктураЭД, ДеревоДанных);

	ИначеЕсли СтруктураЭД.Функция = "СвИСЗК" Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДокументыОснованияСчетаФактуры", ВыборкаШапки.ДокументОснование);
		
		ЗаполнитьДеревоДанныхУКД0_2020(СтруктураДанных, СтруктураЭД, ДеревоДанных);
		
	КонецЕсли;
КонецПроцедуры



#КонецОбласти

#Область УКД2020

#Область РеализацияТоваровУслуг

Функция НайтиРеализациюТоваровУслуг(Знач НомерДокумента, Знач ДатаДокумента, Знач НомерИсправления = 0)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.НомерЭД = &НомерДокумента
	|	И ВЫБОР
	|			КОГДА РеализацияТоваровУслуг.НомерИсправления = 0
	|				ТОГДА НАЧАЛОПЕРИОДА(РеализацияТоваровУслуг.Дата, ДЕНЬ) = &ДатаДокумента
	|			ИНАЧЕ РеализацияТоваровУслуг.ДатаИсходногоДокумента = &ДатаДокумента
	|		КОНЕЦ
	|	И РеализацияТоваровУслуг.НомерИсправления <= &НомерИсправления
	|
	|УПОРЯДОЧИТЬ ПО
	|	РеализацияТоваровУслуг.НомерИсправления УБЫВ";
	Запрос.УстановитьПараметр("НомерДокумента", НомерДокумента);
	Запрос.УстановитьПараметр("ДатаДокумента", НачалоДня(ДатаДокумента));
	Запрос.УстановитьПараметр("НомерИсправления", НомерИсправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

// Заполняет в таблице товаров сведения по маркировке.
//
// Параметры:
//  СтрокаТовара			- СтрокаТаблицыЗначений - строка выгруженной таблицы документа. Должна обязательно содержать колонки:
//                             * НомерСтрокиИсходногоДокумента - Число - номер строки таблицы товаров документа, для которого заполняются данные.
//                             * СведенияОМаркировке - Произвольный - в данную колонку будет записана структура сведений по маркировке.
//  ТаблицаКодовДокумента	- ТаблицаЗначений - содержит сведения об упаковках. Должна обязательно содержать колонки:
//                             * ИдентификаторСтроки - Строка - идентификатор строки.
//                             * НомерУпаковки - Строка - код маркировки.
//  Документ				- ДокументСсылка - ссылка на документ, для которого заполняются данные.
//
Процедура ЗаполнитьРеквизитыМаркировкиВСтрокеТоваров_2019(СтрокаТовара, ТаблицаКодовДокумента, Документ)

	ПутьКДаннымДляОшибки = СтрШаблон("Объект.Товары[%1].МаркируемыеУпаковки", СтрокаТовара.НомерСтрокиИсходногоДокумента - 1);
	
	ТаблицаКодов = Новый ТаблицаЗначений;
	ТаблицаКодов.Колонки.Добавить("Код");
	
	СведенияОМаркировке = Новый Структура;
	СведенияОМаркировке.Вставить("ИндивидуальныеУпаковки", ТаблицаКодов);
	СтрокаТовара.СведенияОМаркировке = СведенияОМаркировке;
	
	ПараметрыПоиска = Новый Структура("ИдентификаторСтроки", СтрокаТовара.ИдентификаторСтроки);
	
	СтрокиУпаковок = ТаблицаКодовДокумента.НайтиСтроки(ПараметрыПоиска);
	Для Каждого СтрокаУпаковки Из СтрокиУпаковок Цикл
		НоваяСтрока = ТаблицаКодов.Добавить();
		НоваяСтрока.Код = СтрокаУпаковки.НомерУпаковки;
	КонецЦикла;
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаКодов,
		"Код", Документ, ПутьКДаннымДляОшибки);

КонецПроцедуры

// Заполняет коды маркировки в документе из дерева электронного документа.
//
// Параметры:
//  ДокументОбъект				 - ДокументОбъект - объект заполняемого документа.
//  СтрокаТоваров				 - СтрокаТабличнойЧасти - строка таблицы товаров документа.
//  СтрокаТоваровДерева			 - СтрокаДереваЗначений - строка товаров дерева электронного документа.
//  ЭтоИндивидуальныеУпаковки	 - Булево - Истина, если нужно заполнить индивидуальные упаковки,
//                                          Ложь, если нужно заполнить транспортные упаковки.
//
Процедура ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокумента_2019(ДокументОбъект, СтрокаТоваров, СтрокаТоваровДерева)
	ТаблицаДокумента = ДокументОбъект.КодыУпаковокМаркируемойПродукции;
	
	ИменаТаблицыУпаковокДерева = Новый Массив;
	ИменаТаблицыУпаковокДерева.Добавить("ИндивидуальныеУпаковки");
	ИменаТаблицыУпаковокДерева.Добавить("ТранспортныеУпаковки");
	ИменаТаблицыУпаковокДерева.Добавить("КонтрольныеИдентификационныеЗнаки");
	
	Для Каждого ИмяТаблицыУпаковокДерева Из ИменаТаблицыУпаковокДерева Цикл
		КодыУпаковок = СтрокаТоваровДерева.Строки.Найти(
			"СведенияОТоварах.НомерСтроки.СведенияОМаркировке." + ИмяТаблицыУпаковокДерева, "ПолныйПуть", Истина);
		Если КодыУпаковок <> Неопределено И ЗначениеЗаполнено(КодыУпаковок.Значение) Тогда
			Для Каждого СтрокаКодаУпаковки Из КодыУпаковок.Строки Цикл
				СтрокаНовойУпаковки = ТаблицаДокумента.Добавить();
				СтрокаНовойУпаковки.ИдентификаторСтроки = СтрокаТоваров.ИдентификаторСтроки;
				
				ПутьКНомеруУпаковки = СтрШаблон("СведенияОТоварах.НомерСтроки.СведенияОМаркировке.%1.НомерСтроки.Код", ИмяТаблицыУпаковокДерева);
				СтрокаНовойУпаковки.НомерУпаковки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаКодаУпаковки, ПутьКНомеруУпаковки);
				
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Заполняет сведения о прослеживаемости в документе из дерева электронного документа.
//
// Параметры:
//  ДокументОбъект				 - ДокументОбъект - объект заполняемого документа.
//  СтрокаТоваров				 - СтрокаТабличнойЧасти - строка таблицы товаров документа.
//  СтрокаТоваровДерева			 - СтрокаДереваЗначений - строка товаров дерева электронного документа.
//  ПутьПрослеживаемости		 - Строка - путь к данным о прослеживаемости в дереве электронного документа.
//
Процедура ЗаполнитьСведенияПрослеживаемостиИзДереваЭлектронногоДокумента(ДокументОбъект, СтрокаТоваров, СтрокаТоваровДерева,
	ПутьПрослеживаемости = "СведенияОТоварах.НомерСтроки.СведенияОПрослеживаемости")
	ТаблицаДокумента = ДокументОбъект.СведенияПрослеживаемости;
	
	ЗначениеРеквизита = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаТоваровДерева, ПутьПрослеживаемости);
	Если ТипЗнч(ЗначениеРеквизита) = Тип("Число") И ЗначениеРеквизита > 0 Тогда
		СведенияОПрослеживаемости = СтрокаТоваровДерева.Строки.Найти(ПутьПрослеживаемости, "ПолныйПуть", Истина);
		Для Каждого СтрокаСведений Из СведенияОПрослеживаемости.Строки Цикл
			СтрокаНовыхСведений = ТаблицаДокумента.Добавить();
			СтрокаНовыхСведений.ИдентификаторСтроки = СтрокаТоваров.ИдентификаторСтроки;
			
			Путь = ПутьПрослеживаемости + ".НомерСтроки.НомерТовара";
			СтрокаНовыхСведений.РНПТ = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СтрокаСведений, Путь, Ложь);
			
			Путь = ПутьПрослеживаемости + ".НомерСтроки.КоличествоУчетное";
			СтрокаНовыхСведений.КоличествоУпаковок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СтрокаСведений, Путь, Ложь);
			
			Если СтрокаНовыхСведений.КоличествоУпаковок = 0 Тогда
				Путь = ПутьПрослеживаемости + ".НомерСтроки.КоличествоТовараУчетноеПослеИзменения";
				СтрокаНовыхСведений.КоличествоУпаковок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СтрокаСведений, Путь, Ложь);
			КонецЕсли;
			
			Путь = ПутьПрослеживаемости + ".НомерСтроки.КоличествоТовараУчетноеДоИзменения";
			СтрокаНовыхСведений.КоличествоУпаковокДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СтрокаСведений, Путь, Ложь);
			
			Путь = ПутьПрослеживаемости + ".НомерСтроки.Количество";
			СтрокаНовыхСведений.КоличествоПрослеживаемости = 
				ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СтрокаСведений, Путь, Ложь);
			
			Если СтрокаНовыхСведений.КоличествоПрослеживаемости = 0 Тогда
				Путь = ПутьПрослеживаемости + ".НомерСтроки.КоличествоТовараПослеИзменения";
				СтрокаНовыхСведений.КоличествоПрослеживаемости = 
					ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СтрокаСведений, Путь, Ложь);
			КонецЕсли;
			
			Путь = ПутьПрослеживаемости + ".НомерСтроки.КоличествоТовараДоИзменения";
			СтрокаНовыхСведений.КоличествоПрослеживаемостиДоКорректировки = 
				ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СтрокаСведений, Путь, Ложь);
				
			Путь = ПутьПрослеживаемости + ".НомерСтроки.ЕдиницаИзмеренияКод";
			ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СтрокаСведений, Путь, Ложь);
			
			Путь = ПутьПрослеживаемости + ".НомерСтроки.ЕдиницаИзмеренияНаименование";
			ЕдиницаИзмеренияНаименование = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СтрокаСведений, Путь, Ложь);
			
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
				Если ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры") Тогда
					СтрокаНовыхСведений.ЕдиницаИзмеренияПрослеживаемости = Справочники.ЕдиницыИзмерения.УпаковкаНоменклатуры(
					СтрокаТоваров.Номенклатура, ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
				Иначе
					СтрокаНовыхСведений.ЕдиницаИзмеренияПрослеживаемости = Справочники.ЕдиницыИзмерения.ЕдиницаИзмеренияПоКоду(
						ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
				КонецЕсли;
			КонецЕсли;
			
			Путь = ПутьПрослеживаемости + ".НомерСтроки.СтоимостьБезНДС";
			СтрокаНовыхСведений.СтоимостьБезНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СтрокаСведений, Путь, Ложь);
		
			Путь = ПутьПрослеживаемости + ".НомерСтроки.СтоимостьБезНДСДоИзменения";
			СтрокаНовыхСведений.СтоимостьБезНДСДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СтрокаСведений, Путь, Ложь);
			
			Если СтрокаНовыхСведений.СтоимостьБезНДС = 0 Тогда
				Путь = ПутьПрослеживаемости + ".НомерСтроки.СтоимостьБезНДСПослеИзменения";
				СтрокаНовыхСведений.СтоимостьБезНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СтрокаСведений, Путь, Ложь);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

