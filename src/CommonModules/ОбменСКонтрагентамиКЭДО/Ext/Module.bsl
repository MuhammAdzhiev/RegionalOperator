	КонецЕсли;
	Если ЗначениеЗаполнено(ВыборкаШапка.ВремяОкончанияПриемки) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "ВремяПриемкиОкончание", ВыборкаШапка.ВремяОкончанияПриемки);
	КонецЕсли;
	Если ЗначениеЗаполнено(ВыборкаШапка.ДатаОтправленияТоваров) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "ДатаОтправки", ВыборкаШапка.ДатаОтправленияТоваров);
	КонецЕсли;
	//  СертификатыСоответствия.
	ВыборкаСертификатыСоответствия = СтруктураДанных.ВыборкаСертификатыСоответствия;
	НаборСертификатов = Новый Массив;
	Пока ВыборкаСертификатыСоответствия.Следующий() Цикл
		НаборСертификатов.Добавить(ВыборкаСертификатыСоответствия.Номер);
	КонецЦикла;
	Если ЗначениеЗаполнено(НаборСертификатов) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "СертификатыСоответствия", НаборСертификатов);
	КонецЕсли;
	//  Сопроводительный документ.
	СопроводительныйДокументНаименование = ?(ЗначениеЗаполнено(ВыборкаШапка.СопроводительныйДокументНаименование),
		ВыборкаШапка.СопроводительныйДокументНаименование, "БСД");
	СопроводительныйДокументНомер = ?(ЗначениеЗаполнено(ВыборкаШапка.СопроводительныйДокументНомер),
		ВыборкаШапка.СопроводительныйДокументНомер, "б/н");
