			ИначеЕсли ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав Тогда
				ЕстьПрава = Истина;
				НоваяСтрока.Признак = "4";
				
			ИначеЕсли ВыборкаТоваров.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар Тогда
