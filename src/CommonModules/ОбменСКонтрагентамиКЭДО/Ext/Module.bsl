// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеПоЗаказуТоваров.
Процедура ЗаполнитьДанныеПоЗаказуТоваров(СсылкаНаОбъект, ДеревоДокумента, Отказ) Экспорт 
	
	СтруктураДанных = Документы[СсылкаНаОбъект.Метаданные().Имя].ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	ТаблицаТоваров = СтруктураДанных.РезультатПоТабличнойЧасти.Выгрузить();
	
	ПроверитьСопоставлениеСНоменклатуройКонтрагента(ТаблицаТоваров, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыШапки = СтруктураДанных.РезультатПоШапке.Выбрать();
	РеквизитыШапки.Следующий();
	
	Если РеквизитыШапки.ОблагаетсяНДСУПокупателя Тогда
		Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
			СтрокаТовара.СуммаНДС = 0;
			СтрокаТовара.СуммаСНДС = СтрокаТовара.Сумма;
		КонецЦикла;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РеквизитыШапки.Валюта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.Валюта");
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(РеквизитыШапки.Валюта, 
			"Объект.Код");
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Валюта", РеквизитыШапки.ВалютаКод, ПараметрыОбработкиОшибок);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Курс", РаботаСКурсамиВалют.ПолучитьКурсВалюты(РеквизитыШапки.Валюта, СсылкаНаОбъект.Дата).Курс);
	
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить сумму документа. Возможные причины:
		|	- не заполнена табличная часть ""Товары""
		|	- не заполнена колонка ""Сумма""'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Сумма", РеквизитыШапки.СуммаДокумента,
		ТекстОшибки);
	
	ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
		"Объект.Основание");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ДокументыОснования",
		РеквизитыШапки.ДокументОснование, ПараметрыОбработкиОшибок);
	
	// Заполняем Организацию
	СведенияОбОрганизации = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(РеквизитыШапки.Организация, СведенияОбОрганизации);
	ЗаполнитьДанныеУчастника(ДеревоДокумента, СведенияОбОрганизации, "Покупатель", Истина);
	ЗаполнитьДанныеУчастника(ДеревоДокумента, СведенияОбОрганизации, "Получатель", Истина);
	
	// Заполняем контрагента
	СведенияОКонтрагенте = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(РеквизитыШапки.Контрагент, СведенияОКонтрагенте);
	ЗаполнитьДанныеУчастника(ДеревоДокумента, СведенияОКонтрагенте, "Продавец", Истина);
	
	СоответствиеСтавокНДСКонтрагента = Новый Соответствие;
	ЗаполнитьСоответствиеСтавокНДС(СоответствиеСтавокНДСКонтрагента);
	ТаблицаТоваров.Колонки.Добавить("Сопоставление");
	
	ШтрихкодыКомбинаций   = Неопределено;
	ШтрихкодыНоменклатуры = Неопределено;
	Если НЕ СтруктураДанных.Свойство("ШтрихкодыНоменклатуры", ШтрихкодыНоменклатуры)
		ИЛИ НЕ СтруктураДанных.Свойство("ШтрихкодыКомбинаций", ШтрихкодыКомбинаций) Тогда
		ШтрихкодыПоТоварам(ТаблицаТоваров, ШтрихкодыКомбинаций, ШтрихкодыНоменклатуры);
	КонецЕсли;

	СведенияОТоварах = Новый ТаблицаЗначений;
	СведенияОТоварах.Колонки.Добавить("НомерСтроки");
	СведенияОТоварах.Колонки.Добавить("Артикул");
	СведенияОТоварах.Колонки.Добавить("Наименование");
	СведенияОТоварах.Колонки.Добавить("ШтрихКод");
	СведенияОТоварах.Колонки.Добавить("Описание");
	СведенияОТоварах.Колонки.Добавить("Страна");
	СведенияОТоварах.Колонки.Добавить("ТорговаяМарка");
	СведенияОТоварах.Колонки.Добавить("СуммаАкциза");
	СведенияОТоварах.Колонки.Добавить("НаименованиеХарактеристики");
	СведенияОТоварах.Колонки.Добавить("ИдКаталога");
	СведенияОТоварах.Колонки.Добавить("ИдКлассификатора");
	СведенияОТоварах.Колонки.Добавить("СтранаПроисхождения");
	СведенияОТоварах.Колонки.Добавить("ГТД");
	СведенияОТоварах.Колонки.Добавить("Цена");
	СведенияОТоварах.Колонки.Добавить("Количество");
	СведенияОТоварах.Колонки.Добавить("Сумма");
	СведенияОТоварах.Колонки.Добавить("НДСУчтеноВСумме");
	СведенияОТоварах.Колонки.Добавить("СуммаНДС");
	СведенияОТоварах.Колонки.Добавить("СтавкаНДС");
	СведенияОТоварах.Колонки.Добавить("НаименованиеСкидки");
	СведенияОТоварах.Колонки.Добавить("СуммаСкидки");
	СведенияОТоварах.Колонки.Добавить("ПроцентСкидки");
	СведенияОТоварах.Колонки.Добавить("СкидкаУчтеноВСумме");
	СведенияОТоварах.Колонки.Добавить("КомментарийКСкидке");
	СведенияОТоварах.Колонки.Добавить("Номенклатура"); 
	СведенияОТоварах.Колонки.Добавить("Характеристика");
	СведенияОТоварах.Колонки.Добавить("Сопоставление");
	
	СведенияОТоварах.Колонки.Добавить("БазоваяЕдиницаКод");
	СведенияОТоварах.Колонки.Добавить("БазоваяЕдиницаНаименование");
	СведенияОТоварах.Колонки.Добавить("БазоваяЕдиницаНаименованиеПолное");
	СведенияОТоварах.Колонки.Добавить("БазоваяЕдиницаМеждународноеСокращение");
	
	СведенияОТоварах.Колонки.Добавить("ЕдиницаИзмеренияКодПоОКЕИ");
	СведенияОТоварах.Колонки.Добавить("ЕдиницаИзмеренияКоэффициент");
	
	СведенияОТоварах.Колонки.Добавить("ЕдиницаИзмерения");
	СведенияОТоварах.Колонки.Добавить("БазоваяЕдиницаСсылка");

	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		НоваяСтрока = СведенияОТоварах.Добавить();
		НоваяСтрока.НомерСтроки = СтрокаТовара.НомерСтроки;
		НоваяСтрока.Артикул = СтрокаТовара.Артикул;
		НоваяСтрока.Наименование = СтрокаТовара.НаименованиеПолное;
		НоваяСтрока.ШтрихКод = СтрокаТовара.ШтрихкодКомбинацииПоставщика;
		НоваяСтрока.Цена = СтрокаТовара.Цена;
		НоваяСтрока.Количество = СтрокаТовара.КоличествоУпаковок;
		НоваяСтрока.Сумма = СтрокаТовара.Сумма;
		НоваяСтрока.НДСУчтеноВСумме = СтрокаТовара.НДСУчтеноВСумме;
		НоваяСтрока.СуммаНДС = СтрокаТовара.СуммаНДС;
		НоваяСтрока.СтавкаНДС = СтрокаТовара.СтавкаНДС;
		НоваяСтрока.СуммаСкидки = СтрокаТовара.СуммаСкидки;
		НоваяСтрока.ПроцентСкидки = СтрокаТовара.ПроцентСкидки;
		НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура;  
		НоваяСтрока.Характеристика = СтрокаТовара.Характеристика;
		НоваяСтрока.НаименованиеХарактеристики = СтрокаТовара.ХарактеристикаНаименование;
		
		// Данные базовой единицы измерения, указанной в соответствующем реквизите номенклатуры
		НоваяСтрока.БазоваяЕдиницаКод = СтрокаТовара.БазоваяЕдиницаКод;
		НоваяСтрока.БазоваяЕдиницаНаименование = СтрокаТовара.БазоваяЕдиницаНаименование;
		НоваяСтрока.БазоваяЕдиницаНаименованиеПолное = СтрокаТовара.БазоваяЕдиницаНаименованиеПолное;
		НоваяСтрока.БазоваяЕдиницаМеждународноеСокращение = СтрокаТовара.БазоваяЕдиницаМеждународноеСокращение;
		
		// Данные упаковки, указанной в табличной части
		НоваяСтрока.ЕдиницаИзмеренияКодПоОКЕИ = СтрокаТовара.ЕдиницаИзмеренияКод;
		НоваяСтрока.ЕдиницаИзмеренияКоэффициент = СтрокаТовара.ЕдиницаИзмеренияКоэффициент;
		
		// Ссылки
		НоваяСтрока.ЕдиницаИзмерения = СтрокаТовара.ЕдиницаИзмерения;
		НоваяСтрока.БазоваяЕдиницаСсылка = СтрокаТовара.БазоваяЕдиницаСсылка;
		
		Сопоставление = Новый Структура;
		Если ЗначениеЗаполнено(СтрокаТовара.ИдентификаторКонтрагента) Тогда
			Если Не ЗначениеЗаполнено(СтрокаТовара.НаименованиеПолное) Тогда
				НоваяСтрока.Наименование = СтрокаТовара.НаименованиеКонтрагента;
			КонецЕсли;
			
			Сопоставление.Вставить("Идентификатор",         СтрокаТовара.ИдентификаторКонтрагента);
			Сопоставление.Вставить("Наименование",          СтрокаТовара.НаименованиеКонтрагента);
			Сопоставление.Вставить("Артикул"       ,        СтрокаТовара.Артикул);
			Сопоставление.Вставить("Характеристика",        СтрокаТовара.ХарактеристикаКонтрагента);
			Сопоставление.Вставить("ЕдиницаИзмерения",      СтрокаТовара.ЕдиницаИзмеренияПоставщика);
			Сопоставление.Вставить("ЕдиницаИзмеренияКод",   СтрокаТовара.ЕдиницаИзмеренияКодПоставщика);
			Сопоставление.Вставить("СтавкаНДС",             СоответствиеСтавокНДСКонтрагента.Получить(СтрокаТовара.СтавкаНДСПоставщика));
			Сопоставление.Вставить("ШтрихкодыНоменклатуры", СтрокаТовара.ШтрихкодыНоменклатурыПоставщика);
			Сопоставление.Вставить("ШтрихкодКомбинации",    СтрокаТовара.ШтрихкодКомбинацииПоставщика);
		Иначе
			Сопоставление.Вставить("Наименование", СтрокаТовара.НаименованиеПолное);
			Если ЗначениеЗаполнено(СтрокаТовара.Характеристика) Тогда
				Сопоставление.Вставить("Характеристика", СтрокаТовара.ХарактеристикаНаименование);
			КонецЕсли;
			Сопоставление.Вставить("ЕдиницаИзмерения"   , СтрокаТовара.ЕдиницаИзмеренияНаименование);
			Сопоставление.Вставить("ЕдиницаИзмеренияКод", СтрокаТовара.ЕдиницаИзмеренияКод);
			Сопоставление.Вставить("СтавкаНДС", СтрокаТовара.НоменклатураСтавкаНДС);
			Сопоставление.Вставить("Артикул"  , СтрокаТовара.НоменклатураАртикул);
			
			ЗаполнитьШтрихкодыТоваровВСопоставление(Сопоставление, ШтрихкодыНоменклатуры, ШтрихкодыКомбинаций,
				СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика, СтрокаТовара.ЕдиницаИзмерения);
		КонецЕсли;
		
		Сопоставление.Вставить("НоменклатураИБ",   СтрокаТовара.Номенклатура);
		Сопоставление.Вставить("ХарактеристикаИБ", СтрокаТовара.Характеристика);
		Сопоставление.Вставить("УпаковкаИБ",       СтрокаТовара.ЕдиницаИзмерения);
		
		НоваяСтрока.Сопоставление = Сопоставление;

	КонецЦикла;
	
	// Заполняется таблица документы сделки
	ЗаполнитьДокументыСделки(ДеревоДокумента, РеквизитыШапки);
	
	ЗаполнитьПараметрыОбработкиОшибокВТаблицеТоваровCML(СведенияОТоварах, СсылкаНаОбъект);
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДокумента, СведенияОТоварах, "Товары");
	СуммаИтог   =  ТаблицаТоваров.Итог("Сумма");
	СкидкаИтог  =  ТаблицаТоваров.Итог("СуммаСкидки");
	НалогиИтог  =  ТаблицаТоваров.Итог("СуммаНДС");
	// Заполняем банковский счет
	Если ЗначениеЗаполнено(РеквизитыШапки.НомерСчета) Тогда
		ДобавитьВДеревоДанныеСчета(ДеревоДокумента, РеквизитыШапки);
	КонецЕсли;
	
	// заполним строку Итогов
	СуммаИтог = ТаблицаТоваров.Итог("Сумма");
	
	ТекстОшибки = НСтр("ru = 'Не удалось итоговые стоимостные показатели. Возможные причины:
		|	- не заполнена табличная часть ""Товары""
		|	- не заполнена колонка ""Сумма""'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Сумма", РеквизитыШапки.СуммаДокумента,
		ТекстОшибки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаИтог", 
		СуммаИтог, ТекстОшибки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаНалогаИтог",
		НалогиИтог, ТекстОшибки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.ЦенаВключаетНДС",
		РеквизитыШапки.ЦенаВключаетНДС);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаБезСкидкиИтог",
		СуммаИтог + СкидкаИтог, ТекстОшибки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаСкидкиИтог",
		СкидкаИтог, ТекстОшибки);
	
	// Заполнение данных о доставке.
	АдресДоставки = Новый Структура("АдресДоставки", РеквизитыШапки.АдресДоставки);
	АдресДоставкиЗначенияПолей = Новый Структура("АдресДоставкиЗначенияПолей", РеквизитыШапки.АдресДоставкиЗначенияПолей);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Доставка.СпособДоставки",
		?(РеквизитыШапки.СпособДоставки = Перечисления.СпособыДоставки.Доставка, "Доставка", "Самовывоз"));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Доставка.АдресДоставки", РеквизитыШапки.АдресДоставки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Доставка.АдресДоставкиЗначенияПолей",
		РеквизитыШапки.АдресДоставкиЗначенияПолей);
	
	// заполним итоги прописью
	ШаблонИтоговаяСтрока = НСтр("ru='Всего наименований %1 на сумму %2'");
	ИтоговаяСтрока = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонИтоговаяСтрока,
																			ТаблицаТоваров.Количество(),
																			РеквизитыШапки.СуммаДокумента);
																			
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогиПрописью", ИтоговаяСтрока);

	Если СтруктураДанных.Свойство("РезультатПоЭтапамГрафикаОплат")
		И СтруктураДанных.РезультатПоЭтапамГрафикаОплат.Количество() > 0 Тогда
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "СрокПлатежа", 
			СтруктураДанных.РезультатПоЭтапамГрафикаОплат[0].ДатаПлатежа);
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(
			ДеревоДокумента, СтруктураДанных.РезультатПоЭтапамГрафикаОплат, "ГрафикОплаты");
	КонецЕсли;

КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеПоОтветуНаЗаказ.
Процедура ЗаполнитьДанныеПоОтветуНаЗаказ(СсылкаНаОбъект, ДеревоДокумента, Отказ) Экспорт
	СтруктураДанных = Документы[СсылкаНаОбъект.Метаданные().Имя].ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	
	ТаблицаТоваров = СтруктураДанных.РезультатПоТабличнойЧасти.Выгрузить();
	
	РеквизитыШапки =  СтруктураДанных.РезультатПоШапке.Выбрать();
	РеквизитыШапки.Следующий();
	
	Если РеквизитыШапки.ОблагаетсяНДСУПокупателя Тогда
		Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
			СтрокаТовара.СуммаНДС = 0;
			СтрокаТовара.СуммаСНДС = СтрокаТовара.Сумма;
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
		"Объект.НомерЭД");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "НомерДокументаОснования",
		РеквизитыШапки.НомерПоДаннымКлиента, ПараметрыОбработкиОшибок);
		
	ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
		"Объект.ДатаЭД");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ДатаДокументаОснования",
		РеквизитыШапки.ДатаПоДаннымКлиента, ПараметрыОбработкиОшибок);
		
	Если Не ЗначениеЗаполнено(РеквизитыШапки.Валюта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.Валюта");
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(РеквизитыШапки.Валюта, 
			"Объект.Код");
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Валюта", РеквизитыШапки.ВалютаКод,
		ПараметрыОбработкиОшибок);

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Курс", РаботаСКурсамиВалют.ПолучитьКурсВалюты(РеквизитыШапки.Валюта, СсылкаНаОбъект.Дата).Курс);
	
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить сумму документа. Возможные причины:
		|	- не заполнена табличная часть ""Товары""
		|	- не заполнена колонка ""Сумма""'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Сумма", РеквизитыШапки.СуммаДокумента);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Комментарий", РеквизитыШапки.ДополнительнаяИнформация);
	
	ТекстОшибки = НСтр("ru = 'Не удалось итоговые стоимостные показатели. Возможные причины:
		|	- не заполнена табличная часть ""Товары""
		|	- не заполнена колонка ""Сумма""'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.ЦенаВключаетНДС",
		РеквизитыШапки.ЦенаВключаетНДС, ТекстОшибки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаИтог",
		РеквизитыШапки.СуммаДокумента, ТекстОшибки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаНалогаИтог",
		ТаблицаТоваров.Итог("СуммаНДС"), ТекстОшибки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаБезСкидкиИтог",
		ТаблицаТоваров.Итог("Сумма") + ТаблицаТоваров.Итог("СуммаСкидки"), ТекстОшибки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаСкидкиИтог",
		ТаблицаТоваров.Итог("СуммаСкидки"),ТекстОшибки);
	
		// Заполняем банковский счет
	Если ЗначениеЗаполнено(РеквизитыШапки.НомерСчета) Тогда
		ДобавитьВДеревоДанныеСчета(ДеревоДокумента, РеквизитыШапки);
	КонецЕсли;
	
	// Документ основание.
	ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
		"Объект.Основание");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ДокументыОснования", РеквизитыШапки.ДокументОснование,
		ПараметрыОбработкиОшибок);
	
	// Заполняем Контрагентов
	СведенияОКонтрагенте = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(РеквизитыШапки.Контрагент, СведенияОКонтрагенте);
	ЗаполнитьДанныеУчастника(ДеревоДокумента, СведенияОКонтрагенте, "Покупатель", Истина);
	ЗаполнитьДанныеУчастника(ДеревоДокумента, СведенияОКонтрагенте, "Получатель", Истина);
	
	// Заполняем организацию
	СведенияОбОрганизации = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(РеквизитыШапки.Организация, СведенияОбОрганизации);
	ЗаполнитьДанныеУчастника(ДеревоДокумента, СведенияОбОрганизации, "Продавец", Истина);
	
	// Заполняется таблица документы сделки
	ЗаполнитьДокументыСделки(ДеревоДокумента, РеквизитыШапки);
	
	ТаблицаТоваров.Колонки.Добавить("Сопоставление");
	
	СоответствиеСтавокНДСКонтрагента = Новый Соответствие;
	ЗаполнитьСоответствиеСтавокНДС(СоответствиеСтавокНДСКонтрагента);
	
	ШтрихкодыКомбинаций   = Неопределено;
	ШтрихкодыНоменклатуры = Неопределено;
	Если НЕ СтруктураДанных.Свойство("ШтрихкодыНоменклатуры", ШтрихкодыНоменклатуры)
		ИЛИ НЕ СтруктураДанных.Свойство("ШтрихкодыКомбинаций", ШтрихкодыКомбинаций) Тогда
		ШтрихкодыПоТоварам(ТаблицаТоваров, ШтрихкодыКомбинаций, ШтрихкодыНоменклатуры);
	КонецЕсли;

	СведенияОТоварах = Новый ТаблицаЗначений;
	СведенияОТоварах.Колонки.Добавить("НомерСтроки");
	СведенияОТоварах.Колонки.Добавить("Артикул");
	СведенияОТоварах.Колонки.Добавить("Наименование");
	СведенияОТоварах.Колонки.Добавить("ШтрихКод");
	СведенияОТоварах.Колонки.Добавить("Описание");
	СведенияОТоварах.Колонки.Добавить("Страна");
	СведенияОТоварах.Колонки.Добавить("ТорговаяМарка");
	СведенияОТоварах.Колонки.Добавить("СуммаАкциза");
	СведенияОТоварах.Колонки.Добавить("НаименованиеХарактеристики");
	СведенияОТоварах.Колонки.Добавить("ИдКаталога");
	СведенияОТоварах.Колонки.Добавить("ИдКлассификатора");
	СведенияОТоварах.Колонки.Добавить("СтранаПроисхождения");
	СведенияОТоварах.Колонки.Добавить("ГТД");
	СведенияОТоварах.Колонки.Добавить("Цена");
	СведенияОТоварах.Колонки.Добавить("Количество");
	СведенияОТоварах.Колонки.Добавить("Сумма");
	СведенияОТоварах.Колонки.Добавить("НДСУчтеноВСумме");
	СведенияОТоварах.Колонки.Добавить("СуммаНДС");
	СведенияОТоварах.Колонки.Добавить("СтавкаНДС");
	СведенияОТоварах.Колонки.Добавить("НаименованиеСкидки");
	СведенияОТоварах.Колонки.Добавить("СуммаСкидки");
	СведенияОТоварах.Колонки.Добавить("ПроцентСкидки");
	СведенияОТоварах.Колонки.Добавить("СкидкаУчтеноВСумме");
	СведенияОТоварах.Колонки.Добавить("КомментарийКСкидке");
	СведенияОТоварах.Колонки.Добавить("Номенклатура"); 
	СведенияОТоварах.Колонки.Добавить("Характеристика");
	СведенияОТоварах.Колонки.Добавить("Сопоставление");
	
	СведенияОТоварах.Колонки.Добавить("БазоваяЕдиницаКод");
	СведенияОТоварах.Колонки.Добавить("БазоваяЕдиницаНаименование");
	СведенияОТоварах.Колонки.Добавить("БазоваяЕдиницаНаименованиеПолное");
	СведенияОТоварах.Колонки.Добавить("БазоваяЕдиницаМеждународноеСокращение");
	
	СведенияОТоварах.Колонки.Добавить("ЕдиницаИзмеренияКодПоОКЕИ");
	СведенияОТоварах.Колонки.Добавить("ЕдиницаИзмеренияКоэффициент");

	СведенияОТоварах.Колонки.Добавить("ЕдиницаИзмерения"); 
	СведенияОТоварах.Колонки.Добавить("БазоваяЕдиницаСсылка");
	
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		НоваяСтрока = СведенияОТоварах.Добавить();
		НоваяСтрока.НомерСтроки = СтрокаТовара.НомерСтроки;
		НоваяСтрока.Артикул = СтрокаТовара.Артикул;
		НоваяСтрока.Наименование = СтрокаТовара.НаименованиеПолное;
		НоваяСтрока.ШтрихКод = СтрокаТовара.ШтрихкодКомбинацииКонтрагента;
		НоваяСтрока.Цена = СтрокаТовара.Цена;
		НоваяСтрока.Количество = СтрокаТовара.КоличествоУпаковок;
		НоваяСтрока.Сумма = СтрокаТовара.Сумма;
		НоваяСтрока.НДСУчтеноВСумме = СтрокаТовара.НДСУчтеноВСумме;
		НоваяСтрока.СуммаНДС = СтрокаТовара.СуммаНДС;
		НоваяСтрока.СтавкаНДС = СтрокаТовара.СтавкаНДС;
		НоваяСтрока.СуммаСкидки = СтрокаТовара.СуммаСкидки;
		НоваяСтрока.ПроцентСкидки = СтрокаТовара.ПроцентСкидки;
		НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура;  
		НоваяСтрока.Характеристика = СтрокаТовара.Характеристика;
		НоваяСтрока.НаименованиеХарактеристики = СтрокаТовара.ХарактеристикаНаименование;
		
		НоваяСтрока.БазоваяЕдиницаКод = СтрокаТовара.БазоваяЕдиницаКод;
		НоваяСтрока.БазоваяЕдиницаНаименование = СтрокаТовара.БазоваяЕдиницаНаименование;
		НоваяСтрока.БазоваяЕдиницаНаименованиеПолное = СтрокаТовара.БазоваяЕдиницаНаименованиеПолное;
		НоваяСтрока.БазоваяЕдиницаМеждународноеСокращение = СтрокаТовара.БазоваяЕдиницаМеждународноеСокращение;
		НоваяСтрока.ЕдиницаИзмеренияКодПоОКЕИ = СтрокаТовара.ЕдиницаИзмеренияКод;
		НоваяСтрока.ЕдиницаИзмеренияКоэффициент = СтрокаТовара.ЕдиницаИзмеренияКоэффициент;
		
		НоваяСтрока.ЕдиницаИзмерения = СтрокаТовара.ЕдиницаИзмерения;
		НоваяСтрока.БазоваяЕдиницаСсылка = СтрокаТовара.БазоваяЕдиницаСсылка;
		
		Сопоставление = Новый Структура;
		Если ЗначениеЗаполнено(СтрокаТовара.ИдентификаторКонтрагента) Тогда
			Сопоставление.Вставить("Идентификатор",         СтрокаТовара.ИдентификаторКонтрагента);
			Сопоставление.Вставить("Наименование",          СтрокаТовара.НаименованиеКонтрагента);
			Сопоставление.Вставить("Артикул"       ,        СтрокаТовара.АртикулКонтрагента);
			Сопоставление.Вставить("Характеристика",        СтрокаТовара.ХарактеристикаКонтрагента);
			Сопоставление.Вставить("ЕдиницаИзмерения",      СтрокаТовара.ЕдиницаИзмеренияКонтрагента);
			Сопоставление.Вставить("ЕдиницаИзмеренияКод",   СтрокаТовара.ЕдиницаИзмеренияКодКонтрагента);
			Сопоставление.Вставить("СтавкаНДС",             СоответствиеСтавокНДСКонтрагента.Получить(СтрокаТовара.СтавкаНДСКонтрагента));
			Сопоставление.Вставить("ШтрихкодыНоменклатуры", СтрокаТовара.ШтрихкодыНоменклатурыКонтрагента);
			Сопоставление.Вставить("ШтрихкодКомбинации",    СтрокаТовара.ШтрихкодКомбинацииКонтрагента);
		Иначе
			Сопоставление.Вставить("Наименование", СтрокаТовара.НаименованиеПолное);
			Если ЗначениеЗаполнено(СтрокаТовара.Характеристика) Тогда
				Сопоставление.Вставить("Характеристика", СтрокаТовара.ХарактеристикаНаименование);
			КонецЕсли;
			Сопоставление.Вставить("ЕдиницаИзмерения"   , СтрокаТовара.ЕдиницаИзмеренияНаименование);
			Сопоставление.Вставить("ЕдиницаИзмеренияКод", СтрокаТовара.ЕдиницаИзмеренияКод);
			Сопоставление.Вставить("СтавкаНДС", СтрокаТовара.НоменклатураСтавкаНДС);
			Сопоставление.Вставить("Артикул"  , СтрокаТовара.НоменклатураАртикул);
			
			ЗаполнитьШтрихкодыТоваровВСопоставление(Сопоставление, ШтрихкодыНоменклатуры, ШтрихкодыКомбинаций,
				СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика, СтрокаТовара.ЕдиницаИзмерения);
		КонецЕсли;
		
		Сопоставление.Вставить("НоменклатураИБ", СтрокаТовара.Номенклатура);
		Сопоставление.Вставить("ХарактеристикаИБ", СтрокаТовара.Характеристика);
		Сопоставление.Вставить("УпаковкаИБ", СтрокаТовара.ЕдиницаИзмерения);
		
		НоваяСтрока.Сопоставление = Сопоставление;
	КонецЦикла;
	
	ЗаполнитьПараметрыОбработкиОшибокВТаблицеТоваровCML(СведенияОТоварах, СсылкаНаОбъект);
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДокумента, СведенияОТоварах, "Товары");
	

	// Заполнение данных о доставке.
	АдресДоставки = Новый Структура("АдресДоставки", РеквизитыШапки.АдресДоставки);
	АдресДоставкиЗначенияПолей = Новый Структура("АдресДоставкиЗначенияПолей", РеквизитыШапки.АдресДоставкиЗначенияПолей);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Доставка.СпособДоставки",
		?(РеквизитыШапки.СпособДоставки = Перечисления.СпособыДоставки.Доставка, "Доставка", "Самовывоз"));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Доставка.АдресДоставки", РеквизитыШапки.АдресДоставки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Доставка.АдресДоставкиЗначенияПолей",
		РеквизитыШапки.АдресДоставкиЗначенияПолей);
		
	// Итоги в документе.
	СуммаПредставление = "";
	ФорматСумм(РеквизитыШапки.СуммаДокумента, СуммаПредставление, РеквизитыШапки.Валюта);
	ИтоговаяСтрока = НСтр("ru='Всего наименований %Количество%, на сумму %Сумма%'");
	ИтоговаяСтрока = СтрЗаменить(ИтоговаяСтрока, "%Количество%", ТаблицаТоваров.Количество());
	ИтоговаяСтрока = СтрЗаменить(ИтоговаяСтрока, "%Сумма%",      СуммаПредставление);
	
	СуммаПрописью  = РаботаСКурсамиВалют.СформироватьСуммуПрописью(РеквизитыШапки.СуммаДокумента, РеквизитыШапки.Валюта);
	ИтоговаяСтрока = ИтоговаяСтрока + Символы.ПС + СуммаПрописью;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогиПрописью", ИтоговаяСтрока);
	
	Если СтруктураДанных.Свойство("РезультатПоЭтапамГрафикаОплат")
		И СтруктураДанных.РезультатПоЭтапамГрафикаОплат.Количество() > 0 Тогда
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "СрокПлатежа", 
			СтруктураДанных.РезультатПоЭтапамГрафикаОплат[0].ДатаПлатежа);
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(
			ДеревоДокумента, СтруктураДанных.РезультатПоЭтапамГрафикаОплат, "ГрафикОплаты");
	КонецЕсли;
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеУниверсальногоКорректировочногоДокумента_2016.
Процедура ПриОтраженииВУчетеУниверсальногоКорректировочногоДокумента_2016(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	СпособОбработки = ПараметрыДляОтраженияВУчете.ПараметрыПоФорматуДокумента.СпособОбработки;
	
	ПервичныйДокумент = Неопределено;
	СчетФактура = Неопределено;
	
	СпособОбработкиПервичногоДокумента = "";
	СпособОбработкиСчетаФактуры = "";
	
	Если ЗначениеЗаполнено(СпособОбработки) И ТипЗнч(СпособОбработки) = Тип("Структура") Тогда

		Если СпособОбработки.Свойство("ПервичныйДокумент") Тогда
			СпособОбработкиПервичногоДокумента = СпособОбработки.ПервичныйДокумент;
		КонецЕсли;

		Если СпособОбработки.Свойство("СчетФактура") Тогда
			СпособОбработкиСчетаФактуры = СпособОбработки.СчетФактура;
		КонецЕсли;
	Иначе
		СпособОбработкиПервичногоДокумента = СпособОбработки;
		СпособОбработкиСчетаФактуры = СпособОбработки;
	КонецЕсли;

	Для Каждого Строка Из РезультатОтраженияВУчете.ДокументыУчета Цикл
		Если ТипЗнч(Строка) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
			СчетФактура = Строка;
		Иначе
			ПервичныйДокумент = Строка;
		КонецЕсли;

	КонецЦикла;
	
	ДокументыУчета = Новый Массив;
	ФункцияУКД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента, "Функция");
	
	Если ФункцияУКД = "ДИС" Или ФункцияУКД = "КСЧФДИС" Тогда
		НайтиСоздатьУКДДокументОбИзмененииСтоимости(ДанныеЭлектронногоДокумента, ПервичныйДокумент,
			СпособОбработкиПервичногоДокумента);
		ДокументыУчета.Добавить(ПервичныйДокумент);
	КонецЕсли;
	
	// Заполним основание в СФ
	ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"ДокументыОснованияСчетаФактуры");
	Если Не ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		ДокументыОснованияСчетаФактуры = Новый Массив;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПервичныйДокумент) Тогда
		ДокументыОснованияСчетаФактуры.Добавить(ПервичныйДокумент);
	КонецЕсли;

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"ДокументыОснованияСчетаФактуры", ДокументыОснованияСчетаФактуры);

	Если ФункцияУКД = "КСЧФ" Или ФункцияУКД = "КСЧФДИС" Тогда
		НайтиСоздатьУКДСчетФактуру(ДанныеЭлектронногоДокумента, СчетФактура, СпособОбработкиСчетаФактуры);
		ДокументыУчета.Добавить(СчетФактура);
	КонецЕсли;
	
	РезультатОтраженияВУчете.ДокументыУчета = ДокументыУчета;
	
КонецПроцедуры

#Область АктОРасхождениях

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеАктОРасхождениях_ИнформацияПокупателя.
Процедура ЗаполнитьДанныеАктОРасхождениях_ИнформацияПокупателя(Знач Основание, Знач Настройки,
	Данные, Описание, Отказ) Экспорт
	
	СтруктураЭД = ОбщегоНазначения.СкопироватьРекурсивно(Настройки, Ложь);
	
	ЗаполнитьДанныеДляАктОРасхождениях(Основание, СтруктураЭД, Данные, Отказ);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеАктОРасхождениях_ДополнительныеСведения.
Процедура ЗаполнитьДанныеАктОРасхождениях_ДополнительныеСведения(Знач Основание, Данные, Отказ) Экспорт
	
	ЗаполнитьДанныеДополнительныхСведенийДляАктОРасхождениях(Основание, Данные, Отказ);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьАктОРасхожденияхПоДополнительнымСведениям.
Процедура ЗаполнитьАктОРасхожденияхПоДополнительнымСведениям(ДанныеДокумента, ОбъектыУчета = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(ОбъектыУчета) Тогда
		АктОРасхождениях = ОбъектыУчета[0];
	Иначе
		Возврат;
	КонецЕсли;
	
	СодержаниеДополнительныхСведений = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДанныеДокумента.НовыйЭД.ЗначениеРеквизита, "СодержаниеДополнительныхСведений");	
	
	ПространствоБлокировки = "Документ.АктОРасхожденияхПоПриемке";
	Если ТипЗнч(АктОРасхождениях) = Тип("ДокументСсылка.АктОРасхожденияхПоОтгрузке") Тогда
		ПространствоБлокировки = "Документ.АктОРасхожденияхПоОтгрузке";
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(ПространствоБлокировки);
	ЭлементБлокировки.УстановитьЗначение("Ссылка", АктОРасхождениях);
	
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	
	Попытка
		Блокировка.Заблокировать();
		
		АктОРасхождениях = АктОРасхождениях.ПолучитьОбъект();
		АктОРасхождениях.ОбменДанными.Загрузка = Истина;
		АктОРасхождениях.СодержаниеДополнительныхСведений = СодержаниеДополнительныхСведений;
		АктОРасхождениях.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ТекстОшибки = НСтр("ru = 'Не удалось заполнить данные акта о расхождениях.'")
			+ Символы.ПС + НСтр("ru = 'Подробности см. в Журнале регистрации.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Заполнение данных акта о расхождениях.'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			АктОРасхождениях.Метаданные(),,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область УПД_5_02

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУПД_5_02_ИнформацияПродавца
Процедура ЗаполнитьДанныеУПД_5_02_ИнформацияПродавца(Знач Основание, Знач Настройки, Данные, Описание, Отказ) Экспорт
	
	ВсеВидыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	ТипДокумента = Настройки.ТипДокумента;
	
	СтруктураЭД = ОбщегоНазначения.СкопироватьРекурсивно(Настройки, Ложь);
	СчетФактура = Неопределено;
	ПередаточныеДокументы = Новый Массив;
	
	ТипДокументаОснования = ТипЗнч(Основание);
	Если ТипДокументаОснования = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		СчетФактура = Основание;
		ПередаточныеДокументы = ОснованияСчетаФактуры(Основание);
	Иначе
		СчетФактура = Документы.СчетФактураВыданный.СчетФактураДокумента(Основание);
		ПередаточныеДокументы.Добавить(Основание);
	КонецЕсли;

	Если ТипДокумента = ВсеВидыДокументов.УПД Тогда
		
		СтруктураЭД.Вставить("Функция", "СЧФДОП");
		
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_5_02(СчетФактура, СтруктураЭД, Данные, Отказ);
		Иначе
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
			Если УПДБезНДС(Данные, "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях") Тогда
				СтруктураЭД.Функция = "ДОП";
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СчетФактура Тогда
		
		СтруктураЭД.Вставить("Функция", "СЧФ");
		ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);

	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СведенияОРеализацииКомиссионером Тогда

		СтруктураЭД.Вставить("Функция", "СвРК");
		
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_5_02(СчетФактура, СтруктураЭД, Данные, Отказ);
		Иначе
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
		КонецЕсли;
			
	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СведенияОЗакупкеКомиссионером Тогда

		СтруктураЭД.Вставить("Функция", "СвЗК");
		ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
			
	Иначе
		
		СтруктураЭД.Вставить("Функция", "ДОП");
		ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
		
	КонецЕсли;
	
	ФункцияУПД = СтруктураЭД.Функция;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "Функция", ФункцияУПД);
	
	Если ФункцияУПД = "СЧФДОП" Тогда
		
		Если Основание = СчетФактура Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Описание.Основания, ПередаточныеДокументы);
		Иначе
			Описание.Основания.Добавить(СчетФактура);
		КонецЕсли;
		
	КонецЕсли;	

КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУПД_5_02_ИнформацияПокупателя.
Процедура ЗаполнитьДанныеУПД_5_02_ИнформацияПокупателя(Знач Основания, Данные, Отказ) Экспорт
	
	Поступление = Документы.ПоступлениеТоваровУслуг.ПустаяСсылка();
	СчетФактура = Документы.СчетФактураПолученный.ПустаяСсылка();
	РезультатРассмотрения = Документы.РезультатыРассмотренияАктаПриемкиЕИС.ПустаяСсылка();
	
	Если Не ТипЗнч(Основания) = Тип("Массив") Тогда
		Основания = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Основания);
	КонецЕсли;
	
	Для Каждого Основание Из Основания Цикл
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			Поступление = Основание;
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
			СчетФактура = Основание;
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.РезультатыРассмотренияАктаПриемкиЕИС")
			ИЛИ ТипЗнч(Основание) = Тип("ДокументСсылка.АктПриемкиВходящийЕИС") Тогда
			РезультатРассмотрения = Основание;
		КонецЕсли;
	КонецЦикла;
	
	ДатаПолученияТоваров = Дата(1, 1, 1);
	СодержаниеОперации   = "-";
	СоставительДокумента = "-";
	КодИтога = "1";
	ЭтоЭлектронноеАктирование = Ложь;
	
	Если ЗначениеЗаполнено(Поступление) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Дата КАК Дата,
		|	ПоступлениеТоваровУслуг.ВидДокумента КАК ВидДокумента,
		|	ПоступлениеТоваровУслуг.Организация.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
		|	ПоступлениеТоваровУслуг.Организация.ИНН КАК ОрганизацияИНН,
		|	ПоступлениеТоваровУслуг.Организация.КПП КАК ОрганизацияКПП,
		|	ПоступлениеТоваровУслуг.ЭтоГосЗакупка КАК ЭтоГосЗакупка,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаКодЗакупки КАК ГосЗакупкаКодЗакупки,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаНомерЛицевогоСчета КАК ГосЗакупкаНомерЛицевогоСчета,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаФинансовыйОрган КАК ГосЗакупкаФинансовыйОрган,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаНомерРеестровойЗаписи КАК ГосЗакупкаНомерРеестровойЗаписи,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаНомерБюджетногоОбязательства КАК ГосЗакупкаНомерБюджетногоОбязательства,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаКазначействоКод КАК ГосЗакупкаКазначействоКод,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаКазначействоНаименование КАК ГосЗакупкаКазначействоНаименование,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаОКТМОПокупателя КАК ГосЗакупкаОКТМОПокупателя,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаОКТМОМестаПоставки КАК ГосЗакупкаОКТМОМестаПоставки,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаПредельнаяДатаОплаты КАК ГосЗакупкаПредельнаяДатаОплаты,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаНомерДенежногоОбязательства КАК ГосЗакупкаНомерДенежногоОбязательства,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаОчередностьПлатежа КАК ГосЗакупкаОчередностьПлатежа,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаВидПлатежа КАК ГосЗакупкаВидПлатежа,
		|	ПоступлениеТоваровУслуг.ДенежныеОбязательстваГосЗакупки.(
		|		НомерСтрокиИнформацииПродавца КАК НомерСтрокиИнформацииПродавца,
		|		КодОбъектаФАИП КАК КодОбъектаФАИП,
		|		ВидСредств КАК ВидСредств,
		|		КодБюджетнойКлассификации КАК КодБюджетнойКлассификации,
		|		КодЦели КАК КодЦели,
		|		СуммаАванса КАК СуммаАванса) КАК ДенежныеОбязательстваГосЗакупки,
		|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Поступление);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		ДатаПолученияТоваров = Выборка.Дата;
		
		СоставительДокумента = ?(ЗначениеЗаполнено(Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН/КПП %2/%3'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН, Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН %2'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН));
		
		Если Выборка.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная Тогда
			СодержаниеОперации = НСтр("ru = 'Товары принял без претензий'");
		ИначеЕсли Выборка.ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот Тогда
			СодержаниеОперации = НСтр("ru = 'Услуги получены, претензий нет.'");
		ИначеЕсли Выборка.ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав Тогда
			СодержаниеОперации = НСтр("ru = 'Имущественные права получены, претензий нет.'");
		КонецЕсли;
		
		ГосЗакупка = Новый Структура;
		ГосЗакупка.Вставить("КодЗакупки", Выборка.ГосЗакупкаКодЗакупки);
		ГосЗакупка.Вставить("НомерЛицевогоСчетаПокупателя", Выборка.ГосЗакупкаНомерЛицевогоСчета);
		ГосЗакупка.Вставить("НаименованиеФинансовогоОрганаПокупателя", Выборка.ГосЗакупкаФинансовыйОрган);
		ГосЗакупка.Вставить("НомерРеестровойЗаписиПокупателя", Выборка.ГосЗакупкаНомерРеестровойЗаписи);
		ГосЗакупка.Вставить("НомерБюджетногоОбязательстваПокупателя", Выборка.ГосЗакупкаНомерБюджетногоОбязательства);
		ГосЗакупка.Вставить("КазначействоПокупателяКод", Выборка.ГосЗакупкаКазначействоКод);
		ГосЗакупка.Вставить("КазначействоПокупателяНаименование", Выборка.ГосЗакупкаКазначействоНаименование);
		ГосЗакупка.Вставить("ОКТМОПокупателя", Выборка.ГосЗакупкаОКТМОПокупателя);
		ГосЗакупка.Вставить("ОКТМОМестаПоставки", Выборка.ГосЗакупкаОКТМОМестаПоставки);
		ГосЗакупка.Вставить("ПредельнаяДатаОплаты", Выборка.ГосЗакупкаПредельнаяДатаОплаты);
		ГосЗакупка.Вставить("НомерДенежногоОбязательства", Выборка.ГосЗакупкаНомерДенежногоОбязательства);
		ГосЗакупка.Вставить("ОчередностьПлатежа", Выборка.ГосЗакупкаОчередностьПлатежа);
		ГосЗакупка.Вставить("ВидПлатежа", Выборка.ГосЗакупкаВидПлатежа);
		Путь = "ЗакупкаДляГосударственныхНужд.";		
		
		Если Выборка.ЭтоГосЗакупка Тогда
			ИмяФормы = "Документ.ПоступлениеТоваровУслуг.ФормаОбъекта";
			ПараметрыФормы = Новый Структура("Ключ", Поступление);
			
			Для Каждого КлючЗначение Из ГосЗакупка Цикл		
				
				Если КлючЗначение.Ключ = "НаименованиеФинансовогоОрганаПокупателя" Тогда
					ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
						Поступление, "Объект.ГосЗакупкаФинансовыйОрган", , ИмяФормы, ПараметрыФормы);
				ИначеЕсли КлючЗначение.Ключ = "ОКТМОПокупателя" Тогда
					ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
						Поступление, "Объект.ГосЗакупкаОКТМОПокупателя", , ИмяФормы, ПараметрыФормы);
				ИначеЕсли КлючЗначение.Ключ = "НаименованиеФинансовогоОрганаПокупателя" Тогда
					ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
						Поступление, "Объект.ГосЗакупкаФинансовыйОрган", , ИмяФормы, ПараметрыФормы);
				Иначе
					ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
						Поступление, "Объект.ГосЗакупка" + СтрЗаменить(КлючЗначение.Ключ, "Покупателя", ""), , ИмяФормы, ПараметрыФормы);
				КонецЕсли;
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, Путь + КлючЗначение.Ключ,
					КлючЗначение.Значение, ПараметрыОбработкиОшибок);
			КонецЦикла;
			
			ДенежныеОбязательства = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(Данные, Путь + "ДенежныеОбязательства");
			ВыборкаОбязательств = Выборка.ДенежныеОбязательстваГосЗакупки.Выбрать();
			Пока ВыборкаОбязательств.Следующий() Цикл
				СтрокаОбязательства = ДенежныеОбязательства.Добавить();
				СтрокаОбязательства.НомерСтрокиИнформацииПродавца = ВыборкаОбязательств.НомерСтрокиИнформацииПродавца;
				СтрокаОбязательства.КодОбъектаФАИП = ВыборкаОбязательств.КодОбъектаФАИП;
				СтрокаОбязательства.ВидСредств = КодИсточникаСредствГосЗакупок(ВыборкаОбязательств.ВидСредств);
				СтрокаОбязательства.КодБюджетнойКлассификации = ВыборкаОбязательств.КодБюджетнойКлассификации;
				СтрокаОбязательства.КодЦели = ВыборкаОбязательств.КодЦели;
				СтрокаОбязательства.СуммаАванса = ВыборкаОбязательств.СуммаАванса;
			КонецЦикла;
			
			Если ЗначениеЗаполнено(ДенежныеОбязательства) Тогда
				ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(Данные, ДенежныеОбязательства, Путь + "ДенежныеОбязательства");
			КонецЕсли;
			
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				Поступление, "Объект.ДенежныеОбязательстваГосЗакупки", , ИмяФормы, ПараметрыФормы);
			ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(Данные, Путь + "ДенежныеОбязательства",
				ПараметрыОбработкиОшибок);
			
		КонецЕсли;
		
		АктОРасхождениях = НайтиАктОРасхожденияхПоОснованию(Выборка.Ссылка);
		Если ЗначениеЗаполнено(АктОРасхождениях) Тогда
			РеквизитыАкта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(АктОРасхождениях, "Проведен,НомерЭД,ДатаЭД,ОбстоятельстваСоставления,ОбстоятельстваИспользования");
			Если РеквизитыАкта.Проведен Тогда
				КодИтога = "2";
				СодержаниеОперации = НСтр("ru = 'Товары (работы, услуги, права) приняты с расхождениями (претензией)'");
				Путь = "СодержаниеФХЖ.СведенияОПринятииТоваров.ДокументОРасхождениях.";
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, Путь + "НаименованиеДокумента", НСтр("ru = 'Акт о расхождениях'"));
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, Путь + "НомерДокумента", РеквизитыАкта.НомерЭД);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, Путь + "ДатаДокумента", РеквизитыАкта.ДатаЭД);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(СчетФактура) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СчетФактураПолученный.Дата КАК Дата,
		|	СчетФактураПолученный.Организация.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
		|	СчетФактураПолученный.Организация.ИНН КАК ОрганизацияИНН,
		|	СчетФактураПолученный.Организация.КПП КАК ОрганизацияКПП
		|ИЗ
		|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
		|ГДЕ
		|	СчетФактураПолученный.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", СчетФактура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		ДатаПолученияТоваров = Выборка.Дата;
		
		СоставительДокумента = ?(ЗначениеЗаполнено(Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН/КПП %2/%3'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН, Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН %2'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН));
	ИначеЕсли ЗначениеЗаполнено(РезультатРассмотрения) Тогда
		
		ЭтоЭлектронноеАктирование = Истина;
		КлиентЭлАктЕИС.ПриЗаполненииДанныхУПД_5_02_ИнформацияПокупателя(РезультатРассмотрения, Данные, Отказ);
		
	КонецЕсли;
	
	Если ЭтоЭлектронноеАктирование Тогда
		Возврат;
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СоставительДокументаНаименование", СоставительДокумента);
	
	Если ЗначениеЗаполнено(ДатаПолученияТоваров) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			Данные, "СодержаниеФХЖ.СведенияОПринятииТоваров.ДатаПолученияТоваров", ДатаПолученияТоваров);
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СодержаниеФХЖ.СведенияОПринятииТоваров.СодержаниеОперации", СодержаниеОперации);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СодержаниеФХЖ.СведенияОПринятииТоваров.КодИтога", КодИтога);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_5_02.
Процедура ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_5_02(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	СпособОбработки = ПараметрыДляОтраженияВУчете.ПараметрыПоФорматуДокумента.СпособОбработки;
	СсылкиНаВладельцев = РезультатОтраженияВУчете.ДокументыУчета;

	ПервичныйДокумент = Неопределено;
	СчетФактура = Неопределено;

	СпособОбработкиПервичногоДокумента = "";
	СпособОбработкиСчетаФактуры = "";

	Если ЗначениеЗаполнено(СпособОбработки) И ТипЗнч(СпособОбработки) = Тип("Структура") Тогда

		Если СпособОбработки.Свойство("ПервичныйДокумент") Тогда
			СпособОбработкиПервичногоДокумента = СпособОбработки.ПервичныйДокумент;
		КонецЕсли;

		Если СпособОбработки.Свойство("СчетФактура") Тогда
			СпособОбработкиСчетаФактуры = СпособОбработки.СчетФактура;
		КонецЕсли;
	Иначе
		СпособОбработкиПервичногоДокумента = СпособОбработки;
		СпособОбработкиСчетаФактуры = СпособОбработки;
	КонецЕсли;

	Если СсылкиНаВладельцев <> Неопределено Тогда
		Для Каждого Строка Из СсылкиНаВладельцев Цикл
			Если ТипЗнч(Строка) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				СчетФактура = Строка;
			Иначе
				ПервичныйДокумент = Строка;
			КонецЕсли;

		КонецЦикла;
	КонецЕсли;
	ФункцияУПД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента, "Функция");
	ДокументыУчета = Новый Массив;

	Если ФункцияУПД = "ДОП" Или ФункцияУПД = "СЧФДОП" Тогда
		НайтиСоздатьУПДДокументОПередаче_5_02(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина,
			СпособОбработкиПервичногоДокумента, РезультатОтраженияВУчете.ОписаниеОшибки, ПараметрыДляОтраженияВУчете);
		ДокументыУчета.Добавить(ПервичныйДокумент);
	ИначеЕсли ФункцияУПД = "СвРК" Или ФункцияУПД = "СвИСРК" Тогда
		НайтиСоздатьУПД0Реализация_5_02(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина, СпособОбработкиПервичногоДокумента,
			РезультатОтраженияВУчете.ОписаниеОшибки);
		ДокументыУчета.Добавить(ПервичныйДокумент);
	ИначеЕсли ФункцияУПД = "СвЗК" Или ФункцияУПД = "СвИСЗК" Тогда
		НайтиСоздатьУПД0Закупка_5_02(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина, СпособОбработкиПервичногоДокумента,
			РезультатОтраженияВУчете.ОписаниеОшибки);
		ДокументыУчета.Добавить(ПервичныйДокумент);
	КонецЕсли;
	
	// Заполним основание в СФ.
	ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"ДокументыОснованияСчетаФактуры");
	Если Не ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		ДокументыОснованияСчетаФактуры = Новый Массив;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПервичныйДокумент) Тогда
		ДокументыОснованияСчетаФактуры.Добавить(ПервичныйДокумент);
	КонецЕсли;

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента, "ДокументыОснованияСчетаФактуры",
		ДокументыОснованияСчетаФактуры);

	Если ФункцияУПД = "СЧФ" Или ФункцияУПД = "СЧФДОП" Тогда
		НайтиСоздатьУПДСчетФактуру_5_02(ДанныеЭлектронногоДокумента, СчетФактура, СпособОбработкиСчетаФактуры,
			РезультатОтраженияВУчете.ОписаниеОшибки);
		ДокументыУчета.Добавить(СчетФактура);
	КонецЕсли;
	
	РезультатОтраженияВУчете.ДокументыУчета = ДокументыУчета;
	
КонецПроцедуры

#КонецОбласти

#Область УПД_5_03

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУПД_5_03_ИнформацияПродавца
Процедура ЗаполнитьДанныеУПД_5_03_ИнформацияПродавца(Знач Основание, Знач Настройки, Данные, Описание, Отказ) Экспорт
	
	ВсеВидыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	ТипДокумента = Настройки.ТипДокумента;
	
	СтруктураЭД = ОбщегоНазначения.СкопироватьРекурсивно(Настройки, Ложь);
	СчетФактура = Неопределено;
	ПередаточныеДокументы = Новый Массив;
	
	ТипДокументаОснования = ТипЗнч(Основание);
	Если ТипДокументаОснования = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		СчетФактура = Основание;
		ПередаточныеДокументы = ОснованияСчетаФактуры(Основание);
	Иначе
		СчетФактура = Документы.СчетФактураВыданный.СчетФактураДокумента(Основание);
		ПередаточныеДокументы.Добавить(Основание);
	КонецЕсли;

	Если ТипДокумента = ВсеВидыДокументов.УПД Тогда
		
		СтруктураЭД.Вставить("Функция", "СЧФДОП");
		
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_5_02(СчетФактура, СтруктураЭД, Данные, Отказ);
		Иначе
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
			Если УПДБезНДС(Данные, "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях") Тогда
				СтруктураЭД.Функция = "ДОП";
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СчетФактура Тогда
		
		СтруктураЭД.Вставить("Функция", "СЧФ");
		ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);

	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СведенияОРеализацииКомиссионером Тогда

		СтруктураЭД.Вставить("Функция", "СвРК");
		
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_5_02(СчетФактура, СтруктураЭД, Данные, Отказ);
		Иначе
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
		КонецЕсли;
			
	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СведенияОЗакупкеКомиссионером Тогда

		СтруктураЭД.Вставить("Функция", "СвЗК");
		ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
			
	Иначе
		
		СтруктураЭД.Вставить("Функция", "ДОП");
		ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(Основание, СтруктураЭД, Данные, Отказ);
		
	КонецЕсли;
	
	ФункцияУПД = СтруктураЭД.Функция;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "Функция", ФункцияУПД);
	
	Если ФункцияУПД = "СЧФДОП" Тогда
		
		Если Основание = СчетФактура Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Описание.Основания, ПередаточныеДокументы);
		Иначе
			Описание.Основания.Добавить(СчетФактура);
		КонецЕсли;
		
	КонецЕсли;	

КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУПД_5_03_ИнформацияПокупателя.
Процедура ЗаполнитьДанныеУПД_5_03_ИнформацияПокупателя(Знач Основания, Данные, Отказ) Экспорт
	
	Поступление = Документы.ПоступлениеТоваровУслуг.ПустаяСсылка();
	СчетФактура = Документы.СчетФактураПолученный.ПустаяСсылка();
	РезультатРассмотрения = Документы.РезультатыРассмотренияАктаПриемкиЕИС.ПустаяСсылка();
	
	Если Не ТипЗнч(Основания) = Тип("Массив") Тогда
		Основания = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Основания);
	КонецЕсли;
	
	Для Каждого Основание Из Основания Цикл
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			Поступление = Основание;
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
			СчетФактура = Основание;
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.РезультатыРассмотренияАктаПриемкиЕИС")
			ИЛИ ТипЗнч(Основание) = Тип("ДокументСсылка.АктПриемкиВходящийЕИС") Тогда
			РезультатРассмотрения = Основание;
		КонецЕсли;
	КонецЦикла;
	
	ДатаПолученияТоваров = Дата(1, 1, 1);
	СодержаниеОперации   = "-";
	СоставительДокумента = "-";
	КодИтога = "1";
	ЭтоЭлектронноеАктирование = Ложь;
	
	Если ЗначениеЗаполнено(Поступление) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Дата КАК Дата,
		|	ПоступлениеТоваровУслуг.ВидДокумента КАК ВидДокумента,
		|	ПоступлениеТоваровУслуг.Организация.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
		|	ПоступлениеТоваровУслуг.Организация.ИНН КАК ОрганизацияИНН,
		|	ПоступлениеТоваровУслуг.Организация.КПП КАК ОрганизацияКПП,
		|	ПоступлениеТоваровУслуг.ЭтоГосЗакупка КАК ЭтоГосЗакупка,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаКодЗакупки КАК ГосЗакупкаКодЗакупки,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаНомерЛицевогоСчета КАК ГосЗакупкаНомерЛицевогоСчета,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаФинансовыйОрган КАК ГосЗакупкаФинансовыйОрган,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаНомерРеестровойЗаписи КАК ГосЗакупкаНомерРеестровойЗаписи,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаНомерБюджетногоОбязательства КАК ГосЗакупкаНомерБюджетногоОбязательства,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаКазначействоКод КАК ГосЗакупкаКазначействоКод,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаКазначействоНаименование КАК ГосЗакупкаКазначействоНаименование,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаОКТМОПокупателя КАК ГосЗакупкаОКТМОПокупателя,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаОКТМОМестаПоставки КАК ГосЗакупкаОКТМОМестаПоставки,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаПредельнаяДатаОплаты КАК ГосЗакупкаПредельнаяДатаОплаты,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаНомерДенежногоОбязательства КАК ГосЗакупкаНомерДенежногоОбязательства,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаОчередностьПлатежа КАК ГосЗакупкаОчередностьПлатежа,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаВидПлатежа КАК ГосЗакупкаВидПлатежа,
		|	ПоступлениеТоваровУслуг.ДенежныеОбязательстваГосЗакупки.(
		|		НомерСтрокиИнформацииПродавца КАК НомерСтрокиИнформацииПродавца,
		|		КодОбъектаФАИП КАК КодОбъектаФАИП,
		|		ВидСредств КАК ВидСредств,
		|		КодБюджетнойКлассификации КАК КодБюджетнойКлассификации,
		|		КодЦели КАК КодЦели,
		|		СуммаАванса КАК СуммаАванса) КАК ДенежныеОбязательстваГосЗакупки,
		|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Поступление);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		ДатаПолученияТоваров = Выборка.Дата;
		
		СоставительДокумента = ?(ЗначениеЗаполнено(Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН/КПП %2/%3'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН, Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН %2'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН));
		
		Если Выборка.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная Тогда
			СодержаниеОперации = НСтр("ru = 'Товары принял без претензий'");
		ИначеЕсли Выборка.ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот Тогда
			СодержаниеОперации = НСтр("ru = 'Услуги получены, претензий нет.'");
		ИначеЕсли Выборка.ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав Тогда
			СодержаниеОперации = НСтр("ru = 'Имущественные права получены, претензий нет.'");
		КонецЕсли;
		
		ГосЗакупка = Новый Структура;
		ГосЗакупка.Вставить("КодЗакупки", Выборка.ГосЗакупкаКодЗакупки);
		ГосЗакупка.Вставить("НомерЛицевогоСчетаПокупателя", Выборка.ГосЗакупкаНомерЛицевогоСчета);
		ГосЗакупка.Вставить("НаименованиеФинансовогоОрганаПокупателя", Выборка.ГосЗакупкаФинансовыйОрган);
		ГосЗакупка.Вставить("НомерРеестровойЗаписиПокупателя", Выборка.ГосЗакупкаНомерРеестровойЗаписи);
		ГосЗакупка.Вставить("НомерБюджетногоОбязательстваПокупателя", Выборка.ГосЗакупкаНомерБюджетногоОбязательства);
		ГосЗакупка.Вставить("КазначействоПокупателяКод", Выборка.ГосЗакупкаКазначействоКод);
		ГосЗакупка.Вставить("КазначействоПокупателяНаименование", Выборка.ГосЗакупкаКазначействоНаименование);
		ГосЗакупка.Вставить("ОКТМОПокупателя", Выборка.ГосЗакупкаОКТМОПокупателя);
		ГосЗакупка.Вставить("ОКТМОМестаПоставки", Выборка.ГосЗакупкаОКТМОМестаПоставки);
		ГосЗакупка.Вставить("ПредельнаяДатаОплаты", Выборка.ГосЗакупкаПредельнаяДатаОплаты);
		ГосЗакупка.Вставить("НомерДенежногоОбязательства", Выборка.ГосЗакупкаНомерДенежногоОбязательства);
		ГосЗакупка.Вставить("ОчередностьПлатежа", Выборка.ГосЗакупкаОчередностьПлатежа);
		ГосЗакупка.Вставить("ВидПлатежа", Выборка.ГосЗакупкаВидПлатежа);
		Путь = "ЗакупкаДляГосударственныхНужд.";		
		
		Если Выборка.ЭтоГосЗакупка Тогда
			ИмяФормы = "Документ.ПоступлениеТоваровУслуг.ФормаОбъекта";
			ПараметрыФормы = Новый Структура("Ключ", Поступление);
			
			Для Каждого КлючЗначение Из ГосЗакупка Цикл		
				
				Если КлючЗначение.Ключ = "НаименованиеФинансовогоОрганаПокупателя" Тогда
					ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
						Поступление, "Объект.ГосЗакупкаФинансовыйОрган", , ИмяФормы, ПараметрыФормы);
				ИначеЕсли КлючЗначение.Ключ = "ОКТМОПокупателя" Тогда
					ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
						Поступление, "Объект.ГосЗакупкаОКТМОПокупателя", , ИмяФормы, ПараметрыФормы);
				ИначеЕсли КлючЗначение.Ключ = "НаименованиеФинансовогоОрганаПокупателя" Тогда
					ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
						Поступление, "Объект.ГосЗакупкаФинансовыйОрган", , ИмяФормы, ПараметрыФормы);
				Иначе
					ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
						Поступление, "Объект.ГосЗакупка" + СтрЗаменить(КлючЗначение.Ключ, "Покупателя", ""), , ИмяФормы, ПараметрыФормы);
				КонецЕсли;
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, Путь + КлючЗначение.Ключ,
					КлючЗначение.Значение, ПараметрыОбработкиОшибок);
			КонецЦикла;
			
			ДенежныеОбязательства = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(Данные, Путь + "ДенежныеОбязательства");
			ВыборкаОбязательств = Выборка.ДенежныеОбязательстваГосЗакупки.Выбрать();
			Пока ВыборкаОбязательств.Следующий() Цикл
				СтрокаОбязательства = ДенежныеОбязательства.Добавить();
				СтрокаОбязательства.НомерСтрокиИнформацииПродавца = ВыборкаОбязательств.НомерСтрокиИнформацииПродавца;
				СтрокаОбязательства.КодОбъектаФАИП = ВыборкаОбязательств.КодОбъектаФАИП;
				СтрокаОбязательства.ВидСредств = КодИсточникаСредствГосЗакупок(ВыборкаОбязательств.ВидСредств);
				СтрокаОбязательства.КодБюджетнойКлассификации = ВыборкаОбязательств.КодБюджетнойКлассификации;
				СтрокаОбязательства.КодЦели = ВыборкаОбязательств.КодЦели;
				СтрокаОбязательства.СуммаАванса = ВыборкаОбязательств.СуммаАванса;
			КонецЦикла;
			
			Если ЗначениеЗаполнено(ДенежныеОбязательства) Тогда
				ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(Данные, ДенежныеОбязательства, Путь + "ДенежныеОбязательства");
			КонецЕсли;
			
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				Поступление, "Объект.ДенежныеОбязательстваГосЗакупки", , ИмяФормы, ПараметрыФормы);
			ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(Данные, Путь + "ДенежныеОбязательства",
				ПараметрыОбработкиОшибок);
			
		КонецЕсли;
		
		АктОРасхождениях = НайтиАктОРасхожденияхПоОснованию(Выборка.Ссылка);
		Если ЗначениеЗаполнено(АктОРасхождениях) Тогда
			РеквизитыАкта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(АктОРасхождениях, "Проведен,НомерЭД,ДатаЭД,ОбстоятельстваСоставления,ОбстоятельстваИспользования");
			Если РеквизитыАкта.Проведен Тогда
				КодИтога = "2";
				СодержаниеОперации = НСтр("ru = 'Товары (работы, услуги, права) приняты с расхождениями (претензией)'");
				Путь = "СодержаниеФХЖ.СведенияОПринятииТоваров.ДокументОРасхождениях.";
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, Путь + "НаименованиеДокумента", НСтр("ru = 'Акт о расхождениях'"));
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, Путь + "НомерДокумента", РеквизитыАкта.НомерЭД);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, Путь + "ДатаДокумента", РеквизитыАкта.ДатаЭД);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(СчетФактура) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СчетФактураПолученный.Дата КАК Дата,
		|	СчетФактураПолученный.Организация.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
		|	СчетФактураПолученный.Организация.ИНН КАК ОрганизацияИНН,
		|	СчетФактураПолученный.Организация.КПП КАК ОрганизацияКПП
		|ИЗ
		|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
		|ГДЕ
		|	СчетФактураПолученный.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", СчетФактура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		ДатаПолученияТоваров = Выборка.Дата;
		
		СоставительДокумента = ?(ЗначениеЗаполнено(Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН/КПП %2/%3'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН, Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН %2'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН));
	ИначеЕсли ЗначениеЗаполнено(РезультатРассмотрения) Тогда
		
		ЭтоЭлектронноеАктирование = Истина;
		КлиентЭлАктЕИС.ПриЗаполненииДанныхУПД_5_02_ИнформацияПокупателя(РезультатРассмотрения, Данные, Отказ);
		
	КонецЕсли;
	
	Если ЭтоЭлектронноеАктирование Тогда
		Возврат;
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СоставительДокументаНаименование", СоставительДокумента);
	
	Если ЗначениеЗаполнено(ДатаПолученияТоваров) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			Данные, "СодержаниеФХЖ.СведенияОПринятииТоваров.ДатаПолученияТоваров", ДатаПолученияТоваров);
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СодержаниеФХЖ.СведенияОПринятииТоваров.СодержаниеОперации", СодержаниеОперации);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СодержаниеФХЖ.СведенияОПринятииТоваров.КодИтога", КодИтога);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_5_03.
Процедура ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_5_03(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт

	СпособОбработки = ПараметрыДляОтраженияВУчете.ПараметрыПоФорматуДокумента.СпособОбработки;
	
	ПервичныйДокумент = Неопределено;
	СчетФактура = Неопределено;
	
	СпособОбработкиПервичногоДокумента = "";
	СпособОбработкиСчетаФактуры = "";
		
	Если ЗначениеЗаполнено(СпособОбработки) И ТипЗнч(СпособОбработки) = Тип("Структура") Тогда

		Если СпособОбработки.Свойство("ПервичныйДокумент") Тогда
			СпособОбработкиПервичногоДокумента = СпособОбработки.ПервичныйДокумент;
		КонецЕсли;

		Если СпособОбработки.Свойство("СчетФактура") Тогда
			СпособОбработкиСчетаФактуры = СпособОбработки.СчетФактура;
		КонецЕсли;
	Иначе
		СпособОбработкиПервичногоДокумента = СпособОбработки;
		СпособОбработкиСчетаФактуры = СпособОбработки;
	КонецЕсли;

	Для Каждого Строка Из РезультатОтраженияВУчете.ДокументыУчета Цикл
		Если ТипЗнч(Строка) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
			СчетФактура = Строка;
		Иначе
			ПервичныйДокумент = Строка;
		КонецЕсли;
	КонецЦикла;

	ФункцияУПД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента, "Функция");
	ДокументыУчета = Новый Массив;
	
	Если ФункцияУПД = "ДОП" Или ФункцияУПД = "СЧФДОП" Тогда
		НайтиСоздатьУПДДокументОПередаче_5_02(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина,
			СпособОбработкиПервичногоДокумента, РезультатОтраженияВУчете.ОписаниеОшибки, ПараметрыДляОтраженияВУчете);
		ДокументыУчета.Добавить(ПервичныйДокумент);
	ИначеЕсли ФункцияУПД = "СвРК" Или ФункцияУПД = "СвИСРК" Тогда
		НайтиСоздатьУПД0Реализация_5_02(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина,
			СпособОбработкиПервичногоДокумента, РезультатОтраженияВУчете.ОписаниеОшибки);
		ДокументыУчета.Добавить(ПервичныйДокумент);
	ИначеЕсли ФункцияУПД = "СвЗК" Или ФункцияУПД = "СвИСЗК" Тогда
		НайтиСоздатьУПД0Закупка_5_02(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина,
			СпособОбработкиПервичногоДокумента, РезультатОтраженияВУчете.ОписаниеОшибки);
		ДокументыУчета.Добавить(ПервичныйДокумент);
	КонецЕсли;
	
	// Заполним основание в СФ.
	ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"ДокументыОснованияСчетаФактуры");
	Если Не ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		ДокументыОснованияСчетаФактуры = Новый Массив;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПервичныйДокумент) Тогда
		ДокументыОснованияСчетаФактуры.Добавить(ПервичныйДокумент);
	КонецЕсли;

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"ДокументыОснованияСчетаФактуры", ДокументыОснованияСчетаФактуры);

	Если ФункцияУПД = "СЧФ" Или ФункцияУПД = "СЧФДОП" Тогда
		НайтиСоздатьУПДСчетФактуру_5_02(ДанныеЭлектронногоДокумента, СчетФактура, СпособОбработкиСчетаФактуры,
			РезультатОтраженияВУчете.ОписаниеОшибки);
		ДокументыУчета.Добавить(СчетФактура);
	КонецЕсли;

	РезультатОтраженияВУчете.ДокументыУчета = ДокументыУчета;
	
КонецПроцедуры

#КонецОбласти

#Область УПД_2019

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_2019.
Процедура ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_2019(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
