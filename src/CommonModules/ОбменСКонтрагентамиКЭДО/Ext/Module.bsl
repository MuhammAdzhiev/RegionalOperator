	ВыборкаСведенияОГрузе = СтруктураДанных.ВыборкаСведенияОГрузе;
	Пока ВыборкаСведенияОГрузе.Следующий() Цикл
		НоваяСтрока = СведенияПоТранспортнымДокументам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаСведенияОГрузе);
		Если ЗначениеЗаполнено(ВыборкаСведенияОГрузе.ОтметкиОтправителя) Тогда
			НоваяСтрока.ДополнительныеДанные = Новый Соответствие;
			НоваяСтрока.ДополнительныеДанные.Вставить(НСтр("ru = 'Особые отметки отправителя'"), ВыборкаСведенияОГрузе.ОтметкиОтправителя);
		КонецЕсли;
	КонецЦикла;
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, СведенияПоТранспортнымДокументам, "СведенияПоТранспортнымДокументам");
	
	// Сведения о времени приемки.
	ОбщийПуть = "СведенияОВремениПриемки.";
	Если ЗначениеЗаполнено(ВыборкаШапка.ДатаПрибытияВПунктНазначения) Тогда
