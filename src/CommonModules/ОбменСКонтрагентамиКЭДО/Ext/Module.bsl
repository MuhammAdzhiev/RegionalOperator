						НовыеСведения.ЕдиницаИзмеренияНаименование = ТекущиеСведения.ЕдиницаИзмеренияНаименование;
						Если ДействуютПравилаЗаполненияПоПроектуПостановления1137() Тогда
							НовыеСведения.СтоимостьБезНДС = ТекущиеСведения.СтоимостьБезНДС;
						Иначе
							НовыеСведения.СтоимостьБезНДС = Окр(ТекущиеСведения.СтоимостьБезНДС);
						КонецЕсли;
					КонецЦикла;
					ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(НоваяСтрока.СведенияОПрослеживаемости,
			"ЕдиницаИзмеренияКод", ВыборкаТоваров.Ссылка, "Объект.Товары.ЕдиницаИзмерения", , "НомерСтрокиТовара");
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаТоваров.АмортизационнаяГруппа)
				Или ЗначениеЗаполнено(ВыборкаТоваров.КодОКОФ)
				Или ЗначениеЗаполнено(ВыборкаТоваров.СрокПолезногоИспользования)
				Или ЗначениеЗаполнено(ВыборкаТоваров.ФактСрокПолезногоИспользования) Тогда
				ДанныеАмортизации = НовыеДанныеАмортизации();
				ДанныеАмортизации.АмортизационнаяГруппа = ВыборкаТоваров.АмортизационнаяГруппа;
				ДанныеАмортизации.КодОКОФ = ВыборкаТоваров.КодОКОФ;
				ДанныеАмортизации.СрокИспользования = ВыборкаТоваров.СрокПолезногоИспользования;
				ДанныеАмортизации.ФактическийСрокИспользования = ВыборкаТоваров.ФактСрокПолезногоИспользования;
				НоваяСтрока.ДанныеДляРасчетаАмортизации = ДанныеАмортизации;
			КонецЕсли;
			
			Сопоставление = Новый Структура;
			Сопоставление.Вставить("Наименование", ВыборкаТоваров.НаименованиеПолное);
			Если ЗначениеЗаполнено(ВыборкаТоваров.Характеристика) Тогда
				Сопоставление.Вставить("Характеристика", ВыборкаТоваров.ХарактеристикаНаименование);
			КонецЕсли;
			Сопоставление.Вставить("ЕдиницаИзмерения", НоваяСтрока.ЕдиницаИзмеренияНаименование);
			Сопоставление.Вставить("Артикул", ВыборкаТоваров.НоменклатураАртикул);
			Сопоставление.Вставить("ЕдиницаИзмеренияКод", ВыборкаТоваров.ЕдиницаИзмеренияКод);
			Сопоставление.Вставить("СтавкаНДС", ВыборкаТоваров.НоменклатураСтавкаНДС);
			
			Сопоставление.Вставить("НоменклатураИБ", ВыборкаТоваров.Номенклатура);
			Сопоставление.Вставить("ХарактеристикаИБ", ВыборкаТоваров.Характеристика);
			Сопоставление.Вставить("УпаковкаИБ", ВыборкаТоваров.ЕдиницаИзмерения);
			
			ЗаполнитьШтрихкодыТоваровВСопоставление(Сопоставление, ШтрихкодыНоменклатуры, ШтрихкодыКомбинаций,
				ВыборкаТоваров.Номенклатура, ВыборкаТоваров.Характеристика, ВыборкаТоваров.ЕдиницаИзмерения);

			НоваяСтрока.Сопоставление = Сопоставление;
			
			Если ЗаполнениеКодаТовара = "Артикул" Тогда
				НоваяСтрока.Код = ВыборкаТоваров.НоменклатураАртикул;
			ИначеЕсли ЗаполнениеКодаТовара = "Штрихкод" 
				И НоваяСтрока.Сопоставление.Свойство("ШтрихкодКомбинации") Тогда
				НоваяСтрока.Код = НоваяСтрока.Сопоставление.ШтрихкодКомбинации;
			КонецЕсли;
			Если ИспользуетсяГосИС Тогда
				ЭлектронноеВзаимодействиеИСМП.ЗаполнитьСведенияОМаркировке_5_02(НоваяСтрока, ВыборкаТоваров, ТаблицаКодовМаркировки);
			Иначе
				ЗаполнитьРеквизитыМаркировкиВСтрокеТоваров_5_02(НоваяСтрока, ТаблицаКодовМаркировки, ВыборкаШапки.Ссылка);
			КонецЕсли;
			
			// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
			Если ЭтоЭлектронноеАктированиеЕИС Тогда
				КлиентЭлАктЕИС.ЗаполнитьДанныеПоСтрокеТоваровУПД_5_02(
					НоваяСтрока, ВыборкаТоваров, СтруктураДанных, ДанныеПриложенияЕИС);
			КонецЕсли;
			// Конец  ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		
		КонецЦикла;
		
		Если ИспользуетсяГосИС Тогда
			
			ПараметрыЗаполнения = Новый Структура;
			ПараметрыЗаполнения.Вставить("Ссылка",          ВыборкаШапки.Ссылка);
			ПараметрыЗаполнения.Вставить("Дата",            ВыборкаШапки.Дата);
			ПараметрыЗаполнения.Вставить("СтруктураДанных", СтруктураДанных);

			ДополнитьДеревоТаблицуКодовМаркировки(ТаблицаКодовМаркировки, ДеревоДанных, ПараметрыЗаполнения, Отказ);

		КонецЕсли;
		
		Если СуммаНалога.БезНДС = Истина Тогда
			СуммаНалога.Сумма = Неопределено;
		Иначе
			СуммаНалога.БезНДС = Неопределено;
		КонецЕсли;
		
		ТекстОшибки = НСтр("ru = 'Не удалось заполнить итоговые стоимостные показатели. Возможные причины:
		|	- не заполнена табличная часть ""Товары""
		|	- не заполнены колонки ""Сумма"", ""НДС"", ""Количество""'");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ТаблицаСчетаФактуры.ВсегоКОплате.СтоимостьБезНалога", СведенияОТоварах.Итог("СтоимостьБезНалога"), ТекстОшибки);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ТаблицаСчетаФактуры.ВсегоКОплате.СтоимостьСНалогом", СведенияОТоварах.Итог("СтоимостьСНалогом"), ТекстОшибки);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ТаблицаСчетаФактуры.ВсегоКОплате.Количество", СведенияОТоварах.Итог("Количество"), ТекстОшибки);
			
		ЭлектронноеВзаимодействие.ЗагрузитьСтруктуруВГруппуДерева(ДеревоДанных, СуммаНалога, "ТаблицаСчетаФактуры.ВсегоКОплате.СуммаНалога");
		ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных, "ТаблицаСчетаФактуры.ВсегоКОплате.СуммаНалога", ТекстОшибки);
		
		// Обработка ошибки с открытием формы по навигационной ссылке.
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезНавигационнуюСсылку(СведенияОТоварах,
			"Наименование", "НаименованиеНавигационнаяСсылка");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезОткрытиеФормы(СведенияОТоварах,
			"Наименование", "Справочник.Номенклатура.ФормаОбъекта",, Новый Структура("Ключ", "Номенклатура"));
		
		// Обработка ошибки через механизм сообщений пользователю.
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
			"Код", "Номенклатура", "Объект.Код");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
			"Наименование", "Номенклатура", "Объект.НаименованиеПолное");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
			"Количество", ВыборкаТоваров.Ссылка, "Объект.Товары.Количество",, "НомерСтрокиИсходногоДокумента");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
			"Цена", ВыборкаТоваров.Ссылка, "Объект.Товары.Цена",, "НомерСтрокиИсходногоДокумента");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
			"СтоимостьБезНалога", ВыборкаТоваров.Ссылка, "Объект.Товары.Сумма",, "НомерСтрокиИсходногоДокумента");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
			"ЕдиницаИзмеренияНаименование", "ЕдиницаИзмерения", "Объект.Наименование");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
			"ЕдиницаИзмеренияКод", "ЕдиницаИзмерения", "Объект.Код");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
			"Признак", "Номенклатура", "Объект.ВидНоменклатуры");
		
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
			"ДанныеДляРасчетаАмортизации.АмортизационнаяГруппа", ВыборкаТоваров.Ссылка,
			"Объект.Товары.АмортизационнаяГруппа",, "НомерСтрокиИсходногоДокумента");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
			"ДанныеДляРасчетаАмортизации.КодОКОФ", ВыборкаТоваров.Ссылка,
			"Объект.Товары.КодОКОФ",, "НомерСтрокиИсходногоДокумента");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
			"ДанныеДляРасчетаАмортизации.СрокИспользования", ВыборкаТоваров.Ссылка,
			"Объект.Товары.СрокПолезногоИспользования",, "НомерСтрокиИсходногоДокумента");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
			"ДанныеДляРасчетаАмортизации.ФактическийСрокИспользования", ВыборкаТоваров.Ссылка,
			"Объект.Товары.ФактСрокПолезногоИспользования",, "НомерСтрокиИсходногоДокумента");
		
		// Обработка ошибки через упрощенный механизм
		ТекстОшибки = НСтр("ru = 'для формирования электронного документа необходимо указать налоговую ставку'");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
			"НалоговаяСтавка",,, ТекстОшибки);
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, СведенияОТоварах, "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях");
		
		Если СтруктураЭД.Функция <> "СЧФ" Тогда 
			
			ТолькоУслуги = Истина;
			СоставСодержания = Новый Массив;
			Если ЕстьТовары Или ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная Тогда
				СоставСодержания.Добавить(НСтр("ru = 'Товары переданы.'"));
				ТолькоУслуги = Ложь;
			КонецЕсли;
			Если ЕстьУслуги Или ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот Тогда
				СоставСодержания.Добавить(НСтр("ru = 'Услуги оказаны в полном объеме.'"));
			КонецЕсли;
			Если ЕстьРаботы Или ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот Тогда
				СоставСодержания.Добавить(НСтр("ru = 'Работы выполнены в полном объеме.'"));
			КонецЕсли;
			Если ЕстьПрава Или ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав Тогда
				СоставСодержания.Добавить(НСтр("ru = 'Имущественные права переданы.'"));
				ТолькоУслуги = Ложь;
			КонецЕсли;
			СодержаниеОперации = СтрСоединить(СоставСодержания, " ");
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияОПередаче.Операция.СодержаниеОперации", СодержаниеОперации);
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС	
	Если ЭтоЭлектронноеАктированиеЕИС Тогда
		КлиентЭлАктЕИС.ЗаполнитьДанныеДереваДляЭлектронногоАктированияЕИС_5_02(ДеревоДанных,
			ДанныеЭлектронногоАктированияЕИС,
			ВыборкаШапки,
			ДанныеПриложенияЕИС,
			Ложь);	
	КонецЕсли;
	// Конец  ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
КонецПроцедуры

// Возвращает таблицу участников.
// 
// Параметры:
//  ДеревоДанных - ДеревоЗначений
//  Путь - Строка
// 
// Возвращаемое значение:
//  см. ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента
//
Функция ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, Путь)

	ТаблицаУчастников = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, Путь);
	ТаблицаУчастников.Колонки.Добавить("СведенияОбУчастнике");
	Возврат ТаблицаУчастников;
	
КонецФункции	

// Добавляет данные участника в таблицу участников.
// 
// Параметры:
//  ДеревоДанных - ДеревоЗначений
//  ТаблицаУчастников - ТаблицаЗначений - см. ПолучитьТаблицуУчастниковУПД_5_02
//  ДанныеУчастника - Структура - см. ПолучитьДанныеУчастникаУПД
//  ПутьТаблицы - Строка
//  ИмяУчастника - Строка
//
Процедура ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаУчастников, ДанныеУчастника, ПутьТаблицы, ИмяУчастника)

	СтрокаУчастника = ТаблицаУчастников.Добавить();
	СтрокаУчастника[ИмяУчастника] = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
		ДеревоДанных, ПутьТаблицы + ".НомерСтроки." + ИмяУчастника);
	ЗаполнитьЗначенияСвойств(СтрокаУчастника[ИмяУчастника], ДанныеУчастника);	
	СтрокаУчастника.СведенияОбУчастнике = ДанныеУчастника.СведенияОбУчастнике;
	
КонецПроцедуры

// Возвращает структуру данных участника.
//
// Параметры:
//     СведенияОбУчастнике - см. ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица
//     ПриоритетыВидовКонтактнойИнформации - Массив из Строка
//     ЭтоЭлектронноеАктированиеЕИС - Булево
//
// Возвращаемое значение:
//     Структура:
//     	* СведенияОбУчастнике - см. ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица
//     	* ТипУчастника - Структура:
//     		** ЮЛ - Структура:
//     			*** НаименованиеОрганизации - Строка
//     			*** ИНН - Строка
//     			*** КПП - Строка
//     		** ИЛ - Структура:
//     			*** НаименованиеОрганизации - Строка
//     			*** Статус - Строка
//     			*** КодСтраны - Строка
//     			*** НаименованиеСтраны - Строка
//     			*** ИдентификаторЮридическогоЛица - Строка
//     		** ИП - Структура:
//     			*** ИНН - Строка
//     			*** Фамилия - Строка
//     			*** Имя - Строка
//     			*** Отчество - Строка
//     			*** СвидетельствоОГосРегистрации - Строка
//     			*** ФИО - Структура:
//     				**** Фамилия - Строка
//     				**** Имя - Строка
//     				**** Отчество - Строка
//     	* Адрес - см. ДанныеАдресаУчастникаУПД_5_02
//     	* КонтактныеСведения - Структура:
//     		** Телефоны - ТаблицаЗначений:
//     			*** Телефон - Строка
//     		** ЭлектронныеПочты - ТаблицаЗначений:
//     			*** ЭлектроннаяПочта - Строка
//     	* БанковскиеРеквизиты - Структура:
//     		** НомерСчета - Строка
//     		** НаименованиеБанка - Строка
//     		** БИКБанка - Строка
//     		** КорреспондентскийСчетБанка - Строка
//     	* КодОКПО - Строка
//
Функция ПолучитьДанныеУчастникаУПД_5_02(Знач СведенияОбУчастнике,
	Знач ПриоритетыВидовКонтактнойИнформации = Неопределено, ЭтоЭлектронноеАктированиеЕИС = Ложь)
	
	КлючДанных = Неопределено;
	СведенияОбУчастнике.Свойство("Ссылка", КлючДанных);
	
	ЭтоСведенияОбОрганизации = ТипЗнч(СведенияОбУчастнике.Ссылка) = Тип("СправочникСсылка.Организации");
	
	Данные = Новый Структура("СведенияОбУчастнике", СведенияОбУчастнике);
	Данные.Вставить("ТипУчастника", Новый Структура);
	
	Если ЭтоЭлектронноеАктированиеЕИС Тогда
		Если ЭтоСведенияОбОрганизации Тогда
			МодульЭлектронноеАктированиеЕИС = ОбщегоНазначения.ОбщийМодуль("ЭлектронноеАктированиеЕИС");
			НаименованиеОрганизации = МодульЭлектронноеАктированиеЕИС.НаименованиеОрганизацииДляЭД(
						СведенияОбУчастнике.Ссылка);
		Иначе
			НаименованиеОрганизации = СведенияОбУчастнике.ПолноеНаименование;
		КонецЕсли;
	Иначе
		НаименованиеОрганизации = СведенияОбУчастнике.СокращенноеНаименование;
	КонецЕсли;
	
	Если СведенияОбУчастнике.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		
		Данные.ТипУчастника.Вставить("ЮЛ", Новый Структура);
		Данные.ТипУчастника.ЮЛ.Вставить("НаименованиеОрганизации", НаименованиеОрганизации);
		Данные.ТипУчастника.ЮЛ.Вставить("ИНН", СведенияОбУчастнике.ИНН);
		Данные.ТипУчастника.ЮЛ.Вставить("КПП", СведенияОбУчастнике.КПП);
		
	ИначеЕсли СведенияОбУчастнике.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент Тогда
		
		Данные.ТипУчастника.Вставить("ИЛ", Новый Структура);
		Данные.ТипУчастника.ИЛ.Вставить("НаименованиеОрганизации", НаименованиеОрганизации);
		
		Статусы = Новый Структура;
		Статусы.Вставить("Организация", "ИО");
		Статусы.Вставить("Гражданин", "ИГ");
		Данные.ТипУчастника.ИЛ.Вставить("Статус", Статусы.Организация);
		
		Если ЗначениеЗаполнено(СведенияОбУчастнике.ЮридическийАдресXML) Тогда
			СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(СведенияОбУчастнике.ЮридическийАдресXML);
			Данные.ТипУчастника.ИЛ.Вставить("КодСтраны", СведенияОбАдресе.КодСтраны);
			Данные.ТипУчастника.ИЛ.Вставить("НаименованиеСтраны", СведенияОбАдресе.Страна);
		КонецЕсли;
		Данные.ТипУчастника.ИЛ.Вставить("ИдентификаторОрганизацииИлиГражданина", СведенияОбУчастнике.ИдентификаторЮридическогоЛица);
			
	// _Демо начало примера	
	ИначеЕсли СведенияОбУчастнике.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
	
		Данные.ТипУчастника.Вставить("ФЛ", Новый Структура);
		Данные.ТипУчастника.ФЛ.Вставить("ИНН", СведенияОбУчастнике.ИНН);
		Данные.ТипУчастника.ФЛ.Вставить("Фамилия", СведенияОбУчастнике.Фамилия);
		Данные.ТипУчастника.ФЛ.Вставить("Имя", СведенияОбУчастнике.Имя);
		Данные.ТипУчастника.ФЛ.Вставить("Отчество", СведенияОбУчастнике.Отчество);
		
		Данные.ТипУчастника.ФЛ.Вставить("ФИО", Новый Структура("Фамилия, Имя, Отчество"));
		ЗаполнитьЗначенияСвойств(Данные.ТипУчастника.ФЛ.ФИО, Данные.ТипУчастника.ФЛ);
	// _Демо конец примера	
		
	Иначе
		
		Данные.ТипУчастника.Вставить("ИП", Новый Структура);
		Данные.ТипУчастника.ИП.Вставить("ИНН", СведенияОбУчастнике.ИНН);
		Данные.ТипУчастника.ИП.Вставить("Фамилия", СведенияОбУчастнике.Фамилия);
		Данные.ТипУчастника.ИП.Вставить("Имя", СведенияОбУчастнике.Имя);
		Данные.ТипУчастника.ИП.Вставить("Отчество", СведенияОбУчастнике.Отчество);
		
		Если ЭтоСведенияОбОрганизации Тогда
			
			Свидетельство = СтрШаблон(НСтр("ru = 'Свидетельство №%1 от %2'"),
				СведенияОбУчастнике.СвидетельствоСерияНомер,
				Формат(СведенияОбУчастнике.СвидетельствоДатаВыдачи, "ДЛФ=D"));
				
			Данные.ТипУчастника.ИП.Вставить("СвидетельствоОГосРегистрации", Свидетельство);
			Данные.ТипУчастника.ИП.Вставить("Отчество", СведенияОбУчастнике.Отчество);
			
			Данные.ТипУчастника.ИП.Вставить("ОГРН", СведенияОбУчастнике.ОГРН);
			Данные.ТипУчастника.ИП.Вставить("ДатаОГРН", СведенияОбУчастнике.ДатаОГРН);
			
		КонецЕсли;
		
		Данные.ТипУчастника.ИП.Вставить("ФИО", Новый Структура("Фамилия, Имя, Отчество"));
		ЗаполнитьЗначенияСвойств(Данные.ТипУчастника.ИП.ФИО, Данные.ТипУчастника.ИП);
		
	КонецЕсли;
	
	ДанныеАдреса = ДанныеАдресаУчастникаУПД_5_02(СведенияОбУчастнике, ПриоритетыВидовКонтактнойИнформации,
		ЭтоСведенияОбОрганизации);
	Если ЗначениеЗаполнено(ДанныеАдреса) Тогда
		Данные.Вставить("Адрес", ДанныеАдреса);
	КонецЕсли;
	
	Данные.Вставить("КонтактныеСведения", Новый Структура);
	
	Телефон = "";
	Если СведенияОбУчастнике.Свойство("Телефоны", Телефон) И ЗначениеЗаполнено(Телефон) Тогда
		Данные.КонтактныеСведения.Вставить("Телефон", Телефон);
		
		Телефоны = Новый ТаблицаЗначений;
		Телефоны.Колонки.Добавить("Телефон");
		НоваяСтрока = Телефоны.Добавить();
		НоваяСтрока.Телефон = Телефон;
		Данные.КонтактныеСведения.Вставить("Телефоны", Телефоны);
		
	КонецЕсли;
	
	ЭлектроннаяПочта = "";
	Если СведенияОбУчастнике.Свойство("ЭлектроннаяПочта", ЭлектроннаяПочта) И ЗначениеЗаполнено(ЭлектроннаяПочта) Тогда
		Данные.КонтактныеСведения.Вставить("ЭлектроннаяПочта", ЭлектроннаяПочта);
		
		ЭлектронныеПочты = Новый ТаблицаЗначений;
		ЭлектронныеПочты.Колонки.Добавить("ЭлектроннаяПочта");
		НоваяСтрока = ЭлектронныеПочты.Добавить();
		НоваяСтрока.ЭлектроннаяПочта = ЭлектроннаяПочта;
		Данные.КонтактныеСведения.Вставить("ЭлектронныеПочты", ЭлектронныеПочты);
			
	КонецЕсли;
	
	Данные.Вставить("БанковскиеРеквизиты", Новый Структура);
	
	НомерСчета = "";
	Если СведенияОбУчастнике.Свойство("НомерСчета", НомерСчета) И ЗначениеЗаполнено(НомерСчета) Тогда
		
		Данные.БанковскиеРеквизиты.Вставить("НомерСчета", НомерСчета);
		
		Банк = ""; БИК = ""; КоррСчет = "";
		Если СведенияОбУчастнике.Свойство("Банк", Банк) И ЗначениеЗаполнено(Банк) Тогда
			
			Данные.БанковскиеРеквизиты.Вставить("НаименованиеБанка", Банк);
			
		КонецЕсли;
		Если СведенияОбУчастнике.Свойство("БИК", БИК) И ЗначениеЗаполнено(БИК) Тогда
			
			Данные.БанковскиеРеквизиты.Вставить("БИКБанка", БИК);
			
		КонецЕсли;
		Если СведенияОбУчастнике.Свойство("КоррСчет", КоррСчет) И ЗначениеЗаполнено(КоррСчет) Тогда
			
			Данные.БанковскиеРеквизиты.Вставить("КорреспондентскийСчетБанка", КоррСчет);
			
		КонецЕсли;
	КонецЕсли;
	
	КодПоОКПО = "";
	Если СведенияОбУчастнике.Свойство("КодПоОКПО", КодПоОКПО) И ЗначениеЗаполнено(КодПоОКПО) Тогда
		
		Данные.Вставить("КодОКПО", КодПоОКПО);
		
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

// Заполняет сведения о маркировке в строке товаров.
//
// Параметры:
//  СтрокаТовара - СтрокаТаблицыЗначений
//  ТаблицаКодовДокумента - ТаблицаЗначений - таблица значений КодыУпаковокМаркируемойПродукции из структуры,
// 											  возвращаемой методом ПолучитьДанныеДляЭД учетного документа.
//  Документ - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО
//
Процедура ЗаполнитьРеквизитыМаркировкиВСтрокеТоваров_5_02(СтрокаТовара, ТаблицаКодовДокумента, Документ)
	
	СведенияОМаркировке = Новый ТаблицаЗначений;
	СведенияОМаркировке.Колонки.Добавить("ИдентификаторУпаковки", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(255)));
	
	ПараметрыПоиска = Новый Структура("ИдентификаторСтроки", СтрокаТовара.ИдентификаторСтроки);
	
	СтрокиУпаковок = ТаблицаКодовДокумента.НайтиСтроки(ПараметрыПоиска);
	Для Каждого СтрокаУпаковки Из СтрокиУпаковок Цикл
		НоваяСтрока = СведенияОМаркировке.Добавить();
		НоваяСтрока.ИдентификаторУпаковки = СтрокаУпаковки.НомерУпаковки;
	КонецЦикла;
	
	СтрокаТовара.СведенияОМаркировке = СведенияОМаркировке;
	
	ПутьКДаннымДляОшибки = СтрШаблон("Объект.Товары[%1].МаркируемыеУпаковки", СтрокаТовара.НомерСтрокиИсходногоДокумента - 1);
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОМаркировке,
		"ИдентификаторУпаковки", Документ, ПутьКДаннымДляОшибки);

КонецПроцедуры

// Заполняет документы подтверждения отгрузки в дереве электронного документа.
//
// Параметры:
//  ДеревоДанных - ДеревоЗначений - дерево электронного документа.
//  СтруктураДанных - Структура - возвращается методом ПолучитьДанныеДляЭД учетного документа.
//
Процедура ЗаполнитьДокументыПодтвержденияОтгрузки_5_02(ДеревоДанных, СтруктураДанных)
	
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	Путь = "СведенияОСчетеФактуре.ДокументыОбОтгрузке";
	ПредставленияДокументовОбОтгрузке = Новый Массив;
	
	ДокументыОбОтгрузке = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
		ДеревоДанных, Путь);
	ВыборкаДокументов = СтруктураДанных.ВыборкаДокументовПодтвержденияОтгрузки;
	Пока ВыборкаДокументов.Следующий() Цикл
		
		ДокументОбОтгрузке = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, Путь + ".НомерСтроки.ДокументОбОтгрузке");
		ДокументОбОтгрузке.НаименованиеДокумента = ВыборкаДокументов.Наименование;
		ДокументОбОтгрузке.НомерДокумента = ВыборкаДокументов.Номер;
		ДокументОбОтгрузке.ДатаДокумента = ВыборкаДокументов.Дата;
		
		НоваяСтрока = ДокументыОбОтгрузке.Добавить();
		НоваяСтрока.ДокументОбОтгрузке = ДокументОбОтгрузке;
		
	КонецЦикла;
	
	Если ДокументыОбОтгрузке.Количество() = 0 Тогда

		ИспользуемУПД = ОбменСКонтрагентами.ИспользованиеУниверсальногоПередаточногоДокумента(
			ВыборкаШапки.Организация, ВыборкаШапки.Контрагент, ВыборкаШапки.ДоговорКонтрагента);
		Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактура
			И СтруктураДанных.Свойство("ВыборкаОснований") Тогда
			ВыборкаОснований = СтруктураДанных.ВыборкаОснований;
			ВыборкаОснований.Сбросить();
			Пока ВыборкаОснований.Следующий() Цикл
				ДокументОснование = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаОснований.ДокументОснование,
					"Номер, Дата, ВидДокумента");
				ДокументОбОтгрузке = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
					ДеревоДанных, Путь + ".НомерСтроки.ДокументОбОтгрузке");
				Если ИспользуемУПД Тогда
					ДокументОбОтгрузке.НомерДокумента = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(
						ВыборкаШапки.Номер, Истина, Истина);
					ДокументОбОтгрузке.ДатаДокумента = НачалоДня(ВыборкаШапки.Дата);
					ДокументОбОтгрузке.НаименованиеДокумента = НСтр("ru = 'Универсальный передаточный документ'");
					Прервать;
				Иначе
					ДокументОбОтгрузке.НомерДокумента = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(
						ДокументОснование.Номер, Истина, Истина);
					ДокументОбОтгрузке.ДатаДокумента = НачалоДня(ДокументОснование.Дата);
					ДокументОбОтгрузке.НаименованиеДокумента = Строка(ДокументОснование.ВидДокумента);
				КонецЕсли;
				ПредставлениеДокумента = СтрШаблон("%1 № %2 от %3", 
					ДокументОбОтгрузке.НаименованиеДокумента,
					ДокументОбОтгрузке.НомерДокумента,
					Формат(ДокументОбОтгрузке.ДатаДокумента, "ДФ=dd.MM.yyyy;"));
				ПредставленияДокументовОбОтгрузке.Добавить(ПредставлениеДокумента);
				НоваяСтрока = ДокументыОбОтгрузке.Добавить();
				НоваяСтрока.ДокументОбОтгрузке = ДокументОбОтгрузке;
			КонецЦикла;
		Иначе
			ДокументОбОтгрузке = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
					ДеревоДанных, Путь + ".НомерСтроки.ДокументОбОтгрузке");
			ДокументОбОтгрузке.НомерДокумента = ВыборкаШапки.Номер;
			ДокументОбОтгрузке.ДатаДокумента = НачалоДня(ВыборкаШапки.Дата);
			Если ИспользуемУПД Тогда
				ДокументОбОтгрузке.НаименованиеДокумента = НСтр("ru = 'Универсальный передаточный документ'");
			Иначе
				ДокументОбОтгрузке.НаименованиеДокумента = Строка(ВыборкаШапки.ВидДокумента);
			КонецЕсли;
			ПредставлениеДокумента = СтрШаблон("%1 № %2 от %3", 
				ДокументОбОтгрузке.НаименованиеДокумента,
				ДокументОбОтгрузке.НомерДокумента,
				Формат(ДокументОбОтгрузке.ДатаДокумента, "ДФ=dd.MM.yyyy;"));
			ПредставленияДокументовОбОтгрузке.Добавить(ПредставлениеДокумента);
			НоваяСтрока = ДокументыОбОтгрузке.Добавить();
			НоваяСтрока.ДокументОбОтгрузке = ДокументОбОтгрузке;
		КонецЕсли;
			
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ДокументыОбОтгрузке, Путь);
	
	Если ЗначениеЗаполнено(ПредставленияДокументовОбОтгрузке) Тогда
		ШаблонСтроки = СтрСоединить(ПредставленияДокументовОбОтгрузке, "; ");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументОбОтгрузке", ШаблонСтроки);
	КонецЕсли;
	
КонецПроцедуры

// Возвращаемое значение:
//  Структура:
// * Сумма - Число
// * БезНДС - Булево - по умолчанию Истина
Функция СуммаНалогаУПД_5_02()
	Возврат Новый Структура("Сумма, БезНДС", 0, Истина);
КонецФункции

// Создает или перезаполняет учетный документ.
//
// Параметры:
//  ДеревоДанных - ДеревоЗначений - дерево электронного документа.
//  СсылкаНаВладельца - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылка на учетный документ.
//  Записывать - Булево - признак проведения учетного документа после заполнения.
//  СпособОбработки - Строка - определяет вид учетного документа.
//  ОписаниеОшибки - Строка - описание ошибки создания учетного документа.
//  ПараметрыДляОтраженияВУчете - Структура - данные для заполнения электронного документа:
//   * ПараметрыЭлектронногоДокумента - см. ОтражениеВУчетеЭДО.НовыеПараметрыЭлектронногоДокумента
//   * ПараметрыСпособаОбмена - см. ОтражениеВУчетеЭДО.НовыеПараметрыСпособаОбмена
//   * ПараметрыПоФорматуДокумента - Структура - дополнительные параметры по формату документа для отражения в учете:
//     ** СпособОбработки - Структура - способы сохранения данных в информационной базе, выбранные пользователем:
//        *** ПервичныйДокумент - Строка - способ сохранения первичного документа.
//        *** СчетФактура       - Строка - способ сохранения счета-фактуры.
//
Процедура НайтиСоздатьУПДДокументОПередаче_5_02(ДеревоДанных, СсылкаНаВладельца, Записывать, СпособОбработки, ОписаниеОшибки,
		ПараметрыДляОтраженияВУчете)
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	ДокументОбъект.НомерЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "СведенияОСчетеФактуре.НомерДокумента");
	ДокументОбъект.НомерИсправления = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "СведенияОСчетеФактуре.Исправление.НомерИсправления");
	Если ЗначениеЗаполнено(ДокументОбъект.НомерИсправления) Тогда
		ВидОперации = Перечисления.ВидыОпераций.Исправление;
		
		ДокументОбъект.ДатаЭД  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "СведенияОСчетеФактуре.Исправление.ДатаИсправления");
		ДокументОбъект.НомерИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "СведенияОСчетеФактуре.НомерДокумента");
		ДокументОбъект.ДатаИсходногоДокумента  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "СведенияОСчетеФактуре.ДатаДокумента");
	Иначе
		ВидОперации = Перечисления.ВидыОпераций.Реализация;
		
		ДокументОбъект.ДатаЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "СведенияОСчетеФактуре.ДатаДокумента");
	КонецЕсли;
	ДокументОбъект.ВидОперации = ВидОперации;
	
	ДокументОбъект.Валюта = ЭлектронноеВзаимодействие.НайтиСсылку("Валюты",
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияОСчетеФактуре.Валюта.Код"));
		
	Путь = "СведенияОСчетеФактуре.ДополнительныеСведенияОбУчастниках.";
	ДокументОбъект.ИдентификаторГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, Путь + "ИдентификаторГосКонтракта");
		
	НомерГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, Путь + "СведенияОГосКонтракте.НомерКонтракта");
	Если ЗначениеЗаполнено(НомерГосКонтракта) Тогда
		ДокументОбъект.ЭтоГосЗакупка = Истина;
	КонецЕсли;
	
	СпециальныеОбстоятельстваФормированияУПД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, Путь + "СпециальныеОбстоятельстваФормированияУПД");
	Если ЗначениеЗаполнено(СпециальныеОбстоятельстваФормированияУПД) Тогда
		ДокументОбъект.СпециальноеОбстоятельствоФНС = СпециальныеОбстоятельстваФормированияУПД;
	КонецЕсли;
	
	СпециальныеОбстоятельстваФормированияДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, Путь + "СпециальныеОбстоятельстваФормированияДокумента");
		
	Если ЗначениеЗаполнено(СпециальныеОбстоятельстваФормированияДокумента) Тогда
		ДокументОбъект.СпециальноеОбстоятельствоФНС = СпециальныеОбстоятельстваФормированияДокумента;
	КонецЕсли;

	СведенияОПродавцах = ДеревоДанных.Строки.Найти("СведенияОСчетеФактуре.СведенияОПродавцах", "ПолныйПуть", Истина);
	СведенияОПокупателях = ДеревоДанных.Строки.Найти("СведенияОСчетеФактуре.СведенияОПокупателях", "ПолныйПуть", Истина);
	Если СведенияОПродавцах.Строки.Количество() > 1
		Или СведенияОПокупателях.Строки.Количество() > 1 Тогда
		ТекстИсключения = СтрШаблон(НСтр("ru = 'Ошибка загрузки электронной товарной накладной %1 от %2.'"), 
			ДокументОбъект.НомерЭД, Формат(ДокументОбъект.ДатаЭД,"ДЛФ=D")) + Символы.ПС
			+ НСтр("ru = 'Загрузка сводных накладных не поддерживается.'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	ОсновнаяСтрокаПродавца = Неопределено;
	
	Путь = "СведенияОСчетеФактуре.СведенияОПродавцах.НомерСтроки.Продавец";
	Для Каждого СтрокаПродавца Из СведенияОПродавцах.Строки Цикл
		ДокументОбъект.Контрагент = КонтрагентПоДаннымЭД(СтрокаПродавца, Путь);
		ОсновнаяСтрокаПродавца = СтрокаПродавца;
		Прервать;
	КонецЦикла;
	
	Путь = "СведенияОСчетеФактуре.СведенияОПокупателях.НомерСтроки.Покупатель";
	Для Каждого СтрокаПокупателя Из СведенияОПокупателях.Строки Цикл
		ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(СтрокаПокупателя, Путь);
		Прервать;
	КонецЦикла;
	
	Путь = "СведенияОСчетеФактуре.СведенияОГрузоотправителях";
	СведенияОГрузоотправителях = ДеревоДанных.Строки.Найти(Путь, "ПолныйПуть", Истина);
	Для Каждого СтрокаГрузоотправителя Из СведенияОГрузоотправителях.Строки Цикл
		ГрузоотправительОнЖе = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СтрокаГрузоотправителя, Путь + ".НомерСтроки.ОнЖе");
		Если ГрузоотправительОнЖе = Истина Тогда
			ДокументОбъект.Грузоотправитель = ДокументОбъект.Контрагент;
		Иначе
			ДокументОбъект.Грузоотправитель = КонтрагентПоДаннымЭД(СтрокаГрузоотправителя,
				Путь + ".НомерСтроки.Грузоотправитель");
		КонецЕсли;
		Прервать;
	КонецЦикла;
	
	Путь = "СведенияОСчетеФактуре.СведенияОГрузополучателях";
	СведенияОГрузополучателях = ДеревоДанных.Строки.Найти(Путь, "ПолныйПуть", Истина);
	Для Каждого СтрокаГрузополучателя Из СведенияОГрузополучателях.Строки Цикл
		ДокументОбъект.Грузополучатель = КонтрагентПоДаннымЭД(СтрокаГрузополучателя,
			Путь + ".НомерСтроки.Грузополучатель");
		Прервать;
	КонецЦикла;
	
	ДокументОбъект.Перевозчик = КонтрагентПоДаннымЭД(ДеревоДанных, "СведенияОПеревозчике");
	
	ДокументОбъект.НомерТранспортнойНакладной = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "НомерТранспортнойНакладной", Ложь);
	
	ДокументОбъект.ДатаТранспортнойНакладной = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДатаТранспортнойНакладной", Ложь);
	
	ДокументОбъект.СведенияОТранспортировкеИГрузе = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "СведенияОПередаче.Операция.Транспортировка.Сведения");
	
	// Поиск и заполнение договора контрагента.
	Путь = "СведенияОПередаче.Операция.ОснованиеОтгрузкиПередачи.ДокументыОснования";
	ОснованияОтгрузки = ДеревоДанных.Строки.Найти(Путь, "ПолныйПуть", Истина);
	Если ОснованияОтгрузки <> Неопределено Тогда
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки,
				Путь + ".НомерСтроки.ДокументОснование.НомерДокумента");
			ДоговорДата = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки,
				Путь + ".НомерСтроки.ДокументОснование.ДатаДокумента");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				СвойстваДоговора = Новый Структура;
				СвойстваДоговора.Вставить("НомерДоговора", ДоговорНомер);
				СвойстваДоговора.Вставить("ДатаДоговора", ДоговорДата);
				СвойстваДоговора.Вставить("Организация", ДокументОбъект.Организация);
				СвойстваДоговора.Вставить("Владелец", ДокументОбъект.Контрагент);
				
				ДоговорКонтрагента = ЭлектронноеВзаимодействие.НайтиСсылку("ДоговорыКонтрагентов",, СвойстваДоговора);
				ДокументОбъект.ДоговорКонтрагента = ДоговорКонтрагента;
				
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	// Поиск и заполнение банковского счета контрагента.
	Путь = "СведенияОСчетеФактуре.СведенияОПродавцах.НомерСтроки.Продавец.БанковскиеРеквизиты";
	НомерСчета = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ОсновнаяСтрокаПродавца,
		Путь + ".НомерСчета");
	БИКБанка = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ОсновнаяСтрокаПродавца,
		Путь + ".БИКБанка");
	ДокументОбъект.БанковскийСчетКонтрагента = БанковскийСчетКонтрагента(
		ДокументОбъект.Контрагент, БИКБанка, НомерСчета, ДокументОбъект.Валюта);
	
	// Сведения об основании.
	ДокументыОснованияДокументаОтгрузки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки");
	Если ЗначениеЗаполнено(ДокументыОснованияДокументаОтгрузки) Тогда
		ДокументОбъект.ДокументОснование = ДокументыОснованияДокументаОтгрузки[0];
	Иначе
		ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
		Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
			МассивСчетФактур = Новый Массив;
			
			Для Каждого СтрокаСФ Из ДокументыОснованияСчетаФактуры Цикл
				Если ТипЗнч(СтрокаСФ) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
					МассивСчетФактур.Добавить(СтрокаСФ);
				КонецЕсли;
			КонецЦикла;
			
			Если МассивСчетФактур.Количество() > 0 Тогда
				ЗаполненДокументОснование = Ложь;
				ВсеДокументыОснования = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивСчетФактур, "ДокументыОснования");
				Для Каждого ТекущаяСчетФактура Из МассивСчетФактур Цикл
					Если ЗаполненДокументОснование Тогда
					    Прервать;
					КонецЕсли;
					
					ДокументыОснования = ВсеДокументыОснования.Получить(ТекущаяСчетФактура);
					
					Если ДокументыОснования = Неопределено
						Или ДокументыОснования.Пустой() Тогда
					    Продолжить;
					КонецЕсли;
					
					ВыборкаДокументовОснований = ДокументыОснования.Выбрать();
					Пока ВыборкаДокументовОснований.Следующий() Цикл
						Если ЗначениеЗаполнено(ВыборкаДокументовОснований.ДокументОснование) Тогда
							ДокументОбъект.ДокументОснование = ВыборкаДокументовОснований.ДокументОснование;
							ЗаполненДокументОснование = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	ЕстьТовары = Ложь;
	ЕстьРаботы = Ложь;
	ЕстьПрава  = Ложь;
	
	ОблагаетсяНДСУПокупателя = Ложь;
	ИспользоватьСопоставлениеНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	
	ДокументОбъект.Товары.Очистить();
	ДокументОбъект.КодыУпаковокМаркируемойПродукции.Очистить();
	
	ТаблицаТоваров = ДокументОбъект.Товары.ВыгрузитьКолонки();
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(ТаблицаТоваров);
	
	// Сведения таблицы.
	Путь = "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях";
	СведенияОТоварах = ДеревоДанных.Строки.Найти(Путь, "ПолныйПуть", Истина);
	
	ИспользуетсяГосИС = КлиентЭДОВызовСервера.ИспользуетсяГосИС();
	Если ИспользуетсяГосИС Тогда
		ШтрихкодыУпаковок = ЭлектронноеВзаимодействиеИСМП.НоваяТаблицаШтрихкодыУпаковок();
	КонецЕсли;
	
	Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
		
		Признак = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.Признак");
		
		Если Признак = "1" Тогда
			ЕстьТовары = Истина;
		ИначеЕсли Признак = "2" Или Признак = "3" Тогда
			ЕстьРаботы = Истина;
		ИначеЕсли Признак = "4" Тогда
			ЕстьПрава  = Истина;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		НоваяСтрока.КоличествоУпаковок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.Количество");
		НоваяСтрока.Цена = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.Цена");
		НоваяСтрока.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.СтоимостьБезНалога");
		НоваяСтрока.СуммаАкциза = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.СуммаАкциза.Сумма");
		
		Если НоваяСтрока.Цена = 0 И НоваяСтрока.Количество <> 0 И ЕстьРаботы Тогда
			НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.Количество;
		ИначеЕсли НоваяСтрока.Цена = 0 И НоваяСтрока.Количество = 0 И ЕстьРаботы Тогда
			НоваяСтрока.Цена = НоваяСтрока.Сумма;
		КонецЕсли;
		
		СтавкаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.НалоговаяСтавка");
		Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
			НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
			ОблагаетсяНДСУПокупателя = Истина;
		Иначе
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаСНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.СтоимостьСНалогом");
			НоваяСтрока.СуммаНДС  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.СуммаНалога.Сумма");
		КонецЕсли;
		
		СведенияОТаможеннойДекларации = СведенияОТоваре.Строки.Найти(
			Путь + ".НомерСтроки.СведенияОДекларации", "ПолныйПуть", Истина);		
		Если СведенияОТаможеннойДекларации <> Неопределено
			И СведенияОТаможеннойДекларации.Строки.Количество() Тогда
			
			НоваяСтрока.НомерГТД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
				Путь + ".НомерСтроки.СведенияОДекларации.НомерСтроки.НомерДекларации");
			
			КодСтраны = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
				Путь + ".НомерСтроки.СведенияОДекларации.НомерСтроки.КодСтраны");
			
			Если ЗначениеЗаполнено(КодСтраны) Тогда
				НоваяСтрока.СтранаПроисхождения = УправлениеКонтактнойИнформацией.СтранаМираПоКодуИлиНаименованию(КодСтраны);
			КонецЕсли;
			
		КонецЕсли;
		
		ДанныеДляРасчетаАмортизации = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации");
		Если ЗначениеЗаполнено(ДанныеДляРасчетаАмортизации) Тогда
			НоваяСтрока.АмортизационнаяГруппа = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации.АмортизационнаяГруппа");
			НоваяСтрока.КодОКОФ = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации.КодОКОФ");
			НоваяСтрока.СрокПолезногоИспользования = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации.СрокИспользования");
			НоваяСтрока.ФактСрокПолезногоИспользования = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации.ФактическийСрокИспользования");
		КонецЕсли;
		
		НоваяСтрока.ОснованиеОсвобожденияОтНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.ОснованиеОсвобожденияОтНДС");
		
		КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(НоваяСтрока);
		ЗаполнитьКодыМаркировкиУПД_5_02(ДокументОбъект, НоваяСтрока, СведенияОТоваре);
		
		Сопоставление = СведенияОТоваре.Строки.Найти(
			Путь + ".НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
		Если Сопоставление <> Неопределено Тогда
			
			Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.Сопоставление.Идентификатор");
			Если ЗначениеЗаполнено(Идентификатор) Тогда
				НоваяСтрока.ИдентификаторКонтрагента = Идентификатор;
			КонецЕсли;
			
			Если ИспользоватьСопоставлениеНоменклатуры Тогда
			
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
				КонецЕсли;
				
				Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.Сопоставление.ХарактеристикаИБ");
				Если ЗначениеЗаполнено(Характеристика) Тогда
					НоваяСтрока.Характеристика = Характеристика;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
			ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, Путь + ".НомерСтроки.ЕдиницаИзмеренияКод");
			ЕдиницаИзмеренияНаименование = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, Путь + ".НомерСтроки.ЕдиницаИзмеренияНаименование");
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) И ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
				НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.УпаковкаНоменклатуры(
					НоваяСтрока.Номенклатура, ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
			ИначеЕсли ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
				НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.ЕдиницаИзмеренияПоКоду(
					ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.НаименованиеКонтрагента = ПредставлениеНоменклатурыПоставщика(
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, Путь + ".НомерСтроки.Наименование"),
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, Путь + ".НомерСтроки.Характеристика"));
		
		НоваяСтрока.НаименованиеПоставщика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.Наименование");
		НоваяСтрока.КодТНВЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.КодВидаТовара");
		
		ЗаполнитьСведенияПрослеживаемостиИзДереваЭлектронногоДокумента(ДокументОбъект, НоваяСтрока, СведенияОТоваре,
			Путь + ".НомерСтроки.СведенияОПрослеживаемости");
		
		ЗаполнитьВидДеятельностиРаздельногоУчетаНДС(НоваяСтрока);
		
		РассчитатьКоличествоБазовыхЕдиниц(НоваяСтрока);
		
		Если ИспользуетсяГосИС Тогда
			ЭлектронноеВзаимодействиеИСМП.ДобавитьШтрихкодыТаблицуШтрихкодовУпаковок_5_02(ШтрихкодыУпаковок, СведенияОТоваре);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИспользуетсяГосИС Тогда
		ЭлектронноеВзаимодействиеИСМП.СвернутьТаблицуШтрихкодовУпаковок(ШтрихкодыУпаковок);
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ШтрихкодыУпаковок);
	КонецЕсли;
	
	СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(ТаблицаТоваров, ДокументОбъект.Контрагент);
	ДокументОбъект.Товары.Загрузить(ТаблицаТоваров);
	
	ДокументОбъект.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;
	
	Путь = "ТаблицаСчетаФактуры.ВсегоКОплате";
	Если ОблагаетсяНДСУПокупателя Тогда
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			Путь + ".СтоимостьБезНалога");
	Иначе
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			Путь + ".СтоимостьСНалогом");
	КонецЕсли;
	
	Если СпособОбработки = "ВозвратТоваровОтПокупателя" Тогда
		ВидДокумента = Перечисления.ВидыДокументов.НакладнаяНаВозврат;
	ИначеЕсли ЕстьТовары Тогда
		ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная;
	ИначеЕсли ЕстьРаботы Тогда
		ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот;
	ИначеЕсли ЕстьПрава Тогда
		ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав;
	ИначеЕсли СпособОбработки = "АктВыполненныхРабот" Тогда
		ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот;
	ИначеЕсли СпособОбработки = "АктНаПередачуПрав" Тогда	
		ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав;
	Иначе	
		ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная;
	КонецЕсли;
	
	ДокументОбъект.ВидДокумента = ВидДокумента;
	
	РежимЗаписиПроведение = Истина;
	Если ДокументОбъект.ВидОперации <> Перечисления.ВидыОпераций.Реализация Тогда
		РежимЗаписиПроведение = ЗначениеЗаполнено(ДокументОбъект.ДокументОснование);
	КонецЕсли;
	
	Если Записывать Тогда
		ЗаписатьДокумент(ДокументОбъект, РежимЗаписиПроведение);
		СсылкаНаВладельца = ДокументОбъект.Ссылка;
		
		ЗаписатьПрисоединенныеФайлыКДокументуЧерезСервисShare(СсылкаНаВладельца, ПараметрыДляОтраженияВУчете);
	Иначе // если функция вызвана из формы "Обработки.ИнтерфейсДокументовЭДО.ЗагрузкаПросмотрЭлектронногоДокумента"
		СсылкаНаВладельца = ДокументОбъект;
	КонецЕсли;
	
КонецПроцедуры

// Создает или перезаполняет учетный документ.
//
// Параметры:
//  ДеревоДанных - ДеревоЗначений - дерево электронного документа.
//  СсылкаНаВладельца - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылка на учетный документ.
//  Записывать - Булево - признак проведения учетного документа после заполнения.
//  СпособОбработки - Строка - определяет вид учетного документа.
//  ОписаниеОшибки - Строка - описание ошибки создания учетного документа.
//
Процедура НайтиСоздатьУПД0Закупка_5_02(ДеревоДанных, СсылкаНаВладельца, Записывать, СпособОбработки, ОписаниеОшибки)
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	ДокументОбъект.НомерЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "СведенияОСчетеФактуре.НомерДокумента");
	ДокументОбъект.НомерИсправления = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "СведенияОСчетеФактуре.Исправление.НомерИсправления");
	Если ЗначениеЗаполнено(ДокументОбъект.НомерИсправления) Тогда
		ВидОперации = Перечисления.ВидыОпераций.Исправление;
		
		ДокументОбъект.ДатаЭД  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "СведенияОСчетеФактуре.Исправление.ДатаИсправления");
		ДокументОбъект.НомерИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "СведенияОСчетеФактуре.НомерДокумента");
		ДокументОбъект.ДатаИсходногоДокумента  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "СведенияОСчетеФактуре.ДатаДокумента");
	Иначе
		ВидОперации = Перечисления.ВидыОпераций.Реализация;
		
		ДокументОбъект.ДатаЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "СведенияОСчетеФактуре.ДатаДокумента");
	КонецЕсли;
	ДокументОбъект.ВидОперации = ВидОперации;
	
	ДокументОбъект.Валюта = ЭлектронноеВзаимодействие.НайтиСсылку("Валюты",
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияОСчетеФактуре.Валюта.Код"));
		
	Путь = "СведенияОСчетеФактуре.ДополнительныеСведенияОбУчастниках.";
	ДокументОбъект.ИдентификаторГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, Путь + "ИдентификаторГосКонтракта");
		
	НомерГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, Путь + "СведенияОГосКонтракте.НомерКонтракта");
	Если ЗначениеЗаполнено(НомерГосКонтракта) Тогда
		ДокументОбъект.ЭтоГосЗакупка = Истина;
	КонецЕсли;
	
	СведенияОПродавцах = ДеревоДанных.Строки.Найти("СведенияОСчетеФактуре.СведенияОПродавцах", "ПолныйПуть", Истина);
	СведенияОПокупателях = ДеревоДанных.Строки.Найти("СведенияОСчетеФактуре.СведенияОПокупателях", "ПолныйПуть", Истина);
	Если СведенияОПродавцах.Строки.Количество() > 1
		Или СведенияОПокупателях.Строки.Количество() > 1 Тогда
		ТекстИсключения = СтрШаблон(НСтр("ru = 'Ошибка загрузки электронной товарной накладной %1 от %2.'"), 
			ДокументОбъект.НомерЭД, Формат(ДокументОбъект.ДатаЭД,"ДЛФ=D")) + Символы.ПС
			+ НСтр("ru = 'Загрузка сводных накладных не поддерживается.'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	ОсновнаяСтрокаПродавца = Неопределено;
	
	Путь = "СведенияОСчетеФактуре.СведенияОПродавцах.НомерСтроки.Продавец";
	Для Каждого СтрокаПродавца Из СведенияОПродавцах.Строки Цикл
		ДокументОбъект.Контрагент = КонтрагентПоДаннымЭД(СтрокаПродавца, Путь);
		Если Не ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
			ДокументОбъект.Контрагент = СоздатьКонтрагентаПоДаннымУПД(СтрокаПродавца, Путь);
		КонецЕсли;
		ОсновнаяСтрокаПродавца = СтрокаПродавца;
		Прервать;
	КонецЦикла;
	
	ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(ДеревоДанных, "СведенияОКомитенте");
	
	Путь = "СведенияОСчетеФактуре.СведенияОГрузоотправителях";
	СведенияОГрузоотправителях = ДеревоДанных.Строки.Найти(Путь, "ПолныйПуть", Истина);
	Для Каждого СтрокаГрузоотправителя Из СведенияОГрузоотправителях.Строки Цикл
		ГрузоотправительОнЖе = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СтрокаГрузоотправителя, Путь + ".НомерСтроки.ОнЖе");
		Если ГрузоотправительОнЖе = Истина Тогда
			ДокументОбъект.Грузоотправитель = ДокументОбъект.Контрагент;
		Иначе
			ДокументОбъект.Грузоотправитель = КонтрагентПоДаннымЭД(СтрокаГрузоотправителя,
				Путь + ".НомерСтроки.Грузоотправитель");
		КонецЕсли;
		Прервать;
	КонецЦикла;
	
	Путь = "СведенияОСчетеФактуре.СведенияОГрузополучателях";
	СведенияОГрузополучателях = ДеревоДанных.Строки.Найти(Путь, "ПолныйПуть", Истина);
	Для Каждого СтрокаГрузополучателя Из СведенияОГрузополучателях.Строки Цикл
		ДокументОбъект.Грузополучатель = КонтрагентПоДаннымЭД(СтрокаГрузополучателя,
			Путь + ".НомерСтроки.Грузополучатель");
		Прервать;
	КонецЦикла;
	
	Путь = "СведенияОСчетеФактуре.СведенияОПокупателях.НомерСтроки.Покупатель";
	Если Не ЗначениеЗаполнено(ДокументОбъект.Грузополучатель) Тогда
		Для Каждого СтрокаПокупателя Из СведенияОПокупателях.Строки Цикл
			ДокументОбъект.Грузополучатель = КонтрагентПоДаннымЭД(СтрокаПокупателя, Путь);
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	ДокументОбъект.Перевозчик = КонтрагентПоДаннымЭД(ДеревоДанных, "СведенияОПеревозчике");
	
	ДокументОбъект.НомерТранспортнойНакладной = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "НомерТранспортнойНакладной", Ложь);
	
	ДокументОбъект.ДатаТранспортнойНакладной = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДатаТранспортнойНакладной", Ложь);
	
	ДокументОбъект.СведенияОТранспортировкеИГрузе = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "СведенияОПередаче.Операция.Транспортировка.Сведения");
	
	// Поиск и заполнение договора контрагента.
	Путь = "СведенияОПередаче.Операция.ОснованиеОтгрузкиПередачи.ДокументыОснования";
	ОснованияОтгрузки = ДеревоДанных.Строки.Найти(Путь, "ПолныйПуть", Истина);
	Если ОснованияОтгрузки <> Неопределено Тогда
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки,
				Путь + ".НомерСтроки.ДокументОснование.НомерДокумента");
			ДоговорДата = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки,
				Путь + ".НомерСтроки.ДокументОснование.ДатаДокумента");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				СвойстваДоговора = Новый Структура;
				СвойстваДоговора.Вставить("НомерДоговора", ДоговорНомер);
				СвойстваДоговора.Вставить("ДатаДоговора", ДоговорДата);
				СвойстваДоговора.Вставить("Организация", ДокументОбъект.Организация);
				СвойстваДоговора.Вставить("Владелец", ДокументОбъект.Контрагент);
				
				ДоговорКонтрагента = ЭлектронноеВзаимодействие.НайтиСсылку("ДоговорыКонтрагентов",, СвойстваДоговора);
				ДокументОбъект.ДоговорКонтрагента = ДоговорКонтрагента;
				
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	// Поиск и заполнение банковского счета контрагента.
	Путь = "СведенияОСчетеФактуре.СведенияОПродавцах.НомерСтроки.Продавец.БанковскиеРеквизиты";
	НомерСчета = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ОсновнаяСтрокаПродавца,
		Путь + ".НомерСчета");
	БИКБанка = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ОсновнаяСтрокаПродавца,
		Путь + ".БИКБанка");
	ДокументОбъект.БанковскийСчетКонтрагента = БанковскийСчетКонтрагента(
		ДокументОбъект.Контрагент, БИКБанка, НомерСчета, ДокументОбъект.Валюта);
	
	// Сведения об основании.
	ДокументыОснованияДокументаОтгрузки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки");
	Если ЗначениеЗаполнено(ДокументыОснованияДокументаОтгрузки) Тогда
		ДокументОбъект.ДокументОснование = ДокументыОснованияДокументаОтгрузки[0];
	Иначе
		ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
		Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
			МассивСчетФактур = Новый Массив;
			
			Для Каждого СтрокаСФ Из ДокументыОснованияСчетаФактуры Цикл
				Если ТипЗнч(СтрокаСФ) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
					МассивСчетФактур.Добавить(СтрокаСФ);
				КонецЕсли;
			КонецЦикла;
			
			Если МассивСчетФактур.Количество() > 0 Тогда
				ЗаполненДокументОснование = Ложь;
				ВсеДокументыОснования = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивСчетФактур, "ДокументыОснования");
				Для Каждого ТекущаяСчетФактура Из МассивСчетФактур Цикл
					Если ЗаполненДокументОснование Тогда
					    Прервать;
					КонецЕсли;
					
					ДокументыОснования = ВсеДокументыОснования.Получить(ТекущаяСчетФактура);
					
					Если ДокументыОснования = Неопределено
						Или ДокументыОснования.Пустой() Тогда
					    Продолжить;
					КонецЕсли;
					
					ВыборкаДокументовОснований = ДокументыОснования.Выбрать();
					Пока ВыборкаДокументовОснований.Следующий() Цикл
						Если ЗначениеЗаполнено(ВыборкаДокументовОснований.ДокументОснование) Тогда
							ДокументОбъект.ДокументОснование = ВыборкаДокументовОснований.ДокументОснование;
							ЗаполненДокументОснование = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	ОблагаетсяНДСУПокупателя = Ложь;
	ИспользоватьСопоставлениеНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	
	ДокументОбъект.Товары.Очистить();
	ДокументОбъект.КодыУпаковокМаркируемойПродукции.Очистить();
	
	ТаблицаТоваров = ДокументОбъект.Товары.ВыгрузитьКолонки();
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(ТаблицаТоваров);
	
	// Сведения таблицы.
	Путь = "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях";
	СведенияОТоварах = ДеревоДанных.Строки.Найти(Путь, "ПолныйПуть", Истина);
	
	ИспользуетсяГосИС = КлиентЭДОВызовСервера.ИспользуетсяГосИС();
	Если ИспользуетсяГосИС Тогда
		ШтрихкодыУпаковок = ЭлектронноеВзаимодействиеИСМП.НоваяТаблицаШтрихкодыУпаковок();
	КонецЕсли;
	
	Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
		
		Признак = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.Признак");
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		НоваяСтрока.КоличествоУпаковок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.Количество");
		НоваяСтрока.Цена = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.Цена");
		НоваяСтрока.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.СтоимостьБезНалога");
		НоваяСтрока.СуммаАкциза = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.СуммаАкциза.Сумма");
		
		Если НоваяСтрока.Цена = 0 И НоваяСтрока.Количество <> 0
			И (Признак = "2" Или Признак = "3") Тогда
			НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.Количество;
		КонецЕсли;
		
		СтавкаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.НалоговаяСтавка");
		Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
			НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
			ОблагаетсяНДСУПокупателя = Истина;
		Иначе
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаСНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.СтоимостьСНалогом");
			НоваяСтрока.СуммаНДС  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.СуммаНалога.Сумма");
		КонецЕсли;
		
		СведенияОТаможеннойДекларации = СведенияОТоваре.Строки.Найти(
			Путь + ".НомерСтроки.СведенияОДекларации", "ПолныйПуть", Истина);		
		Если СведенияОТаможеннойДекларации <> Неопределено
			И СведенияОТаможеннойДекларации.Строки.Количество() Тогда
			
			НоваяСтрока.НомерГТД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
				Путь + ".НомерСтроки.СведенияОДекларации.НомерСтроки.НомерДекларации");
			
			КодСтраны = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
				Путь + ".НомерСтроки.СведенияОДекларации.НомерСтроки.КодСтраны");
			
			Если ЗначениеЗаполнено(КодСтраны) Тогда
				НоваяСтрока.СтранаПроисхождения = УправлениеКонтактнойИнформацией.СтранаМираПоКодуИлиНаименованию(КодСтраны);
			КонецЕсли;
			
		КонецЕсли;
		
		ДанныеДляРасчетаАмортизации = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации");
		Если ЗначениеЗаполнено(ДанныеДляРасчетаАмортизации) Тогда
			НоваяСтрока.АмортизационнаяГруппа = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации.АмортизационнаяГруппа");
			НоваяСтрока.КодОКОФ = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации.КодОКОФ");
			НоваяСтрока.СрокПолезногоИспользования = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации.СрокИспользования");
			НоваяСтрока.ФактСрокПолезногоИспользования = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации.ФактическийСрокИспользования");
		КонецЕсли;
		
		НоваяСтрока.ОснованиеОсвобожденияОтНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.ОснованиеОсвобожденияОтНДС");
		
		КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(НоваяСтрока);
		ЗаполнитьКодыМаркировкиУПД_5_02(ДокументОбъект, НоваяСтрока, СведенияОТоваре);
		
		Сопоставление = СведенияОТоваре.Строки.Найти(
			Путь + ".НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
		Если Сопоставление <> Неопределено Тогда
			
			Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.Сопоставление.Идентификатор");
			Если ЗначениеЗаполнено(Идентификатор) Тогда
				НоваяСтрока.ИдентификаторКонтрагента = Идентификатор;
			КонецЕсли;
			
			Если ИспользоватьСопоставлениеНоменклатуры Тогда
			
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
				КонецЕсли;
				
				Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.Сопоставление.ХарактеристикаИБ");
				Если ЗначениеЗаполнено(Характеристика) Тогда
					НоваяСтрока.Характеристика = Характеристика;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
			ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, Путь + ".НомерСтроки.ЕдиницаИзмеренияКод");
			ЕдиницаИзмеренияНаименование = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, Путь + ".НомерСтроки.ЕдиницаИзмеренияНаименование");
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
				НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.УпаковкаНоменклатуры(
					НоваяСтрока.Номенклатура, ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.НаименованиеКонтрагента = ПредставлениеНоменклатурыПоставщика(
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, Путь + ".НомерСтроки.Наименование"),
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, Путь + ".НомерСтроки.Характеристика"));
		
		НоваяСтрока.НаименованиеПоставщика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.Наименование");
		НоваяСтрока.КодТНВЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.КодВидаТовара");
		
		ЗаполнитьСведенияПрослеживаемостиИзДереваЭлектронногоДокумента(ДокументОбъект, НоваяСтрока, СведенияОТоваре,
			Путь + ".НомерСтроки.СведенияОПрослеживаемости");
		
		ЗаполнитьВидДеятельностиРаздельногоУчетаНДС(НоваяСтрока);
		
		РассчитатьКоличествоБазовыхЕдиниц(НоваяСтрока);
		
		Если ИспользуетсяГосИС Тогда
			ЭлектронноеВзаимодействиеИСМП.ДобавитьШтрихкодыТаблицуШтрихкодовУпаковок_5_02(ШтрихкодыУпаковок, СведенияОТоваре);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИспользуетсяГосИС Тогда
		ЭлектронноеВзаимодействиеИСМП.СвернутьТаблицуШтрихкодовУпаковок(ШтрихкодыУпаковок);
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ШтрихкодыУпаковок);
	КонецЕсли;
	
	СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(ТаблицаТоваров, ДокументОбъект.Контрагент);
	ДокументОбъект.Товары.Загрузить(ТаблицаТоваров);
	
	ДокументОбъект.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;
	
	Путь = "ТаблицаСчетаФактуры.ВсегоКОплате";
	Если ОблагаетсяНДСУПокупателя Тогда
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			Путь + ".СтоимостьБезНалога");
	Иначе
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			Путь + ".СтоимостьСНалогом");
	КонецЕсли;
	
	ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.СведенияКомиссионера;
	
	РежимЗаписиПроведение = Истина;
	Если ДокументОбъект.ВидОперации <> Перечисления.ВидыОпераций.Реализация Тогда
		РежимЗаписиПроведение = ЗначениеЗаполнено(ДокументОбъект.ДокументОснование);
	КонецЕсли;
	
	Если Записывать Тогда
		ЗаписатьДокумент(ДокументОбъект, РежимЗаписиПроведение);
		СсылкаНаВладельца = ДокументОбъект.Ссылка;
	Иначе // если функция вызвана из формы "Обработки.ИнтерфейсДокументовЭДО.ЗагрузкаПросмотрЭлектронногоДокумента"
		СсылкаНаВладельца = ДокументОбъект;
	КонецЕсли;
	
КонецПроцедуры

// Создает или перезаполняет учетный документ.
//
// Параметры:
//  ДеревоДанных - ДеревоЗначений - дерево электронного документа.
//  СсылкаНаВладельца - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылка на учетный документ.
//  Записывать - Булево - признак проведения учетного документа после заполнения.
//  СпособОбработки - Строка - определяет вид учетного документа.
//  ОписаниеОшибки - Строка - описание ошибки создания учетного документа.
//
Процедура НайтиСоздатьУПД0Реализация_5_02(ДеревоДанных, СсылкаНаВладельца, Записывать, СпособОбработки, ОписаниеОшибки)
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	ДокументОбъект.НомерЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "СведенияОСчетеФактуре.НомерДокумента");
	ДокументОбъект.НомерИсправления = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "СведенияОСчетеФактуре.Исправление.НомерИсправления");
	Если ЗначениеЗаполнено(ДокументОбъект.НомерИсправления) Тогда
		ВидОперации = Перечисления.ВидыОпераций.Исправление;
		
		ДокументОбъект.НомерИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "СведенияОСчетеФактуре.НомерДокумента");
		ДокументОбъект.ДатаИсходногоДокумента  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "СведенияОСчетеФактуре.ДатаДокумента");
	Иначе
		ВидОперации = Перечисления.ВидыОпераций.Реализация;
		ДокументОбъект.ДатаЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "СведенияОСчетеФактуре.ДатаДокумента");
	КонецЕсли;
	ДокументОбъект.ВидОперации = ВидОперации;
	
	ДокументОбъект.Валюта = ЭлектронноеВзаимодействие.НайтиСсылку("Валюты",
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияОСчетеФактуре.Валюта.Код"));
		
	Путь = "СведенияОСчетеФактуре.ДополнительныеСведенияОбУчастниках.";
	ДокументОбъект.ИдентификаторГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, Путь + "ИдентификаторГосКонтракта");
		
	НомерГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, Путь + "СведенияОГосКонтракте.НомерКонтракта");
	Если ЗначениеЗаполнено(НомерГосКонтракта) Тогда
		ДокументОбъект.ГосЗакупкаНомерКонтракта = НомерГосКонтракта;
	КонецЕсли;
	
	СведенияОПродавцах = ДеревоДанных.Строки.Найти("СведенияОСчетеФактуре.СведенияОПродавцах", "ПолныйПуть", Истина);
	СведенияОПокупателях = ДеревоДанных.Строки.Найти("СведенияОСчетеФактуре.СведенияОПокупателях", "ПолныйПуть", Истина);
	Если СведенияОПродавцах.Строки.Количество() > 1
		Или СведенияОПокупателях.Строки.Количество() > 1 Тогда
		ТекстИсключения = СтрШаблон(НСтр("ru = 'Ошибка загрузки электронной товарной накладной %1 от %2.'"), 
			ДокументОбъект.НомерЭД, Формат(ДокументОбъект.ДатаЭД,"ДЛФ=D")) + Символы.ПС
			+ НСтр("ru = 'Загрузка сводных накладных не поддерживается.'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(ДеревоДанных, "СведенияОКомитенте");
	
	ОсновнаяСтрокаПродавца = Неопределено;
	
	Для Каждого СтрокаПродавца Из СведенияОПродавцах.Строки Цикл
		ОсновнаяСтрокаПродавца = СтрокаПродавца;
		Прервать;
	КонецЦикла;
	
	Путь = "СведенияОСчетеФактуре.СведенияОПокупателях.НомерСтроки.Покупатель";
	Для Каждого СтрокаПокупателя Из СведенияОПокупателях.Строки Цикл
		ДокументОбъект.Контрагент = КонтрагентПоДаннымЭД(СтрокаПокупателя, Путь);
		Если Не ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
			ДокументОбъект.Контрагент = СоздатьКонтрагентаПоДаннымУПД(СтрокаПокупателя, Путь);
		КонецЕсли;
		Прервать;
	КонецЦикла;
	
	Путь = "СведенияОСчетеФактуре.СведенияОГрузоотправителях";
	СведенияОГрузоотправителях = ДеревоДанных.Строки.Найти(Путь, "ПолныйПуть", Истина);
	Для Каждого СтрокаГрузоотправителя Из СведенияОГрузоотправителях.Строки Цикл
		ГрузоотправительОнЖе = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СтрокаГрузоотправителя, Путь + ".НомерСтроки.ОнЖе");
		Если ГрузоотправительОнЖе = Истина Тогда
			ДокументОбъект.Грузоотправитель = ДокументОбъект.Контрагент;
		Иначе
			ДокументОбъект.Грузоотправитель = КонтрагентПоДаннымЭД(СтрокаГрузоотправителя,
				Путь + ".НомерСтроки.Грузоотправитель");
		КонецЕсли;
		Прервать;
	КонецЦикла;
	
	Путь = "СведенияОСчетеФактуре.СведенияОГрузополучателях";
	СведенияОГрузополучателях = ДеревоДанных.Строки.Найти(Путь, "ПолныйПуть", Истина);
	Для Каждого СтрокаГрузополучателя Из СведенияОГрузополучателях.Строки Цикл
		ДокументОбъект.Грузополучатель = КонтрагентПоДаннымЭД(СтрокаГрузополучателя,
			Путь + ".НомерСтроки.Грузополучатель");
		Прервать;
	КонецЦикла;
	
	ДокументОбъект.Перевозчик = КонтрагентПоДаннымЭД(ДеревоДанных, "СведенияОПеревозчике");
	
	ДокументОбъект.НомерТранспортнойНакладной = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "НомерТранспортнойНакладной", Ложь);
	
	ДокументОбъект.ДатаТранспортнойНакладной = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДатаТранспортнойНакладной", Ложь);
	
	ДокументОбъект.СведенияОТранспортировкеИГрузе = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "СведенияОПередаче.Операция.Транспортировка.Сведения");
	
	// Поиск и заполнение договора контрагента.
	Путь = "СведенияОПередаче.Операция.ОснованиеОтгрузкиПередачи.ДокументыОснования";
	ОснованияОтгрузки = ДеревоДанных.Строки.Найти(Путь, "ПолныйПуть", Истина);
	Если ОснованияОтгрузки <> Неопределено Тогда
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки,
				Путь + ".НомерСтроки.ДокументОснование.НомерДокумента");
			ДоговорДата = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки,
				Путь + ".НомерСтроки.ДокументОснование.ДатаДокумента");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				СвойстваДоговора = Новый Структура;
				СвойстваДоговора.Вставить("НомерДоговора", ДоговорНомер);
				СвойстваДоговора.Вставить("ДатаДоговора", ДоговорДата);
				СвойстваДоговора.Вставить("Организация", ДокументОбъект.Организация);
				СвойстваДоговора.Вставить("Владелец", ДокументОбъект.Контрагент);
				
				ДоговорКонтрагента = ЭлектронноеВзаимодействие.НайтиСсылку("ДоговорыКонтрагентов",, СвойстваДоговора);
				ДокументОбъект.ДоговорКонтрагента = ДоговорКонтрагента;
				
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;	
		
	ОблагаетсяНДСУПокупателя = Ложь;
	ИспользоватьСопоставлениеНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	
	ДокументОбъект.Товары.Очистить();
	ДокументОбъект.КодыУпаковокМаркируемойПродукции.Очистить();
	
	ТаблицаТоваров = ДокументОбъект.Товары.ВыгрузитьКолонки();
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(ТаблицаТоваров);
	
	// Сведения таблицы.
	Путь = "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях";
	СведенияОТоварах = ДеревоДанных.Строки.Найти(Путь, "ПолныйПуть", Истина);
	
	ИспользуетсяГосИС = КлиентЭДОВызовСервера.ИспользуетсяГосИС();
	Если ИспользуетсяГосИС Тогда
		ШтрихкодыУпаковок = ЭлектронноеВзаимодействиеИСМП.НоваяТаблицаШтрихкодыУпаковок();
	КонецЕсли;
	
	Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
		
		Признак = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.Признак");
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		НоваяСтрока.Содержание = ПредставлениеНоменклатурыПоставщика(
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.Наименование"),
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.Характеристика"));
		
		НоваяСтрока.КоличествоУпаковок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.Количество");
		НоваяСтрока.Цена = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.Цена");
		НоваяСтрока.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.СтоимостьБезНалога");
		НоваяСтрока.СуммаАкциза = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.СуммаАкциза.Сумма");
		
		Если НоваяСтрока.Цена = 0 И НоваяСтрока.Количество <> 0
			И (Признак = "2" Или Признак = "3") Тогда
			НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.Количество;
		КонецЕсли;
		
		СтавкаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.НалоговаяСтавка");
		Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
			НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
			ОблагаетсяНДСУПокупателя = Истина;
		Иначе
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаСНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.СтоимостьСНалогом");
			НоваяСтрока.СуммаНДС  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.СуммаНалога.Сумма");
		КонецЕсли;
		
		СведенияОТаможеннойДекларации = СведенияОТоваре.Строки.Найти(
			Путь + ".НомерСтроки.СведенияОДекларации", "ПолныйПуть", Истина);		
		Если СведенияОТаможеннойДекларации <> Неопределено
			И СведенияОТаможеннойДекларации.Строки.Количество() Тогда
			
			НоваяСтрока.НомерГТД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
				Путь + ".НомерСтроки.СведенияОДекларации.НомерСтроки.НомерДекларации");
			
			КодСтраны = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
				Путь + ".НомерСтроки.СведенияОДекларации.НомерСтроки.КодСтраны");
			
			Если ЗначениеЗаполнено(КодСтраны) Тогда
				НоваяСтрока.СтранаПроисхождения = УправлениеКонтактнойИнформацией.СтранаМираПоКодуИлиНаименованию(КодСтраны);
			КонецЕсли;
			
		КонецЕсли;
		
		ДанныеДляРасчетаАмортизации = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации");
		Если ЗначениеЗаполнено(ДанныеДляРасчетаАмортизации) Тогда
			НоваяСтрока.АмортизационнаяГруппа = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации.АмортизационнаяГруппа");
			НоваяСтрока.КодОКОФ = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации.КодОКОФ");
			НоваяСтрока.СрокПолезногоИспользования = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации.СрокИспользования");
			НоваяСтрока.ФактСрокПолезногоИспользования = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации.ФактическийСрокИспользования");
		КонецЕсли;
		
		НоваяСтрока.ОснованиеОсвобожденияОтНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.ОснованиеОсвобожденияОтНДС");
		
		КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(НоваяСтрока);
		ЗаполнитьКодыМаркировкиУПД_5_02(ДокументОбъект, НоваяСтрока, СведенияОТоваре);
		
		Если ИспользоватьСопоставлениеНоменклатуры Тогда
			
			Сопоставление = СведенияОТоваре.Строки.Найти(
				Путь + ".НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
			Если Сопоставление <> Неопределено Тогда
			
				Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.Сопоставление.Идентификатор");
				Если ЗначениеЗаполнено(Идентификатор) Тогда
					НоваяСтрока.ИдентификаторКонтрагента = Идентификатор;
				КонецЕсли;
			
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
				КонецЕсли;
				
				Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.Сопоставление.ХарактеристикаИБ");
				Если ЗначениеЗаполнено(Характеристика) Тогда
					НоваяСтрока.Характеристика = Характеристика;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
			ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, Путь + ".НомерСтроки.ЕдиницаИзмеренияКод");
			ЕдиницаИзмеренияНаименование = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, Путь + ".НомерСтроки.ЕдиницаИзмеренияНаименование");
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
				Если ИспользоватьСопоставлениеНоменклатуры Тогда
					НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.УпаковкаНоменклатуры(
						НоваяСтрока.Номенклатура, ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
				Иначе
					НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.ЕдиницаИзмеренияПоКоду(
						ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.КодТНВЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			Путь + ".НомерСтроки.КодВидаТовара");
		
		ЗаполнитьСведенияПрослеживаемостиИзДереваЭлектронногоДокумента(ДокументОбъект, НоваяСтрока, СведенияОТоваре,
			Путь + ".НомерСтроки.СведенияОПрослеживаемости");
		
		РассчитатьКоличествоБазовыхЕдиниц(НоваяСтрока);
		
		Если ИспользуетсяГосИС Тогда
			ЭлектронноеВзаимодействиеИСМП.ДобавитьШтрихкодыТаблицуШтрихкодовУпаковок_5_02(ШтрихкодыУпаковок, СведенияОТоваре);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИспользуетсяГосИС Тогда
		ЭлектронноеВзаимодействиеИСМП.СвернутьТаблицуШтрихкодовУпаковок(ШтрихкодыУпаковок);
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ШтрихкодыУпаковок);
	КонецЕсли;
	
	Если ИспользоватьСопоставлениеНоменклатуры Тогда
		СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(
			ТаблицаТоваров, ДокументОбъект.Контрагент);
	КонецЕсли;
	
	ДокументОбъект.Товары.Загрузить(ТаблицаТоваров);
	
	ДокументОбъект.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;
	
	Путь = "ТаблицаСчетаФактуры.ВсегоКОплате";
	Если ОблагаетсяНДСУПокупателя Тогда
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			Путь + ".СтоимостьБезНалога");
	Иначе
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			Путь + ".СтоимостьСНалогом");
	КонецЕсли;
	
	ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.СведенияКомиссионера;
	РежимЗаписиПроведение = Истина;
	
	Если Записывать Тогда
		ЗаписатьДокумент(ДокументОбъект, РежимЗаписиПроведение);
		СсылкаНаВладельца = ДокументОбъект.Ссылка;
	Иначе // если функция вызвана из формы "Обработки.ИнтерфейсДокументовЭДО.ЗагрузкаПросмотрЭлектронногоДокумента"
		СсылкаНаВладельца = ДокументОбъект;
	КонецЕсли;
	
КонецПроцедуры

// Создает или перезаполняет учетный документ.
//
// Параметры:
//  ДеревоДанных - ДеревоЗначений - дерево электронного документа.
//  СсылкаНаВладельца - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылка на учетный документ.
//  Записывать - Булево - признак проведения учетного документа после заполнения.
//  СпособОбработки - Строка - определяет вид учетного документа.
//  ОписаниеОшибки - Строка - описание ошибки создания учетного документа.
//
Процедура НайтиСоздатьУПДСчетФактуру_5_02(ДеревоДанных, СсылкаНаВладельца = Неопределено, СпособОбработки = "", ОписаниеОшибки = "")
	
	ТекущаяДатаСеанса = ТекущаяДатаСеанса();
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.СчетФактураПолученный.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса;
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	ВидСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры");
	Если ВидСчетаФактуры = "Авансовый" Тогда
		ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс;
	Иначе
		ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.СчетФактура;
	КонецЕсли;
	
	ДокументОбъект.НомерЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "СведенияОСчетеФактуре.НомерДокумента");
	ДокументОбъект.НомерИсправления = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "СведенияОСчетеФактуре.Исправление.НомерИсправления");
	Если ЗначениеЗаполнено(ДокументОбъект.НомерИсправления) Тогда
		ВидОперации = Перечисления.ВидыОпераций.Исправление;
		
		ДокументОбъект.ДатаЭД  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "СведенияОСчетеФактуре.Исправление.ДатаИсправления");
		ДокументОбъект.НомерИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "СведенияОСчетеФактуре.НомерДокумента");
		ДокументОбъект.ДатаИсходногоДокумента  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "СведенияОСчетеФактуре.ДатаДокумента");
	Иначе
		ВидОперации = Перечисления.ВидыОпераций.Реализация;
		
		ДокументОбъект.ДатаЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "СведенияОСчетеФактуре.ДатаДокумента");
	КонецЕсли;
	ДокументОбъект.ВидОперации = ВидОперации;
	
	ДокументОбъект.Валюта = ЭлектронноеВзаимодействие.НайтиСсылку("Валюты",
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияОСчетеФактуре.Валюта.Код"));
		
	Путь = "СведенияОСчетеФактуре.ДополнительныеСведенияОбУчастниках.";
	ДокументОбъект.ИдентификаторГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, Путь + "ИдентификаторГосКонтракта");
		
	СведенияОПродавцах = ДеревоДанных.Строки.Найти("СведенияОСчетеФактуре.СведенияОПродавцах", "ПолныйПуть", Истина);
	СведенияОПокупателях = ДеревоДанных.Строки.Найти("СведенияОСчетеФактуре.СведенияОПокупателях", "ПолныйПуть", Истина);
	Если СведенияОПродавцах.Строки.Количество() > 1
		Или СведенияОПокупателях.Строки.Количество() > 1 Тогда
		ТекстИсключения = СтрШаблон(НСтр("ru = 'Ошибка загрузки электронной товарной накладной %1 от %2.'"), 
			ДокументОбъект.НомерЭД, Формат(ДокументОбъект.ДатаЭД,"ДЛФ=D")) + Символы.ПС
			+ НСтр("ru = 'Загрузка сводных счетов-фактур не поддерживается.'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;	
	
	Путь = "СведенияОСчетеФактуре.СведенияОПродавцах.НомерСтроки.Продавец";
	Для Каждого СтрокаПродавца Из СведенияОПродавцах.Строки Цикл
		ДокументОбъект.Контрагент = КонтрагентПоДаннымЭД(СтрокаПродавца, Путь);
		Прервать;
	КонецЦикла;
	
	Путь = "СведенияОСчетеФактуре.СведенияОПокупателях.НомерСтроки.Покупатель";
	Для Каждого СтрокаПокупателя Из СведенияОПокупателях.Строки Цикл
		ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(СтрокаПокупателя, Путь);
		Прервать;
	КонецЦикла;
	
	// Поиск и заполнение договора контрагента.
	Путь = "СведенияОПередаче.Операция.ОснованиеОтгрузкиПередачи.ДокументыОснования";
	ОснованияОтгрузки = ДеревоДанных.Строки.Найти(Путь, "ПолныйПуть", Истина);
	Если ОснованияОтгрузки <> Неопределено Тогда
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки,
				Путь + ".НомерСтроки.ДокументОснование.НомерДокумента");
			ДоговорДата = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки,
				Путь + ".НомерСтроки.ДокументОснование.ДатаДокумента");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				СвойстваДоговора = Новый Структура;
				СвойстваДоговора.Вставить("НомерДоговора", ДоговорНомер);
				СвойстваДоговора.Вставить("ДатаДоговора", ДоговорДата);
				СвойстваДоговора.Вставить("Организация", ДокументОбъект.Организация);
				СвойстваДоговора.Вставить("Владелец", ДокументОбъект.Контрагент);
				
				ДоговорКонтрагента = ЭлектронноеВзаимодействие.НайтиСсылку("ДоговорыКонтрагентов",, СвойстваДоговора);
				ДокументОбъект.ДоговорКонтрагента = ДоговорКонтрагента;
				
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	ДокументОбъект.СчетФактураОснование = Документы.СчетФактураПолученный.ПустаяСсылка();
	ДокументОбъект.ДокументыОснования.Очистить();
	ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДокументыОснованияСчетаФактуры");
	Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		МетаданныеТабличнаяЧасть = Метаданные.Документы.СчетФактураПолученный.ТабличныеЧасти.ДокументыОснования;
		ТипыДокументовОснований = МетаданныеТабличнаяЧасть.Реквизиты.ДокументОснование.Тип.Типы();
		Для Каждого ДокументОснования Из ДокументыОснованияСчетаФактуры Цикл
			Если ТипЗнч(ДокументОснования) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				ДокументОбъект.СчетФактураОснование = ДокументОснования;
			Иначе
				ТипДокументаОснования = ТипЗнч(ДокументОснования);
				Если ТипыДокументовОснований.Найти(ТипДокументаОснования) <> Неопределено Тогда
					СтрокаТаблицы = ДокументОбъект.ДокументыОснования.Добавить();
					СтрокаТаблицы.ДокументОснование = ДокументОснования;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		// Для исправительных счет-фактура удаляем из их документов-оснований основания исправляемых счет-фактур.
		Если Не ДокументОбъект.СчетФактураОснование.Пустая()
			И ДокументОбъект.ДокументыОснования.Количество() > 0 Тогда
			УстановитьПривилегированныйРежим(Истина);
			ДокументыОснованияИсправляемойСФ =
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.СчетФактураОснование, "ДокументыОснования");
			ДокументыОснованияИсправляемойСФ = ДокументыОснованияИсправляемойСФ.Выгрузить();
			УстановитьПривилегированныйРежим(Ложь);
			
			Индекс = ДокументОбъект.ДокументыОснования.Количество() - 1;
			Пока Индекс >= 0 Цикл
				ТекущаяСтрока = ДокументОбъект.ДокументыОснования[Индекс];
				Если ДокументыОснованияИсправляемойСФ.Найти(
					ТекущаяСтрока.ДокументОснование, "ДокументОснование") <> Неопределено Тогда
					ДокументОбъект.ДокументыОснования.Удалить(Индекс);
				КонецЕсли;
				Индекс = Индекс - 1;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ОблагаетсяНДСУПокупателя = Ложь;
	ИспользоватьСопоставлениеНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	
	ДокументОбъект.Товары.Очистить();
	Если ДокументОбъект.ДокументыОснования.Количество() = 0 Тогда
		
		ТаблицаТоваров = ДокументОбъект.Товары.ВыгрузитьКолонки();
		
		СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(ТаблицаТоваров);
		
		// Сведения таблицы.
		Путь = "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях";
		СведенияОТоварах = ДеревоДанных.Строки.Найти(Путь, "ПолныйПуть", Истина);
		
		ИспользуетсяГосИС = КлиентЭДОВызовСервера.ИспользуетсяГосИС();
		Если ИспользуетсяГосИС Тогда
			ШтрихкодыУпаковок = ЭлектронноеВзаимодействиеИСМП.НоваяТаблицаШтрихкодыУпаковок();
		КонецЕсли;
		
		Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
			
			Признак = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.Признак");
				
			НоваяСтрока = ТаблицаТоваров.Добавить();	
				
			НоваяСтрока.КоличествоУпаковок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.Количество");
			НоваяСтрока.Цена = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.Цена");
			НоваяСтрока.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.СтоимостьБезНалога");
			НоваяСтрока.СуммаАкциза = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.СуммаАкциза.Сумма");
			
			Если НоваяСтрока.Цена = 0 И НоваяСтрока.Количество <> 0
				И (Признак = "2" Или Признак = "3") Тогда
				НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.Количество;
			КонецЕсли;
			
			СтавкаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.НалоговаяСтавка");
			Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
				НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
				ОблагаетсяНДСУПокупателя = Истина;
			Иначе
				НоваяСтрока.СтавкаНДС = СтавкаНДС;
				НоваяСтрока.СуммаСНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.СтоимостьСНалогом");
				НоваяСтрока.СуммаНДС  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.СуммаНалога.Сумма");
			КонецЕсли;
			
			СведенияОТаможеннойДекларации = СведенияОТоваре.Строки.Найти(
				Путь + ".НомерСтроки.СведенияОДекларации", "ПолныйПуть", Истина);
			
			Если СведенияОТаможеннойДекларации <> Неопределено
				И СведенияОТаможеннойДекларации.Строки.Количество() Тогда
				
				НоваяСтрока.НомерГТД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
					Путь + ".НомерСтроки.СведенияОДекларации.НомерСтроки.НомерДекларации");
				
				КодСтраны = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
					Путь + ".НомерСтроки.СведенияОДекларации.НомерСтроки.КодСтраны");
				
				Если ЗначениеЗаполнено(КодСтраны) Тогда
					НоваяСтрока.СтранаПроисхождения = УправлениеКонтактнойИнформацией.СтранаМираПоКодуИлиНаименованию(КодСтраны);
				КонецЕсли;
				
			КонецЕсли;
			
			ДанныеДляРасчетаАмортизации = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации", "ПолныйПуть");
			Если ЗначениеЗаполнено(ДанныеДляРасчетаАмортизации) Тогда
				НоваяСтрока.АмортизационнаяГруппа = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации.АмортизационнаяГруппа");
				НоваяСтрока.КодОКОФ = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации.КодОКОФ");
				НоваяСтрока.СрокПолезногоИспользования = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации.СрокИспользования");
				НоваяСтрока.ФактСрокПолезногоИспользования = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.ДанныеДляРасчетаАмортизации.ФактическийСрокИспользования");
			КонецЕсли;
			
			НоваяСтрока.ОснованиеОсвобожденияОтНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				Путь + ".НомерСтроки.ОснованиеОсвобожденияОтНДС");
			
			КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(НоваяСтрока);
			
			Если Не ИспользуетсяГосИС Тогда
			ЗаполнитьКодыМаркировкиУПД_5_02(ДокументОбъект, НоваяСтрока, СведенияОТоваре);
			КонецЕсли;
			
			Если ИспользоватьСопоставлениеНоменклатуры Тогда
			
				Сопоставление = СведенияОТоваре.Строки.Найти(
					Путь + ".НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
				Если Сопоставление <> Неопределено Тогда
				
					Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
						Путь + ".НомерСтроки.Сопоставление.Идентификатор");
					Если ЗначениеЗаполнено(Идентификатор) Тогда
						НоваяСтрока.ИдентификаторКонтрагента = Идентификатор;
					КонецЕсли;
				
					Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
						Путь + ".НомерСтроки.Сопоставление.НоменклатураИБ");
					Если ЗначениеЗаполнено(Номенклатура) Тогда
						НоваяСтрока.Номенклатура = Номенклатура;
					КонецЕсли;
					
					Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
						Путь + ".НомерСтроки.Сопоставление.ХарактеристикаИБ");
					Если ЗначениеЗаполнено(Характеристика) Тогда
						НоваяСтрока.Характеристика = Характеристика;
					КонецЕсли;
					
					ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
						Путь + ".НомерСтроки.Сопоставление.УпаковкаИБ");
					Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
						НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
				ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СведенияОТоваре, Путь + ".НомерСтроки.ЕдиницаИзмеренияКод");
				ЕдиницаИзмеренияНаименование = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СведенияОТоваре, Путь + ".НомерСтроки.ЕдиницаИзмеренияНаименование");
				Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
					Если ИспользоватьСопоставлениеНоменклатуры Тогда
						НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.УпаковкаНоменклатуры(
							НоваяСтрока.Номенклатура, ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
					Иначе
						НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.ЕдиницаИзмеренияПоКоду(
							ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока.НаименованиеКонтрагента = ПредставлениеНоменклатурыПоставщика(
				ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.Наименование"),
				ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					Путь + ".НомерСтроки.Характеристика"));
			НоваяСтрока.НаименованиеПоставщика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, Путь + ".НомерСтроки.Наименование");
			НоваяСтрока.КодТНВЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, Путь + ".НомерСтроки.КодВидаТовара");
			
			РассчитатьКоличествоБазовыхЕдиниц(НоваяСтрока);
			
			Если ИспользуетсяГосИС Тогда
				ЭлектронноеВзаимодействиеИСМП.ДобавитьШтрихкодыТаблицуШтрихкодовУпаковок_5_02(ШтрихкодыУпаковок, СведенияОТоваре);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ИспользуетсяГосИС Тогда
			ЭлектронноеВзаимодействиеИСМП.СвернутьТаблицуШтрихкодовУпаковок(ШтрихкодыУпаковок);
			ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ШтрихкодыУпаковок);
		КонецЕсли;
		
		Если ИспользоватьСопоставлениеНоменклатуры Тогда
			СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(
				ТаблицаТоваров, ДокументОбъект.Контрагент);
		КонецЕсли;
		
		ДокументОбъект.Товары.Загрузить(ТаблицаТоваров);
		
	Иначе
		
		ОблагаетсяНДСУПокупателя =
			ДеревоДанных.Строки.Найти("НДС исчисляется налоговым агентом", "Значение", Истина) <> Неопределено;
		
	КонецЕсли;
	
	ДокументОбъект.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;

	Путь = "ТаблицаСчетаФактуры.ВсегоКОплате";
	Если ОблагаетсяНДСУПокупателя Тогда
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			Путь + ".СтоимостьБезНалога");
	Иначе
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			Путь + ".СтоимостьСНалогом");
	КонецЕсли;
	
	Путь = "СведенияОСчетеФактуре.СведенияОПлатежноРасчетныхДокументах";
	ДокументОбъект.ПлатежноРасчетныеДокументы.Очистить();
	ПлатежноРасчетныеДокументы = ДеревоДанных.Строки.Найти(Путь, "ПолныйПуть", Истина);
	Если ПлатежноРасчетныеДокументы <> Неопределено Тогда
		Для Каждого СтрокаПРД Из ПлатежноРасчетныеДокументы.Строки Цикл
			НомерПРД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаПРД,
				Путь + ".НомерСтроки.Номер");
			ДатаПРД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаПРД,
				Путь + ".НомерСтроки.Дата");
			
			Если ЗначениеЗаполнено(НомерПРД) И ЗначениеЗаполнено(ДатаПРД) Тогда
				НоваяСтрока = ДокументОбъект.ПлатежноРасчетныеДокументы.Добавить();
				НоваяСтрока.НомерПлатежноРасчетногоДокумента = НомерПРД;
				НоваяСтрока.ДатаПлатежноРасчетногоДокумента = ДатаПРД;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	РежимЗаписиПроведение = Истина;
	Если ДокументОбъект.ВидОперации <> Перечисления.ВидыОпераций.Реализация Тогда
		РежимЗаписиПроведение = ЗначениеЗаполнено(ДокументОбъект.СчетФактураОснование);
	КонецЕсли;
	
	ЗаписатьДокумент(ДокументОбъект, РежимЗаписиПроведение);
	СсылкаНаВладельца = ДокументОбъект.Ссылка;
	
КонецПроцедуры

// Заполняет коды упаковок маркируемой продукции в учетном документе.
//
// Параметры:
//  ДокументОбъект - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО
//  СтрокаТоваров - СтрокаТаблицыЗначений
//  СтрокаТоваровДерева - СтрокаДереваЗначений
//
Процедура ЗаполнитьКодыМаркировкиУПД_5_02(ДокументОбъект, СтрокаТоваров, СтрокаТоваровДерева)
	ТаблицаДокумента = ДокументОбъект.КодыУпаковокМаркируемойПродукции;
	Путь = "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях.НомерСтроки.СведенияОМаркировке";
	ПутьКИЗ = Путь + ".НомерСтроки.Идентификатор.КонтрольныеЗнаки";
	ПутьУпаковки = Путь + ".НомерСтроки.Идентификатор.ИдентификаторыУпаковок";
	
	СведенияОМаркировке = СтрокаТоваровДерева.Строки.Найти(Путь, "ПолныйПуть", Истина);
	Если СведенияОМаркировке <> Неопределено И ЗначениеЗаполнено(СведенияОМаркировке.Значение) Тогда
		Для Каждого Маркировка Из СведенияОМаркировке.Строки Цикл
			СтрокаНовойУпаковки = ТаблицаДокумента.Добавить();
			СтрокаНовойУпаковки.ИдентификаторСтроки = СтрокаТоваров.ИдентификаторСтроки;
			СтрокаНовойУпаковки.НомерУпаковки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				Маркировка, Путь + ".НомерСтроки.ИдентификаторУпаковки");
			
			КонтрольныеЗнаки = Маркировка.Строки.Найти(ПутьКИЗ, "ПолныйПуть", Истина);
			Если КонтрольныеЗнаки <> Неопределено И ЗначениеЗаполнено(КонтрольныеЗнаки.Значение) Тогда
				Для Каждого КонтрольныйЗнак Из КонтрольныеЗнаки.Строки Цикл
				    СтрокаНовойУпаковки = ТаблицаДокумента.Добавить();
					СтрокаНовойУпаковки.ИдентификаторСтроки = СтрокаТоваров.ИдентификаторСтроки;
					СтрокаНовойУпаковки.НомерУпаковки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
						КонтрольныйЗнак, ПутьКИЗ + ".НомерСтроки.КонтрольныйЗнак");
				КонецЦикла;
			КонецЕсли;	
				
			ИдентификаторыУпаковок = Маркировка.Строки.Найти(ПутьУпаковки, "ПолныйПуть", Истина);
			Если ИдентификаторыУпаковок <> Неопределено И ЗначениеЗаполнено(ИдентификаторыУпаковок.Значение) Тогда
				Для Каждого ИдентификаторУпаковки Из ИдентификаторыУпаковок.Строки Цикл
				    СтрокаНовойУпаковки = ТаблицаДокумента.Добавить();
					СтрокаНовойУпаковки.ИдентификаторСтроки = СтрокаТоваров.ИдентификаторСтроки;
					СтрокаНовойУпаковки.НомерУпаковки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
						ИдентификаторУпаковки, ПутьУпаковки + ".НомерСтроки.ИдентификаторУпаковки");
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры

// Возвращаемое значение:
//  Булево - Истина, если действуют правила заполнения с копейками
Функция ДействуютПравилаЗаполненияПоПроектуПостановления1137()
	
	Возврат ТекущаяУниверсальнаяДата() >= Дата(2025, 12, 31, 21, 0, 0);
	
КонецФункции

// Заполняет данные участников УПД в дереве значений.
//
// Параметры:
//  ДеревоДанных - ДеревоЗначений
//  СведенияОбУчастнике - см. ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица
//  ВидУчастника - Строка
//  ВидАдреса - Строка
//  ЭтоЭлектронноеАктированиеЕИС - Булево
//
Процедура ЗаполнитьДанныеУчастникаУПД_5_02(ДеревоДанных, СведенияОбУчастнике, ВидУчастника,
	ВидАдреса = "ЮридическийАдрес", ЭтоЭлектронноеАктированиеЕИС = Ложь)
	
	// Подготовим параметры обработки ошибок
	КлючДанных = Неопределено;
	СведенияОбУчастнике.Свойство("Ссылка", КлючДанных);
	
	ПараметрыОбработкиОшибокИНН = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		КлючДанных, "Объект.ИНН");
	ПараметрыОбработкиОшибокКПП = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		КлючДанных, "Объект.КПП");
	
	ТипУчастникаОрганизация = ТипЗнч(КлючДанных) = Тип("СправочникСсылка.Организации");
	ПостфиксПоляАдрес = ?(ТипУчастникаОрганизация, "Организации", "Контрагента");
		
	ПутьКДаннымНаименования = ?(ТипУчастникаОрганизация, "Объект.НаименованиеСокращенное", "Объект.НаименованиеПолное");
	
	ПараметрыОбработкиОшибокНаименование = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		КлючДанных, ПутьКДаннымНаименования);
	
	Если ЭтоЭлектронноеАктированиеЕИС И ТипУчастникаОрганизация Тогда
		МодульЭлектронноеАктированиеЕИС = ОбщегоНазначения.ОбщийМодуль("ЭлектронноеАктированиеЕИС");
		НаименованиеОрганизации = МодульЭлектронноеАктированиеЕИС.НаименованиеОрганизацииДляЭД(
			СведенияОбУчастнике.Ссылка);
	Иначе
		НаименованиеОрганизации = СведенияОбУчастнике.ПолноеНаименование;
	КонецЕсли;
	
	Если СведенияОбУчастнике.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации",
			НаименованиеОрганизации, ПараметрыОбработкиОшибокНаименование);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ЮЛ.ИНН",
			СведенияОбУчастнике.ИНН, ПараметрыОбработкиОшибокИНН);

		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ЮЛ.КПП",
			СведенияОбУчастнике.КПП, ПараметрыОбработкиОшибокКПП);
		
	ИначеЕсли СведенияОбУчастнике.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент Тогда
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации",
			НаименованиеОрганизации, ПараметрыОбработкиОшибокНаименование);
			
		Статусы = Новый Структура;
		Статусы.Вставить("Организация", "ИО");
		Статусы.Вставить("Гражданин", "ИГ");
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИЛ.Статус",
			Статусы.Организация);
		
		КодСтраны = Неопределено;
		Страна = Неопределено;
		Если ЗначениеЗаполнено(СведенияОбУчастнике.ЮридическийАдресXML) Тогда
			СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(СведенияОбУчастнике.ЮридическийАдресXML);
			КодСтраны = СведенияОбАдресе.КодСтраны;
			Страна = СведенияОбАдресе.Страна;
		КонецЕсли;
		
		ПараметрыОбработкиОшибокКодСтраныИЛ = Неопределено;
		ПараметрыОбработкиОшибокНаименованиеСтраныИЛ = Неопределено;
		
		Если Не ТипУчастникаОрганизация Тогда
			ПараметрыОбработкиОшибокКодСтраныИЛ = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				КлючДанных, "КонтактнаяИнформацияПолеЮрАдрес" + ПостфиксПоляАдрес);
			ПараметрыОбработкиОшибокНаименованиеСтраныИЛ = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				КлючДанных, "КонтактнаяИнформацияПолеЮрАдрес" + ПостфиксПоляАдрес);
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИЛ.КодСтраны",
			КодСтраны, ПараметрыОбработкиОшибокКодСтраныИЛ);

		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеСтраны",
			Страна, ПараметрыОбработкиОшибокНаименованиеСтраныИЛ);
			
		ПараметрыОбработкиОшибокИдентификаторИЛ = Неопределено;
		Если Не ТипУчастникаОрганизация Тогда
			ПараметрыОбработкиОшибокИдентификаторИЛ = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				КлючДанных, "Объект.ИдентификаторЮридическогоЛица");
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИЛ.ИдентификаторОрганизацииИлиГражданина",
			СведенияОбУчастнике.ИдентификаторЮридическогоЛица, ПараметрыОбработкиОшибокИдентификаторИЛ);
		
	Иначе
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИП.ИНН",
			СведенияОбУчастнике.ИНН, ПараметрыОбработкиОшибокИНН);
			
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИП.ФИО.Фамилия",
			СведенияОбУчастнике.Фамилия, ПараметрыОбработкиОшибокНаименование);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИП.ФИО.Имя",
			СведенияОбУчастнике.Имя, ПараметрыОбработкиОшибокНаименование);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИП.ФИО.Отчество",
			СведенияОбУчастнике.Отчество, ПараметрыОбработкиОшибокНаименование);	
		
		Если ТипЗнч(СведенияОбУчастнике.Ссылка) = Тип("СправочникСсылка.Организации") Тогда
		
			Свидетельство = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Свидетельство №%1 от %2'"),
				СведенияОбУчастнике.СвидетельствоСерияНомер,
				Формат(СведенияОбУчастнике.СвидетельствоДатаВыдачи, "ДЛФ=D"));
			
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				КлючДанных, "Объект.СвидетельствоСерияНомер");
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ИП.СвидетельствоОГосРегистрации",
				Свидетельство, ПараметрыОбработкиОшибок);
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Передаем в дерево данные для заполнения адреса.
	
	ВидКонтактнойИнформации = Неопределено;
	
	ТипУчастникаОрганизация = ТипЗнч(КлючДанных) = Тип("СправочникСсылка.Организации");
	
	Если ВидАдреса = "ПроизвольныйАдрес"
		И ЗначениеЗаполнено(СведенияОбУчастнике.ПроизвольныйАдресЗначенияПолей) Тогда
		
		СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(СведенияОбУчастнике.ПроизвольныйАдресЗначенияПолей);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".Адрес.ТипАдреса.АдресИнформация.КодСтраны", СведенияОбАдресе.КодСтраны);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".Адрес.ТипАдреса.АдресИнформация.НаименованиеСтраны", СведенияОбАдресе.Страна);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".Адрес.ТипАдреса.АдресИнформация.АдресТекст", СведенияОбАдресе.Представление);
		
	ИначеЕсли ВидАдреса = "ПочтовыйАдрес"
		И ЗначениеЗаполнено(СведенияОбУчастнике[ВидАдреса]) Тогда
		
		ВидКонтактнойИнформации = ?(ТипУчастникаОрганизация, Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресОрганизации,
			Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресКонтрагента);
		
	ИначеЕсли ВидАдреса = "ФактическийАдрес" 
		И ЗначениеЗаполнено(СведенияОбУчастнике[ВидАдреса]) Тогда
		
		ВидКонтактнойИнформации = ?(ТипУчастникаОрганизация, Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации,
			Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента);
		
	Иначе
		
		ВидКонтактнойИнформации = ?(ТипУчастникаОрганизация, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,
			Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
		
	КонецЕсли;
	
	Если ВидКонтактнойИнформации <> Неопределено Тогда
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СведенияОбУчастнике.Ссылка, "КонтактнаяИнформацияПолеЮрАдрес" + ПостфиксПоляАдрес + ".");
		
		ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных, ВидУчастника + ".Адрес.АвтоматическиЗаполняемый",
			ПараметрыОбработкиОшибок);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ВидУчастника + ".Адрес.ТипАдреса.АвтоматическиЗаполняемый.ОбъектКонтактнойИнформации", КлючДанных);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ВидУчастника + ".Адрес.ТипАдреса.АвтоматическиЗаполняемый.ВидКонтактнойИнформации", ВидКонтактнойИнформации);	
		
	КонецЕсли;
	
	Телефон = "";
	Если СведенияОбУчастнике.Свойство("Телефоны", Телефон) И ЗначениеЗаполнено(Телефон) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".КонтактныеСведения.Телефоны.НомерСтроки.Телефон",
			Телефон, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	ЭлектроннаяПочта = "";
	Если СведенияОбУчастнике.Свойство("ЭлектроннаяПочта", ЭлектроннаяПочта) И ЗначениеЗаполнено(ЭлектроннаяПочта) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".КонтактныеСведения.ЭлектронныеПочты.НомерСтроки.ЭлектроннаяПочта",
			ЭлектроннаяПочта, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	НомерСчета = "";
	Если СведенияОбУчастнике.Свойство("НомерСчета", НомерСчета) И ЗначениеЗаполнено(НомерСчета) Тогда
		ПараметрыОбработкиОшибок = Неопределено;
		Если СведенияОбУчастнике.Свойство("БанковскийСчет") Тогда
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				СведенияОбУчастнике.БанковскийСчетСсылка, "Объект.НомерСчета");
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".БанковскиеРеквизиты.НомерСчета",
			НомерСчета, ПараметрыОбработкиОшибок);
				
		Банк = ""; БИК = ""; КоррСчет = "";
		Если СведенияОбУчастнике.Свойство("Банк", Банк) И ЗначениеЗаполнено(Банк) Тогда
			ПараметрыОбработкиОшибок = Неопределено;
			Если СведенияОбУчастнике.Свойство("БанкСсылка") Тогда
				ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
					СведенияОбУчастнике.БанкСсылка, "Объект.Наименование");
			КонецЕсли;
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".БанковскиеРеквизиты.НаименованиеБанка",
				Банк, ПараметрыОбработкиОшибок);
		КонецЕсли;
		Если СведенияОбУчастнике.Свойство("БИК", БИК) И ЗначениеЗаполнено(БИК) Тогда
			ПараметрыОбработкиОшибок = Неопределено;
			Если СведенияОбУчастнике.Свойство("БанкСсылка") Тогда
				ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
					СведенияОбУчастнике.БанкСсылка, "Объект.Код");
			КонецЕсли;
				
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".БанковскиеРеквизиты.БИКБанка",
				БИК, ПараметрыОбработкиОшибок);
		КонецЕсли;
		Если СведенияОбУчастнике.Свойство("КоррСчет", КоррСчет) И ЗначениеЗаполнено(КоррСчет) Тогда
			ПараметрыОбработкиОшибок = Неопределено;
			Если СведенияОбУчастнике.Свойство("БанкСсылка") Тогда
				ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
					СведенияОбУчастнике.БанкСсылка, "Объект.КоррСчет");
			КонецЕсли;
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".БанковскиеРеквизиты.КорреспондентскийСчетБанка",
				КоррСчет, ПараметрыОбработкиОшибок);
		КонецЕсли;
	КонецЕсли;
	
	КодПоОКПО = "";
	Если СведенияОбУчастнике.Свойство("КодПоОКПО", КодПоОКПО) И ЗначениеЗаполнено(КодПоОКПО) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(КлючДанных,
			"Объект.КодПоОКПО");
					
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ВидУчастника + ".КодОКПО", КодПоОКПО, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  СведенияОбУчастнике - см. ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица
//  ПриоритетыВидовКонтактнойИнформации - Массив из Строка
//                                      - Неопределено
//  ЭтоСведенияОбОрганизации - Булево
// 
// Возвращаемое значение:
//    Структура:
//     	* ТипАдреса - Структура:
//     		** АдресИнформация - Структура - ключ присутствует только в случае произвольного адреса:
//     			*** КодСтраны - Строка
//     			*** НаименованиеСтраны - Строка
//     			*** АдресТекст - Строка
//     		** АвтоматическиЗаполняемый - Структура - ключ присутствует во всех остальных случаях:
//     			*** ОбъектКонтактнойИнформации - СправочникСсылка - ссылка на физическое или юридическое лицо
//     										   - Неопределено
//     			*** ВидКонтактнойИнформации - СправочникСсылка.ВидыКонтактнойИнформации
Функция ДанныеАдресаУчастникаУПД_5_02(СведенияОбУчастнике, ПриоритетыВидовКонтактнойИнформации, ЭтоСведенияОбОрганизации)
	
	ДанныеАдреса = Новый Структура;
	
	Если СведенияОбУчастнике.Свойство("ПроизвольныйАдрес") Тогда
		СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(СведенияОбУчастнике.ПроизвольныйАдрес);
		
		АдресИнформация = Новый Структура();
		АдресИнформация.Вставить("КодСтраны", СведенияОбАдресе.КодСтраны);
		АдресИнформация.Вставить("НаименованиеСтраны", СведенияОбАдресе.Страна);
		АдресИнформация.Вставить("АдресТекст", СведенияОбАдресе.Представление);
		ДанныеАдреса.Вставить("ТипАдреса", Новый Структура("АдресИнформация", АдресИнформация));
		
		Возврат ДанныеАдреса;
	КонецЕсли;
	
	ВидКонтактнойИнформации = ?(ЭтоСведенияОбОрганизации,
		Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,
		Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
	
	Если ЗначениеЗаполнено(ПриоритетыВидовКонтактнойИнформации) Тогда
		
		Для Каждого ВикКИ Из ПриоритетыВидовКонтактнойИнформации Цикл
			
			Если ЗначениеЗаполнено(СведенияОбУчастнике[ВикКИ]) И ВикКИ = "ПочтовыйАдрес" Тогда
				ВидКонтактнойИнформации = ?(ЭтоСведенияОбОрганизации,
					Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресОрганизации,
					Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресКонтрагента);
					Прервать;
			ИначеЕсли ЗначениеЗаполнено(СведенияОбУчастнике[ВикКИ]) И ВикКИ = "ФактическийАдрес" Тогда
				ВидКонтактнойИнформации = ?(ЭтоСведенияОбОрганизации,
					Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации,
					Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента);
					Прервать;
			ИначеЕсли ЗначениеЗаполнено(СведенияОбУчастнике[ВикКИ]) И ВикКИ = "ЮридическийАдрес" Тогда
				ВидКонтактнойИнформации = ?(ЭтоСведенияОбОрганизации,
					Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,
					Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
					Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли; 
	
	КлючДанных = Неопределено;
	СведенияОбУчастнике.Свойство("Ссылка", КлючДанных);
	АвтоматическиЗаполняемыйАдрес = Новый Структура;
	АвтоматическиЗаполняемыйАдрес.Вставить("ОбъектКонтактнойИнформации", КлючДанных);
	АвтоматическиЗаполняемыйАдрес.Вставить("ВидКонтактнойИнформации", ВидКонтактнойИнформации);
	ДанныеАдреса.Вставить("ТипАдреса", Новый Структура);
	ДанныеАдреса.ТипАдреса.Вставить("АвтоматическиЗаполняемый", АвтоматическиЗаполняемыйАдрес);
	
	Возврат ДанныеАдреса;
	
КонецФункции

// Параметры:
//  ТаблицаУчастников - см. ПолучитьТаблицуУчастниковУПД_5_02
//  ПутьКУчастнику - Строка
//
Процедура ДобавитьОбработкуОшибокВТаблицуУчастниковУПД_5_02(ТаблицаУчастников, ПутьКУчастнику = "")
	
	ПутьКПолю = ?(ЗначениеЗаполнено(ПутьКУчастнику), ПутьКУчастнику + ".", "");
	
	Для каждого СтрокаТаблицы Из ТаблицаУчастников Цикл
		
		Сведения = СтрокаТаблицы.СведенияОбУчастнике;
		Если Не ЗначениеЗаполнено(Сведения) Тогда
			Продолжить;
		КонецЕсли;
		
		Участник = ?(ЗначениеЗаполнено(ПутьКУчастнику), СтрокаТаблицы[ПутьКУчастнику], СтрокаТаблицы);
		ПостфиксПоляАдрес = ?(ТипЗнч(Сведения.Ссылка) = Тип("СправочникСсылка.Контрагенты"), "Контрагента", "Организации");
		
		Если Участник.ТипУчастника.Свойство("ЮЛ") Тогда
			
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ЮЛ.НаименованиеОрганизации", Сведения.Ссылка, "Объект.НаименованиеПолное");
				
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ЮЛ.ИНН", Сведения.Ссылка, "Объект.ИНН");
				
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ЮЛ.КПП", Сведения.Ссылка, "Объект.КПП");
				
		ИначеЕсли Участник.ТипУчастника.Свойство("ИЛ") Тогда
			
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ИЛ.НаименованиеОрганизации", Сведения.Ссылка, "Объект.НаименованиеПолное");
				
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ИЛ.КодСтраны", Сведения.Ссылка, "КонтактнаяИнформацияПолеЮрАдрес" + ПостфиксПоляАдрес);
			
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ИЛ.НаименованиеСтраны", Сведения.Ссылка, "КонтактнаяИнформацияПолеЮрАдрес" + ПостфиксПоляАдрес);
			
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ИЛ.ИдентификаторОрганизацииИлиГражданина", Сведения.Ссылка, "Объект.ИдентификаторЮридическогоЛица");
					
		ИначеЕсли Участник.ТипУчастника.Свойство("ИП") Тогда
			
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ИП.ИНН", Сведения.Ссылка, "Объект.ИНН");
			
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ИП.ФИО.Фамилия", Сведения.Ссылка, "Объект.НаименованиеПолное");
			
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ИП.ФИО.Имя", Сведения.Ссылка, "Объект.НаименованиеПолное");
				
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ИП.ФИО.Отчество", Сведения.Ссылка, "Объект.НаименованиеПолное");	
			
			Если ТипЗнч(Сведения.Ссылка) = Тип("СправочникСсылка.Организации") Тогда
				
				ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
					ПутьКПолю + "ТипУчастника.ИП.СвидетельствоОГосРегистрации", Сведения.Ссылка, "Объект.СвидетельствоСерияНомер");
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
			ПутьКПолю + "Адрес.АвтоматическиЗаполняемый", Сведения.Ссылка, "КонтактнаяИнформацияПолеЮрАдрес" + ПостфиксПоляАдрес);
			
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
			ПутьКПолю + "КонтактныеСведения.Телефон", Сведения.Ссылка);
			
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
			ПутьКПолю + "КонтактныеСведения.ЭлектроннаяПочта", Сведения.Ссылка);
			
		НомерСчета = "";
		Если Сведения.Свойство("НомерСчета", НомерСчета) И ЗначениеЗаполнено(НомерСчета) Тогда
			
			Если Сведения.Свойство("БанковскийСчетСсылка") Тогда
				ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
					ПутьКПолю + "БанковскиеРеквизиты.НомерСчета", Сведения.БанковскийСчетСсылка, "Объект.НомерСчета");
			КонецЕсли;
				
			Банк = ""; БИК = ""; КоррСчет = "";
			Если Сведения.Свойство("Банк", Банк) И ЗначениеЗаполнено(Банк) Тогда
				Если Сведения.Свойство("БанкСсылка") Тогда
					ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
						ПутьКПолю + "БанковскиеРеквизиты.НаименованиеБанка", Сведения.БанкСсылка, "Объект.Наименование");
				КонецЕсли;
			КонецЕсли;
			Если Сведения.Свойство("БИК", БИК) И ЗначениеЗаполнено(БИК) Тогда
				Если Сведения.Свойство("БанкСсылка") Тогда
					ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
						ПутьКПолю + "БанковскиеРеквизиты.БИКБанка", Сведения.БанкСсылка, "Объект.Код");
				КонецЕсли;
			КонецЕсли;
			Если Сведения.Свойство("КоррСчет", КоррСчет) И ЗначениеЗаполнено(КоррСчет) Тогда
				Если Сведения.Свойство("БанкСсылка") Тогда
					ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
						ПутьКПолю + "БанковскиеРеквизиты.КорреспондентскийСчетБанка", Сведения.БанкСсылка, "Объект.КоррСчет");
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		КодПоОКПО = "";
		Если Сведения.Свойство("КодПоОКПО", КодПоОКПО) И ЗначениеЗаполнено(КодПоОКПО) Тогда
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "КодОКПО", Сведения.Ссылка, "Объект.КодПоОКПО");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область УПД2019

Процедура ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ)
	
	СтруктураДанных = Неопределено;
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		СтруктураДанных = Документы.ПоступлениеТоваровУслуг.ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	Иначе
		СтруктураДанных = Документы.РеализацияТоваровУслуг.ПолучитьДанныеДляЭД(СсылкаНаОбъект);		
	КонецЕсли;
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();
	
	Если ВыборкаШапки.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		
		// Обработка ошибки с открытием формы по навигационной ссылке.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерИсправления");
		ИмяФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсправления", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления",
			ВыборкаШапки.НомерИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Дата");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления",
			ВыборкаШапки.ДатаИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента",
			ВыборкаШапки.НомерИсходногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ДатаИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",
			ВыборкаШапки.ДатаИсходногоДокумента, ПараметрыОбработкиОшибок);
		
	Иначе
		// Обработка ошибки с открытием формы по навигационной ссылке.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерЭД");
		ИмяФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект,
			"Объект.НомерЭД", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", ВыборкаШапки.Номер,
			ПараметрыОбработкиОшибок);
			
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.Дата", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",  ВыборкаШапки.Дата,
			ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.ИдентификаторГосКонтракта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ИдентификаторГосКонтракта");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", ВыборкаШапки.ИдентификаторГосКонтракта,
			ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки",
		ВыборкаШапки.ДокументОснование);
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		ЗаполнитьДеревоДанныхУПД0Закупка_2019(СтруктураДанных, СтруктураЭД, ДеревоДанных);		
	Иначе
		ЗаполнитьДеревоДанныхУПД_2019(СтруктураДанных, СтруктураЭД, ДеревоДанных);		
	КонецЕсли;
	
	ЗаполнитьДокументыПодтвержденияОтгрузки(ДеревоДанных, СтруктураДанных);
	
КонецПроцедуры


Процедура НайтиСоздатьУПДДокументОПередаче_2019(ДеревоДанных, СсылкаНаВладельца, Записывать, СпособОбработки, ОписаниеОшибки)
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	ДокументОбъект.НомерЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
	ДокументОбъект.НомерИсправления = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления");
	Если ЗначениеЗаполнено(ДокументОбъект.НомерИсправления) Тогда
		ВидОперации = Перечисления.ВидыОпераций.Исправление;
		
		ДокументОбъект.ДатаЭД  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаИсправления");
		ДокументОбъект.НомерИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "НомерДокумента");
		ДокументОбъект.ДатаИсходногоДокумента  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаДокумента");
	Иначе
		ВидОперации = Перечисления.ВидыОпераций.Реализация;
		
		ДокументОбъект.ДатаЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаДокумента");
	КонецЕсли;
	ДокументОбъект.ВидОперации = ВидОперации;
	
	ДокументОбъект.Валюта = ЭлектронноеВзаимодействие.НайтиСсылку("Валюты",
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод"));
	
	ДокументОбъект.ИдентификаторГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта");
		
	НомерГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.НомерГосКонтракта");
	Если ЗначениеЗаполнено(НомерГосКонтракта) Тогда
		ДокументОбъект.ЭтоГосЗакупка = Истина;
	КонецЕсли;
	
	СведенияОПродавце = ДеревоДанных.Строки.Найти("СведенияОПродавце", "ПолныйПуть");
	СведенияОПокупателе = ДеревоДанных.Строки.Найти("СведенияОПокупателе", "ПолныйПуть");
	Если СведенияОПродавце.Строки.Количество() > 1
		ИЛИ СведенияОПокупателе.Строки.Количество() > 1 Тогда
		ТекстИсключения = СтрШаблон(НСтр("ru = 'Ошибка загрузки электронной товарной накладной %1 от %2.'"), 
			ДокументОбъект.НомерЭД, Формат(ДокументОбъект.ДатаЭД,"ДЛФ=D")) + Символы.ПС
			+ НСтр("ru = 'Загрузка сводных накладных не поддерживается.'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	ОсновнаяСтрокаПродавца = Неопределено;
	Для каждого СтрокаПродавца Из СведенияОПродавце.Строки Цикл
		ДокументОбъект.Контрагент = КонтрагентПоДаннымЭД(СтрокаПродавца, "СведенияОПродавце.НомерСтроки");
		ОсновнаяСтрокаПродавца = СтрокаПродавца;
		Прервать;
	КонецЦикла;
	Для каждого СтрокаПокупателя Из СведенияОПокупателе.Строки Цикл
		ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(СтрокаПокупателя, "СведенияОПокупателе.НомерСтроки");
		Прервать;
	КонецЦикла;
	
	СведенияОГрузоотправителе = ДеревоДанных.Строки.Найти("СведенияОГрузоотправителе", "ПолныйПуть");
	Для каждого СтрокаГрузоотправителя Из СведенияОГрузоотправителе.Строки Цикл
		ГрузоотправительОнЖе = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СтрокаГрузоотправителя, "СведенияОГрузоотправителе.НомерСтроки.ОнЖе");
		Если ГрузоотправительОнЖе = Истина Тогда
			ДокументОбъект.Грузоотправитель = ДокументОбъект.Контрагент;
		Иначе
			ДокументОбъект.Грузоотправитель = КонтрагентПоДаннымЭД(СтрокаГрузоотправителя, "СведенияОГрузоотправителе.НомерСтроки.Грузоотправитель");
		КонецЕсли;
		Прервать;
	КонецЦикла;
	
	СведенияОГрузополучателе = ДеревоДанных.Строки.Найти("СведенияОГрузополучателе", "ПолныйПуть");
	Для каждого СтрокаГрузополучателя Из СведенияОГрузополучателе.Строки Цикл
		ДокументОбъект.Грузополучатель = КонтрагентПоДаннымЭД(СтрокаГрузополучателя, "СведенияОГрузополучателе.НомерСтроки");
		Прервать;
	КонецЦикла;
	
	ДокументОбъект.Перевозчик = КонтрагентПоДаннымЭД(ДеревоДанных, "СведенияОПеревозчике");
	
	ТранспортнаяНакладная = ДеревоДанных.Строки.Найти("ТранспортнаяНакладная", "ПолныйПуть");
	Если ТранспортнаяНакладная <> Неопределено
		И ТранспортнаяНакладная.Строки.Количество() Тогда
		
		ДокументОбъект.НомерТранспортнойНакладной = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ТранспортнаяНакладная.Строки[0], "ТранспортнаяНакладная.НомерСтроки.ТранспортнаяНакладнаяНомер");
		
		ДокументОбъект.ДатаТранспортнойНакладной = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ТранспортнаяНакладная.Строки[0], "ТранспортнаяНакладная.НомерСтроки.ТранспортнаяНакладнаяДата");
		
	КонецЕсли;
	
	ДокументОбъект.СведенияОТранспортировкеИГрузе = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "СведенияОТранспортировке");
	
	// Поиск и заполнение договора контрагента.
	ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеОтгрузкиТоваров", "ПолныйПуть");
	Если ОснованияОтгрузки <> Неопределено Тогда
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументНомер");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				ДоговорДата = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументДата");
				
				СвойстваДоговора = Новый Структура;
				СвойстваДоговора.Вставить("НомерДоговора", ДоговорНомер);
				СвойстваДоговора.Вставить("ДатаДоговора", ДоговорДата);
				СвойстваДоговора.Вставить("Организация", ДокументОбъект.Организация);
				СвойстваДоговора.Вставить("Владелец", ДокументОбъект.Контрагент);
				
				ДоговорКонтрагента = ЭлектронноеВзаимодействие.НайтиСсылку("ДоговорыКонтрагентов",, СвойстваДоговора);
				ДокументОбъект.ДоговорКонтрагента = ДоговорКонтрагента;
				
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	// Поиск и заполнение банковского счета контрагента.
	НомерСчета = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ОсновнаяСтрокаПродавца,
		"СведенияОПродавце.НомерСтроки.БанковскиеРеквизиты.НомерСчета");
	БИКБанка = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ОсновнаяСтрокаПродавца,
		"СведенияОПродавце.НомерСтроки.БанковскиеРеквизиты.БИКБанка");
	ДокументОбъект.БанковскийСчетКонтрагента = БанковскийСчетКонтрагента(
		ДокументОбъект.Контрагент, БИКБанка, НомерСчета, ДокументОбъект.Валюта);
	
	// Сведения об основании.
	ДокументыОснованияДокументаОтгрузки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки");
	Если ЗначениеЗаполнено(ДокументыОснованияДокументаОтгрузки) Тогда
		ДокументОбъект.ДокументОснование = ДокументыОснованияДокументаОтгрузки[0];
	Иначе
		ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
		Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
			Для Каждого СтрокаСФ Из ДокументыОснованияСчетаФактуры Цикл
				Если ТипЗнч(СтрокаСФ) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
					Для Каждого Строка Из СтрокаСФ.ДокументыОснования Цикл
						Если ЗначениеЗаполнено(Строка.ДокументОснование) Тогда
							ДокументОбъект.ДокументОснование = Строка.ДокументОснование;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ЕстьТовары = Ложь;
	ЕстьРаботы = Ложь;
	ЕстьПрава  = Ложь;
	
	ОблагаетсяНДСУПокупателя = Ложь;
	ИспользоватьСопоставлениеНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	
	ДокументОбъект.Товары.Очистить();
	ДокументОбъект.КодыУпаковокМаркируемойПродукции.Очистить();
	
	ТаблицаТоваров = ДокументОбъект.Товары.ВыгрузитьКолонки();
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(ТаблицаТоваров);
	
	ИспользуетсяГосИС = КлиентЭДОВызовСервера.ИспользуетсяГосИС();
	Если ИспользуетсяГосИС Тогда
		// Маркировка
		ШтрихкодыУпаковок = ЭлектронноеВзаимодействиеИСМП.НоваяТаблицаШтрихкодыУпаковок();
	КонецЕсли;
	
	// Сведения таблицы.
	СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
	Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
		
		Признак = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.Признак");
		
		Если Признак = "1" Тогда
			ЕстьТовары = Истина;
		ИначеЕсли Признак = "2" ИЛИ Признак = "3" Тогда
			ЕстьРаботы = Истина;
		ИначеЕсли Признак = "4" Тогда
			ЕстьПрава  = Истина;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		НоваяСтрока.КоличествоУпаковок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.Количество");
		НоваяСтрока.Цена = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмерения");
		НоваяСтрока.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
		НоваяСтрока.СуммаАкциза = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.СуммаАкциза");
		
		Если НоваяСтрока.Цена = 0 И НоваяСтрока.Количество <> 0
			И (Признак = "2" ИЛИ Признак = "3") Тогда
			НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.Количество;
		КонецЕсли;
		
		СтавкаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
		Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
			НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
			ОблагаетсяНДСУПокупателя = Истина;
		Иначе
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаСНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
			НоваяСтрока.СуммаНДС  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СуммаНалога");
		КонецЕсли;
		
		СведенияОТаможеннойДекларации = СведенияОТоваре.Строки.Найти(
			"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации", "ПолныйПуть", Истина);
		
		Если СведенияОТаможеннойДекларации <> Неопределено
			И СведенияОТаможеннойДекларации.Строки.Количество() Тогда
			
			НоваяСтрока.НомерГТД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
				"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.ТаможеннаяДекларацияНомер");
			
			КодСтраны = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
				"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.СтранаПроисхожденияКод");
			
			Если ЗначениеЗаполнено(КодСтраны) Тогда
				НоваяСтрока.СтранаПроисхождения = УправлениеКонтактнойИнформацией.СтранаМираПоКодуИлиНаименованию(КодСтраны);
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрока.ОснованиеОсвобожденияОтНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.ОснованиеОсвобожденияОтНДС");
		
		КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(НоваяСтрока);
		Сопоставление = СведенияОТоваре.Строки.Найти(
			"СведенияОТоварах.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
		Если Сопоставление <> Неопределено Тогда
			
			Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.Сопоставление.Идентификатор");
			Если ЗначениеЗаполнено(Идентификатор) Тогда
				НоваяСтрока.ИдентификаторКонтрагента = Идентификатор;
			КонецЕсли;
			
			Если ИспользоватьСопоставлениеНоменклатуры Тогда
			
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
				КонецЕсли;
				
				Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.ХарактеристикаИБ");
				Если ЗначениеЗаполнено(Характеристика) Тогда
					НоваяСтрока.Характеристика = Характеристика;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
			ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод");
			ЕдиницаИзмеренияНаименование = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияНаименование");
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) И ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
				НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.УпаковкаНоменклатуры(
					НоваяСтрока.Номенклатура, ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
			ИначеЕсли ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
				НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.ЕдиницаИзмеренияПоКоду(
					ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.НаименованиеКонтрагента = ПредставлениеНоменклатурыПоставщика(
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ТоварНаименование"),
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ТоварХарактеристика"));
		
		НоваяСтрока.НаименованиеПоставщика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ТоварНаименование");
		НоваяСтрока.КодТНВЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.КодВидаТовара");
		
		ЗаполнитьСведенияПрослеживаемостиИзДереваЭлектронногоДокумента(ДокументОбъект, НоваяСтрока, СведенияОТоваре);
		
		ЗаполнитьВидДеятельностиРаздельногоУчетаНДС(НоваяСтрока);
		
		РассчитатьКоличествоБазовыхЕдиниц(НоваяСтрока);
		
		Если ИспользуетсяГосИС Тогда
			// Маркировка
			ЭлектронноеВзаимодействиеИСМП.ДобавитьШтрихкодыТаблицуШтрихкодовУпаковок_2019(ШтрихкодыУпаковок, СведенияОТоваре);
		Иначе
			ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокумента_2019(ДокументОбъект, НоваяСтрока, СведенияОТоваре);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИспользуетсяГосИС Тогда
		ЭлектронноеВзаимодействиеИСМП.СвернутьТаблицуШтрихкодовУпаковок(ШтрихкодыУпаковок);
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ШтрихкодыУпаковок);
	КонецЕсли;
	
	СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(ТаблицаТоваров, ДокументОбъект.Контрагент);
	ДокументОбъект.Товары.Загрузить(ТаблицаТоваров);
	
	ДокументОбъект.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;
	
	Если ОблагаетсяНДСУПокупателя Тогда
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоКОплате.ВсегоСтоимостьТоваровБезНалога");
	Иначе
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом");
	КонецЕсли;
	
	Если СпособОбработки = "ВозвратТоваровОтПокупателя" Тогда
		ВидДокумента = Перечисления.ВидыДокументов.НакладнаяНаВозврат;
	ИначеЕсли ЕстьТовары Тогда
		ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная;
	ИначеЕсли ЕстьРаботы Тогда
		ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот;
	ИначеЕсли ЕстьПрава Тогда
		ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав;
	ИначеЕсли СпособОбработки = "АктВыполненныхРабот" Тогда
		ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот;
	ИначеЕсли СпособОбработки = "АктНаПередачуПрав" Тогда	
		ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав;
	Иначе	
		ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная;
	КонецЕсли;
	
	ДокументОбъект.ВидДокумента = ВидДокумента;
	
	РежимЗаписиПроведение = Истина;
	Если ДокументОбъект.ВидОперации <> Перечисления.ВидыОпераций.Реализация Тогда
		РежимЗаписиПроведение = ЗначениеЗаполнено(ДокументОбъект.ДокументОснование);
	КонецЕсли;
	
	Если Записывать Тогда
		ЗаписатьДокумент(ДокументОбъект, РежимЗаписиПроведение);
		СсылкаНаВладельца = ДокументОбъект.Ссылка;
	Иначе // если функция вызвана из формы "Обработки.ИнтерфейсДокументовЭДО.ЗагрузкаПросмотрЭлектронногоДокумента"
		СсылкаНаВладельца = ДокументОбъект;
	КонецЕсли;
	
КонецПроцедуры

Процедура НайтиСоздатьУПД0Закупка_2019(ДеревоДанных, СсылкаНаВладельца, Записывать, СпособОбработки, ОписаниеОшибки)
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	ДокументОбъект.НомерЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
	ДокументОбъект.НомерИсправления = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления");
	Если ЗначениеЗаполнено(ДокументОбъект.НомерИсправления) Тогда
		ВидОперации = Перечисления.ВидыОпераций.Исправление;
		
		ДокументОбъект.ДатаЭД  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаИсправления");
		ДокументОбъект.НомерИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "НомерДокумента");
		ДокументОбъект.ДатаИсходногоДокумента  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаДокумента");
	Иначе
		ВидОперации = Перечисления.ВидыОпераций.Реализация;
		
		ДокументОбъект.ДатаЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаДокумента");
	КонецЕсли;
	ДокументОбъект.ВидОперации = ВидОперации;
	
	ДокументОбъект.Валюта = ЭлектронноеВзаимодействие.НайтиСсылку("Валюты",
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод"));
	
	ДокументОбъект.ИдентификаторГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта");
		
	НомерГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.НомерГосКонтракта");
	Если ЗначениеЗаполнено(НомерГосКонтракта) Тогда
		ДокументОбъект.ЭтоГосЗакупка = Истина;
	КонецЕсли;
	
	СведенияОПродавце = ДеревоДанных.Строки.Найти("СведенияОПродавце", "ПолныйПуть");
	СведенияОПокупателе = ДеревоДанных.Строки.Найти("СведенияОПокупателе", "ПолныйПуть");
	Если СведенияОПродавце.Строки.Количество() > 1
		ИЛИ СведенияОПокупателе.Строки.Количество() > 1 Тогда
		ТекстИсключения = СтрШаблон(НСтр("ru = 'Ошибка загрузки электронной товарной накладной %1 от %2.'"), 
			ДокументОбъект.НомерЭД, Формат(ДокументОбъект.ДатаЭД,"ДЛФ=D")) + Символы.ПС
			+ НСтр("ru = 'Загрузка сводных накладных не поддерживается.'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	ОсновнаяСтрокаПродавца = Неопределено;
	Для каждого СтрокаПродавца Из СведенияОПродавце.Строки Цикл
		ДокументОбъект.Контрагент = КонтрагентПоДаннымЭД(СтрокаПродавца, "СведенияОПродавце.НомерСтроки");
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
			ДокументОбъект.Контрагент = СоздатьКонтрагентаПоДаннымУПД(СтрокаПродавца, "СведенияОПокупателе.НомерСтроки");
		КонецЕсли;
		ОсновнаяСтрокаПродавца = СтрокаПродавца;
		Прервать;
	КонецЦикла;
	
	ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(ДеревоДанных, "СведенияОКомитенте");
	
	СведенияОГрузоотправителе = ДеревоДанных.Строки.Найти("СведенияОГрузоотправителе", "ПолныйПуть");
	Для каждого СтрокаГрузоотправителя Из СведенияОГрузоотправителе.Строки Цикл
		ГрузоотправительОнЖе = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СтрокаГрузоотправителя, "СведенияОГрузоотправителе.НомерСтроки.ОнЖе");
		Если ГрузоотправительОнЖе = Истина Тогда
			ДокументОбъект.Грузоотправитель = ДокументОбъект.Контрагент;
		Иначе
			ДокументОбъект.Грузоотправитель = КонтрагентПоДаннымЭД(СтрокаГрузоотправителя, "СведенияОГрузоотправителе.НомерСтроки.Грузоотправитель");
		КонецЕсли;
		Прервать;
	КонецЦикла;
	
	СведенияОГрузополучателе = ДеревоДанных.Строки.Найти("СведенияОГрузополучателе", "ПолныйПуть");
	Для каждого СтрокаГрузополучателя Из СведенияОГрузополучателе.Строки Цикл
		ДокументОбъект.Грузополучатель = КонтрагентПоДаннымЭД(СтрокаГрузополучателя, "СведенияОГрузополучателе.НомерСтроки");
		Прервать;
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.Грузополучатель) Тогда
		Для каждого СтрокаПокупателя Из СведенияОПокупателе.Строки Цикл
			ДокументОбъект.Грузополучатель = КонтрагентПоДаннымЭД(СтрокаПокупателя, "СведенияОПокупателе.НомерСтроки");
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	ДокументОбъект.Перевозчик = КонтрагентПоДаннымЭД(ДеревоДанных, "СведенияОПеревозчике");
	
	ТранспортнаяНакладная = ДеревоДанных.Строки.Найти("ТранспортнаяНакладная", "ПолныйПуть");
	Если ТранспортнаяНакладная <> Неопределено
		И ТранспортнаяНакладная.Строки.Количество() Тогда
		
		ДокументОбъект.НомерТранспортнойНакладной = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ТранспортнаяНакладная.Строки[0], "ТранспортнаяНакладная.НомерСтроки.ТранспортнаяНакладнаяНомер");
		
		ДокументОбъект.ДатаТранспортнойНакладной = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ТранспортнаяНакладная.Строки[0], "ТранспортнаяНакладная.НомерСтроки.ТранспортнаяНакладнаяДата");
		
	КонецЕсли;
	
	ДокументОбъект.СведенияОТранспортировкеИГрузе = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "СведенияОТранспортировке");
	
	// Поиск и заполнение договора контрагента.
	ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеОтгрузкиТоваров", "ПолныйПуть");
	Если ОснованияОтгрузки <> Неопределено Тогда
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументНомер");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				ДоговорДата = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументДата");
				
				СвойстваДоговора = Новый Структура;
				СвойстваДоговора.Вставить("НомерДоговора", ДоговорНомер);
				СвойстваДоговора.Вставить("ДатаДоговора", ДоговорДата);
				СвойстваДоговора.Вставить("Организация", ДокументОбъект.Организация);
				СвойстваДоговора.Вставить("Владелец", ДокументОбъект.Контрагент);
				
				ДоговорКонтрагента = ЭлектронноеВзаимодействие.НайтиСсылку("ДоговорыКонтрагентов",, СвойстваДоговора);
				ДокументОбъект.ДоговорКонтрагента = ДоговорКонтрагента;
				
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	// Поиск и заполнение банковского счета контрагента.
	НомерСчета = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ОсновнаяСтрокаПродавца,
		"СведенияОПродавце.НомерСтроки.БанковскиеРеквизиты.НомерСчета");
	БИКБанка = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ОсновнаяСтрокаПродавца,
		"СведенияОПродавце.НомерСтроки.БанковскиеРеквизиты.БИКБанка");
	ДокументОбъект.БанковскийСчетКонтрагента = БанковскийСчетКонтрагента(
		ДокументОбъект.Контрагент, БИКБанка, НомерСчета, ДокументОбъект.Валюта);
	
	// Сведения об основании.
	ДокументыОснованияДокументаОтгрузки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки");
	Если ЗначениеЗаполнено(ДокументыОснованияДокументаОтгрузки) Тогда
		ДокументОбъект.ДокументОснование = ДокументыОснованияДокументаОтгрузки[0];
	Иначе
		ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
		Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
			Для Каждого СтрокаСФ Из ДокументыОснованияСчетаФактуры Цикл
				Если ТипЗнч(СтрокаСФ) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
					Для Каждого Строка Из СтрокаСФ.ДокументыОснования Цикл
						Если ЗначениеЗаполнено(Строка.ДокументОснование) Тогда
							ДокументОбъект.ДокументОснование = Строка.ДокументОснование;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ОблагаетсяНДСУПокупателя = Ложь;
	ИспользоватьСопоставлениеНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	
	ДокументОбъект.Товары.Очистить();
	ДокументОбъект.КодыУпаковокМаркируемойПродукции.Очистить();
	
	ТаблицаТоваров = ДокументОбъект.Товары.ВыгрузитьКолонки();
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(ТаблицаТоваров);
	
	ИспользуетсяГосИС = КлиентЭДОВызовСервера.ИспользуетсяГосИС();
	Если ИспользуетсяГосИС Тогда
		// Маркировка
		ШтрихкодыУпаковок = ЭлектронноеВзаимодействиеИСМП.НоваяТаблицаШтрихкодыУпаковок();
	КонецЕсли;
	
	// Сведения таблицы.
	СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
	Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
		
		Признак = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.Признак");
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		НоваяСтрока.КоличествоУпаковок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.Количество");
		НоваяСтрока.Цена = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмерения");
		НоваяСтрока.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
		НоваяСтрока.СуммаАкциза = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.СуммаАкциза");
		
		Если НоваяСтрока.Цена = 0 И НоваяСтрока.Количество <> 0
			И (Признак = "2" ИЛИ Признак = "3") Тогда
			НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.Количество;
		КонецЕсли;
		
		СтавкаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
		Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
			НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
			ОблагаетсяНДСУПокупателя = Истина;
		Иначе
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаСНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
			НоваяСтрока.СуммаНДС  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СуммаНалога");
		КонецЕсли;
		
		СведенияОТаможеннойДекларации = СведенияОТоваре.Строки.Найти(
			"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации", "ПолныйПуть", Истина);
		
		Если СведенияОТаможеннойДекларации <> Неопределено
			И СведенияОТаможеннойДекларации.Строки.Количество() Тогда
			
			НоваяСтрока.НомерГТД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
				"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.ТаможеннаяДекларацияНомер");
			
			КодСтраны = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
				"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.СтранаПроисхожденияКод");
			
			Если ЗначениеЗаполнено(КодСтраны) Тогда
				НоваяСтрока.СтранаПроисхождения = УправлениеКонтактнойИнформацией.СтранаМираПоКодуИлиНаименованию(КодСтраны);
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрока.ОснованиеОсвобожденияОтНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.ОснованиеОсвобожденияОтНДС");
		
		КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(НоваяСтрока);
		
		Сопоставление = СведенияОТоваре.Строки.Найти(
			"СведенияОТоварах.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
		Если Сопоставление <> Неопределено Тогда
			
			Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.Сопоставление.Идентификатор");
			Если ЗначениеЗаполнено(Идентификатор) Тогда
				НоваяСтрока.ИдентификаторКонтрагента = Идентификатор;
			КонецЕсли;
			
			Если ИспользоватьСопоставлениеНоменклатуры Тогда
			
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
				КонецЕсли;
				
				Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.ХарактеристикаИБ");
				Если ЗначениеЗаполнено(Характеристика) Тогда
					НоваяСтрока.Характеристика = Характеристика;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
			ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод");
			ЕдиницаИзмеренияНаименование = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияНаименование");
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
				НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.УпаковкаНоменклатуры(
					НоваяСтрока.Номенклатура, ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.НаименованиеКонтрагента = ПредставлениеНоменклатурыПоставщика(
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ТоварНаименование"),
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ТоварХарактеристика"));
		
		НоваяСтрока.НаименованиеПоставщика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ТоварНаименование");
		НоваяСтрока.КодТНВЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.КодВидаТовара");
		
		ЗаполнитьСведенияПрослеживаемостиИзДереваЭлектронногоДокумента(ДокументОбъект, НоваяСтрока, СведенияОТоваре);
		
		ЗаполнитьВидДеятельностиРаздельногоУчетаНДС(НоваяСтрока);
		
		РассчитатьКоличествоБазовыхЕдиниц(НоваяСтрока);
		
		Если ИспользуетсяГосИС Тогда
			ЭлектронноеВзаимодействиеИСМП.ДобавитьШтрихкодыТаблицуШтрихкодовУпаковок_2019(ШтрихкодыУпаковок, СведенияОТоваре);
		Иначе
			ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокумента_2019(ДокументОбъект, НоваяСтрока, СведенияОТоваре);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИспользуетсяГосИС Тогда
		ЭлектронноеВзаимодействиеИСМП.СвернутьТаблицуШтрихкодовУпаковок(ШтрихкодыУпаковок);
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ШтрихкодыУпаковок);
	КонецЕсли;
	
	СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(ТаблицаТоваров, ДокументОбъект.Контрагент);
	ДокументОбъект.Товары.Загрузить(ТаблицаТоваров);
	
	ДокументОбъект.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;
	
	Если ОблагаетсяНДСУПокупателя Тогда
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоКОплате.ВсегоСтоимостьТоваровБезНалога");
	Иначе
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом");
	КонецЕсли;
	
	ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.СведенияКомиссионера;
	
	РежимЗаписиПроведение = Истина;
	Если ДокументОбъект.ВидОперации <> Перечисления.ВидыОпераций.Реализация Тогда
		РежимЗаписиПроведение = ЗначениеЗаполнено(ДокументОбъект.ДокументОснование);
	КонецЕсли;
	
	Если Записывать Тогда
		ЗаписатьДокумент(ДокументОбъект, РежимЗаписиПроведение);
		СсылкаНаВладельца = ДокументОбъект.Ссылка;
	Иначе // если функция вызвана из формы "Обработки.ИнтерфейсДокументовЭДО.ЗагрузкаПросмотрЭлектронногоДокумента"
		СсылкаНаВладельца = ДокументОбъект;
	КонецЕсли;
	
КонецПроцедуры

Процедура НайтиСоздатьУПД0Реализация_2019(ДеревоДанных, СсылкаНаВладельца, Записывать, СпособОбработки, ОписаниеОшибки)
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	ДокументОбъект.НомерЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
	ДокументОбъект.НомерИсправления = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления");
	Если ЗначениеЗаполнено(ДокументОбъект.НомерИсправления) Тогда
		ВидОперации = Перечисления.ВидыОпераций.Исправление;
		
		ДокументОбъект.НомерИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "НомерИсходногоДокумента");
		ДокументОбъект.ДатаИсходногоДокумента  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаИсходногоДокумента");
	Иначе
		ВидОперации = Перечисления.ВидыОпераций.Реализация;
		ДокументОбъект.ДатаЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаДокумента");
	КонецЕсли;
	ДокументОбъект.ВидОперации = ВидОперации;
	
	ДокументОбъект.Валюта = ЭлектронноеВзаимодействие.НайтиСсылку("Валюты",
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод"));
	
	ДокументОбъект.ИдентификаторГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта");
		
	НомерГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.НомерГосКонтракта");
	Если ЗначениеЗаполнено(НомерГосКонтракта) Тогда
		ДокументОбъект.ГосЗакупкаНомерКонтракта = Истина;
	КонецЕсли;
	
	СведенияОПродавце = ДеревоДанных.Строки.Найти("СведенияОПродавце", "ПолныйПуть");
	СведенияОПокупателе = ДеревоДанных.Строки.Найти("СведенияОПокупателе", "ПолныйПуть");
	Если СведенияОПродавце.Строки.Количество() > 1
		ИЛИ СведенияОПокупателе.Строки.Количество() > 1 Тогда
		ТекстИсключения = СтрШаблон(НСтр("ru = 'Ошибка загрузки электронной товарной накладной %1 от %2.'"), 
			ДокументОбъект.НомерЭД, Формат(ДокументОбъект.ДатаЭД,"ДЛФ=D")) + Символы.ПС
			+ НСтр("ru = 'Загрузка сводных накладных не поддерживается.'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(ДеревоДанных, "СведенияОКомитенте");
	
	ОсновнаяСтрокаПродавца = Неопределено;
	Для каждого СтрокаПродавца Из СведенияОПродавце.Строки Цикл
		ОсновнаяСтрокаПродавца = СтрокаПродавца;
		Прервать;
	КонецЦикла;
	
	Для каждого СтрокаПокупателя Из СведенияОПокупателе.Строки Цикл
		ДокументОбъект.Контрагент = КонтрагентПоДаннымЭД(СтрокаПокупателя, "СведенияОПокупателе.НомерСтроки");
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
			ДокументОбъект.Контрагент = СоздатьКонтрагентаПоДаннымУПД(СтрокаПокупателя, "СведенияОПокупателе.НомерСтроки");
		КонецЕсли;
		Прервать;
	КонецЦикла;
	
	
	СведенияОГрузоотправителе = ДеревоДанных.Строки.Найти("СведенияОГрузоотправителе", "ПолныйПуть");
	Для каждого СтрокаГрузоотправителя Из СведенияОГрузоотправителе.Строки Цикл
		ДокументОбъект.Грузоотправитель = КонтрагентПоДаннымЭД(СтрокаГрузоотправителя, "СведенияОГрузоотправителе.НомерСтроки.Грузоотправитель");
		Прервать;
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.Грузоотправитель) Тогда
		ДокументОбъект.Грузоотправитель = КонтрагентПоДаннымЭД(ОсновнаяСтрокаПродавца, "СведенияОПродавце.НомерСтроки");
	КонецЕсли;
	
	СведенияОГрузополучателе = ДеревоДанных.Строки.Найти("СведенияОГрузополучателе", "ПолныйПуть");
	Для каждого СтрокаГрузополучателя Из СведенияОГрузополучателе.Строки Цикл
		ДокументОбъект.Грузополучатель = КонтрагентПоДаннымЭД(СтрокаГрузополучателя, "СведенияОГрузополучателе.НомерСтроки");
		Прервать;
	КонецЦикла;
	
	ДокументОбъект.Перевозчик = КонтрагентПоДаннымЭД(ДеревоДанных, "СведенияОПеревозчике");
	
	ТранспортнаяНакладная = ДеревоДанных.Строки.Найти("ТранспортнаяНакладная", "ПолныйПуть");
	Если ТранспортнаяНакладная <> Неопределено
		И ТранспортнаяНакладная.Строки.Количество() Тогда
		
		ДокументОбъект.НомерТранспортнойНакладной = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ТранспортнаяНакладная.Строки[0], "ТранспортнаяНакладная.НомерСтроки.ТранспортнаяНакладнаяНомер");
		
		ДокументОбъект.ДатаТранспортнойНакладной = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ТранспортнаяНакладная.Строки[0], "ТранспортнаяНакладная.НомерСтроки.ТранспортнаяНакладнаяДата");
		
	КонецЕсли;
	
	ДокументОбъект.СведенияОТранспортировкеИГрузе = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "СведенияОТранспортировке");
	
	// Поиск и заполнение договора контрагента.
	ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеОтгрузкиТоваров", "ПолныйПуть");
	Если ОснованияОтгрузки <> Неопределено Тогда
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументНомер");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				ДоговорДата = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументДата");
				
				СвойстваДоговора = Новый Структура;
				СвойстваДоговора.Вставить("НомерДоговора", ДоговорНомер);
				СвойстваДоговора.Вставить("ДатаДоговора", ДоговорДата);
				СвойстваДоговора.Вставить("Организация", ДокументОбъект.Организация);
				СвойстваДоговора.Вставить("Владелец", ДокументОбъект.Контрагент);
				
				ДоговорКонтрагента = ЭлектронноеВзаимодействие.НайтиСсылку("ДоговорыКонтрагентов",, СвойстваДоговора);
				ДокументОбъект.ДоговорКонтрагента = ДоговорКонтрагента;
				
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	// Поиск и заполнение банковского счета контрагента.
	НомерСчета = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ОсновнаяСтрокаПродавца,
		"СведенияОПродавце.НомерСтроки.БанковскиеРеквизиты.НомерСчета");
	БИКБанка = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ОсновнаяСтрокаПродавца,
		"СведенияОПродавце.НомерСтроки.БанковскиеРеквизиты.БИКБанка");
	
	ОблагаетсяНДСУПокупателя = Ложь;
	ИспользоватьСопоставлениеНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	
	ДокументОбъект.Товары.Очистить();
	ДокументОбъект.КодыУпаковокМаркируемойПродукции.Очистить();
	
	ТаблицаТоваров = ДокументОбъект.Товары.ВыгрузитьКолонки();
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(ТаблицаТоваров);
	
	ИспользуетсяГосИС = КлиентЭДОВызовСервера.ИспользуетсяГосИС();
	Если ИспользуетсяГосИС Тогда
		// Маркировка
		ШтрихкодыУпаковок = ЭлектронноеВзаимодействиеИСМП.НоваяТаблицаШтрихкодыУпаковок();
	КонецЕсли;
	
	// Сведения таблицы.
	СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
	Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
		
		Признак = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.Признак");
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		НоваяСтрока.Содержание = ПредставлениеНоменклатурыПоставщика(
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ТоварНаименование"),
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ТоварХарактеристика"));
		
		НоваяСтрока.КоличествоУпаковок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.Количество");
		НоваяСтрока.Цена = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмерения");
		НоваяСтрока.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
		НоваяСтрока.СуммаАкциза = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.СуммаАкциза");
		
		Если НоваяСтрока.Цена = 0 И НоваяСтрока.Количество <> 0
			И (Признак = "2" ИЛИ Признак = "3") Тогда
			НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.Количество;
		КонецЕсли;
		
		СтавкаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
		Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
			НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
			ОблагаетсяНДСУПокупателя = Истина;
		Иначе
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаСНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
			НоваяСтрока.СуммаНДС  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СуммаНалога");
		КонецЕсли;
		
		СведенияОТаможеннойДекларации = СведенияОТоваре.Строки.Найти(
			"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации", "ПолныйПуть", Истина);
		
		Если СведенияОТаможеннойДекларации <> Неопределено
			И СведенияОТаможеннойДекларации.Строки.Количество() Тогда
			
			НоваяСтрока.НомерГТД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
				"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.ТаможеннаяДекларацияНомер");
			
			КодСтраны = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
				"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.СтранаПроисхожденияКод");
			
			Если ЗначениеЗаполнено(КодСтраны) Тогда
				НоваяСтрока.СтранаПроисхождения = УправлениеКонтактнойИнформацией.СтранаМираПоКодуИлиНаименованию(КодСтраны);
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрока.ОснованиеОсвобожденияОтНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.ОснованиеОсвобожденияОтНДС");
		
		КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(НоваяСтрока);
		
		Если ИспользоватьСопоставлениеНоменклатуры Тогда
			
			Сопоставление = СведенияОТоваре.Строки.Найти(
				"СведенияОТоварах.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
			Если Сопоставление <> Неопределено Тогда
			
				Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.Идентификатор");
				Если ЗначениеЗаполнено(Идентификатор) Тогда
					НоваяСтрока.ИдентификаторКонтрагента = Идентификатор;
				КонецЕсли;
			
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
				КонецЕсли;
				
				Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.ХарактеристикаИБ");
				Если ЗначениеЗаполнено(Характеристика) Тогда
					НоваяСтрока.Характеристика = Характеристика;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
			ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод");
			ЕдиницаИзмеренияНаименование = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияНаименование");
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
				Если ИспользоватьСопоставлениеНоменклатуры Тогда
					НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.УпаковкаНоменклатуры(
						НоваяСтрока.Номенклатура, ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
				Иначе
					НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.ЕдиницаИзмеренияПоКоду(
						ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.КодТНВЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.КодВидаТовара");
		
		ЗаполнитьСведенияПрослеживаемостиИзДереваЭлектронногоДокумента(ДокументОбъект, НоваяСтрока, СведенияОТоваре);
		
		РассчитатьКоличествоБазовыхЕдиниц(НоваяСтрока);
		
		Если ИспользуетсяГосИС Тогда
			ЭлектронноеВзаимодействиеИСМП.ДобавитьШтрихкодыТаблицуШтрихкодовУпаковок_2019(ШтрихкодыУпаковок, СведенияОТоваре);
		Иначе
			ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокумента_2019(ДокументОбъект, НоваяСтрока, СведенияОТоваре);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИспользуетсяГосИС Тогда
		ЭлектронноеВзаимодействиеИСМП.СвернутьТаблицуШтрихкодовУпаковок(ШтрихкодыУпаковок);
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ШтрихкодыУпаковок);
	КонецЕсли;
	
	Если ИспользоватьСопоставлениеНоменклатуры Тогда
		СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(
			ТаблицаТоваров, ДокументОбъект.Контрагент);
	КонецЕсли;
	
	ДокументОбъект.Товары.Загрузить(ТаблицаТоваров);
	
	ДокументОбъект.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;
	
	Если ОблагаетсяНДСУПокупателя Тогда
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоКОплате.ВсегоСтоимостьТоваровБезНалога");
	Иначе
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом");
	КонецЕсли;
	
	ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.СведенияКомиссионера;
	РежимЗаписиПроведение = Истина;
	
	Если Записывать Тогда
		ЗаписатьДокумент(ДокументОбъект, РежимЗаписиПроведение);
		СсылкаНаВладельца = ДокументОбъект.Ссылка;
	Иначе // если функция вызвана из формы "Обработки.ИнтерфейсДокументовЭДО.ЗагрузкаПросмотрЭлектронногоДокумента"
		СсылкаНаВладельца = ДокументОбъект;
	КонецЕсли;
	
КонецПроцедуры

Процедура НайтиСоздатьУПДСчетФактуру_2019(ДеревоДанных, СсылкаНаВладельца = Неопределено, СпособОбработки = "", ОписаниеОшибки = "")
	
	ТекущаяДатаСеанса = ТекущаяДатаСеанса();
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.СчетФактураПолученный.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса;
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	ВидСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры");
	Если ВидСчетаФактуры = "Авансовый" Тогда
		ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс;
	Иначе
		ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.СчетФактура;
	КонецЕсли;
	
	ДокументОбъект.НомерЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
	ДокументОбъект.НомерИсправления = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления");
	Если ЗначениеЗаполнено(ДокументОбъект.НомерИсправления) Тогда
		ВидОперации = Перечисления.ВидыОпераций.Исправление;
		
		ДокументОбъект.ДатаЭД  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаИсправления");
		ДокументОбъект.НомерИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "НомерДокумента");
		ДокументОбъект.ДатаИсходногоДокумента  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаДокумента");
	Иначе
		ВидОперации = Перечисления.ВидыОпераций.Реализация;
		
		ДокументОбъект.ДатаЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаДокумента");
	КонецЕсли;
	ДокументОбъект.ВидОперации = ВидОперации;
	
	ДокументОбъект.Валюта = ЭлектронноеВзаимодействие.НайтиСсылку("Валюты",
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод"));
	
	ДокументОбъект.ИдентификаторГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта");
		
	СведенияОПродавце = ДеревоДанных.Строки.Найти("СведенияОПродавце", "ПолныйПуть");
	СведенияОПокупателе = ДеревоДанных.Строки.Найти("СведенияОПокупателе", "ПолныйПуть");
	Если СведенияОПродавце.Строки.Количество() > 1
		ИЛИ СведенияОПокупателе.Строки.Количество() > 1 Тогда
		ОписаниеОшибки = СтрШаблон(НСтр("ru = 'Ошибка загрузки электронного счета-фактуры %1 от %2.'"), 
			ДокументОбъект.НомерЭД, Формат(ДокументОбъект.ДатаЭД,"ДЛФ=D")) + Символы.ПС
			+ НСтр("ru = 'Загрузка сводных счетов-фактур не поддерживается.'");
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаПродавца Из СведенияОПродавце.Строки Цикл
		ДокументОбъект.Контрагент = КонтрагентПоДаннымЭД(СтрокаПродавца, "СведенияОПродавце.НомерСтроки");
		Прервать;
	КонецЦикла;
	Для каждого СтрокаПокупателя Из СведенияОПокупателе.Строки Цикл
		ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(СтрокаПокупателя, "СведенияОПокупателе.НомерСтроки");
		Прервать;
	КонецЦикла;
	
	ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеОтгрузкиТоваров", "ПолныйПуть");
	Если ОснованияОтгрузки <> Неопределено Тогда
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументНомер");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				ДоговорДата = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументДата");
				
				СвойстваДоговора = Новый Структура;
				СвойстваДоговора.Вставить("НомерДоговора", ДоговорНомер);
				СвойстваДоговора.Вставить("ДатаДоговора", ДоговорДата);
				СвойстваДоговора.Вставить("Организация", ДокументОбъект.Организация);
				СвойстваДоговора.Вставить("Владелец", ДокументОбъект.Контрагент);
				
				ДоговорКонтрагента = ЭлектронноеВзаимодействие.НайтиСсылку("ДоговорыКонтрагентов",, СвойстваДоговора);
				ДокументОбъект.ДоговорКонтрагента = ДоговорКонтрагента;
				
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	ДокументОбъект.ДокументыОснования.Очистить();
	ДокументыОснованияСчетаФактуры = 
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
	Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		МетаданныеТабличнаяЧасть = Метаданные.Документы.СчетФактураПолученный.ТабличныеЧасти.ДокументыОснования;
		ТипыДокументовОснований = МетаданныеТабличнаяЧасть.Реквизиты.ДокументОснование.Тип.Типы();
		Для Каждого ДокументОснования Из ДокументыОснованияСчетаФактуры Цикл
			Если ТипЗнч(ДокументОснования) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				ДокументОбъект.СчетФактураОснование = ДокументОснования;
			Иначе
				ТипДокументаОснования = ТипЗнч(ДокументОснования);
				Если ТипыДокументовОснований.Найти(ТипДокументаОснования) <> Неопределено Тогда
					СтрокаТаблицы = ДокументОбъект.ДокументыОснования.Добавить();
					СтрокаТаблицы.ДокументОснование = ДокументОснования;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ОблагаетсяНДСУПокупателя = Ложь;
	ИспользоватьСопоставлениеНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	
	ДокументОбъект.Товары.Очистить();
	Если ДокументОбъект.ДокументыОснования.Количество() = 0 Тогда
		
		ТаблицаТоваров = ДокументОбъект.Товары.ВыгрузитьКолонки();
		
		СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(ТаблицаТоваров);
		
		// Сведения таблицы.
		СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
		Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
			
			НоваяСтрока = ТаблицаТоваров.Добавить();
		
			НоваяСтрока.КоличествоУпаковок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.Количество");
			НоваяСтрока.Цена = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмерения");
			НоваяСтрока.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
			НоваяСтрока.СуммаАкциза = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СуммаАкциза");
			
			Признак = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.Признак");
			
			Если НоваяСтрока.Цена = 0 И НоваяСтрока.Количество <> 0
				И (Признак = "2" ИЛИ Признак = "3") Тогда
				НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.Количество;
			КонецЕсли;
			
			СтавкаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
			Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
				НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
				ОблагаетсяНДСУПокупателя = Истина;
			Иначе
				НоваяСтрока.СтавкаНДС = СтавкаНДС;
				НоваяСтрока.СуммаСНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
				НоваяСтрока.СуммаНДС  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.СуммаНалога");
			КонецЕсли;
			
			СведенияОТаможеннойДекларации = СведенияОТоваре.Строки.Найти(
				"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации", "ПолныйПуть", Истина);
			
			Если СведенияОТаможеннойДекларации <> Неопределено
				И СведенияОТаможеннойДекларации.Строки.Количество() Тогда
				
				НоваяСтрока.НомерГТД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
					"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.ТаможеннаяДекларацияНомер");
				
				КодСтраны = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
					"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.СтранаПроисхожденияКод");
				
				Если ЗначениеЗаполнено(КодСтраны) Тогда
					НоваяСтрока.СтранаПроисхождения = УправлениеКонтактнойИнформацией.СтранаМираПоКодуИлиНаименованию(КодСтраны);
				КонецЕсли;
				
			КонецЕсли;
			
			НоваяСтрока.ОснованиеОсвобожденияОтНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.ОснованиеОсвобожденияОтНДС");
			
			КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(НоваяСтрока);
			ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокумента(ДокументОбъект, НоваяСтрока, СведенияОТоваре);
			
			Сопоставление = СведенияОТоваре.Строки.Найти(
			"СведенияОТоварах.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
			Если Сопоставление <> Неопределено Тогда
				
				Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.Идентификатор");
				Если ЗначениеЗаполнено(Идентификатор) Тогда
					НоваяСтрока.ИдентификаторКонтрагента = Идентификатор;
				КонецЕсли;
				
				Если ИспользоватьСопоставлениеНоменклатуры Тогда
					
					Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
					Если ЗначениеЗаполнено(Номенклатура) Тогда
						НоваяСтрока.Номенклатура = Номенклатура;
					КонецЕсли;
					
					Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.ХарактеристикаИБ");
					Если ЗначениеЗаполнено(Характеристика) Тогда
						НоваяСтрока.Характеристика = Характеристика;
					КонецЕсли;
					
					ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.УпаковкаИБ");
					Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
						НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
				ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод");
				ЕдиницаИзмеренияНаименование = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияНаименование");
				Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
					НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.УпаковкаНоменклатуры(
						НоваяСтрока.Номенклатура, ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока.НаименованиеКонтрагента = ПредставлениеНоменклатурыПоставщика(
				ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ТоварНаименование"),
				ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ТоварХарактеристика"));
			НоваяСтрока.НаименованиеПоставщика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ТоварНаименование");
			НоваяСтрока.КодТНВЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.КодВидаТовара");
			
			РассчитатьКоличествоБазовыхЕдиниц(НоваяСтрока);
		КонецЦикла;
		
		СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(ТаблицаТоваров, ДокументОбъект.Контрагент);
		
		ДокументОбъект.Товары.Загрузить(ТаблицаТоваров);
		
	Иначе
		
		ОблагаетсяНДСУПокупателя = ДеревоДанных.Строки.Найти("НДС исчисляется налоговым агентом", "Значение", Истина) <> Неопределено;
		
	КонецЕсли;
	
	ДокументОбъект.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;
	
	Если ОблагаетсяНДСУПокупателя Тогда
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоКОплате.ВсегоСтоимостьТоваровБезНалога");
	Иначе
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом");
	КонецЕсли;
	
	ДокументОбъект.ПлатежноРасчетныеДокументы.Очистить();
	ПлатежноРасчетныеДокументы = ДеревоДанных.Строки.Найти("ПлатежноРасчетныеДокументы", "ПолныйПуть");
	Если ПлатежноРасчетныеДокументы <> Неопределено Тогда
		Для Каждого СтрокаПРД Из ПлатежноРасчетныеДокументы.Строки Цикл
			НомерПРД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаПРД,
				"ПлатежноРасчетныеДокументы.НомерСтроки.НомерПРД");
			ДатаПРД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаПРД,
				"ПлатежноРасчетныеДокументы.НомерСтроки.ДатаПРД");
			
			Если ЗначениеЗаполнено(НомерПРД) И ЗначениеЗаполнено(ДатаПРД) Тогда
				НоваяСтрока = ДокументОбъект.ПлатежноРасчетныеДокументы.Добавить();
				НоваяСтрока.НомерПлатежноРасчетногоДокумента = НомерПРД;
				НоваяСтрока.ДатаПлатежноРасчетногоДокумента  = ДатаПРД;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	РежимЗаписиПроведение = Истина;
	Если ДокументОбъект.ВидОперации <> Перечисления.ВидыОпераций.Реализация Тогда
		РежимЗаписиПроведение = ЗначениеЗаполнено(ДокументОбъект.СчетФактураОснование);
	КонецЕсли;
	
	ЗаписатьДокумент(ДокументОбъект, РежимЗаписиПроведение);
	СсылкаНаВладельца = ДокументОбъект.Ссылка;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ)
	
	СтруктураДанных = Документы.СчетФактураВыданный.ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();
	
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс Тогда
		СтруктураЭД.Функция = "СЧФ";
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СсылкаСчетаФактуры", СсылкаНаОбъект);
	
	Если ВыборкаШапки.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		
		// Обработка ошибки с открытием формы по навигационной ссылке.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерИсправления");
		ИмяФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсправления", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления",
			ВыборкаШапки.НомерИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Дата");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления",
			ВыборкаШапки.ДатаИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента",
			ВыборкаШапки.НомерИсходногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ДатаИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",
			ВыборкаШапки.ДатаИсходногоДокумента, ПараметрыОбработкиОшибок);
		
	Иначе
		// Обработка ошибки с открытием формы по навигационной ссылке.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерЭД");
		ИмяФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект,
			"Объект.НомерЭД", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", ВыборкаШапки.Номер,
			ПараметрыОбработкиОшибок);
			
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.Дата", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",  ВыборкаШапки.Дата,
			ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.ИдентификаторГосКонтракта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ИдентификаторГосКонтракта");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", ВыборкаШапки.ИдентификаторГосКонтракта,
			ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	ОбстоятельстваФормированияСФ = "";
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс Тогда
		ВидСчетаФактуры = "Авансовый";
		ОбстоятельстваФормированияСФ = "2";
	Иначе
		ВидСчетаФактуры = "Реализация";
		ОбстоятельстваФормированияСФ = "1";
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДополнительныеСведенияОбУчастниках.ОбстоятельстваФормированияСФ", ОбстоятельстваФормированияСФ);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры", ВидСчетаФактуры);
	
	МассивОснований = Новый Массив;
	Если СтруктураДанных.Свойство("ВыборкаОснований") Тогда
		
		ВыборкаОснований = СтруктураДанных.ВыборкаОснований;
		Пока ВыборкаОснований.Следующий() Цикл
			МассивОснований.Добавить(ВыборкаОснований.ДокументОснование);
		КонецЦикла;
		
		СтруктураДанныхОснований = Документы[МассивОснований[0].Метаданные().Имя].ПолучитьДанныеДляЭД(МассивОснований);
		Если СтруктураДанныхОснований.ВыборкаШапки.Следующий() Тогда
			ЗаполнитьДеревоДанныхУПД_2019(СтруктураДанныхОснований, СтруктураЭД, ДеревоДанных);
		КонецЕсли;
		
	Иначе
		ЗаполнитьДеревоДанныхУПД_2019(СтруктураДанных, СтруктураЭД, ДеревоДанных);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.СчетФактураОснование) Тогда
		МассивОснований.Добавить(ВыборкаШапки.СчетФактураОснование);
	КонецЕсли;
	
	ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		СсылкаНаОбъект, "Объект.СчетФактураОснование");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры",
		МассивОснований, ПараметрыОбработкиОшибок);
	
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактура Тогда
		ЗаполнитьДокументыПодтвержденияОтгрузки(ДеревоДанных, СтруктураДанных);
	КонецЕсли;
	
	Если СтруктураДанных.Свойство("ВыборкаПРД") Тогда
		
		ПлатежныеДокументы = Новый ТаблицаЗначений;
		ПлатежныеДокументы.Колонки.Добавить("НомерСтроки");
		ПлатежныеДокументы.Колонки.Добавить("НомерПРД");
		ПлатежныеДокументы.Колонки.Добавить("ДатаПРД");
		ПлатежныеДокументы.Колонки.Добавить("Сумма");
		
		ВыборкаПРД = СтруктураДанных.ВыборкаПРД;
		Пока ВыборкаПРД.Следующий() Цикл
			НоваяСтрока = ПлатежныеДокументы.Добавить();
			НоваяСтрока.НомерСтроки = ВыборкаПРД.НомерСтроки;
			НоваяСтрока.НомерПРД    = ВыборкаПРД.НомерПлатежноРасчетногоДокумента;
			НоваяСтрока.ДатаПРД     = ВыборкаПРД.ДатаПлатежноРасчетногоДокумента;
			НоваяСтрока.Сумма = ВыборкаПРД.Сумма;
		КонецЦикла;
		
		// Дополним таблицу платежных документов параметрами обработки ошибок.
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ПлатежныеДокументы,
			"НомерПРД", СсылкаНаОбъект, "Объект.ПлатежноРасчетныеДокументы.НомерПлатежноРасчетногоДокумента",, "НомерСтроки");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ПлатежныеДокументы,
			"ДатаПРД", СсылкаНаОбъект, "Объект.ПлатежноРасчетныеДокументы.ДатаПлатежноРасчетногоДокумента",, "НомерСтроки");
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ПлатежныеДокументы, "ПлатежноРасчетныеДокументы");
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет документы подтверждения отгрузки в дереве электронного документа.
//
// Параметры:
//  ДеревоДанных - ДеревоЗначений - дерево электронного документа.
//  СтруктураДанных - Структура - возвращается методом ПолучитьДанныеДляЭД учетного документа.
//
Процедура ЗаполнитьДокументыПодтвержденияОтгрузки(ДеревоДанных, СтруктураДанных)
	
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ДокументыОбОтгрузке = Новый Массив;
	
	ДокументыПодтвержденияОтгрузки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
		ДеревоДанных, "ДокументыПодтвержденияОтгрузки");
	ВыборкаДокументов = СтруктураДанных.ВыборкаДокументовПодтвержденияОтгрузки;
	Пока ВыборкаДокументов.Следующий() Цикл
		СтрокаДокумента = ДокументыПодтвержденияОтгрузки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, ВыборкаДокументов);
		ПредставлениеДокумента = ПредставлениеДокументаОбОтгрузке(ВыборкаДокументов.НомераСтрок,
			ВыборкаДокументов.Номер, ВыборкаДокументов.Дата);
		ДокументыОбОтгрузке.Добавить(ПредставлениеДокумента);
	КонецЦикла;
	
	ДатаПостановления1096 = Дата(2024,10,1);
	Если ДокументыПодтвержденияОтгрузки.Количество() = 0 Тогда
		Если ВыборкаШапки.Дата < ДатаПостановления1096 Тогда
			СтрокаДокумента = ДокументыПодтвержденияОтгрузки.Добавить();
			СтрокаДокумента.Номер = ВыборкаШапки.Номер;
			СтрокаДокумента.Дата = НачалоДня(ВыборкаШапки.Дата);
			СтрокаДокумента.Наименование = Строка(ВыборкаШапки.ВидДокумента);
			
			КоличествоСтрок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОТоварах");
			НомераСтрок = "1";
			Если КоличествоСтрок > 1 Тогда
				НомераСтрок = НомераСтрок + "-" + КоличествоСтрок;
			КонецЕсли;
			ПредставлениеДокумента = ПредставлениеДокументаОбОтгрузке(НомераСтрок,
				СтрокаДокумента.Номер, СтрокаДокумента.Дата);
			ДокументыОбОтгрузке.Добавить(ПредставлениеДокумента); 
		Иначе
			ИспользуемУПД = ОбменСКонтрагентами.ИспользованиеУниверсальногоПередаточногоДокумента(
				ВыборкаШапки.Организация, ВыборкаШапки.Контрагент, ВыборкаШапки.ДоговорКонтрагента);
			Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактура
				И СтруктураДанных.Свойство("ВыборкаОснований") Тогда
					
				ВыборкаОснований = СтруктураДанных.ВыборкаОснований;
				ВыборкаОснований.Сбросить();
				Пока ВыборкаОснований.Следующий() Цикл
					ДокументОснование = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаОснований.ДокументОснование,
						"Номер, Дата, ВидДокумента");
					СтрокаДокумента = ДокументыПодтвержденияОтгрузки.Добавить();
					Если ИспользуемУПД Тогда
						СтрокаДокумента.Номер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(
							ВыборкаШапки.Номер, Истина, Истина);
						СтрокаДокумента.Дата = НачалоДня(ВыборкаШапки.Дата);
						СтрокаДокумента.Наименование = НСтр("ru = 'Универсальный передаточный документ'");
						Прервать;
					Иначе
						СтрокаДокумента.Номер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(
							ДокументОснование.Номер, Истина, Истина);
						СтрокаДокумента.Дата = НачалоДня(ДокументОснование.Дата);
						СтрокаДокумента.Наименование = Строка(ДокументОснование.ВидДокумента);
					КонецЕсли;
					ПредставлениеДокумента = СтрШаблон("%1 № %2 от %3", 
						СтрокаДокумента.Наименование,
						СтрокаДокумента.Номер,
						Формат(СтрокаДокумента.Дата, "ДФ=dd.MM.yyyy;"));
					ДокументыОбОтгрузке.Добавить(ПредставлениеДокумента);
				КонецЦикла;
			Иначе
				СтрокаДокумента = ДокументыПодтвержденияОтгрузки.Добавить();
				СтрокаДокумента.Номер = ВыборкаШапки.Номер;
				СтрокаДокумента.Дата = НачалоДня(ВыборкаШапки.Дата);
				Если ИспользуемУПД Тогда
					СтрокаДокумента.Наименование = НСтр("ru = 'Универсальный передаточный документ'");
				Иначе
					СтрокаДокумента.Наименование = Строка(ВыборкаШапки.ВидДокумента);
				КонецЕсли;
				ПредставлениеДокумента = СтрШаблон("%1 № %2 от %3", 
					СтрокаДокумента.Наименование,
					СтрокаДокумента.Номер,
					Формат(СтрокаДокумента.Дата, "ДФ=dd.MM.yyyy;"));
				ДокументыОбОтгрузке.Добавить(ПредставлениеДокумента);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных,
		ДокументыПодтвержденияОтгрузки, "ДокументыПодтвержденияОтгрузки");
	
	Если ЗначениеЗаполнено(ДокументыОбОтгрузке) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДокументОбОтгрузке", СтрСоединить(ДокументыОбОтгрузке, "; "));
	КонецЕсли;
	
КонецПроцедуры

Функция ПредставлениеДокументаОбОтгрузке(НомераСтрок, НомерДокумента, ДатаДокумента)
	Возврат СтрШаблон(НСтр("ru = '№ п/п %1 № %2 от %3 г.'"),
		НомераСтрок, НомерДокумента, Формат(ДатаДокумента, "ДФ=dd.MM.yyyy"));
КонецФункции

#КонецОбласти

#Область УПД

Процедура НайтиСоздатьУПДДокументОПередаче(ДеревоДанных, СсылкаНаВладельца, СпособОбработки, ОписаниеОшибки)
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	ДокументОбъект.НомерЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
	ДокументОбъект.НомерИсправления = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления");
	Если ЗначениеЗаполнено(ДокументОбъект.НомерИсправления) Тогда
		ВидОперации = Перечисления.ВидыОпераций.Исправление;
		
		ДокументОбъект.ДатаЭД  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаИсправления");
		ДокументОбъект.НомерИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "НомерДокумента");
		ДокументОбъект.ДатаИсходногоДокумента  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаДокумента");
	Иначе
		ВидОперации = Перечисления.ВидыОпераций.Реализация;
		
		ДокументОбъект.ДатаЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаДокумента");
	КонецЕсли;
	ДокументОбъект.ВидОперации = ВидОперации;
	
	ДокументОбъект.Валюта = ЭлектронноеВзаимодействие.НайтиСсылку("Валюты",
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод"));
	
	ДокументОбъект.ИдентификаторГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта");
	
	ДокументОбъект.Контрагент  = КонтрагентПоДаннымЭД(ДеревоДанных,  "СведенияОПродавце");
	ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(ДеревоДанных, "СведенияОПокупателе");
	
	ГрузоотправительОнЖе = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "СведенияОГрузоотправителе.ОнЖе");
	
	Если ГрузоотправительОнЖе = Истина Тогда
		ДокументОбъект.Грузоотправитель = ДокументОбъект.Контрагент;
	Иначе
		ДокументОбъект.Грузоотправитель = КонтрагентПоДаннымЭД(ДеревоДанных, "СведенияОГрузоотправителе.Грузоотправитель");
	КонецЕсли;
	
	ДокументОбъект.Грузополучатель  = КонтрагентПоДаннымЭД(ДеревоДанных, "СведенияОГрузополучателе");
	ДокументОбъект.Перевозчик       = КонтрагентПоДаннымЭД(ДеревоДанных, "СведенияОПеревозчике");
	
	ТранспортнаяНакладная = ДеревоДанных.Строки.Найти("ТранспортнаяНакладная", "ПолныйПуть");
	Если ТранспортнаяНакладная <> Неопределено
		И ТранспортнаяНакладная.Строки.Количество() Тогда
		
		ДокументОбъект.НомерТранспортнойНакладной = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ТранспортнаяНакладная.Строки[0], "ТранспортнаяНакладная.НомерСтроки.ТранспортнаяНакладнаяНомер");
		
		ДокументОбъект.ДатаТранспортнойНакладной = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ТранспортнаяНакладная.Строки[0], "ТранспортнаяНакладная.НомерСтроки.ТранспортнаяНакладнаяДата");
		
	КонецЕсли;
	
	ДокументОбъект.СведенияОТранспортировкеИГрузе = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "СведенияОТранспортировке");
	
	// Поиск и заполнение договора контрагента.
	ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеОтгрузкиТоваров", "ПолныйПуть");
	Если ОснованияОтгрузки <> Неопределено Тогда
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументНомер");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				ДоговорДата = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументДата");
				
				СвойстваДоговора = Новый Структура;
				СвойстваДоговора.Вставить("НомерДоговора", ДоговорНомер);
				СвойстваДоговора.Вставить("ДатаДоговора", ДоговорДата);
				СвойстваДоговора.Вставить("Организация", ДокументОбъект.Организация);
				СвойстваДоговора.Вставить("Владелец", ДокументОбъект.Контрагент);
				
				ДоговорКонтрагента = ЭлектронноеВзаимодействие.НайтиСсылку("ДоговорыКонтрагентов",, СвойстваДоговора);
				ДокументОбъект.ДоговорКонтрагента = ДоговорКонтрагента;
				
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	// Поиск и заполнение банковского счета контрагента.
	НомерСчета = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияОПродавце.БанковскиеРеквизиты.НомерСчета");
	БИКБанка = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияОПродавце.БанковскиеРеквизиты.БИКБанка");
	ДокументОбъект.БанковскийСчетКонтрагента = БанковскийСчетКонтрагента(
		ДокументОбъект.Контрагент, БИКБанка, НомерСчета, ДокументОбъект.Валюта);
	
	// Сведения об основании.
	ДокументыОснованияДокументаОтгрузки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки");
	Если ЗначениеЗаполнено(ДокументыОснованияДокументаОтгрузки) Тогда
		ДокументОбъект.ДокументОснование = ДокументыОснованияДокументаОтгрузки[0];
	Иначе
		ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
		Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
			Для Каждого СтрокаСФ Из ДокументыОснованияСчетаФактуры Цикл
				Если ТипЗнч(СтрокаСФ) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
					Для Каждого Строка Из СтрокаСФ.ДокументыОснования Цикл
						Если ЗначениеЗаполнено(Строка.ДокументОснование) Тогда
							ДокументОбъект.ДокументОснование = Строка.ДокументОснование;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ЕстьТовары = Ложь;
	ЕстьРаботы = Ложь;
	ЕстьПрава  = Ложь;
	
	ОблагаетсяНДСУПокупателя = Ложь;
	ИспользоватьСопоставлениеНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	
	ДокументОбъект.Товары.Очистить();
	ДокументОбъект.КодыУпаковокМаркируемойПродукции.Очистить();
	
	ТаблицаТоваров = ДокументОбъект.Товары.ВыгрузитьКолонки();
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(ТаблицаТоваров);
	
	// Сведения таблицы.
	СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
	Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
		
		Признак = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.Признак");
		
		Если Признак = "1" Тогда
			ЕстьТовары = Истина;
		ИначеЕсли Признак = "2" ИЛИ Признак = "3" Тогда
			ЕстьРаботы = Истина;
		ИначеЕсли Признак = "4" Тогда
			ЕстьПрава  = Истина;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		НоваяСтрока.КоличествоУпаковок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.Количество");
		НоваяСтрока.Цена = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмерения");
		НоваяСтрока.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
		НоваяСтрока.СуммаАкциза = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.СуммаАкциза");
		
		Если НоваяСтрока.Цена = 0 И НоваяСтрока.КоличествоУпаковок <> 0
			И (Признак = "2" ИЛИ Признак = "3") Тогда
			НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.КоличествоУпаковок;
		КонецЕсли;
		
		СтавкаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
		Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
			НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
			ОблагаетсяНДСУПокупателя = Истина;
		Иначе
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаСНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
			НоваяСтрока.СуммаНДС  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СуммаНалога");
		КонецЕсли;
		
		СведенияОТаможеннойДекларации = СведенияОТоваре.Строки.Найти(
			"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации", "ПолныйПуть", Истина);
		
		Если СведенияОТаможеннойДекларации <> Неопределено
			И СведенияОТаможеннойДекларации.Строки.Количество() Тогда
			
			НоваяСтрока.НомерГТД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
				"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.ТаможеннаяДекларацияНомер");
			
			КодСтраны = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
				"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.СтранаПроисхожденияКод");
			
			Если ЗначениеЗаполнено(КодСтраны) Тогда
				НоваяСтрока.СтранаПроисхождения = УправлениеКонтактнойИнформацией.СтранаМираПоКодуИлиНаименованию(КодСтраны);
			КонецЕсли;
			
		КонецЕсли;
		
		КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(НоваяСтрока);
		ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокумента(ДокументОбъект, НоваяСтрока, СведенияОТоваре);
		
		Сопоставление = СведенияОТоваре.Строки.Найти(
			"СведенияОТоварах.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
		Если Сопоставление <> Неопределено Тогда
			
			Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.Сопоставление.Идентификатор");
			Если ЗначениеЗаполнено(Идентификатор) Тогда
				НоваяСтрока.ИдентификаторКонтрагента = Идентификатор;
			КонецЕсли;
			
			Если ИспользоватьСопоставлениеНоменклатуры Тогда
				
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
				КонецЕсли;
				
				Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.ХарактеристикаИБ");
				Если ЗначениеЗаполнено(Характеристика) Тогда
					НоваяСтрока.Характеристика = Характеристика;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;

			КонецЕсли;
			
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
			ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод");
			ЕдиницаИзмеренияНаименование = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияНаименование");
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
				НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.УпаковкаНоменклатуры(
					НоваяСтрока.Номенклатура, ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.НаименованиеКонтрагента = ПредставлениеНоменклатурыПоставщика(
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ТоварНаименование"));
			
		РассчитатьКоличествоБазовыхЕдиниц(НоваяСтрока);
	КонецЦикла;
	
	СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(ТаблицаТоваров, ДокументОбъект.Контрагент);
	ДокументОбъект.Товары.Загрузить(ТаблицаТоваров);
	
	ДокументОбъект.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;
	
	Если ОблагаетсяНДСУПокупателя Тогда
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоКОплате.ВсегоСтоимостьТоваровБезНалога");
	Иначе
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом");
	КонецЕсли;
	
	Если СпособОбработки = "ВозвратТоваровОтПокупателя" Тогда
		ВидДокумента = Перечисления.ВидыДокументов.НакладнаяНаВозврат;
	ИначеЕсли ЕстьТовары Тогда
		ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная;
	ИначеЕсли ЕстьРаботы Тогда
		ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот;
	ИначеЕсли ЕстьПрава Тогда
		ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав;
	Иначе
		ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная;
	КонецЕсли;
	
	ДокументОбъект.ВидДокумента = ВидДокумента;
	
	РежимЗаписиПроведение = Истина;
	Если ДокументОбъект.ВидОперации <> Перечисления.ВидыОпераций.Реализация Тогда
		РежимЗаписиПроведение = ЗначениеЗаполнено(ДокументОбъект.ДокументОснование);
	КонецЕсли;
	
	ЗаписатьДокумент(ДокументОбъект, РежимЗаписиПроведение);
	СсылкаНаВладельца = ДокументОбъект.Ссылка;
	
КонецПроцедуры

Процедура НайтиСоздатьУПДСчетФактуру(ДеревоДанных, СсылкаНаВладельца, СпособОбработки, ОписаниеОшибки)
	
	ТекущаяДатаСеанса = ТекущаяДатаСеанса();
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.СчетФактураПолученный.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса;
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	ВидСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры");
	Если ВидСчетаФактуры = "Авансовый" Тогда
		ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс;
	Иначе
		ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.СчетФактура;
	КонецЕсли;
	
	ДокументОбъект.НомерЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
	ДокументОбъект.НомерИсправления = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления");
	Если ЗначениеЗаполнено(ДокументОбъект.НомерИсправления) Тогда
		ВидОперации = Перечисления.ВидыОпераций.Исправление;
		
		ДокументОбъект.ДатаЭД  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаИсправления");
		ДокументОбъект.НомерИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "НомерДокумента");
		ДокументОбъект.ДатаИсходногоДокумента  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаДокумента");
	Иначе
		ВидОперации = Перечисления.ВидыОпераций.Реализация;
		
		ДокументОбъект.ДатаЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаДокумента");
	КонецЕсли;
	ДокументОбъект.ВидОперации = ВидОперации;
	
	ДокументОбъект.Валюта = ЭлектронноеВзаимодействие.НайтиСсылку("Валюты",
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод"));
	
	ДокументОбъект.ИдентификаторГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта");
	
	ДокументОбъект.Контрагент  = КонтрагентПоДаннымЭД(ДеревоДанных,  "СведенияОПродавце");
	ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(ДеревоДанных, "СведенияОПокупателе");
	
	ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеОтгрузкиТоваров", "ПолныйПуть");
	Если ОснованияОтгрузки <> Неопределено Тогда
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументНомер");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				ДоговорДата = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументДата");
				
				СвойстваДоговора = Новый Структура;
				СвойстваДоговора.Вставить("НомерДоговора", ДоговорНомер);
				СвойстваДоговора.Вставить("ДатаДоговора", ДоговорДата);
				СвойстваДоговора.Вставить("Организация", ДокументОбъект.Организация);
				СвойстваДоговора.Вставить("Владелец", ДокументОбъект.Контрагент);
				
				ДоговорКонтрагента = ЭлектронноеВзаимодействие.НайтиСсылку("ДоговорыКонтрагентов",, СвойстваДоговора);
				ДокументОбъект.ДоговорКонтрагента = ДоговорКонтрагента;
				
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	ДокументОбъект.ДокументыОснования.Очистить();
	ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
	Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		ДокументОбъект.ДокументыОснования.Очистить();
		Для Каждого ДокументОснования Из ДокументыОснованияСчетаФактуры Цикл
			Если ТипЗнч(ДокументОснования) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				ДокументОбъект.СчетФактураОснование = ДокументОснования;
			Иначе
				СтрокаТаблицы = ДокументОбъект.ДокументыОснования.Добавить();
				СтрокаТаблицы.ДокументОснование = ДокументОснования;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ОблагаетсяНДСУПокупателя = Ложь;
	ИспользоватьСопоставлениеНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	
	ДокументОбъект.Товары.Очистить();
	Если ДокументОбъект.ДокументыОснования.Количество() = 0 Тогда
		
		ТаблицаТовары = ДокументОбъект.Товары.ВыгрузитьКолонки();
		СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(ТаблицаТовары);
		
		// Сведения таблицы.
		СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
		Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
			
			НоваяСтрока = ТаблицаТовары.Добавить();
		
			НоваяСтрока.КоличествоУпаковок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.Количество");
			НоваяСтрока.Цена = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмерения");
			НоваяСтрока.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
			НоваяСтрока.СуммаАкциза = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.СуммаАкциза");
			
			Признак = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.Признак");
			
			Если НоваяСтрока.Цена = 0 И НоваяСтрока.КоличествоУпаковок <> 0
				И (Признак = "2" ИЛИ Признак = "3") Тогда
				НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.КоличествоУпаковок;
			КонецЕсли;
			
			СтавкаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
			Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
				НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
				ОблагаетсяНДСУПокупателя = Истина;
			Иначе
				НоваяСтрока.СтавкаНДС = СтавкаНДС;
				НоваяСтрока.СуммаСНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
				НоваяСтрока.СуммаНДС  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.СуммаНалога");
			КонецЕсли;
			
			СведенияОТаможеннойДекларации = СведенияОТоваре.Строки.Найти(
				"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации", "ПолныйПуть", Истина);
			
			Если СведенияОТаможеннойДекларации <> Неопределено
				И СведенияОТаможеннойДекларации.Строки.Количество() Тогда
				
				НоваяСтрока.НомерГТД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
					"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.ТаможеннаяДекларацияНомер");
				
				КодСтраны = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТаможеннойДекларации.Строки[0],
					"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.СтранаПроисхожденияКод");
				
				Если ЗначениеЗаполнено(КодСтраны) Тогда
					НоваяСтрока.СтранаПроисхождения = УправлениеКонтактнойИнформацией.СтранаМираПоКодуИлиНаименованию(КодСтраны);
				КонецЕсли;
				
			КонецЕсли;
			
			КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(НоваяСтрока);
			ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокумента(ДокументОбъект, НоваяСтрока, СведенияОТоваре);
			
			Сопоставление = СведенияОТоваре.Строки.Найти(
			"СведенияОТоварах.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
			Если Сопоставление <> Неопределено Тогда
				
				Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.Идентификатор");
				Если ЗначениеЗаполнено(Идентификатор) Тогда
					НоваяСтрока.ИдентификаторКонтрагента = Идентификатор;
				КонецЕсли;
				
				Если ИспользоватьСопоставлениеНоменклатуры Тогда
					
					Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
					Если ЗначениеЗаполнено(Номенклатура) Тогда
						НоваяСтрока.Номенклатура = Номенклатура;
					КонецЕсли;
					
					Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.ХарактеристикаИБ");
					Если ЗначениеЗаполнено(Характеристика) Тогда
						НоваяСтрока.Характеристика = Характеристика;
					КонецЕсли;
					
					ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.УпаковкаИБ");
					Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
						НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
					КонецЕсли;

				КонецЕсли;
				
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
				ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод");
				ЕдиницаИзмеренияНаименование = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияНаименование");
				Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
					НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.УпаковкаНоменклатуры(
						НоваяСтрока.Номенклатура, ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
				КонецЕсли;
			КонецЕсли;
			
			ТоварНаименование = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ТоварНаименование");
			НоваяСтрока.НаименованиеКонтрагента = ПредставлениеНоменклатурыПоставщика(ТоварНаименование);
			
			РассчитатьКоличествоБазовыхЕдиниц(НоваяСтрока);
		КонецЦикла;
		
		СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(ТаблицаТовары, ДокументОбъект.Контрагент);
		ДокументОбъект.Товары.Загрузить(ТаблицаТовары);
		
	Иначе
		
		ОблагаетсяНДСУПокупателя = ДеревоДанных.Строки.Найти("НДС исчисляется налоговым агентом", "Значение", Истина) <> Неопределено;
		
	КонецЕсли;
	
	ДокументОбъект.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;
	
	Если ОблагаетсяНДСУПокупателя Тогда
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоКОплате.ВсегоСтоимостьТоваровБезНалога");
	Иначе
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом");
	КонецЕсли;
	
	ДокументОбъект.ПлатежноРасчетныеДокументы.Очистить();
	ПлатежноРасчетныеДокументы = ДеревоДанных.Строки.Найти("ПлатежноРасчетныеДокументы", "ПолныйПуть");
	Если ПлатежноРасчетныеДокументы <> Неопределено Тогда
		Для Каждого СтрокаПРД Из ПлатежноРасчетныеДокументы.Строки Цикл
			НомерПРД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаПРД,
				"ПлатежноРасчетныеДокументы.НомерСтроки.НомерПРД");
			ДатаПРД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаПРД,
				"ПлатежноРасчетныеДокументы.НомерСтроки.ДатаПРД");
			
			Если ЗначениеЗаполнено(НомерПРД) И ЗначениеЗаполнено(ДатаПРД) Тогда
				НоваяСтрока = ДокументОбъект.ПлатежноРасчетныеДокументы.Добавить();
				НоваяСтрока.НомерПлатежноРасчетногоДокумента = НомерПРД;
				НоваяСтрока.ДатаПлатежноРасчетногоДокумента  = ДатаПРД;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	РежимЗаписиПроведение = Истина;
	Если ДокументОбъект.ВидОперации <> Перечисления.ВидыОпераций.Реализация Тогда
		РежимЗаписиПроведение = ЗначениеЗаполнено(ДокументОбъект.СчетФактураОснование);
	КонецЕсли;
	
	ЗаписатьДокумент(ДокументОбъект, РежимЗаписиПроведение);
	СсылкаНаВладельца = ДокументОбъект.Ссылка;
	
КонецПроцедуры

#КонецОбласти

Процедура ЗаполнитьДанныеДляУКДИнформацияПродавцаФНС(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ)
	
	ТипДокумента = ТипЗнч(СсылкаНаОбъект);
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ДокументСсылкаКСЧФ = СсылкаНаОбъект;
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	СчетФактураВыданныйДокументыОснования.ДокументОснование КАК ДокументОснование
			|ИЗ
			|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
			|ГДЕ
			|	СчетФактураВыданныйДокументыОснования.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылкаКСЧФ);
		Выборка = Запрос.Выполнить().Выбрать();
		
		ДокументСсылкаДИС = Неопределено;
		Если Выборка.Следующий() Тогда
			ДокументСсылкаДИС = Выборка.ДокументОснование;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ДокументСсылкаДИС) Тогда
			ШаблонСообщения = НСтр("ru = 'Для %1 универсальный корректировочный документ не применяется.'");
			ТекстСообщения = СтрШаблон(ШаблонСообщения, ДокументСсылкаКСЧФ);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
	Иначе
		ДокументСсылкаДИС = СсылкаНаОбъект;
		ДокументСсылкаКСЧФ = Документы.СчетФактураВыданный.СчетФактураДокумента(СсылкаНаОбъект);
		Если НЕ ЗначениеЗаполнено(ДокументСсылкаКСЧФ) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьДанныеДляКСЧФИнформацияПродавцаФНС(ДокументСсылкаКСЧФ, СтруктураЭД, ДеревоДанных, Отказ);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеДляДИСИнформацияПродавцаФНС(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ)
	
	СтруктураДанных = Документы[СсылкаНаОбъект.Метаданные().Имя].ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();
	
	Если ВыборкаШапки.ВидОперации = Перечисления.ВидыОпераций.Исправление 
		И ЗначениеЗаполнено(ВыборкаШапки.НомерИсправляемогоКорректировочногоДокумента)
		И ЗначениеЗаполнено(ВыборкаШапки.ДатаИсправляемогоКорректировочногоДокумента) Тогда
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(ВыборкаШапки.Ссылка, 
			"Объект.НомерИсправляемогоКорректировочногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента",
			ВыборкаШапки.НомерИсправляемогоКорректировочногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(ВыборкаШапки.Ссылка, 
			"Объект.ДатаИсправляемогоКорректировочногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",
			ВыборкаШапки.ДатаИсправляемогоКорректировочногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсправления");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления",
			ВыборкаШапки.НомерИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ДатаИсправления");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления",
			ВыборкаШапки.ДатаИсправления, ПараметрыОбработкиОшибок);
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерЭД");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента",
			ВыборкаШапки.Номер, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Дата");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",
			ВыборкаШапки.Дата, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.НомерИсходногоДокумента)
		И ЗначениеЗаполнено(ВыборкаШапки.ДатаИсходногоДокумента) Тогда
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"НомерИсходногоДокумента", ВыборкаШапки.НомерИсходногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ДатаИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДатаИсходногоДокумента", ВыборкаШапки.ДатаИсходногоДокумента, ПараметрыОбработкиОшибок);
		
		Если ЗначениеЗаполнено(ВыборкаШапки.НомерИсправленияИсходногоДокумента)
			И ЗначениеЗаполнено(ВыборкаШапки.ДатаИсправленияИсходногоДокумента) Тогда
			
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				СсылкаНаОбъект, "Объект.НомерИсправленияИсходногоДокумента");
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"НомерИсправленияИсходногоДокумента", ВыборкаШапки.НомерИсправленияИсходногоДокумента, ПараметрыОбработкиОшибок);
			
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				СсылкаНаОбъект, "Объект.ДатаИсправленияИсходногоДокумента");
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"ДатаИсправленияИсходногоДокумента", ВыборкаШапки.ДатаИсправленияИсходногоДокумента, ПараметрыОбработкиОшибок);
		КонецЕсли;
		
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры", ВыборкаШапки.ДокументОснование);
	
	ЗаполнитьДеревоДанныхУКД(СтруктураДанных, СтруктураЭД, ДеревоДанных);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеДляКСЧФИнформацияПродавцаФНС(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ)
	
	СтруктураДанных = Документы.СчетФактураВыданный.ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СсылкаКорректировочногоСчетаФактуры", СсылкаНаОбъект);
	Если ВыборкаШапки.ВидОперации = Перечисления.ВидыОпераций.Исправление 
		И ЗначениеЗаполнено(ВыборкаШапки.НомерИсправляемогоКорректировочногоДокумента)
		И ЗначениеЗаполнено(ВыборкаШапки.ДатаИсправляемогоКорректировочногоДокумента) Тогда
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсправляемогоКорректировочногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"НомерДокумента", ВыборкаШапки.НомерИсправляемогоКорректировочногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ДатаИсправляемогоКорректировочногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДатаДокумента",  ВыборкаШапки.ДатаИсправляемогоКорректировочногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсправления");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления",
			ВыборкаШапки.НомерИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ДатаИсправления");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления",
			ВыборкаШапки.ДатаИсправления, ПараметрыОбработкиОшибок);
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерЭД");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента",
			ВыборкаШапки.Номер, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Дата");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",
			ВыборкаШапки.Дата, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.НомерИсходногоДокумента)
		И ЗначениеЗаполнено(ВыборкаШапки.ДатаИсходногоДокумента) Тогда
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"НомерИсходногоДокумента", ВыборкаШапки.НомерИсходногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ДатаИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДатаИсходногоДокумента",  ВыборкаШапки.ДатаИсходногоДокумента, ПараметрыОбработкиОшибок);
		
		Если ЗначениеЗаполнено(ВыборкаШапки.НомерИсправленияИсходногоДокумента)
			И ЗначениеЗаполнено(ВыборкаШапки.ДатаИсправленияИсходногоДокумента) Тогда
			
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				СсылкаНаОбъект, "Объект.НомерИсправленияИсходногоДокумента");
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"НомерИсправленияИсходногоДокумента", ВыборкаШапки.НомерИсправленияИсходногоДокумента, ПараметрыОбработкиОшибок);
			
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				СсылкаНаОбъект, "Объект.ДатаИсправленияИсходногоДокумента");
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"ДатаИсправленияИсходногоДокумента", ВыборкаШапки.ДатаИсправленияИсходногоДокумента, ПараметрыОбработкиОшибок);
		КонецЕсли;
		
	КонецЕсли;
	
	МассивОснований = Новый Массив;
	Если СтруктураДанных.Свойство("ВыборкаОснований") Тогда
		
		ВыборкаОснований = СтруктураДанных.ВыборкаОснований;
		Пока ВыборкаОснований.Следующий() Цикл
			МассивОснований.Добавить(ВыборкаОснований.ДокументОснование);
		КонецЦикла;
		
		СтруктураДанныхОснований = Документы[МассивОснований[0].Метаданные().Имя].ПолучитьДанныеДляЭД(МассивОснований);
		Если СтруктураДанныхОснований.ВыборкаШапки.Следующий() Тогда
			ЗаполнитьДеревоДанныхУКД(СтруктураДанныхОснований, СтруктураЭД, ДеревоДанных);
		КонецЕсли;
		
	Иначе
		ЗаполнитьДеревоДанныхУКД(СтруктураДанных, СтруктураЭД, ДеревоДанных);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.СчетФактураОснование) Тогда
		МассивОснований.Добавить(ВыборкаШапки.СчетФактураОснование);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДокументыОснованияСчетаФактуры", МассивОснований);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПередачаТоваровПродавец(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ)
	
	СтруктураДанных = Документы[СсылкаНаОбъект.Метаданные().Имя].ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();
	
	Если ВыборкаШапки.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		ВидОперацииЭД = Перечисления.ВидыОперацийЭД.Исправление;
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерТоварнойНакладной",
			ВыборкаШапки.НомерИсходногоДокумента, ПараметрыОбработкиОшибок);
			
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ДатаИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаТоварнойНакладной",
			ВыборкаШапки.ДатаИсходногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсправления");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления",
			ВыборкаШапки.НомерИсправления, ПараметрыОбработкиОшибок);
			
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Дата");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления",
			ВыборкаШапки.ДатаИсправления, ПараметрыОбработкиОшибок);
	Иначе
		ВидОперацииЭД = Перечисления.ВидыОперацийЭД.ПродажаКомиссия;
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерЭД");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерТоварнойНакладной",
			ВыборкаШапки.Номер, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Дата");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаТоварнойНакладной",
			ВыборкаШапки.Дата, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации", ВидОперацииЭД);
		
	// Выводим общие реквизиты шапки
	СведенияОПоставщике = Неопределено;
	Если ЗначениеЗаполнено(ВыборкаШапки.Организация) Тогда
		СведенияОПоставщике = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Организация, СведенияОПоставщике);
		
		Если ПравоДоступа("Чтение", Метаданные.Справочники.БанковскиеСчета)
			И ЗначениеЗаполнено(ВыборкаШапки.БанковскийСчетОрганизации) Тогда
			Справочники.БанковскиеСчета.ЗаполнитьРеквизитыБанковскогоСчета(СведенияОПоставщике, ВыборкаШапки.БанковскийСчетОрганизации);
		КонецЕсли;
		
		ЗаполнитьДанныеУчастника(ДеревоДанных, СведенияОПоставщике, "Поставщик");
		
		НаименованиеСоставителяДокумента = СведенияОПоставщике.ПолноеНаименование + ?(ЗначениеЗаполнено(
			СведенияОПоставщике.КПП), СтрШаблон(НСтр("ru = ', ИНН/КПП %1/%2'"), СведенияОПоставщике.ИНН,
			СведенияОПоставщике.КПП), СтрШаблон(НСтр("ru = ', ИНН %1'"), СведенияОПоставщике.ИНН));

		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			ВыборкаШапки.Ссылка, "Объект.Организация");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
					ДеревоДанных, "НаименованиеСоставителяДокумента", НаименованиеСоставителяДокумента,
			ПараметрыОбработкиОшибок);
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(ВыборкаШапки.Ссылка, 
			"Объект.Организация");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"Поставщик", СведенияОПоставщике, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	СведенияОПокупателе = Неопределено;
	Если ЗначениеЗаполнено(ВыборкаШапки.Контрагент) Тогда
		СведенияОПокупателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Контрагент, СведенияОПокупателе);
		
		Если ПравоДоступа("Чтение", Метаданные.Справочники.БанковскиеСчета)
			И ЗначениеЗаполнено(ВыборкаШапки.БанковскийСчетКонтрагента) Тогда
			Справочники.БанковскиеСчета.ЗаполнитьРеквизитыБанковскогоСчета(СведенияОПокупателе, ВыборкаШапки.БанковскийСчетКонтрагента);
		КонецЕсли;
		
		ЗаполнитьДанныеУчастника(ДеревоДанных, СведенияОПокупателе, "Плательщик");

	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(ВыборкаШапки.Ссылка, 
			"Объект.Контрагент");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"Плательщик", СведенияОПокупателе, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.Грузоотправитель) Тогда
		СведенияОГрузоотправителе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Грузоотправитель, СведенияОГрузоотправителе);
		ЗаполнитьДанныеУчастника(ДеревоДанных, СведенияОГрузоотправителе, "Грузоотправитель", , "ПочтовыйАдрес");
	ИначеЕсли СведенияОПоставщике <> Неопределено Тогда
		ЗаполнитьДанныеУчастника(ДеревоДанных, СведенияОПоставщике, "Грузоотправитель", , "ПочтовыйАдрес");
	КонецЕсли;
	
	СведенияОГрузополучателе = Неопределено;
	Если ЗначениеЗаполнено(ВыборкаШапки.Грузополучатель) Тогда
		СведенияОГрузополучателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Грузополучатель, СведенияОГрузополучателе);
	ИначеЕсли СведенияОПокупателе <> Неопределено Тогда
		СведенияОГрузополучателе = СведенияОПокупателе;
	КонецЕсли;
	
	Если СведенияОГрузополучателе <> Неопределено Тогда
		
		Если ЗначениеЗаполнено(ВыборкаШапки.АдресДоставкиЗначенияПолей) Тогда
			ВидАдреса = "ПроизвольныйАдрес";
			СведенияОГрузополучателе.Вставить("ПроизвольныйАдресЗначенияПолей", ВыборкаШапки.АдресДоставкиЗначенияПолей);
		Иначе
			ВидАдреса = "ФактическийАдрес";
		КонецЕсли;
		
		ЗаполнитьДанныеУчастника(ДеревоДанных, СведенияОГрузополучателе, "Грузополучатель",,ВидАдреса);
	КонецЕсли;
	
	ДопДанные = Новый ТаблицаЗначений;
	ДопДанные.Колонки.Добавить("Идентификатор");
	ДопДанные.Колонки.Добавить("Значение");
	
	Если ЗначениеЗаполнено(ВыборкаШапки.Перевозчик) Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаШапки.Перевозчик, "НаименованиеПолное, ИНН, КПП, ЮрФизЛицо");
		СведенияОПеревозчике = ЗначенияРеквизитов.НаименованиеПолное + ", " + ЗначенияРеквизитов.ИНН
			+ ?(ЗначенияРеквизитов.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо, "/" + ЗначенияРеквизитов.КПП, "");
		
		СтрокаДопДанных = ДопДанные.Добавить();	
		СтрокаДопДанных.Идентификатор = "СведенияОПеревозчике";
		СтрокаДопДанных.Значение = СведенияОПеревозчике;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.НомерТранспортнойНакладной)
		И ЗначениеЗаполнено(ВыборкаШапки.ДатаТранспортнойНакладной) Тогда
		
		ТранспортнаяНакладная = Новый ТаблицаЗначений;
		ТранспортнаяНакладная.Колонки.Добавить("ТранспортнаяНакладнаяНомер");
		ТранспортнаяНакладная.Колонки.Добавить("ТранспортнаяНакладнаяДата");
		
		НоваяСтрока = ТранспортнаяНакладная.Добавить();
		НоваяСтрока.ТранспортнаяНакладнаяНомер = ВыборкаШапки.НомерТранспортнойНакладной;
		НоваяСтрока.ТранспортнаяНакладнаяДата  = ВыборкаШапки.ДатаТранспортнойНакладной;
		
		// Дополним таблицу транспортных накладных параметрами обработки ошибок.
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(НоваяСтрока,
			"ТранспортнаяНакладнаяНомер", ВыборкаШапки.Ссылка, "Объект.НомерТранспортнойНакладной");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(НоваяСтрока,
			"ТранспортнаяНакладнаяДата", ВыборкаШапки.Ссылка, "Объект.ДатаТранспортнойНакладной");
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТранспортнаяНакладная, "ТранспортнаяНакладная");
		
	КонецЕсли;
	
	// Обработка ошибки с указанием расширенного текста сообщения вместо параметров обработки ошибки.
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить код валюты документа. Проверьте, что:
	|	- в документе указана валюта,
	|	- для нее заполнен код по Общероссийскому классификатору валют.'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", ВыборкаШапки.ВалютаКод, ТекстОшибки);
	
	Если ЗначениеЗаполнено(ВыборкаШапки.ИдентификаторГосКонтракта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ИдентификаторГосКонтракта");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ИдГосКонтракта",
			ВыборкаШапки.ИдентификаторГосКонтракта, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.ДоговорКонтрагента) Тогда
		
		ОснованияОтгрузки = Новый ТаблицаЗначений;
		ОснованияОтгрузки.Колонки.Добавить("ДоговорКонтрагента");
		ОснованияОтгрузки.Колонки.Добавить("ДокОснованиеНаименование");
		ОснованияОтгрузки.Колонки.Добавить("ДокОснованиеНомер");
		ОснованияОтгрузки.Колонки.Добавить("ДокОснованиеДата");
		
		НоваяСтрока = ОснованияОтгрузки.Добавить();
		НоваяСтрока.ДоговорКонтрагента       = ВыборкаШапки.ДоговорКонтрагента;
		НоваяСтрока.ДокОснованиеНаименование = ВыборкаШапки.НаименованиеДоговора;
		НоваяСтрока.ДокОснованиеНомер        = ВыборкаШапки.НомерДоговора;
		НоваяСтрока.ДокОснованиеДата         = ВыборкаШапки.ДатаДоговора;
		
		// Дополним таблицу оснований параметрами обработки ошибок.
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(НоваяСтрока,
			"ДокОснованиеНаименование", "ДоговорКонтрагента", "Объект.Наименование");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(НоваяСтрока,
			"ДокОснованиеНомер", "ДоговорКонтрагента", "Объект.НомерДоговора");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(НоваяСтрока,
			"ДокОснованиеДата", "ДоговорКонтрагента", "Объект.ДатаДоговора");
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ОснованияОтгрузки, "Основание");
		
	Иначе
		
		// Заполнение параметров ошибки для полей, для которых это обязательно при отсутствии данных для них.
		ТекстОшибки = НСтр("ru = 'Возникла ошибка при заполнении основания отгрузки. Возможные причины:
		|	- в документе отгрузки не указан договор
		|	- в в договоре не указана дата'");
		ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных,
			"Основание.НомерСтроки.ДокОснованиеДата",ТекстОшибки);
		
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснования", ВыборкаШапки.ДокументОснование);
	
	Если ЗначениеЗаполнено(ВыборкаШапки.ДатаОтгрузки) Тогда
		ДатаОтпуска = ВыборкаШапки.ДатаОтгрузки;
	Иначе
		ДатаОтпуска = ВыборкаШапки.Дата;
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияПоОтпускуГруза.ДатаОтпуска", ДатаОтпуска);
	
	ТаблицаТоваров = Новый ТаблицаЗначений();
	ТаблицаТоваров.Колонки.Добавить("НомерСтроки");
	ТаблицаТоваров.Колонки.Добавить("Номенклатура");
	ТаблицаТоваров.Колонки.Добавить("НаименованиеНоменклатуры");
	ТаблицаТоваров.Колонки.Добавить("Характеристика");
	ТаблицаТоваров.Колонки.Добавить("НаименованиеХарактеристики");
	ТаблицаТоваров.Колонки.Добавить("Сорт");
	ТаблицаТоваров.Колонки.Добавить("Артикул");
	ТаблицаТоваров.Колонки.Добавить("КодТовара");
	ТаблицаТоваров.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаТоваров.Колонки.Добавить("ЕдиницаИзмеренияНаименование");
	ТаблицаТоваров.Колонки.Добавить("БазоваяЕдиницаКод");
	ТаблицаТоваров.Колонки.Добавить("ВидУпаковки");
	ТаблицаТоваров.Колонки.Добавить("КоличествоВОдномМесте");
	ТаблицаТоваров.Колонки.Добавить("КоличествоМест");
	ТаблицаТоваров.Колонки.Добавить("МассаБрутто");
	ТаблицаТоваров.Колонки.Добавить("МассаНетто");
	ТаблицаТоваров.Колонки.Добавить("Цена");
	ТаблицаТоваров.Колонки.Добавить("СуммаБезНДС");
	ТаблицаТоваров.Колонки.Добавить("СтавкаНДС");
	ТаблицаТоваров.Колонки.Добавить("СуммаНДС");
	ТаблицаТоваров.Колонки.Добавить("СуммаСНДС");
	ТаблицаТоваров.Колонки.Добавить("ДокументОснование");
	ТаблицаТоваров.Колонки.Добавить("ДопДанныеПодписанные");
	ТаблицаТоваров.Колонки.Добавить("ДопДанныеНеПодписанные");
	ТаблицаТоваров.Колонки.Добавить("Сопоставление");
	
	НомерСтроки = 1;
	ВыборкаТоваров = СтруктураДанных.ВыборкаТоваров;
	
	ШтрихкодыКомбинаций   = Неопределено;
	ШтрихкодыНоменклатуры = Неопределено;
	Если НЕ СтруктураДанных.Свойство("ШтрихкодыНоменклатуры", ШтрихкодыНоменклатуры)
		ИЛИ НЕ СтруктураДанных.Свойство("ШтрихкодыКомбинаций", ШтрихкодыКомбинаций) Тогда
		ШтрихкодыПоТоварам(ВыборкаТоваров, ШтрихкодыКомбинаций, ШтрихкодыНоменклатуры);
	КонецЕсли;

	ЗаполнениеКодаТовара = СтруктураЭД.ВариантыЗаполненияПолей.ТоварКод;
	
	Пока ВыборкаТоваров.Следующий() Цикл
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		НоваяСтрока.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
		
		НоваяСтрока.Номенклатура                 = ВыборкаТоваров.Номенклатура; 
		НоваяСтрока.Характеристика               = ВыборкаТоваров.Характеристика;

		НоваяСтрока.НаименованиеНоменклатуры     = ВыборкаТоваров.НаименованиеПолное;
		НоваяСтрока.НаименованиеХарактеристики   = ВыборкаТоваров.ХарактеристикаНаименование;
		
		Если ЗначениеЗаполнено(ВыборкаТоваров.Содержание) Тогда
			НоваяСтрока.НаименованиеНоменклатуры   = ВыборкаТоваров.Содержание;
			НоваяСтрока.НаименованиеХарактеристики = "";
		КонецЕсли;  
		
		НоваяСтрока.Артикул                      = ВыборкаТоваров.НоменклатураАртикул;
		НоваяСтрока.КодТовара                    = ВыборкаТоваров.НоменклатураКод;
		НоваяСтрока.ЕдиницаИзмеренияНаименование = ВыборкаТоваров.ЕдиницаИзмеренияНаименование;
		НоваяСтрока.ЕдиницаИзмерения             = ВыборкаТоваров.ЕдиницаИзмерения;
		НоваяСтрока.БазоваяЕдиницаКод            = ВыборкаТоваров.ЕдиницаИзмеренияКод;
		НоваяСтрока.МассаНетто                   = ВыборкаТоваров.КоличествоУпаковок;
		НоваяСтрока.Цена                         = ?(ВыборкаТоваров.КоличествоУпаковок = 0, 0,
			Окр(ВыборкаТоваров.СуммаБезНДС / ВыборкаТоваров.КоличествоУпаковок, 2));
		
		Если ВыборкаШапки.ОблагаетсяНДСУПокупателя Тогда
			НоваяСтрока.СуммаБезНДС = ВыборкаТоваров.СуммаСНДС;
			НоваяСтрока.СтавкаНДС   = "НДС исчисляется налоговым агентом";
			НоваяСтрока.СуммаНДС    = 0;
			НоваяСтрока.СуммаСНДС   = 0;
		Иначе
			НоваяСтрока.СуммаБезНДС = ВыборкаТоваров.СуммаБезНДС;
			НоваяСтрока.СтавкаНДС   = ВыборкаТоваров.СтавкаНДС;
			НоваяСтрока.СуммаНДС    = ВыборкаТоваров.СуммаНДС;
			НоваяСтрока.СуммаСНДС   = ВыборкаТоваров.СуммаСНДС;
		КонецЕсли;
		
		ДопДанныеТовара = ОбщегоНазначения.СкопироватьРекурсивно(ДопДанные, Ложь);
		
		СтрокаДопДанныхТовара = ДопДанныеТовара.Добавить();
		СтрокаДопДанныхТовара.Идентификатор = "СтавкаНДС";
		СтрокаДопДанныхТовара.Значение =  ВыборкаТоваров.СтавкаНДС;
		
		Если ЗначениеЗаполнено(ВыборкаТоваров.СуммаАкциза) Тогда
			СтрокаДопДанныхТовара.Идентификатор = "СуммаАкциза";
			СтрокаДопДанныхТовара.Значение =  ВыборкаТоваров.СуммаАкциза;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаТоваров.НомерГТД) Тогда
			СтрокаДопДанныхТовара.Идентификатор = "НомерГТД";
			СтрокаДопДанныхТовара.Значение =  ВыборкаТоваров.НомерГТД;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаТоваров.СтранаПроисхожденияКод) Тогда
			СтрокаДопДанныхТовара.Идентификатор = "КодСтраныПроисхождения";
			СтрокаДопДанныхТовара.Значение =  ВыборкаТоваров.СтранаПроисхожденияКод;
		КонецЕсли;
		
		НоваяСтрока.ДопДанныеПодписанные = ДопДанныеТовара;
		
		Сопоставление = Новый Структура;
		Сопоставление.Вставить("Наименование", ВыборкаТоваров.НаименованиеПолное);
		Если ЗначениеЗаполнено(НоваяСтрока.Характеристика) Тогда
			Сопоставление.Вставить("Характеристика", ВыборкаТоваров.ХарактеристикаНаименование);
		КонецЕсли;
		Сопоставление.Вставить("ЕдиницаИзмерения", НоваяСтрока.ЕдиницаИзмеренияНаименование);
		Сопоставление.Вставить("ЕдиницаИзмеренияКод", ВыборкаТоваров.ЕдиницаИзмеренияКод);
		Сопоставление.Вставить("Артикул", НоваяСтрока.Артикул);
		Сопоставление.Вставить("СтавкаНДС", ВыборкаТоваров.НоменклатураСтавкаНДС);
	
		Сопоставление.Вставить("НоменклатураИБ", НоваяСтрока.Номенклатура);
		Сопоставление.Вставить("ХарактеристикаИБ", НоваяСтрока.Характеристика);
		Сопоставление.Вставить("УпаковкаИБ", НоваяСтрока.ЕдиницаИзмерения);
		
		ЗаполнитьШтрихкодыТоваровВСопоставление(Сопоставление, ШтрихкодыНоменклатуры, ШтрихкодыКомбинаций, 
				НоваяСтрока.Номенклатура, НоваяСтрока.Характеристика, НоваяСтрока.ЕдиницаИзмерения);

		НоваяСтрока.Сопоставление = Сопоставление;
		
		Если ЗаполнениеКодаТовара = "Артикул" Тогда
			НоваяСтрока.КодТовара = ВыборкаТоваров.НоменклатураАртикул;
		ИначеЕсли ЗаполнениеКодаТовара = "Штрихкод"
			И НоваяСтрока.Сопоставление.Свойство("ШтрихкодКомбинации") Тогда
			НоваяСтрока.КодТовара = НоваяСтрока.Сопоставление.ШтрихкодКомбинации;
		КонецЕсли;
	
	КонецЦикла;
	
	// Обработка ошибки через механизм сообщений пользователю.
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"КодТовара", "Номенклатура", "Объект.Код");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"НаименованиеНоменклатуры", "Номенклатура", "Объект.НаименованиеПолное");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"МассаНетто", ВыборкаТоваров.Ссылка, "Объект.Товары.КоличествоУпаковок",, "НомерСтроки");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"Цена", ВыборкаТоваров.Ссылка, "Объект.Товары.Цена",, "НомерСтроки");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"СуммаБезНДС", ВыборкаТоваров.Ссылка, "Объект.Товары.Сумма",, "НомерСтроки");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"СуммаНДС", ВыборкаТоваров.Ссылка, "Объект.Товары.СуммаНДС",, "НомерСтроки");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"СуммаСНДС", ВыборкаТоваров.Ссылка, "Объект.Товары.Сумма",, "НомерСтроки");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"ЕдиницаИзмеренияНаименование", "ЕдиницаИзмерения", "Объект.Наименование");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"БазоваяЕдиницаКод", "ЕдиницаИзмерения", "Объект.Код");
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "ТаблицаТоваров");
	
	// Итоговые показатели по документу.
	
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить итоговые показатели. Возможные причины:
		|	- не заполнена табличная часть ""Товары""
		|	- не заполнены колонки ""Сумма"", ""НДС"", ""Количество""'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
								ДеревоДанных,
								"ОбщиеСведенияОТоварнойНакладной.КоличествоПорядковыхНомеровЗаписей",
								ТаблицаТоваров.Количество(), ТекстОшибки);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
								ДеревоДанных,
								"ОбщиеСведенияОТоварнойНакладной.МассаГрузаНетто",
								ТаблицаТоваров.Итог("МассаНетто"), ТекстОшибки);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
								ДеревоДанных,
								"ВсегоПоНакладной.МассаНетто",
								ТаблицаТоваров.Итог("МассаНетто"), ТекстОшибки);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
								ДеревоДанных,
								"ВсегоПоНакладной.СуммаБезНДС",
								ТаблицаТоваров.Итог("СуммаБезНДС"), ТекстОшибки);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
								ДеревоДанных,
								"ВсегоПоНакладной.СуммаНДС",
								ТаблицаТоваров.Итог("СуммаНДС"), ТекстОшибки);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
								ДеревоДанных,
								"ВсегоПоНакладной.СуммаСНДС",
								ТаблицаТоваров.Итог("СуммаСНДС"), ТекстОшибки);
	
	Если ЗначениеЗаполнено(ВыборкаШапки.СведенияОТранспортировкеИГрузе) Тогда
		СтрокаДопДанных = ДопДанные.Добавить();
		СтрокаДопДанных.Идентификатор = "СведенияОТранспортировке";
		СтрокаДопДанных.Значение = ВыборкаШапки.СведенияОТранспортировкеИГрузе;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.ИныеСведенияОбОтгрузке) Тогда
		СтрокаДопДанных = ДопДанные.Добавить();
		СтрокаДопДанных.Идентификатор = "ИныеСведенияОбОтгрузке";
		СтрокаДопДанных.Значение = ВыборкаШапки.ИныеСведенияОбОтгрузке;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДопДанные) Тогда
		ЭлектронноеВзаимодействие.ДобавитьДопДанныеВДерево(ДеревоДанных, ДопДанные, Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПередачаРаботИсполнитель(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ)
	
	СтруктураДанных = Документы[СсылкаНаОбъект.Метаданные().Имя].ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();
	
	Если ВыборкаШапки.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		ВидОперацииЭД = Перечисления.ВидыОперацийЭД.Исправление;
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерАкта",
			ВыборкаШапки.НомерИсходногоДокумента, ПараметрыОбработкиОшибок);
			
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ДатаИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаАкта",
			ВыборкаШапки.ДатаИсходногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсправления");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления",
			ВыборкаШапки.НомерИсправления, ПараметрыОбработкиОшибок);
			
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Дата");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления",
			ВыборкаШапки.ДатаИсправления, ПараметрыОбработкиОшибок);
	Иначе
		ВидОперацииЭД = Перечисления.ВидыОперацийЭД.ПродажаКомиссия;
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерЭД");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерАкта", ВыборкаШапки.Номер,
			ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Дата");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаАкта", ВыборкаШапки.Дата,
			ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации", ВидОперацииЭД);
	
	// Обработка ошибки с указанием расширенного текста сообщения вместо параметров обработки ошибки.
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить код валюты документа. Проверьте, что:
	|	- в документе указана валюта,
	|	- для нее заполнен код по Общероссийскому классификатору валют.'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", ВыборкаШапки.ВалютаКод, ТекстОшибки);
		
	Если ЗначениеЗаполнено(ВыборкаШапки.ДоговорКонтрагента) Тогда
		
		ОснованияОтгрузки = Новый ТаблицаЗначений;
		ОснованияОтгрузки.Колонки.Добавить("ДоговорКонтрагента");
		ОснованияОтгрузки.Колонки.Добавить("ДокОснованиеНаименование");
		ОснованияОтгрузки.Колонки.Добавить("ДокОснованиеНомер");
		ОснованияОтгрузки.Колонки.Добавить("ДокОснованиеДата");
		
		НоваяСтрока = ОснованияОтгрузки.Добавить();
		НоваяСтрока.ДоговорКонтрагента       = ВыборкаШапки.ДоговорКонтрагента;
		НоваяСтрока.ДокОснованиеНаименование = ВыборкаШапки.НаименованиеДоговора;
		НоваяСтрока.ДокОснованиеНомер        = ВыборкаШапки.НомерДоговора;
		НоваяСтрока.ДокОснованиеДата         = ВыборкаШапки.ДатаДоговора;
		
		// Дополним таблицу оснований параметрами обработки ошибок.
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(НоваяСтрока,
			"ДокОснованиеНаименование", "ДоговорКонтрагента", "Объект.Наименование");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(НоваяСтрока,
			"ДокОснованиеНомер", "ДоговорКонтрагента", "Объект.НомерДоговора");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(НоваяСтрока,
			"ДокОснованиеДата", "ДоговорКонтрагента", "Объект.ДатаДоговора");
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ОснованияОтгрузки, "Основание");
		
	Иначе
		
		// Заполнение параметров ошибки для полей, для которых это обязательно при отсутствии данных для них.
		ТекстОшибки = НСтр("ru = 'Возникла ошибка при заполнении основания отгрузки. Возможные причины:
		|	- в документе отгрузки не указан договор
		|	- в в договоре не указана дата'");
		ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных,
			"Основание.НомерСтроки.ДокОснованиеДата",ТекстОшибки);
		
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснования", ВыборкаШапки.ДокументОснование);
	
	ТекстЗаголовка = НСтр("ru = 'Мы, нижеподписавшиеся, представитель ИСПОЛНИТЕЛЯ, с одной стороны и представитель ЗАКАЗЧИКА с другой
						|стороны, составили настоящий акт в том, что ИСПОЛНИТЕЛЬ выполнил, а ЗАКАЗЧИК принял следующие работы (услуги).'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "Заголовок", ТекстЗаголовка);
	
	СведенияОИсполнителе = Неопределено;
	Если ЗначениеЗаполнено(ВыборкаШапки.Организация) Тогда
		СведенияОИсполнителе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Организация, СведенияОИсполнителе);
		Если ПравоДоступа("Чтение", Метаданные.Справочники.БанковскиеСчета)
			И ЗначениеЗаполнено(ВыборкаШапки.БанковскийСчетОрганизации) Тогда
			Справочники.БанковскиеСчета.ЗаполнитьРеквизитыБанковскогоСчета(СведенияОИсполнителе, ВыборкаШапки.БанковскийСчетОрганизации);
		КонецЕсли;
		ЗаполнитьДанныеУчастника(ДеревоДанных, СведенияОИсполнителе, "Исполнитель");
		
		НаименованиеСоставителяДокумента = СведенияОИсполнителе.ПолноеНаименование + ?(ЗначениеЗаполнено(
			СведенияОИсполнителе.КПП), СтрШаблон(НСтр("ru = ', ИНН/КПП %1/%2'"), СведенияОИсполнителе.ИНН,
			СведенияОИсполнителе.КПП), СтрШаблон(НСтр("ru = ', ИНН %1'"), СведенияОИсполнителе.ИНН));

		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			ВыборкаШапки.Ссылка, "Объект.Организация");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
					ДеревоДанных, "НаименованиеСоставителяДокумента", НаименованиеСоставителяДокумента,
			ПараметрыОбработкиОшибок);
		
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(ВыборкаШапки.Ссылка, 
			"Объект.Организация");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"Исполнитель", СведенияОИсполнителе, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	СведенияОЗаказчике = Неопределено;
	Если ЗначениеЗаполнено(ВыборкаШапки.Контрагент) Тогда
		СведенияОЗаказчике = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Контрагент, СведенияОЗаказчике);
		Если ПравоДоступа("Чтение", Метаданные.Справочники.БанковскиеСчета)
			И ЗначениеЗаполнено(ВыборкаШапки.БанковскийСчетКонтрагента) Тогда
			Справочники.БанковскиеСчета.ЗаполнитьРеквизитыБанковскогоСчета(СведенияОЗаказчике, ВыборкаШапки.БанковскийСчетКонтрагента);
		КонецЕсли;
		ЗаполнитьДанныеУчастника(ДеревоДанных, СведенияОЗаказчике, "Заказчик");
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(ВыборкаШапки.Ссылка, 
			"Объект.Контрагент");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"Заказчик", СведенияОЗаказчике, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	ТаблицаУслуг = Новый ТаблицаЗначений();
	ТаблицаУслуг.Колонки.Добавить("НомерСтроки");
	ТаблицаУслуг.Колонки.Добавить("Номенклатура");
	ТаблицаУслуг.Колонки.Добавить("НаименованиеНоменклатуры");
	ТаблицаУслуг.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаУслуг.Колонки.Добавить("ЕдиницаИзмеренияКод");
	ТаблицаУслуг.Колонки.Добавить("ЕдиницаИзмеренияНаименование");
	ТаблицаУслуг.Колонки.Добавить("Количество");
	ТаблицаУслуг.Колонки.Добавить("Цена");
	ТаблицаУслуг.Колонки.Добавить("СуммаБезНДС");
	ТаблицаУслуг.Колонки.Добавить("СтавкаНДС");
	ТаблицаУслуг.Колонки.Добавить("СуммаНДС");
	ТаблицаУслуг.Колонки.Добавить("СуммаСНДС");
	ТаблицаУслуг.Колонки.Добавить("Описание");
	ТаблицаУслуг.Колонки.Добавить("ДокументОснование");
	ТаблицаУслуг.Колонки.Добавить("ДопДанныеПодписанные");
	ТаблицаУслуг.Колонки.Добавить("ДопДанныеНеПодписанные");
	ТаблицаУслуг.Колонки.Добавить("Сопоставление");
	ТаблицаУслуг.Колонки.Добавить("Характеристика");
	
	НомерСтроки = 1;
	ВыборкаТоваров = СтруктураДанных.ВыборкаТоваров;
	
	ШтрихкодыКомбинаций   = Неопределено;
	ШтрихкодыНоменклатуры = Неопределено;
	Если НЕ СтруктураДанных.Свойство("ШтрихкодыНоменклатуры", ШтрихкодыНоменклатуры)
		ИЛИ НЕ СтруктураДанных.Свойство("ШтрихкодыКомбинаций", ШтрихкодыКомбинаций) Тогда
		ШтрихкодыПоТоварам(ВыборкаТоваров, ШтрихкодыКомбинаций, ШтрихкодыНоменклатуры);
	КонецЕсли;
	
	Пока ВыборкаТоваров.Следующий() Цикл
		
		НоваяСтрока = ТаблицаУслуг.Добавить();
		НоваяСтрока.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
		
		НоваяСтрока.Номенклатура                 = ВыборкаТоваров.Номенклатура;
		НоваяСтрока.НаименованиеНоменклатуры     = КлиентЭДОКлиентСервер.ПредставлениеНоменклатурыДляЭД(ВыборкаТоваров);
		НоваяСтрока.Описание                     = ВыборкаТоваров.Содержание;
		НоваяСтрока.ЕдиницаИзмерения             = ВыборкаТоваров.ЕдиницаИзмерения;
		НоваяСтрока.ЕдиницаИзмеренияКод          = ВыборкаТоваров.ЕдиницаИзмеренияКод;
		НоваяСтрока.ЕдиницаИзмеренияНаименование = ВыборкаТоваров.ЕдиницаИзмеренияНаименование;
		НоваяСтрока.Количество                   = ВыборкаТоваров.КоличествоУпаковок;
		НоваяСтрока.Цена                       = ?(ВыборкаТоваров.КоличествоУпаковок = 0, 0,
			Окр(ВыборкаТоваров.СуммаБезНДС / ВыборкаТоваров.КоличествоУпаковок, 2));
		НоваяСтрока.СуммаБезНДС                  = ВыборкаТоваров.СуммаБезНДС;
		НоваяСтрока.СтавкаНДС                    = ВыборкаТоваров.СтавкаНДС;
		НоваяСтрока.СуммаНДС                     = ВыборкаТоваров.СуммаНДС;
		НоваяСтрока.СуммаСНДС                    = ВыборкаТоваров.СуммаСНДС;
		НоваяСтрока.Характеристика               = ВыборкаТоваров.Характеристика;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.Количество) И Не ЗначениеЗаполнено(НоваяСтрока.Описание) Тогда
			НоваяСтрока.Описание = НоваяСтрока.НаименованиеНоменклатуры;
		КонецЕсли;
		
		НаименованиеДляСопоставления = ВыборкаТоваров.НаименованиеПолное;
		Если Не ЗначениеЗаполнено(НоваяСтрока.Количество) И ЗначениеЗаполнено(НоваяСтрока.Описание) Тогда
			НоваяСтрока.НаименованиеНоменклатуры = "";
			НаименованиеДляСопоставления = Лев(НоваяСтрока.Описание, 1000);
		КонецЕсли;
		
		Сопоставление = Новый Структура;
		Сопоставление.Вставить("Наименование", НаименованиеДляСопоставления);
		Если ЗначениеЗаполнено(НоваяСтрока.Характеристика) Тогда
			Сопоставление.Вставить("Характеристика", ВыборкаТоваров.ХарактеристикаНаименование);
		КонецЕсли;
		Сопоставление.Вставить("ЕдиницаИзмерения", НоваяСтрока.ЕдиницаИзмеренияНаименование);
		Сопоставление.Вставить("Артикул", ВыборкаТоваров.НоменклатураАртикул);
		Сопоставление.Вставить("ЕдиницаИзмеренияКод", ВыборкаТоваров.ЕдиницаИзмеренияКод);
		Сопоставление.Вставить("СтавкаНДС", ВыборкаТоваров.НоменклатураСтавкаНДС);
		
		Сопоставление.Вставить("НоменклатураИБ", ВыборкаТоваров.Номенклатура);
		Сопоставление.Вставить("ХарактеристикаИБ", ВыборкаТоваров.Характеристика);
		Сопоставление.Вставить("УпаковкаИБ", ВыборкаТоваров.ЕдиницаИзмерения);
		
		ЗаполнитьШтрихкодыТоваровВСопоставление(Сопоставление, ШтрихкодыНоменклатуры, ШтрихкодыКомбинаций,
				ВыборкаТоваров.Номенклатура, ВыборкаТоваров.Характеристика, ВыборкаТоваров.ЕдиницаИзмерения);
		
		НоваяСтрока.Сопоставление = Сопоставление;
		
	КонецЦикла;
	
	// Обработка ошибки через механизм сообщений пользователю.
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаУслуг,
		"НаименованиеНоменклатуры", "Номенклатура", "Объект.НаименованиеПолное");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаУслуг,
		"Количество", ВыборкаТоваров.Ссылка, "Объект.Товары.КоличествоУпаковок",, "НомерСтроки");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаУслуг,
		"Цена", ВыборкаТоваров.Ссылка, "Объект.Товары.Цена",, "НомерСтроки");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаУслуг,
		"СуммаБезНДС", ВыборкаТоваров.Ссылка, "Объект.Товары.Сумма",, "НомерСтроки");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаУслуг,
		"СуммаНДС", ВыборкаТоваров.Ссылка, "Объект.Товары.СуммаНДС",, "НомерСтроки");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаУслуг,
		"СуммаСНДС", ВыборкаТоваров.Ссылка, "Объект.Товары.Сумма",, "НомерСтроки");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаУслуг,
		"ЕдиницаИзмеренияНаименование", "ЕдиницаИзмерения", "Объект.Наименование");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаУслуг,
		"ЕдиницаИзмеренияКод", "ЕдиницаИзмерения", "Объект.Код");
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаУслуг, "ТаблицаУслуг");
	
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить итоговые показатели. Возможные причины:
		|	- не заполнена табличная часть ""Услуги""
		|	- не заполнены колонки ""Сумма"", ""НДС"", ""Количество""'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ОписаниеУслуги.СуммаБезНДСИтого",
		ТаблицаУслуг.Итог("СуммаБезНДС"), ТекстОшибки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ОписаниеУслуги.СуммаНДСИтого",
		ТаблицаУслуг.Итог("СуммаНДС"), ТекстОшибки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ОписаниеУслуги.СуммаСНДСИтого",
		ВыборкаШапки.СуммаДокумента, ТекстОшибки);
	
	ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		СсылкаНаОбъект, "Объект.ДатаОтгрузки");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияПоВыполнениюУслуг.ДатаИсполнения",
		ВыборкаШапки.ДатаОтгрузки, ПараметрыОбработкиОшибок);
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеВДеревеДанныхАктаОРасхождениях(СтрокаТовара, ТаблицаКодовДокумента,
	ИмяТаблицыМаркировки, ИдентификаторСтроки = "")

	ТаблицаКодов = Новый ТаблицаЗначений;
	ТаблицаКодов.Колонки.Добавить("Код");
	
	СведенияОМаркировке = Новый Структура;
	СведенияОМаркировке.Вставить("ИндивидуальныеУпаковки", ТаблицаКодов.Скопировать());
	СтрокаТовара[ИмяТаблицыМаркировки] = СведенияОМаркировке;
	
	ПараметрыПоиска = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	
	СтрокиУпаковок = ТаблицаКодовДокумента.НайтиСтроки(ПараметрыПоиска);
	Для Каждого СтрокаУпаковки Из СтрокиУпаковок Цикл
		НоваяСтрока = СведенияОМаркировке.ИндивидуальныеУпаковки.Добавить();
		НоваяСтрока.Код = СтрокаУпаковки.НомерУпаковки;
	КонецЦикла;
	
КонецПроцедуры

// Заполняет табличную часть "Товары" первичного документа или счет-фактуры на основании сведений из дерева данных
Процедура ЗаполнитьТоварыУКД(ДеревоДанных, ДокументОбъект, СуммаДокумента, ОблагаетсяНДСУПокупателя, ИспользоватьСопоставлениеНоменклатуры, КоличествоТовараНеУказано) 
	
	ТаблицаТовары = ДокументОбъект.Товары.ВыгрузитьКолонки();
	
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(ТаблицаТовары);
	
	СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
	
	ИспользуетсяГосИС = КлиентЭДОВызовСервера.ИспользуетсяГосИС();
	Если ИспользуетсяГосИС Тогда
		ШтрихкодыУпаковок = ЭлектронноеВзаимодействиеИСМП.НоваяТаблицаШтрихкодыУпаковок(Истина);
		
		Если ТипЗнч(ДокументОбъект.ДокументОснование) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			ШтрихкодыУпаковокОснования = ШтрихкодированиеИСМПСлужебный.ДанныеМаркируемойНоменклатурыКодовМаркировкиПоДаннымЭДО(ДокументОбъект.ДокументОснование);
			Если ШтрихкодыУпаковокОснования <> Неопределено Тогда
				ШтрихкодыУпаковокОснования.Индексы.Добавить("Номенклатура, Характеристика");
			Иначе
				ШтрихкодыУпаковокОснования = ШтрихкодыУпаковок.СкопироватьКолонки();
			КонецЕсли;
		Иначе
			ШтрихкодыУпаковокОснования = ШтрихкодыУпаковок.СкопироватьКолонки();
		КонецЕсли;
		
		ТоварыДокументаОснования = ДокументОбъект.ДокументОснование.Товары.Выгрузить();
		
	КонецЕсли;
	
	Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
		НоваяСтрока = ТаблицаТовары.Добавить();
		
		НоваяСтрока.КоличествоУпаковокДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СведенияОТоваре, "СведенияОТоварах.НомерСтроки.КоличествоДоКорректировки");
		НоваяСтрока.КоличествоУпаковок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СведенияОТоваре, "СведенияОТоварах.НомерСтроки.Количество");
		НоваяСтрока.ЦенаДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмеренияДоКорректировки");
		НоваяСтрока.Цена = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмерения");
		НоваяСтрока.СуммаДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СведенияОТоваре, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалогаДоКорректировки");
		НоваяСтрока.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СведенияОТоваре, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
		НоваяСтрока.СуммаАкцизаДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СведенияОТоваре, "СведенияОТоварах.НомерСтроки.СуммаАкцизаДоКорректировки");
		НоваяСтрока.СуммаАкциза = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СведенияОТоваре, "СведенияОТоварах.НомерСтроки.СуммаАкциза");
		
		СтавкаНДСДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СведенияОТоваре, "СведенияОТоварах.НомерСтроки.НалоговаяСтавкаДоКорректировки");
		СтавкаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СведенияОТоваре, "СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
		Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
			НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
			ОблагаетсяНДСУПокупателя = Истина;
			
		Иначе
			НоваяСтрока.СтавкаНДСДоКорректировки = СтавкаНДСДоКорректировки;
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаСНДСДоКорректировки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогомДоКорректировки");
			НоваяСтрока.СуммаСНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
			НоваяСтрока.СуммаНДСДоКорректировки  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.СуммаНалогаДоКорректировки");
			НоваяСтрока.СуммаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.СуммаНалога");
			
		КонецЕсли;
		
		СуммаДокумента = СуммаДокумента + НоваяСтрока.СуммаСНДС;
		
		КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(НоваяСтрока);
		
		Если Не ИспользуетсяГосИС Тогда
		ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокументаУКД_2020(ДокументОбъект, НоваяСтрока, СведенияОТоваре,
			"КодыУпаковокМаркируемойПродукцииДоКорректировки", "СведенияОМаркировкеДо");
		ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокументаУКД_2020(ДокументОбъект, НоваяСтрока, СведенияОТоваре,
			"КодыУпаковокМаркируемойПродукции", "СведенияОМаркировкеПосле");
		КонецЕсли;
		
		Сопоставление = СведенияОТоваре.Строки.Найти(
			"СведенияОТоварах.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
		Если Сопоставление <> Неопределено Тогда
			Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.Сопоставление.Идентификатор");
			Если ЗначениеЗаполнено(Идентификатор) Тогда
				НоваяСтрока.ИдентификаторКонтрагента = Идентификатор;
				
			КонецЕсли;
			
			Если ИспользоватьСопоставлениеНоменклатуры Тогда
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СведенияОТоваре, "СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
					
				КонецЕсли;
				
				Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СведенияОТоваре, "СведенияОТоварах.НомерСтроки.Сопоставление.ХарактеристикаИБ");
				Если ЗначениеЗаполнено(Характеристика) Тогда
					НоваяСтрока.Характеристика = Характеристика;
					
				КонецЕсли;
			КонецЕсли;
			
			ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.Сопоставление.УпаковкаИБ");
			Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
				НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
			ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод");
			
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
				Если ИспользоватьСопоставлениеНоменклатуры Тогда
					НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.УпаковкаНоменклатуры(
						НоваяСтрока.Номенклатура, ЕдиницаИзмеренияКод);
				Иначе
					НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.ЕдиницаИзмеренияПоКоду(
						ЕдиницаИзмеренияКод);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ИспользуетсяГосИС Тогда
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Номенклатура", НоваяСтрока.Номенклатура);
			Если ЗначениеЗаполнено(НоваяСтрока.Характеристика) Тогда
				ПараметрыОтбора.Вставить("Характеристика", НоваяСтрока.Характеристика);
			КонецЕсли;
			Если ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
				ПараметрыОтбора.Вставить("ЕдиницаИзмерения", НоваяСтрока.ЕдиницаИзмерения);
			КонецЕсли;
			
			НайденнаяСтрокаТоваров = ТоварыДокументаОснования.НайтиСтроки(ПараметрыОтбора);
			Если НайденнаяСтрокаТоваров.Количество() Тогда
				Для Каждого Строка Из НайденнаяСтрокаТоваров Цикл
					ТоварыДокументаОснования.Удалить(Строка);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		НаименованиеТовара = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ТоварНаименование");
		Если НаименованиеТовара = Неопределено Тогда
			НаименованиеТовара = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.ХарактеристикаОписаниеТовара");
			Если НаименованиеТовара = Неопределено Тогда
				НаименованиеТовара = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.КодТовара");
				Если НаименованиеТовара = Неопределено Тогда
					НаименованиеТовара = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.АртикулТовара");
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НаименованиеТовара) Тогда
			НоваяСтрока.НаименованиеКонтрагента = ПредставлениеНоменклатурыПоставщика(НаименованиеТовара);
			
			Если Не ТаблицаТовары.Колонки.Найти("НаименованиеПоставщика") = Неопределено Тогда
				НоваяСтрока.НаименованиеПоставщика = ПредставлениеНоменклатурыПоставщика(НаименованиеТовара);
			КонецЕсли;		
			
			Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
				НоваяСтрока.Содержание = ПредставлениеНоменклатурыПоставщика(НаименованиеТовара);
			КонецЕсли;
			
		КонецЕсли;
		
		Если НоваяСтрока.КоличествоУпаковокДоКорректировки Или НоваяСтрока.Количество Тогда
			КоличествоТовараНеУказано = Ложь
			
		КонецЕсли;
		
		НоваяСтрока.КодТНВЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "СведенияОТоварах.НомерСтроки.КодВидаТовара");
		
		Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда 
			ЗаполнитьВидДеятельностиРаздельногоУчетаНДС(НоваяСтрока);
		КонецЕсли;
		
		ЗаполнитьСведенияПрослеживаемостиИзДереваЭлектронногоДокумента(ДокументОбъект, НоваяСтрока, СведенияОТоваре);
		
		РассчитатьКоличествоБазовыхЕдиниц(НоваяСтрока);
		
		Если ИспользуетсяГосИС Тогда
			ЭлектронноеВзаимодействиеИСМП.ДобавитьШтрихкодыТаблицуШтрихкодовУпаковок_УКД2020(ШтрихкодыУпаковок, СведенияОТоваре, ШтрихкодыУпаковокОснования, НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(ТаблицаТовары, ДокументОбъект.Контрагент);
	
	Если ИспользуетсяГосИС Тогда
		Для Каждого ТекСтрока Из ТаблицаТовары Цикл 
			// заполним Количество с учетом единиц измерения
			Если ЗначениеЗаполнено(ТекСтрока.ЕдиницаИзмерения) Тогда
				ТекКоэффициент = Справочники.ЕдиницыИзмерения.КоличествоБазовыхЕдиницВУпаковке(ТекСтрока.ЕдиницаИзмерения);
			Иначе
				ТекКоэффициент = 1;
			КонецЕсли;
			ТекСтрока.Количество = ТекСтрока.КоличествоУпаковок * ТекКоэффициент;
		КонецЦикла;
		
		Для Каждого СтрокаТЧоснования Из ТоварыДокументаОснования Цикл
			ДобавляемаяСтрока = ТаблицаТовары.Добавить();
			ЗаполнитьЗначенияСвойств(ДобавляемаяСтрока, СтрокаТЧоснования);
			ЭлектронноеВзаимодействиеИСМП.ДобавитьШтрихкодыПоДокументуОснованию_УКД(ШтрихкодыУпаковок, ШтрихкодыУпаковокОснования, ДобавляемаяСтрока);
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ШтрихкодыУпаковок) Тогда
			ЭлектронноеВзаимодействиеИСМП.НормализоватьШтрихкодыУпаковокУКД(ШтрихкодыУпаковок);
			ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ШтрихкодыУпаковок);
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект.Товары.Загрузить(ТаблицаТовары);
	
КонецПроцедуры

Процедура ЗаполнитьВидДеятельностиРаздельногоУчетаНДС(НоваяСтрока) 
	
	Если НоваяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
		НоваяСтрока.ВозвратПодДеятельность = Перечисления.ВидыДеятельностиРаздельногоУчетаНДС.НеОблагаетсяНДС;
		
	Иначе
		НоваяСтрока.ВозвратПодДеятельность = Перечисления.ВидыДеятельностиРаздельногоУчетаНДС.ОблагаетсяНДС;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура РассчитатьКоличествоБазовыхЕдиниц(СтрокаТаблицыДокумента)
	
	Коэффициент = 1;
	Если ЗначениеЗаполнено(СтрокаТаблицыДокумента.ЕдиницаИзмерения) Тогда
		Коэффициент = Справочники.ЕдиницыИзмерения.КоличествоБазовыхЕдиницВУпаковке(СтрокаТаблицыДокумента.ЕдиницаИзмерения)
	КонецЕсли;
		
	СтрокаТаблицыДокумента.Количество = Коэффициент * СтрокаТаблицыДокумента.КоличествоУпаковок;
	
КонецПроцедуры

Процедура ЗаполнитьНоменклатуруКонтрагентаВТаблицеТоваров(ТаблицаДокумента, Знач Контрагент)
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры")
		Или ТаблицаДокумента.Количество() = 0 Тогда
		
		Возврат;
	КонецЕсли;
	
	Товары = НовыйТаблицаТоваровДляСопоставления();
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		НоваяЗапись = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаДокумента);
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаДокумента, "ЕдиницаИзмерения") Тогда
			НоваяЗапись.Упаковка = СтрокаДокумента.ЕдиницаИзмерения;
		КонецЕсли;
	КонецЦикла;
	
	РезультатПоиска = СопоставлениеНоменклатурыКонтрагентов.РезультатЗапросаПоискаНоменклатурыКонтрагентаПоНоменклатуреИБ(
		Контрагент, Товары);
	Если РезультатПоиска.Пустой() Тогда
		Возврат;
	КонецЕсли;

	Сопоставления = РезультатПоиска.Выгрузить();
	Сопоставления.Индексы.Добавить("НомерСтроки");
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		СопоставлениеПоСтроке = Сопоставления.Найти(СтрокаДокумента.НомерСтроки, "НомерСтроки");
		Если СопоставлениеПоСтроке = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаДокумента.НоменклатураКонтрагента = СопоставлениеПоСтроке.НоменклатураКонтрагента;
	КонецЦикла;

КонецПроцедуры

Функция НовыйТаблицаТоваровДляСопоставления()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НомерСтроки",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0, ДопустимыйЗнак.Неотрицательный)));
	Результат.Колонки.Добавить("Номенклатура",
		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Характеристика",
		Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Результат.Колонки.Добавить("Упаковка",
		Новый ОписаниеТипов("СправочникСсылка.ЕдиницыИзмерения"));
	Результат.Колонки.Добавить("НоменклатураКонтрагента",
		Новый ОписаниеТипов("СправочникСсылка.НоменклатураКонтрагентов"));
	
	Возврат Результат;
	
КонецФункции

