				Если ВыборкаТоваров.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа Тогда
					ЕстьРаботы = Истина;
					НоваяСтрока.Признак = "2";
				Иначе
					ЕстьУслуги = Истина;
