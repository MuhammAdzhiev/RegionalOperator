// См. ОбменСКонтрагентамиПереопределяемый.СпособыОтраженияВУчетеТипаЭлектронногоДокумента.
Процедура СпособыОтраженияВУчетеТипаЭлектронногоДокумента(ТипДокумента, СписокСпособовОбработки) Экспорт 
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	Если ТипДокумента = ТипыДокументов.АктВыполненныхРабот Тогда
		
		СписокСпособовОбработки.Добавить("АктВыполненныхРабот", НСтр("ru = 'Акт выполненных работ'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.АктНаПередачуПрав Тогда
		
		СписокСпособовОбработки.Добавить("АктНаПередачуПрав", НСтр("ru = 'Акт на передачу прав'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.ТоварнаяНакладная Тогда
		
		СписокСпособовОбработки.Добавить("ПоступлениеТоваровУслуг", НСтр("ru = 'Товарная накладная'"), Истина);
		СписокСпособовОбработки.Добавить("ВозвратТоваровОтПокупателя", НСтр("ru = 'Накладная на возврат'"));
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СоглашениеОбИзмененииСтоимости Тогда
		
		СписокСпособовОбработки.Добавить("ПоступлениеТоваровУслуг", НСтр("ru = 'Акт, накладная (Корректировка)'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.КорректировочныйСчетФактура Тогда
		
		СписокСпособовОбработки.Добавить("СчетФактураПолученный", НСтр("ru = 'Счет-фактура полученный (Корректировка)'"),Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СчетФактура Тогда
		
		СписокСпособовОбработки.Добавить("СчетФактураПолученный", НСтр("ru = 'Счет-фактура полученный'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.КаталогТоваров Тогда
		
		СписокСпособовОбработки.Добавить("НоменклатураПоставщиков", НСтр("ru = 'Номенклатура поставщиков'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.ЗаказТовара Тогда
		
		СписокСпособовОбработки.Добавить("ЗаказПокупателя", НСтр("ru = 'Заказ покупателя'"),Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.ОтветНаЗаказ Тогда
		
		СписокСпособовОбработки.Добавить("ЗаказПоставщику", НСтр("ru = 'Заказ поставщику'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СчетНаОплату Тогда
		
		СписокСпособовОбработки.Добавить("СчетНаОплатуПоставщика", НСтр("ru = 'Счет от поставщика'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СчетОферта Тогда
		
		СписокСпособовОбработки.Добавить("СчетНаОплатуПоставщика", НСтр("ru = 'Счет от поставщика'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.АктОРасхождениях Тогда
		
		СписокСпособовОбработки.Добавить("АктОРасхожденияхПоОтгрузке", НСтр("ru = 'Акт о расхождениях по отгрузке'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.УПД Тогда
	
		СписокСпособовОбработки.Добавить("АктОРасхожденияхПоОтгрузке", НСтр("ru = 'Акт о расхождениях по отгрузке'"), Истина);
	
	ИначеЕсли ТипДокумента = ТипыДокументов.СведенияОРеализацииКомиссионером Тогда
	
		СписокСпособовОбработки.Добавить("СведенияОРеализацииКомиссионером", НСтр("ru = 'Товарная накладная'"), Истина);
	
	ИначеЕсли ТипДокумента = ТипыДокументов.СведенияОЗакупкеКомиссионером Тогда
	
		СписокСпособовОбработки.Добавить("СведенияОЗакупкеКомиссионером", НСтр("ru = 'Товарная накладная'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.КорректировкаСведенийОРеализацииКомиссионером Тогда
	
		СписокСпособовОбработки.Добавить("КорректировкаСведенийОРеализацииКомиссионером", НСтр("ru = 'Товарная накладная (Корректировка)'"), Истина);
	
	ИначеЕсли ТипДокумента = ТипыДокументов.КорректировкаСведенийОЗакупкеКомиссионером Тогда
	
		СписокСпособовОбработки.Добавить("КорректировкаСведенийОЗакупкеКомиссионером", НСтр("ru = 'Товарная накладная (Корректировка)'"), Истина);
	
	ИначеЕсли ТипДокумента = ТипыДокументов.ДоговорныйДокумент Тогда
	
		СписокСпособовОбработки.Добавить("ДоговорыКонтрагентов", НСтр("ru = 'Договор'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.АктСверкиВзаиморасчетов Тогда
		
		СписокСпособовОбработки.Добавить("АктСверкиВзаиморасчетов", НСтр("ru = 'Акт сверки взаиморасчетов'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.ТоварнаяНакладнаяРБ Тогда
		
		СписокСпособовОбработки.Добавить("ПоступлениеТоваровУслуг", НСтр("ru = 'Товарная накладная'"), Истина);
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.СписокВидовИсходящихДокументов.
Процедура СписокВидовИсходящихДокументов(ТипДокумента, СписокСпособовОбработки) Экспорт
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	Если ТипДокумента = ТипыДокументов.ТоварнаяНакладная Тогда
		
		СписокСпособовОбработки.Добавить("РеализацияТоваровУслуг", НСтр("ru = 'Товарная накладная'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СчетФактура Тогда
		
		СписокСпособовОбработки.Добавить("СчетФактураВыданный", НСтр("ru = 'Счет-фактура выданный'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.УПД Или ТипДокумента = ТипыДокументов.УКД Тогда
		
		СписокСпособовОбработки.Добавить("РеализацияТоваровУслуг", НСтр("ru = 'Товарная накладная'"), Истина);
		СписокСпособовОбработки.Добавить("СчетФактураВыданный", НСтр("ru = 'Счет-фактура выданный'"), Истина);
	
	ИначеЕсли ТипДокумента = ТипыДокументов.АктОРасхождениях Тогда
		
		СписокСпособовОбработки.Добавить("АктОРасхожденияхПоПриемке", НСтр("ru = 'Акт о расхождениях по приемке'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.АктВыполненныхРабот Тогда
		
		СписокСпособовОбработки.Добавить("РеализацияТоваровУслуг", НСтр("ru = 'Акт выполненных работ'"), Истина);
	
	ИначеЕсли ТипДокумента = ТипыДокументов.АктНаПередачуПрав Тогда
		
		СписокСпособовОбработки.Добавить("РеализацияТоваровУслуг", НСтр("ru = 'Акт на передачу прав'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СоглашениеОбИзмененииСтоимости Тогда
		
		СписокСпособовОбработки.Добавить("РеализацияТоваровУслуг", НСтр("ru = 'Акт, накладная (Корректировка)'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.КорректировочныйСчетФактура Тогда
		
		СписокСпособовОбработки.Добавить("СчетФактураВыданный", НСтр("ru = 'Счет-фактура выданный (Корректировка)'"), Истина);
		
	КонецЕсли;
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ИмяОбъектаМетаданныхПоСпособуОтраженияВУчете.
Процедура ИмяОбъектаМетаданныхПоСпособуОтраженияВУчете(СпособОбработки, ИмяДокумента) Экспорт 
	
	Если СпособОбработки = "ВозвратТоваровОтПокупателя"
		Или СпособОбработки = "АктВыполненныхРабот"
		Или СпособОбработки = "АктНаПередачуПрав" Тогда
		ИмяДокумента = "ПоступлениеТоваровУслуг";
	ИначеЕсли СпособОбработки = "СведенияОРеализацииКомиссионером"
		ИЛИ СпособОбработки = "КорректировкаСведенийОРеализацииКомиссионером" Тогда
		ИмяДокумента = "РеализацияТоваровУслуг";
	ИначеЕсли СпособОбработки = "СведенияОЗакупкеКомиссионером"
		ИЛИ СпособОбработки = "КорректировкаСведенийОЗакупкеКомиссионером" Тогда
		ИмяДокумента = "ПоступлениеТоваровУслуг";
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.СоответствиеИсходящихТиповЭлектронныхДокументовДокументамИБ.
Процедура СоответствиеИсходящихТиповЭлектронныхДокументовДокументамИБ(
	СоответствиеТиповЭлектронныхДокументовДокументамИБ) Экспорт 
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.ТоварнаяНакладная,
		НСтр("ru = 'Товарная накладная'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.АктВыполненныхРабот,
		НСтр("ru = 'Акт выполненных работ'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.АктНаПередачуПрав,
		НСтр("ru = 'Акт на передачу прав'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.СчетФактура,
		НСтр("ru = 'Счет-фактура'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.СоглашениеОбИзмененииСтоимости,
		НСтр("ru = 'Акт, накладная (Корректировка)'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.КорректировочныйСчетФактура,
		НСтр("ru = 'Счет-фактура (Корректировка)'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.КаталогТоваров,
		НСтр("ru = 'Каталог товаров (Настройка ЭДО)'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.ОтветНаЗаказ,
		НСтр("ru = 'Заказ покупателя'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.ЗаказТовара,
		НСтр("ru = 'Заказ поставщику'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.СчетНаОплату,
		НСтр("ru = 'Счет покупателю'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.СчетОферта,
		НСтр("ru = 'Счет-оферта'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.АктОРасхождениях,
		НСтр("ru = 'Акт о расхождениях по приемке'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.АктСверкиВзаиморасчетов,
		НСтр("ru = 'Акт сверки взаиморасчетов'"));
		
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.УПД,
		НСтр("ru = 'Акт/накладная + счет-фактура'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(ТипыДокументов.УКД,
		НСтр("ru = 'Акт/накладная + счет-фактура (Корректировка)'"));

	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(
		ТипыДокументов.СведенияОРеализацииКомиссионером,
		НСтр("ru = 'Сведения о реализации комиссионером'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(
		ТипыДокументов.СведенияОЗакупкеКомиссионером,
		НСтр("ru = 'Сведения о закупке комиссионером'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(
		ТипыДокументов.КорректировкаСведенийОРеализацииКомиссионером,
		НСтр("ru = 'Сведения о реализации комиссионером (Корректировка)'"));
	СоответствиеТиповЭлектронныхДокументовДокументамИБ.Вставить(
		ТипыДокументов.КорректировкаСведенийОЗакупкеКомиссионером,
		НСтр("ru = 'Сведения о закупке комиссионером (Корректировка)'"));
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриПолученииОписанияОснованияЭлектронногоДокумента.
Процедура ПриПолученииОписанияОснованияЭлектронногоДокумента(ОснованиеОбъект, Описание, СтандартнаяОбработка) Экспорт
	
	ТипОснования = ТипЗнч(ОснованиеОбъект);
	Если ТипОснования = Тип("ДокументОбъект.РеализацияТоваровУслуг") 
		Или ТипОснования = Тип("ДокументОбъект.СчетФактураВыданный")
		Или ТипОснования = Тип("ДокументСсылка.РеализацияТоваровУслуг") 
		Или ТипОснования = Тип("ДокументСсылка.СчетФактураВыданный")  Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Описание.Организация = ОснованиеОбъект.Организация;
		Описание.Контрагент  = ОснованиеОбъект.Контрагент;
		Описание.Дата  = ОснованиеОбъект.Дата;
		Описание.Номер = ОснованиеОбъект.ПредставлениеНомера;
		Описание.СуммаДокумента = ОснованиеОбъект.СуммаДокумента;
		Описание.Вид = СтрШаблон(НСтр("ru = '%1 (%2)'"),
			ОснованиеОбъект.ВидДокумента, ОснованиеОбъект.ВидОперации);
		Валюта = ОснованиеОбъект.Валюта;
		Если ТипЗнч(Валюта) = Тип("Строка") Тогда
			Описание.КодВалюты = Валюта;
		Иначе
			Описание.КодВалюты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Валюта,"Код");
		КонецЕсли;
		Описание.ЦенаВключаетНДС = ОснованиеОбъект.ЦенаВключаетНДС;
		Описание.СуммаНДСДокумента = ПолучитьСуммуНДСДокумента(ТипОснования, ОснованиеОбъект);
		
	ИначеЕсли ТипОснования = Тип("ДокументОбъект.ЗаказПоставщику")
		Или ТипОснования = Тип("ДокументОбъект.ЗаказПокупателя")
		Или ТипОснования = Тип("ДокументОбъект.СчетНаОплатуПокупателю")
		Или ТипОснования = Тип("ДокументСсылка.ЗаказПоставщику")
		Или ТипОснования = Тип("ДокументСсылка.ЗаказПокупателя")
		Или ТипОснования = Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Описание.Организация = ОснованиеОбъект.Организация;
		Описание.Контрагент  = ОснованиеОбъект.Контрагент;
		Описание.Дата  = ОснованиеОбъект.Дата;
		Описание.Номер = ОснованиеОбъект.НомерЭД;
		Описание.СуммаДокумента = ОснованиеОбъект.СуммаДокумента;
		Описание.Вид = ОснованиеОбъект.ВидДокумента;
		Валюта = ОснованиеОбъект.Валюта;
		Если ТипЗнч(Валюта) = Тип("Строка") Тогда
			Описание.КодВалюты = Валюта;
		Иначе
			Описание.КодВалюты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Валюта,"Код");
		КонецЕсли;
		Описание.ЦенаВключаетНДС = ОснованиеОбъект.ЦенаВключаетНДС;
		Описание.СуммаНДСДокумента = ОснованиеОбъект.Товары.Итог("СуммаНДС");
		
	ИначеЕсли ТипОснования = Тип("ДокументОбъект.АктОРасхожденияхПоПриемке") 
		Или ТипОснования = Тип("ДокументСсылка.АктОРасхожденияхПоПриемке") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		СуммаДокументаСНДС = ОснованиеОбъект.Товары.Итог("СуммаСНДС");
		СуммаДокумента = ОснованиеОбъект.Товары.Итог("Сумма");
		
		Описание.Организация = ОснованиеОбъект.Организация;
		Описание.Контрагент  = ОснованиеОбъект.Контрагент;
		Описание.Дата = ОснованиеОбъект.Дата;
		Описание.Номер = ОснованиеОбъект.ПредставлениеНомера;
		Описание.СуммаДокумента = СуммаДокументаСНДС;
		Валюта = ОснованиеОбъект.Валюта;
		Если ТипЗнч(Валюта) = Тип("Строка") Тогда
			Описание.КодВалюты = Валюта;
		Иначе
			Описание.КодВалюты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Валюта,"Код");
		КонецЕсли;
		Описание.СуммаНДСДокумента = ОснованиеОбъект.Товары.Итог("СуммаНДС");
				
		Если СуммаДокумента = СуммаДокументаСНДС Тогда 
			Описание.ЦенаВключаетНДС = Истина;
		Иначе 
			Описание.ЦенаВключаетНДС = Ложь;
		КонецЕсли;
		
	ИначеЕсли ТипОснования = Тип("СправочникОбъект.ДоговорыКонтрагентов") 
		Или ТипОснования = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Описание.Организация = ОснованиеОбъект.Организация;
		Описание.Контрагент  = ОснованиеОбъект.Владелец;
		Описание.Дата = ОснованиеОбъект.ДатаДоговора;
		Описание.Номер = ОснованиеОбъект.НомерДоговора;
		
		Если ОснованиеОбъект.СуммаВключаетНДС Тогда
			Описание.СуммаДокумента = ОснованиеОбъект.Сумма;
		Иначе
			Описание.СуммаДокумента = ОснованиеОбъект.Сумма + ОснованиеОбъект.СуммаНДС;
		КонецЕсли;
		Валюта = ОснованиеОбъект.ВалютаРасчетов;
		Если ТипЗнч(Валюта) = Тип("Строка") Тогда
			Описание.КодВалюты = Валюта;
		Иначе
			Описание.КодВалюты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Валюта,"Код");
		КонецЕсли;
		Описание.ЦенаВключаетНДС = ОснованиеОбъект.СуммаВключаетНДС;
		Описание.СуммаНДСДокумента = ОснованиеОбъект.СуммаНДС;
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПослеФормированияЭлектронногоДокумента.
Процедура ПослеФормированияЭлектронногоДокумента(ЭлектронныйДокумент) Экспорт
	
	Если Не КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ЭлектронныйДокумент) = Тип("ДокументСсылка.ЭлектронныйДокументИсходящийЭДО") Тогда
		ОбъектыУчета = ОбменСКонтрагентами.СведенияОбЭлектронномДокументе(ЭлектронныйДокумент).ОбъектыУчета;
		ДокументыПоТипам = Новый Соответствие;
		Для Каждого ДокументОснование Из ОбъектыУчета Цикл
			ТипОснования = ТипЗнч(ДокументОснование);
			Элемент = ДокументыПоТипам.Получить(ТипОснования);
			Если Элемент = Неопределено Тогда
				Элемент = Новый Массив;
			КонецЕсли;
			Элемент.Добавить(ДокументОснование);
			ДокументыПоТипам.Вставить(ТипОснования, Элемент);
		КонецЦикла;
		
		СчетаФактуры = ДокументыПоТипам.Получить(Тип("ДокументСсылка.СчетФактураВыданный"));
		Если СчетаФактуры<>Неопределено Тогда
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Ссылка", СчетаФактуры);
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	СчетФактураВыданныйДокументыОснования.ДокументОснование КАК ДокументОснование
			|ИЗ
			|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
			|ГДЕ
			|	СчетФактураВыданныйДокументыОснования.Ссылка В(&Ссылка)";
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				ТипОснования = ТипЗнч(Выборка.ДокументОснование);
				Элемент = ДокументыПоТипам.Получить(ТипОснования);
				Если Элемент = Неопределено Тогда
					Элемент = Новый Массив;
				КонецЕсли;
				Элемент.Добавить(Выборка.ДокументОснование);
				ДокументыПоТипам.Вставить(ТипОснования, Элемент);
			КонецЦикла;
		КонецЕсли;
		
		ТипыКПроверке = Новый Массив;
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ТипыКПроверке, Метаданные.ОпределяемыеТипы.ОснованиеОтгрузкаТоваровИСМП.Тип.Типы());
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ТипыКПроверке, Метаданные.ОпределяемыеТипы.ОснованиеВыводаИзОборотаИСМП.Тип.Типы());
		
		Для Каждого Тип Из ТипыКПроверке Цикл
			ДокументыТипа = ДокументыПоТипам.Получить(Тип);
			Если ДокументыТипа<>Неопределено Тогда
				РасчетСтатусовОформленияИСМП.РассчитатьСтатусыОформленияДокументов(ДокументыТипа);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	СоответствиеТребованиямГИСМТ.ПослеФормированияЭлектронногоДокумента(ЭлектронныйДокумент);	
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПослеЗагрузкиНовогоЭлектронногоДокумента.
Процедура ПослеЗагрузкиНовогоЭлектронногоДокумента(ЭлектронныйДокумент) Экспорт
	
	Если КлиентЭДОВызовСервера.ИспользуетсяГосИС()
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлектронныйДокумент, "СодержитМаркируемыеТовары")
		И ЗначениеЗаполнено(ЭлектронныйДокумент) Тогда
		МассивДокументов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЭлектронныйДокумент);
		УстановитьПривилегированныйРежим(Истина);
		СоответствиеТребованиямГИСМТ.ДобавитьВРегистрДляОтслеживанияСоответствияТребованиямГИСМТ(МассивДокументов);
	КонецЕсли;
	
КонецПроцедуры

