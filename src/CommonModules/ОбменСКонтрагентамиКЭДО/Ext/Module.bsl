		НоваяСтрока.НаименованиеЕдиницыИзмеренияПослеКорректировки = ВыборкаТоваров.ЕдиницаИзмеренияНаименование;
		Если ЗначениеЗаполнено(ВыборкаТоваров.КодТНВЭД) Тогда
			НоваяСтрока.КодВидаТовара = ВыборкаТоваров.КодТНВЭД;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаТоваров.НомерГТД) Или ЗначениеЗаполнено(ВыборкаТоваров.СтранаПроисхожденияКод) Тогда
			СведенияОТаможеннойДекларации = Новый ТаблицаЗначений;
			СведенияОТаможеннойДекларации.Колонки.Добавить(
				"СтранаПроисхожденияКод", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(3)));
			СведенияОТаможеннойДекларации.Колонки.Добавить(
				"ТаможеннаяДекларацияНомер", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(29)));
			СтрокаТД = СведенияОТаможеннойДекларации.Добавить();
			
			Если ЗначениеЗаполнено(ВыборкаТоваров.НомерГТД) Тогда
				СтрокаТД.ТаможеннаяДекларацияНомер = ВыборкаТоваров.НомерГТД;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаТоваров.СтранаПроисхожденияКод) Тогда
				СтрокаТД.СтранаПроисхожденияКод = ВыборкаТоваров.СтранаПроисхожденияКод;
			КонецЕсли;
			
			НоваяСтрока.СведенияОТаможеннойДекларации = СведенияОТаможеннойДекларации;
		КонецЕсли;
		
		Если ИспользуетсяГосИС Тогда
			// Маркировка
			ЭлектронноеВзаимодействиеИСМП.ЗаполнитьСведенияОМаркировкеУКД2020(НоваяСтрока, ВыборкаТоваров, ТаблицаКодовМаркировкиДоКорректировки, ТаблицаКодовМаркировки);
		Иначе
			ЗаполнитьРеквизитыМаркировкиВСтрокеТоваровУКД_2020(НоваяСтрока, ТаблицаКодовМаркировкиДоКорректировки, ВыборкаШапки.Ссылка, "СведенияОМаркировкеДо");
			ЗаполнитьРеквизитыМаркировкиВСтрокеТоваровУКД_2020(НоваяСтрока, ТаблицаКодовМаркировки, ВыборкаШапки.Ссылка, "СведенияОМаркировкеПосле");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураДанных.СведенияПрослеживаемости) Тогда
			Отбор = Новый Структура("ИдентификаторСтроки", ВыборкаТоваров.ИдентификаторСтроки);
			КоллекцияСведений = СтруктураДанных.СведенияПрослеживаемости.НайтиСтроки(Отбор);
			Если ЗначениеЗаполнено(КоллекцияСведений) Тогда
				НоваяСтрока.СведенияОПрослеживаемости = НоваяКорректировкаСведенийОПрослеживаемости();
				Для Каждого ТекущиеСведения Из КоллекцияСведений Цикл
					
					КоличествоУвеличение = Макс(ТекущиеСведения.КоличествоПрослеживаемости
						- ТекущиеСведения.КоличествоПрослеживаемостиДоКорректировки, 0);
					КоличествоУменьшение = Макс(ТекущиеСведения.КоличествоПрослеживаемостиДоКорректировки
						- ТекущиеСведения.КоличествоПрослеживаемости, 0);
					
					КоличествоУчетноеУвеличение = Макс(ТекущиеСведения.КоличествоУпаковок
						- ТекущиеСведения.КоличествоУпаковокДоКорректировки, 0);
					КоличествоУчетноеУменьшение = Макс(ТекущиеСведения.КоличествоУпаковокДоКорректировки
						- ТекущиеСведения.КоличествоУпаковок, 0);
						
					СтоимостьБезНДСУвеличение = Макс(ТекущиеСведения.СтоимостьБезНДС
						- ТекущиеСведения.СтоимостьБезНДСДоКорректировки, 0);
					СтоимостьБезНДСУменьшение = Макс(ТекущиеСведения.СтоимостьБезНДСДоКорректировки
						- ТекущиеСведения.СтоимостьБезНДС, 0);
					
					НовыеСведения = НоваяСтрока.СведенияОПрослеживаемости.Добавить();
					НовыеСведения.НомерТовара = ТекущиеСведения.РНПТ;
					НовыеСведения.ЕдиницаИзмеренияКод = ТекущиеСведения.ЕдиницаИзмеренияКод;
					НовыеСведения.КоличествоТовараДоИзменения = ТекущиеСведения.КоличествоПрослеживаемостиДоКорректировки;
					НовыеСведения.КоличествоТовараПослеИзменения = ТекущиеСведения.КоличествоПрослеживаемости;
					НовыеСведения.КоличествоТовараУвеличение = КоличествоУвеличение;
					НовыеСведения.КоличествоТовараУменьшение = КоличествоУменьшение;
					НовыеСведения.КоличествоТовараУчетноеДоИзменения = ТекущиеСведения.КоличествоУпаковокДоКорректировки;
					НовыеСведения.КоличествоТовараУчетноеПослеИзменения = ТекущиеСведения.КоличествоУпаковок;
					НовыеСведения.КоличествоТовараУчетноеУвеличение = КоличествоУчетноеУвеличение;
					НовыеСведения.КоличествоТовараУчетноеУменьшение = КоличествоУчетноеУменьшение;
					НовыеСведения.СтоимостьБезНДСДоИзменения = ТекущиеСведения.СтоимостьБезНДСДоКорректировки;
					НовыеСведения.СтоимостьБезНДСПослеИзменения = ТекущиеСведения.СтоимостьБезНДС;
					НовыеСведения.СтоимостьБезНДСУвеличение = СтоимостьБезНДСУвеличение;
					НовыеСведения.СтоимостьБезНДСУменьшение = СтоимостьБезНДСУменьшение;
					
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить итоговые стоимостные показатели. Возможные причины:
		|	- не заполнена табличная часть ""Товары""
