	КонецЕсли;
	Перевозчик = Неопределено;
	Если ЗначениеЗаполнено(ВыборкаШапка.Перевозчик) Тогда
		Перевозчик = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапка.Перевозчик, Перевозчик);
		ЗаполнитьДанныеУчастникаУПД(ДеревоДанных, Перевозчик, ОбщийПуть + "Перевозчик");
	КонецЕсли;
	//  Транспортный документ.
	ТранспортныйДокументНаименование = ?(ЗначениеЗаполнено(ВыборкаШапка.ТранспортныйДокументНаименование),
