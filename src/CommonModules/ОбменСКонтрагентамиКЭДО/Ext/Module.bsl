#Область СервисShare

// Заполняет присоединенные файлы к загруженному учетному документу через сервис 1С:Share.
// Возможна загрузка исходного файла электронного документа и его дополнительных файлов.
//
// Параметры:
//  СсылкаНаДокумент - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылка на объект учета.
//  ДополнительныеДанные - Структура - данные для заполнения электронного документа:
//    * ПараметрыЭлектронногоДокумента - см. ОтражениеВУчетеЭДО.НовыеПараметрыЭлектронногоДокумента
//    * ПараметрыСпособаОбмена - см. ОтражениеВУчетеЭДО.НовыеПараметрыСпособаОбмена
//
Процедура ЗаписатьПрисоединенныеФайлыКДокументуЧерезСервисShare(СсылкаНаДокумент, Знач ДополнительныеДанные)
	
	ПараметрыСпособаОбмена = ДополнительныеДанные.ПараметрыСпособаОбмена;
	
	Если ПараметрыСпособаОбмена.СпособОбмена <> ИнтеграцияShare.СпособОбмена() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЭлектронногоДокумента = ДополнительныеДанные.ПараметрыЭлектронногоДокумента;
	
	ДанныеОсновногоФайла = Неопределено;
	Если Не ПараметрыЭлектронногоДокумента.Свойство("ДанныеОсновногоФайла", ДанныеОсновногоФайла) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПравоДоступа("Добавление", Метаданные.Справочники.Файлы)
		Или (УправлениеДоступом.ОграничиватьДоступНаУровнеЗаписей() 
		И Не УправлениеДоступом.ИзменениеРазрешено(Справочники.ПапкиФайлов.Шаблоны)) Тогда
		
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Недостаточно прав доступа для добавления файлов. Не удалось добавить файлы к документу %1'",
			ОбщегоНазначения.КодОсновногоЯзыка()), СсылкаНаДокумент);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Добавление присоединенных файлов.'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Предупреждение, СсылкаНаДокумент.Метаданные(), , ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеОсновногоФайла.ДвоичныеДанные) = Тип("ДвоичныеДанные")
		И ЗначениеЗаполнено(ДанныеОсновногоФайла.ИмяФайла) Тогда
		
		ДвоичныеДанныеФайла = ДанныеОсновногоФайла.ДвоичныеДанные;
		ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
		ПараметрыФайла.ВладелецФайлов              = СсылкаНаДокумент;
		ПараметрыФайла.ВремяИзмененияУниверсальное = ТекущаяУниверсальнаяДата();
		ПараметрыФайла.Автор                       = Пользователи.АвторизованныйПользователь();
		
		ДанныеФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДанныеОсновногоФайла.ИмяФайла);
		ПараметрыФайла.ИмяБезРасширения   = ДанныеФайла.ИмяБезРасширения;
		ПараметрыФайла.РасширениеБезТочки = ОбщегоНазначенияКлиентСервер.РасширениеБезТочки(
			ДанныеФайла.Расширение);

		АдресДанныхДокумента = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла);
		РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресДанныхДокумента);
		
	КонецЕсли;
	
	Если ПараметрыСпособаОбмена.ДанныеСпособаОбмена = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСпособаОбмена = ПараметрыСпособаОбмена.ДанныеСпособаОбмена;
	
	Для Каждого СтрокаФайл Из ДанныеСпособаОбмена.ДополнительныеФайлыДокумента Цикл
		ДобавитьФайлКДокументу(СсылкаНаДокумент, СтрокаФайл.ДвоичныеДанныеФайла, СтрокаФайл.ИмяБезРасширения,
			СтрокаФайл.РасширениеБезТочки);
	КонецЦикла;

	Для Каждого СтрокаФайл Из ДанныеСпособаОбмена.ФайлыВизуализации Цикл
		ДобавитьФайлКДокументу(СсылкаНаДокумент, СтрокаФайл.ДвоичныеДанныеФайла, СтрокаФайл.ИмяБезРасширения,
			СтрокаФайл.Расширение);
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//  СсылкаНаДокумент - ОпределяемыйТип.ВладелецПрисоединенныхФайлов
//  ДвоичныеДанныеФайла - ДвоичныеДанные
//  ИмяБезРасширения - Строка
//  РасширениеБезТочки - Строка
Процедура ДобавитьФайлКДокументу(Знач СсылкаНаДокумент, Знач ДвоичныеДанныеФайла, Знач ИмяБезРасширения, Знач РасширениеБезТочки)
	
	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.ВладелецФайлов              = СсылкаНаДокумент;
	ПараметрыФайла.ВремяИзмененияУниверсальное = ТекущаяУниверсальнаяДата();
	ПараметрыФайла.Автор                       = Пользователи.АвторизованныйПользователь();
	ПараметрыФайла.ИмяБезРасширения            = ИмяБезРасширения;
	ПараметрыФайла.РасширениеБезТочки          = РасширениеБезТочки;

	АдресДанныхДокумента = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла);
	РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресДанныхДокумента);
	
КонецПроцедуры

#КонецОбласти

#Область АктСверкиВзаиморасчетов

// Параметры:
//  ТаблицаДляЗаполнения - ТаблицаЗначений - См. Документ.АктСверкиВзаиморасчетов.ДанныеОтправителя
//                                           См. Документ.АктСверкиВзаиморасчетов.ДанныеПолучателя
//  СведенияПоДоговорам - ДеревоЗначений - См. Обработка.ОбменСКонтрагентами.Макет.АктСверкиВзаиморасчетов_ИнформацияОтправителя_5_01
//                                         См. Обработка.ОбменСКонтрагентами.Макет.АктСверкиВзаиморасчетов_ИнформацияПолучателя_5_01
Процедура ЗаполнитьТаблицуАктаСверкиВзаиморасчетовПоДаннымОтправителяПолучателя(ТаблицаДляЗаполнения,
	СведенияПоДоговорам)
	
	Для Каждого ТекущийДоговор Из СведенияПоДоговорам Цикл
		
		Для Каждого ТекущийДокумент Из ТекущийДоговор.СведенияПоДокументам Цикл
			
			Для Каждого ТекущаяОперация Из ТекущийДокумент.СведенияПоОперациям Цикл
			
				НоваяСтрока = ТаблицаДляЗаполнения.Добавить();
				НоваяСтрока.НомерДоговора = ТекущийДоговор.НомерДоговора;
				НоваяСтрока.ДатаДоговора = ТекущийДоговор.ДатаДоговора;
				НоваяСтрока.НаименованиеДоговора = ТекущийДоговор.ОписаниеДоговора;
				
				НоваяСтрока.НомерДокумента = ТекущийДокумент.НомерДокумента;
				НоваяСтрока.ДатаДокумента = ТекущийДокумент.ДатаДокумента;
				НоваяСтрока.НаименованиеДокумента = ТекущийДокумент.НаименованиеДокумента;
			
				НоваяСтрока.ПорядковыйНомерОперации = ТекущаяОперация.ПорядковыйНомерСтроки;
				НоваяСтрока.ДатаОперации = ТекущаяОперация.ДатаОперации;
				НоваяСтрока.НаименованиеОперации = ТекущаяОперация.НаименованиеОперации;
				
				НоваяСтрока.Дебет = ТекущаяОперация.СуммаДебет;
				НоваяСтрока.Кредит = ТекущаяОперация.СуммаКредит;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  Данные - ДеревоЗначений - См. Обработка.ОбменСКонтрагентами.Макет.АктСверкиВзаиморасчетов_ИнформацияОтправителя_5_01
//                            См. Обработка.ОбменСКонтрагентами.Макет.АктСверкиВзаиморасчетов_ИнформацияПолучателя_5_01
//  ДанныеОтправителяПолучателя - ТаблицаЗначений:
//	* НомерСтроки - Число
//	* НомерДоговора - Строка
//	* ДатаДоговора - Дата
//	* НаименованиеДоговора - Строка
//	* НомерДокумента - Строка
//	* ДатаДокумента - Дата
//	* НаименованиеДокумента - Строка
//	* ПорядковыйНомерОперации - Число
//	* ДатаОперации - Дата
//	* НаименованиеОперации - Строка
//	* Дебет - Число
//	* Кредит - Число
//  ПутьКСведениямПоДоговорам - Строка
Процедура ЗаполнитьТаблицуАктаСверкиВзаиморасчетов(Данные, ДанныеОтправителяПолучателя, ПутьКСведениямПоДоговорам)

	// Сведения по договорам.
	СведенияПоДоговорам = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
		Данные, ПутьКСведениямПоДоговорам);
		
	ДанныеПоДоговорам = ОбщегоНазначения.СкопироватьРекурсивно(ДанныеОтправителяПолучателя);
	ДанныеПоДоговорам.Свернуть("НаименованиеДоговора, НомерДоговора, ДатаДоговора");
	
	Для Каждого ДанныеДоговора Из ДанныеПоДоговорам Цикл

		ОтборПоДоговору = Новый Структура("НаименованиеДоговора, НомерДоговора, ДатаДоговора",
			ДанныеДоговора.НаименованиеДоговора, ДанныеДоговора.НомерДоговора, ДанныеДоговора.ДатаДоговора);
		ОперацииПоДоговору = ДанныеОтправителяПолучателя.Скопировать(ОтборПоДоговору);
		
		НоваяСтрокаПоДоговорам = СведенияПоДоговорам.Добавить();
		НоваяСтрокаПоДоговорам.ОписаниеДоговора = ДанныеДоговора.НаименованиеДоговора;
		НоваяСтрокаПоДоговорам.НомерДоговора = ДанныеДоговора.НомерДоговора;
		НоваяСтрокаПоДоговорам.ДатаДоговора = ДанныеДоговора.ДатаДоговора;
		НоваяСтрокаПоДоговорам.ОборотПоДебету = ОперацииПоДоговору.Итог("Дебет");
		НоваяСтрокаПоДоговорам.ОборотПоКредиту = ОперацииПоДоговору.Итог("Кредит");
		
		// Сведения по документам.
		СведенияПоДокументам = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			Данные, СтрШаблон("%1.НомерСтроки.СведенияПоДокументам", ПутьКСведениямПоДоговорам));
			
		ДанныеПоДокументам = ОбщегоНазначения.СкопироватьРекурсивно(ОперацииПоДоговору);
		ДанныеПоДокументам.Свернуть("НаименованиеДокумента, НомерДокумента, ДатаДокумента");	
			
		Для Каждого ДанныеДокумента Из ДанныеПоДокументам Цикл
			
			ОтборПоДокументу = Новый Структура("НаименованиеДокумента, НомерДокумента, ДатаДокумента",
				ДанныеДокумента.НаименованиеДокумента, ДанныеДокумента.НомерДокумента, ДанныеДокумента.ДатаДокумента);
			ОперацииПоДокументу = ОперацииПоДоговору.Скопировать(ОтборПоДокументу);
			
			НоваяСтрокаПоДокументам = СведенияПоДокументам.Добавить();
			НоваяСтрокаПоДокументам.НаименованиеДокумента = ДанныеДокумента.НаименованиеДокумента;
			НоваяСтрокаПоДокументам.НомерДокумента = ДанныеДокумента.НомерДокумента;
			НоваяСтрокаПоДокументам.ДатаДокумента = ДанныеДокумента.ДатаДокумента;
			
			// Сведения по операциям.
			СведенияПоОперациям = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(Данные,
				СтрШаблон("%1.НомерСтроки.СведенияПоДокументам.НомерСтроки.СведенияПоОперациям",
				ПутьКСведениямПоДоговорам));
			
			Для Каждого ДанныеОперации Из ОперацииПоДокументу Цикл
				
				НоваяСтрокаПоОперациям = СведенияПоОперациям.Добавить();
				НоваяСтрокаПоОперациям.НаименованиеОперации = ДанныеОперации.НаименованиеОперации;
				НоваяСтрокаПоОперациям.ПорядковыйНомерСтроки = ДанныеОперации.ПорядковыйНомерОперации;
				НоваяСтрокаПоОперациям.ДатаОперации = ДанныеОперации.ДатаОперации;
				НоваяСтрокаПоОперациям.СуммаДебет = ДанныеОперации.Дебет;
				НоваяСтрокаПоОперациям.СуммаКредит = ДанныеОперации.Кредит;
			
			КонецЦикла;
			
			НоваяСтрокаПоДокументам.СведенияПоОперациям = СведенияПоОперациям;
			
		КонецЦикла;
		
		НоваяСтрокаПоДоговорам.СведенияПоДокументам = СведенияПоДокументам;

	КонецЦикла;
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(
		Данные, СведенияПоДоговорам, ПутьКСведениямПоДоговорам);
		
КонецПроцедуры

// Параметры:
//  Участник - Структура:
//  * ТипУчастника - Структура:
//  ** ИП - Структура:
//  *** ИНН - Строка
//  *** ОГРН - Строка
//  *** Фамилия - Строка
//  *** Имя - Строка
//  *** Отчество - Строка
//  ** ЮЛ - Структура:
//  *** НаименованиеОрганизации - Строка
//  *** ИНН - Строка
//  *** КПП - Строка
//  *** ОГРН - Строка
//  ** ИЛ - Структура:
//  *** НаименованиеОрганизации - Строка
//  *** ИдентификаторОрганизации - Строка
//  *** ИныеСведения - Строка
//  ** ФЛ - Структура:
//  *** ИНН - Строка
//  *** Фамилия - Строка
//  *** Имя - Строка
//  *** Отчество - Строка
// 
// Возвращаемое значение:
//  Структура:
// * ИНН - Строка
// * КПП - Строка
// * Наименование - Строка
Функция РеквизитыУчастникаАктСверкиВзаиморасчетов(Знач Участник)
	
	Реквизиты = Новый Структура("ИНН, КПП, Наименование", "", "", "");
	
	Если Участник.ТипУчастника.Свойство("ЮЛ") Тогда
		
		Реквизиты.ИНН = Участник.ТипУчастника.ЮЛ.ИНН;
		Реквизиты.КПП = Участник.ТипУчастника.ЮЛ.КПП;
		Реквизиты.Наименование = Участник.ТипУчастника.ЮЛ.НаименованиеОрганизации;
		
	ИначеЕсли Участник.ТипУчастника.Свойство("ИЛ") Тогда
		
		Реквизиты.Наименование = Участник.ТипУчастника.ИЛ.НаименованиеОрганизации;
		
	ИначеЕсли Участник.ТипУчастника.Свойство("ИП") Тогда
		
		Реквизиты.ИНН = Участник.ТипУчастника.ИП.ИНН;
		
	ИначеЕсли Участник.ТипУчастника.Свойство("ФЛ") Тогда
		
		Реквизиты.ИНН = Участник.ТипУчастника.ФЛ.ИНН;
		ЧастиФИО = Новый Массив;
		Если ЗначениеЗаполнено(Участник.ТипУчастника.ФЛ.Фамилия) Тогда
			ЧастиФИО.Добавить(Участник.ТипУчастника.ФЛ.Фамилия);
		КонецЕсли;
		Если ЗначениеЗаполнено(Участник.ТипУчастника.ФЛ.Имя) Тогда
			ЧастиФИО.Добавить(Участник.ТипУчастника.ФЛ.Имя);
		КонецЕсли;
		Если ЗначениеЗаполнено(Участник.ТипУчастника.ФЛ.Отчество) Тогда
			ЧастиФИО.Добавить(Участник.ТипУчастника.ФЛ.Отчество);
		КонецЕсли;
		Реквизиты.Наименование = СтрСоединить(ЧастиФИО, " ");
		
	КонецЕсли;
	
	Возврат Реквизиты;
	
КонецФункции

#КонецОбласти // АктСверкиВзаиморасчетов

// Заполняет данные участника ЭДО в дерево данных для счета на оплату версии 5.01.
//
// Параметры:
//  ДеревоДанных        - ДеревоЗначений - Данные для формирования электронного документа.
//  СведенияОбУчастнике - Структура - Информация об участнике ЭДО.
//  ВидУчастника        - Строка - Роль участника сделки.
//  ВидАдреса           - Строка - Вид адреса для заполнения в электронный документ.
//     Принимает значения: ЮридическийАдрес, ФактическийАдрес, ПочтовыйАдрес, ПроизвольныйАдрес.
//
Процедура ЗаполнитьДанныеУчастникаСчетуНаОплату_5_01(ДеревоДанных, СведенияОбУчастнике, ВидУчастника,
			ВидАдреса = "ЮридическийАдрес")
	
	// Подготовим параметры обработки ошибок
	КлючДанных = Неопределено;
	СведенияОбУчастнике.Свойство("Ссылка", КлючДанных);
	
	ПараметрыОбработкиОшибокИНН = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		КлючДанных, "Объект.ИНН");
	ПараметрыОбработкиОшибокКПП = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		КлючДанных, "Объект.КПП");
	ПараметрыОбработкиОшибокОГРН = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		КлючДанных, "Объект.ОГРН");
		
	ТипУчастникаОрганизация = ТипЗнч(КлючДанных) = Тип("СправочникСсылка.Организации");
	ПостфиксПоляАдрес = ?(ТипУчастникаОрганизация, "Организации", "Контрагента");
	
	ПутьКДаннымНаименования = ?(ТипУчастникаОрганизация, "Объект.НаименованиеСокращенное", "Объект.НаименованиеПолное");
	
	ПараметрыОбработкиОшибокНаименование = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		КлючДанных, ПутьКДаннымНаименования);
	
	// Передаем в дерево данные для заполнения адреса.
	ВидКонтактнойИнформации = Неопределено;
	
	Если ВидАдреса = "ПроизвольныйАдрес"
		И ЗначениеЗаполнено(СведенияОбУчастнике.ПроизвольныйАдресЗначенияПолей) Тогда
		
		СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(СведенияОбУчастнике.ПроизвольныйАдресЗначенияПолей);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".Адрес.ТипАдреса.АдресИнформация.КодСтраны", СведенияОбАдресе.КодСтраны);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".Адрес.ТипАдреса.АдресИнформация.НаименованиеСтраны", СведенияОбАдресе.Страна);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".Адрес.ТипАдреса.АдресИнформация.АдресТекст", СведенияОбАдресе.Представление);
		
	ИначеЕсли ВидАдреса = "ПочтовыйАдрес"
		И ЗначениеЗаполнено(СведенияОбУчастнике[ВидАдреса]) Тогда
		
		ВидКонтактнойИнформации = ?(ТипУчастникаОрганизация, Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресОрганизации,
			Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресКонтрагента);
		
	ИначеЕсли ВидАдреса = "ФактическийАдрес" 
		И ЗначениеЗаполнено(СведенияОбУчастнике[ВидАдреса]) Тогда
		
		ВидКонтактнойИнформации = ?(ТипУчастникаОрганизация, Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации,
			Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента);
		
	Иначе
		
		ВидКонтактнойИнформации = ?(ТипУчастникаОрганизация, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,
			Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
		
	КонецЕсли;
	
	Если ВидКонтактнойИнформации <> Неопределено Тогда
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СведенияОбУчастнике.Ссылка, "КонтактнаяИнформацияПолеЮрАдрес" + ПостфиксПоляАдрес + ".");
		
		ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных, ВидУчастника + ".Адрес.АвтоматическиЗаполняемый",
			ПараметрыОбработкиОшибок);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".Адрес.ТипАдреса.АвтоматическиЗаполняемый.ОбъектКонтактнойИнформации", КлючДанных);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".Адрес.ТипАдреса.АвтоматическиЗаполняемый.ВидКонтактнойИнформации", ВидКонтактнойИнформации);
		
	КонецЕсли;
	
	Если СведенияОбУчастнике.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ЮЛ.ИНН",
			СведенияОбУчастнике.ИНН, ПараметрыОбработкиОшибокИНН);
			
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ЮЛ.КПП",
			СведенияОбУчастнике.КПП, ПараметрыОбработкиОшибокКПП);
			
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации",
			СведенияОбУчастнике.ПолноеНаименование, ПараметрыОбработкиОшибокНаименование);
			
		Если ЭлектронноеВзаимодействие.СуществуетРеквизитВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ОГРН") Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ЮЛ.ОГРН",
				СведенияОбУчастнике.ОГРН, ПараметрыОбработкиОшибокОГРН);
		КонецЕсли;
	
	ИначеЕсли СведенияОбУчастнике.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент Тогда
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации",
			СведенияОбУчастнике.ПолноеНаименование, ПараметрыОбработкиОшибокНаименование);
			
		Статусы = Новый Структура;
		Статусы.Вставить("Организация", "ИО");
		Статусы.Вставить("Гражданин", "ИГ");
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИЛ.Статус",
			Статусы.Организация);
		
		КодСтраны = Неопределено;
		Страна = Неопределено;
		Если ЗначениеЗаполнено(СведенияОбУчастнике.ЮридическийАдресXML) Тогда
			СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(СведенияОбУчастнике.ЮридическийАдресXML);
			КодСтраны = СведенияОбАдресе.КодСтраны;
			Страна = СведенияОбАдресе.Страна;
		ИначеЕсли ЗначениеЗаполнено(СведенияОбУчастнике.ФактическийАдресXML) Тогда
			СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(СведенияОбУчастнике.ФактическийАдресXML);
			КодСтраны = СведенияОбАдресе.КодСтраны;
			Страна = СведенияОбАдресе.Страна;
		КонецЕсли;
		
		ПараметрыОбработкиОшибокКодСтраныИЛ = Неопределено;
		ПараметрыОбработкиОшибокНаименованиеСтраныИЛ = Неопределено;
		
		Если Не ТипУчастникаОрганизация Тогда
			ПараметрыОбработкиОшибокКодСтраныИЛ = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				КлючДанных, "КонтактнаяИнформацияПолеЮрАдрес" + ПостфиксПоляАдрес);
			ПараметрыОбработкиОшибокНаименованиеСтраныИЛ = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				КлючДанных, "КонтактнаяИнформацияПолеЮрАдрес" + ПостфиксПоляАдрес);
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИЛ.КодСтраны",
			КодСтраны, ПараметрыОбработкиОшибокКодСтраныИЛ);

		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеСтраны",
			Страна, ПараметрыОбработкиОшибокНаименованиеСтраныИЛ);
			
		ПараметрыОбработкиОшибокИдентификаторИЛ = Неопределено;
		Если Не ТипУчастникаОрганизация Тогда
			ПараметрыОбработкиОшибокИдентификаторИЛ = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				КлючДанных, "Объект.ИдентификаторЮридическогоЛица");
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИЛ.ИдентификаторОрганизации",
			СведенияОбУчастнике.ИдентификаторЮридическогоЛица, ПараметрыОбработкиОшибокИдентификаторИЛ);
	
	ИначеЕсли СведенияОбУчастнике.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель Тогда
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИП.ИНН",
			СведенияОбУчастнике.ИНН, ПараметрыОбработкиОшибокИНН);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИП.ФИО.Фамилия",
			СведенияОбУчастнике.Фамилия, ПараметрыОбработкиОшибокНаименование);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИП.ФИО.Имя",
			СведенияОбУчастнике.Имя, ПараметрыОбработкиОшибокНаименование);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИП.ФИО.Отчество",
			СведенияОбУчастнике.Отчество, ПараметрыОбработкиОшибокНаименование);
			
		Если ЗначениеЗаполнено(СведенияОбУчастнике.СвидетельствоСерияНомер) Тогда
			Свидетельство = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Свидетельство №%1 от %2'"),
							СведенияОбУчастнике.СвидетельствоСерияНомер,
							Формат(СведенияОбУчастнике.СвидетельствоДатаВыдачи, "ДЛФ=D"));
			
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				КлючДанных, "Объект.СвидетельствоСерияНомер");
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ИП.СвидетельствоГосударственнойРегистрации",
				Свидетельство, ПараметрыОбработкиОшибок);
		КонецЕсли;
		
		Если ЭлектронноеВзаимодействие.СуществуетРеквизитВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ОГРН") Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ИП.ОГРН",
				СведенияОбУчастнике.ОГРН, ПараметрыОбработкиОшибокОГРН);
		КонецЕсли;
		
	Иначе
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ФЛ.ИНН",
			СведенияОбУчастнике.ИНН, ПараметрыОбработкиОшибокИНН);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ФЛ.ФИО.Фамилия",
			СведенияОбУчастнике.Фамилия, ПараметрыОбработкиОшибокНаименование);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ФЛ.ФИО.Имя",
			СведенияОбУчастнике.Имя, ПараметрыОбработкиОшибокНаименование);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ФЛ.ФИО.Отчество",
			СведенияОбУчастнике.Отчество, ПараметрыОбработкиОшибокНаименование);
	КонецЕсли;
	
	Телефон = "";
	Если СведенияОбУчастнике.Свойство("Телефоны", Телефон) И ЗначениеЗаполнено(Телефон) Тогда
		Телефоны = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, ВидУчастника + ".КонтактныеСведения.Телефоны");
		НоваяСтрока = Телефоны.Добавить();	
		НоваяСтрока.Телефон = Телефон;	
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(
			ДеревоДанных, Телефоны, ВидУчастника + ".КонтактныеСведения.Телефоны");
	КонецЕсли;
	
	ЭлектроннаяПочта = "";
	Если СведенияОбУчастнике.Свойство("ЭлектроннаяПочта", ЭлектроннаяПочта) И ЗначениеЗаполнено(ЭлектроннаяПочта) Тогда
		ЭлектронныеПочты = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, ВидУчастника + ".КонтактныеСведения.ЭлектронныеПочты");
		НоваяСтрока = ЭлектронныеПочты.Добавить();	
		НоваяСтрока.ЭлектроннаяПочта = ЭлектроннаяПочта;	
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(
			ДеревоДанных, ЭлектронныеПочты, ВидУчастника + ".КонтактныеСведения.ЭлектронныеПочты");
	КонецЕсли;
	
	НомерСчета = "";
	Если СведенияОбУчастнике.Свойство("НомерСчета", НомерСчета) И ЗначениеЗаполнено(НомерСчета) Тогда
		Банк = "";
		БИК = "";
		КоррСчет = "";
		
		ПараметрыОбработкиОшибок = Неопределено;
		Если СведенияОбУчастнике.Свойство("БанковскийСчет") Тогда
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				СведенияОбУчастнике.БанковскийСчетСсылка, "Объект.НомерСчета");
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".БанковскиеРеквизиты.НомерСчета",
			НомерСчета, ПараметрыОбработкиОшибок);
		
		Если СведенияОбУчастнике.Свойство("Банк", Банк) И ЗначениеЗаполнено(Банк) Тогда
			ПараметрыОбработкиОшибок = Неопределено;
			Если СведенияОбУчастнике.Свойство("БанкСсылка") Тогда
				ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
					СведенияОбУчастнике.БанкСсылка, "Объект.Наименование");
			КонецЕсли;
				
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".БанковскиеРеквизиты.НаименованиеБанка",
				Банк, ПараметрыОбработкиОшибок);
		КонецЕсли;
		Если СведенияОбУчастнике.Свойство("БИК", БИК) И ЗначениеЗаполнено(БИК) Тогда
			ПараметрыОбработкиОшибок = Неопределено;
			Если СведенияОбУчастнике.Свойство("БанкСсылка") Тогда
				ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
					СведенияОбУчастнике.БанкСсылка, "Объект.Код");
			КонецЕсли;
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".БанковскиеРеквизиты.БанкБИК",
				БИК, ПараметрыОбработкиОшибок);
		КонецЕсли;
		Если СведенияОбУчастнике.Свойство("КоррСчет", КоррСчет) И ЗначениеЗаполнено(КоррСчет) Тогда
			ПараметрыОбработкиОшибок = Неопределено;
			Если СведенияОбУчастнике.Свойство("БанкСсылка") Тогда
				ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
					СведенияОбУчастнике.БанкСсылка, "Объект.КоррСчет");
			КонецЕсли;
			
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ВидУчастника + ".БанковскиеРеквизиты.КорреспондентскийСчетБанка",
				КоррСчет, ПараметрыОбработкиОшибок);
		КонецЕсли;
		
	КонецЕсли;
	
	КодОКПО = "";
	Если СведенияОбУчастнике.Свойство("КодПоОКПО", КодОКПО) И ЗначениеЗаполнено(КодОКПО) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ВидУчастника + ".КодОКПО",
			КодОКПО);
	КонецЕсли;	

КонецПроцедуры

#КонецОбласти

