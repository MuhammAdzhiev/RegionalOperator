// Заполнение объектов

// Перезаполняет реквизиты шапки объекта.
//
// Параметры:
//  ТекущийОбъект    - Объект ИБ, реквизиты шапки которого необходимо заполнить,
//  ДанныеЗаполнения - Структура значений, которые необходимо подставить в объект ИБ.
//
Процедура ПерезаполнениеЗначенийРеквизитовШапки(ТекущийОбъект, ДанныеЗаполнения)
	
	Для Каждого Строка Из ДанныеЗаполнения Цикл
		
		Если ЗначениеЗаполнено(Строка.Ключ) И ТекущийОбъект.Метаданные().Реквизиты.Найти(Строка.Ключ) <> Неопределено Тогда
			Если ТекущийОбъект[Строка.Ключ] <> Строка.Значение Тогда
				ТекущийОбъект[Строка.Ключ] = Строка.Значение;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет в таблице товаров сведения по маркировке.
//
// Параметры:
//  СтрокаТовара			- СтрокаТаблицыЗначений - строка выгруженной таблицы документа. Должна обязательно содержать колонки:
//                             * НомерСтрокиИсходногоДокумента - Число - номер строки таблицы товаров документа, для которого заполняются данные.
//                             * СведенияОМаркировке - Произвольный - в данную колонку будет записана структура сведений по маркировке.
//  ТаблицаКодовДокумента	- ТаблицаЗначений - содержит сведения об упаковках. Должна обязательно содержать колонки:
//                             * ИдентификаторСтроки - Строка - идентификатор строки.
//                             * НомерУпаковки - Строка - код маркировки.
//  Документ				- ДокументСсылка - ссылка на документ, для которого заполняются данные.
//
Процедура ЗаполнитьРеквизитыМаркировкиВСтрокеТоваровУКД_ГИСМТ(СтрокаТовара, ТаблицаКодовДокумента,
	Документ, ИмяСведенийОМаркировке, ИмяРеквизитаТЧ)

	ПутьКДаннымДляОшибки = СтрШаблон("Объект.Товары[%1].%2", СтрокаТовара.НомерСтрокиИсходногоДокумента - 1, ИмяРеквизитаТЧ);
	
	ТаблицаКодов = Новый ТаблицаЗначений;
	ТаблицаКодов.Колонки.Добавить("Код");
	
	СведенияОМаркировке = Новый Структура;
	СведенияОМаркировке.Вставить("КонтрольныеИдентификационныеЗнаки", ТаблицаКодов);
	СтрокаТовара[ИмяСведенийОМаркировке] = СведенияОМаркировке;
	
	ПараметрыПоиска = Новый Структура("ИдентификаторСтроки", СтрокаТовара.ИдентификаторСтроки);
	
	СтрокиУпаковок = ТаблицаКодовДокумента.НайтиСтроки(ПараметрыПоиска);
	Для Каждого СтрокаУпаковки Из СтрокиУпаковок Цикл
		НоваяСтрока = ТаблицаКодов.Добавить();
		НоваяСтрока.Код = СтрокаУпаковки.НомерУпаковки;
	КонецЦикла;
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаКодов,
		"КодУпаковки", Документ, ПутьКДаннымДляОшибки);

КонецПроцедуры

// Заполняет коды маркировки в документе из дерева электронного документа.
//
// Параметры:
//  ДокументОбъект				 - ДокументОбъект - объект заполняемого документа.
//  СтрокаТоваров				 - СтрокаТабличнойЧасти - строка таблицы товаров документа.
//  СтрокаТоваровДерева			 - СтрокаДереваЗначений - строка товаров дерева электронного документа.
//  ЭтоИндивидуальныеУпаковки	 - Булево - Истина, если нужно заполнить индивидуальные упаковки,
//                                          Ложь, если нужно заполнить транспортные упаковки.
//
Процедура ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокумента(ДокументОбъект, СтрокаТоваров, СтрокаТоваровДерева)
	
	ИмяТаблицыУпаковокДерева = "КодыИндивидуальныхУпаковок";
	ТаблицаДокумента = ДокументОбъект.КодыУпаковокМаркируемойПродукции;
	
	КодыУпаковок = СтрокаТоваровДерева.Строки.Найти(
		"СведенияОТоварах.НомерСтроки.СведенияОМаркировке." + ИмяТаблицыУпаковокДерева, "ПолныйПуть", Истина);
	Если КодыУпаковок <> Неопределено И ЗначениеЗаполнено(КодыУпаковок.Значение) Тогда
		Для Каждого СтрокаКодаУпаковки Из КодыУпаковок.Строки Цикл
			СтрокаНовойУпаковки = ТаблицаДокумента.Добавить();
			СтрокаНовойУпаковки.ИдентификаторСтроки = СтрокаТоваров.ИдентификаторСтроки;
			
			ПутьКНомеруУпаковки = СтрШаблон("СведенияОТоварах.НомерСтроки.СведенияОМаркировке.%1.НомерСтроки.КодУпаковки",
				ИмяТаблицыУпаковокДерева);
			СтрокаНовойУпаковки.НомерУпаковки       = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаКодаУпаковки,
				ПутьКНомеруУпаковки);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Заполняет коды маркировки в документе из дерева электронного документа.
//
// Параметры:
//  ДокументОбъект				 - ДокументОбъект - объект заполняемого документа.
//  СтрокаТоваров				 - СтрокаТабличнойЧасти - строка таблицы товаров документа.
//  СтрокаТоваровДерева			 - СтрокаДереваЗначений - строка товаров дерева электронного документа.
//  ЭтоИндивидуальныеУпаковки	 - Булево - Истина, если нужно заполнить индивидуальные упаковки,
//                                          Ложь, если нужно заполнить транспортные упаковки.
//
Процедура ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокумента_ГИСМТ(ДокументОбъект, СтрокаТоваров, СтрокаТоваровДерева)
	
	ДобавитьВТаблицуДокументаСтрокиМаркировки_ГИСМТ(ДокументОбъект.КодыУпаковокМаркируемойПродукцииДоКорректировки,
		СтрокаТоваровДерева, СтрокаТоваров.ИдентификаторСтроки, "СведенияОМаркировкеДо", "КонтрольныеИдентификационныеЗнаки");
	ДобавитьВТаблицуДокументаСтрокиМаркировки_ГИСМТ(ДокументОбъект.КодыУпаковокМаркируемойПродукцииДоКорректировки,
		СтрокаТоваровДерева, СтрокаТоваров.ИдентификаторСтроки, "СведенияОМаркировкеДо", "ТранспортныеУпаковки");
	
	ДобавитьВТаблицуДокументаСтрокиМаркировки_ГИСМТ(ДокументОбъект.КодыУпаковокМаркируемойПродукции,
		СтрокаТоваровДерева, СтрокаТоваров.ИдентификаторСтроки, "СведенияОМаркировке", "КонтрольныеИдентификационныеЗнаки");
	ДобавитьВТаблицуДокументаСтрокиМаркировки_ГИСМТ(ДокументОбъект.КодыУпаковокМаркируемойПродукции,
		СтрокаТоваровДерева, СтрокаТоваров.ИдентификаторСтроки, "СведенияОМаркировке", "ТранспортныеУпаковки");
	
КонецПроцедуры

Процедура ДобавитьВТаблицуДокументаСтрокиМаркировки_ГИСМТ(ТаблицаДокумента,
		СтрокаТоваровДерева, Идентификатор, ИмяТаблицы, ИмяВидаУпаковки) 
	
	ПутьКСведениямОМаркировке = СтрШаблон("СведенияОТоварах.НомерСтроки.%1.%2", ИмяТаблицы, ИмяВидаУпаковки);
	КодыУпаковок = СтрокаТоваровДерева.Строки.Найти(ПутьКСведениямОМаркировке, "ПолныйПуть", Истина);
	Если КодыУпаковок <> Неопределено И ЗначениеЗаполнено(КодыУпаковок.Значение) Тогда
		Для Каждого СтрокаКодаУпаковки Из КодыУпаковок.Строки Цикл
			СтрокаНовойУпаковки = ТаблицаДокумента.Добавить();
			СтрокаНовойУпаковки.ИдентификаторСтроки = Идентификатор;
			
			ПутьКНомеруУпаковки = СтрШаблон("СведенияОТоварах.НомерСтроки.%1.%2.НомерСтроки.Код", ИмяТаблицы, ИмяВидаУпаковки);
			СтрокаНовойУпаковки.НомерУпаковки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаКодаУпаковки, ПутьКНомеруУпаковки);
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

