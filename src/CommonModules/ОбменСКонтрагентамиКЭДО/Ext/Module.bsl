// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеРеквизитыОрганизации.
Процедура ЗаполнитьДанныеРеквизитыОрганизации(СсылкаНаОбъект, ДеревоДанных, Отказ) Экспорт

	СведенияОбОрганизации = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(СсылкаНаОбъект, СведенияОбОрганизации);
	
	ЗаполнитьДанныеУчастника(ДеревоДанных, СведенияОбОрганизации, "Организация", Истина);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаФормирования", ТекущаяДатаСеанса());
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "Наименование", "Реквизиты "+СсылкаНаОбъект.Наименование);

КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьРегистрационныеДанныеОрганизации
Процедура ЗаполнитьРегистрационныеДанныеОрганизации(Организация, ДанныеОрганизации) Экспорт
	
	СвойстваОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация,
			"НаименованиеПолное, ИНН, КПП, ОГРН, ЮрФизЛицо, Руководитель");
	
	ОрганизацияФизЛицо = (СвойстваОрганизации.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель
		ИЛИ СвойстваОрганизации.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо);
	
	ДанныеОрганизации.Вставить("ОрганизацияСсылка", Организация);
	
	ДанныеОрганизации.Вставить("Наименование" , СвойстваОрганизации.НаименованиеПолное);
	ДанныеОрганизации.Вставить("ИНН"          , СвойстваОрганизации.ИНН);
	ДанныеОрганизации.Вставить("КПП"          , СвойстваОрганизации.КПП);
	ДанныеОрганизации.Вставить("ОГРН"         , СвойстваОрганизации.ОГРН);
	ДанныеОрганизации.Вставить("КодИМНС"      , "");
	
	Если ОрганизацияФизЛицо Тогда
		ДанныеОрганизации.Вставить("ЮрФизЛицо", "ФизЛицо");
	Иначе
		ДанныеОрганизации.Вставить("ЮрФизЛицо", "ЮрЛицо");
	КонецЕсли;
	
	ЗаполнитьДанныеРуководителя(СвойстваОрганизации, ДанныеОрганизации);
	
	ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
	
	ДанныеОрганизации.Вставить("Индекс"         , "");
	ДанныеОрганизации.Вставить("Регион"         , "");
	ДанныеОрганизации.Вставить("КодРегиона"     , "");
	ДанныеОрганизации.Вставить("Район"          , "");
	ДанныеОрганизации.Вставить("Город"          , "");
	ДанныеОрганизации.Вставить("НаселенныйПункт", "");
	ДанныеОрганизации.Вставить("Улица"          , "");
	ДанныеОрганизации.Вставить("Дом"            , "");
	ДанныеОрганизации.Вставить("Корпус"         , "");
	ДанныеОрганизации.Вставить("Квартира"       , "");
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтактнаяИнформация.Значение
	|ИЗ
	|	Справочник.Организации.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Ссылка = &Ссылка
	|	И КонтактнаяИнформация.Вид = &Вид";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", Организация);
	Запрос.УстановитьПараметр("Вид",    ВидКонтактнойИнформации);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		АдресСтруктурой = РаботаСАдресами.СведенияОбАдресе(Выборка.Значение);
		Если АдресСтруктурой.Свойство("Индекс") Тогда
			ДанныеОрганизации.Индекс = АдресСтруктурой.Индекс;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("Регион") Тогда
			ДанныеОрганизации.Регион = АдресСтруктурой.Регион;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("КодРегиона") Тогда
			ДанныеОрганизации.КодРегиона = АдресСтруктурой.КодРегиона;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("Район") Тогда
			ДанныеОрганизации.Район = АдресСтруктурой.Район;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("Город") Тогда
			ДанныеОрганизации.Город = АдресСтруктурой.Город;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("НаселенныйПункт") Тогда
			ДанныеОрганизации.НаселенныйПункт = АдресСтруктурой.НаселенныйПункт;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("Улица") Тогда
			ДанныеОрганизации.Улица = АдресСтруктурой.Улица;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("Здание") И ЗначениеЗаполнено(АдресСтруктурой.Здание) Тогда
			ДанныеОрганизации.Дом = АдресСтруктурой.Здание.Номер;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("Корпуса") И ЗначениеЗаполнено(АдресСтруктурой.Корпуса) Тогда
			ДанныеОрганизации.Корпус = АдресСтруктурой.Корпуса[0].Номер;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("Помещения") И ЗначениеЗаполнено(АдресСтруктурой.Помещения) Тогда
			ДанныеОрганизации.Квартира = АдресСтруктурой.Помещения[0].Номер;
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеОрганизации.Вставить("Телефон", УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		Организация, Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации));
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеПоКаталогуТоваровCML.
Процедура ЗаполнитьДанныеПоКаталогуТоваровCML(Организация, ТоварыКаталога, ДеревоДанных, Отказ) Экспорт
	
	Если Не ЗначениеЗаполнено(ТоварыКаталога) Тогда
		Возврат;
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержитТолькоИзменения", Истина);
	
	СведенияОбОрганизации = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(Организация, СведенияОбОрганизации);
	ЗаполнитьДанныеУчастника(ДеревоДанных, СведенияОбОрганизации, "Владелец", Истина);
	
	ТоварыКаталога.Колонки.Добавить("Сопоставление");
	
	ЕстьКолонкаШтрихкодыНоменклатуры = ТоварыКаталога.Колонки.Найти("ШтрихкодыНоменклатуры") <> Неопределено;
	ЕстьКолонкаШтрихкодКомбинации    = ТоварыКаталога.Колонки.Найти("ШтрихкодКомбинации") <> Неопределено;
	
	Для Каждого СтрокаТовара Из ТоварыКаталога Цикл
		
		Сопоставление = Новый Структура;
		Сопоставление.Вставить("Наименование",        СтрокаТовара.Наименование);
		Сопоставление.Вставить("Характеристика",      СтрокаТовара.ХарактеристикаНаименование);
		Сопоставление.Вставить("ЕдиницаИзмерения",    СтрокаТовара.БазоваяЕдиницаНаименование);
		Сопоставление.Вставить("ЕдиницаИзмеренияКод", СтрокаТовара.БазоваяЕдиницаКод);
		Сопоставление.Вставить("Артикул",             СтрокаТовара.Артикул);
		Сопоставление.Вставить("СтавкаНДС",           СтрокаТовара.СтавкаНДС);
		Если ЕстьКолонкаШтрихкодКомбинации Тогда
			Сопоставление.Вставить("ШтрихкодКомбинации",  СтрокаТовара.ШтрихкодКомбинации);
		КонецЕсли;
		Если ЕстьКолонкаШтрихкодыНоменклатуры Тогда
			Сопоставление.Вставить("ШтрихкодыНоменклатуры", СтрокаТовара.ШтрихкодыНоменклатуры);
		КонецЕсли;
		Сопоставление.Вставить("НоменклатураИБ",      СтрокаТовара.Номенклатура);
		Сопоставление.Вставить("ХарактеристикаИБ",    СтрокаТовара.Характеристика);
		Сопоставление.Вставить("УпаковкаИБ",          СтрокаТовара.БазоваяЕдиницаСсылка);
		СтрокаТовара.Сопоставление = Сопоставление;
		
	КонецЦикла;
	
	ЗаполнитьПараметрыОбработкиОшибокВТаблицеТоваровCML(ТоварыКаталога);
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТоварыКаталога, "Товары");
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеПоСчету.
Процедура ЗаполнитьДанныеПоСчету(СсылкаНаОбъект, ДеревоДокумента, Отказ) Экспорт
	
	СтруктураДанных = Документы.СчетНаОплатуПокупателю.ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();
	
	ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		СсылкаНаОбъект, "Объект.НомерЭД");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Номер",
		ВыборкаШапки.Номер, ПараметрыОбработкиОшибок);
	
	ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		СсылкаНаОбъект, "Объект.Дата");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Дата",
		ВыборкаШапки.Дата, ПараметрыОбработкиОшибок);
	
	Если Не ЗначениеЗаполнено(ВыборкаШапки.Валюта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Валюта");
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			ВыборкаШапки.Валюта, "Объект.Код");
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		ДеревоДокумента, "Валюта", ВыборкаШапки.ВалютаКод, ПараметрыОбработкиОшибок);
	
	СтруктураКурса = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВыборкаШапки.Валюта, ВыборкаШапки.Дата);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Курс", СтруктураКурса.Курс);
	
	Если ЗначениеЗаполнено(ВыборкаШапки.ДоговорКонтрагента) Тогда
		
		НазначениеПлатежа = ВыборкаШапки.ДоговорНаименование;
		Если ЗначениеЗаполнено(ВыборкаШапки.ДоговорНомер) Тогда
			НазначениеПлатежа = НазначениеПлатежа + " " + СтрШаблон(НСтр("ru = '№ %1'"), ВыборкаШапки.ДоговорНомер);
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаШапки.ДоговорДата) Тогда
			НазначениеПлатежа = НазначениеПлатежа + " " + СтрШаблон(НСтр("ru = 'от %1'"),
				Формат(ВыборкаШапки.ДоговорДата,"ДЛФ=D"));
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "НазначениеПлатежа", НазначениеПлатежа);
		
	КонецЕсли;
	
	// Заполняем Контрагента
	СведенияОПокупателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Контрагент, СведенияОПокупателе);
	ЗаполнитьДанныеУчастника(ДеревоДокумента, СведенияОПокупателе, "Покупатель", Истина);
	
	// Заполняем организацию
	СведенияОПродавце = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Организация, СведенияОПродавце);
	ЗаполнитьДанныеУчастника(ДеревоДокумента, СведенияОПродавце, "Продавец", Истина);
	
	// Заполняем таблицу товаров
	ТаблицаТоваров = Новый ТаблицаЗначений();
	ТаблицаТоваров.Колонки.Добавить("Ссылка");
	ТаблицаТоваров.Колонки.Добавить("НомерСтроки");
	ТаблицаТоваров.Колонки.Добавить("Артикул");
	ТаблицаТоваров.Колонки.Добавить("Наименование");
	ТаблицаТоваров.Колонки.Добавить("Описание");
	ТаблицаТоваров.Колонки.Добавить("Номенклатура");
	ТаблицаТоваров.Колонки.Добавить("Характеристика");
	ТаблицаТоваров.Колонки.Добавить("НаименованиеХарактеристики");
	ТаблицаТоваров.Колонки.Добавить("Штрихкод");
	ТаблицаТоваров.Колонки.Добавить("БазоваяЕдиницаСсылка");
	ТаблицаТоваров.Колонки.Добавить("БазоваяЕдиницаКод");
	ТаблицаТоваров.Колонки.Добавить("БазоваяЕдиницаНаименование");
	ТаблицаТоваров.Колонки.Добавить("БазоваяЕдиницаМеждународноеСокращение");
	ТаблицаТоваров.Колонки.Добавить("БазоваяЕдиницаНаименованиеПолное");
	ТаблицаТоваров.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаТоваров.Колонки.Добавить("ЕдиницаИзмеренияКодПоОКЕИ");
	ТаблицаТоваров.Колонки.Добавить("ЕдиницаИзмеренияКоэффициент");
	ТаблицаТоваров.Колонки.Добавить("Цена");
	ТаблицаТоваров.Колонки.Добавить("Количество");
	ТаблицаТоваров.Колонки.Добавить("СуммаСкидки");
	ТаблицаТоваров.Колонки.Добавить("Сумма");
	ТаблицаТоваров.Колонки.Добавить("НДСУчтеноВСумме");
	ТаблицаТоваров.Колонки.Добавить("СуммаНДС");
	ТаблицаТоваров.Колонки.Добавить("СтавкаНДС");
	ТаблицаТоваров.Колонки.Добавить("Сопоставление");
	
	НДСУчтеноВСумме = ВыборкаШапки.ЦенаВключаетНДС;
	ВыборкаТоваров = СтруктураДанных.ВыборкаТоваров;
	
	ШтрихкодыКомбинаций   = Неопределено;
	ШтрихкодыНоменклатуры = Неопределено;
	Если НЕ СтруктураДанных.Свойство("ШтрихкодыНоменклатуры", ШтрихкодыНоменклатуры)
		ИЛИ НЕ СтруктураДанных.Свойство("ШтрихкодыКомбинаций", ШтрихкодыКомбинаций) Тогда
		ШтрихкодыПоТоварам(ВыборкаТоваров, ШтрихкодыКомбинаций, ШтрихкодыНоменклатуры);
	КонецЕсли;
	
	Пока ВыборкаТоваров.СледующийПоЗначениюПоля("НомерСтроки") Цикл
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		НоваяСтрока.Ссылка                                = ВыборкаТоваров.Ссылка;
		НоваяСтрока.НомерСтроки                           = ВыборкаТоваров.НомерСтроки;
		НоваяСтрока.Артикул                               = ВыборкаТоваров.НоменклатураАртикул;
		НоваяСтрока.Номенклатура                          = ВыборкаТоваров.Номенклатура;
		НоваяСтрока.Наименование                          = ВыборкаТоваров.НаименованиеПолное;
		
		Если ЗначениеЗаполнено(ВыборкаТоваров.Содержание) Тогда
			НоваяСтрока.Наименование = ВыборкаТоваров.Содержание;
			НоваяСтрока.Описание = ВыборкаТоваров.Содержание;
		Иначе
			НоваяСтрока.НаименованиеХарактеристики = ВыборкаТоваров.ХарактеристикаНаименование;
			НоваяСтрока.Характеристика             = ВыборкаТоваров.Характеристика;
		КонецЕсли;
		
		НоваяСтрока.БазоваяЕдиницаСсылка                  = ВыборкаТоваров.БазоваяЕдиницаСсылка;
		НоваяСтрока.БазоваяЕдиницаКод                     = ВыборкаТоваров.БазоваяЕдиницаКод;
		НоваяСтрока.БазоваяЕдиницаНаименование            = ВыборкаТоваров.БазоваяЕдиницаНаименование;
		НоваяСтрока.БазоваяЕдиницаНаименованиеПолное      = ВыборкаТоваров.БазоваяЕдиницаНаименованиеПолное;
		НоваяСтрока.БазоваяЕдиницаМеждународноеСокращение = ВыборкаТоваров.БазоваяЕдиницаМеждународноеСокращение;
		НоваяСтрока.ЕдиницаИзмерения                      = ВыборкаТоваров.БазоваяЕдиницаСсылка;
		НоваяСтрока.ЕдиницаИзмеренияКодПоОКЕИ             = ВыборкаТоваров.БазоваяЕдиницаКод;
		НоваяСтрока.ЕдиницаИзмеренияКоэффициент           = 1;
		НоваяСтрока.Цена                                  = ВыборкаТоваров.Цена;
		НоваяСтрока.Количество                            = ВыборкаТоваров.Количество;
		НоваяСтрока.СуммаСкидки                           = ВыборкаТоваров.СуммаСкидки;
		НоваяСтрока.НДСУчтеноВСумме                       = НДСУчтеноВСумме;
		
		Если ВыборкаШапки.ОблагаетсяНДСУПокупателя Тогда
			НоваяСтрока.Сумма = ВыборкаТоваров.СуммаСНДС;
			НоваяСтрока.СтавкаНДС = "НДС исчисляется налоговым агентом";
			НоваяСтрока.СуммаНДС = 0;
		Иначе
			НоваяСтрока.Сумма = ?(НДСУчтеноВСумме, ВыборкаТоваров.СуммаСНДС, ВыборкаТоваров.Сумма);
			НоваяСтрока.СуммаНДС = ВыборкаТоваров.СуммаНДС;
			НоваяСтрока.СтавкаНДС = ВыборкаТоваров.СтавкаНДС;
		КонецЕсли;
		
		Сопоставление = Новый Структура;
		Сопоставление.Вставить("Наименование", ВыборкаТоваров.НаименованиеПолное);
		Если ЗначениеЗаполнено(ВыборкаТоваров.Характеристика) Тогда
			Сопоставление.Вставить("Характеристика", ВыборкаТоваров.ХарактеристикаНаименование);
		КонецЕсли;
		Сопоставление.Вставить("ЕдиницаИзмерения", НоваяСтрока.БазоваяЕдиницаНаименование);
		Сопоставление.Вставить("Артикул",          НоваяСтрока.Артикул);
		Сопоставление.Вставить("Штрихкод",         НоваяСтрока.Штрихкод);
		Сопоставление.Вставить("ЕдиницаИзмеренияКод", ВыборкаТоваров.БазоваяЕдиницаКод);
		Сопоставление.Вставить("СтавкаНДС", ВыборкаТоваров.НоменклатураСтавкаНДС);
		
		Сопоставление.Вставить("НоменклатураИБ",   НоваяСтрока.Номенклатура);
		Сопоставление.Вставить("ХарактеристикаИБ", ВыборкаТоваров.Характеристика);
		Сопоставление.Вставить("УпаковкаИБ",       НоваяСтрока.БазоваяЕдиницаСсылка);
		НоваяСтрока.Сопоставление = Сопоставление;
		
		Если НоваяСтрока.Сопоставление.Свойство("ШтрихкодКомбинации") Тогда
			НоваяСтрока.Штрихкод = НоваяСтрока.Сопоставление.ШтрихкодКомбинации;
		КонецЕсли;
		
		
	КонецЦикла;
	
	ЗаполнитьПараметрыОбработкиОшибокВТаблицеТоваровCML(ТаблицаТоваров);
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДокумента, ТаблицаТоваров, "Товары");
	
	Если СтруктураДанных.Свойство("ТаблицаЭтаповГрафикаОплаты") Тогда
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "СрокПлатежа", 
			СтруктураДанных.ТаблицаЭтаповГрафикаОплаты[0].ДатаПлатежа);
		
		// Заполняется график оплаты.
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДокумента,
			СтруктураДанных.ТаблицаЭтаповГрафикаОплаты, "ГрафикОплаты");
		
	КонецЕсли;
	
	// Заполняется таблица документы сделки.
	ЗаполнитьДокументыСделки(ДеревоДокумента, ВыборкаШапки);
	
	// Заполняется уникальный идентификатор платежа.
	ИдентификаторПлатежа = ВыборкаШапки.ИдентификаторПлатежа;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "УникальныйИдентификаторПлатежа", ИдентификаторПлатежа);
	
	// заполняем итоги по документу
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить сумму документа. Возможные причины:
		|	- не заполнена табличная часть ""Товары""
		|	- не заполнена колонка ""Сумма""'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Сумма", ВыборкаШапки.СуммаДокумента,
		ТекстОшибки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.Сумма",
		ВыборкаШапки.СуммаДокумента, ТекстОшибки);
		
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.ЦенаВключаетНДС", ВыборкаШапки.ЦенаВключаетНДС);
	
	СуммаНДСИтог = 0;
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить итоговую сумму НДС. Возможные причины:
		|	- не заполнена табличная часть ""Товары""
		|	- не заполнена колонка ""Сумма НДС""'");
	Если Не ТаблицаТоваров.Колонки.Найти("СуммаНДС") = Неопределено Тогда
		СуммаНДСИтог = ТаблицаТоваров.Итог("СуммаНДС");
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаНДС",
		СуммаНДСИтог, ТекстОшибки);
	
	СуммаСкидкиИтог = 0;
	Если Не ТаблицаТоваров.Колонки.Найти("СуммаСкидки") = Неопределено Тогда
		СуммаСкидкиИтог = ТаблицаТоваров.Итог("СуммаСкидки");
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаСкидки", СуммаСкидкиИтог);
	
	СуммаБезСкидки = ВыборкаШапки.СуммаДокумента + СуммаСкидкиИтог;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаБезСкидки", СуммаБезСкидки);
	
	СуммаПредставление = "";
	ФорматСумм(ВыборкаШапки.СуммаДокумента, СуммаПредставление, ВыборкаШапки.Валюта);
	
	ИтоговаяСтрока = СтрШаблон(НСтр("ru='Всего наименований %1, на сумму %2'"),
		ТаблицаТоваров.Количество(), СуммаПредставление);

	ИтоговаяСтрока = ИтоговаяСтрока + Символы.ПС + РаботаСКурсамиВалют.СформироватьСуммуПрописью(ВыборкаШапки.СуммаДокумента, ВыборкаШапки.Валюта);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогиПрописью", ИтоговаяСтрока);
	
	Если ЗначениеЗаполнено(ВыборкаШапки.НомерСчета) Тогда
		
		ДанныеСчета = Новый Структура;
		ДанныеСчета.Вставить("БанковскийСчет", ВыборкаШапки.БанковскийСчет);
		ДанныеСчета.Вставить("НомерСчета", ВыборкаШапки.НомерСчета);
		ДанныеСчета.Вставить("Комментарий", ВыборкаШапки.БанковскийСчетКомментарий);
		ДанныеСчета.Вставить("Банк", ВыборкаШапки.Банк);
		ДанныеСчета.Вставить("БанкНаименование", ВыборкаШапки.Банк.Наименование);
		ДанныеСчета.Вставить("БанкБИК", ВыборкаШапки.Банк.Код);
		ДанныеСчета.Вставить("БанкСчетКорр", ВыборкаШапки.Банк.КоррСчет);
		
		РеквизитыБанкаКорреспондента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаШапки.БанкДляРасчетов, "Наименование, КоррСчет, Код");
		ДанныеСчета.Вставить("БанкДляРасчетов", ВыборкаШапки.БанкДляРасчетов);
		ДанныеСчета.Вставить("БанкКоррНаименование", РеквизитыБанкаКорреспондента.Наименование);
		ДанныеСчета.Вставить("БанкКоррБИК", РеквизитыБанкаКорреспондента.Код);
		ДанныеСчета.Вставить("БанкКоррСчетКорр", РеквизитыБанкаКорреспондента.КоррСчет);
		
		ДобавитьВДеревоДанныеСчета(ДеревоДокумента, ДанныеСчета);
		
	КонецЕсли;
	
	// _Демо начало примера
	Если ЗначениеЗаполнено(ВыборкаШапки.БанковскийСчет) Тогда
		РеквизитыБанковскогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаШапки.БанковскийСчет, 
			"_ДемоПредставлениеПолучателя,_ДемоКПС,_ДемоОКТМО");
		
		ДопДанныеБюджетные = Новый Структура;
		
		Если Не ПустаяСтрока(РеквизитыБанковскогоСчета._ДемоПредставлениеПолучателя) Тогда
			ДопДанныеБюджетные.Вставить("НаименованиеПолучателяПлатежа",
				РеквизитыБанковскогоСчета._ДемоПредставлениеПолучателя);

			Если Не ПустаяСтрока(РеквизитыБанковскогоСчета._ДемоКПС) Тогда
				ДопДанныеБюджетные.Вставить("КПС", РеквизитыБанковскогоСчета._ДемоКПС);
			КонецЕсли;

			Если Не ПустаяСтрока(РеквизитыБанковскогоСчета._ДемоОКТМО) Тогда
				ДопДанныеБюджетные.Вставить("ОКТМО", РеквизитыБанковскогоСчета._ДемоОКТМО);
			КонецЕсли;

			ЭлектронноеВзаимодействие.ДобавитьДопДанныеВДерево(ДеревоДокумента, ДопДанныеБюджетные, Истина);
		КонецЕсли;
		
	КонецЕсли;
	// _Демо конец примера
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДокументаCML.
Процедура ПриОтраженииВУчетеДокументаCML(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	ТипДокумента = ПараметрыДляОтраженияВУчете.ПараметрыЭлектронногоДокумента.ТипДокумента;
	
	ПараметрыПоФорматуДокумента = ПараметрыДляОтраженияВУчете.ПараметрыПоФорматуДокумента;
	ДеревоРазбора = ПараметрыПоФорматуДокумента.ДеревоСсылокНаОбъекты;
	
	СсылкаНаВладельца = Неопределено;
	Если ЗначениеЗаполнено(РезультатОтраженияВУчете.ДокументыУчета) Тогда
		СсылкаНаВладельца = РезультатОтраженияВУчете.ДокументыУчета[0];
	КонецЕсли;
	
	НайденныйОбъект = Неопределено;
	Если ТипДокумента = ТипыДокументов.ТоварнаяНакладная
		ИЛИ ТипДокумента = ТипыДокументов.АктВыполненныхРабот
		ИЛИ ТипДокумента = ТипыДокументов.АктНаПередачуПрав
		ИЛИ ТипДокумента = ТипыДокументов.СоглашениеОбИзмененииСтоимости Тогда
		
		НайденныйОбъект = НайтиСоздатьПоступлениеТоваровУслуг(ДанныеЭлектронногоДокумента, ДеревоРазбора,
			СсылкаНаВладельца, ПараметрыПоФорматуДокумента.СпособОбработки, ПараметрыДляОтраженияВУчете);
		
	ИначеЕсли (ТипДокумента = ТипыДокументов.СчетФактура
		ИЛИ ТипДокумента = ТипыДокументов.КорректировочныйСчетФактура) Тогда
		
		НайденныйОбъект = НайтиСоздатьСчетФактуру(ДанныеЭлектронногоДокумента, ДеревоРазбора, СсылкаНаВладельца);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.КаталогТоваров Тогда
		
		СохранитьДанныеКаталогаТоваров(ДанныеЭлектронногоДокумента, ДеревоРазбора);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.РеквизитыОрганизации Тогда
		
		НайденныйОбъект = НовыйКонтрагент(ДанныеЭлектронногоДокумента, ДеревоРазбора, СсылкаНаВладельца)
		
	ИначеЕсли ТипДокумента = ТипыДокументов.ЗаказТовара Тогда
	
		НайденныйОбъект = НайтиСоздатьЗаказПокупателя(ДанныеЭлектронногоДокумента, ДеревоРазбора, СсылкаНаВладельца,
			ПараметрыДляОтраженияВУчете);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.ОтветНаЗаказ Тогда
	
		НайденныйОбъект = НайтиСоздатьЗаказПоставщику(ДанныеЭлектронногоДокумента, ДеревоРазбора, СсылкаНаВладельца,
			ПараметрыДляОтраженияВУчете);

	ИначеЕсли ТипДокумента = ТипыДокументов.СчетНаОплату Тогда
		
		НайденныйОбъект = НайтиСоздатьСчетНаОплату(ДанныеЭлектронногоДокумента, ДеревоРазбора, СсылкаНаВладельца,
			ПараметрыДляОтраженияВУчете);

	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденныйОбъект) Тогда
		РезультатОтраженияВУчете.ДокументыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НайденныйОбъект);
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДокументаПередачаТоваров.
Процедура ПриОтраженииВУчетеДокументаПередачаТоваров(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	СпособОбработки = ПараметрыДляОтраженияВУчете.ПараметрыПоФорматуДокумента.СпособОбработки;
	
	СсылкаНаВладельца = Неопределено;
	Если ЗначениеЗаполнено(РезультатОтраженияВУчете.ДокументыУчета) Тогда
		СсылкаНаВладельца = РезультатОтраженияВУчете.ДокументыУчета[0];
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	Если СпособОбработки = "ВозвратТоваровОтПокупателя" Тогда
		ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.НакладнаяНаВозврат;
	Иначе
		ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная;
	КонецЕсли;
	
	ДокументОбъект.НомерЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"НомерТоварнойНакладной");
	ДокументОбъект.НомерИсправления = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"НомерИсправления");
	Если ЗначениеЗаполнено(ДокументОбъект.НомерИсправления) Тогда
		ВидОперации = Перечисления.ВидыОпераций.Исправление;
		
		ДокументОбъект.ДатаЭД  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДанныеЭлектронногоДокумента, "ДатаИсправления");
		ДокументОбъект.НомерИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДанныеЭлектронногоДокумента, "НомерТоварнойНакладной");
		ДокументОбъект.ДатаИсходногоДокумента  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДанныеЭлектронногоДокумента, "ДатаТоварнойНакладной");
	Иначе
		ВидОперации = Перечисления.ВидыОпераций.Реализация;
		
		ДокументОбъект.ДатаЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДанныеЭлектронногоДокумента, "ДатаТоварнойНакладной");
	КонецЕсли;
	ДокументОбъект.ВидОперации = ВидОперации;
	
	ДокументОбъект.Валюта = ЭлектронноеВзаимодействие.НайтиСсылку("Валюты",
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента, "ВалютаКод"));
	
	ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(ДанныеЭлектронногоДокумента, "Плательщик");
	ДокументОбъект.Контрагент  = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "Поставщик");
	
	ДокументОбъект.Грузоотправитель = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "Грузоотправитель");
	ДокументОбъект.Грузополучатель  = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "Грузополучатель");
	
	ДопДанные = ДанныеЭлектронногоДокумента.Строки.Найти("ДопДанные", "ПолныйПуть");
	ДопДанные = ДопДанные.Строки.Найти("ДопДанные.Подписанные", "ПолныйПуть");
	
	СведенияОПеревозчике = "";
	
	Если ДопДанные <> Неопределено
		И ДопДанные.Строки.Количество() Тогда
		
		Для Каждого СтрокаДопДанных Из ДопДанные.Строки Цикл
			Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СтрокаДопДанных, "ДопДанные.Подписанные.НомерСтроки.Идентификатор");
			Значение = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СтрокаДопДанных, "ДопДанные.Подписанные.НомерСтроки.Значение");
				
			Если Идентификатор = "СведенияОПеревозчике" Тогда
				СведенияОПеревозчике = Значение;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОПеревозчике) Тогда
		Позиция = СтрНайти(СведенияОПеревозчике, ", ", НаправлениеПоиска.СКонца);
		Если Позиция > 0 Тогда
			СтрокаИННКПП = Сред(СведенияОПеревозчике, Позиция + 2);
			МассивИННКПП = СтрРазделить(СтрокаИННКПП, "/", Ложь);
			Количество = МассивИННКПП.Количество();
			Если Количество > 0 Тогда
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ ПЕРВЫЕ 1
					|	Контрагенты.Ссылка КАК Ссылка
					|ИЗ
					|	Справочник.Контрагенты КАК Контрагенты
					|ГДЕ
					|	НЕ Контрагенты.ПометкаУдаления
					|	И Контрагенты.ИНН = &ИНН";
				Запрос.УстановитьПараметр("ИНН", МассивИННКПП[0]);
				Если Количество > 1 Тогда
					Запрос.Текст = Запрос.Текст + " И Контрагенты.КПП = &КПП";
					Запрос.УстановитьПараметр("КПП", МассивИННКПП[1]);
				КонецЕсли;
				
				Выборка = Запрос.Выполнить().Выбрать();
				
				Если Выборка.Следующий() Тогда
					ДокументОбъект.Перевозчик = Выборка.Ссылка;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект.ИдентификаторГосКонтракта = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДанныеЭлектронногоДокумента, "ИдГосКонтракта");
	
	ТранспортнаяНакладная = ДанныеЭлектронногоДокумента.Строки.Найти("ТранспортнаяНакладная", "ПолныйПуть");
	Если ТранспортнаяНакладная <> Неопределено
		И ТранспортнаяНакладная.Строки.Количество() Тогда
		
		ДокументОбъект.НомерТранспортнойНакладной = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ТранспортнаяНакладная.Строки[0], "ТранспортнаяНакладная.НомерСтроки.ТранспортнаяНакладнаяНомер");
		
		ДокументОбъект.ДатаТранспортнойНакладной = ДатаИзСтроки(
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ТранспортнаяНакладная.Строки[0],
				"ТранспортнаяНакладная.НомерСтроки.ТранспортнаяНакладнаяДата"));
		
	КонецЕсли;
	
	ДокументыОснования = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента, "ДокументыОснования");
	Если ЗначениеЗаполнено(ДокументыОснования) Тогда
		Если ТипЗнч(ДокументыОснования) = Тип("Массив") И ДокументыОснования.Количество() > 0 Тогда
			ДокументОбъект.ДокументОснование = ДокументыОснования[0];
		Иначе
			ДокументОбъект.ДокументОснование = ДокументыОснования;
		КонецЕсли;
	КонецЕсли;
	
	// Поиск и заполнения договора контрагента.
	ОснованияОтгрузки = ДанныеЭлектронногоДокумента.Строки.Найти("Основание", "ПолныйПуть");
	Если ОснованияОтгрузки <> Неопределено Тогда
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "Основание.НомерСтроки.ДокОснованиеНомер");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				ДоговорДата = ДатаИзСтроки(ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СтрокаОснованиеОтгрузки, "Основание.НомерСтроки.ДокОснованиеДата"));
				
				СвойстваДоговора = Новый Структура;
				СвойстваДоговора.Вставить("НомерДоговора", ДоговорНомер);
				СвойстваДоговора.Вставить("ДатаДоговора", ДоговорДата);
				СвойстваДоговора.Вставить("Организация", ДокументОбъект.Организация);
				СвойстваДоговора.Вставить("Владелец", ДокументОбъект.Контрагент);
				
				ДоговорКонтрагента = ЭлектронноеВзаимодействие.НайтиСсылку("ДоговорыКонтрагентов", ,СвойстваДоговора);
				ДокументОбъект.ДоговорКонтрагента = ДоговорКонтрагента;
				
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	// Поиск и заполнение банковского счета контрагента.
	НомерСчета = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"Поставщик.БанковскийСчет.НомерСчета");
	БИКБанка = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"Поставщик.БанковскийСчет.БИК");
	ДокументОбъект.БанковскийСчетКонтрагента = БанковскийСчетКонтрагента(
		ДокументОбъект.Контрагент, БИКБанка, НомерСчета, ДокументОбъект.Валюта);
	
	ДокументОбъект.СведенияОТранспортировкеИГрузе = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
		ДанныеЭлектронногоДокумента, "ДопДанные.Подписанные.СведенияОТранспортировке", Ложь);
	
	ОблагаетсяНДСУПокупателя = Ложь;
	ИспользоватьСопоставлениеНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	
	ДокументОбъект.Товары.Очистить();
	
	ТаблицаТоваров = ДокументОбъект.Товары.ВыгрузитьКолонки();
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(ТаблицаТоваров);
	
	// Сведения таблицы.
	СведенияОТоварах = ДанныеЭлектронногоДокумента.Строки.Найти("ТаблицаТоваров", "ПолныйПуть");
	Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		МассаНетто = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "ТаблицаТоваров.НомерСтроки.МассаНетто");
		КоличествоМест = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "ТаблицаТоваров.НомерСтроки.КоличествоМест");
		НоваяСтрока.КоличествоУпаковок = ?(ЗначениеЗаполнено(МассаНетто), МассаНетто, КоличествоМест);
		НоваяСтрока.Цена = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"ТаблицаТоваров.НомерСтроки.Цена");
		НоваяСтрока.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"ТаблицаТоваров.НомерСтроки.СуммаБезНДС");
		
		СтавкаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
			"ТаблицаТоваров.НомерСтроки.СтавкаНДС");
		Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
			НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
			ОблагаетсяНДСУПокупателя = Истина;
		Иначе
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаСНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"ТаблицаТоваров.НомерСтроки.СуммаСНДС");
			НоваяСтрока.СуммаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"ТаблицаТоваров.НомерСтроки.СуммаНДС");
		КонецЕсли;
		
		НоваяСтрока.СуммаАкциза = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СведенияОТоваре, "ТаблицаТоваров.НомерСтроки.ДопДанныеПодписанные.СуммаАкциза", Ложь);
		
		НоваяСтрока.НомерГТД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СведенияОТоваре, "ТаблицаТоваров.НомерСтроки.ДопДанныеПодписанные.НомерТД", Ложь);
		КодСтраны = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СведенияОТоваре, "ТаблицаТоваров.НомерСтроки.ДопДанныеПодписанные.КодСтраныПроисхождения", Ложь);
		Если ЗначениеЗаполнено(КодСтраны) Тогда
			НоваяСтрока.СтранаПроисхождения = УправлениеКонтактнойИнформацией.СтранаМираПоКодуИлиНаименованию(КодСтраны);
		КонецЕсли;
		
		Сопоставление = СведенияОТоваре.Строки.Найти(
			"ТаблицаТоваров.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
		Если Сопоставление <> Неопределено Тогда
			
			Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"ТаблицаТоваров.НомерСтроки.Сопоставление.Идентификатор");
			Если ЗначениеЗаполнено(Идентификатор) Тогда
				НоваяСтрока.ИдентификаторКонтрагента = Идентификатор;
			КонецЕсли;
			
			Если ИспользоватьСопоставлениеНоменклатуры Тогда
				
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"ТаблицаТоваров.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
				КонецЕсли;
				
				Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"ТаблицаТоваров.НомерСтроки.Сопоставление.ХарактеристикаИБ");
				Если ЗначениеЗаполнено(Характеристика) Тогда
					НоваяСтрока.Характеристика = Характеристика;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
				"ТаблицаТоваров.НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;

			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
			ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОТоваре, "ТаблицаТоваров.НомерСтроки.БазоваяЕдиницаКод");
				
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
				НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.УпаковкаНоменклатуры(
					НоваяСтрока.Номенклатура, ЕдиницаИзмеренияКод);
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.НаименованиеКонтрагента = ПредставлениеНоменклатурыПоставщика(
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "ТаблицаТоваров.НомерСтроки.НаименованиеНоменклатуры"),
			ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "ТаблицаТоваров.НомерСтроки.НаименованиеХарактеристики"));
		
		Если КолонкаСуществует(ТаблицаТоваров, "НаименованиеПоставщика") Тогда
			НоваяСтрока.НаименованиеПоставщика = ПредставлениеНоменклатурыПоставщика(
				ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "ТаблицаТоваров.НомерСтроки.НаименованиеНоменклатуры"),
				ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре, "ТаблицаТоваров.НомерСтроки.НаименованиеХарактеристики"));
		КонецЕсли;
			
		ЗаполнитьВидДеятельностиРаздельногоУчетаНДС(НоваяСтрока);
		
		РассчитатьКоличествоБазовыхЕдиниц(НоваяСтрока);
	КонецЦикла;
	
	СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(ТаблицаТоваров, ДокументОбъект.Контрагент);
	ДокументОбъект.Товары.Загрузить(ТаблицаТоваров);
	
	ДокументОбъект.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;
	
	Если ОблагаетсяНДСУПокупателя Тогда
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
			"ВсегоПоНакладной.СуммаБезНДС");
	Иначе
		ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
			"ВсегоПоНакладной.СуммаСНДС");
	КонецЕсли;
	
	РежимЗаписиПроведение = Истина;
	Если ДокументОбъект.ВидОперации <> Перечисления.ВидыОпераций.Реализация Тогда
		РежимЗаписиПроведение = ЗначениеЗаполнено(ДокументОбъект.ДокументОснование);
	КонецЕсли;
	
	ЗаписатьДокумент(ДокументОбъект, РежимЗаписиПроведение);
	
	РезультатОтраженияВУчете.ДокументыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументОбъект.Ссылка);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДокументаПередачаРезультатовРабот.
Процедура ПриОтраженииВУчетеДокументаПередачаРезультатовРабот(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	СсылкаНаВладельца = Неопределено;
	Если ЗначениеЗаполнено(РезультатОтраженияВУчете.ДокументыУчета) Тогда
		СсылкаНаВладельца = РезультатОтраженияВУчете.ДокументыУчета[0];
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот;
	
	ДокументОбъект.НомерЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"НомерАкта");
	ДокументОбъект.НомерИсправления = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"НомерИсправления");
	Если ЗначениеЗаполнено(ДокументОбъект.НомерИсправления) Тогда
		ВидОперации = Перечисления.ВидыОпераций.Исправление;
		
		ДокументОбъект.ДатаЭД  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДанныеЭлектронногоДокумента, "ДатаИсправления");
		ДокументОбъект.НомерИсходногоДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДанныеЭлектронногоДокумента, "НомерАкта");
		ДокументОбъект.ДатаИсходногоДокумента  = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДанныеЭлектронногоДокумента, "ДатаАкта");
	Иначе
		ВидОперации = Перечисления.ВидыОпераций.Реализация;
		
		ДокументОбъект.ДатаЭД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			ДанныеЭлектронногоДокумента, "ДатаАкта");
	КонецЕсли;
	ДокументОбъект.ВидОперации = ВидОперации;
	
	ДокументОбъект.Валюта = ЭлектронноеВзаимодействие.НайтиСсылку("Валюты",
		ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента, "ВалютаКод"));
	
	ДокументОбъект.Контрагент  = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "Заказчик");
	ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(ДанныеЭлектронногоДокумента, "Исполнитель");
	
	// Заполним основание.
	ДокументыОснования = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента, "ДокументыОснования");
	Если ЗначениеЗаполнено(ДокументыОснования) Тогда
		Если ТипЗнч(ДокументыОснования) = Тип("Массив") И ДокументыОснования.Количество() > 0 Тогда
			ДокументОбъект.ДокументОснование = ДокументыОснования[0];
		Иначе
			ДокументОбъект.ДокументОснование = ДокументыОснования;
		КонецЕсли;
	КонецЕсли;
	
	// Поиск и заполнения договора контрагента.
	ОснованияОтгрузки = ДанныеЭлектронногоДокумента.Строки.Найти("Основание", "ПолныйПуть");
	Если ОснованияОтгрузки <> Неопределено Тогда
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "Основание.НомерСтроки.ДокОснованиеНомер");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				ДоговорДата = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
					СтрокаОснованиеОтгрузки, "Основание.НомерСтроки.ДокОснованиеДата");
				
				СвойстваДоговора = Новый Структура;
				СвойстваДоговора.Вставить("НомерДоговора", ДоговорНомер);
				СвойстваДоговора.Вставить("ДатаДоговора", ДоговорДата);
				СвойстваДоговора.Вставить("Организация", ДокументОбъект.Организация);
				СвойстваДоговора.Вставить("Владелец", ДокументОбъект.Контрагент);
				
				ДоговорКонтрагента = ЭлектронноеВзаимодействие.НайтиСсылку("ДоговорыКонтрагентов", , СвойстваДоговора);
				ДокументОбъект.ДоговорКонтрагента = ДоговорКонтрагента;
				
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	// Поиск и заполнение банковского счета контрагента.
	НомерСчета = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"Заказчик.БанковскийСчет.НомерСчета");
	БИКБанка = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"Заказчик.БанковскийСчет.БИК");
	ДокументОбъект.БанковскийСчетКонтрагента = БанковскийСчетКонтрагента(
		ДокументОбъект.Контрагент, БИКБанка, НомерСчета, ДокументОбъект.Валюта);
	
	ИспользоватьСопоставлениеНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	
	ДокументОбъект.Товары.Очистить();
	
	ТаблицаТоваров = ДокументОбъект.Товары.ВыгрузитьКолонки();
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(ТаблицаТоваров);
	
	// Сведения таблицы.
	СведенияОбУслугах = ДанныеЭлектронногоДокумента.Строки.Найти("ТаблицаУслуг", "ПолныйПуть");
	Для Каждого СведенияОбУслуге Из СведенияОбУслугах.Строки Цикл
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		// Обязательные реквизиты:
		НоваяСтрока.СтавкаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОбУслуге,
			"ТаблицаУслуг.НомерСтроки.СтавкаНДС");
		НоваяСтрока.СуммаСНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОбУслуге,
			"ТаблицаУслуг.НомерСтроки.СуммаСНДС");
		НоваяСтрока.СуммаНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОбУслуге,
			"ТаблицаУслуг.НомерСтроки.СуммаНДС");
		
		// Необязательные реквизиты:
		НоваяСтрока.КоличествоУпаковок = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОбУслуге,
			"ТаблицаУслуг.НомерСтроки.Количество");
		НоваяСтрока.Цена = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОбУслуге,
			"ТаблицаУслуг.НомерСтроки.Цена");
		НоваяСтрока.Сумма = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОбУслуге,
			"ТаблицаУслуг.НомерСтроки.СуммаБезНДС");		
			
		Если НоваяСтрока.Количество = 0 Тогда
			НоваяСтрока.Количество = 1;
		КонецЕсли;

		Если НоваяСтрока.Цена = 0 И НоваяСтрока.КоличествоУпаковок <> 0 Тогда
			НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.КоличествоУпаковок;
		КонецЕсли;
		
		Сопоставление = СведенияОбУслуге.Строки.Найти(
			"ТаблицаУслуг.НомерСтроки.Сопоставление", "ПолныйПуть");
		Если Сопоставление <> Неопределено Тогда
			
			Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОбУслуге,
				"ТаблицаУслуг.НомерСтроки.Сопоставление.Идентификатор");
			Если ЗначениеЗаполнено(Идентификатор) Тогда
				НоваяСтрока.ИдентификаторКонтрагента = Идентификатор;
			КонецЕсли;
			
			Если ИспользоватьСопоставлениеНоменклатуры Тогда
				
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОбУслуге,
					"ТаблицаУслуг.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
				КонецЕсли;
				
				Характеристика = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОбУслуге,
					"ТаблицаУслуг.НомерСтроки.Сопоставление.ХарактеристикаИБ");
				Если ЗначениеЗаполнено(Характеристика) Тогда
					НоваяСтрока.Характеристика = Характеристика;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОбУслуге,
					"ТаблицаУслуг.НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;

			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
			ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОбУслуге, "ТаблицаУслуг.НомерСтроки.ЕдиницаИзмеренияКод");
			ЕдиницаИзмеренияНаименование = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОбУслуге, "ТаблицаУслуг.НомерСтроки.ЕдиницаИзмеренияНаименование");
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) И ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
				НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.УпаковкаНоменклатуры(
					НоваяСтрока.Номенклатура, ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
			ИначеЕсли ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
				НоваяСтрока.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.ЕдиницаИзмеренияПоКоду(
					ЕдиницаИзмеренияКод, ЕдиницаИзмеренияНаименование);
			КонецЕсли;
		КонецЕсли;
		
		НаименованиеУслуги = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
			СведенияОбУслуге, "ТаблицаУслуг.НомерСтроки.НаименованиеНоменклатуры");
			
		Если Не ЗначениеЗаполнено(НаименованиеУслуги) Тогда
			НаименованиеУслуги = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(
				СведенияОбУслуге, "ТаблицаУслуг.НомерСтроки.Описание");
		КонецЕсли;
		
		НоваяСтрока.НаименованиеКонтрагента = ПредставлениеНоменклатурыПоставщика(НаименованиеУслуги);
		НоваяСтрока.НаименованиеПоставщика = ПредставлениеНоменклатурыПоставщика(НаименованиеУслуги);
		
		РассчитатьКоличествоБазовыхЕдиниц(НоваяСтрока);
	КонецЦикла;
	
	СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(ТаблицаТоваров, ДокументОбъект.Контрагент);
	ДокументОбъект.Товары.Загрузить(ТаблицаТоваров);
	
	ДокументОбъект.СуммаДокумента = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"ОписаниеУслуги.СуммаСНДСИтого");
	
	РежимЗаписиПроведение = Истина;
	Если ДокументОбъект.ВидОперации <> Перечисления.ВидыОпераций.Реализация Тогда
		РежимЗаписиПроведение = ЗначениеЗаполнено(ДокументОбъект.ДокументОснование);
	КонецЕсли;
	
	ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
	ЗаписатьДокумент(ДокументОбъект, РежимЗаписиПроведение);
	
	РезультатОтраженияВУчете.ДокументыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументОбъект.Ссылка);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_2016.
Процедура ПриОтраженииВУчетеУниверсальногоПередаточногоДокумента_2016(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	СпособОбработки = ПараметрыДляОтраженияВУчете.ПараметрыПоФорматуДокумента.СпособОбработки;
	
	ПервичныйДокумент = Неопределено;
	СчетФактура = Неопределено;
	
	СпособОбработкиПервичногоДокумента = "";
	СпособОбработкиСчетаФактуры = "";
	
	Если ЗначениеЗаполнено(СпособОбработки) И ТипЗнч(СпособОбработки) = Тип("Структура") Тогда
		
		Если СпособОбработки.Свойство("ПервичныйДокумент") Тогда
			СпособОбработкиПервичногоДокумента = СпособОбработки.ПервичныйДокумент;
		КонецЕсли;
		
		Если СпособОбработки.Свойство("СчетФактура") Тогда
			СпособОбработкиСчетаФактуры = СпособОбработки.СчетФактура;
		КонецЕсли;
	
	Иначе
		СпособОбработкиПервичногоДокумента = СпособОбработки;
		СпособОбработкиСчетаФактуры = СпособОбработки;
	КонецЕсли;
	
	Для Каждого Строка Из РезультатОтраженияВУчете.ДокументыУчета Цикл
		Если ТипЗнч(Строка) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
			СчетФактура = Строка;
		Иначе
			ПервичныйДокумент = Строка;
		КонецЕсли;
	КонецЦикла;

	ФункцияУПД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента, "Функция");
	
	ДокументыУчета = Новый Массив;
	Если ФункцияУПД = "ДОП" Или ФункцияУПД = "СЧФДОП" Тогда
		НайтиСоздатьУПДДокументОПередаче(ДанныеЭлектронногоДокумента, ПервичныйДокумент, СпособОбработкиПервичногоДокумента,
			РезультатОтраженияВУчете.ОписаниеОшибки);
		ДокументыУчета.Добавить(ПервичныйДокумент);
	КонецЕсли;
	
	// Заполним основание в СФ.
	ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"ДокументыОснованияСчетаФактуры");
	Если Не ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		ДокументыОснованияСчетаФактуры = Новый Массив;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПервичныйДокумент) Тогда
		ДокументыОснованияСчетаФактуры.Добавить(ПервичныйДокумент);
	КонецЕсли;

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента, "ДокументыОснованияСчетаФактуры",
		ДокументыОснованияСчетаФактуры);
	
	Если ФункцияУПД = "СЧФ" Или ФункцияУПД = "СЧФДОП" Тогда
		НайтиСоздатьУПДСчетФактуру(ДанныеЭлектронногоДокумента, СчетФактура, СпособОбработкиСчетаФактуры,
			РезультатОтраженияВУчете.ОписаниеОшибки);
	КонецЕсли;
	ДокументыУчета.Добавить(СчетФактура);
	
	РезультатОтраженияВУчете.ДокументыУчета = ДокументыУчета;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДокументаСчетНаОплату101.
Процедура ПриОтраженииВУчетеДокументаСчетНаОплату101(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	Данные = Новый Структура;
	Для Каждого СтрокаДерева Из ДанныеЭлектронногоДокумента.Строки Цикл
		Путь = СтрокаДерева.ПолныйПуть;
		ДанныеСтроки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДанныеЭлектронногоДокумента, Путь);
		Данные.Вставить(Путь, ДанныеСтроки);
	КонецЦикла;
		
	Если ЗначениеЗаполнено(РезультатОтраженияВУчете.ДокументыУчета) Тогда
		ДокументОбъект = РезультатОтраженияВУчете.ДокументыУчета[0].ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.СчетНаОплатуПоставщика.СоздатьДокумент();
		ДокументОбъект.ВидДокумента = Перечисления.ВидыДокументов.СчетНаОплату;
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	// Шапка.
	ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(ДанныеЭлектронногоДокумента, "Покупатель");
	ДокументОбъект.Контрагент  = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "Продавец");
	
	ДокументОбъект.ПолучательДенежныхСредств = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "ПолучательДенежныхСредств");
	ДокументОбъект.Плательщик  = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "Плательщик");
	
	ДокументОбъект.Грузоотправитель = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "Грузоотправитель");
	ДокументОбъект.Грузополучатель  = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "Грузополучатель");
	
	ДокументОбъект.НомерЭД = Данные.НомерДокумента;
	ДокументОбъект.ДатаЭД = Данные.ДатаДокумента;
	
	ДокументОбъект.Валюта = Справочники.Валюты.НайтиПоКоду(Данные.ДенежнаяЕдиница.КодВалюты);
	Если Не ЗначениеЗаполнено(ДокументОбъект.Валюта) Тогда
		ДокументОбъект.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
	ОблагаетсяНДСУПокупателя = Ложь;
	
	// Товары.
	Товары = ДокументОбъект.Товары.ВыгрузитьКолонки();
	Для Каждого ТекущаяСтрока Из Данные.ТаблицаТоваров Цикл
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.Номенклатура = ТекущаяСтрока.Сопоставление.НоменклатураИБ;
		НоваяСтрока.Характеристика = ТекущаяСтрока.Сопоставление.ХарактеристикаИБ;
		НоваяСтрока.ЕдиницаИзмерения = ТекущаяСтрока.Сопоставление.УпаковкаИБ;
		НоваяСтрока.НаименованиеПоставщика = ТекущаяСтрока.Наименование;
		НоваяСтрока.Количество = ТекущаяСтрока.Количество;
		НоваяСтрока.КоличествоУпаковок = ТекущаяСтрока.Количество;
		НоваяСтрока.Цена = ТекущаяСтрока.ЦенаЗаЕдиницуИзмерения;
		НоваяСтрока.Сумма = ТекущаяСтрока.СтоимостьБезНДС;
		НоваяСтрока.СуммаСкидки = ТекущаяСтрока.СуммаСкидки;
		СтавкаНДС = ТекущаяСтрока.СтавкаНДС;
		Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
			НоваяСтрока.СуммаСНДС = НоваяСтрока.Сумма;
			ОблагаетсяНДСУПокупателя = Истина;
		Иначе
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаСНДС = ТекущаяСтрока.СтоимостьСНДС;
			НоваяСтрока.СуммаНДС = ТекущаяСтрока.СуммаНДС.СуммаНалога;
		КонецЕсли;
		КодСтраны = ТекущаяСтрока.ДополнительныеСведения.КодСтраныПроисхождения;
		Если ЗначениеЗаполнено(КодСтраны) Тогда
			НоваяСтрока.СтранаПроисхождения = УправлениеКонтактнойИнформацией.СтранаМираПоКодуИлиНаименованию(КодСтраны);
		КонецЕсли;
		НоваяСтрока.КодТНВЭД = ТекущаяСтрока.ДополнительныеСведения.КодВидаТовара;
	КонецЦикла;
	ДокументОбъект.Товары.Загрузить(Товары);
	
	ДокументОбъект.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;
	
	Если ОблагаетсяНДСУПокупателя Тогда
		ДокументОбъект.СуммаДокумента = Данные.ВсегоКОплате.СтоимостьБезНДС;
	Иначе
		ДокументОбъект.СуммаДокумента = Данные.ВсегоКОплате.СтоимостьСНДС;
	КонецЕсли;
	
	ЗаписатьДокумент(ДокументОбъект, Истина);
	РезультатОтраженияВУчете.ДокументыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументОбъект.Ссылка);

КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДоговорногоДокумента101.
Процедура ПриОтраженииВУчетеДоговорногоДокумента101(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	ИнформацияДокумента = ДанныеЭлектронногоДокумента.ИнформацияДокумента[0];
	
	// Если документ не соответствует ограничениям, то не распознаем.
	Если НЕ (ИнформацияДокумента.ФункцияДокумента = ДанныеЭлектронногоДокумента.ФункцииДокумента().Дог
		И ИнформацияДокумента.ПризнакПорядкаФормирования = ДанныеЭлектронногоДокумента.ПризнакиПорядкаФормирования().НеОферта) Тогда
		РезультатОтраженияВУчете.ОписаниеОшибки = НСтр("ru = 'Данный вид договора не поддерживается.'");
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РезультатОтраженияВУчете.ДокументыУчета) Тогда
		СправочникОбъект = РезультатОтраженияВУчете.ДокументыУчета[0].ПолучитьОбъект();
	Иначе
		СправочникОбъект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	КонецЕсли;

	СправочникОбъект.СуммаНДС = 0;
	СправочникОбъект.СуммаВключаетНДС = 0;
	СправочникОбъект.Сумма = 0;
	СправочникОбъект.СтавкаНДС = Перечисления.СтавкиНДС.ПустаяСсылка();
	СправочникОбъект.ПредметДоговора = Перечисления.ПредметыДоговоров.ПустаяСсылка();
	СправочникОбъект.ВалютаРасчетов = Справочники.Валюты.ПустаяСсылка();
	СправочникОбъект.НаличиеПролонгации = Ложь;
	СправочникОбъект.ДатаНачалаДействия = Дата(1, 1, 1);
	СправочникОбъект.ДатаОкончанияДействия = Дата(1, 1, 1);
	
	Если ЗначениеЗаполнено(ДанныеЭлектронногоДокумента.Предмет) Тогда
		ОтборПредмета = Новый Структура;
		ОтборПредмета.Вставить("НомерСтрокиТаблицы", 0);
		НайденныеСтроки = ДанныеЭлектронногоДокумента.Предмет.НайтиСтроки(ОтборПредмета);
	
		Если НайденныеСтроки.Количество() > 0 Тогда
		
			СтрокаОбщейИнформацииПредмета = НайденныеСтроки[0];
			
			ПризнакиПредметаДоговорногоДокумента = ДанныеЭлектронногоДокумента.ПризнакиПредметаДоговорногоДокумента();
			
			ПредметПоДаннымДоговорногоДокумента101(СправочникОбъект.ПредметДоговора,
				СтрокаОбщейИнформацииПредмета.ПризнакПредмета, ПризнакиПредметаДоговорногоДокумента);
			ПроверитьУстановитьВалютуПоДаннымДоговорногоДокумента101(СправочникОбъект.ВалютаРасчетов,
				СтрокаОбщейИнформацииПредмета.КодВалюты);
			СуммаСНДС = СтрокаОбщейИнформацииПредмета.СуммаСНДС;
			СтавкаНДСПоДаннымДоговорногоДокумента101(СправочникОбъект.СтавкаНДС, СтрокаОбщейИнформацииПредмета);
			СправочникОбъект.СуммаНДС = СтрокаОбщейИнформацииПредмета.СуммаНалога;
			
			СправочникОбъект.СуммаВключаетНДС = Истина;
			СправочникОбъект.Сумма = СуммаСНДС;
			
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(ДанныеЭлектронногоДокумента.СведенияОбОбщейСтоимости)
		И ДанныеЭлектронногоДокумента.СведенияОбОбщейСтоимости.Количество() > 0 Тогда
		
		СведенияОбОбщейСтоимости = ДанныеЭлектронногоДокумента.СведенияОбОбщейСтоимости[0];
		СправочникОбъект.СуммаНДС = СведенияОбОбщейСтоимости.СуммаНДС;
		ПроверитьУстановитьВалютуПоДаннымДоговорногоДокумента101(СправочникОбъект.ВалютаРасчетов,
			СведенияОбОбщейСтоимости.КодВалюты);
			
	КонецЕсли;

	СоответствиеПротивоположныхВидовДоговоров = Новый Соответствие;
	ЗаполнитьСоответствиеВидовДоговоровПротивоположноеЗначениюКонтрагентов(СоответствиеПротивоположныхВидовДоговоров);
	СправочникОбъект.ВидДоговора = СоответствиеПротивоположныхВидовДоговоров.Получить(ИнформацияДокумента.ТипДоговора);
	СправочникОбъект.ДатаДоговора = ИнформацияДокумента.ДатаДоговора;
	СправочникОбъект.НомерДоговора = ИнформацияДокумента.НомерДоговора;
	
	Если ЗначениеЗаполнено(СправочникОбъект.НомерДоговора) Тогда
		Если НРег(СправочникОбъект.НомерДоговора) <> "без номера (б/н)" Тогда
			СправочникОбъект.Наименование = СтрШаблон(НСтр("ru = 'Договор № %1'"), СправочникОбъект.НомерДоговора);
		Иначе
			СправочникОбъект.Наименование = СтрШаблон(НСтр("ru = 'Договор %1'"), СправочникОбъект.НомерДоговора);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СправочникОбъект.ДатаДоговора) Тогда
			СправочникОбъект.Наименование = СтрШаблон(НСтр("ru = '%1 от %2'"), СправочникОбъект.Наименование,
				Формат(СправочникОбъект.ДатаДоговора, "ДФ=dd.MM.yyyy;"));
		КонецЕсли;
	КонецЕсли;
	
	ТипыСторон = Обработки.ФорматДоговорныйДокумент101.ТипыСторонДоговора();
	СправочникОбъект.Организация =
		ОрганизацияПоДаннымДоговорногоДокумента101(ИнформацияДокумента.Контрагент.ИдентификационныеСведения,
			ТипыСторон);
	СправочникОбъект.Владелец =
		КонтрагентПоДаннымДоговорногоДокумента101(ИнформацияДокумента.Организация.ИдентификационныеСведения,
			ТипыСторон);
	
	Если ЗначениеЗаполнено(ИнформацияДокумента.СрокДействия) Тогда
		СправочникОбъект.ДатаНачалаДействия = ИнформацияДокумента.СрокДействия.ДатаНачалаДействия;
		СправочникОбъект.ДатаОкончанияДействия = ИнформацияДокумента.СрокДействия.ДатаОкончанияДействия;
		ПризнакиНаличияПролонгации = ИнформацияДокумента.СрокДействия.НаличиеПролонгации;
		Если ПризнакиНаличияПролонгации = ДанныеЭлектронногоДокумента.ПризнакиНаличияПролонгации().ОтсутствуетУсловиеПролонгации Тогда
			СправочникОбъект.НаличиеПролонгации = Ложь;
		Иначе
			СправочникОбъект.НаличиеПролонгации = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ЗаписатьСправочник(СправочникОбъект);
	РезультатОтраженияВУчете.ДокументыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СправочникОбъект.Ссылка);

КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.СоздатьОбъектВБД.
Процедура СоздатьОбъектВБД(СтрокаОбъекта, ДеревоРазбора, НовыйЭлемент) Экспорт
	
	Если СтрокаОбъекта.ОписаниеТипа = "СправочникСсылка.БанковскиеСчета" Тогда
		НовыйЭлемент = СоздатьПерезаполнитьБанковскийСчетКонтрагента(СтрокаОбъекта, ДеревоРазбора);
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.СсылкаНаОбъектПоИННКПП.
Процедура СсылкаНаОбъектПоИННКПП(ТипОбъекта, ИНН, КПП, Ссылка, ДатаСведений = Неопределено) Экспорт
	
	Ссылка = Неопределено;
	
	ИмяМетаданных = ЭлектронноеВзаимодействиеКЭДОПовтИсп.ИмяПрикладногоСправочника(ТипОбъекта);
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Выборка.Ссылка
	|ИЗ
	|	Справочник." + ИмяМетаданных + " КАК Выборка
	|ГДЕ
	|	НЕ Выборка.ПометкаУдаления И
	|	Выборка.ИНН = &ИНН";
	Если ЗначениеЗаполнено(КПП) И КПП <> "0" Тогда
		ТекстЗапроса = ТекстЗапроса
			+ " И Выборка.КПП = &КПП";
		Запрос.УстановитьПараметр("КПП", КПП);
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ИНН", ИНН);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Ссылка = Выборка.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьРеквизитыКонтрагента.
Процедура ЗаполнитьРеквизитыКонтрагента(СтруктураРеквизитов, КонтрагентСсылка) Экспорт
	
	НачатьТранзакцию();
	
	Попытка
		
		Если ЗначениеЗаполнено(СтруктураРеквизитов.Контрагент) Тогда
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Справочник.Контрагенты");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", СтруктураРеквизитов.Контрагент);
			Блокировка.Заблокировать();
			
			Контрагент = СтруктураРеквизитов.Контрагент.ПолучитьОбъект();
		Иначе
			Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
		КонецЕсли;
		
		Контрагент.Наименование = СтруктураРеквизитов.Наименование;
		ИНН_КПП        = СтруктураРеквизитов.ИНН_КПП;
		Контрагент.ИНН = Сред(ИНН_КПП, 1, СтрНайти(ИНН_КПП, "/") - 1);
		Контрагент.КПП = Сред(ИНН_КПП, СтрНайти(ИНН_КПП, "/") + 1);
		
		Контрагент.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	КонтрагентСсылка = Контрагент.Ссылка;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПолучитьЗначениеПеречисления.
Процедура ПолучитьЗначениеПеречисления(ИмяПеречисления, ПредставлениеПеречисления, НайденноеЗначение) Экспорт
	
	Если Метаданные.Перечисления.Найти(ИмяПеречисления) = Неопределено Тогда
		НайденноеЗначение = ПредставлениеПеречисления;
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлПеречисления Из Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
		Если СтрНайти(ВРег(ЭлПеречисления.Синоним), ВРег(ПредставлениеПеречисления)) > 0
			ИЛИ СтрНайти(ВРег(ЭлПеречисления.Имя), ВРег(ПредставлениеПеречисления)) > 0 Тогда
			
			НайденноеЗначение = Перечисления[ИмяПеречисления][ЭлПеречисления.Имя];
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ДанныеСвидетельстваОРегистрацииИП.
Процедура ДанныеСвидетельстваОРегистрацииИП(ИП, Сведения) Экспорт
	
	Если ТипЗнч(ИП) = Тип("СправочникСсылка.Организации") Тогда
		РеквизитыСвидетельства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИП,
			"СвидетельствоДатаВыдачи, СвидетельствоСерияНомер");
		Сведения = СтрШаблон(НСтр("ru = 'Свидетельство о регистрации № %1 от %2'"), 
			РеквизитыСвидетельства.СвидетельствоСерияНомер,
			Формат(РеквизитыСвидетельства.СвидетельствоДатаВыдачи, "ДЛФ=D"));
	Иначе
		Сведения = "";
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.АдресЭлектроннойПочтыКонтрагента.
Процедура АдресЭлектроннойПочтыКонтрагента(Контрагент, АдресЭП) Экспорт
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Представление КАК АдресЭП
	|ИЗ
	|	&ИмяТаблицыКонтактнаяИнформация КАК КонтактнаяИнформация 
	|ГДЕ
	|	КонтактнаяИнформация.Ссылка = &Владелец
	|	И КонтактнаяИнформация.Тип = &Тип
	|	И КонтактнаяИнформация.Вид = &ВидEmail";
	
	Если ТипЗнч(Контрагент) = Тип("СправочникСсылка.Организации") Тогда
		ВидEmail = Справочники.ВидыКонтактнойИнформации["EmailОрганизации"].Ссылка;
	ИначеЕсли ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
		ВидEmail = Справочники.ВидыКонтактнойИнформации["EmailКонтрагента"].Ссылка;
	Иначе
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяТаблицыКонтактнаяИнформация", 
		Контрагент.Метаданные().ПолноеИмя() + ".КонтактнаяИнформация");
	
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	Запрос.УстановитьПараметр("Тип",      Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	Запрос.УстановитьПараметр("ВидEmail", ВидEmail);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		АдресЭП = Выборка.АдресЭП;
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПолучитьБанковскиеСчета.
Процедура ПолучитьБанковскиеСчета(Организация, Таблица) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БанковскиеСчета.Ссылка КАК БанковскийСчет
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Владелец = &Организация
	|	И &УсловияОтбораПоБанку";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("УсловияОтбораПоБанку", Истина);
	
