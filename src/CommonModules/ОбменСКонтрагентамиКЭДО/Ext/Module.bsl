	Иначе
		СпособОбработкиПервичногоДокумента = СпособОбработки;
		СпособОбработкиСчетаФактуры = СпособОбработки;
	КонецЕсли;

	Для Каждого Строка Из РезультатОтраженияВУчете.ДокументыУчета Цикл
		Если ТипЗнч(Строка) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
			СчетФактура = Строка;
		Иначе
			ПервичныйДокумент = Строка;
		КонецЕсли;

	КонецЦикла;

	ФункцияУПД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента, "Функция");
	ДокументыУчета = Новый Массив;
	
	Если ФункцияУПД = "ДОП" Или ФункцияУПД = "СЧФДОП" Тогда
		НайтиСоздатьУПДДокументОПередаче_2019(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина,
			СпособОбработкиПервичногоДокумента, РезультатОтраженияВУчете.ОписаниеОшибки);
		ДокументыУчета.Добавить(ПервичныйДокумент);
	ИначеЕсли ФункцияУПД = "СвРК" Или ФункцияУПД = "СвИСРК" Тогда
		НайтиСоздатьУПД0Реализация_2019(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина, СпособОбработкиПервичногоДокумента,
			РезультатОтраженияВУчете.ОписаниеОшибки);
		ДокументыУчета.Добавить(ПервичныйДокумент);
	ИначеЕсли ФункцияУПД = "СвЗК" Или ФункцияУПД = "СвИСЗК" Тогда
		НайтиСоздатьУПД0Закупка_2019(ДанныеЭлектронногоДокумента, ПервичныйДокумент, Истина, СпособОбработкиПервичногоДокумента,
			РезультатОтраженияВУчете.ОписаниеОшибки);
		ДокументыУчета.Добавить(ПервичныйДокумент);
	КонецЕсли;
	
	// Заполним основание в СФ.
	ДокументыОснованияСчетаФактуры = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"ДокументыОснованияСчетаФактуры");
	Если Не ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		ДокументыОснованияСчетаФактуры = Новый Массив;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПервичныйДокумент) Тогда
		ДокументыОснованияСчетаФактуры.Добавить(ПервичныйДокумент);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента,
		"ДокументыОснованияСчетаФактуры", ДокументыОснованияСчетаФактуры);
	
	Если ФункцияУПД = "СЧФ" Или ФункцияУПД = "СЧФДОП" Тогда
		НайтиСоздатьУПДСчетФактуру_2019(ДанныеЭлектронногоДокумента, СчетФактура, СпособОбработкиСчетаФактуры,
			РезультатОтраженияВУчете.ОписаниеОшибки);
		ДокументыУчета.Добавить(СчетФактура);
	КонецЕсли;

	РезультатОтраженияВУчете.ДокументыУчета = ДокументыУчета;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУПД2019_ИнформацияПродавца.
Процедура ЗаполнитьДанныеУПД2019_ИнформацияПродавца(Знач Основание, Знач Настройки, Данные, Описание, Отказ) Экспорт
	
	ВсеВидыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	ТипДокумента = Настройки.ТипДокумента;
	
	СтруктураЭД = ОбщегоНазначения.СкопироватьРекурсивно(Настройки, Ложь);
	СчетФактура = Неопределено;
	ПередаточныеДокументы = Новый Массив;
	
	ТипДокументаОснования = ТипЗнч(Основание);
	Если ТипДокументаОснования = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		СчетФактура = Основание;
		ПередаточныеДокументы = ОснованияСчетаФактуры(Основание);
	Иначе
		СчетФактура = Документы.СчетФактураВыданный.СчетФактураДокумента(Основание);
		ПередаточныеДокументы.Добавить(Основание);
	КонецЕсли;

	Если ТипДокумента = ВсеВидыДокументов.УПД Тогда
		
		СтруктураЭД.Вставить("Функция", "СЧФДОП");
		
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_2019(СчетФактура, СтруктураЭД, Данные, Отказ);
		Иначе
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_2019(Основание, СтруктураЭД, Данные, Отказ);
			Если УПДБезНДС(Данные) Тогда
				СтруктураЭД.Функция = "ДОП";
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СчетФактура Тогда
		
		СтруктураЭД.Вставить("Функция", "СЧФ");
		ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_2019(Основание, СтруктураЭД, Данные, Отказ);

	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СведенияОРеализацииКомиссионером Тогда

		СтруктураЭД.Вставить("Функция", "СвРК");
		
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_2019(СчетФактура, СтруктураЭД, Данные, Отказ);
		Иначе
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_2019(Основание, СтруктураЭД, Данные, Отказ);
		КонецЕсли;
			
	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СведенияОЗакупкеКомиссионером Тогда

		СтруктураЭД.Вставить("Функция", "СвЗК");
		ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_2019(Основание, СтруктураЭД, Данные, Отказ);
			
	Иначе
		
		СтруктураЭД.Вставить("Функция", "ДОП");
		ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_2019(Основание, СтруктураЭД, Данные, Отказ);
		
	КонецЕсли;
	
	ФункцияУПД = СтруктураЭД.Функция;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "Функция", ФункцияУПД);
	
	Если ФункцияУПД = "СЧФДОП" Тогда
		
		Если Основание = СчетФактура Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Описание.Основания, ПередаточныеДокументы);
		Иначе
			Описание.Основания.Добавить(СчетФактура);
		КонецЕсли;
		
	КонецЕсли;	

КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУПД2019_ИнформацияПокупателя.
Процедура ЗаполнитьДанныеУПД2019_ИнформацияПокупателя(Знач Основания, Данные, Отказ) Экспорт
	
	Поступление = Документы.ПоступлениеТоваровУслуг.ПустаяСсылка();
	СчетФактура = Документы.СчетФактураПолученный.ПустаяСсылка();
	РезультатРассмотрения = Документы.РезультатыРассмотренияАктаПриемкиЕИС.ПустаяСсылка();
	
	Если НЕ ТипЗнч(Основания) = Тип("Массив") Тогда
		Основания = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Основания);
	КонецЕсли;
	
	Для каждого Основание Из Основания Цикл
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			Поступление = Основание;
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
			СчетФактура = Основание;
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.РезультатыРассмотренияАктаПриемкиЕИС")
			ИЛИ ТипЗнч(Основание) = Тип("ДокументСсылка.АктПриемкиВходящийЕИС") Тогда
			РезультатРассмотрения = Основание;
		КонецЕсли;
	КонецЦикла;
	
	ДатаПолученияТоваров = Дата(1, 1, 1);
	СодержаниеОперации   = "-";
	СоставительДокумента = "-";
	КодИтога = "1";
	ЭтоЭлектронноеАктирование = Ложь;
	
	Если ЗначениеЗаполнено(Поступление) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Дата КАК Дата,
		|	ПоступлениеТоваровУслуг.ВидДокумента КАК ВидДокумента,
		|	ПоступлениеТоваровУслуг.Организация.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
		|	ПоступлениеТоваровУслуг.Организация.ИНН КАК ОрганизацияИНН,
		|	ПоступлениеТоваровУслуг.Организация.КПП КАК ОрганизацияКПП,
		|	ПоступлениеТоваровУслуг.ЭтоГосЗакупка КАК ЭтоГосЗакупка,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаКодЗакупки КАК ГосЗакупкаКодЗакупки,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаНомерЛицевогоСчета КАК ГосЗакупкаНомерЛицевогоСчета,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаФинансовыйОрган КАК ГосЗакупкаФинансовыйОрган,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаНомерРеестровойЗаписи КАК ГосЗакупкаНомерРеестровойЗаписи,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаНомерБюджетногоОбязательства КАК ГосЗакупкаНомерБюджетногоОбязательства,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаКазначействоКод КАК ГосЗакупкаКазначействоКод,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаКазначействоНаименование КАК ГосЗакупкаКазначействоНаименование,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаОКТМОПокупателя КАК ГосЗакупкаОКТМОПокупателя,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаОКТМОМестаПоставки КАК ГосЗакупкаОКТМОМестаПоставки,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаПредельнаяДатаОплаты КАК ГосЗакупкаПредельнаяДатаОплаты,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаНомерДенежногоОбязательства КАК ГосЗакупкаНомерДенежногоОбязательства,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаОчередностьПлатежа КАК ГосЗакупкаОчередностьПлатежа,
		|	ПоступлениеТоваровУслуг.ГосЗакупкаВидПлатежа КАК ГосЗакупкаВидПлатежа,
		|	ПоступлениеТоваровУслуг.ДенежныеОбязательстваГосЗакупки.(
		|		НомерСтрокиИнформацииПродавца КАК НомерСтрокиИнформацииПродавца,
		|		КодОбъектаФАИП КАК КодОбъектаФАИП,
		|		ВидСредств КАК ВидСредств,
		|		КодБюджетнойКлассификации КАК КодБюджетнойКлассификации,
		|		КодЦели КАК КодЦели,
		|		СуммаАванса КАК СуммаАванса) КАК ДенежныеОбязательстваГосЗакупки,
		|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Поступление);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		ДатаПолученияТоваров = Выборка.Дата;
		
		СоставительДокумента = ?(ЗначениеЗаполнено(Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН/КПП %2/%3'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН, Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН %2'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН));
		
		Если Выборка.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная Тогда
			СодержаниеОперации = НСтр("ru = 'Товары принял без претензий'");
		ИначеЕсли Выборка.ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот Тогда
			СодержаниеОперации = НСтр("ru = 'Услуги получены, претензий нет.'");
		ИначеЕсли Выборка.ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав Тогда
			СодержаниеОперации = НСтр("ru = 'Имущественные права получены, претензий нет.'");
		КонецЕсли;
		
		ГосЗакупка = Новый Структура;
		ГосЗакупка.Вставить("КодЗакупки", Выборка.ГосЗакупкаКодЗакупки);
		ГосЗакупка.Вставить("НомерЛицевогоСчетаПокупателя", Выборка.ГосЗакупкаНомерЛицевогоСчета);
		ГосЗакупка.Вставить("НаименованиеФинансовогоОрганаПокупателя", Выборка.ГосЗакупкаФинансовыйОрган);
		ГосЗакупка.Вставить("НомерРеестровойЗаписиПокупателя", Выборка.ГосЗакупкаНомерРеестровойЗаписи);
		ГосЗакупка.Вставить("НомерБюджетногоОбязательстваПокупателя", Выборка.ГосЗакупкаНомерБюджетногоОбязательства);
		ГосЗакупка.Вставить("КазначействоПокупателяКод", Выборка.ГосЗакупкаКазначействоКод);
		ГосЗакупка.Вставить("КазначействоПокупателяНаименование", Выборка.ГосЗакупкаКазначействоНаименование);
		ГосЗакупка.Вставить("ОКТМОПокупателя", Выборка.ГосЗакупкаОКТМОПокупателя);
		ГосЗакупка.Вставить("ОКТМОМестаПоставки", Выборка.ГосЗакупкаОКТМОМестаПоставки);
		ГосЗакупка.Вставить("ПредельнаяДатаОплаты", Выборка.ГосЗакупкаПредельнаяДатаОплаты);
		ГосЗакупка.Вставить("НомерДенежногоОбязательства", Выборка.ГосЗакупкаНомерДенежногоОбязательства);
		ГосЗакупка.Вставить("ОчередностьПлатежа", Выборка.ГосЗакупкаОчередностьПлатежа);
		ГосЗакупка.Вставить("ВидПлатежа", Выборка.ГосЗакупкаВидПлатежа);
		Путь = "ЗакупкаДляГосударственныхНужд.";
		ГосЗакупкаЗаполнена = Ложь;
		
		Если Выборка.ЭтоГосЗакупка Тогда
			Для Каждого КлючЗначение Из ГосЗакупка Цикл		
				НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(Поступление, "ЭтоГосЗакупка");
				ИмяФормы = "Документ.ПоступлениеТоваровУслуг.ФормаОбъекта";
				ПараметрыФормы = Новый Структура("Ключ", Поступление);
				Если КлючЗначение.Ключ = "НаименованиеФинансовогоОрганаПокупателя" Тогда
					ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
						Поступление, "Объект.ГосЗакупкаФинансовыйОрган", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
				ИначеЕсли КлючЗначение.Ключ = "ОКТМОПокупателя" Тогда
					ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
						Поступление, "Объект.ГосЗакупкаОКТМОПокупателя", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
				ИначеЕсли КлючЗначение.Ключ = "НаименованиеФинансовогоОрганаПокупателя" Тогда
					ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
						Поступление, "Объект.ГосЗакупкаФинансовыйОрган", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
				Иначе
					ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
						Поступление, "Объект.ГосЗакупка" + СтрЗаменить(КлючЗначение.Ключ, "Покупателя", ""), НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
				КонецЕсли;
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, Путь + КлючЗначение.Ключ,
					КлючЗначение.Значение, ПараметрыОбработкиОшибок);
			КонецЦикла;
		КонецЕсли;
		
		ДенежныеОбязательства = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(Данные, Путь + "ДенежныеОбязательства");
		ВыборкаОбязательств = Выборка.ДенежныеОбязательстваГосЗакупки.Выбрать();
		Пока ВыборкаОбязательств.Следующий() Цикл
			СтрокаОбязательства = ДенежныеОбязательства.Добавить();
			СтрокаОбязательства.НомерСтрокиИнформацииПродавца = ВыборкаОбязательств.НомерСтрокиИнформацииПродавца;
			СтрокаОбязательства.КодОбъектаФАИП = ВыборкаОбязательств.КодОбъектаФАИП;
			СтрокаОбязательства.ВидСредств = КодИсточникаСредствГосЗакупок(ВыборкаОбязательств.ВидСредств);
			СтрокаОбязательства.КодБюджетнойКлассификации = ВыборкаОбязательств.КодБюджетнойКлассификации;
			СтрокаОбязательства.КодЦели = ВыборкаОбязательств.КодЦели;
			СтрокаОбязательства.СуммаАванса = ВыборкаОбязательств.СуммаАванса;
		КонецЦикла;
		Если ЗначениеЗаполнено(ДенежныеОбязательства) Тогда
			ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(Данные, ДенежныеОбязательства, Путь + "ДенежныеОбязательства");
		КонецЕсли;
		
		АктОРасхождениях = НайтиАктОРасхожденияхПоОснованию(Выборка.Ссылка);
		Если ЗначениеЗаполнено(АктОРасхождениях) Тогда
			РеквизитыАкта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(АктОРасхождениях, "Проведен,НомерЭД,ДатаЭД,ОбстоятельстваСоставления,ОбстоятельстваИспользования");
			Если РеквизитыАкта.Проведен Тогда
				КодИтога = "2";
				СодержаниеОперации = НСтр("ru = 'Товары (работы, услуги, права) приняты с расхождениями (претензией)'");
				Путь = "СведенияОПринятииТоваров.ДокументОРасхождениях.";
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, Путь + "Наименование", НСтр("ru = 'Акт о расхождениях'"));
				Если РеквизитыАкта.ОбстоятельстваИспользования = Перечисления.ОбстоятельстваИспользованияАктаОРасхождениях.ПриемкаСРасхождениями Тогда
					ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, Путь + "Вид", "2");
				ИначеЕсли РеквизитыАкта.ОбстоятельстваИспользования = Перечисления.ОбстоятельстваИспользованияАктаОРасхождениях.Расхождения Тогда
					ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, Путь + "Вид", "3");
				КонецЕсли;
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, Путь + "Номер", РеквизитыАкта.НомерЭД);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, Путь + "Дата", РеквизитыАкта.ДатаЭД);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(СчетФактура) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СчетФактураПолученный.Дата КАК Дата,
		|	СчетФактураПолученный.Организация.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
		|	СчетФактураПолученный.Организация.ИНН КАК ОрганизацияИНН,
		|	СчетФактураПолученный.Организация.КПП КАК ОрганизацияКПП
		|ИЗ
		|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
		|ГДЕ
		|	СчетФактураПолученный.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", СчетФактура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		ДатаПолученияТоваров = Выборка.Дата;
		
		СоставительДокумента = ?(ЗначениеЗаполнено(Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН/КПП %2/%3'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН, Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН %2'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН));
	ИначеЕсли ЗначениеЗаполнено(РезультатРассмотрения) Тогда
		
		ЭтоЭлектронноеАктирование = Истина;
		КлиентЭлАктЕИС.ПриЗаполненииДанныхУПД2019_ИнформацияПокупателя(РезультатРассмотрения, Данные, Отказ);
		
	КонецЕсли;
	
	Если ЭтоЭлектронноеАктирование Тогда
		Возврат;
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СоставительДокументаНаименование", СоставительДокумента);
	
	Если ЗначениеЗаполнено(ДатаПолученияТоваров) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			Данные, "СведенияОПринятииТоваров.ДатаПолученияТоваров", ДатаПолученияТоваров);
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СведенияОПринятииТоваров.СодержаниеОперации", СодержаниеОперации);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СведенияОПринятииТоваров.КодИтога", КодИтога);
	
КонецПроцедуры

#КонецОбласти

#Область УПД

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУПД_ИнформацияПокупателя.
Процедура ЗаполнитьДанныеУПД_ИнформацияПокупателя(Знач Основания, Данные, Отказ) Экспорт
	
	Поступление = Документы.ПоступлениеТоваровУслуг.ПустаяСсылка();
	СчетФактура = Документы.СчетФактураПолученный.ПустаяСсылка();
	Для каждого Основание Из Основания Цикл
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			Поступление = Основание;
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
			СчетФактура = Основание;
		КонецЕсли;
	КонецЦикла;
	
	ДатаПолученияТоваров = ТекущаяДатаСеанса();
	СодержаниеОперации   = "-";
	СоставительДокумента = "-";
	
	Если ЗначениеЗаполнено(Поступление) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Дата КАК Дата,
		|	ПоступлениеТоваровУслуг.ВидДокумента КАК ВидДокумента,
		|	ПоступлениеТоваровУслуг.Организация.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
		|	ПоступлениеТоваровУслуг.Организация.ИНН КАК ОрганизацияИНН,
		|	ПоступлениеТоваровУслуг.Организация.КПП КАК ОрганизацияКПП,
		|	ПоступлениеТоваровУслуг.ДенежныеОбязательстваГосЗакупки.(
		|		НомерСтрокиИнформацииПродавца КАК НомерСтрокиИнформацииПродавца,
		|		КодОбъектаФАИП КАК КодОбъектаФАИП,
		|		ВидСредств КАК ВидСредств,
		|		КодБюджетнойКлассификации КАК КодБюджетнойКлассификации,
		|		КодЦели КАК КодЦели,
		|		СуммаАванса КАК СуммаАванса) КАК ДенежныеОбязательстваГосЗакупки,
		|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Поступление);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		ДатаПолученияТоваров = Выборка.Дата;
		
		СоставительДокумента = ?(ЗначениеЗаполнено(Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН/КПП %2/%3'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН, Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН %2'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН));
		
		Если Выборка.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная Тогда
			СодержаниеОперации = НСтр("ru = 'Товары принял без претензий'");
		ИначеЕсли Выборка.ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот Тогда
			СодержаниеОперации = НСтр("ru = 'Услуги получены, претензий нет.'");
		ИначеЕсли Выборка.ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав Тогда
			СодержаниеОперации = НСтр("ru = 'Имущественные права получены, претензий нет.'");
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(СчетФактура) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СчетФактураПолученный.Дата КАК Дата,
		|	СчетФактураПолученный.Организация.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
		|	СчетФактураПолученный.Организация.ИНН КАК ОрганизацияИНН,
		|	СчетФактураПолученный.Организация.КПП КАК ОрганизацияКПП
		|ИЗ
		|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
		|ГДЕ
		|	СчетФактураПолученный.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", СчетФактура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		ДатаПолученияТоваров = Выборка.Дата;
		
		СоставительДокумента = ?(ЗначениеЗаполнено(Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН/КПП %2/%3'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН, Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН %2'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН));
		
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СоставительДокументаНаименование", СоставительДокумента);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			Данные, "ДатаПолученияТоваров", ДатаПолученияТоваров);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СодержаниеОперации", СодержаниеОперации);
	
КонецПроцедуры

#КонецОбласти

#Область УКД

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУКД_ИнформацияПродавца.
Процедура ЗаполнитьДанныеУКД_ИнформацияПродавца(Основание, Настройки, Данные, Описание, Отказ) Экспорт
	
	ВсеВидыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	ВидДокумента = Настройки.ТипДокумента;
	
	СтруктураЭД = ОбщегоНазначения.СкопироватьРекурсивно(Настройки, Ложь);
	СчетФактура = Неопределено;
	КорректировочныеДокументы = Новый Массив;
	
	ТипДокумента = ТипЗнч(Основание);
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		СчетФактура = Основание;
		ПередаточныеДокументы = ОснованияСчетаФактуры(Основание);
	Иначе
		СчетФактура = Документы.СчетФактураВыданный.СчетФактураДокумента(Основание);
		КорректировочныеДокументы.Добавить(Основание);
	КонецЕсли;

	Если ВидДокумента = ВсеВидыДокументов.УКД Тогда
		
		СтруктураЭД.Вставить("Функция", "КСЧФДИС");
		
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ЗаполнитьДанныеДляУКДИнформацияПродавцаФНС(СчетФактура, СтруктураЭД, Данные, Отказ);
		Иначе
			ЗаполнитьДанныеДляДИСИнформацияПродавцаФНС(Основание, СтруктураЭД, Данные, Отказ);
			Если УПДБезНДС(Данные) Тогда
				СтруктураЭД.Функция = "ДИС";
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ВидДокумента = ВсеВидыДокументов.КорректировочныйСчетФактура Тогда
		
		СтруктураЭД.Вставить("Функция", "КСЧФ");
		ЗаполнитьДанныеДляКСЧФИнформацияПродавцаФНС(Основание, СтруктураЭД, Данные, Отказ);
		
	Иначе
		
		СтруктураЭД.Вставить("Функция", "ДИС");
		ЗаполнитьДанныеДляДИСИнформацияПродавцаФНС(Основание, СтруктураЭД, Данные, Отказ);
		
	КонецЕсли;
	
	ФункцияУКД = СтруктураЭД.Функция;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "Функция", ФункцияУКД);
	
	Если ФункцияУКД = "КСЧФДИС" Тогда
		
		Если Основание = СчетФактура Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Описание.Основания, ПередаточныеДокументы);
		Иначе
			Описание.Основания.Добавить(СчетФактура);
		КонецЕсли;
		
	ИначеЕсли ФункцияУКД = "КСЧФ" Тогда
		
	ИначеЕсли ФункцияУКД = "ДИС" Тогда
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУКД_ИнформацияПокупателя.
Процедура ЗаполнитьДанныеУКД_ИнформацияПокупателя(Знач Основания, Данные, Отказ) Экспорт
	
	СоставительДокумента = "-";
	
	Если ЗначениеЗаполнено(Основания) Тогда 
		СведенияОПокупателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(Основания[0].Организация, СведенияОПокупателе);
		СоставительДокумента = СведенияОПокупателе.ПолноеНаименование;
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные,
		"СоставительДокументаНаименование", СоставительДокумента);


	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "ДатаСогласования", ТекущаяДатаСеанса());
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "СодержаниеОперации",
		НСтр("ru = 'С изменением стоимости согласен'"));

КонецПроцедуры

#КонецОбласти

#Область УКД_2020

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУКД2020_ИнформацияПродавца.
Процедура ЗаполнитьДанныеУКД2020_ИнформацияПродавца(Основание, Настройки, Данные, Описание, Отказ) Экспорт
	
	ВсеВидыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	ВидДокумента = Настройки.ТипДокумента;
	
	СтруктураЭД = ОбщегоНазначения.СкопироватьРекурсивно(Настройки, Ложь);
	СчетФактура = Неопределено;
	КорректировочныеДокументы = Новый Массив;
	
	ТипДокумента = ТипЗнч(Основание);
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		СчетФактура = Основание;
		ПередаточныеДокументы = ОснованияСчетаФактуры(Основание);
	Иначе
		СчетФактура = Документы.СчетФактураВыданный.СчетФактураДокумента(Основание);
		КорректировочныеДокументы.Добавить(Основание);
	КонецЕсли;

	Если ВидДокумента = ВсеВидыДокументов.УКД Тогда
		
		СтруктураЭД.Вставить("Функция", "КСЧФДИС");
		
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ЗаполнитьДанныеУКДИнформацияПродавцаФНС_2020(СчетФактура, СтруктураЭД, Данные, Отказ);
		Иначе
			ЗаполнитьДанныеУКДИнформацияПродавцаФНС_2020(Основание, СтруктураЭД, Данные, Отказ);
			Если УПДБезНДС(Данные) Тогда
				СтруктураЭД.Функция = "ДИС";
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ВидДокумента = ВсеВидыДокументов.КорректировкаСведенийОРеализацииКомиссионером Тогда
		
		СтруктураЭД.Вставить("Функция", "СвИСРК");
		ЗаполнитьДанныеУКДИнформацияПродавцаФНС_2020(Основание, СтруктураЭД, Данные, Отказ);

	ИначеЕсли ВидДокумента = ВсеВидыДокументов.КорректировкаСведенийОЗакупкеКомиссионером Тогда
		
		СтруктураЭД.Вставить("Функция", "СвИСЗК");
		ЗаполнитьДанныеУКДИнформацияПродавцаФНС_2020(Основание, СтруктураЭД, Данные, Отказ);

	ИначеЕсли ВидДокумента = ВсеВидыДокументов.КорректировочныйСчетФактура Тогда
		
		СтруктураЭД.Вставить("Функция", "КСЧФ");
		ЗаполнитьДанныеУКДИнформацияПродавцаФНС_2020(Основание, СтруктураЭД, Данные, Отказ);

	Иначе
		
		СтруктураЭД.Вставить("Функция", "ДИС");
		ЗаполнитьДанныеУКДИнформацияПродавцаФНС_2020(Основание, СтруктураЭД, Данные, Отказ);
		
	КонецЕсли;
	
	ФункцияУКД = СтруктураЭД.Функция;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "Функция", ФункцияУКД);
	
	Если ФункцияУКД <> "ДИС" И ФункцияУКД <> "СвИСРК" И ФункцияУКД <> "СвИСЗК" И Не ЗначениеЗаполнено(СчетФактура) Тогда
		ТекстСообщения = НСтр("ru = 'Не выписан счет-фактура'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Основание);
		Отказ = Истина;
	КонецЕсли;
	
	Если ФункцияУКД = "КСЧФДИС" Тогда
		
		Если Основание = СчетФактура Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Описание.Основания, ПередаточныеДокументы);
		Иначе
			Описание.Основания.Добавить(СчетФактура);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеУКД2020_ИнформацияПокупателя.
Процедура ЗаполнитьДанныеУКД2020_ИнформацияПокупателя(Знач Основания, Данные, Отказ) Экспорт
	
	СоставительДокумента = "-";
	
	Если ЗначениеЗаполнено(Основания) Тогда 
		СведенияОПокупателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(Основания[0].Организация, СведенияОПокупателе);
		СоставительДокумента = СведенияОПокупателе.ПолноеНаименование;
	КонецЕсли;

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные,
		"СоставительДокументаНаименование", СоставительДокумента);

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "ДатаСогласования", ТекущаяДатаСеанса());
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "СодержаниеОперации",
		НСтр("ru = 'С изменением стоимости согласен'"));
		
	РезультатРассмотрения = Документы.РезультатыРассмотренияАктаПриемкиЕИС.ПустаяСсылка();
	
	Если НЕ ТипЗнч(Основания) = Тип("Массив") Тогда
		Основания = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Основания);
	КонецЕсли;
	
	ЭтоЭлектронноеАктирование = Ложь;
	Для каждого Основание Из Основания Цикл
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.РезультатыРассмотренияАктаПриемкиЕИС")
			ИЛИ ТипЗнч(Основание) = Тип("ДокументСсылка.АктПриемкиВходящийЕИС") Тогда
			РезультатРассмотрения = Основание;
			ЭтоЭлектронноеАктирование = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЭтоЭлектронноеАктирование Тогда
		КлиентЭлАктЕИС.ПриЗаполненииДанныхУКД2020_ИнформацияПокупателя(
			РезультатРассмотрения, Данные, Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПередачаТоваров

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеПередачаТоваров_ИнформацияПродавца.
Процедура ЗаполнитьДанныеПередачаТоваров_ИнформацияПродавца(Знач Основание, Знач Настройки, Данные, Описание, Отказ) Экспорт
	
	СтруктураЭД = ОбщегоНазначения.СкопироватьРекурсивно(Настройки, Ложь);
	
	ЗаполнитьДанныеПередачаТоваровПродавец(Основание, СтруктураЭД, Данные, Отказ);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеПередачаТоваров_ИнформацияПокупателя.
Процедура ЗаполнитьДанныеПередачаТоваров_ИнформацияПокупателя(Знач Основания, Данные, Отказ) Экспорт
	
	ДатаПолученияТоваров = Дата(1, 1, 1);
	СоставительДокумента = "-";
	
	Поступление = Документы.ПоступлениеТоваровУслуг.ПустаяСсылка();
	Для каждого Основание Из Основания Цикл
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			Поступление = Основание;
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Дата КАК Дата,
	|	ПоступлениеТоваровУслуг.Организация.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
	|	ПоступлениеТоваровУслуг.Организация.ИНН КАК ОрганизацияИНН,
	|	ПоступлениеТоваровУслуг.Организация.КПП КАК ОрганизацияКПП,
	|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	ПоступлениеТоваровУслуг.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Поступление);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	ДатаПолученияТоваров = Выборка.Дата;

	СоставительДокумента = ?(ЗначениеЗаполнено(Выборка.ОрганизацияКПП), СтрШаблон(НСтр("ru = '%1, ИНН/КПП %2/%3'"),
		Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН, Выборка.ОрганизацияКПП), СтрШаблон(НСтр(
		"ru = '%1, ИНН %2'"), Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН));

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		Данные, "СоставительДокументаНаименование", СоставительДокумента);

	Если ЗначениеЗаполнено(ДатаПолученияТоваров) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			Данные, "ДатаПолученияГруза", ДатаПолученияТоваров);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПередачаУслуг

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеПередачаУслуг_ИнформацияПродавца.
Процедура ЗаполнитьДанныеПередачаУслуг_ИнформацияПродавца(Знач Основание, Знач Настройки, Данные, Описание, Отказ) Экспорт
	
	СтруктураЭД = ОбщегоНазначения.СкопироватьРекурсивно(Настройки, Ложь);
	
	ЗаполнитьДанныеПередачаРаботИсполнитель(Основание, СтруктураЭД, Данные, Отказ);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеПередачаУслуг_ИнформацияПокупателя.
