// Заполняет в таблице товаров сведения по маркировке.
//
// Параметры:
//  СтрокаТовара			- СтрокаТаблицыЗначений - строка выгруженной таблицы документа. Должна обязательно содержать колонки:
//                             * НомерСтрокиИсходногоДокумента - Число - номер строки таблицы товаров документа, для которого заполняются данные.
//                             * СведенияОМаркировке - Произвольный - в данную колонку будет записана структура сведений по маркировке.
//  ТаблицаКодовДокумента	- ТаблицаЗначений - содержит сведения об упаковках. Должна обязательно содержать колонки:
//                             * ИдентификаторСтроки - Строка - идентификатор строки.
//                             * НомерУпаковки - Строка - код маркировки.
//  Документ				- ДокументСсылка - ссылка на документ, для которого заполняются данные.
//
Процедура ЗаполнитьРеквизитыМаркировкиВСтрокеТоваровУКД_2020(СтрокаТовара, ТаблицаКодовДокумента, Документ, ИмяСведенийОМаркировке)

	ПутьКДаннымДляОшибки = СтрШаблон("Объект.Товары[%1].МаркируемыеУпаковки", СтрокаТовара.НомерСтрокиИсходногоДокумента - 1);
	
	ТаблицаКодов = Новый ТаблицаЗначений;
	ТаблицаКодов.Колонки.Добавить("Код");
	
	СведенияОМаркировке = Новый Структура;
	СведенияОМаркировке.Вставить("ИндивидуальныеУпаковки", ТаблицаКодов);
	СтрокаТовара[ИмяСведенийОМаркировке] = СведенияОМаркировке;
	
	ПараметрыПоиска = Новый Структура("ИдентификаторСтроки", СтрокаТовара.ИдентификаторСтроки);
	
	СтрокиУпаковок = ТаблицаКодовДокумента.НайтиСтроки(ПараметрыПоиска);
	Для Каждого СтрокаУпаковки Из СтрокиУпаковок Цикл
		НоваяСтрока = ТаблицаКодов.Добавить();
		НоваяСтрока.Код = СтрокаУпаковки.НомерУпаковки;
	КонецЦикла;
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаКодов,
		"КодУпаковки", Документ, ПутьКДаннымДляОшибки);

КонецПроцедуры

// Заполняет коды маркировки в документе из дерева электронного документа.
//
// Параметры:
//  ДокументОбъект				 - ДокументОбъект - объект заполняемого документа.
//  СтрокаТоваров				 - СтрокаТабличнойЧасти - строка таблицы товаров документа.
//  СтрокаТоваровДерева			 - СтрокаДереваЗначений - строка товаров дерева электронного документа.
//  ЭтоИндивидуальныеУпаковки	 - Булево - Истина, если нужно заполнить индивидуальные упаковки,
//                                          Ложь, если нужно заполнить транспортные упаковки.
//
Процедура ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокументаУКД_2020(ДокументОбъект, СтрокаТоваров, СтрокаТоваровДерева,
		ИмяТаблицыДокумента, ИмяТалицыДерева)
	
	ТаблицаДокумента = ДокументОбъект[ИмяТаблицыДокумента];
	
	ИменаТаблицыУпаковокДерева = Новый Массив;
	ИменаТаблицыУпаковокДерева.Добавить("ИндивидуальныеУпаковки");
	ИменаТаблицыУпаковокДерева.Добавить("ТранспортныеУпаковки");
	ИменаТаблицыУпаковокДерева.Добавить("КонтрольныеИдентификационныеЗнаки");
	
	Для Каждого ИмяТаблицыУпаковокДерева Из ИменаТаблицыУпаковокДерева Цикл
		ЗначениеПоиска = СтрШаблон("СведенияОТоварах.НомерСтроки.%1.%2", ИмяТалицыДерева, ИмяТаблицыУпаковокДерева);
		КодыУпаковок = СтрокаТоваровДерева.Строки.Найти(ЗначениеПоиска, "ПолныйПуть", Истина);
		Если КодыУпаковок <> Неопределено И ЗначениеЗаполнено(КодыУпаковок.Значение) Тогда
			Для Каждого СтрокаКодаУпаковки Из КодыУпаковок.Строки Цикл
				СтрокаНовойУпаковки = ТаблицаДокумента.Добавить();
				СтрокаНовойУпаковки.ИдентификаторСтроки = СтрокаТоваров.ИдентификаторСтроки;
				
				ПолныйПуть = СтрШаблон("СведенияОТоварах.НомерСтроки.%1.%2.НомерСтроки.Код", ИмяТалицыДерева, ИмяТаблицыУпаковокДерева); 
				СтрокаНовойУпаковки.НомерУпаковки = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаКодаУпаковки, ПолныйПуть);
					
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


#КонецОбласти

#Область УПД_5_02

// Заполняет данные электронного документа.
//
// Параметры:
//  СсылкаНаОбъект - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - основание для электронного документа.
//  СтруктураЭД - Структура - настройки заполнения данных:
//   * Функция - Строка
//   * ТипДокумента - Произвольный
//   * Отправитель - ОпределяемыйТип.Организация
//   * Получатель - ОпределяемыйТип.КонтрагентБЭД
//   * Договор - ОпределяемыйТип.ДоговорСКонтрагентомЭДО
//   * ВариантыЗаполненияПолей - Структура:
//    ** ТоварКод - Строка
//  ДеревоДанных - ДеревоЗначений - дерево электронного документа.
// 	Отказ - Булево - признак отказа от дальнейшего заполнения.
//
Процедура ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_5_02(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ)
	
	СтруктураДанных = Документы.СчетФактураВыданный.ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();
	ОбщийПуть = "СведенияОСчетеФактуре.";
	
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс Тогда
		СтруктураЭД.Функция = "СЧФ";
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СсылкаСчетаФактуры", СсылкаНаОбъект);
	
	Если ВыборкаШапки.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		// Обработка ошибки с открытием формы по навигационной ссылке.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерИсправления");
		ИмяФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсправления", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "Исправление.НомерИсправления", ВыборкаШапки.НомерИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Дата");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "Исправление.ДатаИсправления", ВыборкаШапки.ДатаИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "НомерДокумента", ВыборкаШапки.НомерИсходногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ДатаИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "ДатаДокумента", ВыборкаШапки.ДатаИсходногоДокумента, ПараметрыОбработкиОшибок);
	Иначе
		// Обработка ошибки с открытием формы по навигационной ссылке.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерЭД");
		ИмяФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект,
			"Объект.НомерЭД", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "НомерДокумента", ВыборкаШапки.Номер, ПараметрыОбработкиОшибок);
			
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.Дата", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "ДатаДокумента", ВыборкаШапки.Дата, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.ИдентификаторГосКонтракта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ИдентификаторГосКонтракта");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", ВыборкаШапки.ИдентификаторГосКонтракта,
			ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	ПараметрыОбработкиОшибокДатыОтгрузки = Неопределено;
	ПараметрыОбработкиОшибокДатыНачалаПоставки = Неопределено;
	ПараметрыОбработкиОшибокДатыОкончанияПоставки = Неопределено;
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный") 
		И ЗначениеЗаполнено(ВыборкаШапки.СчетФактураОснование) Тогда
		СсылкаНаКлюч = ВыборкаШапки.СчетФактураОснование;
	Иначе
		СсылкаНаКлюч = СсылкаНаОбъект;
	КонецЕсли;

	ТекстОшибки = НСтр("ru = 'Необходимо указать дату отгрузки или заполнить период поставки'");

	ПараметрыОбработкиОшибокДатыОтгрузки = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		СсылкаНаКлюч, "Объект.ДатаОтгрузки", , , , ТекстОшибки);
			
	ПараметрыОбработкиОшибокДатыОкончанияПоставки = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		СсылкаНаКлюч, "Объект.ДатаОкончанияПоставки", , , , ТекстОшибки);

	ДатаНачалаПоставки = ВыборкаШапки.ДатаНачалаПоставки;
	Если ЗначениеЗаполнено(ДатаНачалаПоставки) И ЗначениеЗаполнено(ВыборкаШапки.ДатаОкончанияПоставки)
		И ДатаНачалаПоставки > ВыборкаШапки.ДатаОкончанияПоставки Тогда
			
		ТекстОшибки = НСтр("ru = 'Дата начала поставки не может быть больше даты окончания'");
		ДатаНачалаПоставки = Неопределено;
	КонецЕсли;
	
	ПараметрыОбработкиОшибокДатыНачалаПоставки = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		СсылкаНаКлюч, "Объект.ДатаНачалаПоставки", , , , ТекстОшибки);
	
	Путь = "СведенияОПередаче.Операция.";
	Если СтруктураЭД.Функция <> "СЧФ"
		И ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная
		Или ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактура Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "ДатаОтгрузки",
			ВыборкаШапки.ДатаОтгрузки, ПараметрыОбработкиОшибокДатыОтгрузки);
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "ДатаНачалаПоставки",
		ДатаНачалаПоставки, ПараметрыОбработкиОшибокДатыНачалаПоставки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "ДатаОкончанияПоставки",
		ВыборкаШапки.ДатаОкончанияПоставки, ПараметрыОбработкиОшибокДатыОкончанияПоставки);
	
	ОбстоятельстваФормированияСФ = "";
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс Тогда
		ВидСчетаФактуры = "Авансовый";
		ОбстоятельстваФормированияСФ = "2";
	Иначе
		ВидСчетаФактуры = "Реализация";
		ОбстоятельстваФормированияСФ = "1";
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		ОбщийПуть + "ДополнительныеСведенияОбУчастниках.ОбстоятельстваФормированияСФ", ОбстоятельстваФормированияСФ);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры", ВидСчетаФактуры);
	
	МассивОснований = Новый Массив;
	Если СтруктураДанных.Свойство("ВыборкаОснований") Тогда
		
		ВыборкаОснований = СтруктураДанных.ВыборкаОснований;
		Пока ВыборкаОснований.Следующий() Цикл
			МассивОснований.Добавить(ВыборкаОснований.ДокументОснование);
		КонецЦикла;
		
		СтруктураДанныхОснований = Документы[МассивОснований[0].Метаданные().Имя].ПолучитьДанныеДляЭД(МассивОснований);
		Если СтруктураДанныхОснований.ВыборкаШапки.Следующий() Тогда
			ЗаполнитьДеревоДанныхУПД_5_02(СтруктураДанныхОснований, СтруктураЭД, ДеревоДанных, Отказ);
		КонецЕсли;
		
	Иначе
		ЗаполнитьДеревоДанныхУПД_5_02(СтруктураДанных, СтруктураЭД, ДеревоДанных, Отказ);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.СчетФактураОснование) Тогда
		МассивОснований.Добавить(ВыборкаШапки.СчетФактураОснование);
	КонецЕсли;
	
	ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		СсылкаНаОбъект, "Объект.СчетФактураОснование");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры",
		МассивОснований, ПараметрыОбработкиОшибок);
	
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.СчетФактура Тогда
		ЗаполнитьДокументыПодтвержденияОтгрузки_5_02(ДеревоДанных, СтруктураДанных);
	КонецЕсли;
	
	Если СтруктураДанных.Свойство("ВыборкаПРД") Тогда
		
		ПлатежныеДокументы = Новый ТаблицаЗначений;
		ПлатежныеДокументы.Колонки.Добавить("НомерСтроки");
		ПлатежныеДокументы.Колонки.Добавить("Номер");
		ПлатежныеДокументы.Колонки.Добавить("Дата");
		ПлатежныеДокументы.Колонки.Добавить("Сумма");
		
		ВыборкаПРД = СтруктураДанных.ВыборкаПРД;
		Пока ВыборкаПРД.Следующий() Цикл
			НоваяСтрока = ПлатежныеДокументы.Добавить();
			НоваяСтрока.НомерСтроки = ВыборкаПРД.НомерСтроки;
			НоваяСтрока.Номер = ВыборкаПРД.НомерПлатежноРасчетногоДокумента;
			НоваяСтрока.Дата = ВыборкаПРД.ДатаПлатежноРасчетногоДокумента;
			НоваяСтрока.Сумма = ВыборкаПРД.Сумма;
		КонецЦикла;
		
		// Дополним таблицу платежных документов параметрами обработки ошибок.
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ПлатежныеДокументы,
			"Номер", СсылкаНаОбъект, "Объект.ПлатежноРасчетныеДокументы.НомерПлатежноРасчетногоДокумента",, "НомерСтроки");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ПлатежныеДокументы,
			"Дата", СсылкаНаОбъект, "Объект.ПлатежноРасчетныеДокументы.ДатаПлатежноРасчетногоДокумента",, "НомерСтроки");
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ПлатежныеДокументы, ОбщийПуть + "СведенияОПлатежноРасчетныхДокументах");
		
	КонецЕсли;
	
	Если СтруктураДанных.Свойство("ВыборкаАвансовыхСчетовФактур") Тогда
		
		АвансовыеСчетаФактуры = Новый ТаблицаЗначений();
		АвансовыеСчетаФактуры.Колонки.Добавить("НомерСтроки");
		АвансовыеСчетаФактуры.Колонки.Добавить("НомерДокумента");
		АвансовыеСчетаФактуры.Колонки.Добавить("ДатаДокумента");
		АвансовыеСчетаФактуры.Колонки.Добавить("НомерИсправительногоДокумента");
		АвансовыеСчетаФактуры.Колонки.Добавить("ДатаИсправительногоДокумента");
		
		ВыборкаАвансовыхСчетовФактур = СтруктураДанных.ВыборкаАвансовыхСчетовФактур;
		Пока ВыборкаАвансовыхСчетовФактур.Следующий() Цикл
			НоваяСтрока = АвансовыеСчетаФактуры.Добавить();
			НоваяСтрока.НомерСтроки = ВыборкаАвансовыхСчетовФактур.НомерСтроки;
			НоваяСтрока.НомерДокумента = ВыборкаАвансовыхСчетовФактур.НомерАвансовойСчетФактуры;
			НоваяСтрока.ДатаДокумента = ВыборкаАвансовыхСчетовФактур.ДатаАвансовойСчетФактуры;
			НоваяСтрока.НомерИсправительногоДокумента = ВыборкаАвансовыхСчетовФактур.НомерИсправительногоДокумента;
			НоваяСтрока.ДатаИсправительногоДокумента = ВыборкаАвансовыхСчетовФактур.ДатаИсправительногоДокумента;
		КонецЦикла;
		
		// Дополним таблицу авансовых счетов-фактур параметрами обработки ошибок.
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(АвансовыеСчетаФактуры,
			"Номер", СсылкаНаОбъект, "Объект.СведенияОВыданныхСчетахФактурахНаАванс.НомерАвансовойСчетФактуры",,
			"НомерСтроки");
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(АвансовыеСчетаФактуры,
			"Дата", СсылкаНаОбъект, "Объект.СведенияОВыданныхСчетахФактурахНаАванс.ДатаАвансовойСчетФактуры",,
			"НомерСтроки");
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, АвансовыеСчетаФактуры, 
			ОбщийПуть + "ДополнительныеСведенияОбУчастниках.АвансовыеСчетаФактуры");
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет данные электронного документа.
//
// Параметры:
//  СсылкаНаОбъект - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - основание для электронного документа.
//  СтруктураЭД - Структура - настройки заполнения данных:
//   * Функция - Строка
//   * ТипДокумента - Произвольный
//   * Отправитель - ОпределяемыйТип.Организация
//   * Получатель - ОпределяемыйТип.КонтрагентБЭД
//   * Договор - ОпределяемыйТип.ДоговорСКонтрагентомЭДО
//   * ВариантыЗаполненияПолей - Структура:
//    ** ТоварКод - Строка
//  ДеревоДанных - ДеревоЗначений - дерево электронного документа.
// 	Отказ - Булево - признак отказа от дальнейшего заполнения.
//
Процедура ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_5_02(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ)
	
	СтруктураДанных = Неопределено;
	ЭтоРеализацияТоваровУслуг = ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровУслуг");
	Если ЭтоРеализацияТоваровУслуг Тогда
		СтруктураДанных = Документы.РеализацияТоваровУслуг.ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	Иначе
		СтруктураДанных = Документы.ПоступлениеТоваровУслуг.ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	КонецЕсли;
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	ВыборкаШапки.Следующий();
	ОбщийПуть = "СведенияОСчетеФактуре.";
	
	Если ВыборкаШапки.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		// Обработка ошибки с открытием формы по навигационной ссылке.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерИсправления");
		ИмяФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсправления", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "Исправление.НомерИсправления", ВыборкаШапки.НомерИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Дата");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "Исправление.ДатаИсправления", ВыборкаШапки.ДатаИсправления, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "НомерДокумента", ВыборкаШапки.НомерИсходногоДокумента, ПараметрыОбработкиОшибок);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ДатаИсходногоДокумента");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "ДатаДокумента", ВыборкаШапки.ДатаИсходногоДокумента, ПараметрыОбработкиОшибок);
	Иначе
		// Обработка ошибки с открытием формы по навигационной ссылке.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерЭД");
		ИмяФормы = "Документ.РеализацияТоваровУслуг.ФормаОбъекта";
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект,
			"Объект.НомерЭД", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "НомерДокумента", ВыборкаШапки.Номер, ПараметрыОбработкиОшибок);
			
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.Дата", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "ДатаДокумента", ВыборкаШапки.Дата, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаШапки.ИдентификаторГосКонтракта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ИдентификаторГосКонтракта");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ОбщийПуть + "ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", ВыборкаШапки.ИдентификаторГосКонтракта,
			ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	ПараметрыОбработкиОшибокДатыОтгрузки = Неопределено;
	ПараметрыОбработкиОшибокДатыНачалаПоставки = Неопределено;
	ПараметрыОбработкиОшибокДатыОкончанияПоставки = Неопределено;
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный") 
		И ЗначениеЗаполнено(ВыборкаШапки.СчетФактураОснование) Тогда
		СсылкаНаКлюч = ВыборкаШапки.СчетФактураОснование;
	Иначе
		СсылкаНаКлюч = СсылкаНаОбъект;
	КонецЕсли;

	ТекстОшибки = НСтр("ru = 'Необходимо указать дату отгрузки или заполнить период поставки'");

	ПараметрыОбработкиОшибокДатыОтгрузки = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		СсылкаНаКлюч, "Объект.ДатаОтгрузки", , , , ТекстОшибки);
			
	ПараметрыОбработкиОшибокДатыОкончанияПоставки = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		СсылкаНаКлюч, "Объект.ДатаОкончанияПоставки", , , , ТекстОшибки);

	Если ЭтоРеализацияТоваровУслуг Тогда
		ДатаНачалаПоставки = ВыборкаШапки.ДатаНачалаПоставки;
		Если ЗначениеЗаполнено(ДатаНачалаПоставки) И ЗначениеЗаполнено(ВыборкаШапки.ДатаОкончанияПоставки)
			И ДатаНачалаПоставки > ВыборкаШапки.ДатаОкончанияПоставки Тогда
				
			ТекстОшибки = НСтр("ru = 'Дата начала поставки не может быть больше даты окончания'");
			ДатаНачалаПоставки = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыОбработкиОшибокДатыНачалаПоставки = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
		СсылкаНаКлюч, "Объект.ДатаНачалаПоставки", , , , ТекстОшибки);
	
	Путь = "СведенияОПередаче.Операция.";
	Если СтруктураЭД.Функция <> "СЧФ"
		И ЭтоРеализацияТоваровУслуг Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "ДатаОтгрузки",
			ВыборкаШапки.ДатаОтгрузки, ПараметрыОбработкиОшибокДатыОтгрузки);
	КонецЕсли;
	Если ЭтоРеализацияТоваровУслуг Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "ДатаНачалаПоставки",
			ДатаНачалаПоставки, ПараметрыОбработкиОшибокДатыНачалаПоставки);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "ДатаОкончанияПоставки",
			ВыборкаШапки.ДатаОкончанияПоставки, ПараметрыОбработкиОшибокДатыОкончанияПоставки);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки",
		ВыборкаШапки.ДокументОснование);
	
	Если ЭтоРеализацияТоваровУслуг Тогда
		ЗаполнитьДеревоДанныхУПД_5_02(СтруктураДанных, СтруктураЭД, ДеревоДанных, Отказ);
	Иначе
		ЗаполнитьДеревоДанныхУПДЗакупка_5_02(СсылкаНаОбъект, СтруктураДанных, СтруктураЭД, ДеревоДанных, Отказ);
	КонецЕсли;
	
	ЗаполнитьДокументыПодтвержденияОтгрузки_5_02(ДеревоДанных, СтруктураДанных);
	
КонецПроцедуры

// Заполняет дерево электронного документа.
//
// Параметры:
//  СсылкаНаОбъект - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - основание для электронного документа.
//  СтруктураДанных - Структура - возвращается методом ПолучитьДанныеДляЭД учетного документа.
//  СтруктураЭД - Структура - настройки заполнения данных:
//   * Функция - Строка
//   * ТипДокумента - Произвольный
//   * Отправитель - ОпределяемыйТип.Организация
//   * Получатель - ОпределяемыйТип.КонтрагентБЭД
//   * Договор - ОпределяемыйТип.ДоговорСКонтрагентомЭДО
//   * ВариантыЗаполненияПолей - Структура:
//    ** ТоварКод - Строка
//  ДеревоДанных - ДеревоЗначений - дерево электронного документа
//  Отказ - Булево - Истина, если в процессе формирования ЭД были найдены критические ошибки.
//
Процедура ЗаполнитьДеревоДанныхУПДЗакупка_5_02(СсылкаНаОбъект, СтруктураДанных, СтруктураЭД, ДеревоДанных, Отказ = Ложь)
		
	Комитент = СтруктураЭД.Получатель;
	ДоговорСКомитентом = СтруктураЭД.Договор;
	
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	
	СведенияОПродавце = Неопределено; 
	Если ЗначениеЗаполнено(ВыборкаШапки.Контрагент) Тогда
		СведенияОПродавце = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Контрагент, СведенияОПродавце);
		
		Если ТипЗнч(ВыборкаШапки.Ссылка) <> Тип("ДокументСсылка.СчетФактураВыданный")
			И ЗначениеЗаполнено(ВыборкаШапки.БанковскийСчетОрганизации) Тогда
			Справочники.БанковскиеСчета.ЗаполнитьРеквизитыБанковскогоСчета(СведенияОПродавце, ВыборкаШапки.БанковскийСчетОрганизации);
		КонецЕсли;
		
		ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОПродавцах";
		ИмяУчастника = "Продавец";
		ТаблицаПродавцов = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
		ДанныеПродавца = ПолучитьДанныеУчастникаУПД_5_02(СведенияОПродавце);
		ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаПродавцов, ДанныеПродавца, ПутьТаблицы, ИмяУчастника);
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД_5_02(ТаблицаПродавцов, ИмяУчастника);
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаПродавцов, ПутьТаблицы);
		
		СоставительДокументаНаименование = СведенияОПродавце.ПолноеНаименование
			+ ?(ЗначениеЗаполнено(СведенияОПродавце.КПП),
				СтрШаблон(НСтр("ru = ', ИНН/КПП %1/%2'"), СведенияОПродавце.ИНН, СведенияОПродавце.КПП),
				СтрШаблон(НСтр("ru = ', ИНН %1'"), СведенияОПродавце.ИНН));
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(ВыборкаШапки.Ссылка, 
			"Объект.Организация");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СоставительДокументаНаименование, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	СведенияОПокупателе = Неопределено; 
	Если ЗначениеЗаполнено(ВыборкаШапки.Организация) Тогда
		СведенияОПокупателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Организация, СведенияОПокупателе);
		
		Если ТипЗнч(ВыборкаШапки.Ссылка) <> Тип("ДокументСсылка.СчетФактураВыданный")
			И ЗначениеЗаполнено(ВыборкаШапки.БанковскийСчетКонтрагента) Тогда
			Справочники.БанковскиеСчета.ЗаполнитьРеквизитыБанковскогоСчета(СведенияОПокупателе, ВыборкаШапки.БанковскийСчетКонтрагента);
		КонецЕсли;
		
		ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОПокупателях";
		ИмяУчастника = "Покупатель";
		ТаблицаПокупателей = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
		ДанныеПокупателя = ПолучитьДанныеУчастникаУПД_5_02(СведенияОПокупателе);
		ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаПокупателей, ДанныеПокупателя, ПутьТаблицы, ИмяУчастника);
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД_5_02(ТаблицаПокупателей, ИмяУчастника);
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаПокупателей, ПутьТаблицы);
		
	КонецЕсли;
	
	// Обработка ошибки с указанием расширенного текста сообщения вместо параметров обработки ошибки.
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить код валюты документа. Проверьте, что:
	|	- в документе указана валюта,
	|	- для нее заполнен код по Общероссийскому классификатору валют.'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОСчетеФактуре.Валюта.Код",
		ВыборкаШапки.ВалютаКод, ТекстОшибки);
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить наименование валюты документа. Проверьте, что:
	|	- в документе указана валюта,
	|	- у нее заполнено наименование.'");
	
	НаименованиеВалютыПоОКВ = "";
	ДанныеВалютыПоКлассификатору = ИнтеграцияБСПБЭД.ДанныеВалютыПоКлассификатору(ВыборкаШапки.ВалютаКод);
	Если ЗначениеЗаполнено(ДанныеВалютыПоКлассификатору) Тогда
		НаименованиеВалютыПоОКВ = ДанныеВалютыПоКлассификатору.Наименование;
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОСчетеФактуре.Валюта.Наименование",
		НаименованиеВалютыПоОКВ, ТекстОшибки);
	
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная Тогда
		
		ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОГрузоотправителях";
		ИмяУчастника = "Грузоотправитель";
		ТаблицаГрузоотправителей = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
		
		Если ЗначениеЗаполнено(ВыборкаШапки.Грузоотправитель) Тогда
			СведенияОГрузоотправителе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
			ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Грузоотправитель, СведенияОГрузоотправителе);
			ДанныеГрузоотправителя = ПолучитьДанныеУчастникаУПД_5_02(СведенияОГрузоотправителе);
			ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаГрузоотправителей, ДанныеГрузоотправителя, ПутьТаблицы, ИмяУчастника);
		Иначе
			СтрокаГрузоотправителя = ТаблицаГрузоотправителей.Добавить();
			СтрокаГрузоотправителя.ОнЖе = Истина;
		КонецЕсли;
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД_5_02(ТаблицаГрузоотправителей, "Грузоотправитель");
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаГрузоотправителей, ПутьТаблицы);
		
		ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОГрузополучателях";
		ИмяУчастника = "Грузополучатель";
		ТаблицаГрузополучателей = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
		
		ПриоритетыВидовКИГрузополучателя = Новый Массив;
		ПриоритетыВидовКИГрузополучателя.Добавить("ФактическийАдрес");
		ПриоритетыВидовКИГрузополучателя.Добавить("ПочтовыйАдрес");
		
		Грузополучатель = ?(
			ЗначениеЗаполнено(ВыборкаШапки.Грузополучатель),
			ВыборкаШапки.Грузополучатель,
			ВыборкаШапки.Организация);
		
		Если ЗначениеЗаполнено(Грузополучатель) Тогда
			СведенияОГрузополучателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
			ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(Грузополучатель, СведенияОГрузополучателе);
			Если ЗначениеЗаполнено(ВыборкаШапки.АдресДоставкиЗначенияПолей) Тогда
				СведенияОГрузополучателе.Вставить("ПроизвольныйАдрес", ВыборкаШапки.АдресДоставкиЗначенияПолей);
			КонецЕсли;
			ДанныеГрузополучателя = ПолучитьДанныеУчастникаУПД_5_02(СведенияОГрузополучателе, ПриоритетыВидовКИГрузополучателя);
