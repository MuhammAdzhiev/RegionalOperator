			НоваяСтрока.СтоимостьБезНалога = ВыборкаТоваров.СуммаБезНДС;
			НоваяСтрока.НалоговаяСтавка = ВыборкаТоваров.СтавкаНДС;
			
			Если ВыборкаТоваров.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС Тогда
				
				НоваяСтрока.СуммаНалога.Сумма = ВыборкаТоваров.СуммаНДС;
				НоваяСтрока.СуммаНалога.БезНДС = Ложь;
				
				СуммаНалога.Сумма = СуммаНалога.Сумма + ВыборкаТоваров.СуммаНДС;
				СуммаНалога.БезНДС = Ложь;
				
			КонецЕсли;
			
			НоваяСтрока.СтоимостьСНалогом = ВыборкаТоваров.СуммаСНДС;
		КонецЕсли;
		
		Если НоваяСтрока.СуммаНалога.БезНДС = Истина Тогда
			НоваяСтрока.СуммаНалога.Сумма = Неопределено;
		Иначе
			НоваяСтрока.СуммаНалога.БезНДС = Неопределено;
		КонецЕсли;
		
		НоваяСтрока.Номенклатура = ВыборкаТоваров.Номенклатура;
		НоваяСтрока.КодВидаТовара = ВыборкаТоваров.КодТНВЭД;
		НоваяСтрока.ЕдиницаИзмерения = ВыборкаТоваров.ЕдиницаИзмерения;
		НоваяСтрока.НаименованиеНавигационнаяСсылка = ПолучитьНавигационнуюСсылку(
			ВыборкаТоваров.Номенклатура, "Наименование");
		НоваяСтрока.ОснованиеОсвобожденияОтНДС = ВыборкаТоваров.ОснованиеОсвобожденияОтНДС;
		
		Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот Тогда
			
			Если ВыборкаТоваров.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа Тогда
				ЕстьРаботы = Истина;
				НоваяСтрока.Признак = ПризнакиТоваров.Работа;
			Иначе
				ЕстьУслуги = Истина;
				НоваяСтрока.Признак = ПризнакиТоваров.Услуга;
			КонецЕсли;
			
		ИначеЕсли ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав Тогда
			ЕстьПрава = Истина;
			НоваяСтрока.Признак = ПризнакиТоваров.Право;
			
		ИначеЕсли ВыборкаТоваров.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар Тогда
			ЕстьТовары = Истина;
			НоваяСтрока.Признак = ПризнакиТоваров.Имущество;
			
		ИначеЕсли ВыборкаТоваров.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа Тогда
			ЕстьРаботы = Истина;
			НоваяСтрока.Признак = ПризнакиТоваров.Работа;
			
		ИначеЕсли ВыборкаТоваров.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
			ЕстьУслуги = Истина;
			НоваяСтрока.Признак = ПризнакиТоваров.Услуга;
			
		ИначеЕсли ВыборкаТоваров.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Право Тогда
			ЕстьПрава = Истина;
			НоваяСтрока.Признак = ПризнакиТоваров.Право;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаТоваров.НомерГТД) Или ЗначениеЗаполнено(ВыборкаТоваров.СтранаПроисхожденияКод) Тогда
			НоваяСтрокаДекларации = СведенияОДекларации.Добавить();
			
			Если ЗначениеЗаполнено(ВыборкаТоваров.НомерГТД) Тогда
				НоваяСтрокаДекларации.НомерДекларации = ВыборкаТоваров.НомерГТД;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаТоваров.СтранаПроисхожденияКод) Тогда
				НоваяСтрокаДекларации.КодСтраны = ВыборкаТоваров.СтранаПроисхожденияКод;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаТоваров.СтранаПроисхожденияНаименование) Тогда
				НоваяСтрокаСтраны = СтраныПроисхождения.Добавить();
				НоваяСтрокаСтраны.СтранаПроисхождения = ВыборкаТоваров.СтранаПроисхожденияНаименование;
			КонецЕсли;
			
			НоваяСтрока.СведенияОДекларации = СведенияОДекларации.Скопировать();
			НоваяСтрока.СтраныПроисхождения = СтраныПроисхождения.Скопировать();
			НоваяСтрока.СтранаПроисхождения = ВыборкаТоваров.СтранаПроисхожденияНаименование;
			СведенияОДекларации.Очистить();
			СтраныПроисхождения.Очистить();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураДанных.СведенияПрослеживаемости) Тогда
			Отбор = Новый Структура("ИдентификаторСтроки", ВыборкаТоваров.ИдентификаторСтроки);
			КоллекцияСведений = СтруктураДанных.СведенияПрослеживаемости.НайтиСтроки(Отбор);
			Если ЗначениеЗаполнено(КоллекцияСведений) Тогда
				НоваяСтрока.СведенияОПрослеживаемости = НовыеСведенияОПрослеживаемости();
				Для Каждого ТекущиеСведения Из КоллекцияСведений Цикл
					НовыеСведения = НоваяСтрока.СведенияОПрослеживаемости.Добавить();
					НовыеСведения.НомерТовара = ТекущиеСведения.РНПТ;
					НовыеСведения.КоличествоУчетное = ТекущиеСведения.КоличествоУпаковок;
					НовыеСведения.Количество = ТекущиеСведения.КоличествоПрослеживаемости;
					НовыеСведения.ЕдиницаИзмеренияКод = ТекущиеСведения.ЕдиницаИзмеренияКод;
					НовыеСведения.ЕдиницаИзмеренияНаименование = ТекущиеСведения.ЕдиницаИзмеренияНаименование;
					НовыеСведения.СтоимостьБезНДС = Окр(ТекущиеСведения.СтоимостьБезНДС);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаТоваров.АмортизационнаяГруппа)
			Или ЗначениеЗаполнено(ВыборкаТоваров.КодОКОФ)
			Или ЗначениеЗаполнено(ВыборкаТоваров.СрокПолезногоИспользования)
			Или ЗначениеЗаполнено(ВыборкаТоваров.ФактСрокПолезногоИспользования) Тогда
			ДанныеАмортизации = НовыеДанныеАмортизации();
			ДанныеАмортизации.АмортизационнаяГруппа = ВыборкаТоваров.АмортизационнаяГруппа;
			ДанныеАмортизации.КодОКОФ = ВыборкаТоваров.КодОКОФ;
			ДанныеАмортизации.СрокИспользования = ВыборкаТоваров.СрокПолезногоИспользования;
			ДанныеАмортизации.ФактическийСрокИспользования = ВыборкаТоваров.ФактСрокПолезногоИспользования;
			НоваяСтрока.ДанныеДляРасчетаАмортизации = ДанныеАмортизации;
		КонецЕсли;
		
		Сопоставление = Новый Структура;
		Сопоставление.Вставить("Наименование", ВыборкаТоваров.НаименованиеПолное);
		Если ЗначениеЗаполнено(ВыборкаТоваров.Характеристика) Тогда
			Сопоставление.Вставить("Характеристика", ВыборкаТоваров.ХарактеристикаНаименование);
		КонецЕсли;
		Сопоставление.Вставить("ЕдиницаИзмерения", НоваяСтрока.ЕдиницаИзмеренияНаименование);
		Сопоставление.Вставить("Артикул", ВыборкаТоваров.НоменклатураАртикул);
		Сопоставление.Вставить("ЕдиницаИзмеренияКод", ВыборкаТоваров.ЕдиницаИзмеренияКод);
		Сопоставление.Вставить("СтавкаНДС", ВыборкаТоваров.НоменклатураСтавкаНДС);
		
		Сопоставление.Вставить("НоменклатураИБ", ВыборкаТоваров.Номенклатура);
		Сопоставление.Вставить("ХарактеристикаИБ", ВыборкаТоваров.Характеристика);
		Сопоставление.Вставить("УпаковкаИБ", ВыборкаТоваров.ЕдиницаИзмерения);
		
		ЗаполнитьШтрихкодыТоваровВСопоставление(Сопоставление, ШтрихкодыНоменклатуры, ШтрихкодыКомбинаций,
			ВыборкаТоваров.Номенклатура, ВыборкаТоваров.Характеристика, ВыборкаТоваров.ЕдиницаИзмерения);

		НоваяСтрока.Сопоставление = Сопоставление;
		
		Если ЗаполнениеКодаТовара = "Артикул" Тогда
			НоваяСтрока.ТоварКод = ВыборкаТоваров.НоменклатураАртикул;
		ИначеЕсли ЗаполнениеКодаТовара = "Штрихкод" 
			И НоваяСтрока.Сопоставление.Свойство("ШтрихкодКомбинации") Тогда
			НоваяСтрока.ТоварКод = НоваяСтрока.Сопоставление.ШтрихкодКомбинации;
		КонецЕсли;
		
		Если ИспользуетсяГосИС Тогда
			ЭлектронноеВзаимодействиеИСМП.ЗаполнитьСведенияОМаркировке_5_02(НоваяСтрока, ВыборкаТоваров, ТаблицаКодовМаркировки);
		Иначе
			ЗаполнитьРеквизитыМаркировкиВСтрокеТоваров_5_02(НоваяСтрока, ТаблицаКодовМаркировки, ВыборкаШапки.Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИспользуетсяГосИС Тогда
		
		ПараметрыЗаполнения = Новый Структура;
		ПараметрыЗаполнения.Вставить("Ссылка",          ВыборкаШапки.Ссылка);
		ПараметрыЗаполнения.Вставить("Дата",            ВыборкаШапки.Дата);
		ПараметрыЗаполнения.Вставить("СтруктураДанных", СтруктураДанных);
		
		ДополнитьДеревоТаблицуКодовМаркировки(ТаблицаКодовМаркировки, ДеревоДанных, ПараметрыЗаполнения, Отказ);

	КонецЕсли;
	
	Если СуммаНалога.БезНДС = Истина Тогда
		СуммаНалога.Сумма = Неопределено;
	Иначе
		СуммаНалога.БезНДС = Неопределено;
	КонецЕсли;
	
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить итоговые стоимостные показатели. Возможные причины:
	|	- не заполнена табличная часть ""Товары""
	|	- не заполнены колонки ""Сумма"", ""НДС"", ""Количество""'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ТаблицаСчетаФактуры.ВсегоКОплате.СтоимостьБезНалога", СведенияОТоварах.Итог("СтоимостьБезНалога"), ТекстОшибки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ТаблицаСчетаФактуры.ВсегоКОплате.СтоимостьСНалогом", СведенияОТоварах.Итог("СтоимостьСНалогом"), ТекстОшибки);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ТаблицаСчетаФактуры.ВсегоКОплате.Количество", СведенияОТоварах.Итог("Количество"), ТекстОшибки);
		
	ЭлектронноеВзаимодействие.ЗагрузитьСтруктуруВГруппуДерева(ДеревоДанных, СуммаНалога, "ТаблицаСчетаФактуры.ВсегоКОплате.СуммаНалога");
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных, "ТаблицаСчетаФактуры.ВсегоКОплате.СуммаНалога", ТекстОшибки);
	
	// Обработка ошибки с открытием формы по навигационной ссылке.
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезНавигационнуюСсылку(СведенияОТоварах,
		"Наименование", "НаименованиеНавигационнаяСсылка");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезОткрытиеФормы(СведенияОТоварах,
		"Наименование", "Справочник.Номенклатура.ФормаОбъекта",, Новый Структура("Ключ", "Номенклатура"));
	
	// Обработка ошибки через механизм сообщений пользователю.
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
		"Код", "Номенклатура", "Объект.Код");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
		"Наименование", "Номенклатура", "Объект.НаименованиеПолное");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
		"Количество", ВыборкаТоваров.Ссылка, "Объект.Товары.Количество",, "НомерСтрокиИсходногоДокумента");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
		"Цена", ВыборкаТоваров.Ссылка, "Объект.Товары.Цена",, "НомерСтрокиИсходногоДокумента");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
		"СтоимостьБезНалога", ВыборкаТоваров.Ссылка, "Объект.Товары.Сумма",, "НомерСтрокиИсходногоДокумента");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
		"ЕдиницаИзмеренияНаименование", "ЕдиницаИзмерения", "Объект.Наименование");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
		"ЕдиницаИзмеренияКод", "ЕдиницаИзмерения", "Объект.Код");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
		"Признак", "Номенклатура", "Объект.ВидНоменклатуры");
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
		"ДанныеДляРасчетаАмортизации.АмортизационнаяГруппа", ВыборкаТоваров.Ссылка,
		"Объект.Товары.АмортизационнаяГруппа",, "НомерСтрокиИсходногоДокумента");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
		"ДанныеДляРасчетаАмортизации.КодОКОФ", ВыборкаТоваров.Ссылка,
		"Объект.Товары.КодОКОФ",, "НомерСтрокиИсходногоДокумента");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
		"ДанныеДляРасчетаАмортизации.СрокИспользования", ВыборкаТоваров.Ссылка,
		"Объект.Товары.СрокПолезногоИспользования",, "НомерСтрокиИсходногоДокумента");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
		"ДанныеДляРасчетаАмортизации.ФактическийСрокИспользования", ВыборкаТоваров.Ссылка,
		"Объект.Товары.ФактСрокПолезногоИспользования",, "НомерСтрокиИсходногоДокумента");
	
	// Обработка ошибки через упрощенный механизм
	ТекстОшибки = НСтр("ru = 'для формирования электронного документа необходимо указать налоговую ставку'");
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СведенияОТоварах,
		"НалоговаяСтавка",,, ТекстОшибки);
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, СведенияОТоварах, "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях");
	
	ТекстОшибки = НСтр("ru = 'Возникла ошибка при заполнении страны происхождения в сведениях по ГТД. Возможные причины:
	|	- не заполнена колонка ""Страна происхождения""
	|	- указанной страны нет в классификаторе стран мира'");
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных,
		"ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях.НомерСтроки.СведенияОДекларации.НомерСтроки.КодСтраны", ТекстОшибки);
	
	ТолькоУслуги = Истина;
	СоставСодержания = Новый Массив;
	ПараметрыОбработкиОшибокСодержаниеОперации = Неопределено;
	Если ЕстьТовары Или ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная Тогда
		СоставСодержания.Добавить(НСтр("ru = 'Товары переданы.'"));
		ТолькоУслуги = Ложь;
	КонецЕсли;
	Если ЕстьУслуги Или ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот Тогда
		СоставСодержания.Добавить(НСтр("ru = 'Услуги оказаны в полном объеме.'"));
	КонецЕсли;
	Если ЕстьРаботы Или ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот Тогда
		СоставСодержания.Добавить(НСтр("ru = 'Работы выполнены в полном объеме.'"));
	КонецЕсли;
	Если ЕстьПрава Или ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав Тогда
		СоставСодержания.Добавить(НСтр("ru = 'Имущественные права переданы.'"));
		ТолькоУслуги = Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(ВыборкаШапки.СодержаниеОперации) Тогда
		СоставСодержания.Добавить(ВыборкаШапки.СодержаниеОперации);
	КонецЕсли;
	СодержаниеОперации = СтрСоединить(СоставСодержания, " ");
	Если Не ЗначениеЗаполнено(СодержаниеОперации) Тогда
		ТекстОшибки = НСтр("ru = 'Необходимо заполнить содержание операции'");
		ПараметрыОбработкиОшибокСодержаниеОперации = 
			ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				СсылкаНаОбъект, "Объект.СодержаниеОперации", , , , ТекстОшибки);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, 
		"СведенияОПередаче.Операция.СодержаниеОперации", СодержаниеОперации, ПараметрыОбработкиОшибокСодержаниеОперации);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги);
		
КонецПроцедуры

// Заполняет дерево электронного документа.
//
// Параметры:
//  СтруктураДанных - Структура - возвращается методом ПолучитьДанныеДляЭД учетного документа.
//  СтруктураЭД - Структура - настройки заполнения данных:
//   * Функция - Строка
//   * ТипДокумента - Произвольный
//   * Отправитель - ОпределяемыйТип.Организация
//   * Получатель - ОпределяемыйТип.КонтрагентБЭД
//   * Договор - ОпределяемыйТип.ДоговорСКонтрагентомЭДО
//   * ВариантыЗаполненияПолей - Структура:
//    ** ТоварКод - Строка
//  ДеревоДанных - ДеревоЗначений - дерево электронного документа
//  Отказ - Булево - Истина, если в процессе формирования ЭД были найдены критические ошибки.
//
Процедура ЗаполнитьДеревоДанныхУПД_5_02(СтруктураДанных, СтруктураЭД, ДеревоДанных, Отказ = Ложь)
	
	ВыборкаШапки = СтруктураДанных.ВыборкаШапки;
	
	ЭтоЭлектронноеАктированиеЕИС = Ложь;
	МодульЭлектронноеАктированиеЕИС = Неопределено;
	ДанныеПриложенияЕИС = Неопределено;
	ДанныеЭлектронногоАктированияЕИС = Неопределено;
	
	Если ЗначениеЗаполнено(СтруктураДанных.ДанныеЭлектронногоАктированияЕИС)
		И СтруктураДанных.ДанныеЭлектронногоАктированияЕИС.Количество() > 0 Тогда
		МодульЭлектронноеАктированиеЕИС = ОбщегоНазначения.ОбщийМодуль("ЭлектронноеАктированиеЕИС");
		
		ОбменВключен = МодульЭлектронноеАктированиеЕИС.
			ОбменПоОрганизацииВключен(ВыборкаШапки.Организация);
		Контракт = МодульЭлектронноеАктированиеЕИС.
			ГосударственныйКонтрактДоговора(ВыборкаШапки.ДоговорКонтрагента);
			
		Если ОбменВключен И ЗначениеЗаполнено(Контракт) Тогда
			ЭтоЭлектронноеАктированиеЕИС = Истина;
			ДанныеПриложенияЕИС = МодульЭлектронноеАктированиеЕИС.
				НовыеДанныеПриложенияКТитулуПродавцаУПД();
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"ДанныеЭлектронногоАктированияЕИС.ДанныеПриложения", ДанныеПриложенияЕИС);
			ДанныеЭлектронногоАктированияЕИС = СтруктураДанных.ДанныеЭлектронногоАктированияЕИС;
		КонецЕсли;
		
	КонецЕсли;
	
	Комитент = Неопределено;
	ДоговорСКомитентом = Неопределено;
	Если СтруктураЭД.Функция = "СвРК" Или СтруктураЭД.Функция = "СвЗК" Тогда
		Комитент = СтруктураЭД.Получатель;
		ДоговорСКомитентом = СтруктураЭД.Договор;
	КонецЕсли;
	
	СведенияОПродавце = Неопределено; 
	Если ЗначениеЗаполнено(ВыборкаШапки.Организация) Тогда
		СведенияОПродавце = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Организация, СведенияОПродавце);
		
		Если ТипЗнч(ВыборкаШапки.Ссылка) <> Тип("ДокументСсылка.СчетФактураВыданный")
			И ЗначениеЗаполнено(ВыборкаШапки.БанковскийСчетОрганизации) Тогда
			Справочники.БанковскиеСчета.ЗаполнитьРеквизитыБанковскогоСчета(СведенияОПродавце, ВыборкаШапки.БанковскийСчетОрганизации);
		КонецЕсли;
		
		ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОПродавцах";
		ИмяУчастника = "Продавец";
		ТаблицаПродавцов = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
		ДанныеПродавца = ПолучитьДанныеУчастникаУПД_5_02(СведенияОПродавце, , ЭтоЭлектронноеАктированиеЕИС);
		ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаПродавцов, ДанныеПродавца, ПутьТаблицы, ИмяУчастника);
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД_5_02(ТаблицаПродавцов, ИмяУчастника);
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаПродавцов, ПутьТаблицы);
		
		Если ЭтоЭлектронноеАктированиеЕИС Тогда
			СоставительДокументаНаименование =
				МодульЭлектронноеАктированиеЕИС.НаименованиеОрганизацииДляЭД(
					СведенияОПродавце.Ссылка);
		Иначе
			СоставительДокументаНаименование = СведенияОПродавце.ПолноеНаименование
				+ ?(ЗначениеЗаполнено(СведенияОПродавце.КПП),
					СтрШаблон(НСтр("ru = ', ИНН/КПП %1/%2'"), СведенияОПродавце.ИНН, СведенияОПродавце.КПП),
					СтрШаблон(НСтр("ru = ', ИНН %1'"), СведенияОПродавце.ИНН));
		КонецЕсли;
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(ВыборкаШапки.Ссылка, 
			"Объект.Организация");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СоставительДокументаНаименование, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	СведенияОПокупателе = Неопределено; 
	Если ЗначениеЗаполнено(ВыборкаШапки.Контрагент) Тогда
		СведенияОПокупателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
		ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Контрагент, СведенияОПокупателе);
		
		Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная
			И ЗначениеЗаполнено(ВыборкаШапки.Грузополучатель) Тогда
				
			СведенияОГрузополучателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
			ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Грузополучатель, СведенияОГрузополучателе);
			
			// Отгрузка в адрес обособленного подразделения покупателя.
			Если СведенияОПокупателе.ИНН = СведенияОГрузополучателе.ИНН Тогда
				СведенияОПокупателе.КПП = СведенияОГрузополучателе.КПП;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТипЗнч(ВыборкаШапки.Ссылка) <> Тип("ДокументСсылка.СчетФактураВыданный")
			И ЗначениеЗаполнено(ВыборкаШапки.БанковскийСчетКонтрагента) Тогда
			Справочники.БанковскиеСчета.ЗаполнитьРеквизитыБанковскогоСчета(СведенияОПокупателе, ВыборкаШапки.БанковскийСчетКонтрагента);
		КонецЕсли;
		
		ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОПокупателях";
		ИмяУчастника = "Покупатель";
		ТаблицаПокупателей = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
		ДанныеПокупателя = ПолучитьДанныеУчастникаУПД_5_02(СведенияОПокупателе, , ЭтоЭлектронноеАктированиеЕИС);
		ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаПокупателей, ДанныеПокупателя, ПутьТаблицы, ИмяУчастника);
		Если ЭтоЭлектронноеАктированиеЕИС Тогда
			МодульЭлектронноеАктированиеЕИС.ИнформацияУчастникаПокупателя(ТаблицаПокупателей, ИмяУчастника);
		КонецЕсли;
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД_5_02(ТаблицаПокупателей, ИмяУчастника);
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаПокупателей, ПутьТаблицы);
		
	КонецЕсли;
	
	// Обработка ошибки с указанием расширенного текста сообщения вместо параметров обработки ошибки.
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить код валюты документа. Проверьте, что:
	|	- в документе указана валюта,
	|	- для нее заполнен код по Общероссийскому классификатору валют.'");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОСчетеФактуре.Валюта.Код",
		ВыборкаШапки.ВалютаКод, ТекстОшибки);
	ТекстОшибки = НСтр("ru = 'Не удалось заполнить наименование валюты документа. Проверьте, что:
	|	- в документе указана валюта,
	|	- у нее заполнено наименование.'");
	
	НаименованиеВалютыПоОКВ = "";
	ДанныеВалютыПоКлассификатору = ИнтеграцияБСПБЭД.ДанныеВалютыПоКлассификатору(ВыборкаШапки.ВалютаКод);
	Если ЗначениеЗаполнено(ДанныеВалютыПоКлассификатору) Тогда
		НаименованиеВалютыПоОКВ = ДанныеВалютыПоКлассификатору.Наименование;
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, 
		"СведенияОСчетеФактуре.Валюта.Наименование",
		НаименованиеВалютыПоОКВ,
		ТекстОшибки);
		
	Если ВыборкаШапки.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная Тогда
		
		ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОГрузоотправителях";
		ИмяУчастника = "Грузоотправитель";
		ТаблицаГрузоотправителей = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
		
		Если ЗначениеЗаполнено(ВыборкаШапки.Грузоотправитель) Тогда
			СведенияОГрузоотправителе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
			ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Грузоотправитель, СведенияОГрузоотправителе);
			ДанныеГрузоотправителя = ПолучитьДанныеУчастникаУПД_5_02(СведенияОГрузоотправителе);
			ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаГрузоотправителей, ДанныеГрузоотправителя, ПутьТаблицы, ИмяУчастника);
		Иначе
			СтрокаГрузоотправителя = ТаблицаГрузоотправителей.Добавить();
			СтрокаГрузоотправителя.ОнЖе = Истина;
		КонецЕсли;
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД_5_02(ТаблицаГрузоотправителей, ИмяУчастника);
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаГрузоотправителей, ПутьТаблицы);		
		
		ПутьТаблицы = "СведенияОСчетеФактуре.СведенияОГрузополучателях";
		ИмяУчастника = "Грузополучатель";
		ТаблицаГрузополучателей = ПолучитьТаблицуУчастниковУПД_5_02(ДеревоДанных, ПутьТаблицы);
		
		ПриоритетыВидовКИГрузополучателя = Новый Массив;
		ПриоритетыВидовКИГрузополучателя.Добавить("ФактическийАдрес");
		ПриоритетыВидовКИГрузополучателя.Добавить("ПочтовыйАдрес");
		
		Если ЗначениеЗаполнено(ВыборкаШапки.Грузополучатель) Тогда
			СведенияОГрузополучателе = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
			ЭлектронноеВзаимодействиеКЭДО.ПолучитьДанныеЮрФизЛица(ВыборкаШапки.Грузополучатель, СведенияОГрузополучателе);
			Если ЗначениеЗаполнено(ВыборкаШапки.АдресДоставкиЗначенияПолей) Тогда
				СведенияОГрузополучателе.Вставить("ПроизвольныйАдрес", ВыборкаШапки.АдресДоставкиЗначенияПолей);
			КонецЕсли;
			ДанныеГрузополучателя = ПолучитьДанныеУчастникаУПД_5_02(СведенияОГрузополучателе, ПриоритетыВидовКИГрузополучателя);
			ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаГрузополучателей, ДанныеГрузополучателя, ПутьТаблицы, ИмяУчастника);
		Иначе
			Если ЗначениеЗаполнено(ВыборкаШапки.АдресДоставкиЗначенияПолей) Тогда
				СведенияОПокупателе.Вставить("ПроизвольныйАдрес", ВыборкаШапки.АдресДоставкиЗначенияПолей);
			КонецЕсли;
			ДанныеГрузополучателя = ПолучитьДанныеУчастникаУПД_5_02(СведенияОПокупателе, ПриоритетыВидовКИГрузополучателя);
			ДобавитьУчастникаУПД_5_02(ДеревоДанных, ТаблицаГрузополучателей, ДанныеГрузополучателя, ПутьТаблицы, ИмяУчастника);
		КонецЕсли;
		
		Если ЭтоЭлектронноеАктированиеЕИС Тогда
			ДанныеГрузополучателя = ТаблицаГрузополучателей[ТаблицаГрузополучателей.Количество() - 1];
			ИдентификаторУчастника = МодульЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаГрузополучателя();
			ДанныеГрузополучателя[ИмяУчастника].ИнформацияДляУчастника = ИдентификаторУчастника;
		КонецЕсли;
		
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД_5_02(ТаблицаГрузополучателей, ИмяУчастника);
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаГрузополучателей, ПутьТаблицы);
		
		Если ЗначениеЗаполнено(ВыборкаШапки.ИныеСведенияОбОтгрузке) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"ИныеСведенияОбОтгрузке", ВыборкаШапки.ИныеСведенияОбОтгрузке);
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураЭД.Функция <> "СЧФ" Тогда 
		
		Путь = "СведенияОПередаче.Операция.ОснованиеОтгрузкиПередачи."; 
		
		Если ЗначениеЗаполнено(ВыборкаШапки.ДоговорКонтрагента) Тогда
			ДокументОснование = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
				ДеревоДанных, Путь + "ДокументыОснования.НомерСтроки.ДокументОснование");
			ДокументОснование.НаименованиеДокумента = ВыборкаШапки.НаименованиеДоговора;
			ДокументОснование.НомерДокумента = ВыборкаШапки.НомерДоговора;
			ДокументОснование.ДатаДокумента = ВыборкаШапки.ДатаДоговора;
			
			ТаблицаДокументовОснований = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
				ДеревоДанных, Путь + "ДокументыОснования");
			ТаблицаДокументовОснований.Колонки.Добавить("ДоговорКонтрагента");
			СтрокаДокументаОснования = ТаблицаДокументовОснований.Добавить();
