#Область ПрограммныйИнтерфейс

#Область ТЭДО

// см. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДокументаТЭДО
Процедура ПриОтраженииВУчетеДокументаТЭДО(ДокументУчета, СпособОбработки, ДанныеТЭДО, ОписаниеОшибки) Экспорт
	
	Если ДанныеТЭДО.ПространствоИмен = ТрансграничныйЭДО.ПространстваИмен().ТоварнаяНакладнаяРБ Тогда
		ПриОтраженииВУчетеТоварнойНакладнойРБ(ДокументУчета, СпособОбработки, ДанныеТЭДО);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииИспользуемыхТиповЭлектронныхДокументов.
Процедура ПриОпределенииИспользуемыхТиповЭлектронныхДокументов(АктуальныеТипы) Экспорт
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	// Для обмена по форматам ФНС.
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.ТоварнаяНакладная);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.АктВыполненныхРабот);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.СчетФактура);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.КорректировочныйСчетФактура);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.СоглашениеОбИзмененииСтоимости);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.АктНаПередачуПрав);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.УПД);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.УКД);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.АктОРасхождениях);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.ДоговорныйДокумент);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.АктСверкиВзаиморасчетов);
	
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.СведенияОРеализацииКомиссионером);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.СведенияОЗакупкеКомиссионером);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.КорректировкаСведенийОРеализацииКомиссионером);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.КорректировкаСведенийОЗакупкеКомиссионером);
	
	// Для обмена по форматам CML 2.
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.КаталогТоваров);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.ЗаказТовара);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.ОтветНаЗаказ);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.СчетНаОплату);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.СчетОферта);
	
	// Поддержка трансграничного ЭДО
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.ТоварнаяНакладнаяРБ);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьПараметрыЭДПоИсточнику.
Процедура ЗаполнитьПараметрыЭДПоИсточнику(Источник, ПараметрыЭлектронногоДокумента) Экспорт
	
	ТипыДокументов        = ОбменСКонтрагентами.ТипыДокументов();
	НаправленияДокументов = ОбменСКонтрагентами.НаправленияДокументов();
	
	ТипИсточника = ТипЗнч(Источник);
	ЭтоСсылка = ОбщегоНазначения.ЭтоСсылка(ТипИсточника);

	Если ТипИсточника = Тип("ДокументСсылка.РеализацияТоваровУслуг")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		
		Реквизиты = "ВидДокумента, ВидОперации, Организация, Контрагент, ДоговорКонтрагента, ДокументОснование,
			|НомерИсправляемогоКорректировочногоДокумента, ДатаИсправляемогоКорректировочногоДокумента";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		СтрокаПараметров.Направление        = НаправленияДокументов.Исходящий;
		СтрокаПараметров.Организация        = ЗначенияРеквизитов.Организация;
		СтрокаПараметров.Контрагент         = ЗначенияРеквизитов.Контрагент;
		СтрокаПараметров.ДоговорКонтрагента = ЗначенияРеквизитов.ДоговорКонтрагента;
		
		Если ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОпераций.Корректировка
			ИЛИ (ЗначениеЗаполнено(ЗначенияРеквизитов.НомерИсправляемогоКорректировочногоДокумента)
				И ЗначениеЗаполнено(ЗначенияРеквизитов.ДатаИсправляемогоКорректировочногоДокумента)) Тогда
			СтрокаПараметров.Тип = ТипыДокументов.СоглашениеОбИзмененииСтоимости;
		ИначеЕсли ЗначенияРеквизитов.ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот Тогда
			СтрокаПараметров.Тип = ТипыДокументов.АктВыполненныхРабот;
		ИначеЕсли ЗначенияРеквизитов.ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав Тогда
			СтрокаПараметров.Тип = ТипыДокументов.АктНаПередачуПрав;
		ИначеЕсли ЗначенияРеквизитов.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная Тогда
			СтрокаПараметров.Тип = ТипыДокументов.ТоварнаяНакладная;
		ИначеЕсли ЗначенияРеквизитов.ВидДокумента = Перечисления.ВидыДокументов.СведенияКомиссионера Тогда
			СтрокаПараметров.Направление = НаправленияДокументов.Входящий;
			Если ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОпераций.Корректировка Тогда
				СтрокаПараметров.Тип = ТипыДокументов.КорректировкаСведенийОРеализацииКомиссионером;
			Иначе
				СтрокаПараметров.Тип = ТипыДокументов.СведенияОРеализацииКомиссионером;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОпераций.Корректировка
			Или ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОпераций.Исправление
			И ЗначениеЗаполнено(ЗначенияРеквизитов.ДокументОснование) Тогда
			СчетФактураДокументаОснования = Документы.СчетФактураВыданный.СчетФактураДокумента(
				ЗначенияРеквизитов.ДокументОснование);
			Если Не ЗначениеЗаполнено(СчетФактураДокументаОснования) Тогда
				СтрокаПараметров.ФормированиеУниверсальногоДокумента = 
					ОбменСКонтрагентами.ВариантыФормированияУниверсальныхДокументов().Запрещено;
			КонецЕсли;
		КонецЕсли;
		
		СтрокиБезНДС = Источник.Товары.НайтиСтроки(Новый Структура("СтавкаНДС", Перечисления.СтавкиНДС.БезНДС));
		Если Источник.Товары.Количество() <> 0 И Источник.Товары.Количество() = СтрокиБезНДС.Количество() Тогда
			СтрокаПараметров.ФормированиеУниверсальногоДокумента = 
				ОбменСКонтрагентами.ВариантыФормированияУниверсальныхДокументов().Запрещено;
		КонецЕсли;
		
		Если СтрокаПараметров.Тип = ТипыДокументов.ТоварнаяНакладная
			ИЛИ СтрокаПараметров.Тип = ТипыДокументов.СоглашениеОбИзмененииСтоимости Тогда
			
			ТаблицаКомитентов = ТаблицаКомитентовПоДокументу(Источник);
			
			Для Каждого СтрокаКомитента Из ТаблицаКомитентов Цикл
				
				СтрокаТаблицы = ПараметрыЭлектронногоДокумента.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаПараметров);
				СтрокаТаблицы.Контрагент = СтрокаКомитента.Комитент;
				СтрокаТаблицы.ДоговорКонтрагента = СтрокаКомитента.ДоговорСКомитентом;
				СтрокаТаблицы.Направление = НаправленияДокументов.Исходящий;
				Если СтрокаПараметров.Тип = ТипыДокументов.ТоварнаяНакладная Тогда
					СтрокаТаблицы.Тип = ТипыДокументов.СведенияОРеализацииКомиссионером;
				ИначеЕсли СтрокаПараметров.Тип = ТипыДокументов.СоглашениеОбИзмененииСтоимости Тогда
					СтрокаТаблицы.Тип = ТипыДокументов.КорректировкаСведенийОРеализацииКомиссионером;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ПоступлениеТоваровУслуг")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда
		
		Реквизиты = "ВидДокумента, ВидОперации, Организация, Контрагент, ДоговорКонтрагента,
			|НомерИсправляемогоКорректировочногоДокумента, ДатаИсправляемогоКорректировочногоДокумента";
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		СтрокаПараметров.Направление        = НаправленияДокументов.Входящий;
		СтрокаПараметров.Организация        = ЗначенияРеквизитов.Организация;
		СтрокаПараметров.Контрагент         = ЗначенияРеквизитов.Контрагент;
		СтрокаПараметров.ДоговорКонтрагента = ЗначенияРеквизитов.ДоговорКонтрагента;
		
		Если ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОпераций.Корректировка
			ИЛИ (ЗначениеЗаполнено(ЗначенияРеквизитов.НомерИсправляемогоКорректировочногоДокумента)
				И ЗначениеЗаполнено(ЗначенияРеквизитов.ДатаИсправляемогоКорректировочногоДокумента)) Тогда
			СтрокаПараметров.Тип = ТипыДокументов.СоглашениеОбИзмененииСтоимости;
		ИначеЕсли ЗначенияРеквизитов.ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот Тогда
			СтрокаПараметров.Тип = ТипыДокументов.АктВыполненныхРабот;
		ИначеЕсли ЗначенияРеквизитов.ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав Тогда
			СтрокаПараметров.Тип = ТипыДокументов.АктНаПередачуПрав;
		ИначеЕсли ЗначенияРеквизитов.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная Тогда
			СтрокаПараметров.Тип = ТипыДокументов.ТоварнаяНакладная;
		ИначеЕсли ЗначенияРеквизитов.ВидДокумента = Перечисления.ВидыДокументов.НакладнаяНаВозврат Тогда
			СтрокаПараметров.Тип = ТипыДокументов.ТоварнаяНакладная; 
		ИначеЕсли ЗначенияРеквизитов.ВидДокумента = Перечисления.ВидыДокументов.СведенияКомиссионера Тогда
			СтрокаПараметров.Направление = НаправленияДокументов.Входящий;
			Если ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОпераций.Корректировка Тогда
				СтрокаПараметров.Тип = ТипыДокументов.КорректировкаСведенийОЗакупкеКомиссионером;
			Иначе
				СтрокаПараметров.Тип = ТипыДокументов.СведенияОЗакупкеКомиссионером;
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаПараметров.Тип = ТипыДокументов.ТоварнаяНакладная
			ИЛИ СтрокаПараметров.Тип = ТипыДокументов.СоглашениеОбИзмененииСтоимости Тогда
			
			ТаблицаКомитентов = ТаблицаКомитентовПоДокументу(Источник);
			
			Для Каждого СтрокаКомитента Из ТаблицаКомитентов Цикл
				
				СтрокаТаблицы = ПараметрыЭлектронногоДокумента.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаПараметров);
				СтрокаТаблицы.Контрагент = СтрокаКомитента.Комитент;
				СтрокаТаблицы.ДоговорКонтрагента = СтрокаКомитента.ДоговорСКомитентом;
				СтрокаТаблицы.Направление = НаправленияДокументов.Исходящий;
				Если СтрокаПараметров.Тип = ТипыДокументов.ТоварнаяНакладная Тогда
					СтрокаТаблицы.Тип = ТипыДокументов.СведенияОЗакупкеКомиссионером;
				ИначеЕсли СтрокаПараметров.Тип = ТипыДокументов.СоглашениеОбИзмененииСтоимости Тогда
					СтрокаТаблицы.Тип = ТипыДокументов.КорректировкаСведенийОЗакупкеКомиссионером;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.СчетФактураВыданный")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.СчетФактураВыданный") Тогда
		
		Реквизиты = "ВидДокумента, ВидОперации, Организация, Контрагент, ДоговорКонтрагента,
			|НомерИсправляемогоКорректировочногоДокумента, ДатаИсправляемогоКорректировочногоДокумента";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		Если ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОпераций.Корректировка
			ИЛИ (ЗначениеЗаполнено(ЗначенияРеквизитов.НомерИсправляемогоКорректировочногоДокумента)
				И ЗначениеЗаполнено(ЗначенияРеквизитов.ДатаИсправляемогоКорректировочногоДокумента)) Тогда
			Тип = ТипыДокументов.КорректировочныйСчетФактура;
		Иначе
			Тип = ТипыДокументов.СчетФактура;
		КонецЕсли;
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		
		СтрокаПараметров.Тип               = Тип;
		СтрокаПараметров.Направление       = НаправленияДокументов.Исходящий;
		СтрокаПараметров.Организация        = ЗначенияРеквизитов.Организация;
		СтрокаПараметров.Контрагент         = ЗначенияРеквизитов.Контрагент;
		СтрокаПараметров.ДоговорКонтрагента = ЗначенияРеквизитов.ДоговорКонтрагента;
		
		Если ЗначенияРеквизитов.ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс Тогда
			СтрокаПараметров.ФормированиеУниверсальногоДокумента = 
				ОбменСКонтрагентами.ВариантыФормированияУниверсальныхДокументов().Запрещено;
		КонецЕсли;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.СчетФактураПолученный")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.СчетФактураПолученный") Тогда
		
		Реквизиты = "ВидОперации, Организация, Контрагент, ДоговорКонтрагента";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
