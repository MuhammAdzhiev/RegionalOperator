// Расписание регламентных заданий.
// 
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - Расписание регламентных заданий по имени:
//  * Ключ - Строка
//  * Значение - РасписаниеРегламентногоЗадания
Функция РасписаниеРегламентныхЗаданий()
	
	ВозвращаемоеЗначение = Новый Соответствие();
	
	// ЗагрузкаСведенийОбОтклоненияхИСМП
	Расписание = Новый РасписаниеРегламентногоЗадания();
	ДанныеРасписания = ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру(Расписание);
	ДанныеРасписания.ПериодПовтораДней = 1;
	ДанныеРасписания.ВремяНачала       = '00010101030000';
	ВозвращаемоеЗначение.Вставить(
		Метаданные.РегламентныеЗадания.ЗагрузкаСведенийОбОтклоненияхИСМП,
		ОбщегоНазначенияКлиентСервер.СтруктураВРасписание(ДанныеРасписания));
	
	// ОчисткаПулаКодовМаркировкиИСМП
	Расписание = Новый РасписаниеРегламентногоЗадания();
	ДанныеРасписания = ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру(Расписание);
	ДанныеРасписания.ПериодПовтораДней = 1;
	ДанныеРасписания.ВремяНачала       = '00010101040000';
	ВозвращаемоеЗначение.Вставить(
		Метаданные.РегламентныеЗадания.ОчисткаПулаКодовМаркировкиИСМП,
		ОбщегоНазначенияКлиентСервер.СтруктураВРасписание(ДанныеРасписания));
	
	// УдалениеНеиспользованныхКодовМаркировкиИСМП
	Расписание = Новый РасписаниеРегламентногоЗадания();
	ДанныеРасписания = ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру(Расписание);
	ДанныеРасписания.ПериодПовтораДней = 1;
	ДанныеРасписания.ВремяНачала       = '00010101020000';
	ВозвращаемоеЗначение.Вставить(
		Метаданные.РегламентныеЗадания.УдалениеНеиспользованныхКодовМаркировкиИСМП,
