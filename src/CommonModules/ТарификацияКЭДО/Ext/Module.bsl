// Возвращает признак тарифицируемости услуги
// 
// Возвращаемое значение:
//  Булево
//
Функция УслугаТарифицируется(ИдентификаторУслуги, ИдентификаторПоставщика) Экспорт
	
	Услуга = Тарификация.УслугаПоИдентификаторуИИдентификаторуПоставщика(ИдентификаторУслуги, ИдентификаторПоставщика,
		Ложь);
	
	Если Услуга = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Услуга, "Тарифицируется");
	Возврат Результат;
	
КонецФункции

// Представление конфигурации
// 
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеКонфигурации() Экспорт
	
	Если КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		Результат = НСтр("ru = 'Электронный документооборот и Маркировка'");
	Иначе
		Результат = НСтр("ru = 'Электронный документооборот (ЭДО)'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Обработчик события при подключении услуги "Маркировка"
// Параметры:
//  ВызовПриНачалеРаботыСистемы - Булево - Вызов при начале работы системы
Процедура ПриПодключенииУслугиМаркировка(ВызовПриНачалеРаботыСистемы = Ложь) Экспорт
	
	//@skip-check module-nstr-camelcase
	Комментарий = НСтр("ru='Начало обработки ПриПодключенииУслугиМаркировка'");
	ЗаписьЖурналаРегистрации(ИмяСобытияЖР(), УровеньЖурналаРегистрации.Информация,,, Комментарий);
	
	УстановитьПривилегированныйРежим(Истина);
	Константы.ИспользоватьГосИС.Установить(Истина);
	
	РасписаниеРегламентныхЗаданий = РасписаниеРегламентныхЗаданий();
	
	Для Каждого КлючИЗначение Из РасписаниеРегламентныхЗаданий Цикл
		
		МетаданныеЗадания = КлючИЗначение.Ключ;
		ПараметрыОтбора   = Новый Структура;
		ПараметрыОтбора.Вставить("Метаданные", МетаданныеЗадания.Имя);
		
		Задания = РегламентныеЗаданияСервер.НайтиЗадания(ПараметрыОтбора);
		
		Если Задания.Количество() Тогда
			
			ИдентификаторЗадания = Задания[0].УникальныйИдентификатор;
			ПараметрыЗадания = Новый Структура;
			ПараметрыЗадания.Вставить("Расписание",    КлючИЗначение.Значение);
			ПараметрыЗадания.Вставить("Использование", Истина);
			РегламентныеЗаданияСервер.ИзменитьЗадание(ИдентификаторЗадания, ПараметрыЗадания);
			
		Иначе
			
			ПараметрыЗадания = Новый Структура;
			ПараметрыЗадания.Вставить("Метаданные",    МетаданныеЗадания);
			ПараметрыЗадания.Вставить("Использование", Истина);
			ПараметрыЗадания.Вставить("Наименование",  МетаданныеЗадания.Синоним);
			ПараметрыЗадания.Вставить("Ключ",          Строка(Новый УникальныйИдентификатор));
			ПараметрыЗадания.Вставить("Расписание",    КлючИЗначение.Значение);
			
			РегламентныеЗаданияСервер.ДобавитьЗадание(ПараметрыЗадания);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ВызовПриНачалеРаботыСистемы Тогда
		ПараметрыОповещения = ТарификацияКЭДОКлиентСервер.ПараметрыОповещенияОбИзмененииСпискаУслуг();
		ПараметрыОповещения.Заголовок              = ПредставлениеКонфигурации();
		ПараметрыОповещения.ИспользоватьМаркировку = Истина;
		
		СерверныеОповещения.ОтправитьСерверноеОповещение(
			ТарификацияКЭДОКлиентСервер.ИмяСерверногоОповещенияИзмененияСпискаУслуг(),
			ПараметрыОповещения,
			Неопределено,
			Истина);
	КонецЕсли;
	
	//@skip-check module-nstr-camelcase
	Комментарий = НСтр("ru='Конец обработки ПриПодключенииУслугиМаркировка'");
	ЗаписьЖурналаРегистрации(ИмяСобытияЖР(), УровеньЖурналаРегистрации.Информация,,, Комментарий);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

// Обработчик события при отключении услуги "Маркировка"
// 
// Параметры:
//  ВызовПриНачалеРаботыСистемы - Булево - Вызов при начале работы системы
Процедура ПриОтключенииУслугиМаркировка(ВызовПриНачалеРаботыСистемы = Ложь) Экспорт
	
	//@skip-check module-nstr-camelcase
	Комментарий = НСтр("ru='Начало обработки ПриОтключенииУслугиМаркировка'");
	ЗаписьЖурналаРегистрации(ИмяСобытияЖР(), УровеньЖурналаРегистрации.Информация,,, Комментарий);
	
	УстановитьПривилегированныйРежим(Истина);
	Константы.ИспользоватьГосИС.Установить(Ложь);
	
	РасписаниеРегламентныхЗаданий = РасписаниеРегламентныхЗаданий();
	
	Для Каждого КлючИЗначение Из РасписаниеРегламентныхЗаданий Цикл
		
		МетаданныеЗадания = КлючИЗначение.Ключ;
		ПараметрыОтбора   = Новый Структура;
		ПараметрыОтбора.Вставить("Метаданные", МетаданныеЗадания.Имя);
		
		Задания = РегламентныеЗаданияСервер.НайтиЗадания(ПараметрыОтбора);
		
		Если Задания.Количество() Тогда
			ИдентификаторЗадания = Задания[0].УникальныйИдентификатор;
			ПараметрыЗадания = Новый Структура;
			ПараметрыЗадания.Вставить("Использование", Ложь);
			РегламентныеЗаданияСервер.ИзменитьЗадание(ИдентификаторЗадания, ПараметрыЗадания);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ВызовПриНачалеРаботыСистемы Тогда
		ПараметрыОповещения = ТарификацияКЭДОКлиентСервер.ПараметрыОповещенияОбИзмененииСпискаУслуг();
		ПараметрыОповещения.Заголовок = ПредставлениеКонфигурации();
		
		СерверныеОповещения.ОтправитьСерверноеОповещение(
			ТарификацияКЭДОКлиентСервер.ИмяСерверногоОповещенияИзмененияСпискаУслуг(),
			ПараметрыОповещения,
			Неопределено,
			Истина);
	КонецЕсли;
	
	//@skip-check module-nstr-camelcase
	Комментарий = НСтр("ru='Конец обработки ПриОтключенииУслугиМаркировка'");
	ЗаписьЖурналаРегистрации(ИмяСобытияЖР(), УровеньЖурналаРегистрации.Информация,,, Комментарий);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

// Обработчик события при подключении услуги "ЛегкийКлиентЭДО'"
// Параметры:
//  ВызовПриНачалеРаботыСистемы - Булево - Вызов при начале работы системы
Процедура ПриПодключенииУслугиЛегкийКлиентЭДО(ВызовПриНачалеРаботыСистемы = Ложь) Экспорт
	
	//@skip-check module-nstr-camelcase
	Комментарий = НСтр("ru='Начало обработки ПриПодключенииУслугиЛегкийКлиентЭДО'");
	ЗаписьЖурналаРегистрации(ИмяСобытияЖР(), УровеньЖурналаРегистрации.Информация,,, Комментарий);
	
	УстановитьПривилегированныйРежим(Истина);   
	
	НастройкиКлиентЭДО.НастроитьПриложениеЭлектронныйДокументооборот();
	ТребуетсяОбновлениеИнтерфейса = Ложь;
	КлиентЭДОВызовСервера.НастроитьИнтерфейс(Ложь, ТребуетсяОбновлениеИнтерфейса);
					
	//@skip-check module-nstr-camelcase
	Комментарий = НСтр("ru='Конец обработки ПриПодключенииУслугиЛегкийКлиентЭДО'");
	ЗаписьЖурналаРегистрации(ИмяСобытияЖР(), УровеньЖурналаРегистрации.Информация,,, Комментарий);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

// Обработчик события при отключении услуги "ЛегкийКлиентЭДО"
// 
// Параметры:
//  ВызовПриНачалеРаботыСистемы - Булево - Вызов при начале работы системы
