// См. ОбщегоНазначенияПереопределяемый.ПриДобавленииПараметровРаботыКлиента
Процедура ПриДобавленииПараметровРаботыКлиента(Параметры) Экспорт
	
	ИмяПараметраПредставлениеКонфигурации      = ТарификацияКЭДОКлиентСервер.ИмяПараметраПредставлениеКонфигурации();
	ИмяПараметраТребуетсяИзменитьПредставление = ТарификацияКЭДОКлиентСервер.ИмяПараметраТребуетсяИзменитьЗаголовокПриложения();
	
	Параметры.Вставить(
		ИмяПараметраПредставлениеКонфигурации,
		ПредставлениеКонфигурации());
	Параметры.Вставить(
		ИмяПараметраТребуетсяИзменитьПредставление,
		Ложь);
	
КонецПроцедуры

// См. ОбщегоНазначенияПереопределяемый.ПриДобавленииПараметровРаботыКлиентаПриЗапуске
Процедура ПриДобавленииПараметровРаботыКлиентаПриЗапуске(Параметры) Экспорт
	
	ИмяПараметраПредставлениеКонфигурации      = ТарификацияКЭДОКлиентСервер.ИмяПараметраПредставлениеКонфигурации();
	ИмяПараметраТребуетсяИзменитьПредставление = ТарификацияКЭДОКлиентСервер.ИмяПараметраТребуетсяИзменитьЗаголовокПриложения();
	
	Параметры.Вставить(
		ИмяПараметраПредставлениеКонфигурации,
		ПредставлениеКонфигурации());
	ТребуетсяЗаменитьПредставлениеКонфигурации = НастройкиКлиентЭДО.ИспользуетсяЛегкийКлиентЭДО();
	Параметры.Вставить(ИмяПараметраТребуетсяИзменитьПредставление, ТребуетсяЗаменитьПредставлениеКонфигурации);
	
КонецПроцедуры

// См. ТарификацияПереопределяемый.ПриФормированииСпискаУслуг
Процедура ПриФормированииСпискаУслуг(ПоставщикиУслуг) Экспорт
	
	УслугиКЭДО = Новый Массив;
	
	Услуга = Новый Структура;
	Услуга.Вставить("Идентификатор", ИдентификаторУслугиМаркировка());
	Услуга.Вставить("Наименование",  НСтр("ru = 'Маркировка'"));
	Услуга.Вставить("ТипУслуги",     Перечисления.ТипыУслуг.Безлимитная);
	//@skip-check typed-value-adding-to-untyped-collection
	УслугиКЭДО.Добавить(Услуга);

	Услуга = Новый Структура;
	Услуга.Вставить("Идентификатор", ИдентификаторУслугиЛегкийКлиентЭДО());
	Услуга.Вставить("Наименование",  НСтр("ru = 'Легкий Клиент ЭДО'"));
	Услуга.Вставить("ТипУслуги",     Перечисления.ТипыУслуг.Безлимитная);
	//@skip-check typed-value-adding-to-untyped-collection
	УслугиКЭДО.Добавить(Услуга);	
	
	НовыйПоставщикКЭДО = Новый Структура;
	НовыйПоставщикКЭДО.Вставить("Идентификатор", ИдентификаторПоставщикаКЭДО());
	НовыйПоставщикКЭДО.Вставить("Наименование",  НСтр("ru = '1С:ЭДО'"));
	НовыйПоставщикКЭДО.Вставить("Услуги",        УслугиКЭДО);
	
	ПоставщикиУслуг.Добавить(НовыйПоставщикКЭДО);
	
КонецПроцедуры

