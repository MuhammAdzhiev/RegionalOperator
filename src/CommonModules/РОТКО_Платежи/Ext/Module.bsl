// Назначение модуля: Проверка существования платежей по внешнему идентификатору.
// Проверяет, существует ли другой платеж с указанным внешним идентификатором; при редактировании исключает текущий документ.
// Параметры:
//   Идентификатор - внешний уникальный идентификатор платежа.
//   ИсключаемаяСсылка - документ, который не следует учитывать при поиске дубликата.
// Возвращаемое значение:
//   Булево — Истина, если найден другой платеж с тем же идентификатором.
Функция ЕстьПлатежПоИдентификатору(Идентификатор, ИсключаемаяСсылка = Неопределено) Экспорт
	
	Идентификатор = СокрЛП(Идентификатор);
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ИсключаемаяСсылка = Неопределено Тогда
		ИсключаемаяСсылка = Документы.ПлатежТКО.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	П.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПлатежТКО КАК П
	|ГДЕ
	|	П.ИдентификаторПлатежа = &Идентификатор
	|	И П.Ссылка <> &ИсключаемаяСсылка";
	
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Запрос.УстановитьПараметр("ИсключаемаяСсылка", ИсключаемаяСсылка);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции
