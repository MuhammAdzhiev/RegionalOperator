// См. ОбменССайтомПереопределяемый.ЗаписатьДатуНомерЗаказовССайта.
Процедура ЗаписатьДатуНомерЗаказовССайта(ТаблицаЗаказов, ПрикладныеПараметры) Экспорт

	// Подготовим таблицу обновляемых свойств и их значений.
	ЗначенияСвойствДляОбновления = Новый ТаблицаЗначений;
	ЗначенияСвойствДляОбновления.Колонки.Добавить("Свойство",
		Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"));
	ЗначенияСвойствДляОбновления.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка"));

	Для Каждого ТекСтрока Из ТаблицаЗаказов Цикл
		
		Если Не ЗначениеЗаполнено(ПрикладныеПараметры.НомерНаСайте) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПрикладныеПараметры.ДатаНаСайте) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаСвойстваНомер = ЗначенияСвойствДляОбновления.Добавить();
		СтрокаСвойстваНомер.Свойство = ПрикладныеПараметры.НомерНаСайте;
		СтрокаСвойстваНомер.Значение = ТекСтрока.НомерЗаказа;
		
		СтрокаСвойстваДата = ЗначенияСвойствДляОбновления.Добавить();
		СтрокаСвойстваДата.Свойство = ПрикладныеПараметры.ДатаНаСайте;
		СтрокаСвойстваДата.Значение = ТекСтрока.ДатаЗаказа;
		
	КонецЦикла;
	
	УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(ТекСтрока.Заказ, ЗначенияСвойствДляОбновления);
	
КонецПроцедуры

// См. ОбменССайтомПереопределяемый.ПолучитьРанееЗагруженныеДокументы.
Процедура ПолучитьРанееЗагруженныеДокументы(ПрикладныеПараметры, ТаблицаНомераИДатыЗаказов, Результат) Экспорт
	
	НомерНаСайте = ПрикладныеПараметры.НомерНаСайте;
	МассивНомеров = ТаблицаНомераИДатыЗаказов.ВыгрузитьКолонку("НомерЗаказа");
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("МассивНомеров", МассивНомеров);
	Запрос.УстановитьПараметр("НомерНаСайте", НомерНаСайте);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Объект КАК ЗаказПокупателя,
	|	Т.Значение КАК НомерЗаказаНаСайте
	|ПОМЕСТИТЬ втЗаказыССайта
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК Т
	|ГДЕ
	|	Т.Объект ССЫЛКА Документ.ЗаказПокупателя
	|	И Т.Свойство = &НомерНаСайте
	|	И Т.Значение В(&МассивНомеров)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДополнительныеСведения.Объект КАК Заказ,
	|	ИСТИНА КАК ЗаказОтменен
	|ПОМЕСТИТЬ втОтмененныеЗаказы
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ВЫБОР
	|		КОГДА ДополнительныеСведения.Свойство.Имя = ""Отменен""
	|			ТОГДА НЕ ДополнительныеСведения.Значение = ""false""
	|	КОНЕЦ
	|	И ДополнительныеСведения.Объект ССЫЛКА Документ.ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втЗаказыССайта.ЗаказПокупателя КАК ЗаказПокупателя,
	|	втЗаказыССайта.НомерЗаказаНаСайте КАК НомерЗаказаНаСайте,
	|	ЕСТЬNULL(втОтмененныеЗаказы.ЗаказОтменен, ВЫБОР
	|			КОГДА втЗаказыССайта.ЗаказПокупателя.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказов.Отменен)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК НеОбновлятьЗаказ
	|ИЗ
	|	втЗаказыССайта КАК втЗаказыССайта
	|		ЛЕВОЕ СОЕДИНЕНИЕ втОтмененныеЗаказы КАК втОтмененныеЗаказы
	|		ПО втЗаказыССайта.ЗаказПокупателя = втОтмененныеЗаказы.Заказ";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
КонецПроцедуры

// См. ОбменССайтомПереопределяемый.РеквизитыЗаказаНаСайте.
Процедура РеквизитыЗаказаНаСайте(ДокСсылка, УзелОбмена, ДанныеССайта) Экспорт

	ДанныеССайта = Неопределено;
	
	СвойствоДатаНаСайте = Неопределено;
	СвойствоНомерНаСайте = Неопределено;
	
	СохраненныеПараметры = УзелОбмена.ПараметрыПрикладногоРешения.Получить();
	ПрикладныеПараметры = СохраненныеПараметры.ПараметрыПрикладногоРешения;

	ЗапрашиваемыеСвойства = Новый Массив;
	Если ПрикладныеПараметры.Свойство("ДатаНаСайте") Тогда
		СвойствоДатаНаСайте = ПрикладныеПараметры.ДатаНаСайте;
		ЗапрашиваемыеСвойства.Добавить(СвойствоДатаНаСайте);
	КонецЕсли;
	
	Если ПрикладныеПараметры.Свойство("НомерНаСайте") Тогда
		СвойствоНомерНаСайте = ПрикладныеПараметры.НомерНаСайте;
		ЗапрашиваемыеСвойства.Добавить(СвойствоНомерНаСайте);
	КонецЕсли;
	
	Если ЗапрашиваемыеСвойства.Количество() Тогда
		ЗначенияСвойств = УправлениеСвойствами.ЗначенияСвойств(ДокСсылка, Ложь,, ЗапрашиваемыеСвойства);
	
		Если ЗначенияСвойств.Количество() Тогда
			ДанныеССайта = Новый Структура;
			ДанныеССайта.Вставить("НомерЗаказаНаСайте", "");
			ДанныеССайта.Вставить("ДатаЗаказаНаСайте",  Дата(1, 1, 1));
			
			Для Каждого СтрокаЗначения Из ЗначенияСвойств Цикл
				Если СтрокаЗначения.Свойство = СвойствоНомерНаСайте Тогда
					ДанныеССайта.НомерЗаказаНаСайте = СтрокаЗначения.Значение;
				Иначе
					ДанныеССайта.ДатаЗаказаНаСайте = СтрокаЗначения.Значение;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры 

// Метод выполняет проверку значения режима замещения 
// Если таковой указан как системное перечисление "РежимЗамещения", то выполняет его приведение к типу Булево.
Процедура АдаптироватьЗначениеЗамещенияРегистра(Замещение) Экспорт
	
	ВерсияБСП = СтандартныеПодсистемыСервер.ВерсияБиблиотеки();
	
	ЭтаВерсияНижеБСП_3_1_11 = (ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияБСП, "3.1.11.0") <= 0);
	Если ЭтаВерсияНижеБСП_3_1_11
		ИЛИ Замещение = Неопределено
		ИЛИ ТипЗнч(Замещение) = Тип("Булево") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	МодульОбщегоНазначения = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначения");
	
	Если МодульОбщегоНазначения = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ЭтоРасширенныйРежимЗамещения = МодульОбщегоНазначения.ЭтоЗамещениеНабораЗаписей(Замещение)
		ИЛИ МодульОбщегоНазначения.ЭтоОбновлениеНабораЗаписей(Замещение)
		ИЛИ МодульОбщегоНазначения.ЭтоСлияниеНабораЗаписей(Замещение)
		ИЛИ МодульОбщегоНазначения.ЭтоУдалениеНабораЗаписей(Замещение);
	
	Если ЭтоРасширенныйРежимЗамещения = Истина Тогда
		
		Замещение = Истина;
		Возврат;
		
	КонецЕсли;
	
	Замещение = Ложь;
	
КонецПроцедуры

#КонецОбласти