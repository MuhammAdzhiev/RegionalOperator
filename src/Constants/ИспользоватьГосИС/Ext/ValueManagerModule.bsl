
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// При записи константы
// 
// Параметры:
//  Отказ - Булево - Отказ
Процедура ПриЗаписи(Отказ)
	
	НачатьТранзакцию();
	Попытка
		
		УстановитьПривилегированныйРежим(Истина);
		
		УстановитьЗначенияЗависимыхКонстант(Значение);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьЗначенияЗависимыхКонстант(Значение)
	
	Константы.ВестиУчетМаркируемойПродукцииИСМП.Установить(Значение);
	Константы.ВестиУчетПодконтрольныхТоваровВЕТИС.Установить(Значение);
	Константы.ВестиСведенияДляДекларацийПоАлкогольнойПродукции.Установить(Значение);
	Константы.ИспользоватьПодключаемоеОборудование.Установить(Значение);
	Константы.ИспользоватьФоновуюПроверкуДокументовГИСМТ.Установить(Значение);
	Константы.ИспользоватьПроверкуСтатусовДокументовВГИСМТ.Установить(Значение);
	Константы.ИспользоватьАвтоматическоеУдалениеНеиспользованныхКодовМаркировкиИСМП.Установить(Значение);
	Константы.ИспользоватьАвтоматическуюЗагрузкуСведенийОбОтклоненияхИСМП.Установить(Значение);
	Константы.ИспользоватьАвтоматическуюСверткуРегистраСоответствиеНоменклатурыВЕТИС.Установить(Значение);
	Константы.ИспользоватьАвтоматическуюСверткуРегистраСоответствиеНоменклатурыЕГАИС.Установить(Значение);
	
	Если Значение Тогда
		Константы.ИспользоватьСервисРаботаСНоменклатурой.Установить(Значение);
		Константы.СрокХраненияИспользованныхКодовМаркировки.Установить(30);
		Константы.ИспользоватьДополнительныеРеквизитыИСведения.Установить(Значение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
