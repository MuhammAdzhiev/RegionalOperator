	Рейс.Ссылка,
	Рейс.ТипИсполнителя,
	Рейс.Подрядчик,
	Рейс.ПричинаСрыва
ИЗ
	Документ.Рейс КАК Рейс
ГДЕ
	Рейс.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусРейса.НеВыполнен)</query>
