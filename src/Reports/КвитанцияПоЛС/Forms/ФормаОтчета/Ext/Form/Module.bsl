// Назначение модуля: Формирование и печать квитанции по лицевому счету за выбранный период.
// Получает табличный документ квитанции и выводит его пользователю.
&НаКлиенте
Процедура Печать(Команда)
	
	ТабДок = СформироватьКвитанциюНаСервере();
	ТабДок.Показать(); 
	
КонецПроцедуры
// Собирает начисления, оплаты и итог для печати квитанции по выбранному лицевому счету.
&НаСервере
Функция СформироватьКвитанциюНаСервере() Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
		ВызватьИсключение "Выберите лицевой счет.";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Период) Тогда
		ВызватьИсключение "Выберите период.";
	КонецЕсли;
	
	ДатаНачала = НачалоМесяца(Период);
	ДатаОкончания = КонецМесяца(Период);
	// 1. Начислено и оплачено за период
	Запрос1 = Новый Запрос;
	Запрос1.Текст =
	"ВЫБРАТЬ
	|	СУММА(Взаиморасчеты.НачисленоОборот) КАК Начислено,
	|	СУММА(Взаиморасчеты.ОплаченоОборот) КАК Оплачено
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыТКО.Обороты(&ДатаНачала, &ДатаОкончания, , ЛицевойСчет = &ЛицевойСчет) КАК Взаиморасчеты";
	
	Запрос1.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос1.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос1.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	Результат1 = Запрос1.Выполнить().Выбрать();
	
	Начислено = 0;
	Оплачено = 0;
	
	Если Результат1.Следующий() Тогда
		Если Результат1.Начислено <> Неопределено Тогда
			Начислено = Результат1.Начислено;
		КонецЕсли;
		Если Результат1.Оплачено <> Неопределено Тогда
			Оплачено = Результат1.Оплачено;
		КонецЕсли;
	КонецЕсли;
	// 2. Остаток долга на конец периода
	Запрос2 = Новый Запрос;
	Запрос2.Текст =
	"ВЫБРАТЬ
	|	Взаиморасчеты.НачисленоОстаток КАК НачисленоОстаток,
	|	Взаиморасчеты.ОплаченоОстаток КАК ОплаченоОстаток
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыТКО.Остатки(&ДатаОкончания, ЛицевойСчет = &ЛицевойСчет) КАК Взаиморасчеты";
	
	Запрос2.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос2.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	Результат2 = Запрос2.Выполнить().Выбрать();
	
	Долг = 0;
	
	Если Результат2.Следующий() Тогда
		НачисленоОстаток = 0;
		ОплаченоОстаток = 0;
		
		Если Результат2.НачисленоОстаток <> Неопределено Тогда
			НачисленоОстаток = Результат2.НачисленоОстаток;
		КонецЕсли;
		
		Если Результат2.ОплаченоОстаток <> Неопределено Тогда
			ОплаченоОстаток = Результат2.ОплаченоОстаток;
		КонецЕсли;
		
		Долг = НачисленоОстаток - ОплаченоОстаток;
	КонецЕсли;
	
	КОплате = ?(Долг > 0, Долг, 0);
	// 3. Печатная форма
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	Макет = ОтчетОбъект.ПолучитьМакет("ПФ_Квитанция");
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОтображатьСетку = Ложь;
	
	Область = Макет.ПолучитьОбласть("Область");
	
	Область.Параметры.ЛС = ЛицевойСчет;
	Область.Параметры.Потребитель = ЛицевойСчет.Потребитель;
	Область.Параметры.Адрес = ЛицевойСчет.ОбъектНедвижимости;
	Область.Параметры.Период = Формат(Период, "ДФ='MMMM yyyy'");
	Область.Параметры.Начислено = Начислено;
	Область.Параметры.Оплачено = Оплачено;
	Область.Параметры.Долг = Долг;
	Область.Параметры.КОплате = КОплате;
	Область.Параметры.ДатаФормирования = ТекущаяДата();
	
	ТабДок.Вывести(Область);
	
	Возврат ТабДок;
	
КонецФункции