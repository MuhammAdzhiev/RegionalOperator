		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Рейс.Дата КАК Дата,
	Рейс.Смена КАК Смена,
	Рейс.Город КАК Город,
	Рейс.Зона КАК Зона,
	Рейс.ТипИсполнителя КАК ТипИсполнителя,
	РейсТочкиМаршрута.Площадка КАК Площадка,
	РейсТочкиМаршрута.ПланОбъемМ3 КАК ПланОбъемМ3,
	РейсТочкиМаршрута.ПричинаНевыполнения КАК ПричинаНевыполнения,
	РейсТочкиМаршрута.Комментарий КАК Комментарий,
	Рейс.Ссылка КАК Ссылка,
	Рейс.ТС КАК ТС,
	Рейс.Подрядчик КАК Подрядчик
ИЗ
	Документ.Рейс.ТочкиМаршрута КАК РейсТочкиМаршрута
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Рейс КАК Рейс
		ПО РейсТочкиМаршрута.Ссылка = Рейс.Ссылка
ГДЕ
	РейсТочкиМаршрута.СтатусТочки = ЗНАЧЕНИЕ(Перечисление.СтатусТочкиМаршрута.НеВыполнен)</query>
