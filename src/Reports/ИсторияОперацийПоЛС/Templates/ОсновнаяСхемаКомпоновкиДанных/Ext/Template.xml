		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	НачислениеТКО.Дата КАК Дата,
	НачислениеТКО.ЛицевойСчет КАК ЛицевойСчет,
	НачислениеТКО.ЛицевойСчет.Потребитель КАК Потребитель,
	"Начисление" КАК ВидОперации,
	НачислениеТКО.Сумма КАК Начислено,
	0 КАК Оплачено,
	НачислениеТКО.Основание КАК Основание,
	НачислениеТКО.Ссылка КАК Документ
ИЗ
	Документ.НачислениеТКО КАК НачислениеТКО
ГДЕ
	НачислениеТКО.Проведен
	И НачислениеТКО.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ПлатежТКО.Дата,
	ПлатежТКО.ЛицевойСчет,
	ПлатежТКО.ЛицевойСчет.Потребитель,
	"Платеж",
	0,
	ПлатежТКО.Сумма,
	ПлатежТКО.КаналОплаты,
	ПлатежТКО.Ссылка
ИЗ
	Документ.ПлатежТКО КАК ПлатежТКО
ГДЕ
	ПлатежТКО.Проведен
	И ПлатежТКО.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусПлатежа.Разнесен)
	И ПлатежТКО.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ПерерасчетТКО.Дата,
	ПерерасчетТКО.ЛицевойСчет,
	ПерерасчетТКО.ЛицевойСчет.Потребитель,
	"Перерасчет",
	ПерерасчетТКО.Сумма,
	0,
	ПерерасчетТКО.Основание,
	ПерерасчетТКО.Ссылка
ИЗ
	Документ.ПерерасчетТКО КАК ПерерасчетТКО
ГДЕ
	ПерерасчетТКО.Проведен
	И ПерерасчетТКО.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания</query>
