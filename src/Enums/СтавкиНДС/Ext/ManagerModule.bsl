////////////////////////////////////////////////////////////////////////////////
// Модуль менеджера Перечисление.СтавкиНДС.
//  
////////////////////////////////////////////////////////////////////////////////

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	ДатаПроверки = Неопределено;
	Если Не Параметры.Свойство("Дата", ДатаПроверки) Тогда
		ДатаПроверки = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ДатаВводаСтавкиНДС20 = Дата(2019, 1, 1);
	ДатаВводаСтавкиНДС5_7 = Дата(2025, 1, 1);
	
	Если (ДатаПроверки < ДатаВводаСтавкиНДС20
		ИЛИ ДатаПроверки < ДатаВводаСтавкиНДС5_7) И Не Параметры.Свойство("ПолучатьВсе") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Параметры.Вставить("ПолучатьВсе");
		ДанныеВыбора = ПолучитьДанныеВыбора(Параметры);
		Исключить = Новый Массив;

		Если ДатаПроверки < ДатаВводаСтавкиНДС5_7 Тогда
			Исключить.Добавить(НДС5);
			Исключить.Добавить(НДС7);
			Исключить.Добавить(НДС5_105);
			Исключить.Добавить(НДС7_107);
		КонецЕсли;
		
		Если ДатаПроверки < ДатаВводаСтавкиНДС20 Тогда
			Исключить.Добавить(НДС20);
			Исключить.Добавить(НДС20_120);
		КонецЕсли;
		
		НаУдаление = Новый Массив;
		Для каждого Элемент Из ДанныеВыбора Цикл
			Значение = Элемент.Значение;
			Если ТипЗнч(Значение) = Тип("Структура") Тогда
				Значение = Значение.Значение;
			КонецЕсли;
			Если Исключить.Найти(Значение) <> Неопределено Тогда
				НаУдаление.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
		Для каждого Элемент Из НаУдаление Цикл
			ДанныеВыбора.Удалить(Элемент);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Параметры:
//   ДатаПроверки - Дата
// Возвращаемое значение:
//  Булево - Истина, если ставки 22% и 22/122 начали действовать
Функция ДействуетСтавкаНДС22(ДатаПроверки) Экспорт
	
	ДатаВводаСтавкиНДС22 = Дата(2026, 1, 1);
	Возврат ДатаПроверки >= ДатаВводаСтавкиНДС22;
	
КонецФункции

#КонецОбласти

#КонецЕсли