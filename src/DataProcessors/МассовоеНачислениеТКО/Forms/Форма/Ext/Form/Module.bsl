// Назначение модуля: Форма запуска массового начисления через длительные операции БСП и отображения результата.
// Запускает фоновое начисление и отображает стандартное окно прогресса БСП.
&НаКлиенте
Процедура ВыполнитьНачисление(Команда)
	
	ДлительнаяОперация = НачатьМассовоеНачислениеНаСервере();
	
	Оповещение = Новый ОписаниеОповещения("ПослеМассовогоНачисления", ЭтотОбъект);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект); 
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина; 
	// Проверяем состояние каждые 2 секунды.
	ПараметрыОжидания.Интервал = 2;	
	ПараметрыОжидания.ТекстСообщения = "Выполняется начисление ТКО...";
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры
// Собирает параметры формы и запускает длительную операцию на сервере.
&НаСервере
Функция НачатьМассовоеНачислениеНаСервере()
	
	// Все значения берем из реквизитов формы, имя вызываемой функции фиксировано.
	ПараметрыНачисления = Новый Структура;
	ПараметрыНачисления.Вставить("Период", Объект.Период);
	ПараметрыНачисления.Вставить("Тариф", Объект.Тариф);
	ПараметрыНачисления.Вставить("Город", Объект.Город);
	ПараметрыНачисления.Вставить("ТипПотребителя", Объект.ТипПотребителя);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Массовое начисление ТКО";
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, "РОТКО_МассовоеНачисление.ВыполнитьНачислениеВФоне",
	ПараметрыНачисления);
	
КонецФункции
// Получает итоги фоновой операции и выводит пользователю счетчики и ошибки.
// Параметры:
//   Результат - результат операции либо данные обработки события.
//   ДополнительныеПараметры - дополнительные данные, переданные при запуске фоновой операции.
&НаКлиенте
Процедура ПослеМассовогоНачисления(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Сообщить("Ожидание начисления отменено. Проверьте выполненные операции перед новым запуском.");
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		Сообщить("Сбой массового начисления: " + Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус <> "Выполнено" Тогда
		Сообщить("Операция закончилась со статусом: " + Результат.Статус);
		Возврат;
	КонецЕсли;
	
	Итог = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	
	Если Итог = Неопределено Тогда
		Сообщить("Операция завершена, но результат не удалось получить из временного хранилища.");
		Возврат;
	КонецЕсли;
	
	Сообщить("Массовое начисление завершено. Всего ЛС: " + Строка(Итог.Всего) + ", создано: " + Строка(Итог.Создано)
	+ ", уже начислено: " + Строка(Итог.Пропущено) + ", ошибок: " + Строка(Итог.Ошибок) + ".");
	
	Для Каждого ОшибкаЛС Из Итог.ПротоколОшибок Цикл
		Сообщить(ОшибкаЛС);
	КонецЦикла;
	
	Если Итог.Ошибок > Итог.ПротоколОшибок.Количество() Тогда
		Сообщить("Показаны первые " + Строка(Итог.ПротоколОшибок.Количество())
		+ " ошибок. Полный протокол — в журнале регистрации, событие РОТКО.МассовоеНачисление.");
	КонецЕсли;
	
КонецПроцедуры
