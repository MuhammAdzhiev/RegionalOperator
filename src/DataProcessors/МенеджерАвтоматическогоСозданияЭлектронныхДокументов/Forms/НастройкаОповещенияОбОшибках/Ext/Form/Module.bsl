
#Область ОписаниеПеременных

&НаКлиенте
Перем РодительУдаленногоЭлемента;

&НаКлиенте
Перем Закрытие;

&НаКлиенте
Перем ТекстОшибкиЗаполненияУчетнойЗаписи;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ОтображатьПодсказки", ОтображатьПодсказки);
	Элементы.ГруппаПодсказка.Видимость = ОтображатьПодсказки;
	
	ЗагрузитьНастройкиОповещения();
	ЗагрузитьНастройкиРаспределения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Закрытие = Ложь;
	
	ПроверитьДанныеРаспределения();
	
	РазвернутьВсеСтрокиДереваРаспределенияОтветственности();
	ПерейтиНаВыбраннуюСтраницу();
	
	Если ПоУмолчанию Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность И Не Закрытие Тогда
		Отказ = Истина;
		Если ЗавершениеРаботы Тогда
			ПодключитьОбработчикОжидания("ПередЗакрытиемПродолжение", 1, Истина);
			
		Иначе
			ПередЗакрытиемПродолжение();
			
		КонецЕсли;
	Иначе
		Оповестить("ИзмененыНастройкиОповещенияОбОшибках");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемПродолжение() Экспорт
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, "Данные были изменены. Сохранить изменения?", 
		РежимДиалогаВопрос.ДаНетОтмена);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Если СохранитьНастройкиОповещенияОбОшибкахИРаспределенияОтветственности() Тогда
			Модифицированность = Ложь;
			Закрыть();
		КонецЕсли;
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		Закрытие = Истина;
		Закрыть();
	КонецЕсли;
	
	Оповестить("ИзмененыНастройкиОповещенияОбОшибках");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВариантГруппировкиПриИзменении(Элемент)
	
	ОценкаПроизводительностиКлиент.ЗамерВремени(
		"Обработка.МенеджерАвтоматическогоСозданияЭлектронныхДокументов.Форма.НастройкаОповещенияОбОшибках.ПереходМеждуВкладкамиНастроекРаспределения");
	
	// В текущий момент "ВариантГруппировки" - это выбранный вариант,
	//  но для синхронизации нужно обойти предыдущий вариант.
	ВариантыГруппировок = ВариантыГруппировок();
	Если ВариантГруппировки = ВариантыГруппировок.ПоОрганизациям Тогда
		СинхронизироватьДеревьяРаспределения("РаспределениеПоОрганизациям", "РаспределениеПоАдресатам", 
			ВариантыГруппировок.ПоАдресатам);
		ПроверитьДанныеРаспределения();
		
	Иначе
		СинхронизироватьДеревьяРаспределения("РаспределениеПоАдресатам", "РаспределениеПоОрганизациям", 
			ВариантыГруппировок.ПоОрганизациям);
		ПроверитьДанныеРаспределения();
		
	КонецЕсли;
	
	РазвернутьВсеСтрокиДереваРаспределенияОтветственности();
	ПерейтиНаВыбраннуюСтраницу();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРаспределения

&НаКлиенте
Процедура РаспределениеПоАдресатамЗначениеПриИзменении(Элемент)
	
	ДанныеСтроки = Элементы.РаспределениеПоАдресатам.ТекущиеДанные;
	ПроверитьЗаполнениеДанныхВСтрокеРаспределения(ДанныеСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеПоАдресатамПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ПроверитьДанныеРаспределения();
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеПоОрганизациямЗначениеПриИзменении(Элемент)
	
	ДанныеСтроки = Элементы.РаспределениеПоОрганизациям.ТекущиеДанные;
	ПроверитьЗаполнениеДанныхВСтрокеРаспределения(ДанныеСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеПоОрганизациямПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ПроверитьДанныеРаспределения();
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеПоАдресатамПередУдалением(Элемент, Отказ)
	
	ЗапомнитьРодителяУдаляемогоЭлемента();
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеПоАдресатамПослеУдаления(Элемент)
	
	Если Не РодительУдаленногоЭлемента = Неопределено Тогда
		ОбновитьОписаниеГруппировкиПоАдресатам(РодительУдаленногоЭлемента);
	КонецЕсли;
	ПроверитьДанныеРаспределения();
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеПоОрганизациямПередУдалением(Элемент, Отказ)
	
	ИдентификаторСтрокиВсеОрганизации = Неопределено;
	СтрокиПоОрганизациям = РаспределениеПоОрганизациям.ПолучитьЭлементы();
	Для Каждого Строка Из СтрокиПоОрганизациям Цикл
		Если Не ЗначениеЗаполнено(Строка.Значение) Тогда
			ИдентификаторСтрокиВсеОрганизации = Строка.ПолучитьИдентификатор();
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ВыделенныеСтрокиПоОрганизациям = Элементы.РаспределениеПоОрганизациям.ВыделенныеСтроки;
	Если ВыделенныеСтрокиПоОрганизациям.Найти(ИдентификаторСтрокиВсеОрганизации) <> Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Удалять строку ""<Все организации>"" запрещено.'"));
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеПоОрганизациямПослеУдаления(Элемент)
	
	ПроверитьДанныеРаспределения();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьОрганизацию(Команда)
	
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("Значение", ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка"));
	ДанныеСтроки.Вставить("Тип", ТипыСтрокиНастроек().Организация);
	ДанныеСтроки.Вставить("ИндексКартинки", 1);
	
	ДобавитьОрганизациюВДеревоРаспределения(ДанныеСтроки);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПользователя(Команда)
	
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("Значение", ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка"));
	ДанныеСтроки.Вставить("Тип", ТипыСтрокиНастроек().Пользователь);
	ДанныеСтроки.Вставить("ИндексКартинки", 2);
	
	ДобавитьАдресатаВДеревоРаспределения(ДанныеСтроки);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЭлектроннуюПочту(Команда)
	
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("Значение", "");
	ДанныеСтроки.Вставить("Тип", ТипыСтрокиНастроек().ЭлектроннаяПочта);
	ДанныеСтроки.Вставить("ИндексКартинки", 0);
	
	ДобавитьАдресатаВДеревоРаспределения(ДанныеСтроки);
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	Если СохранитьНастройкиОповещенияОбОшибкахИРаспределенияОтветственности() Тогда
		
		Закрытие = Истина;
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	
	СохранитьНастройкиОповещенияОбОшибкахИРаспределенияОтветственности();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция СохранитьНастройкиОповещенияОбОшибкахИРаспределенияОтветственности() 
	
	ОценкаПроизводительностиКлиент.ЗамерВремени(
		"Обработка.МенеджерАвтоматическогоСозданияЭлектронныхДокументов.Форма.НастройкаОповещенияОбОшибках.СохранениеНастроек");
	
	Успех = Ложь;
	
	ПроверитьУчетнуюЗаписьОтправителя();
	
	ОшибкиЗаполненияДанныхРаспределения = Ложь;
	ПроверитьДанныеРаспределения(ОшибкиЗаполненияДанныхРаспределения);
	
	Если ОшибкаЗаполненияУчетнойЗаписи Или ОшибкиЗаполненияДанныхРаспределения Тогда
		Если ОшибкаЗаполненияУчетнойЗаписи Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиЗаполненияУчетнойЗаписи,
				ЭлектроннаяПочтаОтправителяОповещенийОбОшибках, "ЭлектроннаяПочтаОтправителяОповещенийОбОшибках");
		КонецЕсли;
		Если ОшибкиЗаполненияДанныхРаспределения Тогда
			ТекстСообщения = НСтр("ru = 'Необходимо исправить ошибки заполнения данных распределения.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
	Иначе
		НастройкиОповещенияОбОшибках = Новый Структура;
		НастройкиОповещенияОбОшибках.Вставить("ЭлектроннаяПочтаОтправителяОповещенийОбОшибках",
			ЭлектроннаяПочтаОтправителяОповещенийОбОшибках);
		НастройкиОповещенияОбОшибках.Вставить("ВариантГруппировки", ВариантГруппировки);
		
		ОпределитьВидимостьПодсказки();
		
		ОписаниеОшибки = "";
		Если СохранитьНастройкиОповещенияОбОшибкахИРаспределенияОтветственностиНаСервере(НастройкиОповещенияОбОшибках, ОписаниеОшибки) Тогда
			Модифицированность = Ложь;
			Успех = Истина;
		Иначе
			ПоказатьПредупреждение(, ОписаниеОшибки);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Успех;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьДанныеРаспределения(ОшибкиЗаполненияДанныхРаспределения = Ложь) 
	
	Если ВариантГруппировки = ВариантыГруппировок().ПоОрганизациям Тогда
		ПроверитьДанныеРаспределенияРекурсивно(ЭтаФорма.РаспределениеПоОрганизациям.ПолучитьЭлементы(),
			Истина, ОшибкиЗаполненияДанныхРаспределения, Истина);
			
		Если РаспределениеПоОрганизациям.ПолучитьЭлементы().Количество() = 1 Тогда
			Если РаспределениеПоОрганизациям.ПолучитьЭлементы()[0].ПолучитьЭлементы().Количество() = 0 Тогда
				ОшибкиЗаполненияДанныхРаспределения = Истина;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ПроверитьДанныеРаспределенияРекурсивно(ЭтаФорма.РаспределениеПоАдресатам.ПолучитьЭлементы(), 
			Ложь, ОшибкиЗаполненияДанныхРаспределения, Ложь);
			
		Если РаспределениеПоАдресатам.ПолучитьЭлементы().Количество() = 0 Тогда
			ОшибкиЗаполненияДанныхРаспределения = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьДанныеРаспределенияРекурсивно(ДанныеРаспределения, ПропуститьПервуюСтроку, ОшибкиЗаполненияДанныхРаспределения,
	ГруппировкаПоОрганизациям, РодительскаяСтрока = Истина) 
	
	Для Каждого ДанныеСтроки Из ДанныеРаспределения Цикл
		Если ПропуститьПервуюСтроку Тогда
			ПропуститьПервуюСтроку = Ложь;
		Иначе
			Если РодительскаяСтрока И ГруппировкаПоОрганизациям И ДанныеСтроки.ПолучитьЭлементы().Количество() = 0 Тогда
				ДанныеСтроки.ТекстОшибкиЗаполнения = НСтр("ru = 'Адресаты не указаны'");
				ДанныеСтроки.ОшибкаЗаполнения = Истина;
				ОшибкиЗаполненияДанныхРаспределения = Истина;
			Иначе
				ПроверитьЗаполнениеДанныхВСтрокеРаспределения(ДанныеСтроки, ОшибкиЗаполненияДанныхРаспределения);
			КонецЕсли;
		КонецЕсли;
		ПроверитьДанныеРаспределенияРекурсивно(ДанныеСтроки.ПолучитьЭлементы(), Ложь, ОшибкиЗаполненияДанныхРаспределения,
			ГруппировкаПоОрганизациям, Ложь);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнениеДанныхВСтрокеРаспределения(ДанныеСтроки, ОшибкиЗаполненияДанныхРаспределения = Ложь)
	
	ДанныеСтроки.ТекстОшибкиЗаполнения = "";
	ДанныеСтроки.ОшибкаЗаполнения = Ложь;
	
	ТекстОшибки = "";
	Если ТипЗнч(ДанныеСтроки.Значение) = Тип("Строка") Тогда
		Если Не ОбщегоНазначенияКлиентСервер.АдресЭлектроннойПочтыСоответствуетТребованиям(ДанныеСтроки.Значение) Тогда
			ТекстОшибки = НСтр("ru = 'Адрес электронной почты введен неверно'");
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДанныеСтроки.Значение) = Тип("СправочникСсылка.Организации") Тогда
		Если ДанныеСтроки.Значение.Пустая() Тогда
			ТекстОшибки = НСтр("ru = 'Организация не указана'");
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДанныеСтроки.Значение) = Тип("СправочникСсылка.Пользователи") Тогда
		Если ДанныеСтроки.Значение.Пустая() Тогда
			ТекстОшибки = НСтр("ru = 'Пользователь не указан'");
		КонецЕсли;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ДанныеСтроки.ТекстОшибкиЗаполнения = ТекстОшибки;
		ДанныеСтроки.ОшибкаЗаполнения = Истина;
		ОшибкиЗаполненияДанныхРаспределения = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьУчетнуюЗаписьОтправителя() 
	
	ТекстОшибкиЗаполненияУчетнойЗаписи = "";
	ОшибкаЗаполненияУчетнойЗаписи = Ложь;
	
	Если ЭлектроннаяПочтаОтправителяОповещенийОбОшибках.Пустая() Тогда
		ТекстОшибкиЗаполненияУчетнойЗаписи =
			НСтр("ru = 'Не указана учетная запись электронной почты для отправки оповещений об ошибках.'");
		ОшибкаЗаполненияУчетнойЗаписи = Истина;
		
	ИначеЕсли Не УчетнаяЗаписьОтправителяЗаполнена(ЭлектроннаяПочтаОтправителяОповещенийОбОшибках) Тогда
		ТекстОшибкиЗаполненияУчетнойЗаписи =
			НСтр("ru = 'В указанной учетной записи не заполнен адрес электронной почты.'");
		ОшибкаЗаполненияУчетнойЗаписи = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УчетнаяЗаписьОтправителяЗаполнена(УчетнаяЗапись) 
	Возврат ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "АдресЭлектроннойПочты"));
КонецФункции

&НаСервере
Функция ПроверитьЗаполнениеЭлектроннойПочтыПользователей() 
	
	Результат = Истина;
	Если ВариантГруппировки = ВариантыГруппировок().ПоОрганизациям Тогда
		ДанныеРаспределения = РаспределениеПоОрганизациям.ПолучитьЭлементы();
	Иначе
		ДанныеРаспределения = РаспределениеПоАдресатам.ПолучитьЭлементы();
	КонецЕсли;
	ТипыСтрокиНастроек = ТипыСтрокиНастроек();
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	Для Каждого СтрокаГруппировка Из ДанныеРаспределения Цикл
		Если СтрокаГруппировка.Тип = ТипыСтрокиНастроек.Пользователь Тогда
			Если Не ОбъектНаСервере.ЭлектроннаяПочтаЗаполнена(СтрокаГруппировка.Значение) Тогда
				СтрокаГруппировка.ОшибкаЗаполнения = Истина;
				СтрокаГруппировка.ТекстОшибкиЗаполнения = 
					НСтр("ru = 'Ни у пользователя, ни у физ. лица пользователя не указан адрес электронной почты.'");
					
				Результат = Ложь;
			КонецЕсли;
		КонецЕсли;
		Для Каждого СтрокаДетализация Из СтрокаГруппировка.ПолучитьЭлементы() Цикл
			Если СтрокаДетализация.Тип = ТипыСтрокиНастроек.Пользователь Тогда
				Если Не ОбъектНаСервере.ЭлектроннаяПочтаЗаполнена(СтрокаДетализация.Значение) Тогда
					СтрокаДетализация.ОшибкаЗаполнения = Истина;
					СтрокаДетализация.ТекстОшибкиЗаполнения = 
						НСтр("ru = 'Ни у пользователя, ни у физ. лица пользователя не указан адрес электронной почты.'");
						
					Результат = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СохранитьНастройкиОповещенияОбОшибкахИРаспределенияОтветственностиНаСервере(НастройкиОповещенияОбОшибках, ОписаниеОшибки) 
	
	Результат = Ложь;
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	Если Не ПроверитьЗаполнениеЭлектроннойПочтыПользователей() Тогда
		ОписаниеОшибки = НСтр("ru = 'Необходимо исправить ошибки заполнения данных распределения.'");
		Возврат Результат;
	КонецЕсли;
	
	// Настройки оповещения об ошибках
	ОбъектНаСервере.СохранитьНастройкиОповещенияОбОшибках(НастройкиОповещенияОбОшибках);
	
	// Настройки распределения ответственности
	Если ВариантГруппировки = ВариантыГруппировок().ПоОрганизациям Тогда
		ИмяДереваИсточника = "РаспределениеПоОрганизациям";
	Иначе
		ИмяДереваИсточника = "РаспределениеПоАдресатам";
	КонецЕсли;
	
	ДеревоИсточник = РеквизитФормыВЗначение(ИмяДереваИсточника);
	ТаблицаРаспределения = ТаблицаИзДереваРаспределения(ДеревоИсточник, ВариантГруппировки, Истина);
	
	Результат = ОбъектНаСервере.СохранитьНастройкиРаспределенияОтветственности(ТаблицаРаспределения, 
		ОписаниеОшибки);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПерейтиНаВыбраннуюСтраницу() 
	
	Элементы.Страницы.ТекущаяСтраница = Элементы[ВариантГруппировки];
	
КонецПроцедуры

&НаКлиенте
Процедура ПеревестиСтрокуДереваРаспределенияВРежимРедактирования(ИмяДерева, Строка) 
	
	Элементы[ИмяДерева].ТекущаяСтрока = Строка.ПолучитьИдентификатор();
	Элементы[ИмяДерева].ИзменитьСтроку();
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсеСтрокиДереваРаспределенияОтветственности()
	
	ИмяДерева = ?(ВариантГруппировки = ВариантыГруппировок().ПоОрганизациям, "РаспределениеПоОрганизациям", 
		"РаспределениеПоАдресатам");
	Для Каждого Строка Из ЭтотОбъект[ИмяДерева].ПолучитьЭлементы() Цикл
		Элементы[ИмяДерева].Развернуть(Строка.ПолучитьИдентификатор(), Истина);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапомнитьРодителяУдаляемогоЭлемента() 
	
	ТекущиеДанные = Элементы.РаспределениеПоАдресатам.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РодительУдаленногоЭлемента = ТекущиеДанные.ПолучитьРодителя();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОписаниеГруппировкиПоАдресатам(ТекущийРодитель) 
	
	ТекущийРодитель.ВсеОрганизации = Не ТекущийРодитель.ПолучитьЭлементы().Количество();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройкиОповещения() 
	
	НастройкиОповещенияОбОшибках = РеквизитФормыВЗначение("Объект").НастройкиОповещенияОбОшибках();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОповещенияОбОшибках);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройкиРаспределения() 
	
	ВариантыГруппировок = ВариантыГруппировок();
	
	ТаблицаРаспределения = РеквизитФормыВЗначение("Объект").НастройкиРаспределенияОтветственности();
	Если ВариантГруппировки = ВариантыГруппировок.ПоОрганизациям Тогда
		СинхронизироватьДеревьяРаспределения("РаспределениеПоОрганизациям", "РаспределениеПоАдресатам", 
			ВариантыГруппировок.ПоОрганизациям, ТаблицаРаспределения);
		
	Иначе
		СинхронизироватьДеревьяРаспределения("РаспределениеПоАдресатам", "РаспределениеПоОрганизациям", 
			ВариантыГруппировок.ПоАдресатам, ТаблицаРаспределения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СинхронизироватьДеревьяРаспределения(ИмяДереваПриемника, ИмяДереваИсточника, ГруппировкаРаспределения, 
	Знач ТаблицаРаспределения = Неопределено) 
	
	ВариантыГруппировок = ВариантыГруппировок();
	ТипыСтрокиНастроек = ТипыСтрокиНастроек();
	
	Если ТаблицаРаспределения = Неопределено Тогда
		ДеревоИсточник = РеквизитФормыВЗначение(ИмяДереваИсточника);
		ТаблицаРаспределения = ТаблицаИзДереваРаспределения(ДеревоИсточник, ГруппировкаРаспределения);
		
	КонецЕсли;
	
	Если ВариантГруппировки = ВариантыГруппировок.ПоОрганизациям
		И НужноДобавитьСтрокуВсеОрганизации(ТаблицаРаспределения, ВариантГруппировки) Тогда
		
		ДобавитьСтрокуТаблицыРаспределения(ТаблицаРаспределения, Справочники.Организации.ПустаяСсылка(), "", Ложь);
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Если ВариантГруппировки = ВариантыГруппировок.ПоОрганизациям Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВременнаяТаблица.Организация КАК Организация,
		|	ВременнаяТаблица.Ответственный КАК Ответственный
		|ПОМЕСТИТЬ ТаблицаРаспределения
		|ИЗ
		|	&ВременнаяТаблица КАК ВременнаяТаблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаРаспределения.Организация КАК Организация,
		|	ТаблицаРаспределения.Ответственный КАК Ответственный,
		|	ВЫБОР
		|		КОГДА ТаблицаРаспределения.Организация = &ОрганизацияПустаяСсылка
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК Приоритет
		|ИЗ
		|	ТаблицаРаспределения КАК ТаблицаРаспределения
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет
		|ИТОГИ ПО
		|	Организация";
		
	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВременнаяТаблица.Организация КАК Организация,
		|	ВременнаяТаблица.Ответственный КАК Ответственный
		|ПОМЕСТИТЬ ТаблицаРаспределения
		|ИЗ
		|	&ВременнаяТаблица КАК ВременнаяТаблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаРаспределения.Ответственный КАК Ответственный,
		|	ТаблицаРаспределения.Организация КАК Организация
		|ИЗ
		|	ТаблицаРаспределения КАК ТаблицаРаспределения
		|ИТОГИ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Организация)
		|ПО
		|	Ответственный";
		
	КонецЕсли;
	Запрос.УстановитьПараметр("ВременнаяТаблица", ТаблицаРаспределения); 
	Запрос.УстановитьПараметр("ОрганизацияПустаяСсылка", Справочники.Организации.ПустаяСсылка()); 
	
	ДеревоПриемник = РеквизитФормыВЗначение(ИмяДереваПриемника);
	ДеревоПриемник.Строки.Очистить();
	
	ВыборкаГруппировка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаГруппировка.Следующий() Цикл
		Если ВариантГруппировки = ВариантыГруппировок.ПоОрганизациям Тогда
			СтрокаГруппировка = ДобавитьСтрокуДереваРаспределения(ДеревоПриемник, ВыборкаГруппировка.Организация, 
				ТипыСтрокиНастроек.Организация, 1);
			
		Иначе
			Ответственный = ВыборкаГруппировка.Ответственный;
			Если ТипЗнч(ВыборкаГруппировка.Ответственный) = Тип("СправочникСсылка.Пользователи") Тогда
				СтрокаГруппировка = ДобавитьСтрокуДереваРаспределения(ДеревоПриемник, Ответственный, 
					ТипыСтрокиНастроек.Пользователь, 2);
				
			ИначеЕсли СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ВыборкаГруппировка.Ответственный) Тогда
				Ответственный = XMLЗначение(Тип("СправочникСсылка.Пользователи"), ВыборкаГруппировка.Ответственный);
				СтрокаГруппировка = ДобавитьСтрокуДереваРаспределения(ДеревоПриемник, Ответственный, 
					ТипыСтрокиНастроек.Пользователь, 2);
				
			Иначе
				СтрокаГруппировка = ДобавитьСтрокуДереваРаспределения(ДеревоПриемник, Ответственный, 
					ТипыСтрокиНастроек.ЭлектроннаяПочта, 0);
				
			КонецЕсли;
		КонецЕсли;
		
		ВыборкаДетальныеЗаписи = ВыборкаГруппировка.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВариантГруппировки = ВариантыГруппировок.ПоОрганизациям Тогда
				Если ПустаяСтрока(ВыборкаДетальныеЗаписи.Ответственный) Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТипЗнч(ВыборкаДетальныеЗаписи.Ответственный) = Тип("СправочникСсылка.Пользователи") Тогда
					ДобавитьСтрокуДереваРаспределения(СтрокаГруппировка, ВыборкаДетальныеЗаписи.Ответственный, 
						ТипыСтрокиНастроек.Пользователь, 2);
					
				ИначеЕсли СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ВыборкаДетальныеЗаписи.Ответственный) Тогда
					Ответственный = XMLЗначение(Тип("СправочникСсылка.Пользователи"), ВыборкаДетальныеЗаписи.Ответственный);
					ДобавитьСтрокуДереваРаспределения(СтрокаГруппировка, Ответственный, 
						ТипыСтрокиНастроек.Пользователь, 2);
					
				Иначе
					ДобавитьСтрокуДереваРаспределения(СтрокаГруппировка, ВыборкаДетальныеЗаписи.Ответственный, 
						ТипыСтрокиНастроек.ЭлектроннаяПочта, 0);
					
				КонецЕсли;
			Иначе
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Организация) Тогда
					ДобавитьСтрокуДереваРаспределения(СтрокаГруппировка, ВыборкаДетальныеЗаписи.Организация, 
						ТипыСтрокиНастроек.Организация, 1);
					
				Иначе
					СтрокаГруппировка.ВсеОрганизации = Истина;
					Если ВыборкаГруппировка.Организация > 1 Тогда
						СтрокаГруппировка = ДобавитьСтрокуДереваРаспределения(ДеревоПриемник, Ответственный, 
							ТипыСтрокиНастроек.Пользователь, 2);
						
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоПриемник, ИмяДереваПриемника);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТаблицаИзДереваРаспределения(ДеревоРаспределения, ГруппировкаРаспределения, ПередЗаписью = Ложь) 
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	
	Если ПередЗаписью Тогда
		Типы = Новый Массив;
		Типы.Добавить(Тип("Строка"));
		Типы.Добавить(Тип("СправочникСсылка.Пользователи"));
		
		Результат.Колонки.Добавить("Ответственный", Новый ОписаниеТипов(Типы));
		
	Иначе
		Результат.Колонки.Добавить("Ответственный", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(300)));
		
	КонецЕсли;
	
	ОрганизацииПустаяСсылка = Справочники.Организации.ПустаяСсылка();
	ВариантыГруппировок = ВариантыГруппировок();
	
	Для Каждого СтрокаОсновная Из ДеревоРаспределения.Строки Цикл
		Если СтрокаОсновная.Строки.Количество() Тогда
			Если ГруппировкаРаспределения = ВариантыГруппировок.ПоОрганизациям Тогда
				Для Каждого СтрокаВложенная Из СтрокаОсновная.Строки Цикл
					ДобавитьСтрокуТаблицыРаспределения(Результат, СтрокаОсновная.Значение, СтрокаВложенная.Значение, ПередЗаписью);
					
				КонецЦикла;
			Иначе
				Для Каждого СтрокаВложенная Из СтрокаОсновная.Строки Цикл
					ДобавитьСтрокуТаблицыРаспределения(Результат, СтрокаВложенная.Значение, СтрокаОсновная.Значение, ПередЗаписью);
					
				КонецЦикла;
			КонецЕсли;
		Иначе
			Если ГруппировкаРаспределения = ВариантыГруппировок.ПоАдресатам Тогда
				ДобавитьСтрокуТаблицыРаспределения(Результат, ОрганизацииПустаяСсылка, СтрокаОсновная.Значение, ПередЗаписью);
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьСтрокуТаблицыРаспределения(ТаблицаРаспределения, Организация, Знач Ответственный, ПередЗаписью) 
	
	Если Не ПередЗаписью И ЗначениеЗаполнено(Ответственный) Тогда
		Ответственный = ?(ТипЗнч(Ответственный) = Тип("Строка"), Ответственный, XMLСтрока(Ответственный));
		
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Организация", Организация);
	ПараметрыОтбора.Вставить("Ответственный", Ответственный);
	
	ЕстьТакаяСтрока = ТаблицаРаспределения.НайтиСтроки(ПараметрыОтбора).Количество();
	Если ЕстьТакаяСтрока Или (ПередЗаписью И Не ЗначениеЗаполнено(Ответственный)) Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = ТаблицаРаспределения.Добавить();
	НоваяСтрока.Организация = Организация;
	НоваяСтрока.Ответственный = Ответственный;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДобавитьСтрокуДереваРаспределения(ДеревоРаспределения, Значение, Тип, ИндексКартинки) 
	
	Результат = ДеревоРаспределения.Строки.Добавить();
	Результат.Значение = Значение;
	Результат.Тип = Тип;
	Результат.ИндексКартинки = ИндексКартинки;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция НужноДобавитьСтрокуВсеОрганизации(ТаблицаРаспределения, ВариантГруппировки)
	
	Результат = ТаблицаРаспределения.Найти(Справочники.Организации.ПустаяСсылка(), "Организация") = Неопределено;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьОрганизациюВДеревоРаспределения(ДанныеСтроки)
	
	ТипыСтрокиНастроек = ТипыСтрокиНастроек();
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаГруппировкаПоОрганизациям Тогда
		ТекущиеДанные = РаспределениеПоОрганизациям.ПолучитьЭлементы();
		
		ИмяДереваРаспределения = "РаспределениеПоОрганизациям";
		ЕстьКолонкаВсеОрганизации = Ложь;
		
	Иначе
		ТекущиеДанные = Элементы.РаспределениеПоАдресатам.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
			
		ИначеЕсли ТекущиеДанные.Тип = ТипыСтрокиНастроек.Организация Тогда
			ТекущиеДанные = ТекущиеДанные.ПолучитьРодителя().ПолучитьЭлементы();
			
		Иначе
			ТекущиеДанные = ТекущиеДанные.ПолучитьЭлементы();
			
		КонецЕсли;
		
		ИмяДереваРаспределения = "РаспределениеПоАдресатам";
		ЕстьКолонкаВсеОрганизации = Истина;
		
	КонецЕсли;
	
	НоваяСтрока = ТекущиеДанные.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтроки);
	
	Если ЕстьКолонкаВсеОрганизации Тогда
		НоваяСтрока.ПолучитьРодителя().ВсеОрганизации = Ложь;
		
	КонецЕсли;
	
	ПеревестиСтрокуДереваРаспределенияВРежимРедактирования(ИмяДереваРаспределения, НоваяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьАдресатаВДеревоРаспределения(ДанныеСтроки)
	
	ТипыСтрокиНастроек = ТипыСтрокиНастроек();
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаГруппировкаПоОрганизациям Тогда
		ТекущиеДанные = Элементы.РаспределениеПоОрганизациям.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
			
		ИначеЕсли ТекущиеДанные.Тип <> ТипыСтрокиНастроек.Организация Тогда
			ТекущиеДанные = ТекущиеДанные.ПолучитьРодителя().ПолучитьЭлементы();
			
		Иначе
			ТекущиеДанные = ТекущиеДанные.ПолучитьЭлементы();
			
		КонецЕсли;
		
		ИмяДереваРаспределения = "РаспределениеПоОрганизациям";
		ЕстьКолонкаВсеОрганизации = Ложь;
		
	Иначе
		ТекущиеДанные = РаспределениеПоАдресатам.ПолучитьЭлементы();
		ИмяДереваРаспределения = "РаспределениеПоАдресатам";
		ЕстьКолонкаВсеОрганизации = Истина;
		
	КонецЕсли;
	
	НоваяСтрока = ТекущиеДанные.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтроки);
	
	Если ЕстьКолонкаВсеОрганизации Тогда
		НоваяСтрока.ВсеОрганизации = Истина;
		
	КонецЕсли;
	
	ПеревестиСтрокуДереваРаспределенияВРежимРедактирования(ИмяДереваРаспределения, НоваяСтрока);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТипыСтрокиНастроек() 
	ИсходнаяСтруктура = Новый Структура;
	
	ИсходнаяСтруктура.Вставить("ЭлектроннаяПочта", "ЭлектроннаяПочта");
	ИсходнаяСтруктура.Вставить("Пользователь", "Пользователь");
	ИсходнаяСтруктура.Вставить("Организация", "Организация");
	
	Результат = Новый ФиксированнаяСтруктура(ИсходнаяСтруктура);
	
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВариантыГруппировок() 
	
	ИсходнаяСтруктура = Новый Структура;
	ИсходнаяСтруктура.Вставить("ПоОрганизациям", "СтраницаГруппировкаПоОрганизациям");
	ИсходнаяСтруктура.Вставить("ПоАдресатам", "СтраницаГруппировкаПоАдресатам");
	
	Результат = Новый ФиксированнаяСтруктура(ИсходнаяСтруктура);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОпределитьВидимостьПодсказки() 
	
	Если Не ОтображатьПодсказки Тогда
		Возврат;
	КонецЕсли;
	
	Если ВариантГруппировки = ВариантыГруппировок().ПоОрганизациям Тогда
		Если РаспределениеПоОрганизациям.ПолучитьЭлементы().Количество() = 1 Тогда
			Элементы.ГруппаПодсказка.Видимость = 
				РаспределениеПоОрганизациям.ПолучитьЭлементы()[0].ПолучитьЭлементы().Количество() = 0;
		Иначе
			Элементы.ГруппаПодсказка.Видимость = Ложь;
		КонецЕсли;
	Иначе
		Элементы.ГруппаПодсказка.Видимость = РаспределениеПоАдресатам.ПолучитьЭлементы().Количество() = 0;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
