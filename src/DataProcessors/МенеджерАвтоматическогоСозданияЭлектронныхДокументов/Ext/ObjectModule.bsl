Процедура ДополнитьТекстПисьма(ТекстПисьма, Ошибка, ПараметрыПубликацииИБ) 
	
	ВнешняяСсылкаНаДокумент = "";
	Если ПустаяСтрока(ПараметрыПубликацииИБ.Адрес) Тогда
		Шаблон =
		"%1<h3>%2:</h3>
		|<pre>%3</pre>
		|%4";
		
		ТекстПисьма = СтрШаблон(Шаблон, ТекстПисьма, Ошибка.УчетныйДокументСтрокой,
			Ошибка.ОписаниеОшибки, Символы.ПС);
		
	Иначе
		Шаблон =
		"%1<h3><a href=""%2"">%3:</a></h3>
		|<pre>%4</pre>
		|%5";
		ВнешняяСсылкаНаДокумент = НавигационнаяСсылкаДляУведомления(Ошибка.УчетныйДокумент, ПараметрыПубликацииИБ);
		ТекстПисьма = СтрШаблон(Шаблон, ТекстПисьма, ВнешняяСсылкаНаДокумент, Ошибка.УчетныйДокументСтрокой,
			Ошибка.ОписаниеОшибки, Символы.ПС);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыПубликацииИнформационнойБазы() 
	
	Результат = Новый Структура("Адрес,ЭтоВебПубликация", "", Ложь);
	
	АдресИБВИнтернет = ОбщегоНазначения.АдресПубликацииИнформационнойБазыВИнтернете();
	АдресИБВЛокальнойСети = ОбщегоНазначения.АдресПубликацииИнформационнойБазыВЛокальнойСети();
	
	Если ЗначениеЗаполнено(АдресИБВИнтернет) Тогда
		Результат.Адрес = СокрЛП(АдресИБВИнтернет);
		Результат.ЭтоВебПубликация = Истина;
	ИначеЕсли ЗначениеЗаполнено(АдресИБВЛокальнойСети) Тогда
		Результат.Адрес = СокрЛП(АдресИБВЛокальнойСети);
		Результат.ЭтоВебПубликация = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НавигационнаяСсылкаДляУведомления(Ссылка, ПараметрыПубликацииИБ)
	
	АдресПубликацииИБ = ПараметрыПубликацииИБ.Адрес;
	Если ПараметрыПубликацииИБ.ЭтоВебПубликация И Прав(АдресПубликацииИБ, 1)<> "/" Тогда
		АдресПубликацииИБ = ПараметрыПубликацииИБ.Адрес + "/";
	КонецЕсли;
		
	Возврат АдресПубликацииИБ + "#" + ПолучитьНавигационнуюСсылку(Ссылка);
	
КонецФункции

Функция СозданиеЭлектронныхДокументовВключено() 
	
	Результат = Константы.СоздаватьЭлектронныеДокументыАвтоматически.Получить();
	Возврат Результат;
	
КонецФункции

Функция ИнициализироватьТаблицуОшибок()
	
	Результат = Новый ТаблицаЗначений;
	
	ТипДокументы = ИнтеграцияЭДО.ОписаниеТиповОснованийЭлектронныхДокументов();
	
	Результат.Колонки.Добавить("УчетныйДокумент", ТипДокументы);
	
	ТипОрганизация = Новый ОписаниеТипов("СправочникСсылка.Организации");
	Результат.Колонки.Добавить("Организация", ТипОрганизация);
	
	ТипХеш = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(20));
	Результат.Колонки.Добавить("ХешОшибки", ТипХеш);
	
	ТипОписаниеОшибки = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(1000));
	Результат.Колонки.Добавить("ОписаниеОшибки", ТипОписаниеОшибки);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьСтрокуОшибки(ТаблицаОшибок, УчетныйДокумент, Организация, ОписаниеОшибки)
	
	НоваяСтрока = ТаблицаОшибок.Добавить();
	НоваяСтрока.УчетныйДокумент = УчетныйДокумент;
	НоваяСтрока.Организация = Организация;
	НоваяСтрока.ОписаниеОшибки = ОписаниеОшибки;
	НоваяСтрока.ХешОшибки = ОбщегоНазначенияБЭД.Хеш_MD5_64(ОписаниеОшибки);
	
КонецПроцедуры

Процедура ЗафиксироватьРезультатОтправкиОповещения(ОповещениеОтправлено, ОтправленныеОшибки)
	
	Для Каждого Ошибка Из ОтправленныеОшибки Цикл
		МенеджерЗаписи = РегистрыСведений.ОшибкиСозданияЭлектронныхДокументов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.УчетныйДокумент = Ошибка.УчетныйДокумент;
		МенеджерЗаписи.ХешОшибки = Ошибка.ХешОшибки;
		МенеджерЗаписи.ОповещениеОтправлено = ОповещениеОтправлено;
		МенеджерЗаписи.ОписаниеОшибки = Ошибка.ОписаниеОшибки;
		
		МенеджерЗаписи.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьИсправленнуюОшибку(УчетныйДокумент, ХешОшибки)
	
	Набор = РегистрыСведений.ОшибкиСозданияЭлектронныхДокументов.СоздатьНаборЗаписей();
	Набор.Отбор.УчетныйДокумент.Установить(УчетныйДокумент);
	Набор.Отбор.ХешОшибки.Установить(ХешОшибки);
	Набор.Записать();
	
КонецПроцедуры

Функция СформироватьИОтправитьПисьмо(УчетнаяЗапись, Адресат, ТекстПисьма)
	
	Результат = Ложь;
	
	ПараметрыПисьма = Новый Структура();
	ПараметрыПисьма.Вставить("Кому", Адресат);
	ПараметрыПисьма.Вставить("Тема", НСтр("ru = 'Клиент ЭДО: При создании электронных документов произошли ошибки.'"));
	ПараметрыПисьма.Вставить("Тело", ТекстПисьма);
	ПараметрыПисьма.Вставить("ТипТекста", "HTML");
	
	Письмо = РаботаСПочтовымиСообщениями.ПодготовитьПисьмо(УчетнаяЗапись, ПараметрыПисьма);
	
	Попытка
		РезультатОтправки = РаботаСПочтовымиСообщениями.ОтправитьПисьмо(УчетнаяЗапись, Письмо);
		Если Не РезультатОтправки.ОшибочныеПолучатели.Количество() Тогда
			Результат = Истина;
			
		КонецЕсли;
	Исключение
		ИнфоОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		СведенияОСобытии = СведенияОСобытииЖурналаРегистрации();
		ЗаписьЖурналаРегистрации(СведенияОСобытии.Имя, УровеньЖурналаРегистрации.Ошибка, СведенияОСобытии.Метаданные,, ИнфоОшибки);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция СведенияОСобытииЖурналаРегистрации() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Имя", НСтр("ru = 'Менеджер автосоздания электронных документов'"));
	Результат.Вставить("Метаданные", Метаданные.Обработки.МенеджерАвтоматическогоСозданияЭлектронныхДокументов);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли

