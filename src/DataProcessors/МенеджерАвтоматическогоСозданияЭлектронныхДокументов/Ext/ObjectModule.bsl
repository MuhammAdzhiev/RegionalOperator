			НастройкиОповещения.ЭлектроннаяПочтаОтправителяОповещенийОбОшибках);
		Результат.Вставить("ВариантГруппировки", НастройкиОповещения.ВариантГруппировки);
		
	Иначе
		Результат.Вставить("ПоУмолчанию", Истина);
		Результат.Вставить("ЭлектроннаяПочтаОтправителяОповещенийОбОшибках",
			Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты);
		Результат.Вставить("ВариантГруппировки", "СтраницаГруппировкаПоОрганизациям");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НастройкиРаспределенияОтветственности() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОтветственныеЗаОшибкиСозданияЭлектронныхДокументов.Организация КАК Организация,
	|	ОтветственныеЗаОшибкиСозданияЭлектронныхДокументов.Ответственный КАК Ответственный,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ПользователиКонтактнаяИнформация.АдресЭП, """") = """"
	|				И ЕСТЬNULL(ФизическиеЛицаКонтактнаяИнформация.АдресЭП, """") = """"
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЭлектроннаяПочтаЗаполнена
	|ИЗ
	|	РегистрСведений.ОтветственныеЗаОшибкиСозданияЭлектронныхДокументов КАК ОтветственныеЗаОшибкиСозданияЭлектронныхДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|			ПО Пользователи.Ссылка = ПользователиКонтактнаяИнформация.Ссылка
	|				И (ПользователиКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailПользователя))
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
	|			ПО Пользователи.ФизическоеЛицо = ФизическиеЛицаКонтактнаяИнформация.Ссылка
	|				И (ФизическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailФизлица))
	|		ПО ОтветственныеЗаОшибкиСозданияЭлектронныхДокументов.Ответственный = Пользователи.Ссылка";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Функция СохранитьНастройкиОповещенияОбОшибках(НастройкиОповещенияОбОшибках) Экспорт
	
	Константы.НастройкиОповещенияОбОшибках.Установить(Новый ХранилищеЗначения(НастройкиОповещенияОбОшибках));
	
КонецФункции

Функция СохранитьНастройкиРаспределенияОтветственности(ТаблицаРаспределения, ОписаниеОшибки) Экспорт
	
	Результат = Ложь;
	
	НачатьТранзакцию();
	
	Набор = РегистрыСведений.ОтветственныеЗаОшибкиСозданияЭлектронныхДокументов.СоздатьНаборЗаписей();
	Набор.Загрузить(ТаблицаРаспределения);
	
	Попытка
		Набор.Записать(Истина);
		Результат = Истина;
		
		Если ТаблицаРаспределения.Количество() = 0 Тогда
			Константы.СоздаватьЭлектронныеДокументыАвтоматически.Установить(Ложь);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОписаниеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОтменитьТранзакцию();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ЭлектроннаяПочтаЗаполнена(ВыбранныйПользователь) Экспорт
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ПользователиКонтактнаяИнформация.АдресЭП, """") КАК ЭлектроннаяПочтаПользователя,
	|	ЕСТЬNULL(ФизическиеЛицаКонтактнаяИнформация.АдресЭП, """") КАК ЭлектроннаяПочтаФизлица
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|		ПО Пользователи.Ссылка = ПользователиКонтактнаяИнформация.Ссылка
	|			И (ПользователиКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailПользователя))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
	|		ПО Пользователи.ФизическоеЛицо = ФизическиеЛицаКонтактнаяИнформация.Ссылка
	|			И (ФизическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailФизлица))
	|ГДЕ
	|	Пользователи.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ВыбранныйПользователь);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		
		Если Ложь
			Или Не ПустаяСтрока(ВыборкаДетальныеЗаписи.ЭлектроннаяПочтаПользователя)
			Или Не ПустаяСтрока(ВыборкаДетальныеЗаписи.ЭлектроннаяПочтаФизлица)
			Тогда
			
			Результат = Истина;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

