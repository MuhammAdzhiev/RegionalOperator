
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает состояние настройки оповещений об ошибках.
Функция НастройкиОповещенияОбОшибкахВыполнены() Экспорт
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиОповещенияОбОшибках.Значение КАК Значение
	|ИЗ
	|	Константа.НастройкиОповещенияОбОшибках КАК НастройкиОповещенияОбОшибках
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОтветственныеЗаОшибкиСозданияЭлектронныхДокументов.Ответственный КАК Ответственный
	|ИЗ
	|	РегистрСведений.ОтветственныеЗаОшибкиСозданияЭлектронныхДокументов КАК ОтветственныеЗаОшибкиСозданияЭлектронныхДокументов
	|ГДЕ
	|	ВЫБОР
	|			КОГДА НЕ ОтветственныеЗаОшибкиСозданияЭлектронныхДокументов.Ответственный ПОДОБНО """"
	|					И НЕ ОтветственныеЗаОшибкиСозданияЭлектронныхДокументов.Ответственный = &ПользователиПустаяСсылка
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ПользователиПустаяСсылка", Справочники.Пользователи.ПустаяСсылка());
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатПакет = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	НастройкиОповещенияВыполнены = Ложь;
	
	РезультатНастройкиОповещения = РезультатПакет[0];
	Если Не РезультатНастройкиОповещения.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатНастройкиОповещения.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		
		НастройкиОповещения = ВыборкаДетальныеЗаписи.Значение.Получить();
		Если ТипЗнч(НастройкиОповещения) = Тип("Структура") Тогда
			НастройкиОповещенияВыполнены = Истина;
			
		КонецЕсли;
	КонецЕсли;
	
	РезультатНастройкиРаспределения = РезультатПакет[1];
	
	НастройкиРаспределенияВыполнены = Ложь;
	
	РезультатНастройкиРаспределения = РезультатПакет[1];
	Если Не РезультатНастройкиРаспределения.Пустой() Тогда
		НастройкиРаспределенияВыполнены = Истина;
		
	КонецЕсли;
	
	Возврат НастройкиОповещенияВыполнены И НастройкиРаспределенияВыполнены;
	
КонецФункции

// Возвращает результат успеха создания электронных документов и в случае неудачи - 
//  отправку оповещений об ошибках.
//
// Возвращаемое значение:
//  Булево - результат успеха создания электронных документов.
Функция СоздатьЭлектронныеДокументы() Экспорт
	
	Результат = Ложь;
	Если Не СозданиеЭлектронныхДокументовВключено() Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Инициализируем таблицу ошибок.
	ТаблицаОшибок = ИнициализироватьТаблицуОшибок();
	
	// Выберем учетные документы.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СостоянияПоОбъектамУчетаЭДО.СсылкаНаОбъект КАК Документ
	|ИЗ
	|	РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияПоОбъектамУчетаЭДО
	|ГДЕ
	|	СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументовЭДО.НеСформирован)
	|	И НЕ СостоянияПоОбъектамУчетаЭДО.СсылкаНаОбъект ССЫЛКА Документ.УдалитьПроизвольныйЭД
	|	И НЕ СостоянияПоОбъектамУчетаЭДО.СсылкаНаОбъект ССЫЛКА Документ.ТранспортныйКонтейнерЭДО
	|	И НЕ СостоянияПоОбъектамУчетаЭДО.СсылкаНаОбъект ССЫЛКА Справочник.НастройкиЭДО
	|	И НЕ СостоянияПоОбъектамУчетаЭДО.СсылкаНаОбъект ССЫЛКА Справочник.УдалитьСоглашенияОбИспользованииЭД";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДокументыОснования = Новый Массив;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДокументыОснования.Добавить(ВыборкаДетальныеЗаписи.Документ);
	КонецЦикла;
	
	// Выполним попытку создания электронных документов.
	Ошибки = ОбменСКонтрагентамиИнтеграция.НовыеЭлектронныеДокументы(ДокументыОснования);
	
	ЗамерОтправкиОповещенийОбОшибках = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(
		"Обработка.МенеджерАвтоматическогоСозданияЭлектронныхДокументов.МодульОбъекта.ОтправкаПисемОбОшибкахСозданияЭлектронныхДокументов");
		
	Для Каждого Ошибка Из Ошибки Цикл
		// Запомним ошибку для последующей обработки.
		ОшибкиДанных = Ошибка.Ошибки.ОшибкиДанных;
		Если ЗначениеЗаполнено(ОшибкиДанных) Тогда		
			Для Каждого ОшибкаЗаполненияДанных Из Ошибка.Ошибки.ОшибкиДанных.ЗаполнениеДанных Цикл
				ДобавитьСтрокуОшибки(ТаблицаОшибок, Ошибка.Документ, Ошибка.Организация, ОшибкаЗаполненияДанных.ТекстОшибки);
			КонецЦикла;
		КонецЕсли; 
	КонецЦикла;
	
	// Отберем только те ошибки, по которым нужно отправить оповещение и определим адресата. А так же
	//  определим ошибки, которые исправили.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаОшибок.УчетныйДокумент КАК УчетныйДокумент,
	|	ТаблицаОшибок.Организация КАК Организация,
	|	ТаблицаОшибок.ХешОшибки КАК ХешОшибки,
	|	ТаблицаОшибок.ОписаниеОшибки КАК ОписаниеОшибки
	|ПОМЕСТИТЬ Ошибки
	|ИЗ
	|	&ТаблицаОшибок КАК ТаблицаОшибок
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	ХешОшибки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОшибки.УчетныйДокумент КАК УчетныйДокумент,
	|	ВТОшибки.Организация КАК Организация,
	|	ВТОшибки.ХешОшибки КАК ХешОшибки,
	|	ВТОшибки.ОписаниеОшибки КАК ОписаниеОшибки
	|ПОМЕСТИТЬ ОшибкиКОтправке
	|ИЗ
	|	Ошибки КАК ВТОшибки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОшибкиСозданияЭлектронныхДокументов КАК ОшибкиСозданияЭлектронныхДокументов
	|		ПО ВТОшибки.УчетныйДокумент = ОшибкиСозданияЭлектронныхДокументов.УчетныйДокумент
	|		И ВТОшибки.ХешОшибки = ОшибкиСозданияЭлектронныхДокументов.ХешОшибки
	|ГДЕ
	|	(ОшибкиСозданияЭлектронныхДокументов.ОповещениеОтправлено ЕСТЬ NULL
	|	ИЛИ НЕ ОшибкиСозданияЭлектронныхДокументов.ОповещениеОтправлено)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОшибкиКОтправке.УчетныйДокумент КАК УчетныйДокумент,
	|	ОшибкиКОтправке.Организация КАК Организация,
	|	ОшибкиКОтправке.ХешОшибки КАК ХешОшибки,
	|	ОшибкиКОтправке.ОписаниеОшибки КАК ОписаниеОшибки,
	|	ОтветственныеЗаОшибкиПоВсемОрганизациям.Ответственный КАК Ответственный
	|ПОМЕСТИТЬ ОшибкиКОтправкеПоОтветственным
	|ИЗ
	|	ОшибкиКОтправке КАК ОшибкиКОтправке
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЗаОшибкиСозданияЭлектронныхДокументов КАК
	|			ОтветственныеЗаОшибкиПоВсемОрганизациям
	|		ПО (ОтветственныеЗаОшибкиПоВсемОрганизациям.Организация = &ОрганизацииПустаяСсылка)
	|ГДЕ
	|	ОтветственныеЗаОшибкиПоВсемОрганизациям.Ответственный ЕСТЬ НЕ NULL
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОшибкиКОтправке.УчетныйДокумент,
	|	ОшибкиКОтправке.Организация,
	|	ОшибкиКОтправке.ХешОшибки,
	|	ОшибкиКОтправке.ОписаниеОшибки,
	|	ОтветственныеЗаОшибкиПоУказаннымОрганизациям.Ответственный
	|ИЗ
	|	ОшибкиКОтправке КАК ОшибкиКОтправке
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЗаОшибкиСозданияЭлектронныхДокументов КАК
	|			ОтветственныеЗаОшибкиПоУказаннымОрганизациям
	|		ПО (ИСТИНА)
	|		И ОшибкиКОтправке.Организация = ОтветственныеЗаОшибкиПоУказаннымОрганизациям.Организация
	|ГДЕ
	|	ОтветственныеЗаОшибкиПоУказаннымОрганизациям.Ответственный ЕСТЬ НЕ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОшибкиКОтправкеПоОтветственным.УчетныйДокумент КАК УчетныйДокумент,
	|	ОшибкиКОтправкеПоОтветственным.Организация КАК Организация,
	|	ОшибкиКОтправкеПоОтветственным.ХешОшибки КАК ХешОшибки,
	|	ОшибкиКОтправкеПоОтветственным.ОписаниеОшибки КАК ОписаниеОшибки,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ОшибкиКОтправкеПоОтветственным.Ответственный) = ТИП(СТРОКА)
	|			ТОГДА ОшибкиКОтправкеПоОтветственным.Ответственный
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК АдресатЭлектроннаяПочта,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ОшибкиКОтправкеПоОтветственным.Ответственный) = ТИП(Справочник.Пользователи)
	|			ТОГДА ОшибкиКОтправкеПоОтветственным.Ответственный
	|		ИНАЧЕ &ПользователиПустаяСсылка
	|	КОНЕЦ КАК АдресатПользователь,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ОшибкиКОтправкеПоОтветственным.Ответственный) = ТИП(Справочник.Пользователи)
	|			ТОГДА ОшибкиКОтправкеПоОтветственным.Ответственный.ФизическоеЛицо
	|		ИНАЧЕ &ФизическиеЛицаПустаяСсылка
	|	КОНЕЦ КАК АдресатФизическоеЛицо
	|ПОМЕСТИТЬ ОшибкиКОтправкеСДетализациейПоТипамОтветственных
	|ИЗ
	|	ОшибкиКОтправкеПоОтветственным КАК ОшибкиКОтправкеПоОтветственным
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА ОшибкиКОтправкеСДетализациейПоТипамОтветственных.АдресатЭлектроннаяПочта <> """"
	|			ТОГДА ОшибкиКОтправкеСДетализациейПоТипамОтветственных.АдресатЭлектроннаяПочта
	|		ИНАЧЕ ВЫБОР
	|			КОГДА ЕСТЬNULL(ПользователиКонтактнаяИнформация.АдресЭП, """") = """"
	|				ТОГДА ЕСТЬNULL(ФизическиеЛицаКонтактнаяИнформация.АдресЭП, """")
	|			ИНАЧЕ ЕСТЬNULL(ПользователиКонтактнаяИнформация.АдресЭП, """")
	|		КОНЕЦ
	|	КОНЕЦ КАК ЭлектроннаяПочта,
	|	ОшибкиКОтправкеСДетализациейПоТипамОтветственных.УчетныйДокумент КАК УчетныйДокумент,
	|	ПРЕДСТАВЛЕНИЕ(ОшибкиКОтправкеСДетализациейПоТипамОтветственных.УчетныйДокумент) КАК УчетныйДокументСтрокой,
	|	ОшибкиКОтправкеСДетализациейПоТипамОтветственных.ХешОшибки КАК ХешОшибки,
	|	ОшибкиКОтправкеСДетализациейПоТипамОтветственных.ОписаниеОшибки КАК ОписаниеОшибки,
	|	ОшибкиКОтправкеСДетализациейПоТипамОтветственных.Организация КАК Организация
	|ИЗ
	|	ОшибкиКОтправкеСДетализациейПоТипамОтветственных КАК ОшибкиКОтправкеСДетализациейПоТипамОтветственных
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|		ПО ОшибкиКОтправкеСДетализациейПоТипамОтветственных.АдресатПользователь = ПользователиКонтактнаяИнформация.Ссылка
	|		И (ПользователиКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailПользователя))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
	|		ПО ОшибкиКОтправкеСДетализациейПоТипамОтветственных.АдресатФизическоеЛицо = ФизическиеЛицаКонтактнаяИнформация.Ссылка
	|		И (ФизическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailФизлица))
	|ИТОГИ
	|ПО
	|	ЭлектроннаяПочта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОшибкиСозданияЭлектронныхДокументов.УчетныйДокумент КАК УчетныйДокумент,
	|	ОшибкиСозданияЭлектронныхДокументов.ХешОшибки КАК ХешОшибки
	|ИЗ
	|	РегистрСведений.ОшибкиСозданияЭлектронныхДокументов КАК ОшибкиСозданияЭлектронныхДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Ошибки КАК Ошибки
	|		ПО ОшибкиСозданияЭлектронныхДокументов.УчетныйДокумент = Ошибки.УчетныйДокумент
	|		И ОшибкиСозданияЭлектронныхДокументов.ХешОшибки = Ошибки.ХешОшибки
	|ГДЕ
	|	Ошибки.ОписаниеОшибки ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ТаблицаОшибок", ТаблицаОшибок);
	Запрос.УстановитьПараметр("ОрганизацииПустаяСсылка", Справочники.Организации.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПользователиПустаяСсылка", Справочники.Пользователи.ПустаяСсылка());
	Запрос.УстановитьПараметр("ФизическиеЛицаПустаяСсылка", Справочники.ФизическиеЛица.ПустаяСсылка());
	
	ТекущаяДата = ТекущаяДатаСеанса();
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	
	РезультатПакет = Запрос.ВыполнитьПакет();
	
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ЗамерОтправкиОповещенийОбОшибках, ТаблицаОшибок.Количество());
	
	// Отправим оповещения.
	РезультатОшибкиКОтправке = РезультатПакет[4];
	Если Не РезультатОшибкиКОтправке.Пустой() Тогда
		НастройкиОтправки = НастройкиОповещенияОбОшибках();
		ПараметрыПубликацииИБ = ПараметрыПубликацииИнформационнойБазы();
		
		ВыборкаОшибкиКОтправке = РезультатОшибкиКОтправке.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаОшибкиКОтправке.Следующий() Цикл
			ОтправленныеОшибки = Новый Массив;
			ТекстПисьма = "";
			
			ВыборкаДетальныеЗаписи = ВыборкаОшибкиКОтправке.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				ДанныеОшибки = Новый Структура;
				ДанныеОшибки.Вставить("УчетныйДокумент", ВыборкаДетальныеЗаписи.УчетныйДокумент);
				ДанныеОшибки.Вставить("ХешОшибки", ВыборкаДетальныеЗаписи.ХешОшибки);
				ДанныеОшибки.Вставить("ОписаниеОшибки", ВыборкаДетальныеЗаписи.ОписаниеОшибки);
				
				ОтправленныеОшибки.Добавить(ДанныеОшибки);
				
				ДополнитьТекстПисьма(ТекстПисьма, ВыборкаДетальныеЗаписи, ПараметрыПубликацииИБ);
				
			КонецЦикла;
			
			ОповещениеОтправлено = СформироватьИОтправитьПисьмо(НастройкиОтправки.ЭлектроннаяПочтаОтправителяОповещенийОбОшибках,
					ВыборкаОшибкиКОтправке.ЭлектроннаяПочта, ТекстПисьма);
			ЗафиксироватьРезультатОтправкиОповещения(ОповещениеОтправлено, ОтправленныеОшибки);
				
		КонецЦикла;
	КонецЕсли;
	
	// Удалим исправленные ошибки.
	РезультатОшибкиКУдалению = РезультатПакет[5];
	Если Не РезультатОшибкиКУдалению.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатОшибкиКУдалению.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			УдалитьИсправленнуюОшибку(ВыборкаДетальныеЗаписи.УчетныйДокумент, ВыборкаДетальныеЗаписи.ХешОшибки);
		
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает результат успеха удаления накопленных ошибок создания электронных документов.
