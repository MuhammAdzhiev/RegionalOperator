		СведенияОСобытии = СведенияОСобытииЖурналаРегистрации();
		ЗаписьЖурналаРегистрации(СведенияОСобытии.Имя, УровеньЖурналаРегистрации.Ошибка, СведенияОСобытии.Метаданные,, ИнфоОшибки);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

