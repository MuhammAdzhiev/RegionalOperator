
#Область Переменные

&НаКлиенте
Перем ТекстУведомленияНастроекОповещенияОбОшибках;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ПользователиИнформационнойБазы.ТекущийПользователь().Имя <> "" Тогда
		Обсуждения = СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована();
	Иначе
		Элементы.Обсуждения.Видимость = Ложь;
	КонецЕсли;
	
	НастроитьОповещенияОбОшибках = "Настроить оповещения об ошибках";
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "РегистрацияВзаимодействия" Тогда
		
		Обсуждения = Параметр;
		
	ИначеЕсли ИмяСобытия = "ИзмененыНастройкиОповещенияОбОшибках" Тогда
		
		НовоеЗначение = НастройкиОповещенияОбОшибкахВыполнены();
		Если НаборКонстант.СоздаватьЭлектронныеДокументыАвтоматически <> НовоеЗначение Тогда
			НаборКонстант.СоздаватьЭлектронныеДокументыАвтоматически = НовоеЗначение;
			ПриИзмененииРеквизита(Элементы.СоздаватьЭлектронныеДокументыАвтоматическиБЭД);
			ТекстУведомленияНастроекОповещенияОбОшибках = СтрШаблон(НСтр("ru = '%1 автоматическое создание электронных документов'"),
				?(НовоеЗначение, "Включено", "Отключено")); 
			ПодключитьОбработчикОжидания("ПоказатьУведомлениеНастроекОповещенияОбОшибках", 0.1, Истина);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИспользоватьСопоставлениеНоменклатурыПриИзменении(Элемент)
	
	Если Не НаборКонстант.ИспользоватьСопоставлениеНоменклатуры
		И УстановленКонтрольСопоставленияНоменклатуры() Тогда
		Контекст = Новый Структура("Элемент", Элемент);
		Оповещение = Новый ОписаниеОповещения("ИзменитьРеквизитПослеВопроса", ЭтотОбъект, Контекст);
		ТекстВопроса = НСтр("ru = 'Номенклатура поставщиков, зарегистрированная к сопоставлению, будет снята с контроля. Продолжить?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ПриИзмененииРеквизита(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбсужденияПриИзменении(Элемент)
	
	НавигационнаяСсылка = "e1cib/command/Обработка.РегистрацияВСистемеВзаимодействия.Команда.РегистрацияВзаимодействий";
	ПерейтиПоНавигационнойСсылке(НавигационнаяСсылка);
	Обсуждения = Не Обсуждения;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНастройкуАвтосозданияЭлектронныхДокументов(Элемент)
	
	Если НаборКонстант.СоздаватьЭлектронныеДокументыАвтоматически Тогда
		Если НастройкиОповещенияОбОшибкахВыполнены() Тогда
			ПриИзмененииРеквизита(Элемент);
		Иначе
			НаборКонстант.СоздаватьЭлектронныеДокументыАвтоматически = Ложь;
			ОткрытьФормуНастроекОповещенийОбОшибках(Истина);
		КонецЕсли;
	Иначе
		Контекст = Новый Структура("Элемент", Элемент);
		Оповещение = Новый ОписаниеОповещения("ОтключитьАвтосозданиеЭлектронныхДокументов", ЭтотОбъект, Контекст);
		ТекстВопроса = НСтр("ru = 'Информация о текущих ошибках создания электронных документов будет удалена. Продолжить?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаОповещенияОбОшибкахНажатие(Элемент)
	
	ОткрытьФормуНастроекОповещенийОбОшибках();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПриИзмененииРеквизита(Элемент, ОбновлятьИнтерфейс = Истина)
	
	КонстантаИмя = ПриИзмененииРеквизитаСервер(Элемент.Имя);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	Если ОбновлятьИнтерфейс Тогда
		ПодключитьОбработчикОжидания("ОбновитьИнтерфейсПрограммы", 0.1, Истина);
	КонецЕсли;
	
	Если КонстантаИмя <> "" Тогда
		Оповестить("Запись_НаборКонстант", Новый Структура, КонстантаИмя);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПриИзмененииРеквизитаСервер(Знач ИмяЭлемента)
	
	РеквизитПутьКДанным = Элементы[ИмяЭлемента].ПутьКДанным;
	
	КонстантаИмя = СохранитьЗначениеРеквизита(РеквизитПутьКДанным);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	Возврат КонстантаИмя;
	
КонецФункции

&НаСервере
Функция СохранитьЗначениеРеквизита(РеквизитПутьКДанным)
	
	// Определение имени константы.
	КонстантаИмя = "";
	Если НРег(Лев(РеквизитПутьКДанным, 14)) = НРег("НаборКонстант.") Тогда
		// Если путь к данным реквизита указан через "НаборКонстант".
		КонстантаИмя = Сред(РеквизитПутьКДанным, 15);
	
	КонецЕсли;
	
	// Сохранения значения константы.
	Если КонстантаИмя <> "" Тогда
		КонстантаМенеджер = Константы[КонстантаИмя];
		КонстантаЗначение = НаборКонстант[КонстантаИмя];
		
		Если КонстантаМенеджер.Получить() <> КонстантаЗначение Тогда
			КонстантаМенеджер.Установить(КонстантаЗначение);
		КонецЕсли;
	КонецЕсли;
	
	Возврат КонстантаИмя;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьИнтерфейсПрограммы()
	
	ОбщегоНазначенияКлиент.ОбновитьИнтерфейсПрограммы();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УстановленКонтрольСопоставленияНоменклатуры()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КонтрольСопоставленияНоменклатурыЭДО.ЭлектронныйДокумент КАК ЭлектронныйДокумент
		|ИЗ
		|	РегистрСведений.КонтрольСопоставленияНоменклатурыЭДО КАК КонтрольСопоставленияНоменклатурыЭДО
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	КонтрольОтраженияВУчетеЭДО.ЭлектронныйДокумент
		|ИЗ
		|	РегистрСведений.КонтрольОтраженияВУчетеЭДО КАК КонтрольОтраженияВУчетеЭДО
		|ГДЕ
		|	КонтрольОтраженияВУчетеЭДО.СопоставитьНоменклатуру";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

&НаКлиенте
Процедура ИзменитьРеквизитПослеВопроса(Результат, Контекст) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		НаборКонстант.ИспользоватьСопоставлениеНоменклатуры = Истина;
		Возврат;
	КонецЕсли;
	
	КонстантаИмя = "";
	ОтключитьИспользованиеСопоставленияНоменклатуры(Контекст.Элемент.Имя, КонстантаИмя);
	
	ОбновитьПовторноИспользуемыеЗначения();
	ПодключитьОбработчикОжидания("ОбновитьИнтерфейсПрограммы", 0.1, Истина);
	Оповестить("Запись_НаборКонстант", Новый Структура, КонстантаИмя);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьАвтосозданиеЭлектронныхДокументов(Ответ, Контекст) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПриИзмененииРеквизита(Контекст.Элемент);
		
	Иначе
		НаборКонстант.СоздаватьЭлектронныеДокументыАвтоматически = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НастройкиОповещенияОбОшибкахВыполнены() 
	
	Менеджер = Обработки.МенеджерАвтоматическогоСозданияЭлектронныхДокументов.Создать();
	Результат = Менеджер.НастройкиОповещенияОбОшибкахВыполнены();
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОтключитьИспользованиеСопоставленияНоменклатуры(Знач ИмяЭлемента, КонстантаИмя)
	
	НачатьТранзакцию();
	Попытка
		
		НаборЗаписей = РегистрыСведений.КонтрольСопоставленияНоменклатурыЭДО.СоздатьНаборЗаписей();
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(НаборЗаписей.Метаданные().ПолноеИмя());
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		НаборЗаписей.Записать();
		
		ПолноеИмяОбъекта = Метаданные.РегистрыСведений.КонтрольОтраженияВУчетеЭДО.ПолноеИмя();
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
		Блокировка.Заблокировать();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтрольОтраженияВУчетеЭДО.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
			|	КонтрольОтраженияВУчетеЭДО.СоздатьУчетныйДокумент КАК СоздатьУчетныйДокумент,
			|	КонтрольОтраженияВУчетеЭДО.ПровестиУчетныйДокумент КАК ПровестиУчетныйДокумент
			|ИЗ
			|	РегистрСведений.КонтрольОтраженияВУчетеЭДО КАК КонтрольОтраженияВУчетеЭДО
			|ГДЕ
			|	КонтрольОтраженияВУчетеЭДО.СопоставитьНоменклатуру";
			
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("ЭлектронныйДокумент", Выборка.ЭлектронныйДокумент);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
			Запись = РегистрыСведений.КонтрольОтраженияВУчетеЭДО.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, Выборка);
			Запись.Записать();
			
		КонецЦикла;
		
		КонстантаИмя = ПриИзмененииРеквизитаСервер(ИмяЭлемента);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		НаборКонстант.ИспользоватьСопоставлениеНоменклатуры = Истина;
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастроекОповещенийОбОшибках(ОтображатьПодсказки = Ложь) 
	
	ОценкаПроизводительностиКлиент.ЗамерВремени(
		"Обработка.МенеджерАвтоматическогоСозданияЭлектронныхДокументов.Форма.НастройкаОповещенияОбОшибках.ОткрытиеФормыНастроек");
	
	ИмяФормаОбработки = "Обработка.МенеджерАвтоматическогоСозданияЭлектронныхДокументов.Форма.НастройкаОповещенияОбОшибках";
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОтображатьПодсказки", ОтображатьПодсказки);
	
	ОткрытьФорму(ИмяФормаОбработки, ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьУведомлениеНастроекОповещенияОбОшибках() Экспорт
	Если Не ПустаяСтрока(ТекстУведомленияНастроекОповещенияОбОшибках) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстУведомленияНастроекОповещенияОбОшибках);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
