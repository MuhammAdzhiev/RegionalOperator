
#Область ОписаниеПеременных

&НаКлиенте
Перем ОбработчикРезультатаЗаявкиТакском, ДействиеОбработкиЗаявкиТакском;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	НастройкиСтартовогоПомощникаКЭДО = КлиентЭДО.ПолучитьНастройкиСтартовогоПомощникаКЭДО();
	
	Если ЗначениеЗаполнено(НастройкиСтартовогоПомощникаКЭДО) Тогда
		
		ЗаполнитьРеквизитыФормыСохраненнымиНастройкамиПомощникаЭДО();
		
	КонецЕсли;
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	ВключеноРазделениеДанных = ОбщегоНазначения.РазделениеВключено();
	
	Если НЕ ВключеноРазделениеДанных Тогда
		ЛогинПарольИПП = ПроверитьПодключениеИнтернетПоддержки();
		Если ЛогинПарольИПП <> Неопределено Тогда
			
			ЛогинИнтернетПоддержки      = ЛогинПарольИПП.Логин;
			ПарольИнтернетПоддержки     = ЛогинПарольИПП.Пароль;
			ПодключенаИнтернетПоддержка = Истина;
			
			ПодключенСервис1СКонтрагент = ПроверитьПодключениеСервиса1СКонтрагентНаТестовыхДанных();
			
		КонецЕсли;
		
		ЛицензионноеСоглашениеКлиентЭДОПринято = Константы.ЛицензионноеСоглашениеПринято.Получить();
		
	Иначе
		ПодключенаИнтернетПоддержка            = Истина;
		ПодключенСервис1СКонтрагент            = Истина;
		ЛицензионноеСоглашениеКлиентЭДОПринято = Истина;
	КонецЕсли;
	
	ЭтоПолноправныйПользователь = Пользователи.ЭтоПолноправныйПользователь( , , Ложь);

	ПолучитьПрограммыЭлектроннойПодписиИШифрования();
	
	ЕстьПравоНаПросмотрЖурналаРегистрации = ПравоДоступа("ЖурналРегистрации", Метаданные);
	
	ТребуетсяРегистрацияБС = (ОбменДокументамиСКонтрагентами И ОбменБезЭЦП) ИЛИ Поставщик ИЛИ Покупатель;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Если НЕ ЗначениеЗаполнено(СертификатЭЦП) И ОбменЭДО И ОбменДокументамиСКонтрагентами Тогда
			
			МассивУстановленныхСертификатовЭЦП = ПроверитьНаличиеУстановленныхСертификатов(Организация, ТекущийПользователь);
			
			Если ЗначениеЗаполнено(МассивУстановленныхСертификатовЭЦП) Тогда
				ДействующиеСертификатыЭЦП.ЗагрузитьЗначения(МассивУстановленныхСертификатовЭЦП);
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(СертификатЭЦП) Тогда
			
			Если СертификатЭЦП.ПолучитьОбъект() = Неопределено Тогда // Сертификат удален пользователем.
				
				СертификатЭЦП = Неопределено;
				ЗаказанНовыйСертификатЭЦП = Ложь;
					
			Иначе
				
				СведенияЗаявления = ПолучитьСтатусЗаявленияНаСертификат(СертификатЭЦП);
				СостояниеСертификатаКриптографии = СведенияЗаявления.СостояниеЗаявления;
				ЗаявлениеУдалено = СведенияЗаявления.ПометкаУдаления;
				
				Если ЗаявлениеУдалено Тогда
					
					СертификатЭЦП = Неопределено;
					ЗаказанНовыйСертификатЭЦП = Ложь;
					
				ИначеЕсли СостояниеСертификатаКриптографии = ПредопределенноеЗначение("Перечисление.СостоянияЗаявленияНаВыпускСертификата.Отправлено") Тогда
					
					ТребуетсяПроверкаСостоянияСертификата = Истина;
					
					НовоеСостояниеСертификата = ПроверитьСостояниеСертификатаКриптографии();
					
					Если ТипЗнч(НовоеСостояниеСертификата) = Тип("ПеречислениеСсылка.СостоянияЗаявленияНаВыпускСертификата") Тогда
						СостояниеСертификатаКриптографии = НовоеСостояниеСертификата;
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ ПропуститьРегистрациюБС И ТребуетсяРегистрацияБС Тогда
			ПодготовитьСтраницуРегистрацииБС();
			ОрганизацияЗарегистрированаВБС = ЕстьРегистрацияОрганизацииВБС(Организация);
		КонецЕсли;
		
	КонецЕсли;
	
	ИспользоватьОбменБизнесСеть = Константы.ИспользоватьОбменБизнесСеть.Получить();
	ИспользоватьСервисЭДО       = Константы.ИспользоватьОбменЭД.Получить();
	
	ЗаполнитьПодключенныхОператоровЭДО();
	
	Если НЕ ЗначениеЗаполнено(ОператорЭДО) Тогда
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Обновление данных из сервиса настроек 1С:ЭДО'");
		
		ДлительнаяОперацияПолученияОператоровЭДО = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"СинхронизацияЭДО.ОбновитьКешиОператоровЭДОИФорматов");
	КонецЕсли;

	СтильШрифтаМелкийШрифтТекста = ШрифтыСтиля.МелкийШрифтТекста;
	
	УстановитьВидимостьДоступностьЭлементовФормы();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НачатьОжиданиеПолученияИдентификаторовЭДО();
	
	ПроверитьУстановкуРасширенияКриптографии();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#Область ОбщиеКоманды

&НаКлиенте
Процедура ГиперссылкаВыходНажатие(Элемент)
	
	ОповещениеЗавершения = Новый ОписаниеОповещения("ОбработатьЗакрытиеПомощника", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.СтартовыйПомощникКЭДО.Форма.ЗакрытиеПомощника", ,
		ЭтотОбъект,,,, ОповещениеЗавершения, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры

&НаКлиенте
Процедура ГиперссылкаНазадНажатие(Элемент)
	
	ПерейтиНаСтраницу();
	
КонецПроцедуры

#КонецОбласти

#Область СтраницаВыборОпций

&НаКлиенте
Процедура ПокупательПриИзменении(Элемент)
	
	ИзменитьОтображениеУсловияСоглашения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоставщикПриИзменении(Элемент)
	
	ИзменитьОтображениеУсловияСоглашения();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбменСКонтрагентамиПриИзменении(Элемент)
	
	Элементы.ОбменБезЭЦП.Доступность = ОбменДокументамиСКонтрагентами;
	Элементы.ОбменЭДО.Доступность    = ОбменДокументамиСКонтрагентами;
	
	Если НЕ ОбменБезЭЦП И НЕ ОбменЭДО И ОбменДокументамиСКонтрагентами Тогда
		ОбменБезЭЦП = Истина;
		ОбменЭДО    = Истина;
	КонецЕсли;
	
	ИзменитьОтображениеУсловияСоглашения();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбменЭДОПриИзменении(Элемент)
	
	ОбменДокументамиСКонтрагентами = ОбменБезЭЦП ИЛИ ОбменЭДО;
	
	ИзменитьСхемуКартинокШагов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбменБезЭЦППриИзменении(Элемент)
	
	ОбменДокументамиСКонтрагентами = ОбменБезЭЦП ИЛИ ОбменЭДО;
	
	ИзменитьОтображениеУсловияСоглашения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодсказкаУсловияОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	Если НавигационнаяСсылкаФорматированнойСтроки = НСтр("ru = 'ПрограммаКлиентЭДО'") Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФорму("Обработка.СтартовыйПомощникКЭДО.Форма.СоглашениеНаИспользованиеПрограммы", ,
			ЭтотОбъект, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СтраницаВходНаПорталИТС

&НаКлиенте
Процедура ГиперссылкаВосстановлениеПароляНажатие(Элемент)
	
	ИнтернетПоддержкаПользователейКлиент.ОткрытьСтраницуВосстановленияПароля();

КонецПроцедуры

&НаКлиенте
Процедура ГиперссылкаРегистрацияНажатие(Элемент)
	
	ИнтернетПоддержкаПользователейКлиент.ОткрытьСтраницуРегистрацииНовогоПользователя();

КонецПроцедуры

&НаКлиенте
Процедура ДекорацияТекстОшибкиИППОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьЖурналРегистрации(НСтр("ru = 'Подключение интернет-поддержки пользователей'"));

КонецПроцедуры

&НаКлиенте
Процедура ЛогинИПарольИнтернетПоддержкиИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Элементы.ДекорацияТекстОшибкиИПП.Заголовок) Тогда
		УстановитьВидимостьПодключенияИПП(Ложь, Элементы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛогинИПарольИнтернетПоддержкиОчистка(Элемент, СтандартнаяОбработка)
	
	УстановитьВидимостьПодключенияИПП(Ложь, Элементы);

КонецПроцедуры

#КонецОбласти

#Область СтраницаЗаполненияОрганизации

&НаКлиенте
Процедура ИННПоискИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	
	ВыполнитьПоискПоИНН(Текст);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияГиперссылкаИзменитьНажатие(Элемент)
	
	ИзменитьСтраницуЗаполненияСведенийОрганизации("СтраницаИзменитьСведенияОрганизации");
	
КонецПроцедуры

&НаКлиенте
Процедура ИННОрганизацииИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	
	ОтключитьОбработчикОжидания("Подключаемый_ОбработатьОшибкуНесоответствияТребованиямИНН");
	ОтключитьОбработчикОжидания("Подключаемый_ОчиститьКППДляИП");
	
	СтрокаИНН = СокрЛП(Текст);
	ДлинаИНН  = СтрДлина(СтрокаИНН);
	
	Если ДлинаИНН = 12 Тогда
		Элементы.КППОрганизации.Доступность = Ложь;
		Элементы.КППОрганизации.ПодсказкаВвода = НСтр("ru = 'не требуется'");
		ПодключитьОбработчикОжидания("Подключаемый_ОчиститьКППДляИП", 1, Истина);
	Иначе
		Если НЕ Элементы.КППОрганизации.Доступность Тогда
			Элементы.КППОрганизации.Доступность = Истина;
			Элементы.КППОрганизации.ПодсказкаВвода = НСтр("ru = '9 цифр'");
		КонецЕсли;
	КонецЕсли;
	
	Если ДлинаИНН <> 10 И ДлинаИНН <> 12 Тогда
		Если Элементы.ДекорацияНадписьОпечатки_1.Видимость Тогда
			УстановитьВидимостьОшибкиНекорректногоИНН(Ложь, Элементы);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ДлинаИНН = 10 Тогда
		ЭтоЮрЛицо = Истина;
	Иначе
		ЭтоЮрЛицо = Ложь;
	КонецЕсли;
	
	СоответствуетТребованиям = РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(СтрокаИНН, ЭтоЮрЛицо, Неопределено);
	
	Если НЕ СоответствуетТребованиям Тогда
		ПодключитьОбработчикОжидания("Подключаемый_ОбработатьОшибкуНесоответствияТребованиямИНН", 1, Истина);
	Иначе
		УстановитьВидимостьОшибкиНекорректногоИНН(Ложь, Элементы);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СтраницаУстановкиКриптопровайдера

&НаКлиенте
Процедура ВариантыПрограммыКриптографииПриИзменении(Элемент)
	
	ПрограммаКриптографии = Элемент.СписокВыбора[0].Представление;
	
	Если ПрограммаКриптографии = НСтр("ru = 'Облачный сервис'") Тогда
		Элементы.СтраницаНадписиВыбораПрограммы.ТекущаяСтраница   = Элементы.СтраницаНадписиОблачныйСервис;
		Элементы.КриптопровайдерПродолжить.Видимость              = Истина;
		Элементы.УстановитьКриптопровайдер.Видимость              = Ложь;
	Иначе
		Элементы.СтраницаНадписиВыбораПрограммы.ТекущаяСтраница   = Элементы.СтраницаНадписиКриптографии;
		Элементы.КриптопровайдерПродолжить.Видимость              = Ложь;
		Элементы.УстановитьКриптопровайдер.Видимость              = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СтраницыЭЦПиШифрования

&НаКлиенте
Процедура ДекорацияЗаявленияОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылка, СтандартнаяОбработка)
	
	Если НавигационнаяСсылка = НСтр("ru = 'Заявление'") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ОткрытьФормуЗаявленияНаВыпускНовогоСертификата();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СертификатНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЭлектроннаяПодписьКлиент.СертификатНачалоВыбораСПодтверждением(Элемент,
			СертификатЭЦП, СтандартнаяОбработка);

КонецПроцедуры
		
&НаКлиенте
Процедура СертификатСоздание(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьСертификатЗавершение", ЭтотОбъект);
	
	ПараметрыДобавленияСертификата = ЭлектроннаяПодписьКлиент.ПараметрыДобавленияСертификата();
	ПараметрыДобавленияСертификата.ВЛичныйСписок = Истина;
	ПараметрыДобавленияСертификата.Организация = Организация;
	ПараметрыДобавленияСертификата.ИзЛичногоХранилища = Истина;
	ПараметрыДобавленияСертификата.СоздатьЗаявление = Истина;

	ЭлектроннаяПодписьКлиент.ДобавитьСертификат(Оповещение, ПараметрыДобавленияСертификата);

КонецПроцедуры

#КонецОбласти

#Область СтраницаРегистрацииЭДО

&НаКлиенте
Процедура ДекорацияУсловияИспользованияЭДООбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("РегистрСведений.УчетныеЗаписиЭДО.Форма.УсловияИспользования");

КонецПроцедуры

&НаКлиенте
Процедура ОператорЭДОПодключенныйК1СЭДОПриИзменении(Элемент)
	
	УстановитьВидимостьОшибкиОператораЭДО(Ложь, Элементы);
	
	ПолучитьДанныеВыбранногоОператора();
	
	ИдентификаторЭДО = "";

	Если ЭтоОператор1СТакскомВМоделиСервиса() Тогда
		УстановитьВидимость1СТакском(Истина, Элементы, СпособОбменаЭД);
	Иначе
		УстановитьВидимость1СТакском(Ложь, Элементы, СпособОбменаЭД);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЮрАдресНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТипыКонтактнойИнформацииАдрес = ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес");
		
	ВидКонтактнойИнформации = ПараметрыВидаКонтактнойИнформации(ТипыКонтактнойИнформацииАдрес);
	ВидКонтактнойИнформации.Вставить("РедактированиеТолькоВДиалоге", Истина);
	ВидКонтактнойИнформации.Вставить("ОбязательноеЗаполнение"      , Истина);
	ВидКонтактнойИнформации.Вставить("Наименование"                , НСтр("ru = 'Юридический адрес организации'"));
	ВидКонтактнойИнформации.НастройкиПроверки.ПроверятьКорректность = Истина;
	
	ПараметрыОткрытия = УправлениеКонтактнойИнформациейКлиент.ПараметрыФормыКонтактнойИнформации(
		ВидКонтактнойИнформации, ЗначениеПолейАдреса, ЮрАдрес, , ТипыКонтактнойИнформацииАдрес);
	
	Оповещение = Новый ОписаниеОповещения("ОткрытьФормуКонтактнойИнформацииЗавершение", ЭтотОбъект);
	
	УправлениеКонтактнойИнформациейКлиент.ОткрытьФормуКонтактнойИнформации(ПараметрыОткрытия, , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура НадписьПодключениеТакскомВМоделиСервисаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылка, СтандартнаяОбработка)
	
	Если НавигационнаяСсылка = НСтр("ru = 'ИдентификаторЭДО'") Тогда
		
		СтандартнаяОбработка = Ложь;
		Элементы.НадписьПодключениеТакскомВМоделиСервиса.Видимость = Ложь;
		Элементы.ИдентификаторЭДО.Видимость                        = Истина;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДекорацияТекстОшибкиРегистрацииОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(КонтекстОперацииПодключенияЭДО) Тогда
		ПараметрыОбработкиОшибок = ОбработкаНеисправностейБЭДКлиент.НовыеПараметрыОбработкиОшибок();
		КонтекстОперацииПодключенияЭДО.ОшибкиОбработаны = Ложь;
		ОбработкаНеисправностейБЭДКлиент.ОбработатьОшибки(КонтекстОперацииПодключенияЭДО, ПараметрыОбработкиОшибок);
	ИначеЕсли ЕстьПравоНаПросмотрЖурналаРегистрации Тогда
		ОткрытьЖурналРегистрации(НСтр("ru = 'Электронное взаимодействие.Обмен с контрагентами'"));
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Недостаточно прав на просмотр журнала регистрации.'"));
	КонецЕсли;
	
КонецПроцедуры

