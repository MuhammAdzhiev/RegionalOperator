КонецПроцедуры

// Шаг установки криптопровайдера.
//
&НаКлиенте
Процедура УстановитьРасширениеКриптографии(Команда)
	
	Описание = Новый ОписаниеОповещения("ПроверитьУстановкуРасширения", ЭтотОбъект);
	ЭлектроннаяПодписьКлиент.УстановитьРасширение(Истина, Описание);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКриптопровайдер(Команда)
	
	ПроверитьИСохранитьПользователяНастройкиСистемы();
	
	УстановитьДоступностьВидимостьЭлементовУстановкиКриптопровайдера(Ложь);
	
	Если ВариантыПрограммы = 0 Тогда
		УстановитьVipNet();
	ИначеЕсли ВариантыПрограммы = 1 Тогда
		УстановитьCryptoPRO();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Далее(Команда)
	
	Если Элементы.ГруппаСтраницБыстрогоСтарта.ТекущаяСтраница = Элементы.СтраницаВыбораЭЦП Тогда
		Если НЕ ЗначениеЗаполнено(СертификатЭЦП) Тогда
			ОчиститьСообщения();
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнен сертификат'"), ,"СертификатЭЦП");
			Возврат;
		КонецЕсли;
		
		СвойстваСубъекта = ПолучитьСвойствоСубъектаСертификата(СертификатЭЦП);
		
		ИННСубъекта = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СвойстваСубъекта.ИНН, 12, "0");
		ИННПроверки = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ИННОрганизации, 12, "0");

		Если ИННСубъекта <> ИННПроверки Тогда
			
			Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияВыбораСертификата", ЭтотОбъект);
			
			Вопросы = Новый Массив;
			Вопросы.Добавить(НСтр("ru = 'Обратите внимание:'"));
			Вопросы.Добавить(НСтр("ru = '- ИНН по данным сертификата не совпадает с ИНН выбранной организации.'"));
			Вопросы.Добавить(НСтр("ru = 'Продолжить получение идентификатора?'"));
			ТекстВопроса = СтрСоединить(Вопросы, Символы.ПС);
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПерейтиНаСтраницуВперед();
	
КонецПроцедуры

// Шаг установки ЭЦП и шифрования.
//
&НаКлиенте
Процедура ЗаказатьСертификат(Команда)
	
	ПараметрыДобавленияСертификата = ЭлектроннаяПодписьКлиент.ПараметрыДобавленияСертификата();
	ПараметрыДобавленияСертификата.Организация = Организация;
	ПараметрыДобавленияСертификата.ИзЛичногоХранилища = Ложь;
	ПараметрыДобавленияСертификата.СоздатьЗаявление = Истина;
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьСертификатЗавершение", ЭтотОбъект);
	
	ЭлектроннаяПодписьКлиент.ДобавитьСертификат(Оповещение, ПараметрыДобавленияСертификата);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСертификат(Команда)
	
	ЗаказанНовыйСертификатЭЦП = Ложь;
	
	ПараметрыДобавленияСертификата = ЭлектроннаяПодписьКлиент.ПараметрыДобавленияСертификата();
	ПараметрыДобавленияСертификата.Организация = Организация;
	ПараметрыДобавленияСертификата.ИзЛичногоХранилища = Истина;
	ПараметрыДобавленияСертификата.СоздатьЗаявление = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьСертификатЗавершение", ЭтотОбъект);
	
	ЭлектроннаяПодписьКлиент.ДобавитьСертификат(Оповещение, ПараметрыДобавленияСертификата);
	
	УстановитьВидимостьОжиданияУстановкиЭЦП(Истина, Элементы);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСертификат(Команда)
	
	ОткрытьФормуЗаявленияНаВыпускНовогоСертификата();

КонецПроцедуры

// Шаг регистрации оператора ЭДО.
//
&НаКлиенте
Процедура ЗарегистрироватьЭДО(Команда)
	
	Если НЕ ЭтоОператор1СТакскомВМоделиСервиса() Тогда
		
		Если ЭтоОператор1СТакском(СпособОбменаЭД) Тогда
			Если Не ЗначениеЗаполнено(Телефон) Тогда
				ОчиститьСообщения();
				ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнен телефон.'"), , "Телефон");
				Возврат;
			КонецЕсли;
		Иначе
			Проверка = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(КодФНС);
			Если НЕ (ЗначениеЗаполнено(Проверка) И СтрДлина(КодФНС) = 4) Тогда
				ОчиститьСообщения();
				ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Код ФНС не корректный.'"), ,"КодФНС");
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ТекстСообщения = "";
		СоответствуетТребованиямОГРН = РегламентированныеДанныеКлиентСервер.ОГРНСоответствуетТребованиям(ОГРНОрганизации, ЭтоЮридическоеЛицо, ТекстСообщения);
		Если НЕ СоответствуетТребованиямОГРН Тогда
			ОчиститьСообщения();
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, ,"ОГРНОрганизации");
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЮрАдрес) Тогда
			ОчиститьСообщения();
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнен юридический адрес организации.'"), ,"ЮрАдрес");
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ОператорЭДО) Тогда
			ОчиститьСообщения();
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбран оператор ЭДО.'"), ,"ОператорЭДО");
			Возврат;
		КонецЕсли;
		
		ДанныеОрганизации = Новый Структура;
		ДанныеОрганизации.Вставить("ОГРНИзменен", ОГРНИзменен);
		ДанныеОрганизации.Вставить("АдресИзменен", АдресИзменен);
		ДанныеОрганизации.Вставить("ТелефонИзменен", ТелефонИзменен);
		ДанныеОрганизации.Вставить("ОГРН", ОГРНОрганизации);
		ДанныеОрганизации.Вставить("ЮрАдрес", ЮрАдрес);
		ДанныеОрганизации.Вставить("Телефон", ТелефонЗначенияПолей);
		ЗаполнитьДанныеОрганизации(Организация, ДанныеОрганизации, ЭтоОператор1СТакском(СпособОбменаЭД));

	Иначе
		ОчиститьСообщения();
		Если НЕ ЗначениеЗаполнено(ИдентификаторЭДО) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнен идентификатор ЭДО.'"), ,"ИдентификаторЭДО");
			Возврат;
		ИначеЕсли НЕ СтрНачинаетсяС(ИдентификаторЭДО, ИдентификаторОператораЭДО) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Идентификатор ЭДО не корректный.'"), ,"ИдентификаторЭДО");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПолучитьДанныеВыбранногоОператора();
	
	ДанныеПодключенияКЭДО = ПараметрыПодключенияКЭДО();
	
	ЗаблокироватьПоляЗаполненияРегистрацииЭДО(Истина);
	
	ОтменитьРегистрациюЭДО = Ложь;
	
	НайденноеЗначение = СписокЗаявокИОператоровЭДО.НайтиПоЗначению(ИдентификаторОператораЭДО);
	Если НайденноеЗначение = Неопределено
		И ЗначениеЗаполнено(ИдентификаторЗаявки) Тогда
		ИдентификаторЗаявки = "";
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОтмененаРегистрацияЭДО", Ложь);
	ДополнительныеПараметры.Вставить("ИдентификаторЗаявки"   , "");
	
	ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ОбработатьПрогрессВыполнения", ЭтотОбъект, ДополнительныеПараметры);
	
	ОповещениеЗавершения = Новый ОписаниеОповещения("ВыполнитьПодключениеКЭДОЗавершение", ЭтотОбъект);
	
	Элементы.СтраницыКомандЭДО.ТекущаяСтраница = Элементы.СтраницаОжиданиеРегистрацииЭДО;
	
	СинхронизацияЭДОКлиент.НачатьВыполнениеОперацииЭДО(ДанныеПодключенияКЭДО, ОповещениеЗавершения, ОповещениеОПрогрессеВыполнения);
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбщиеОперацииФормы

&НаСервере
Процедура УстановитьВидимостьДоступностьЭлементовФормы()
	
	Элементы.Логотип.Видимость       = Ложь;
	Элементы.СтраницыШагов.Видимость = Ложь;
	
	Если НЕ УслугаOnboarding Тогда
		
		Если НЕ ВключеноРазделениеДанных Тогда
			УстановитьВидимостьПодключенияИПП(Ложь, Элементы);
			Элементы.ДекорацияКартинкаОжиданияПодключенияИПП.Видимость = Ложь;
			Элементы.ДекорацияНадписьПодключенияИПП.Видимость          = Ложь;
		КонецЕсли;
		
		Элементы.КПП.Видимость = Ложь;
		
		УстановитьВидимостьОшибкиРегистрацииВБизнесСети(Ложь, Элементы);
		УстановитьВидимостьОжиданияПодключенияБС(Ложь, Элементы);
		УстановитьВидимостьОжиданияПоискаИНН(Ложь, Элементы);
		
		Элементы.ДекорацияКартинкаОжиданияОрганизации_ИНН.Видимость = Ложь;
		Элементы.ДекорацияНадписьОжиданиеОрганизации_ИНН.Видимость  = Ложь;
		
		Элементы.ДекорацияКартинкаОжиданияОрганизации.Видимость     = Ложь;
		Элементы.ДекорацияНадписьОжиданиеОрганизации.Видимость      = Ложь;
		
		Элементы.ЗавершитьПодключениеБСГотово.Видимость             = Ложь;
		
		УстановитьВидимостьОшибкиНекорректногоИНН(Ложь, Элементы);
		
	КонецЕсли;
	
	УстановитьВидимостьОжиданияУстановкиЭЦП(Ложь, Элементы);
	
	УстановитьВидимость1СТакском(Ложь, Элементы, СпособОбменаЭД);
	УстановитьВидимостьОшибкиОператораЭДО(Ложь, Элементы);
	
	Элементы.СтраницаВсе.Видимость                    = Ложь;
	Элементы.СтраницыТорговли_БезБСиЗакупки.Видимость = Ложь;
	Элементы.СтраницаПродажи.Видимость                = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьВидимостьЭлементовОжиданияПодключенияИПП(Ожидание)
	
	Элементы.ГруппаПодключиться.Доступность                    = НЕ Ожидание;
	Элементы.ПодключитьИнтернетПоддержку.Доступность           = НЕ Ожидание;
	Элементы.ГиперссылкаНазад_1.Видимость                      = НЕ Ожидание;
	Элементы.ГиперссылкаВыход_2.Видимость                      = НЕ Ожидание;
	Элементы.ДекорацияКартинкаОжиданияПодключенияИПП.Видимость = Ожидание;
	Элементы.ДекорацияНадписьПодключенияИПП.Видимость          = Ожидание;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьНастройкиВыбораОпций(Знач НастройкиСтартовогоПомощникаКЭДО, ИспользоватьОбменБизнесСеть,
		ЛицензионноеСоглашениеКлиентЭДОПринято)
	
	Если НЕ ЛицензионноеСоглашениеКлиентЭДОПринято Тогда
		УстановитьЛицензионноеСоглашениеПринято();
		ЛицензионноеСоглашениеКлиентЭДОПринято = Истина;
	КонецЕсли;
	
	Если НЕ ИспользоватьОбменБизнесСеть Тогда
		УстановитьИспользованиеОбменаБизнесСеть();
		ИспользоватьОбменБизнесСеть = Истина;
	КонецЕсли;
	
	КлиентЭДОВызовСервера.СохранитьНастройкиСтартовогоПомощникаКЭДО(НастройкиСтартовогоПомощникаКЭДО);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьЗакрытиеПомощника(ПоказыватьПриСледующемВходе, ДополнительныеПараметры) Экспорт
	
	Если ПоказыватьПриСледующемВходе = Истина Тогда
		ТекущаяСтраницаШага = Элементы.ГруппаСтраницБыстрогоСтарта.ТекущаяСтраница;
		Если ТекущаяСтраницаШага <> Элементы.СтраницаПродолжитьНастройку
			И ТекущаяСтраницаШага <> Элементы.СтраницаСтартаУслуги
			И ТекущаяСтраницаШага <> Элементы.СтраницаВыборОпций Тогда
			СохранитьПередВыходомНастройкиПомощника();
		КонецЕсли;
	ИначеЕсли ПоказыватьПриСледующемВходе = Ложь Тогда
		БольшеНеПоказывать = Истина;
		СохранитьНастройкиПомощника();
	Иначе
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	ЗавершитьРаботуПомощника();
	
	Если НЕ ВключеноРазделениеДанных И НЕ ЛицензионноеСоглашениеКлиентЭДОПринято Тогда
		
		Оповещение = Новый ОписаниеОповещения("ОбработатьОтветЛицензионноеСоглашение", ЭтотОбъект);
		
		ОткрытьФорму("Обработка.НачалоРаботыКЭДО.Форма.ЛицензионноеСоглашение", , , , , ,
			Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОтветЛицензионноеСоглашение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Истина Тогда
		ПрекратитьРаботуСистемы();
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьПодключениеИнтернетПоддержки()
	
	УстановитьПривилегированныйРежим(Истина);
	ЛогинПарольИПП = ИнтернетПоддержкаПользователей.ДанныеАутентификацииПользователяИнтернетПоддержки();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ЛогинПарольИПП;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьПодключениеСервиса1СКонтрагентНаТестовыхДанных()
	
	НайденныеРеквизиты = РаботаСКонтрагентами.ЮридическиеЛицаПоНаименованию("ТестовыйКонтрагент");
	
	Если ЗначениеЗаполнено(НайденныеРеквизиты.ОписаниеОшибки) Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРеквизитыФормыСохраненнымиНастройкамиПомощникаЭДО()
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиСтартовогоПомощникаКЭДО);
	СписокРеквизитовСтрокой = "ИНН, КПП, Наименование";
	
	Если ЗначениеЗаполнено(Организация) Тогда
		СвойстваОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, СписокРеквизитовСтрокой);
		ИННОрганизации          = СвойстваОрганизации.ИНН;
		КППОрганизации          = СвойстваОрганизации.КПП;
		НаименованиеОрганизации = СвойстваОрганизации.Наименование;
		ЭтоЮридическоеЛицо      = ?(СтрДлина(ИННОрганизации) = 10, Истина, Ложь);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПригласившийКонтрагент) Тогда
		СвойстваКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПригласившийКонтрагент, СписокРеквизитовСтрокой);
		ИННКонтрагента          = СвойстваКонтрагента.ИНН;
		КППКонтрагента          = СвойстваКонтрагента.КПП;
		НаименованиеКонтрагента = СвойстваКонтрагента.Наименование;
	КонецЕсли;
	
	Если ОбменДокументамиСКонтрагентами Тогда
		Элементы.ОбменБезЭЦП.Доступность = Истина;
		Элементы.ОбменЭДО.Доступность    = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкиПомощника()
	
	ПерезаполнитьЗначенияНастройкиПомощника(ЭтотОбъект, ТекущийПользователь, Пользователь,
		НастройкиСтартовогоПомощникаКЭДО, ИдентификаторЗаявки, СписокЗаявокИОператоровЭДО);
	КлиентЭДОВызовСервера.СохранитьНастройкиСтартовогоПомощникаКЭДО(НастройкиСтартовогоПомощникаКЭДО);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПерезаполнитьЗначенияНастройкиПомощника(Знач Форма, Знач ТекущийПользователь, Пользователь,
		НастройкиСтартовогоПомощникаКЭДО, Знач ИдентификаторЗаявки, Знач СписокЗаявокИОператоровЭДО)
	
	Если НастройкиСтартовогоПомощникаКЭДО = Неопределено Тогда
		НастройкиСтартовогоПомощникаКЭДО = КлиентЭДОКлиентСервер.НоваяСтруктураНастроекПомощникаЭДО();
	Иначе
		Если НЕ НастройкиСтартовогоПомощникаКЭДО.Свойство("ИдентификаторЗаявки") Тогда
			НастройкиСтартовогоПомощникаКЭДО.Вставить("ИдентификаторЗаявки", ИдентификаторЗаявки);
		КонецЕсли;
		Если НЕ НастройкиСтартовогоПомощникаКЭДО.Свойство("СписокЗаявокИОператоровЭДО") Тогда
			НастройкиСтартовогоПомощникаКЭДО.Вставить("СписокЗаявокИОператоровЭДО", СписокЗаявокИОператоровЭДО);
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(НастройкиСтартовогоПомощникаКЭДО, Форма);
	НастройкиСтартовогоПомощникаКЭДО.Пользователь = ТекущийПользователь;
	
	Пользователь = ТекущийПользователь;
	
КонецПроцедуры

// Схема шагов состоит из 12 вариантов:
//  1,2,3,9,10  - для локальной базы,
//  4,5,6,11,12 - для базы базы запущенной на фреше без услуги Onboarding,
//  7,8         - для базы базы запущенной на фреше с услугой Onboarding.
//
&НаКлиенте
Процедура ОпределитьСхемуКартинкиШагов()
	
	ТребуютсяШагиЭДО = ОбменДокументамиСКонтрагентами И ОбменЭДО;
	
	Если ВключеноРазделениеДанных И УслугаOnboarding Тогда
		СхемаКартинкиШагов = ?(КриптопровайдерУстановлен, 8, 7);
	ИначеЕсли ВключеноРазделениеДанных И НЕ УслугаOnboarding Тогда
		Если ТребуетсяРегистрацияБС И ТребуютсяШагиЭДО Тогда
			СхемаКартинкиШагов = ?(КриптопровайдерУстановлен, 12, 11);
		ИначеЕсли ТребуютсяШагиЭДО Тогда
			СхемаКартинкиШагов = ?(КриптопровайдерУстановлен, 5, 4);
		Иначе
			СхемаКартинкиШагов = 6;
		КонецЕсли;
	Иначе
		Если ТребуетсяРегистрацияБС И ТребуютсяШагиЭДО Тогда
			СхемаКартинкиШагов = ?(КриптопровайдерУстановлен, 10, 9);
		ИначеЕсли ТребуютсяШагиЭДО Тогда
			СхемаКартинкиШагов = ?(КриптопровайдерУстановлен, 2, 1);
		Иначе
			СхемаКартинкиШагов = 3;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтраницуНеПройденногоШага()
	
	Если СхемаКартинкиШагов = 0 Тогда
		ОпределитьСхемуКартинкиШагов();
	КонецЕсли;
	
	Если НЕ Элементы.Логотип.Видимость Тогда
		Элементы.Логотип.Видимость = Истина;
	КонецЕсли;
	
	Если НЕ Элементы.СтраницыШагов.Видимость Тогда
		Элементы.СтраницыШагов.Видимость = Истина;
	КонецЕсли;
	
	Страница      = Неопределено;
	ЭтапНастройки = "";
	
	Если УслугаOnboarding Тогда
		
		Если НЕ НачатаНастройкаСистемы Тогда
			
			ТекстЗаголовкаНадписиСтартаНастройкиУслуги = НСтр("ru = 'Добро пожаловать'") + " """ + НаименованиеОрганизации + """";
			ПредставлениеКонтрагента = """" + НаименованиеКонтрагента + " (" + ИННКонтрагента
				+ ?(ЗначениеЗаполнено(КППКонтрагента), "/" + КППКонтрагента, "") + ")""";
			Элементы.ДекорацияНадписиСтартаНастройкиУслуги.Заголовок = 
				СтрШаблон(НСтр("ru = 'Организация %1 предлагает обмениваться документами в электронном виде.'"), ПредставлениеКонтрагента);
				
			ЭтапНастройки = ЭтапНастройкиСтарт();
			Страница      = Элементы.СтраницаСтартаУслуги;
			
		КонецЕсли;
		
	Иначе
		
		// Шаг 1 - выбор опций.
		Если НЕ (ОбменДокументамиСКонтрагентами ИЛИ Поставщик ИЛИ Покупатель) Тогда
			
			ИзменитьОтображениеУсловияСоглашения();
			ОбменЭДО    = Истина;
			ОбменБезЭЦП = Истина;
			
			ЭтапНастройки = ЭтапНастройкиСтарт();
			Страница      = Элементы.СтраницаВыборОпций;
			
		// Шаг 2 - вход на портал 1С:ИТС.
		ИначеЕсли НЕ ВключеноРазделениеДанных
			И НЕ ПодключенаИнтернетПоддержка Тогда
			ЭтапНастройки  = ЭтапНастройкиПодключениеИПП();
			ТекущийЭлемент = Элементы.ЛогинИнтернетПоддержки;
			Страница       = Элементы.СтраницаПодключениеИнтернетПоддержки;
			
		// Шаг 3 - заполнение организации.
		ИначеЕсли НЕ ЗначениеЗаполнено(Организация) Тогда
			Страница = СтраницаЗаполненияОрганизации();

		// Шаг 4 - подключение к 1С:Бизнес-сети.
		ИначеЕсли ТребуетсяРегистрацияБС И НЕ ОрганизацияЗарегистрированаВБС И НЕ ПропуститьРегистрациюБС Тогда
			ЭтапНастройки = ЭтапНастройкиПодключениеБС();
			Страница      = Элементы.СтраницаПодключениеБизнесСети;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Страница = Неопределено И ОбменЭДО И ОбменДокументамиСКонтрагентами Тогда
		
		// Шаг 4 - установка криптографии.
		Если (НЕ КриптопровайдерУстановлен
			ИЛИ Элементы.ГруппаСтраницБыстрогоСтарта.ТекущаяСтраница = Элементы.СтраницаУстановкиКриптопровайдера)
			И НЕ (ПрограммаКриптографии = НСтр("ru = 'Облачный сервис'") И ВключеноРазделениеДанных) Тогда
			ПодготовитьСтраницуУстановкиКриптопровайдера();
			Страница      = Элементы.СтраницаУстановкиКриптопровайдера;
	
		// Шаг 5 - установка ЭЦП.
		ИначеЕсли НЕ ЗначениеЗаполнено(СертификатЭЦП) Тогда
			Если ДействующиеСертификатыЭЦП.Количество() Тогда
				ПодготовитьСтраницуВыбораЭЦП();
				ЭтапНастройки = ЭтапНастройкиДобавлениеЭЦП();
				Страница      = Элементы.СтраницаВыбораЭЦП;
			Иначе
				ЭтапНастройки = ЭтапНастройкиУстановкаЭЦП();
				Страница      = Элементы.СтраницаУстановкиЭЦПиШифрования;
			КонецЕсли;
		ИначеЕсли ЗаказанНовыйСертификатЭЦП
			И СостояниеСертификатаКриптографии <> ПредопределенноеЗначение("Перечисление.СостоянияЗаявленияНаВыпускСертификата.Исполнено") Тогда
			ПодготовитьСтраницуОжиданияЭЦП();
			Страница      = Элементы.СтраницаЗаказаЭЦПОжидание;
			
		// Шаг 6 - регистрация оператора ЭДО.
		ИначеЕсли ЭДОПодключен Тогда
			ЭтапНастройки = ЭтапНастройкиЗавершениеЭДО();
			Страница      = Элементы.СтраницаЗавершенияРегистрацииЭДО;
		Иначе
			ПодготовитьСтраницуРегистрацииОператораЭДО();
			Страница      = Элементы.СтраницаРегистрацииЭДО;
		КонецЕсли;
		
	КонецЕсли;
	
	Если БольшеНеПоказывать И Страница = Неопределено Тогда
		ПодготовитьСтраницуСПолезнымиСсылками();
		Страница = Элементы.СтраницаПолезныхСсылок;
	КонецЕсли;
	
	Если НачатаНастройкаСистемы И ЗначениеЗаполнено(Пользователь)
		И Пользователь <> ТекущийПользователь Тогда
		
		Элементы.ДекорацияТекстНадписиЧастичнойНастройкиПользователь.Заголовок
			= СтрШаблон(НСтр("ru = 'Система была частично настроена под пользователем %1.'"), Пользователь);
		
		Страница = Элементы.СтраницаПродолжитьНастройку;
		
	КонецЕсли;

	Возврат Страница;
	
КонецФункции

&НаКлиенте
Функция СтраницаЗаполненияОрганизации()
	
	Если ПодключенСервис1СКонтрагент Тогда
		ЭтапНастройки = ЭтапНастройкиОрганизацияСервис();
		ПодготовитьСтраницуЗаполненияОрганизацииСервиса();
		Страница      = Элементы.СтраницаОрганизацииСервис1СКонтрагент;
	Иначе
		ЭтапНастройки  = ЭтапНастройкиОрганизация();
		ТекущийЭлемент = Элементы.НаименованиеОрганизации;
		Страница       = Элементы.СтраницаОрганизацииБезСервиса1СКонтрагент;
	КонецЕсли;
	
	Возврат Страница;

КонецФункции

&НаКлиенте
Процедура ПерейтиНаСтраницу(ИмяСледующейСтраницы = Неопределено, ДействиеНазад = Истина)
	
	ОчиститьСообщения();
	
	Если ИмяСледующейСтраницы = Неопределено Тогда
		
		ТекущаяСтраницаШага = Элементы.ГруппаСтраницБыстрогоСтарта.ТекущаяСтраница;
		
		Если ДействиеНазад Тогда
			
			Если ТекущаяСтраницаШага = Элементы.СтраницаПодключениеИнтернетПоддержки Тогда
				
				ЭтапНастройки = ЭтапНастройкиСтарт();
				Элементы.ГруппаСтраницБыстрогоСтарта.ТекущаяСтраница = Элементы.СтраницаВыборОпций;
				УстановитьВидимостьПодключенияИПП(Ложь, Элементы);
				
			ИначеЕсли ТекущаяСтраницаШага = Элементы.СтраницаОрганизацииСервис1СКонтрагент
				ИЛИ ТекущаяСтраницаШага = Элементы.СтраницаОрганизацииБезСервиса1СКонтрагент Тогда
				
				Если ВключеноРазделениеДанных Тогда
					ЭтапНастройки = ЭтапНастройкиСтарт();
					Элементы.ГруппаСтраницБыстрогоСтарта.ТекущаяСтраница = Элементы.СтраницаВыборОпций;
				Иначе
					ЭтапНастройки  = ЭтапНастройкиПодключениеИПП();
					ТекущийЭлемент = Элементы.ЛогинИнтернетПоддержки;
					Элементы.ГруппаСтраницБыстрогоСтарта.ТекущаяСтраница = Элементы.СтраницаПодключениеИнтернетПоддержки;
				КонецЕсли;
				
			ИначеЕсли ТекущаяСтраницаШага = Элементы.СтраницаПодключениеБизнесСети Тогда
				
				Элементы.ГруппаСтраницБыстрогоСтарта.ТекущаяСтраница = СтраницаЗаполненияОрганизации();
				
				УстановитьВидимостьОшибкиРегистрацииВБизнесСети(Ложь, Элементы);
				
			КонецЕсли;
			
		Иначе
			
			Если ТекущаяСтраницаШага = Элементы.СтраницаУстановкиКриптопровайдера Тогда
				Если ДействующиеСертификатыЭЦП.Количество() Тогда
					ПодготовитьСтраницуВыбораЭЦП();
					ЭтапНастройки = ЭтапНастройкиДобавлениеЭЦП();
					Элементы.ГруппаСтраницБыстрогоСтарта.ТекущаяСтраница = Элементы.СтраницаВыбораЭЦП;
				Иначе
					ЭтапНастройки = ЭтапНастройкиУстановкаЭЦП();
					Элементы.ГруппаСтраницБыстрогоСтарта.ТекущаяСтраница = Элементы.СтраницаУстановкиЭЦПиШифрования;
				КонецЕсли;
				
			ИначеЕсли ТекущаяСтраницаШага = Элементы.СтраницаДобавлениеЭЦП
				ИЛИ ТекущаяСтраницаШага = Элементы.СтраницаВыбораЭЦП Тогда
				ПодготовитьСтраницуРегистрацииОператораЭДО();
				Элементы.ГруппаСтраницБыстрогоСтарта.ТекущаяСтраница = Элементы.СтраницаРегистрацииЭДО;
			
			ИначеЕсли ТекущаяСтраницаШага = Элементы.СтраницаЗавершенияРегистрацииЭДО Тогда
				ПодготовитьСтраницуСПолезнымиСсылками();
				Элементы.ГруппаСтраницБыстрогоСтарта.ТекущаяСтраница = Элементы.СтраницаПолезныхСсылок;
				
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		Элементы.ГруппаСтраницБыстрогоСтарта.ТекущаяСтраница = Элементы[ИмяСледующейСтраницы];
		
	КонецЕсли;
	
	Элементы.СтраницыШагов.ТекущаяСтраница = Элементы.Найти("СтраницаШаг" + ЭтапНастройки + "_" + СхемаКартинкиШагов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаСтраницуВперед()
	
	СохранитьНастройкиПомощника();
	
	ПерейтиНаСтраницу(Неопределено, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаСтраницуНеПройденногоЭтапа()
	
	СледующаяСтраница = ПолучитьСтраницуНеПройденногоШага();
	
	Если СледующаяСтраница <> Неопределено Тогда
		ПерейтиНаСтраницу(СледующаяСтраница.Имя, Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРаботуПомощника()
	
	ТребуетсяНастройкаЭДО = ОбменЭДО И ОбменДокументамиСКонтрагентами;
	
	ЗавершитьРаботуПомощникаНаСервере(ИспользоватьСервисЭДО, ТребуетсяНастройкаЭДО);
	
	ОбновитьИнтерфейс();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗавершитьРаботуПомощникаНаСервере(Знач ИспользоватьСервисЭДО, Знач ТребуетсяНастройкаЭДО)

	Если НЕ ИспользоватьСервисЭДО И ТребуетсяНастройкаЭДО Тогда
		КлиентЭДО.ВосстановитьСистемныеНастройки();
		УстановитьИспользованиеСервисаЭДО();
	Иначе
		КлиентЭДО.ВосстановитьСистемныеНастройки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПередВыходомНастройкиПомощника()
	
	Если НачатаНастройкаСистемы Тогда
		Если НЕ ЗначениеЗаполнено(НастройкиСтартовогоПомощникаКЭДО) Тогда
			НастройкиСтартовогоПомощникаКЭДО = КлиентЭДОКлиентСервер.НоваяСтруктураНастроекПомощникаЭДО();
		КонецЕсли;
		СохранитьНастройкиПомощника();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИСохранитьПользователяНастройкиСистемы()
	
	Если Пользователь <> ТекущийПользователь Тогда
		НастройкиСтартовогоПомощникаКЭДО.Пользователь = ТекущийПользователь;
		Пользователь = ТекущийПользователь;
		КлиентЭДОВызовСервера.СохранитьНастройкиСтартовогоПомощникаКЭДО(НастройкиСтартовогоПомощникаКЭДО);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьНастройкуСистемы()
	
	НачатаНастройкаСистемы = Истина;
	ПерезаполнитьЗначенияНастройкиПомощника(ЭтотОбъект, ТекущийПользователь, Пользователь,
		НастройкиСтартовогоПомощникаКЭДО, ИдентификаторЗаявки, СписокЗаявокИОператоровЭДО);
	СохранитьНастройкиВыбораОпций(НастройкиСтартовогоПомощникаКЭДО, ИспользоватьОбменБизнесСеть,
		ЛицензионноеСоглашениеКлиентЭДОПринято);
	ПерейтиНаСтраницуНеПройденногоЭтапа();
	
КонецПроцедуры

&НаКлиенте
Функция ТекстОшибкиССсылкойНаЖурналРегистрации(ТекстОшибки)
	
	МассивТекстаОшибки = Новый Массив;
	МассивТекстаОшибки.Добавить(ТекстОшибки);
	МассивТекстаОшибки.Добавить(Символы.ПС);
	МассивТекстаОшибки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Подробнее см. в журнале регистрации.'"),,,, "ЖурналРегистрации"));
	
	Возврат Новый ФорматированнаяСтрока(МассивТекстаОшибки);
	
КонецФункции

&НаКлиенте
Процедура ОткрытьЖурналРегистрации(ВидСобытия)
	
	ТекущаяДата = ОбщегоНазначенияКлиент.ДатаСеанса();
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("СобытиеЖурналаРегистрации" , ВидСобытия);
	ПараметрыОткрытия.Вставить("ДатаНачала"                , НачалоДня(ТекущаяДата));
	ПараметрыОткрытия.Вставить("ДатаОкончания"             , КонецДня(ТекущаяДата));
	
	ОткрытьФорму("Обработка.ЖурналРегистрации.Форма.ЖурналРегистрации", ПараметрыОткрытия, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Функция ЭтапНастройкиСтарт()
	
	Возврат "Старт";
	
КонецФункции

&НаКлиенте
Функция ЭтоОператор1СТакскомВМоделиСервиса()
	
	Возврат ВключеноРазделениеДанных И ЭтоОператор1СТакском(СпособОбменаЭД);
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоОператор1СТакском(СпособОбменаЭД)
	
	Возврат СпособОбменаЭД = ПредопределенноеЗначение("Перечисление.СпособыОбменаЭД.ЧерезОператораЭДОТакском");
		
КонецФункции

&НаСервереБезКонтекста
Процедура ТелефонПриИзмененииНаСервере(Телефон, ТелефонЗначенияПолей)
	
	ТелефонЗначенияПолей = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияПоПредставлению(
		Телефон, Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаНомераТелефона(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Телефон = Результат.Представление;
	ТелефонЗначенияПолей = Результат.Значение;
	ТелефонИзменен = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СтраницаВыборОпций

&НаКлиенте
Процедура ИзменитьОтображениеУсловияСоглашения()

	ТребуетсяРегистрацияБС = Покупатель ИЛИ Поставщик ИЛИ (ОбменБезЭЦП И ОбменДокументамиСКонтрагентами);
	ТекстЗаголовка         = Элементы.ПодсказкаУсловия.Заголовок;
	МассивСтрокГиперссылки = Новый Массив;
	ТекстСоглашения        = Новый ФорматированнаяСтрока(НСтр("ru = 'Нажатие кнопки ""Начать настройку"" означает согласие с'") + " ");
	МассивСтрокГиперссылки.Добавить(ТекстСоглашения);
	
	ТребуетсяСоглашениеКЭДО = НЕ ЛицензионноеСоглашениеКлиентЭДОПринято И НЕ ВключеноРазделениеДанных;
	
	Если ТребуетсяСоглашениеКЭДО Тогда
		МассивСтрокГиперссылки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'условиями использования программы'"), , , , "ПрограммаКлиентЭДО"));
		Если ТребуетсяРегистрацияБС Тогда
			МассивСтрокГиперссылки.Добавить(Новый ФорматированнаяСтрока(" " + Символы.ПС + НСтр("ru = 'и'") + " "));
		КонецЕсли;
	КонецЕсли;
	
	Если ТребуетсяРегистрацияБС Тогда
		МассивСтрокГиперссылки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'условиями использования сервиса 1С:Бизнес-сеть'")
			, , , , "https://1cbn.ru/agreement"));
	КонецЕсли;
		
	ВидимостьПодсказкиУсловия = Элементы.ПодсказкаУсловия.Видимость;
	
	Если НЕ ТребуетсяСоглашениеКЭДО И НЕ ТребуетсяРегистрацияБС Тогда
		
		ВидимостьПодсказкиУсловия           = Ложь;
		Элементы.ПодсказкаУсловия.Видимость = Ложь;
		
	ИначеЕсли НЕ ВидимостьПодсказкиУсловия Тогда
		
		ВидимостьПодсказкиУсловия           = Истина;
		Элементы.ПодсказкаУсловия.Видимость = Истина;
		
	КонецЕсли;
	
	Если ВидимостьПодсказкиУсловия Тогда
		
		ФорматированнаяСтрокаЗаголовка = Новый ФорматированнаяСтрока(МассивСтрокГиперссылки);
		Если ТекстЗаголовка <> ФорматированнаяСтрокаЗаголовка
			И ФорматированнаяСтрокаЗаголовка <> ТекстСоглашения Тогда
			Элементы.ПодсказкаУсловия.Заголовок = ФорматированнаяСтрокаЗаголовка;
		КонецЕсли;
		
	КонецЕсли;
	
	ИзменитьСхемуКартинокШагов();
	
КонецПроцедуры

