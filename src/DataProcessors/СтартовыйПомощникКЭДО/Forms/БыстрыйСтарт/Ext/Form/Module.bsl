Процедура УстановитьВидимостьОшибкиНекорректногоИНН(Знач Видимость, Элементы)
	
	Элементы.ДекорацияКартинкаОшибкиВалидностиИНН_1.Видимость = Видимость;
	Элементы.ДекорацияНадписьОпечатки_1.Видимость             = Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьСтраницуЗаполненияОрганизацииСервиса()
	
	Если ЗначениеЗаполнено(ИННОрганизации) Тогда
		Если ЗначениеЗаполнено(НаименованиеОрганизации) Тогда
			ИзменитьСтраницуЗаполненияСведенийОрганизации("СтраницаИННПоискЗавершен");
		Иначе
			ИзменитьСтраницуЗаполненияСведенийОрганизации("СтраницаИзменитьСведенияОрганизации");
		КонецЕсли;
	Иначе
		УстановитьВидимостьОжиданияПоискаИНН(Ложь, Элементы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьШагЗаполненияОрганизации()
	
	ДлинаИНН = СтрДлина(ИННОрганизации);
	ТекстСообщения = "";
	
	Если ДлинаИНН > 10 Тогда
		ЭтоЮридическоеЛицо = Ложь;
	Иначе
		ЭтоЮридическоеЛицо = Истина;
	КонецЕсли;
	
	ОчиститьСообщения();
	СоответствуетТребованиямИНН = РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(ИННОрганизации, ЭтоЮридическоеЛицо, ТекстСообщения);
	Если НЕ СоответствуетТребованиямИНН Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "ИННОрганизации");
		Возврат;
	КонецЕсли;
	
	Если ЭтоЮридическоеЛицо Тогда
		СоответствуетТребованиямКПП = РегламентированныеДанныеКлиентСервер.КППСоответствуетТребованиям(КППОрганизации, ТекстСообщения);
		Если НЕ СоответствуетТребованиямКПП Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "КППОрганизации");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаименованиеОрганизации) Тогда
		ОчиститьСообщения();
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо заполнить наименование организации'"),, "НаименованиеОрганизации");
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	УстановитьОжиданиеОперацииПоОрганизации(Истина);
	
	МассивУстановленныхСертификатовЭЦП = Новый Массив;
		
	ЗавершитьЗаполнениеОрганизацииНаСервере(МассивУстановленныхСертификатовЭЦП);
	СохранитьНастройкиПомощника();
	
	ЗарегистрироватьОрганизациюВСервисе = ТребуетсяРегистрацияБС И НЕ ОрганизацияЗарегистрированаВБС;

	Если НЕ ЗарегистрироватьОрганизациюВСервисе Тогда
		Если ЗначениеЗаполнено(МассивУстановленныхСертификатовЭЦП) Тогда
			ДействующиеСертификатыЭЦП.ЗагрузитьЗначения(МассивУстановленныхСертификатовЭЦП);
		КонецЕсли;
	КонецЕсли;
	
	ПерейтиКСледующемуШагуПослеЗаполненияОрганизации(ЗарегистрироватьОрганизациюВСервисе);
	УстановитьОжиданиеОперацииПоОрганизации(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ЗавершитьЗаполнениеОрганизацииНаСервере(МассивУстановленныхСертификатовЭЦП)
	
	Если ПодключенСервис1СКонтрагент
		И ДанныеОрганизацииПоДаннымЕГРП <> Неопределено Тогда
		РеквизитыОрганизации = ОбщегоНазначения.СкопироватьРекурсивно(ДанныеОрганизацииПоДаннымЕГРП);
		НаименованиеПоДаннымЕГРП = (НаименованиеОрганизации = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			РеквизитыОрганизации, "НаименованиеСокращенное"));
		РеквизитыОрганизации.Вставить("КПП"                     , КППОрганизации);
		РеквизитыОрганизации.Вставить("НаименованиеСокращенное" , НаименованиеОрганизации);
		СоздатьОрганизацию(РеквизитыОрганизации, ЭтоЮридическоеЛицо, НаименованиеПоДаннымЕГРП, Организация);
	Иначе
		РеквизитыОрганизации = Новый Структура;
		РеквизитыОрганизации.Вставить("ИНН"                     , ИННОрганизации);
		РеквизитыОрганизации.Вставить("КПП"                     , КППОрганизации);
		РеквизитыОрганизации.Вставить("НаименованиеСокращенное" , НаименованиеОрганизации);
		СоздатьОрганизацию(РеквизитыОрганизации, ЭтоЮридическоеЛицо, Ложь, Организация);
	КонецЕсли;
	
	Если ТребуетсяРегистрацияБС Тогда
		ПодготовитьСтраницуРегистрацииБС();
		ОрганизацияЗарегистрированаВБС = ЕстьРегистрацияОрганизацииВБС(Организация);
	Иначе
		Если ОбменЭДО И ОбменДокументамиСКонтрагентами И НЕ ЗначениеЗаполнено(МассивУстановленныхСертификатовЭЦП) Тогда
			МассивУстановленныхСертификатовЭЦП = ПроверитьНаличиеУстановленныхСертификатов(Организация, ТекущийПользователь);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКСледующемуШагуПослеЗаполненияОрганизации(ЗарегистрироватьОрганизациюВСервисе)
	
	Если ЗарегистрироватьОрганизациюВСервисе Тогда
		ЭтапНастройки = ЭтапНастройкиПодключениеБС();
		ПерейтиНаСтраницу(Элементы.СтраницаПодключениеБизнесСети.Имя, Ложь);
	ИначеЕсли ОбменЭДО И ОбменДокументамиСКонтрагентами Тогда
		Если НЕ КриптопровайдерУстановлен Тогда
			ПроверитьУстановкуРасширенияКриптографии();
		Иначе
			ПерейтиНаСтраницуНеПройденногоЭтапа();
		КонецЕсли;
	Иначе
		СохранитьНастройкиПомощника();
		ПерейтиНаСтраницуНеПройденногоЭтапа();
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьОжиданияПоискаИНН(Знач Видимость, Элементы)
	
	Если Элементы.ДекорацияКартинкаПоискаОрганизации.Видимость <> Видимость Тогда
		Элементы.ДекорацияКартинкаПоискаОрганизации.Видимость = Видимость;
		Элементы.ДекорацияНадписьПоискаОрганизации.Видимость  = Видимость;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСтраницуЗаполненияСведенийОрганизации(ИмяСледующейСтраницы)
	
	ТекущаяСтраница = Элементы[ИмяСледующейСтраницы];
	Элементы.СтраницаЗаполнениеСведенийОрганизации.ТекущаяСтраница = ТекущаяСтраница;
	
	ИзменитьВидимостьИННКПП(СтрДлина(ИННОрганизации));
	
	Если ТекущаяСтраница = Элементы.СтраницаИННПоискЗавершен Тогда
		ЗаполнитьПредставлениеНайденнойОрганизации();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыОрганизацииАсинхронно(ПараметрыПроцедуры, УникальныйИдентификатор)
	
	ДлительныеОперации.ОтменитьВыполнениеЗадания(УникальныйИдентификатор);
	
	НаименованиеЗадания = НСтр("ru = 'Получение реквизитов организации в сервисе 1С-Контрагент.'");
	ИмяПроцедуры        = "Обработки.СтартовыйПомощникКЭДО.ПолучитьРеквизитыОрганизации";
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	ПараметрыВыполнения.ЗапуститьВФоне              = Истина;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(ИмяПроцедуры, ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаСервереБезКонтекста
Процедура СоздатьОрганизацию(Знач РеквизитыОрганизации, Знач ЭтоЮридическоеЛицо, Знач НаименованиеПоДаннымЕГРП, Организация)
	
	ПроверитьОрганизациюНаСуществование(РеквизитыОрганизации.ИНН,
		?(ЭтоЮридическоеЛицо, РеквизитыОрганизации.КПП, ""), Организация);
	
	Если Организация = Справочники.Организации.ПустаяСсылка() Тогда
		ОбъектОрганизация = Справочники.Организации.СоздатьЭлемент();
	Иначе
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОбъектОрганизация, РеквизитыОрганизации);
	
	Если РеквизитыОрганизации.Свойство("РегистрационныйНомер") Тогда
		ОбъектОрганизация.ОГРН = РеквизитыОрганизации.РегистрационныйНомер;
	КонецЕсли;
	
	Если ЭтоЮридическоеЛицо Тогда
		ОбъектОрганизация.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
		Если РеквизитыОрганизации.Свойство("ЮридическийАдрес") Тогда
			ЮридическийАдрес = РеквизитыОрганизации.ЮридическийАдрес;
			Если ЗначениеЗаполнено(ЮридическийАдрес) Тогда
				Если ЮридическийАдрес.Свойство("КонтактнаяИнформация") Тогда
					ЗаписатьЮридическийАдресОрганизации(ОбъектОрганизация, ЮридическийАдрес.КонтактнаяИнформация);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ОбъектОрганизация.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель;
	КонецЕсли;
	
	Если НЕ НаименованиеПоДаннымЕГРП Тогда
		
		СтруктураНаименования = КлиентЭДОКлиентСервер.РазложитьСтрокуНаименованияОрганизации(
			ОбъектОрганизация.НаименованиеСокращенное, ОбъектОрганизация.ЮрФизЛицо);
		
		ОбъектОрганизация.НаименованиеПолное = КлиентЭДОКлиентСервер.СформироватьНаименованиеПолное(ОбъектОрганизация.ЮрФизЛицо, СтруктураНаименования);
		ОбъектОрганизация.Наименование       = КлиентЭДОКлиентСервер.СформироватьНаименование(СтруктураНаименования);
		
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		ОбъектОрганизация.Записать();
		Организация = ОбъектОрганизация.Ссылка;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Создание новой организации.'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , , ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьОрганизациюНаСуществование(Знач ИНН, Знач КПП, Организация)
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления
		|	И Организации.ИНН = &ИНН
		|	И &УсловиеНаКПП";
	
	Если ЗначениеЗаполнено(КПП) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеНаКПП", "Организации.КПП = &КПП");
		Запрос.УстановитьПараметр("КПП", КПП);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеНаКПП", "Истина");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ИНН", ИНН);
	
	Запрос.Текст = ТекстЗапроса;
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ВыборкаОрганизации = РезультатЗапроса.Выбрать();
	
	Если ВыборкаОрганизации.Следующий() Тогда
		Организация = ВыборкаОрганизации.Ссылка;
	Иначе
		Организация = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработатьОшибкиПолученияДанныхПоОрганизации()
	
	ИзменитьСтраницуЗаполненияСведенийОрганизации("СтраницаОшибкиВалидностиИНН");
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ИзменитьСтраницуПоискаИНН()

	ИзменитьСтраницуЗаполненияСведенийОрганизации("СтраницаОжиданияПоискаВСервисе1СКонтрагент");
	ВыполнитьПоискПоИНН(Элементы.ИНН.ТекстРедактирования);

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВидимостьИННКПП(ДлинаИНН)
	
	Если ДлинаИНН <> 12
		И Элементы.СтраницаЗаполнениеСведенийОрганизации.ТекущаяСтраница = Элементы.СтраницаИзменитьСведенияОрганизации Тогда
		Элементы.КПП.Видимость = Истина;
	ИначеЕсли Элементы.КПП.Видимость Тогда
		Элементы.КПП.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПолучитьЗначенияРеквизитовОрганизации()
	
	ИННОрганизации = Элементы.ИНН.ТекстРедактирования;
	ДлинаИНН       = СтрДлина(ИННОрганизации);
	
	Если ДлинаИНН = 10 Тогда
		ЭтоЮридическоеЛицо = Истина;
	Иначе
		ЭтоЮридическоеЛицо = Ложь;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ЭтоЮридическоеЛицо" , ЭтоЮридическоеЛицо);
	ДополнительныеПараметры.Вставить("ИННОрганизации"     , ИННОрганизации);
	
	ДлительнаяОперацияДанныхОрганизацииЕГРП = ПолучитьРеквизитыОрганизацииАсинхронно(ДополнительныеПараметры, УникальныйИдентификатор);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	Описание = Новый ОписаниеОповещения("ОбработатьПолученныеДанныеЕГРПОрганизации", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперацияДанныхОрганизацииЕГРП, Описание, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПолученныеДанныеЕГРПОрганизации(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеОрганизацииПоДаннымЕГРП = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	
	Если ДанныеОрганизацииПоДаннымЕГРП <> Неопределено Тогда
		
		НаименованиеОрганизации               = ДанныеОрганизацииПоДаннымЕГРП.НаименованиеСокращенное;
		Если ЭтоЮридическоеЛицо Тогда
			КППОрганизации                    = ДанныеОрганизацииПоДаннымЕГРП.КПП;
		КонецЕсли;
		ЗаполнитьПредставлениеНайденнойОрганизации();
		ИзменитьСтраницуЗаполненияСведенийОрганизации("СтраницаИННПоискЗавершен");
		
	Иначе
		
		КППОрганизации                    = "";
		НаименованиеОрганизации           = "";
		ПредставлениеНайденнойОрганизации = "";
		
		ИзменитьСтраницуЗаполненияСведенийОрганизации("СтраницаИзменитьСведенияОрганизации");
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработатьОшибкуНесоответствияТребованиямИНН()
	
	УстановитьВидимостьОшибкиНекорректногоИНН(Истина, Элементы);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОчиститьКППДляИП()
	
	Если СтрДлина(Элементы.ИННОрганизации.ТекстРедактирования) = 12 И ЗначениеЗаполнено(КППОрганизации) Тогда
		КППОрганизации = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПредставлениеНайденнойОрганизации()
	
	Если ЭтоЮридическоеЛицо Тогда
		ПредставлениеНайденнойОрганизации = НаименованиеОрганизации + " (" + НСтр("ru = 'КПП:'")+ КППОрганизации +")";
	Иначе
		ПредставлениеНайденнойОрганизации = НаименованиеОрганизации;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СтраницаПодключениеБизнесСети

&НаКлиенте
Функция ЭтапНастройкиПодключениеБС()
	
	Возврат "ПодключениеБС";
	
КонецФункции

&НаКлиенте
Функция ЭтапНастройкиЗавершениеБС()
	
	Возврат "ЗавершениеБС";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьОшибкиРегистрацииВБизнесСети(Знач Видимость, Элементы)
	
	Если Видимость Тогда
		Элементы.СтраницыОшибкиРегистрацииБС.ТекущаяСтраница = Элементы.СтраницаТекстаОшибки;
	Иначе
		Элементы.СтраницыОшибкиРегистрацииБС.ТекущаяСтраница = Элементы.СтраницаПустая_1;
	КонецЕсли;
	Элементы.ДекорацияКартинкаОшибкиБС.Видимость           = Видимость;
	Элементы.ДекорацияТекстОшибкиРегистрацииБС.Видимость   = Видимость;
	Элементы.ЗарегистрироватьБизнесСеть_Повторно.Видимость = Видимость;
	Элементы.ПродолжитьБезРегистрацииБС.Видимость          = Видимость;
	Элементы.ЗарегистрироватьБизнесСеть.Видимость          = НЕ Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекстОшибкиПриРегистрацииВБизнесСети(Знач ТекстОшибки)
	
	Элементы.ДекорацияТекстОшибкиРегистрацииБС.Заголовок = ТекстОшибки;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьОжиданияПодключенияБС(Знач Видимость, Элементы)
	
	Если Элементы.ДекорацияКартинкаОжиданиеПодключениеБС.Видимость <> Видимость Тогда
		Элементы.ДекорацияКартинкаОжиданиеПодключениеБС.Видимость = Видимость;
		Элементы.ДекорацияНадписьОжиданиеПодключениеБС.Видимость  = Видимость;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьОрганизациюВБСЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ТекстНеУдалосьПодключить = Нстр("ru = 'Не удалось подключить организацию.'");
	ПодробностиОшибки = "";
	ДанныеСервиса = Неопределено;
	
	Если Результат = Неопределено Тогда
		ОшибкаЗаданияПодключения = Истина;
	ИначеЕсли Не Результат.Свойство("АдресРезультата") Тогда 
		ОшибкаЗаданияПодключения = Истина;
	ИначеЕсли Не ЭтоАдресВременногоХранилища(Результат.АдресРезультата) Тогда 
		ОшибкаЗаданияПодключения = Истина;
	Иначе
		ДанныеСервиса = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		ОшибкаЗаданияПодключения = Не ЗначениеЗаполнено(ДанныеСервиса);
	КонецЕсли;
	
	Если Результат.Свойство("Сообщения") И ЗначениеЗаполнено(Результат.Сообщения) Тогда
		Сообщения = Новый Массив;
		Для каждого ЭлементКоллекции Из Результат.Сообщения Цикл
			Сообщения.Добавить(ЭлементКоллекции.Текст);
		КонецЦикла;
		
		ПодробностиОшибки = СтрСоединить(Сообщения, " ");
	КонецЕсли;
	
	ТекстОшибки = СтрШаблон("%1%2", ТекстНеУдалосьПодключить, ?(Не ПустаяСтрока(ПодробностиОшибки), " "+ПодробностиОшибки, ""));
	
	Если ОшибкаЗаданияПодключения Тогда 
		Если ЕстьПравоНаПросмотрЖурналаРегистрации Тогда
			МассивСтрок = Новый Массив;
			МассивСтрок.Добавить(ТекстОшибки);
			МассивСтрок.Добавить(Символы.ПС);
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru ='Подробнее.'"),,,, "ЖурналРегистрации"));
			ТекстОшибки = Новый ФорматированнаяСтрока(МассивСтрок);
		КонецЕсли;
		
		УстановитьВидимостьОшибкиРегистрацииВБизнесСети(Истина, Элементы);
		УстановитьТекстОшибкиПриРегистрацииВБизнесСети(ТекстОшибки);
		УстановитьВидимостьОжиданияПодключенияБС(Ложь, Элементы);
		
		Возврат;
	КонецЕсли;
	
	Если ДанныеСервиса.СтатусПодключения = "Подключена" Тогда
		
		Оповестить("Запись_НаборКонстант",, "ИспользоватьОбменБизнесСеть");
		Оповестить("БизнесСеть_РегистрацияОрганизаций",, ВладелецФормы);
		
		УстановитьВидимостьОшибкиРегистрацииВБизнесСети(Ложь, Элементы);
		ОрганизацияЗарегистрированаВБС = Истина;
		СохранитьНастройкиПомощника();
		ПодготовитьСтраницуЗавершенияПодключенияБС();
		ПерейтиНаСтраницу(Элементы.СтраницаУспешногоЗавершенияПодключенияБС.Имя, Ложь);
		
	Иначе

		Если ЕстьПравоНаПросмотрЖурналаРегистрации Тогда
			МассивСтрок = Новый Массив;
			МассивСтрок.Добавить(ТекстОшибки);
			МассивСтрок.Добавить(Символы.ПС);
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(НСтр("ru ='Подробнее.'"),,,, "ЖурналРегистрации"));
			ТекстОшибки = Новый ФорматированнаяСтрока(МассивСтрок);
		КонецЕсли;
		
		УстановитьВидимостьОшибкиРегистрацииВБизнесСети(Истина, Элементы);
		УстановитьТекстОшибкиПриРегистрацииВБизнесСети(ТекстОшибки);
		
	КонецЕсли;
	
	УстановитьВидимостьОжиданияПодключенияБС(Ложь, Элементы);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьРегистрацияОрганизацииВБС(Знач Организация)
	
	Возврат БизнесСеть.ОрганизацияПодключена(Организация);
	
КонецФункции

&НаКлиенте
Процедура ПерейтиКСледующемуШагуПослеПодключенияБС()
	
	Если ОбменЭДО И ОбменДокументамиСКонтрагентами Тогда
		СохранитьНастройкиПомощника();
		Если НЕ КриптопровайдерУстановлен Тогда
			ПроверитьУстановкуРасширенияКриптографии();
		Иначе
			ПерейтиНаСтраницуНеПройденногоЭтапа();
		КонецЕсли;
	Иначе
		БольшеНеПоказывать = Истина;
		СохранитьНастройкиПомощника();
		ПерейтиНаСтраницуНеПройденногоЭтапа();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПодготовитьСтраницуРегистрацииБС()
	
	ДанныеОрганизацииВBase64 = БизнесСеть.ДанныеОрганизацииВBase64(Организация);
	Элементы.ДекорацияЗавершениеПодключенияБС.Заголовок = СтроковыеФункции.ФорматированнаяСтрока(
		СтрШаблон(НСтр("ru = 'Организация <b>%1</b> успешно подключена к сервису 1С:Бизнес-сеть.'"), НаименованиеОрганизации));
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПодготовитьСтраницуЗавершенияПодключенияБС()
	
	Если СхемаКартинкиШагов = 3 ИЛИ СхемаКартинкиШагов = 6 Тогда
		Элементы.ЗавершитьПодключениеБСГотово.Видимость = Истина;
		Элементы.ЗавершитьПодключениеБС.Видимость       = Ложь;
		
		БольшеНеПоказывать = Истина;
		СохранитьНастройкиПомощника();
	КонецЕсли;
	
	ЭтапНастройки = ЭтапНастройкиЗавершениеБС();
	
КонецПроцедуры

