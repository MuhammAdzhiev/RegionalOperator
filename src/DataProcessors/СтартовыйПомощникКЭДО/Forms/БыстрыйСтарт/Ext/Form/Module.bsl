	Возврат "ПодключениеИПП";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПодключенияИПП(Видимость, Элементы)
	
	Элементы.ДекорацияКартинкаОшибкиПодключения.Видимость = Видимость;
	Элементы.ДекорацияТекстОшибкиИПП.Видимость            = Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьИнтернетПоддержку()
	
	УстановитьДоступностьВидимостьЭлементовОжиданияПодключенияИПП(Истина);
	
	ТекстОшибки        = Неопределено;
	ЕстьТекстПодробнее = Ложь;
	
	ПодключенаИнтернетПоддержка = ПроверитьАутентификациюПользователя(ЛогинИнтернетПоддержки, ПарольИнтернетПоддержки,
		ТекстОшибки, ЕстьТекстПодробнее);
	
	Если НЕ ПодключенаИнтернетПоддержка Тогда
		
		Если ЕстьТекстПодробнее И ЭтоПолноправныйПользователь Тогда
			Элементы.ДекорацияТекстОшибкиИПП.Заголовок = ТекстОшибкиССсылкойНаЖурналРегистрации(ТекстОшибки);
		Иначе
			Элементы.ДекорацияТекстОшибкиИПП.Заголовок = ТекстОшибки;
		КонецЕсли;

		УстановитьВидимостьПодключенияИПП(Истина, Элементы);
				
	Иначе
		
		УстановитьВидимостьПодключенияИПП(Ложь, Элементы);
		
		ПодключенСервис1СКонтрагент = ПроверитьПодключениеСервиса1СКонтрагентНаТестовыхДанных();
		
		ПроверитьИСохранитьПользователяНастройкиСистемы();
		Страница = СтраницаЗаполненияОрганизации();
		
		ПерейтиНаСтраницу(Страница.Имя, Ложь);
		
	КонецЕсли;

	УстановитьДоступностьВидимостьЭлементовОжиданияПодключенияИПП(Ложь);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьАутентификациюПользователя(Знач Логин, Знач Пароль, ТекстОшибки, ЕстьТекстПодробнее)
	
	ДанныеАутентификации = Новый Структура("Логин, Пароль",
		Логин,
		Пароль);
	СохранитьДанныеАутентификацииИПП(ДанныеАутентификации);

	Отказ          = Ложь;
	ТекстПодробнее = НСтр("ru = 'Подробнее см. в журнале регистрации.'");
	
	Попытка
		
		УстановитьПривилегированныйРежим(Истина);
		Результат = ИнтернетПоддержкаПользователей.ТикетАутентификацииНаПорталеПоддержки("https://api.orgregister.1c.ru/orgregister/");
		УстановитьПривилегированныйРежим(Ложь);
		
		Если ЗначениеЗаполнено(Результат.КодОшибки) Тогда
			Отказ = Истина;
			ТекстОшибки = Результат.СообщениеОбОшибке;
			
			Если СтрНайти(ТекстОшибки, ТекстПодробнее) > 0 Тогда
				ТекстОшибки = СтрЗаменить(ТекстОшибки, ТекстПодробнее, "");
				ЕстьТекстПодробнее = Истина;
			КонецЕсли;
		КонецЕсли;
		
	Исключение
		Отказ = Истина;
		ТекстОшибки = НСтр("ru = 'Не удалось подключиться к порталу 1С:ИТС.'");
		ТекстСообщения = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Подключение интернет-поддержки пользователей'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
		ЕстьТекстПодробнее = Истина;
	КонецПопытки;
	
	Если Отказ Тогда
		// Отключаем интернет-поддержку.
		СохранитьДанныеАутентификацииИПП(Неопределено);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьДанныеАутентификацииИПП(ДанныеАутентификации)
	
	УстановитьПривилегированныйРежим(Истина);
	ИнтернетПоддержкаПользователей.СохранитьДанныеАутентификации(ДанныеАутентификации);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

