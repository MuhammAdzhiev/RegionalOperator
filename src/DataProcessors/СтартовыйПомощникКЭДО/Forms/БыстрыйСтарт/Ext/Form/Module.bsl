Функция ЭтапНастройкиУстановкаЭЦП()
	
	Возврат "УстановкаЭЦП";
	
КонецФункции

&НаКлиенте
Функция ЭтапНастройкиОтправленоЗаявление()
	
	Возврат "ОтправленоЗаявление";
	
КонецФункции

&НаКлиенте
Функция ЭтапНастройкиДобавлениеЭЦП()
	
	Возврат "ДобавлениеЭЦП";
	
КонецФункции

&НаКлиенте
Процедура ПодготовитьСтраницуВыбораЭЦП()
	
	Элементы.Сертификат.СписокВыбора.ЗагрузитьЗначения(ДействующиеСертификатыЭЦП.ВыгрузитьЗначения());
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьСтраницуОжиданияЭЦП()
	
	Если СостояниеСертификатаКриптографии = ПредопределенноеЗначение("Перечисление.СостоянияЗаявленияНаВыпускСертификата.НеПодготовлено")
		ИЛИ СостояниеСертификатаКриптографии = ПредопределенноеЗначение("Перечисление.СостоянияЗаявленияНаВыпускСертификата.Подготовлено") Тогда
		Элементы.СтраницыОжиданияСертификатаЭЦП.ТекущаяСтраница = Элементы.СтраницаНеПодготовленногоЗаявления;
		ЭтапНастройки = ЭтапНастройкиУстановкаЭЦП();
	ИначеЕсли СостояниеСертификатаКриптографии = ПредопределенноеЗначение("Перечисление.СостоянияЗаявленияНаВыпускСертификата.Отправлено") Тогда
		Если ТребуетсяПроверкаСостоянияСертификата Тогда
			ЭтапНастройки = ЭтапНастройкиОтправленоЗаявление();
			Если ЗначениеЗаполнено(ОписаниеОшибкиЗаявления) Тогда
				Элементы.СтраницыОжиданияСертификатаЭЦП.ТекущаяСтраница = Элементы.СтраницаОшибкиСертификата;
				ТекстПодробнееВЖурнале = НСтр("ru = 'Подробнее см. в журнале регистрации.'");
				Если СтрНайти(ОписаниеОшибкиЗаявления, ТекстПодробнееВЖурнале)> 0 Тогда
					ОписаниеОшибкиЗаявления = СтрЗаменить(ОписаниеОшибкиЗаявления, ТекстПодробнееВЖурнале, "");
					ТекстОшибки = ТекстОшибкиССсылкойНаЖурналРегистрации(ОписаниеОшибкиЗаявления);
				Иначе
					ТекстОшибки = ОписаниеОшибкиЗаявления;
				КонецЕсли;
				
				Элементы.ДекорацияНадписьОшибкиСертификата.Заголовок    = ТекстОшибки;
			Иначе
				Элементы.СтраницыОжиданияСертификатаЭЦП.ТекущаяСтраница = Элементы.СтраницаОжиданияСертификата;
			КонецЕсли;
		Иначе
			Элементы.СтраницыОжиданияСертификатаЭЦП.ТекущаяСтраница = Элементы.СтраницаОтправленногоСертификата;
			ЭтапНастройки = ЭтапНастройкиОтправленоЗаявление();
		КонецЕсли;
	ИначеЕсли СостояниеСертификатаКриптографии = ПредопределенноеЗначение("Перечисление.СостоянияЗаявленияНаВыпускСертификата.ИсполненоСертификатНеУстановлен")
		Или СостояниеСертификатаКриптографии = ПредопределенноеЗначение("Перечисление.СостоянияЗаявленияНаВыпускСертификата.ИсполненоРаспискаНеОтправлена") Тогда
		Элементы.СтраницыОжиданияСертификатаЭЦП.ТекущаяСтраница = Элементы.СтраницаПолученногоСертификата;
		ЭтапНастройки = ЭтапНастройкиДобавлениеЭЦП();
	ИначеЕсли СостояниеСертификатаКриптографии = ПредопределенноеЗначение("Перечисление.СостоянияЗаявленияНаВыпускСертификата.Отклонено") Тогда
		Элементы.СтраницыОжиданияСертификатаЭЦП.ТекущаяСтраница = Элементы.СтраницаСертификатОтклонен;
		ЭтапНастройки = ЭтапНастройкиУстановкаЭЦП();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьНаличиеУстановленныхСертификатов(Знач Организация, Знач ТекущийПользователь)
	
	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(
	"ВЫБРАТЬ
	|	СертификатыКлючейЭлектроннойПодписиИШифрования.Ссылка КАК Ссылка,
	|	СертификатыКлючейЭлектроннойПодписиИШифрования.Пользователь КАК Пользователь
	|ПОМЕСТИТЬ ДействующиеСертификаты
	|ИЗ
	|	Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования КАК СертификатыКлючейЭлектроннойПодписиИШифрования
	|ГДЕ
	|	НЕ СертификатыКлючейЭлектроннойПодписиИШифрования.ПометкаУдаления
	|	И СертификатыКлючейЭлектроннойПодписиИШифрования.ДействителенДо >= &ДействителенДо
	|	И НЕ СертификатыКлючейЭлектроннойПодписиИШифрования.Отозван
	|	И СертификатыКлючейЭлектроннойПодписиИШифрования.Организация = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДействующиеСертификаты.Ссылка КАК Ссылка
	|ИЗ
	|	ДействующиеСертификаты КАК ДействующиеСертификаты
	|ГДЕ
	|	ДействующиеСертификаты.Пользователь = &Пользователь
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ДействующиеСертификаты.Ссылка
	|ИЗ
	|	ДействующиеСертификаты КАК ДействующиеСертификаты
	|ГДЕ
	|	ДействующиеСертификаты.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)"
	);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДействителенДо"          , КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Организация"             , Организация);
	Запрос.УстановитьПараметр("Пользователь"            , ТекущийПользователь);
	
	НеуказанныйПользователь = Пользователи.СсылкаНеуказанногоПользователя();
	Запрос.УстановитьПараметр("НеуказанныйПользователь" , НеуказанныйПользователь);
	
	Если НеуказанныйПользователь <> Неопределено Тогда
		ЧастиЗапроса.Добавить(
		"ВЫБРАТЬ
		|	ДействующиеСертификаты.Ссылка
		|ИЗ
		|	ДействующиеСертификаты КАК ДействующиеСертификаты
		|ГДЕ
		|	ДействующиеСертификаты.Пользователь = &НеуказанныйПользователь"
		);
	КонецЕсли;
	
	Разделитель = "
	|ОБЪЕДИНИТЬ
	|";
	
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, Разделитель);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаКлиенте
Процедура ОбработатьСертификатЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("Ссылка") И ЗначениеЗаполнено(Результат.Ссылка) Тогда

		СертификатЭЦП = Результат.Ссылка;
		
		СведенияЗаявления = ПолучитьСтатусЗаявленияНаСертификат(СертификатЭЦП);
		СостояниеСертификатаКриптографии = СведенияЗаявления.СостояниеЗаявления;
		
		Если СостояниеСертификатаКриптографии = ПредопределенноеЗначение("Перечисление.СостоянияЗаявленияНаВыпускСертификата.ПустаяСсылка") Тогда
			СохранитьНастройкиПомощника();
			ЭтапНастройки = ЭтапНастройкиДобавлениеЭЦП();
			ПерейтиНаСтраницу("СтраницаДобавлениеЭЦП", Ложь);
		Иначе
			ЗаказанНовыйСертификатЭЦП       = Истина;
			СохранитьНастройкиПомощника();
			
			Если СостояниеСертификатаКриптографии <> ПредопределенноеЗначение("Перечисление.СостоянияЗаявленияНаВыпускСертификата.Исполнено") Тогда
				ПодготовитьСтраницуОжиданияЭЦП();
				ПерейтиНаСтраницу("СтраницаЗаказаЭЦПОжидание", Ложь);
			Иначе
				ЭтапНастройки = ЭтапНастройкиДобавлениеЭЦП();
				ПерейтиНаСтраницу("СтраницаДобавлениеЭЦП", Ложь);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Если Элементы.ДекорацияКартинкаОжиданияУстановкиЭЦП.Видимость Тогда
		УстановитьВидимостьОжиданияУстановкиЭЦП(Ложь, Элементы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьОжиданияУстановкиЭЦП(Знач Видимость, Элементы)
	
	Элементы.ДекорацияКартинкаОжиданияУстановкиЭЦП.Видимость = Видимость;
	Элементы.ДекорацияНадписьОжиданиеУстановкиЭЦП.Видимость  = Видимость;
	Элементы.ГиперссылкаВыход_10.Видимость                   = НЕ Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияВыбораСертификата(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПерейтиНаСтраницуВперед();
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСвойствоСубъектаСертификата(Знач Сертификат)
	
	Возврат КриптографияБЭД.СвойстваСубъектаСертификатаПоСсылке(Сертификат);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСтатусЗаявленияНаСертификат(Знач Сертификат)
	
	СостояниеЗаявления = Обработки.ЗаявлениеНаВыпускНовогоКвалифицированногоСертификата.СостояниеЗаявления(Сертификат);
	ПометкаУдаления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сертификат, "ПометкаУдаления");
	
	СведенияЗаявления = Новый Структура;
	СведенияЗаявления.Вставить("СостояниеЗаявления", СостояниеЗаявления);
	СведенияЗаявления.Вставить("ПометкаУдаления", ПометкаУдаления);
	
	Возврат СведенияЗаявления;
	
КонецФункции

&НаСервере
Функция ПроверитьСостояниеСертификатаКриптографии()
	
	Возврат Обработки.СтартовыйПомощникКЭДО.ПолучитьСтатусНовогоСертификатаКриптографии(СертификатЭЦП, ОписаниеОшибкиЗаявления, ЕстьПравоНаПросмотрЖурналаРегистрации);
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуЗаявленияНаВыпускНовогоСертификата()
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("СертификатСсылка", СертификатЭЦП);
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьСертификатЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.ЗаявлениеНаВыпускНовогоКвалифицированногоСертификата.Форма.Форма", ПараметрыОткрытия,
		ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область СтраницаРегистрацииЭДО

&НаКлиенте
Функция ЭтапНастройкиЭДО()
	
	Возврат "ЭДО";
	
КонецФункции

&НаКлиенте
Функция ЭтапНастройкиЗавершениеЭДО()
	
	Возврат "ЗавершениеЭДО";
	
КонецФункции

&НаКлиенте
Процедура ПодготовитьСтраницуРегистрацииОператораЭДО()
	
	ЭтапНастройки = ЭтапНастройкиЭДО();

	ДанныеОрганизации = ПолучитьДанныеОрганизацииДляРегистрацииОператораЭДО(Организация);
	
	ЮрАдрес             = ДанныеОрганизации.ЮрАдрес;
	ЗначениеПолейАдреса = ДанныеОрганизации.ЗначениеПолейАдреса;
	КодФНС              = ДанныеОрганизации.КодНалоговогоОргана;
	ОГРНОрганизации     = ДанныеОрганизации.ОГРН;

	Если НЕ ЭтоЮридическоеЛицо Тогда
		Элементы.ОГРНОрганизации.Заголовок      = НСтр("ru = 'ОГРНИП'");
		Элементы.ОГРНОрганизации.ПодсказкаВвода = НСтр("ru = '15 цифр'");
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьДанныеОрганизации(Организация, ДанныеОрганизации, ЭтоТакском)
	
	Если ДанныеОрганизации.ОГРНИзменен Тогда
		ЗаписатьОГРНОрганизации(Организация, ДанныеОрганизации.ОГРН);
	КонецЕсли;
	
	Если ДанныеОрганизации.АдресИзменен Тогда
		ЗаписатьЮридическийАдресОрганизации(Организация, ДанныеОрганизации.ЮрАдрес);
		ДанныеОрганизации.АдресИзменен = Ложь;
	КонецЕсли;
	
	Если ДанныеОрганизации.ТелефонИзменен И ЭтоТакском Тогда
		ЗаписатьТелефонОрганизации(Организация, ДанныеОрганизации.Телефон);
		ДанныеОрганизации.ТелефонИзменен = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьЮридическийАдресОрганизации(Организация, Знач ЮрАдрес)
	
	УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Организация, ЮрАдрес,
		Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации, ТекущаяДатаСеанса(), Истина);
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьТелефонОрганизации(Знач Организация, Знач Телефон)
	
	УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Организация, Телефон,
		Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации, ТекущаяДатаСеанса(), Истина);
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьОГРНОрганизации(Знач Организация, Знач ОГРНОрганизации)
	
	ОбъектОрганизации = Организация.ПолучитьОбъект();
	ОбъектОрганизации.ОГРН = ОГРНОрганизации;
	НачатьТранзакцию();
	Попытка
		ОбъектОрганизации.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
	КонецПопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеОрганизацииДляРегистрацииОператораЭДО(Знач Организация)
	
	Возврат КлиентЭДО.ПолучитьРеквизитыОрганизацииДляРегистрационногоПакета(Организация);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьДанныеОператоровЭДО(Результат, ДополнительныеПараметры) Экспорт
	
	ДлительнаяОперацияПолученияОператоровЭДО = Неопределено;
	
	ЗаполнитьПодключенныхОператоровЭДО();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодключенныхОператоровЭДО()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОператорыЭДО.ИНН КАК ИНН,
	|	ОператорыЭДО.КПП КАК КПП,
	|	ОператорыЭДО.ОГРН КАК ОГРН,
	|	ОператорыЭДО.ОтпечатокСертификата КАК Сертификат,
	|	ОператорыЭДО.СпособОбменаЭД КАК СпособОбменаЭД,
	|	ОператорыЭДО.Представление КАК Наименование,
	|	ОператорыЭДО.ИдентификаторОператора КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ОператорыЭДО КАК ОператорыЭДО
	|ГДЕ
	|	ОператорыЭДО.ДоступноПодключениеЧерез1С";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	ТаблицаОператоровЭДО.Загрузить(РезультатЗапроса);
	
	МассивОператоровЭДО = РезультатЗапроса.ВыгрузитьКолонку("Наименование");
	
	Элементы.ОператорЭДОПодключенныйК1СЭДО.СписокВыбора.ЗагрузитьЗначения(МассивОператоровЭДО);

	Если ЗначениеЗаполнено(МассивОператоровЭДО) Тогда
		ОператорЭДО = МассивОператоровЭДО[0];
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьОжиданиеПолученияИдентификаторовЭДО()
	
	Если НЕ ЗначениеЗаполнено(ДлительнаяОперацияПолученияОператоровЭДО)
		ИЛИ ЗначениеЗаполнено(ОператорЭДО) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	Описание = Новый ОписаниеОповещения("ОбработатьДанныеОператоровЭДО", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперацияПолученияОператоровЭДО, Описание, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДанныеВыбранногоОператора()
	
	Для Каждого Оператор Из ТаблицаОператоровЭДО Цикл
		
		Если Оператор.Наименование = ОператорЭДО Тогда
			
			ИдентификаторОператораЭДО = Оператор.Идентификатор;
			СпособОбменаЭД            = Оператор.СпособОбменаЭД;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимость1СТакском(Знач Видимость, Элементы, СпособОбменаЭД)
	
	Элементы.НадписьПодключениеТакскомВМоделиСервиса.Видимость = Видимость;
	Элементы.ЮрАдрес.Видимость                                 = НЕ Видимость;
	Элементы.КодФНС.Видимость                                  = НЕ Видимость И Не ЭтоОператор1СТакском(СпособОбменаЭД);
	Элементы.Телефон.Видимость                                 = НЕ Видимость И ЭтоОператор1СТакском(СпособОбменаЭД);
	Элементы.ОГРНОрганизации.Видимость                         = НЕ Видимость;
	Если Элементы.ИдентификаторЭДО.Видимость Тогда
		Элементы.ИдентификаторЭДО.Видимость                    = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьОшибкиОператораЭДО(Знач Видимость, Элементы)
	
	Элементы.ДекорацияКартинкаОшибкиРегистрацииЭДО.Видимость = Видимость;
	Элементы.ДекорацияТекстОшибкиРегистрации.Видимость = Видимость;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПараметрыВидаКонтактнойИнформации(ВидКонтактнойИнформации)

	Возврат УправлениеКонтактнойИнформацией.ПараметрыВидаКонтактнойИнформации(ВидКонтактнойИнформации);

КонецФункции

&НаКлиенте
Процедура ОткрытьФормуКонтактнойИнформацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		АдресИзменен        = Истина;
		ЮрАдрес             = Результат.Представление;
		ЗначениеПолейАдреса = Результат.Значение;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыПодключенияКЭДО()
	
	ДанныеПодключенияКЭДО = СинхронизацияЭДОКлиентСервер.НоваяОперацияПодключенияЭДО();
	
	ПараметрыРегистрации = ДанныеПодключенияКЭДО.Параметры;
	ПараметрыРегистрации.КодНалоговогоОргана         = КодФНС;
	ПараметрыРегистрации.ОператорЭДО                 = ИдентификаторОператораЭДО;
	ПараметрыРегистрации.Организация                 = Организация;
	ПараметрыРегистрации.СпособОбменаЭД              = СпособОбменаЭД;
	ПараметрыРегистрации.АдресОрганизации            = ЮрАдрес;
	ПараметрыРегистрации.НаименованиеУчетнойЗаписи   = СтрШаблон(НСтр("ru = '%1, %2'"), Организация, СпособОбменаЭД);
	ПараметрыРегистрации.НазначениеУчетнойЗаписи     = НСтр("ru = 'Основная'");
	ПараметрыРегистрации.ПринятыУсловияИспользования = Истина;
	ПараметрыРегистрации.Сертификат                  = СертификатЭЦП;
	
	ПараметрыРегистрации.Вставить("АдресОрганизацииЗначение", ЗначениеПолейАдреса);
	
	Если ЗначениеЗаполнено(ИдентификаторЭДО) Тогда
		ДанныеПодключенияКЭДО.Результат.ИдентификаторЭДО = ИдентификаторЭДО;
		СпособОбменаАбонента = СпособОбменаАбонентаНаСервере(ИдентификаторЭДО);
		Если ЗначениеЗаполнено(СпособОбменаАбонента) Тогда
			ДанныеПодключенияКЭДО.Параметры.СпособОбменаЭД = СпособОбменаАбонента;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторЗаявки) Тогда
		ДанныеПодключенияКЭДО.Результат.НомерЗаявки = ИдентификаторЗаявки;
	КонецЕсли;
	
	СлужебныеПараметры = ДанныеПодключенияКЭДО.СлужебныеПараметры;
	СлужебныеПараметры.ОткрыватьФормуДлительнойОперации   = Ложь;
	
	СлужебныеПараметры.Вставить("ПоказатьЗапросПродолжения", Ложь);
	СлужебныеПараметры.Вставить("ВключеноРазделениеДанных" , ВключеноРазделениеДанных);
	
	Если СтрНайти(НРег(ОператорЭДО), "такском") > 0 Тогда
		ОповещениеОжиданиеОбработки = Новый ОписаниеОповещения("ВыполнитьОжиданиеОбработкиЗаявленияТакском", ЭтотОбъект);
		СлужебныеПараметры.Вставить("ПроцедураПроверкиЗаявленияТакском", ОповещениеОжиданиеОбработки);
	КонецЕсли;

	Возврат ДанныеПодключенияКЭДО;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПодключениеКЭДОЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	КонтекстОперацииПодключенияЭДО = "";
	
	Если Результат.Свойство("ОперацияЭДО") Тогда
		ОперацияЭДО = Результат.ОперацияЭДО;
		КонтекстОперацииПодключенияЭДО = ОперацияЭДО.СлужебныеПараметры.КонтекстДиагностики;
	КонецЕсли;
	
	ЗаблокироватьПоляЗаполненияРегистрацииЭДО(Ложь);

	Если НЕ Результат.Выполнено И ЗначениеЗаполнено(КонтекстОперацииПодключенияЭДО)
		И ЗначениеЗаполнено(КонтекстОперацииПодключенияЭДО.Диагностика.Ошибки) Тогда
		УстановитьВидимостьОшибкиОператораЭДО(Истина, Элементы);
		Элементы.СтраницыКомандЭДО.ТекущаяСтраница = Элементы.СтраницаКомандыРегистрации;
	ИначеЕсли Результат.Выполнено Тогда
		УстановитьВидимостьОшибкиОператораЭДО(Ложь, Элементы);
		ЭДОПодключен       = Истина;
		ИдентификаторЭДО   = ОперацияЭДО.Результат.УчетнаяЗапись;
		БольшеНеПоказывать = Истина;
		СохранитьНастройкиПомощника();
		ЗапуститьПроверкуПриглашенийЭДО();
		ПерейтиНаСтраницуНеПройденногоЭтапа();
	Иначе
		СохранитьИдентификаторЗаявки(ОперацияЭДО.Результат.НомерЗаявки);
		СохранитьИдентификаторЭДО(ОперацияЭДО.Результат.ИдентификаторЭДО);
		УстановитьВидимостьОшибкиОператораЭДО(Ложь, Элементы);
		Элементы.СтраницыКомандЭДО.ТекущаяСтраница = Элементы.СтраницаКомандыРегистрации;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОжиданиеОбработкиЗаявленияТакском(Результат, ДополнительныеПараметры) Экспорт
	
	ОбработчикРезультатаЗаявкиТакском = Результат.ОбработчикПродолженияПроверкиЗаявкиТакском;
	ДействиеОбработкиЗаявкиТакском    = Результат.ДействиеОбработкиЗаявкиТакском;
	
	ПодключитьОбработчикОжидания("Подключаемый_ОжиданиеОбработкиЗаявкиТакском", 10, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОжиданиеОбработкиЗаявкиТакском()
	
	ВыполнитьОбработкуОповещения(ОбработчикРезультатаЗаявкиТакском, ДействиеОбработкиЗаявкиТакском);

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьПроверкуПриглашенийЭДО()
	
	Оповещение = Новый ОписаниеОповещения("ОбновитьСтатусыПриглашенийПослеАвторизации", ЭтотОбъект);
	КонтекстДиагностики = ОбработкаНеисправностейБЭДКлиент.НовыйКонтекстДиагностики();	
	СинхронизацияЭДОКлиент.АвторизоватьсяВСервисеЭлектронногоДокументооборота(Оповещение, КонтекстДиагностики);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусыПриглашенийПослеАвторизации(РезультатАвторизации, ДополнительныеПараметры) Экспорт
	
	ОбработкаНеисправностейБЭДКлиент.ОбработатьОшибки(РезультатАвторизации.КонтекстДиагностики);
	
	КлиентЭДОКлиент.НачатьОжиданиеОбновленияИнформацииПоПриглашениямВ1СЭДО(
		РезультатАвторизации.КлючиСинхронизации, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаблокироватьПоляЗаполненияРегистрацииЭДО(Знач Видимость)
	
	Элементы.ОператорЭДОПодключенныйК1СЭДО.ТолькоПросмотр = Видимость;
	Элементы.ЮрАдрес.ТолькоПросмотр                       = Видимость;
	Элементы.ОГРНОрганизации.ТолькоПросмотр               = Видимость;
	Элементы.КодФНС.ТолькоПросмотр                        = Видимость;
	Элементы.Телефон.ТолькоПросмотр                       = Видимость;
	Элементы.ИдентификаторЭДО.ТолькоПросмотр              = Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменаОперацииРегистрацииЭДО(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОтменитьРегистрациюЭДО = Истина;
		Если ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
			ИнтеграцияБСПБЭДВызовСервера.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
		Иначе
			Элементы.СтраницыКомандЭДО.ТекущаяСтраница = Элементы.СтраницаКомандыРегистрации;
		КонецЕсли;
		ЗаблокироватьПоляЗаполненияРегистрацииЭДО(Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПрогрессВыполнения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено
		И Результат.Свойство("ИдентификаторЗадания") Тогда
		ИдентификаторЗадания = Результат.ИдентификаторЗадания;
	КонецЕсли;
	
	НомерЗаявки = "";
	Если ДополнительныеПараметры.Свойство("ИдентификаторЗаявки", НомерЗаявки) Тогда
		СохранитьИдентификаторЗаявки(НомерЗаявки);
	КонецЕсли;
	
	УчетнаяЗаписьЭДО = "";
	Если ДополнительныеПараметры.Свойство("ИдентификаторЭДО", УчетнаяЗаписьЭДО) Тогда
		СохранитьИдентификаторЭДО(УчетнаяЗаписьЭДО);
	КонецЕсли;
	
	Если ОтменитьРегистрациюЭДО Тогда
		Если Результат <> Неопределено
			И Результат.Статус <> "Выполнено" Тогда
			ИнтеграцияБСПБЭДВызовСервера.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
		КонецЕсли;
		
		Если ДополнительныеПараметры.Свойство("ОтмененаРегистрацияЭДО") Тогда
			ДополнительныеПараметры.ОтмененаРегистрацияЭДО = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИдентификаторЗаявки(НомерЗаявки);
	
	Если ЗначениеЗаполнено(НомерЗаявки)
		И НомерЗаявки <> ИдентификаторЗадания Тогда
		ИдентификаторЗаявки = НомерЗаявки;
		
		НайденноеЗначение = СписокЗаявокИОператоровЭДО.НайтиПоЗначению(ИдентификаторОператораЭДО);
		Если НайденноеЗначение = Неопределено Тогда
			СписокЗаявокИОператоровЭДО.Добавить(ИдентификаторОператораЭДО, ИдентификаторЗаявки);
			СохранитьНастройкиПомощника();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИдентификаторЭДО(УчетнаяЗаписьЭДО);
	
	Если ЗначениеЗаполнено(УчетнаяЗаписьЭДО)
		И УчетнаяЗаписьЭДО <> ИдентификаторЭДО Тогда
		ИдентификаторЭДО = УчетнаяЗаписьЭДО;
		СохранитьНастройкиПомощника();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СпособОбменаАбонентаНаСервере(Знач ИдентификаторЭДО)
	
	Возврат ОбменСКонтрагентамиИнтеграция.СпособОбменаАбонентаЭДО(ИдентификаторЭДО);
	
КонецФункции
	
#КонецОбласти

#Область СтраницаПолезныхСсылок

&НаКлиенте
Функция ЭтапНастройкиГотово()
	
	Возврат "Готово";
	
КонецФункции

&НаКлиенте
Процедура ОбработатьОтветВыбораОбменаДокументами(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Ложь Тогда
		ОткрытьФормуПриглашенияЧерезБизнесСеть(ДополнительныеПараметры);
	ИначеЕсли Результат = Истина Тогда
		ОткрытьФормуПриглашенияЧерезЭДО(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПриглашенияЧерезБизнесСеть(ДополнительныеПараметры)
	
	ОткрытьФорму("Обработка.БизнесСеть.Форма.ОтправкаПриглашенийКонтрагентам", ДополнительныеПараметры, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПриглашенияЧерезЭДО(ДополнительныеПараметры)
	
	ОткрытьФорму("РегистрСведений.ПриглашенияКОбменуЭлектроннымиДокументами.Форма.ПомощникОтправкиПриглашения", ДополнительныеПараметры, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьСтраницуСПолезнымиСсылками()
	
	ЭтапНастройки = ЭтапНастройкиГотово();
	Если НЕ ОбменДокументамиСКонтрагентами Тогда
		Элементы.СтраницаВсе.Видимость                            = Истина;
		Если НЕ Поставщик Тогда
			Элементы.ГруппаПродажиВсе.Видимость                   = Ложь;
		ИначеЕсли НЕ Покупатель Тогда
			Элементы.ГруппаЗакупкиВсе.Видимость                   = Ложь;
		КонецЕсли;
	ИначеЕсли Поставщик И Покупатель Тогда
		Элементы.СтраницаВсе.Видимость                            = Истина;
	ИначеЕсли Поставщик И НЕ Покупатель И ОбменДокументамиСКонтрагентами Тогда
		Элементы.СтраницаПродажи.Видимость                        = Истина;
	ИначеЕсли НЕ Поставщик И НЕ Покупатель И ОбменДокументамиСКонтрагентами Тогда
		Элементы.СтраницыТорговли_БезБСиЗакупки.Видимость         = Истина;
		Элементы.СтраницыТорговли_БезБСиЗакупки.ТекущаяСтраница   = Элементы.СтраницаБезБизнесСети;
	ИначеЕсли НЕ Поставщик И Покупатель И ОбменДокументамиСКонтрагентами Тогда
		Элементы.СтраницыТорговли_БезБСиЗакупки.Видимость         = Истина;
		Элементы.СтраницыТорговли_БезБСиЗакупки.ТекущаяСтраница   = Элементы.СтраницаЗакупки;
	КонецЕсли;
	
	Если ОрганизацияЗарегистрированаВБС ИЛИ НЕ ОбменБезЭЦП Тогда
		Элементы.ДекорацияЗарегистрироватьБС.Видимость            = Ложь;
	КонецЕсли;
	
	Если НЕ ОбменДокументамиСКонтрагентами Тогда
		Элементы.ДекорацияПриглашенияКОбменуДокументами.Видимость = Ложь;
	КонецЕсли;
	
	Если НЕ ЭтоПолноправныйПользователь Тогда
		Элементы.ДекорацияНастройкиСинхронизации.Видимость        = Ложь;
		Элементы.ДекорацияНастройкиПользователейИПрав.Видимость   = Ложь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
