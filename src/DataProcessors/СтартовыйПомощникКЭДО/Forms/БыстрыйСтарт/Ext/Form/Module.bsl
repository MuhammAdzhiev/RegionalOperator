// Шаг выбор деятельности.
// Используется для локальной базы и базы запущенной на фреше без услуги Onboarding.
//
&НаКлиенте
Процедура НачатьНастройку(Команда)
	
	Если НЕ (ОбменДокументамиСКонтрагентами ИЛИ Поставщик ИЛИ Покупатель) Тогда
		ОчиститьСообщения();
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать чем планируете заниматься в программе.'"), , "Покупатель");
		Возврат;
	КонецЕсли;
	
	НачатьНастройкуСистемы();
	
КонецПроцедуры

// Стартовая страница настройки системы по услуге Onboarding.
//
&НаКлиенте
Процедура НачатьНастройкуУслуги(Команда)
	
	НачатьНастройкуСистемы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьНастройку(Команда)
	
	НачатаНастройкаСистемы = Истина;
	
	ПроверитьИСохранитьПользователяНастройкиСистемы();
	
	ПерейтиНаСтраницуНеПройденногоЭтапа();
	
КонецПроцедуры

// Шаг подключение к интернет-поддержке.
// Используется только для локальной базы.
//
&НаКлиенте
Процедура ПодключитьИППиПродолжить(Команда)
	
	Если НЕ ЗначениеЗаполнено(ЛогинИнтернетПоддержки) Тогда
		
		ОчиститьСообщения();
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Введите логин'"),, "ЛогинИнтернетПоддержки");
		Возврат;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(ПарольИнтернетПоддержки) Тогда
		
		ОчиститьСообщения();
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Введите пароль'"),, "ПарольИнтернетПоддержки");
		Возврат;
		
	КонецЕсли;
	
	ПодключитьИнтернетПоддержку();
	
КонецПроцедуры

// Шаг заполнение организации.
// Используется для локальной базы и базы запущенной на фреше без услуги Onboarding.
//
