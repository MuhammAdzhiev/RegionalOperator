&НаСервере
Процедура ПолучитьПрограммыЭлектроннойПодписиИШифрования()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Программы.Ссылка КАК Ссылка,
	|	Программы.ИмяПрограммы КАК ИмяПрограммы,
	|	Программы.ТипПрограммы КАК ТипПрограммы,
	|	Программы.ЭтоВстроенныйКриптопровайдер  КАК ЭтоВстроенныйКриптопровайдер 
	|ИЗ
	|	Справочник.ПрограммыЭлектроннойПодписиИШифрования КАК Программы
	|ГДЕ
	|	НЕ Программы.ЭтоВстроенныйКриптопровайдер 
	|	И НЕ Программы.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Программы.Ссылка,
	|	Программы.ИмяПрограммы,
	|	Программы.ТипПрограммы,
	|	Программы.ЭтоВстроенныйКриптопровайдер 
	|ИЗ
	|	Справочник.ПрограммыЭлектроннойПодписиИШифрования КАК Программы
	|ГДЕ
	|	Программы.ЭтоВстроенныйКриптопровайдер 
	|	И &ИспользоватьЭлектроннуюПодписьВМоделиСервиса
	|	И НЕ Программы.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ИспользоватьЭлектроннуюПодписьВМоделиСервиса",
		КриптографияБЭД.ИспользоватьЭлектроннуюПодписьВМоделиСервиса());
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОписаниеПрограммы = Новый Структура;
		Если НЕ Выборка.ЭтоВстроенныйКриптопровайдер  Тогда
			ОписаниеПрограммы.Вставить("ИмяПрограммы" , Выборка.ИмяПрограммы);
		Иначе
			ОписаниеПрограммы.Вставить("ИмяПрограммы" , НСтр("ru = 'Встроенный криптопровайдер'"));
			ОблачныйСервисДоступен = Истина;
		КонецЕсли;
		
		ОписаниеПрограммы.Вставить("ТипПрограммы" , Выборка.ТипПрограммы);
		ОписаниеПрограммы.Вставить("Ссылка"       , Выборка.Ссылка);
		
		ПрограммыКриптографии.Добавить(ОписаниеПрограммы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьСтраницуУстановкиКриптопровайдера()
	
	Если КриптопровайдерУстановлен Тогда
		Элементы.СтраницыУстановкиКриптопровайдера.ТекущаяСтраница      = Элементы.СтраницаПроверенныхПрограмм;
		ТекстУстановленнойПрограммы                                     = НСтр("ru = 'Программа криптографии'")
			+ " " + ПрограммаКриптографии + " " + НСтр("ru = 'установлена на компьютере.'");
		ЭтапНастройки                                                   = ЭтапНастройкиКриптопровайдерЗавершение();
	ИначеЕсли ТребуетсяУстановкаРасширенияКриптографии Тогда
		Элементы.СтраницыУстановкиКриптопровайдера.ТекущаяСтраница      = Элементы.СтраницаУстановкиРасширения;
		Элементы.ДекорацияКартинкаОжиданияУстановкиРасширения.Видимость = Ложь;
		Элементы.ДекорацияНадписьОжиданиеУстановкиРасширения.Видимость  = Ложь;
		ЭтапНастройки                                                   = ЭтапНастройкиУстановкаРасширения();
	Иначе
		Элементы.СтраницыУстановкиКриптопровайдера.ТекущаяСтраница      = Элементы.СтраницаВыбораКриптопровайдера;
		ЭтапНастройки                                                   = ЭтапНастройкиКриптопровайдер();
		Если ОблачныйСервисДоступен Тогда
			Элементы.КриптопровайдерПродолжить.Видимость              = Истина;
			Элементы.УстановитьКриптопровайдер.Видимость              = Ложь;
			Если НЕ ЗначениеЗаполнено(ПрограммаКриптографии) Тогда
				Элементы.СтраницаНадписиВыбораПрограммы.ТекущаяСтраница   = Элементы.СтраницаНадписиОблачныйСервис;
				ТекущийЭлемент                                            = Элементы.ВариантыПрограммыОблачныйСервис;
				ВариантыПрограммы                                         = 2;
				ПрограммаКриптографии                                     = НСтр("ru = 'Облачный сервис'");
			КонецЕсли;
		Иначе
			Элементы.УстановитьКриптопровайдер.Видимость              = Истина;
			Элементы.ВариантыПрограммыОблачныйСервис.Видимость        = Ложь;
			Элементы.КриптопровайдерПродолжить.Видимость              = Ложь;
			Элементы.СтраницаНадписиВыбораПрограммы.ТекущаяСтраница   = Элементы.СтраницаНадписиКриптографии;
			Если НЕ ЗначениеЗаполнено(ПрограммаКриптографии) Тогда
				ТекущийЭлемент                                        = Элементы.ВариантыПрограммыVipNet;
				ВариантыПрограммы                                     = 0;
				ПрограммаКриптографии                                 = НСтр("ru = 'VipNet CSP'");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьУстановкуРасширенияКриптографии()
	
	Оповещение = Новый ОписаниеОповещения("ПроверитьУстановкуРасширенияКриптографииПродолжение", ЭтотОбъект);
	НачатьПодключениеРасширенияРаботыСКриптографией(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьУстановкуРасширенияКриптографииПродолжение(Подключено, ДополнительныеПараметры) Экспорт
		
	ТребуетсяУстановкаРасширенияКриптографии = НЕ Подключено;
	
	Если Подключено Тогда
		ОпределитьУстановленныеПрограммыКриптографии();
	Иначе
		ПерейтиНаСтраницуНеПройденногоЭтапа();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОпределитьУстановленныеПрограммыКриптографии()

	Описание = Новый ОписаниеОповещения("ОпределитьУстановленныеПрограммыКриптографииЗавершение", ЭтотОбъект);
	ЭлектроннаяПодписьКлиент.НайтиУстановленныеПрограммы(Описание, ПрограммыКриптографии.ВыгрузитьЗначения(), Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОпределитьУстановленныеПрограммыКриптографииЗавершение(РезультатУстановленныхПрограмм, ДополнительныеПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(РезультатУстановленныхПрограмм) Тогда
		Возврат;
	КонецЕсли;
	
	ИспользуемыеПрограммы = Новый Соответствие;
	Для Каждого Программа Из ПрограммыКриптографии Цикл
		ИспользуемыеПрограммы.Вставить(Программа.Значение.ИмяПрограммы, Программа.Значение);
	КонецЦикла;

	Для Каждого Программа Из РезультатУстановленныхПрограмм Цикл
		
		Если НЕ Программа.Установлена Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПрограммыКриптографии = Программа.ИмяПрограммы;
		
		ИспользуемаяПрограмма = ИспользуемыеПрограммы.Получить(Программа.ИмяПрограммы);
		Если ИспользуемаяПрограмма = Неопределено Тогда
			Продолжить;
		Иначе
			
			Если СтрНайти(НРег(ИмяПрограммыКриптографии), "vipnet") > 0 Тогда
				ПредставлениеИмениПрограммы = Элементы.ВариантыПрограммыVipNet.СписокВыбора[0].Представление;
			ИначеЕсли СтрНайти(НРег(ИмяПрограммыКриптографии), "crypto") > 0 Тогда
				ПредставлениеИмениПрограммы = Элементы.ВариантыПрограммыCryptoPRO.СписокВыбора[0].Представление;
			Иначе
				ПредставлениеИмениПрограммы = ИспользуемаяПрограмма.ИмяПрограммы;
			КонецЕсли;

			УстановленныеПрограммыКриптографии.Добавить(ИспользуемаяПрограмма.Ссылка, ПредставлениеИмениПрограммы);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если УстановленныеПрограммыКриптографии.Количество() Тогда
		КриптопровайдерУстановлен = Истина;
		ПрограммаКриптографии = УстановленныеПрограммыКриптографии[0].Представление;
	КонецЕсли;
	
	Если НЕ ДействующиеСертификатыЭЦП.Количество() Тогда
		МассивУстановленныхСертификатовЭЦП = ПроверитьНаличиеУстановленныхСертификатов(Организация, ТекущийПользователь);
		
		Если ЗначениеЗаполнено(МассивУстановленныхСертификатовЭЦП) Тогда
			ДействующиеСертификатыЭЦП.ЗагрузитьЗначения(МассивУстановленныхСертификатовЭЦП);
		КонецЕсли;
	КонецЕсли;

	ПерейтиНаСтраницуНеПройденногоЭтапа();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьУстановкуРасширения(Подключен, ДополнительныеПараметры) Экспорт
	
	Если Подключен Тогда
		ТребуетсяУстановкаРасширенияКриптографии = Ложь;
		УстановитьОжиданиеПроверкиУстановленныхПрограмм(Истина);
		ОпределитьУстановленныеПрограммыКриптографии();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОжиданиеПроверкиУстановленныхПрограмм(Знач Видимость)
	
	Элементы.УстановитьРасширениеКриптографии.Доступность           = НЕ Видимость;
	Элементы.ГиперссылкаВыход_7.Видимость                           = НЕ Видимость;
	Элементы.ДекорацияКартинкаОжиданияУстановкиРасширения.Видимость = Видимость;
	Элементы.ДекорацияНадписьОжиданиеУстановкиРасширения.Видимость  = Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьCryptoPRO()
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПовторнаяПроверкаПрограммКриптографии", ЭтотОбъект);
	КриптографияБЭДКлиент.УстановитьCryptoPRO(ОповещениеОЗавершении, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьVipNet()
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПовторнаяПроверкаПрограммКриптографии", ЭтотОбъект);
	КриптографияБЭДКлиент.УстановитьVipNet(ОповещениеОЗавершении, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПовторнаяПроверкаПрограммКриптографии(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Результат)
		ИЛИ Результат = Ложь Тогда
		УстановитьДоступностьВидимостьЭлементовУстановкиКриптопровайдера(Истина);
		Возврат;
	КонецЕсли;
	
	Если Результат.Выполнено Тогда
		ОпределитьУстановленныеПрограммыКриптографии();
		Элементы.ГиперссылкаВыход_8.Доступность = Истина;
	Иначе
		УстановитьДоступностьВидимостьЭлементовУстановкиКриптопровайдера(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьВидимостьЭлементовУстановкиКриптопровайдера(Видимость)
	
	Элементы.УстановитьКриптопровайдер.Доступность          = Видимость;
	Элементы.ВариантыПрограммыVipNet.ТолькоПросмотр         = НЕ Видимость;
	Элементы.ВариантыПрограммыCryptoPRO.ТолькоПросмотр      = НЕ Видимость;
	Элементы.ВариантыПрограммыОблачныйСервис.ТолькоПросмотр = НЕ Видимость;
	Элементы.ГиперссылкаВыход_8.Доступность                 = Видимость;

КонецПроцедуры

#КонецОбласти

