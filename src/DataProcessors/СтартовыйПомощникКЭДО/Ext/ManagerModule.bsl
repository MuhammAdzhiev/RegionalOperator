
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

#Область ПолучениеСостоянияЗаявления

// Возвращает статус заявления на новый сертификат.
// 
// Параметры:
//  ЗаявлениеНаНовыйСертификат - СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования
//  ОписаниеОшибки - Строка
//  ЕстьПравоНаПросмотрЖурналаРегистрации - Булево
// 
// Возвращаемое значение:
//  - ПеречислениеСсылка.СостоянияЗаявленияНаВыпускСертификата
//  - Неопределено 
Функция ПолучитьСтатусНовогоСертификатаКриптографии(ЗаявлениеНаНовыйСертификат, ОписаниеОшибки, ЕстьПравоНаПросмотрЖурналаРегистрации) Экспорт
	
	Попытка
		Обработки.ЗаявлениеНаВыпускНовогоКвалифицированногоСертификата.ОбновитьСостояниеЗаявления(ЗаявлениеНаНовыйСертификат);
	Исключение
		КраткоеПредставлениеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОписаниеОшибки = СтрШаблон(НСтр("ru = 'Ошибка при получении статуса заявления сертификата по причине: %1'"),
			КраткоеПредставлениеОшибки);
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Получение статуса нового сертификата (ЭДО)'",
			ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Если ЕстьПравоНаПросмотрЖурналаРегистрации Тогда
			ОписаниеОшибки = ОписаниеОшибки + Символы.ПС + НСтр("ru = 'Подробнее см. в журнале регистрации'");
		КонецЕсли;
		Возврат Неопределено;
	КонецПопытки;
	
	ДанныеЗаявления = ДанныеЗаявленияНаНовыйСертификат(ЗаявлениеНаНовыйСертификат);
	ОписаниеОшибки = ДанныеЗаявления.СостояниеОбработкиЗаявления;
	
	Возврат ДанныеЗаявления.СостояниеЗаявления;
	
КонецФункции

// Возвращает данные заявления на новый сертификат.
// 
// Параметры:
//  Сертификат - СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования
// 
// Возвращаемое значение:
//  Структура:
// * СостояниеЗаявления - ПеречислениеСсылка.СостоянияЗаявленияНаВыпускСертификата
//                      - Неопределено
// * СостояниеОбработкиЗаявления - Строка
Функция ДанныеЗаявленияНаНовыйСертификат(Сертификат)
	
	ДанныеЗаявления = Новый Структура;
	ДанныеЗаявления.Вставить("СостояниеЗаявления", Неопределено);
	ДанныеЗаявления.Вставить("СостояниеОбработкиЗаявления", "");
		
	МенеджерЗаписи = РегистрыСведений.ЗаявленияНаВыпускСертификата.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Сертификат = Сертификат;
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеЗаявления, МенеджерЗаписи);
		Возврат ДанныеЗаявления;
	Иначе
		Возврат ДанныеЗаявления;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

// Получить реквизиты организации.
// 
// Параметры:
//  ДополнительныеПараметры - Структура:
//  * ЭтоЮридическоеЛицо - Булево
//  * ИННОрганизации - Строка
//  АдресРезультата - Строка
// 
// Возвращаемое значение:
//  Неопределено, Строка - адрес структуры сведений во временном хранилище
Функция ПолучитьРеквизитыОрганизации(ДополнительныеПараметры, АдресРезультата) Экспорт
	
	ЭтоЮридическоеЛицо = ДополнительныеПараметры.ЭтоЮридическоеЛицо;
	ИННОрганизации     = ДополнительныеПараметры.ИННОрганизации;
	
	Если ЭтоЮридическоеЛицо Тогда
		РеквизитыОрганизации = РаботаСКонтрагентами.СведенияОЮридическомЛицеПоИНН(ИННОрганизации).ЕГРЮЛ;
	Иначе
		РеквизитыОрганизации = РаботаСКонтрагентами.РеквизитыПредпринимателяПоИНН(ИННОрганизации);
	КонецЕсли;
	
	Если РеквизитыОрганизации = Неопределено Или ЗначениеЗаполнено(РеквизитыОрганизации.ОписаниеОшибки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ИНН", "");
	Результат.Вставить("КПП", "");   
	Результат.Вставить("Наименование", "");
	Результат.Вставить("НаименованиеСокращенное", "");
	Результат.Вставить("НаименованиеПолное", "");
	Результат.Вставить("Руководитель", "");
	Результат.Вставить("РегистрационныйНомер", "");
	Результат.Вставить("ЮридическийАдрес", Неопределено);
	
	ЗаполнитьЗначенияСвойств(Результат, РеквизитыОрганизации);
	
	Возврат ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецФункции

#КонецОбласти

#КонецЕсли
