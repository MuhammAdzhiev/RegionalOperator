КонецФункции

&НаКлиенте
Процедура ПреобразоватьPDFДокумент()
	
	Если Не ЗначениеЗаполнено(АдресРезультатаВХранилище) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыФайловPDF = Интеграция1СШтампКлиентСервер.ТипыФайловPDFДокумента();
	ТипФайлаPDF   = ТипыФайловPDF.Получить(ФорматСохранения);
	
	Если ТипФайлаPDF = Неопределено Тогда
		
		ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Неподдерживаемая версия формата PDF: %1'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
			ФорматСохранения);
				
		ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки);
		
		Возврат;
		
	КонецЕсли;
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресРезультатаВХранилище);
	
	Попытка
		ДокументPDF = Новый ДокументPDF;
		ДокументPDF.Прочитать(ДвоичныеДанные.ОткрытьПотокДляЧтения());
		
		ПотокДанныхФайла = Новый ПотокВПамяти;
		ДокументPDF.Записать(ПотокДанныхФайла,, ТипФайлаPDF);
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	
	ДвоичныеДанные = ПотокДанныхФайла.ЗакрытьИПолучитьДвоичныеДанные();
	ПоместитьВоВременноеХранилище(ДвоичныеДанные, АдресРезультатаВХранилище);
	
КонецПроцедуры

&НаКлиенте
Функция ДопустимыйФорматСохранения(Знач Расширение)
	
	НедопустимыеФорматы = Новый Массив;
	
	НедопустимыеФорматы.Добавить(РасширениеФайлаXLS());
	НедопустимыеФорматы.Добавить(РасширениеФайлаXLSX());
	НедопустимыеФорматы.Добавить(РасширениеФайлаODS());
	
	Возврат ?(НедопустимыеФорматы.Найти(Расширение) = Неопределено, Расширение, РасширениеФайлаPDF());
	
КонецФункции

&НаКлиенте
Функция ТипФайлаПоРасширению(Знач Расширение)
	
	ТипыФайлов = Новый Соответствие;
	
	ТипыФайлов.Вставить(РасширениеФайлаPDF(),
		НСтр("ru='Документ PDF'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));
	ТипыФайлов.Вставить(ВерсияФайлаPDF_A_1(),
		НСтр("ru='Документ PDF/A-1'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));
	ТипыФайлов.Вставить(ВерсияФайлаPDF_A_2(),
		НСтр("ru='Документ PDF/A-2'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));
	ТипыФайлов.Вставить(ВерсияФайлаPDF_A_3(),
		НСтр("ru='Документ PDF/A-3'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));
	ТипыФайлов.Вставить(РасширениеФайлаDOC(),
		НСтр("ru='Документ Word 97-2003'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));
	ТипыФайлов.Вставить(РасширениеФайлаDOCX(),
		НСтр("ru='Документы Word'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));
	ТипыФайлов.Вставить(РасширениеФайлаODT(),
		НСтр("ru='ODF - Текстовый документ'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));
	ТипыФайлов.Вставить(РасширениеФайлаODS(),
		НСтр("ru='ODF - Электронная таблица'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));
	ТипыФайлов.Вставить(РасширениеФайлаXLS(),
		НСтр("ru='Документ Excel 97-2003'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));
	ТипыФайлов.Вставить(РасширениеФайлаXLSX(),
		НСтр("ru='Документ Excel'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));
	ТипыФайлов.Вставить(РасширениеФайлаRTF(),
		НСтр("ru='Текст в формате RTF'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));
	
	ТипФайла = ТипыФайлов.Получить(Расширение);
	
	Возврат ?(ТипФайла = Неопределено, НСтр("ru='Документ'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()), ТипФайла)
	
КонецФункции

