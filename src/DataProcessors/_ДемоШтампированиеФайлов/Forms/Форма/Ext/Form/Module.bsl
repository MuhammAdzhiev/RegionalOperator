
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьНастройкиПоУмолчанию();
	ЗаполнитьЗначениеКонстант();
	ЗаполнитьТаблицуЗначенийРеквизитов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьЭлементов();
	УстановитьДоступностьЭлементов();
	ЗаполнитьСписокВыбораФорматовРезультата();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВариантРасположенияПриИзменении(Элемент)
	
	ИспользуетсяВариантРасположенияПоКоординатам = ВариантРасположения = ЗначениеВариантРасположенияПоКоординатам;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ГруппаКоординаты",
		"Видимость",
		ИспользуетсяВариантРасположенияПоКоординатам);
		
	ИспользуетсяВариантРасположенияПоТегам = ВариантРасположения = ЗначениеВариантРасположенияПоТегам;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ГруппаРасположениеПоПозиции",
		"Видимость",
		Не ИспользуетсяВариантРасположенияПоТегам);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ГруппаРасположениеПоТегам",
		"Видимость",
		ИспользуетсяВариантРасположенияПоТегам);
		
	Если Не ИспользуетсяВариантРасположенияПоТегам Тогда
		ЗначениеТега = "";
		АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов("ЗначениеТега");
	КонецЕсли;
	
	Если Не ИспользуетсяВариантРасположенияПоКоординатам Тогда
		ОтступОтЛевойГраницы   = 0;
		ОтступОтВерхнейГраницы = 0;
		АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов("ОтступОтЛевойГраницы");
		АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов("ОтступОтВерхнейГраницы");
	КонецЕсли;
	
	ИспользуетсяВариантРасположенияНаКонкретнойСтранице = ВариантРасположения = ЗначениеРасположенияНаКонкретнойСтранице;
	
	Если Не ИспользуетсяВариантРасположенияНаКонкретнойСтранице Тогда
		НомерСтраницыДляРасположенияШтампа = 1;
		АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов("НомерСтраницыДляРасположенияШтампа");
	КонецЕсли;
	
	АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилоРасположенияПриИзменении(Элемент)
	
	УстановитьВидимостьНомерСтраницы();
	АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрозрачностьПриИзменении(Элемент)
	
	ВидимостьГруппы = Прозрачность = ЗначениеПрозрачностиПрозрачный;
	
	УровеньПрозрачности = ?(ВидимостьГруппы,
								ЗначениеУровняПрозрачностиПоУмолчанию,
								ЗначениеУровняПрозрачностиНеПрозрачный);
								
	АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов("УровеньПрозрачности");
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ГруппаПрозрачность",
		"Видимость",
		ВидимостьГруппы);
		
	АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура КоэффициентПрозрачностиПриИзменении(Элемент)
	
	Элементы.УровеньПрозрачности.Заголовок = СтрШаблон(
		НСтр("ru='Уровень прозрачности %1 %%'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
		УровеньПрозрачности);
		
	АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура НомерСтраницыДляРасположенияШтампаПриИзменении(Элемент)
	
	Если НомерСтраницыДляРасположенияШтампа = 0 Тогда
		НомерСтраницыДляРасположенияШтампа = 1;
	КонецЕсли;
	
	АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеТегаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	ЗначениеТега = СтрЗаменить(Текст, " ", "");
	АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтступОтЛевойГраницыПриИзменении(Элемент)
	
	АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтступОтВерхнейГраницыПриИзменении(Элемент)
	
	АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтступОтКраевСтраницыПриИзменении(Элемент)
	
	АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗамещатьТегШтампомПриИзменении(Элемент)
	
	АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантВставкиКартинкиШтампаПриИзменении(Элемент)
	
	АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура КоэффициентИзмененияРазмераПриИзменении(Элемент)
	
	АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ФорматСохраненияПриИзменении(Элемент)
	
	ТребуетсяПреобразованиеФорматаPDF = Ложь;
	
	СохраненноеЗначениеРеквизита = СохраненноеЗначениеРеквизитаФормы(Элемент.Имя);
	ТекущееЗначениеРеквизита     = ЭтаФорма[Элемент.Имя];
	
	Если Интеграция1СШтампКлиентСервер.ЭтоПодмножествоФорматаPDF(СохраненноеЗначениеРеквизита)
		И Интеграция1СШтампКлиентСервер.ЭтоПодмножествоФорматаPDF(ТекущееЗначениеРеквизита)
		И СохраненноеЗначениеРеквизита <>  ЭтаФорма[Элемент.Имя] Тогда
			ТребуетсяПреобразованиеФорматаPDF = Истина;
	КонецЕсли;
	
	АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов(Элемент.Имя, Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийСтраницФормы

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.СтраницаОсновная И ТребуетсяАктуализацияДанных Тогда
		УстановитьШтампВДокумент(РасширениеФайлаPDF());
		ТребуетсяАктуализацияДанных = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьДокумент(Команда)
	
	СтандартнаяОбработка = Ложь;
	
	АдресРезультатаВХранилище = "";
	РодительскийКаталог = "";
	
	Если ЗначениеЗаполнено(ПутьКДокументу) Тогда
		Документ = Новый Файл(ПутьКДокументу);
		РодительскийКаталог = Документ.Путь;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = Нстр("ru ='Выберите файл документа.'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
	Диалог.Фильтр = "
		|Документ PDF (*.PDF)|*.PDF|
		|Документ Word 97-2003 (*.DOC)|*.DOC|
		|Документы Word (*.DOCX)|*.DOCX|
		|Текст в формате RTF (*.RTF)|*.RTF|
		|Документ Excel (*.XLSX)|*.XLSX|
		|Документ Excel 97-2003 (*.XLS)|*.XLS|
		|ODF - Текстовый документ (*.ODT)|*.ODT|
		|ODF - Электронная таблица (*.ODS)|*.ODS|";
	
	Диалог.Каталог = РодительскийКаталог;
	
	Оповещение = Новый ОписаниеОповещения("ПослеОткрытияФайлаДокумента", ЭтотОбъект);
	
	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
	ПараметрыЗагрузки.Интерактивно       = Истина;
	ПараметрыЗагрузки.Диалог             = Диалог;
	
	ФайловаяСистемаКлиент.ЗагрузитьФайл(Оповещение, ПараметрыЗагрузки, ПутьКДокументу);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКартинку(Команда)
	
	РодительскийКаталог = "";
	
	Если ЗначениеЗаполнено(ПутьКШтампу) Тогда
		Картинка = Новый Файл(ПутьКШтампу);
		РодительскийКаталог = Картинка.Путь;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = Нстр("ru ='Выберите файл картинки штампа.'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
	Диалог.Фильтр  = "
		|Картинка PNG (*.PNG)|*.PNG|
		|Картинка JPEG (*.JPEG)|*.JPEG|
		|Картинка JPG (*.JPG)|*.JPG|
		|Картинка SVG (*.SVG)|*.SVG|";
	
	Диалог.Каталог = РодительскийКаталог; 
	
	Оповещение = Новый ОписаниеОповещения("ПослеОткрытияШтампа", ЭтотОбъект);
	
	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
	ПараметрыЗагрузки.Интерактивно       = Истина;
	ПараметрыЗагрузки.Диалог             = Диалог;
	
	ФайловаяСистемаКлиент.ЗагрузитьФайл(Оповещение, ПараметрыЗагрузки, ПутьКШтампу);
	
КонецПроцедуры

&НаКлиенте
Процедура СкачатьРезультат(Команда)
	
	Если Не ЗначениеЗаполнено(ИсходныйФорматДокумента) Тогда
		
		ТекстОшибки = Нстр("ru ='Не удалось определить расширение выбранного документа. Попробуйте снова выбрать документ.'", 
				ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
				
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресРезультатаВХранилище)
		И РезультатВизуализирован
		И Интеграция1СШтампКлиентСервер.ЭтоПодмножествоФорматаPDF(ФорматСохранения) Тогда
			СкачатьФайлПослеПолученияРезультата(Истина);
	Иначе
	
		АдресРезультатаВХранилище = "";
		
		Оповещение = Новый ОписаниеОповещения("НачатьСкачиваниеФайлаПослеПолученияРезультата", ЭтотОбъект);
		УстановитьШтампВДокумент(ФорматСохранения, Оповещение);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьШтампВДокумент(Знач РасширениеРезультата, Знач ОписаниеОповещенияПослеПолученияРезультата = Неопределено)
	
	Отказ = Ложь;
	
	ПроверитьЗаполнениеРеквизитов(ПутьКДокументу, "ПутьКДокументу", Отказ);
	ПроверитьЗаполнениеРеквизитов(ПутьКШтампу, "ПутьКШтампу", Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	МассивДанныхРеквизитов = Новый Массив;
	
	ДанныеРеквизита = НовыеДанныеРеквизита();
	ДанныеРеквизита.ИмяРеквизита      = "ПутьКДокументу";
	ДанныеРеквизита.ЗначениеРеквизита = ПутьКДокументу;
	
	МассивДанныхРеквизитов.Добавить(ДанныеРеквизита);
	
	ДанныеРеквизита = НовыеДанныеРеквизита();
	ДанныеРеквизита.ИмяРеквизита      = "ПутьКШтампу";
	ДанныеРеквизита.ЗначениеРеквизита = ПутьКШтампу;
	
	МассивДанныхРеквизитов.Добавить(ДанныеРеквизита);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ФорматРезультата", РасширениеРезультата);
	ДополнительныеПараметры.Вставить("ОписаниеОповещенияПослеПолученияРезультата", ОписаниеОповещенияПослеПолученияРезультата);
	
	ОбработкаЗавершения = Новый ОписаниеОповещения(
		"УстановитьШтампПослеПроверкиСуществованияФайлов",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	ПроверитьСуществованиеФайлов(МассивДанныхРеквизитов, ОбработкаЗавершения);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНастройкиПоУмолчанию()
	
	ОтступОтКраевСтраницы        = Интеграция1СШтампКлиентСервер.ЗначениеОтступаОтКраевСтраницыПоУмолчанию();
	Прозрачность                 = Интеграция1СШтампКлиентСервер.ЗначениеПрозрачностиПрозрачный();
	УровеньПрозрачности          = Интеграция1СШтампКлиентСервер.ЗначениеКоэффициентаПрозрачностиШтампаПоУмолчанию();
	ВариантРасположения          = Интеграция1СШтампКлиентСервер.СпособРазмещенияВнизуПоЦентру();
	ПравилоРасположения          = Интеграция1СШтампКлиентСервер.СпособРасположенияНаКаждойСтранице();
	ВариантВставкиКартинкиШтампа = Интеграция1СШтампКлиентСервер.СпособУстановкиШтампаНадТекстом();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначениеКонстант()
	
	ЗначениеВариантРасположенияПоКоординатам     = Интеграция1СШтампКлиентСервер.СпособРазмещенияПоКоординатам();
	ЗначениеВариантРасположенияПоТегам           = Интеграция1СШтампКлиентСервер.СпособРазмещенияПоТегам();
	ЗначениеПрозрачностиПрозрачный               = Интеграция1СШтампКлиентСервер.ЗначениеПрозрачностиПрозрачный();
	ЗначениеРасположенияНаКонкретнойСтранице     = Интеграция1СШтампКлиентСервер.СпособРасположенияНаКонкретнойСтранице();
	НомерСтраницыДляРасположенияШтампа           = 1; 
	УровеньПрозрачности                          = 50;
	ФорматСохранения                             = РасширениеФайлаPDF();
	
	ЗначениеУровняПрозрачностиПоУмолчанию  = УровеньПрозрачностиВПроцентах(
		Интеграция1СШтампКлиентСервер.ЗначениеКоэффициентаПрозрачностиШтампаПоУмолчанию());
	ЗначениеУровняПрозрачностиНеПрозрачный = УровеньПрозрачностиВПроцентах(
		Интеграция1СШтампКлиентСервер.ЗначениеКоэффициентаПрозрачностиШтампаНепрозрачный());
	
КонецПроцедуры

&НаСервере
Функция УровеньПрозрачностиВПроцентах(Знач КоэффициентПрозрачности)
	
	// Сервис работает со значением от 0 до 255, где 255 - полностью не прозрачный
	Возврат 100 - Окр(КоэффициентПрозрачности/255*100)
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуЗначенийРеквизитов()
	
	ЗначенияРеквизитов.Очистить();
	
	СписокРеквизитов = МассивСохраняемыхРеквизитов();
	
	Для Каждого НаименованиеРеквизита Из СписокРеквизитов Цикл
		
		НоваяСтрока = ЗначенияРеквизитов.Добавить();
		
		НоваяСтрока.Реквизит = НаименованиеРеквизита;
		НоваяСтрока.Значение = ЭтаФорма[НаименованиеРеквизита];
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция МассивСохраняемыхРеквизитов()
	
	МассивРеквизитов = Новый Массив;
	
	МассивРеквизитов.Добавить("ВариантВставкиКартинкиШтампа");
	МассивРеквизитов.Добавить("ВариантРасположения");
	МассивРеквизитов.Добавить("ЗамещатьТегШтампом");
	МассивРеквизитов.Добавить("ЗначениеТега");
	МассивРеквизитов.Добавить("КоэффициентИзмененияРазмера");
	МассивРеквизитов.Добавить("НомерСтраницыДляРасположенияШтампа");
	МассивРеквизитов.Добавить("ОтступОтВерхнейГраницы");
	МассивРеквизитов.Добавить("ОтступОтКраевСтраницы");
	МассивРеквизитов.Добавить("ОтступОтЛевойГраницы");
	МассивРеквизитов.Добавить("ПравилоРасположения");
	МассивРеквизитов.Добавить("Прозрачность");
	МассивРеквизитов.Добавить("УровеньПрозрачности");
	МассивРеквизитов.Добавить("ФорматСохранения");
	
	Возврат МассивРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура АктуализироватьЗначениеРеквизитаВТаблицеЗначенийРеквизитов(Знач ИмяРеквизита, УстанавливатьПризнакАктуализации = Истина)
	
	Отбор = Новый Структура("Реквизит", ИмяРеквизита);
	
	МассивСтрок = ЗначенияРеквизитов.НайтиСтроки(Отбор);
	
	Если МассивСтрок.Количество() <> 1 Тогда
		ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Должно быть только одно значение реквизита: ""%1"" в таблице ""ЗначенияРеквизитов""'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
			ИмяРеквизита);
				
		ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	ТекущееЗначениеРеквизита = ЭтаФорма[ИмяРеквизита];
	
	НайденнаяСтрока = МассивСтрок[0];
	
	Если НайденнаяСтрока.Значение <>  ТекущееЗначениеРеквизита Тогда
		НайденнаяСтрока.Значение = ТекущееЗначениеРеквизита;
		Если УстанавливатьПризнакАктуализации Тогда
			ТребуетсяАктуализацияДанных = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СохраненноеЗначениеРеквизитаФормы(Знач ИмяРеквизита)
	
	Отбор = Новый Структура("Реквизит", ИмяРеквизита);
	
	МассивСтрок = ЗначенияРеквизитов.НайтиСтроки(Отбор);
	
	Если МассивСтрок.Количество() <> 1 Тогда
		ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Должно быть только одно значение реквизита: ""%1"" в таблице ""ЗначенияРеквизитов""'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
			ИмяРеквизита);
		ВызватьИсключение ОписаниеОшибки;
	КонецЕсли;
	
	НайденнаяСтрока = МассивСтрок[0];
	
	Возврат НайденнаяСтрока.Значение;
	
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	// Видимость координат
	ВидимостьГруппыКоординаты = ВариантРасположения = ЗначениеВариантРасположенияПоКоординатам;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ГруппаКоординаты",
		"Видимость",
		ВидимостьГруппыКоординаты);
		
	// Видимость расположения по позиции либо по тегам
	ВидимостьГруппыРасположенияПоТегам = ВариантРасположения = ЗначениеВариантРасположенияПоТегам;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ГруппаРасположениеПоПозиции",
		"Видимость",
		Не ВидимостьГруппыРасположенияПоТегам);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ГруппаРасположениеПоТегам",
		"Видимость",
		ВидимостьГруппыРасположенияПоТегам);
	
	// Видимость коэффициента прозрачности
	ВидимостьГруппыПрозрачность = Прозрачность = ЗначениеПрозрачностиПрозрачный;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ГруппаПрозрачность",
		"Видимость",
		ВидимостьГруппыПрозрачность);
		
	// Видимость номер страницы
	УстановитьВидимостьНомерСтраницы();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЭлементов()
	
	// Доступность выбора формата получения результата.
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ГруппаСкачатьРезультат",
		"Доступность",
		ЗначениеЗаполнено(ПутьКДокументу));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокВыбораФорматовРезультата()
	
	Если Не ЗначениеЗаполнено(ФорматСохранения) Тогда
		Возврат;
	КонецЕсли;
	
	СписокВыбораФорматов = Элементы.ФорматСохранения.СписокВыбора;
	
	Если СписокВыбораФорматов.НайтиПоЗначению(ФорматСохранения) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокВыбораФорматов.Вставить(0, ФорматСохранения, ВРег(ФорматСохранения));
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьНомерСтраницы()
	
	ОтобразитьНомерСтраницы = ПравилоРасположения = ЗначениеРасположенияНаКонкретнойСтранице;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"НомерСтраницыДляРасположенияШтампа",
		"Видимость",
		ОтобразитьНомерСтраницы);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗначениеИсходногоФорматаИзСпискаФорматов()
	
	Если Не ЗначениеЗаполнено(ИсходныйФорматДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	МассивФорматов = Новый Массив;
	
	МассивФорматов.Добавить(РасширениеФайлаPDF());
	МассивФорматов.Добавить(ВерсияФайлаPDF_A_1());
	МассивФорматов.Добавить(ВерсияФайлаPDF_A_2());
	МассивФорматов.Добавить(ВерсияФайлаPDF_A_3());
	
	Если МассивФорматов.Найти(ИсходныйФорматДокумента) <> Неопределено
		ИЛИ Элементы.ФорматСохранения.СписокВыбора.НайтиПоЗначению(ИсходныйФорматДокумента) = Неопределено Тогда
			Возврат;
	КонецЕсли;
	
	Элементы.ФорматСохранения.СписокВыбора.Удалить(0);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОткрытияФайлаДокумента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьЗначениеИсходногоФорматаИзСпискаФорматов();
	
	ПутьКДокументу = Результат.Имя;
	Документ = Новый Файл(ПутьКДокументу);
	
	Элементы.ВыбратьДокумент.Заголовок = Документ.Имя;
	
	НовоеЗначениеИсходногоФормата = СтрЗаменить(НРег(Документ.Расширение), ".", "");
	
	Если НаименованиеДокумента <> Документ.ИмяБезРасширения Тогда
		ПредставлениеДокумента = Новый ДокументPDF;
	КонецЕсли;
	
	ИсходныйФорматДокумента = НовоеЗначениеИсходногоФормата;
	ФорматСохранения        = ДопустимыйФорматСохранения(НовоеЗначениеИсходногоФормата);
	НаименованиеДокумента   = Документ.ИмяБезРасширения;
	
	ЗаполнитьСписокВыбораФорматовРезультата();
	УстановитьДоступностьЭлементов();
	
	Если ЗначениеЗаполнено(ПутьКШтампу) Тогда
		УстановитьШтампВДокумент(РасширениеФайлаPDF());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОткрытияШтампа(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКШтампу = Результат.Имя;
	Элементы.ВыбратьКартинку.Заголовок = ИмяФайлаПоПолномуПути(ПутьКШтампу);
	
	Если ЗначениеЗаполнено(ПутьКДокументу) Тогда
		УстановитьШтампВДокумент(РасширениеФайлаPDF());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСуществованиеФайлов(МассивДанныхРеквизитов, ОбработкаЗавершения)
	
	Контекст = Новый Структура;
	Контекст.Вставить("ОбработкаЗавершения"    , ОбработкаЗавершения);
	Контекст.Вставить("МассивДанныхРеквизитов" , МассивДанныхРеквизитов);
	
	ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботыСФайлами(
		Новый ОписаниеОповещения(
			"ПроверитьСуществованиеФайлаПослеПодключенияРасширенияРаботыСФайлами",
			ЭтотОбъект,
			Контекст));
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСуществованиеФайлаПослеПодключенияРасширенияРаботыСФайлами(РасширениеПодключено, Контекст) Экспорт
	
	Если Не РасширениеПодключено Тогда
		ВыполнитьОбработкуОповещения(Контекст.ОбработкаЗавершения, Ложь);
		Возврат;
	КонецЕсли;
	
	Контекст.Вставить("ПутьКТекущемуРеквизиту", "");
	Контекст.Вставить("Индекс", -1);
	
	ПроверитьСуществованиеФайлаЦиклНачало(Контекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСуществованиеФайлаЦиклНачало(Контекст)
	
	Если Контекст.МассивДанныхРеквизитов.Количество() <= Контекст.Индекс + 1 Тогда
		// После цикла.
		ВыполнитьОбработкуОповещения(Контекст.ОбработкаЗавершения, Истина);
		Возврат;
	КонецЕсли;
	
	Контекст.Индекс = Контекст.Индекс + 1;
	Контекст.ПутьКТекущемуРеквизиту = Контекст.МассивДанныхРеквизитов.Получить(Контекст.Индекс).ЗначениеРеквизита;
	
	Файл = Новый Файл(Контекст.ПутьКТекущемуРеквизиту);
	Файл.НачатьПроверкуСуществования(Новый ОписаниеОповещения(
		"ПроверитьСуществованиеФайлаЦиклКонец", ЭтотОбъект, Контекст));
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСуществованиеФайлаЦиклКонец(Существует, Контекст) Экспорт
	
	Если Не Существует Тогда
		
		ТекстСообщения = НСтр("ru = 'Не найден файл.'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, Контекст.ПутьКТекущемуРеквизиту);
		
		ВыполнитьОбработкуОповещения(Контекст.ОбработкаЗавершения, Ложь);
		
		Возврат;
		
	КонецЕсли;
	
	ПроверитьСуществованиеФайлаЦиклНачало(Контекст);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьШтампПослеПроверкиСуществованияФайлов(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВизуализирован = Ложь;
	
	Документ = Новый Файл(ПутьКДокументу);
	
	ПараметрыУстановкиШтамповВДокумент = Интеграция1СШтампКлиентСервер.НовыеПараметрыУстановкиШтамповВДокумент();
	
	ПараметрыУстановкиШтамповВДокумент.ПараметрыДокумента.ДвоичныеДанные    = Новый ДвоичныеДанные(ПутьКДокументу);
	ПараметрыУстановкиШтамповВДокумент.ПараметрыДокумента.Расширение        = НРег(СтрЗаменить(Документ.Расширение, ".", ""));
	ПараметрыУстановкиШтамповВДокумент.ПараметрыШтампов                     = ПараметрыШтампов();
	ПараметрыУстановкиШтамповВДокумент.ПараметрыРезультата.ФорматРезультата = НРег(ДополнительныеПараметры.ФорматРезультата);
	
	Сценарий = "БЭД.ДемоШтампированиеФайлов.ВизуализацияПроштампированногоЭлектронногоДокумента";
	
	ОписаниеОповещения = Новый ОписаниеОповещения("РезультатУстановкиШтамповВДокумент",
		ЭтотОбъект, ДополнительныеПараметры);
	
	Интеграция1СШтампКлиент.УстановитьШтампыВДокумент(
		ОписаниеОповещения,
		ПараметрыУстановкиШтамповВДокумент,
		Сценарий);
	
КонецПроцедуры

&НаКлиенте
Функция НовыеДанныеРеквизита()
	
	ДанныеРеквизитов = Новый Структура;
	ДанныеРеквизитов.Вставить("ИмяРеквизита");
	ДанныеРеквизитов.Вставить("ЗначениеРеквизита");
	
	Возврат ДанныеРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьЗаполнениеРеквизитов(ПутьКФайлу, ПутьКРеквизиту, Отказ)
	
	Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ТекстСообщения = НСтр("ru = 'Необходимо указать путь к файлу.'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,ПутьКРеквизиту,, Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатУстановкиШтамповВДокумент(РезультатОбработкиДокумента, ДополнительныеПараметры) Экспорт
	
	Если РезультатОбработкиДокумента.ЕстьОшибки Тогда
		
		ТекстОшибки = РезультатОбработкиДокумента.ИнформацияОбОшибках.ТекстОшибки;
		
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = Нстр("ru ='Не удалось получить результат штампирования файла.'", 
				ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
		КонецЕсли;
				
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		Возврат;
		
	КонецЕсли;
	
	ДвоичныеДанные = РезультатОбработкиДокумента.ДанныеФайла.ДвоичныеДанные;
	АдресРезультатаВХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
	
	Если Интеграция1СШтампСлужебныйКлиентСервер.ВизуализацияФорматаДокументаСервисаПоддерживаетсяПлатформой(
		ДополнительныеПараметры.ФорматРезультата) Тогда
			ПредставлениеДокумента.Прочитать(ДвоичныеДанные.ОткрытьПотокДляЧтения());
			РезультатВизуализирован = Истина;
	КонецЕсли;
	
	Если Не ДополнительныеПараметры.ОписаниеОповещенияПослеПолученияРезультата = Неопределено Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОписаниеОповещенияПослеПолученияРезультата);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьСкачиваниеФайлаПослеПолученияРезультата(Результат, ДополнительныеПараметры) Экспорт
	
	СкачатьФайлПослеПолученияРезультата();
	
КонецПроцедуры

&НаКлиенте
Процедура СкачатьФайлПослеПолученияРезультата(ВыполнятьПреобразованиеФормата = Ложь) 
	
	ЭтоФорматPDF = Интеграция1СШтампКлиентСервер.ЭтоПодмножествоФорматаPDF(ФорматСохранения);
	
	Если ВыполнятьПреобразованиеФормата И ТребуетсяПреобразованиеФорматаPDF Тогда
		ПреобразоватьPDFДокумент();
	КонецЕсли;
	
	Фильтр = СтрШаблон(
		"%1 (*.%2)|*.%2|",
		ТипФайлаПоРасширению(ФорматСохранения),
		?(ЭтоФорматPDF, РасширениеФайлаPDF(), ФорматСохранения));
	
	Если Не ЗначениеЗаполнено(НаименованиеДокумента) Тогда
		НаименованиеДокумента = НСтр("ru='Документ'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
	КонецЕсли;
	
	ПараметрыСохраненияФайла = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	ПараметрыСохраненияФайла.Диалог.Фильтр = Фильтр;
	
	ФайловаяСистемаКлиент.СохранитьФайл(Неопределено, АдресРезультатаВХранилище, НаименованиеДокумента, ПараметрыСохраненияФайла);
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыШтампов()
	
	Штампы = Новый Массив;
	
	КартинкаШтампа = Новый Файл(ПутьКШтампу);
	
	ПараметрыШтампа = Интеграция1СШтампКлиентСервер.НовыеПараметрыШтампа();
	
	ПараметрыШтампа.ПараметрыФайла.ДвоичныеДанные         = Новый ДвоичныеДанные(ПутьКШтампу);
	ПараметрыШтампа.ПараметрыФайла.Расширение             = НРег(СтрЗаменить(КартинкаШтампа.Расширение, ".", ""));
	ПараметрыШтампа.Настройки.КоэффициентИзмененияРазмера = КоэффициентИзмененияРазмера;
	ПараметрыШтампа.Настройки.УровеньПрозрачности         = КоэффициентУровняПрозрачности();
	
	Если ВариантРасположения = ЗначениеВариантРасположенияПоТегам Тогда
		
		ПараметрыТега = Интеграция1СШтампКлиентСервер.НовыеПараметрыТега();
		
		ПараметрыТега.ЗначениеТега          = ЗначениеТега;
		ПараметрыТега.ЗамещатьЗначениеТега  = ЗамещатьТегШтампом;
		ПараметрыТега.СпособУстановкиШтампа = ВариантВставкиКартинкиШтампа;
		
		ПараметрыШтампа.ПараметрыУстановки.ПоТегам.Теги.Добавить(ПараметрыТега);
		
	Иначе
		
		ПараметрыУстановкиШтампа = Интеграция1СШтампКлиентСервер.НовыеПараметрыУстановкиШтампаПоПозиции();
		
		ПараметрыУстановкиШтампа.НаСтранице.Расположение    = ВариантРасположения;
		ПараметрыУстановкиШтампа.НаСтранице.Координаты.Верх = ОтступОтВерхнейГраницы;
		ПараметрыУстановкиШтампа.НаСтранице.Координаты.Лево = ОтступОтЛевойГраницы;
		ПараметрыУстановкиШтампа.НаСтранице.ОтступОтГраниц  = ОтступОтКраевСтраницы;
		ПараметрыУстановкиШтампа.НаСтраницах.Расположение   = ПравилоРасположения;
		ПараметрыУстановкиШтампа.НаСтраницах.НомерСтраницы  = НомерСтраницыДляРасположенияШтампа;
		
		ПараметрыШтампа.ПараметрыУстановки.ПоПозиционированию.Позиции.Добавить(ПараметрыУстановкиШтампа);
		
	КонецЕсли;
	
	Штампы.Добавить(ПараметрыШтампа);
	
	Возврат Штампы;
	
КонецФункции

&НаКлиенте
Функция КоэффициентУровняПрозрачности()
	
	// Сервис работает со значением от 0 до 255, где 255 - полностью не прозрачный.
	// Пользователю удобнее работать в процентном соотношении.
	
	Возврат 255 - Окр(УровеньПрозрачности*255/100);
	
КонецФункции

