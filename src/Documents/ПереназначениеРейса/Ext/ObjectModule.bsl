// Назначение модуля: Фиксация переназначения исполнителя рейса и запись события в историю изменений.
// Изменяет назначение исполнителя рейса и регистрирует изменение в истории.
Процедура ОбработкаПроведения(Отказ, РежимПроведения)	
	// Получаем рейс
	ОбъектРейса = Рейс.ПолучитьОбъект();
	
	ОбъектРейса.ДополнительныеСвойства.Вставить("РазрешеноПереназначение", Истина);
	// === 1. Записываем историю ===
	
	ЗаписьИстории = РегистрыСведений.ИсторияИзмененийРейсов.СоздатьМенеджерЗаписи();
	
	ЗаписьИстории.Рейс = Рейс;
	ЗаписьИстории.СтарыйТипИсполнителя = ОбъектРейса.ТипИсполнителя;
	ЗаписьИстории.НовыйТипИсполнителя = НовыйТипИсполнителя;
	ЗаписьИстории.СтароеТС = ОбъектРейса.ТС;
	ЗаписьИстории.НовоеТС = НовоеТС;
	ЗаписьИстории.СтарыйВодитель = ОбъектРейса.Водитель;
	ЗаписьИстории.НовыйВодитель = НовыйВодитель;
	ЗаписьИстории.СтарыйПодрядчик = ОбъектРейса.Подрядчик;
	ЗаписьИстории.НовыйПодрядчик = НовыйПодрядчик;
	ЗаписьИстории.Причина = Причина;
	ЗаписьИстории.Пользователь = РОТКО_Пользователи.ПолучитьТекущегоСотрудника(); 
	
	Если ЗаписьИстории.Пользователь = Неопределено Тогда
		Отказ = Истина;
		Сообщить("Не настроено соответствие логина пользователя и сотрудника (Регистр: СоответствиеЛогиновИСотрудников).");
		Возврат;
	КонецЕсли;
	
	ЗаписьИстории.ДатаИзменения = ТекущаяДата();
	ЗаписьИстории.Записать();
	// === 2. Меняем рейс ===
	ОбъектРейса.ТипИсполнителя = НовыйТипИсполнителя;
	ОбъектРейса.ТС = НовоеТС;
	ОбъектРейса.Водитель = НовыйВодитель;
	ОбъектРейса.Подрядчик = НовыйПодрядчик;
	ОбъектРейса.Записать();
		
КонецПроцедуры
