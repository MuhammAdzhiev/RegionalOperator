
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Получение данных для формирования электронного документа.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка.РеализацияТоваровУслуг - ссылка на документ.
//  ЗаполнитьДанныеШтрихкодовДляУКДДо - Булево - запрос кодов для документа корректировки
// Возвращаемое значение:
//  Структура - структура данных для печати.
//
Функция ПолучитьДанныеДляЭД(СсылкаНаОбъект, ЗаполнитьДанныеШтрихкодовДляУКДДо = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка,
	|	ПоступлениеТоваровУслуг.НомерЭД КАК Номер,
	|	ПоступлениеТоваровУслуг.Дата КАК Дата,
	|	ПоступлениеТоваровУслуг.НомерИсправления КАК НомерИсправления,
	|	ПоступлениеТоваровУслуг.Дата КАК ДатаИсправления,
	|	ПоступлениеТоваровУслуг.НомерИсходногоДокумента КАК НомерИсходногоДокумента,
	|	ПоступлениеТоваровУслуг.ДатаИсходногоДокумента КАК ДатаИсходногоДокумента,
	|	ПоступлениеТоваровУслуг.НомерИсправленияИсходногоДокумента КАК НомерИсправленияИсходногоДокумента,
	|	ПоступлениеТоваровУслуг.ДатаИсправленияИсходногоДокумента КАК ДатаИсправленияИсходногоДокумента,
	|	ПоступлениеТоваровУслуг.НомерИсправляемогоКорректировочногоДокумента КАК
	|		НомерИсправляемогоКорректировочногоДокумента,
	|	ПоступлениеТоваровУслуг.ДатаИсправляемогоКорректировочногоДокумента КАК ДатаИсправляемогоКорректировочногоДокумента,
	|	ПоступлениеТоваровУслуг.ВидДокумента КАК ВидДокумента,
	|	ПоступлениеТоваровУслуг.ВидОперации КАК ВидОперации,
	|	ПоступлениеТоваровУслуг.Организация КАК Организация,
	|	ПоступлениеТоваровУслуг.Контрагент КАК Контрагент,
	|	ПоступлениеТоваровУслуг.БанковскийСчетКонтрагента КАК БанковскийСчетКонтрагента,
	|	ПоступлениеТоваровУслуг.БанковскийСчетОрганизации КАК БанковскийСчетОрганизации,
	|	ПоступлениеТоваровУслуг.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ПоступлениеТоваровУслуг.ДоговорКонтрагента.Наименование КАК НаименованиеДоговора,
	|	ПоступлениеТоваровУслуг.ДоговорКонтрагента.НомерДоговора КАК НомерДоговора,
	|	ПоступлениеТоваровУслуг.ДоговорКонтрагента.ДатаДоговора КАК ДатаДоговора,
	|	ПоступлениеТоваровУслуг.Грузоотправитель КАК Грузоотправитель,
	|	ПоступлениеТоваровУслуг.Грузоотправитель.ОсновнойБанковскийСчет КАК БанковскийСчетГрузоотправителя,
	|	ПоступлениеТоваровУслуг.Грузополучатель КАК Грузополучатель,
	|	ПоступлениеТоваровУслуг.Грузополучатель.ОсновнойБанковскийСчет КАК БанковскийСчетГрузополучателя,
	|	"""" КАК АдресДоставки,
	|	"""" КАК АдресДоставкиЗначение,
	|	"""" КАК АдресДоставкиЗначенияПолей,
	|	ПоступлениеТоваровУслуг.Перевозчик КАК Перевозчик,
	|	ПоступлениеТоваровУслуг.НомерТранспортнойНакладной КАК НомерТранспортнойНакладной,
	|	ПоступлениеТоваровУслуг.ДатаТранспортнойНакладной КАК ДатаТранспортнойНакладной,
	|	ПоступлениеТоваровУслуг.СведенияОТранспортировкеИГрузе КАК СведенияОТранспортировкеИГрузе,
	|	ПоступлениеТоваровУслуг.СуммаДокумента КАК СуммаДокумента,
	|	ПоступлениеТоваровУслуг.Валюта КАК Валюта,
	|	ПоступлениеТоваровУслуг.Валюта.Код КАК ВалютаКод,
	|	ПоступлениеТоваровУслуг.Валюта.Наименование КАК ВалютаНаименование,
	|	ПоступлениеТоваровУслуг.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
	|	ПоступлениеТоваровУслуг.ДокументОснование КАК ДокументОснование,
	|	ПоступлениеТоваровУслуг.ОблагаетсяНДСУПокупателя КАК ОблагаетсяНДСУПокупателя,
	|	ПоступлениеТоваровУслуг.ГосЗакупкаНомерЛицевогоСчета КАК ГосЗакупкаНомерЛицевогоСчета,
	|	ПоступлениеТоваровУслуг.ГосЗакупкаКазначействоКод КАК ГосЗакупкаКазначействоКод,
	|	ПоступлениеТоваровУслуг.ГосЗакупкаКазначействоНаименование КАК ГосЗакупкаКазначействоНаименование,
	|	"""" КАК ИныеСведенияОбОтгрузке,
	|	ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) КАК ДатаОтгрузки,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Фактор,
	|	ПоступлениеТоваровУслуг.СпециальноеОбстоятельствоФНС КАК СпециальноеОбстоятельствоФНС,
	|	ПоступлениеТоваровУслуг.СодержаниеОперации КАК СодержаниеОперации
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	ПоступлениеТоваровУслуг.Ссылка В (&Ссылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
	|	Товары.Номенклатура.Код КАК НоменклатураКод,
	|	Товары.Номенклатура.Артикул КАК НоменклатураАртикул,
	|	Товары.Номенклатура.СтавкаНДС КАК НоменклатураСтавкаНДС,
	|	Товары.Номенклатура.ВидНоменклатуры.ТипНоменклатуры КАК ТипНоменклатуры,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Характеристика.Наименование КАК ХарактеристикаНаименование,
	|	СправочникНоменклатура.ЕдиницаИзмерения КАК БазоваяЕдиницаСсылка,
	|	&ДанныеБазовойЕдиницы,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	&ДанныеУпаковки,
	|	Товары.КоличествоУпаковокДоКорректировки КАК КоличествоУпаковокДоКорректировки,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	| 	ВЫБОР
	|		КОГДА Товары.КоличествоУпаковок = 0
	|			ТОГДА Товары.КоличествоУпаковокДоКорректировки
	|		ИНАЧЕ Товары.КоличествоУпаковокДоКорректировки * Товары.Количество / Товары.КоличествоУпаковок
	|	КОНЕЦ КАК КоличествоДоКорректировки,
	|	ВЫБОР
	|		КОГДА Товары.КоличествоУпаковок = 0
	|			ТОГДА Товары.КоличествоУпаковокДоКорректировки
	|		ИНАЧЕ Товары.КоличествоУпаковокДоКорректировки * Товары.Количество / Товары.КоличествоУпаковок
	|	КОНЕЦ КАК КоличествоДо,
	|	ВЫБОР
	|		КОГДА Товары.Количество = 0
	|			ТОГДА Товары.КоличествоУпаковок
	|		ИНАЧЕ Товары.Количество
	|	КОНЕЦ КАК Количество,
	|	Товары.ЦенаДоКорректировки КАК ЦенаДоКорректировки,
	|	Товары.Цена КАК Цена,
	|	Товары.СуммаДоКорректировки КАК СуммаДоКорректировки,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДСДоКорректировки КАК СтавкаНДСДоКорректировки,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДСДоКорректировки КАК СуммаНДСДоКорректировки,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.СуммаСНДСДоКорректировки КАК СуммаСНДСДоКорректировки,
	|	Товары.СуммаСНДС КАК СуммаСНДС,
	|	Товары.СуммаСНДСДоКорректировки - Товары.СуммаНДСДоКорректировки КАК СуммаБезНДСДоКорректировки,
	|	Товары.СуммаСНДС - Товары.СуммаНДС КАК СуммаБезНДС,
	|	Товары.СуммаАкцизаДоКорректировки КАК СуммаАкцизаДоКорректировки,
	|	Товары.СуммаАкциза КАК СуммаАкциза,
	|	Товары.НомерГТД КАК НомерГТД,
	|	Товары.СтранаПроисхождения.Код КАК СтранаПроисхожденияКод,
	|	Товары.СтранаПроисхождения.Наименование КАК СтранаПроисхожденияНаименование,
	|	Товары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	"""" КАК Содержание,
	|	Товары.КодТНВЭД КАК КодТНВЭД,
	|	Товары.ОснованиеОсвобожденияОтНДС,
	|	Товары.Комитент КАК Комитент,
	|	Товары.ДоговорСКомитентом КАК ДоговорСКомитентом,
	|	Товары.АмортизационнаяГруппа КАК АмортизационнаяГруппа,
	|	Товары.КодОКОФ КАК КодОКОФ,
	|	Товары.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
	|	Товары.ФактСрокПолезногоИспользования КАК ФактСрокПолезногоИспользования
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО СправочникНоменклатура.Ссылка = Товары.Номенклатура
	|ГДЕ
	|	Товары.Ссылка В (&Ссылка)
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеТоваровУслугКодыИндивидуальныхУпаковокМаркируемойПродукции.НомерУпаковки КАК НомерУпаковки,
	|	ПоступлениеТоваровУслугКодыИндивидуальныхУпаковокМаркируемойПродукции.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.КодыУпаковокМаркируемойПродукции КАК
	|		ПоступлениеТоваровУслугКодыИндивидуальныхУпаковокМаркируемойПродукции
	|ГДЕ
	|	ПоступлениеТоваровУслугКодыИндивидуальныхУпаковокМаркируемойПродукции.Ссылка В (&Ссылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеТоваровУслугКодыУпаковокМаркируемойПродукцииДоКорректировки.НомерУпаковки КАК НомерУпаковки,
	|	ПоступлениеТоваровУслугКодыУпаковокМаркируемойПродукцииДоКорректировки.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.КодыУпаковокМаркируемойПродукцииДоКорректировки КАК
	|		ПоступлениеТоваровУслугКодыУпаковокМаркируемойПродукцииДоКорректировки
	|ГДЕ
	|	ПоступлениеТоваровУслугКодыУпаковокМаркируемойПродукцииДоКорректировки.Ссылка В (&Ссылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыПодтвержденияОтгрузки.Наименование КАК Наименование,
	|	ДокументыПодтвержденияОтгрузки.Номер КАК Номер,
	|	ДокументыПодтвержденияОтгрузки.Дата КАК Дата
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ДокументыПодтвержденияОтгрузки КАК ДокументыПодтвержденияОтгрузки
	|ГДЕ
	|	ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СведенияПрослеживаемости.РНПТ,
	|	СведенияПрослеживаемости.КоличествоУпаковок,
	|	СведенияПрослеживаемости.КоличествоУпаковокДоКорректировки,
	|	СведенияПрослеживаемости.КоличествоПрослеживаемости,
	|	СведенияПрослеживаемости.КоличествоПрослеживаемостиДоКорректировки,
	|	СведенияПрослеживаемости.ЕдиницаИзмеренияПрослеживаемости.Код КАК ЕдиницаИзмеренияКод,
	|	СведенияПрослеживаемости.ЕдиницаИзмеренияПрослеживаемости.Наименование КАК ЕдиницаИзмеренияНаименование,
	|	СведенияПрослеживаемости.СтоимостьБезНДС,
	|	СведенияПрослеживаемости.СтоимостьБезНДСДоКорректировки,
	|	СведенияПрослеживаемости.ИдентификаторСтроки
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.СведенияПрослеживаемости КАК СведенияПрослеживаемости
	|ГДЕ
	|	СведенияПрослеживаемости.Ссылка В (&Ссылка)";
	
	ОбменСКонтрагентамиКЭДО.ИнициализацияТекстаЗапросаПоискаШтрихкодовПоВременнойТаблицеТоваров(
		Запрос.Текст, Метаданные.Документы.РеализацияТоваровУслуг.Имя, Истина);
	
	Справочники.ЕдиницыИзмерения.ДополнитьЗапросДаннымиЕдиницыИзмеренияУпаковки(
		Запрос.Текст, "&ДанныеБазовойЕдиницы", "СправочникНоменклатура.ЕдиницаИзмерения", "БазоваяЕдиница", Истина);
		
	Справочники.ЕдиницыИзмерения.ДополнитьЗапросДаннымиЕдиницыИзмеренияУпаковки(
		Запрос.Текст, "&ДанныеУпаковки", "Товары.ЕдиницаИзмерения", "ЕдиницаИзмерения");	
	
	ИспользуетсяГосИС = КлиентЭДОВызовСервера.ИспользуетсяГосИС();
	Если ИспользуетсяГосИС Тогда
		Запрос.Текст = Запрос.Текст
			           + ОбщегоНазначения.РазделительПакетаЗапросов()
			           + ТекстЗапросаДанныхМаркировки(ЗаполнитьДанныеШтрихкодовДляУКДДо);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаШапки = МассивРезультатов[0].Выбрать();
	
	ВыборкаТоваров = МассивРезультатов[1].Выбрать();
	
	ТаблицаКодов = МассивРезультатов[2].Выгрузить();
	ТаблицаКодов.Индексы.Добавить("НомерУпаковки, ИдентификаторСтроки");
	
	ТаблицаКодовДоКорректировки = МассивРезультатов[3].Выгрузить();
	ТаблицаКодовДоКорректировки.Индексы.Добавить("НомерУпаковки, ИдентификаторСтроки");
	
	ВыборкаДокументовПодтвержденияОтгрузки = МассивРезультатов[4].Выбрать();
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ВыборкаШапки",   ВыборкаШапки);
	СтруктураДанных.Вставить("ВыборкаТоваров", ВыборкаТоваров);
	
	СтруктураДанных.Вставить("КодыУпаковокМаркируемойПродукции", ТаблицаКодов);
	СтруктураДанных.Вставить("КодыУпаковокМаркируемойПродукцииДоКорректировки", ТаблицаКодовДоКорректировки);
	
	СтруктураДанных.Вставить("ВыборкаДокументовПодтвержденияОтгрузки", ВыборкаДокументовПодтвержденияОтгрузки);
	
	ШтрихкодыКомбинаций = МассивРезультатов[9].Выгрузить();
	ШтрихкодыКомбинаций.Индексы.Добавить("Номенклатура, Характеристика, ЕдиницаИзмерения");
	СтруктураДанных.Вставить("ШтрихкодыКомбинаций", ШтрихкодыКомбинаций);

	ШтрихкодыНоменклатуры = МассивРезультатов[10].Выгрузить();
	ШтрихкодыНоменклатуры.Индексы.Добавить("Номенклатура");
	СтруктураДанных.Вставить("ШтрихкодыНоменклатуры", ШтрихкодыНоменклатуры);
	
	СтруктураДанных.Вставить("СведенияПрослеживаемости", МассивРезультатов[5].Выгрузить());
	
	Если ИспользуетсяГосИС Тогда
		
		КоличествоРезультатов = МассивРезультатов.ВГраница();
		
		ПараметрыСканирования = ШтрихкодированиеОбщегоНазначенияИС.ПараметрыСканирования(
			?(ТипЗнч(СсылкаНаОбъект) = Тип("Массив"), СсылкаНаОбъект[0], СсылкаНаОбъект));
		Товары = МассивРезультатов[1].Выгрузить();
		
		Если ЗаполнитьДанныеШтрихкодовДляУКДДо Тогда
			
			МаркировкаДо = МассивРезультатов[КоличествоРезультатов].Выгрузить();
			
			ТоварыДо = Товары.Скопировать();
			ТоварыДо.Колонки.Удалить(ТоварыДо.Колонки.Количество);
			ТоварыДо.Колонки.КоличествоДоКорректировки.Имя = "Количество";
			
			МаркировкаДо = ЭлектронноеВзаимодействиеИСМП.ЧастичноеСодержимоеИКодыОСУ(
				МаркировкаДо, ТоварыДо, ПараметрыСканирования);
			
			Если МаркировкаДо.Количество() = 0 Тогда // Коды переданы через документ прямого обмена.
				Маркировка = МаркировкаДо.СкопироватьКолонки();
			Иначе
				Маркировка = МассивРезультатов[КоличествоРезультатов-1].Выгрузить();
				Маркировка = ЭлектронноеВзаимодействиеИСМП.ЧастичноеСодержимоеИКодыОСУ(
					Маркировка,	Товары, ПараметрыСканирования);
			КонецЕсли;
			
			СтруктураДанных.Вставить("МаркировкаДо", МаркировкаДо);
			СтруктураДанных.Вставить("Маркировка", Маркировка);
			
		Иначе
			
			Маркировка = МассивРезультатов[КоличествоРезультатов].Выгрузить();
			Маркировка = ЭлектронноеВзаимодействиеИСМП.ЧастичноеСодержимоеИКодыОСУ(
				Маркировка, Товары, ПараметрыСканирования);
			
			СтруктураДанных.Вставить("Маркировка", Маркировка);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураДанных;
	
КонецФункции

#Область Обновление

// Регистрирует данные для обработчика обновления
// 
// Параметры:
//  Параметры - Структура - параметры.
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	
	Данные = Новый Массив;
	
	Данные_Основной = ДанныеКОбработкеДляПереходаНаНовуюВерсию_Основной();
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Данные, Данные_Основной, Истина);
	
	Данные_ЗаполнитьСтавкуНДСДоКорректировки = ДанныеКОбработкеДляПереходаНаНовуюВерсию_ЗаполнитьСтавкуНДСДоКорректировки();
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Данные, Данные_ЗаполнитьСтавкуНДСДоКорректировки, Истина);
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные, ДополнительныеПараметры);
	
КонецПроцедуры

// Обработчик обновления.
// 
// Параметры:
//  Параметры - Структура - параметры.
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	МетаданныеОбъекта = Метаданные.Документы.ПоступлениеТоваровУслуг;
	ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
	ПараметрыОтметкиВыполнения = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ОбработанныхОбъектов = 0;
	ПроблемныхОбъектов = 0;
	
	Если ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, "Документ.ЭлектронныйДокументВходящийЭДО")
		Или ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, "РегистрСведений.СостоянияПоОбъектамУчетаЭДО")
		Или ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, "Справочник.СообщениеЭДОПрисоединенныеФайлы")
		Или ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, "РегистрСведений.ХранилищеФайлов")
		Или ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, "РегистрСведений.НоменклатураКонтрагентовБЭД") Тогда
		Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(
			Параметры.Очередь, ПолноеИмяОбъекта);
		Возврат;
	КонецЕсли;
	
	ПараметрыВыборки = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта, ПараметрыВыборки);
	Если Параметры.ПрогрессВыполнения.ВсегоОбъектов = 0 Тогда
		Параметры.ПрогрессВыполнения.ВсегоОбъектов = Выборка.Количество();
	КонецЕсли;
	
	НаборСсылок = Новый Массив;
	Пока Выборка.Следующий() Цикл
		НаборСсылок.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Для каждого СсылкаНаОбъект Из НаборСсылок Цикл
		
		НачатьТранзакцию();
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", СсылкаНаОбъект);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
			Записать = Ложь;
			
			Объект = СсылкаНаОбъект.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				ОбработатьДанные_ЗаполнитьИдентификаторСтроки(Объект, Записать);
				ОбработатьДанные_ЗаполнитьСтавкуНДСДоКорректировки(Объект, Записать);
			КонецЕсли;
			
			Если Записать Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(СсылкаНаОбъект, ПараметрыОтметкиВыполнения);
			КонецЕсли;
			
			ОбработанныхОбъектов = ОбработанныхОбъектов + 1;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			ШаблонСообщения = НСтр("ru = 'Не удалось обработать поступление товаров и услуг: %1 по причине:'");
			ТекстСообщения = СтрШаблон(ШаблонСообщения, СсылкаНаОбъект) + Символы.ПС + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка,
				МетаданныеОбъекта, СсылкаНаОбъект, ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Если ОбработанныхОбъектов = 0 И ПроблемныхОбъектов <> 0 Тогда
		ШаблонСообщения = НСтр("ru = 'Не удалось обработать некоторые поступления товаров и услуг (пропущены): %1'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ПроблемныхОбъектов);
		ВызватьИсключение ТекстСообщения;
	Иначе
		ШаблонСообщения = НСтр("ru = 'Обработана очередная порция поступлений товаров и услуг: %1'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ОбработанныхОбъектов);
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Информация,
			МетаданныеОбъекта,, ТекстСообщения);
	КонецЕсли;
	
	Параметры.ПрогрессВыполнения.ОбработаноОбъектов  = Параметры.ПрогрессВыполнения.ОбработаноОбъектов  + ОбработанныхОбъектов;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(
		Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

