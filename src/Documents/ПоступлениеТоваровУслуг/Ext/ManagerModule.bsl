#Область СлужебныеПроцедурыИФункции

Функция ДанныеКОбработкеДляПереходаНаНовуюВерсию_Основной() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоступлениеТоваровУслугТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	|ГДЕ
	|	ПоступлениеТоваровУслугТовары.ИдентификаторСтроки = """"";
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьДанные_ЗаполнитьИдентификаторСтроки(Объект, Записать) 
	
	Для каждого СтрокаТовара Из Объект.Товары Цикл
		Если Не ЗначениеЗаполнено(СтрокаТовара.ИдентификаторСтроки) Тогда
			КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(СтрокаТовара);
			Записать = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ДанныеКОбработкеДляПереходаНаНовуюВерсию_ЗаполнитьСтавкуНДСДоКорректировки() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК Товары
	|ГДЕ
	|	Товары.КоличествоУпаковокДоКорректировки <> 0
	|	И Товары.СтавкаНДСДоКорректировки = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)
	|	И Товары.СтавкаНДС <> ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)";
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьДанные_ЗаполнитьСтавкуНДСДоКорректировки(Объект, Записать) 
	
	Для каждого СтрокаТовара Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТовара.КоличествоУпаковокДоКорректировки)
			И ЗначениеЗаполнено(СтрокаТовара.СтавкаНДС)
			И Не ЗначениеЗаполнено(СтрокаТовара.СтавкаНДСДоКорректировки) Тогда
			СтрокаТовара.СтавкаНДСДоКорректировки = СтрокаТовара.СтавкаНДС;
			Записать = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстЗапросаДанныхМаркировки(ЗаполнитьДанныеШтрихкодовДляУКДДо = Ложь)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаШтрихкодыУпаковок.ШтрихкодУпаковки КАК Штрихкод,
	|	ТаблицаШтрихкодыУпаковок.Ссылка              КАК Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ШтрихкодыУпаковок КАК ТаблицаШтрихкодыУпаковок
	|ГДЕ
	|	ТаблицаШтрихкодыУпаковок.Ссылка В (&Ссылка)
	|";

	Если ЗаполнитьДанныеШтрихкодовДляУКДДо Тогда

		ТекстЗапроса = ТекстЗапроса
			+ ОбщегоНазначения.РазделительПакетаЗапросов()
			+ "ВЫБРАТЬ
			|	ТаблицаШтрихкодыУпаковокДо.ШтрихкодУпаковки КАК Штрихкод,
			|	ТаблицаШтрихкодыУпаковок.Ссылка           КАК Ссылка
			|ИЗ
			|	Документ.ПоступлениеТоваровУслуг КАК ТаблицаШтрихкодыУпаковок
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.ШтрихкодыУпаковок КАК ТаблицаШтрихкодыУпаковокДо
			|		ПО ТаблицаШтрихкодыУпаковок.ДокументОснование = ТаблицаШтрихкодыУпаковокДо.Ссылка
			|ГДЕ
			|	ТаблицаШтрихкодыУпаковок.Ссылка В (&Ссылка)
			|";

	КонецЕсли;

	Возврат ТекстЗапроса;

КонецФункции

#КонецОбласти

#КонецЕсли