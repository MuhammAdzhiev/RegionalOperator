	НоваяКоманда.Обработчик = "КлиентЭДОКлиент.СоздатьНаОснованииРеализациюТоваровУслугКоманда";
	НоваяКоманда.ТипПараметра = ОписаниеТипаТекущегоОбъекта;
	
	НоваяКоманда = Команды.Добавить();
