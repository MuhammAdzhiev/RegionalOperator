Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	ПараметрыПроверки = КлиентЭДО.ПараметрыПроверкиЗаполненияКоличестваИЕдиницыИзмерения();
	ПараметрыПроверки.Вставить("Объект", ЭтотОбъект);
	ПараметрыПроверки.Вставить("МассивНепроверяемыхРеквизитов", МассивНепроверяемыхРеквизитов);
	КлиентЭДО.ПроверитьЗаполнениеХарактеристик(ПараметрыПроверки, Отказ);
	КлиентЭДО.ПроверитьЗаполнениеДанныхАмортизации(ПараметрыПроверки, Отказ);
	
	ЭтоКорректировка = (ВидОперации = Перечисления.ВидыОпераций.Корректировка);
	ЭтоИсправлениеКорректировки = (ВидОперации = Перечисления.ВидыОпераций.Исправление
			И ЗначениеЗаполнено(НомерИсправляемогоКорректировочногоДокумента));
	
	ПроверитьКоличествоИЦену = Не (ЭтоКорректировка Или ЭтоИсправлениеКорректировки);
	
	Если ПроверитьКоличествоИЦену Тогда
		КлиентЭДО.ПроверитьЗаполнениеКоличестваИЕдиницыИзмерения(ПараметрыПроверки, Отказ);
	Иначе
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Количество");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.КоличествоУпаковок");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.ЕдиницаИзмерения");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Сумма");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Цена");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МассивНепроверяемыхРеквизитов) Тогда
		ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	КонецЕсли;
	
	КлиентЭДО.ОбработкаПроверкиЗаполнения(ЭтотОбъект, ПроверяемыеРеквизиты, Отказ);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("Основание") И ДанныеЗаполнения.Свойство("ВидОперации") Тогда

		ВидОперации = ДанныеЗаполнения.ВидОперации;
		Основание = ДанныеЗаполнения.Основание; 
		
		БанковскийСчетОрганизации						= Основание.БанковскийСчетОрганизации;
		БанковскийСчетКонтрагента 						= Основание.БанковскийСчетКонтрагента;
		Валюта 											= Основание.Валюта;
		ВидДокумента 									= Основание.ВидДокумента;
		Грузоотправитель 								= Основание.Грузоотправитель;
		Грузополучатель 								= Основание.Грузополучатель;
		ДатаИсправленияИсходногоДокумента 				= Основание.ДатаИсправленияИсходногоДокумента;
		ДатаИсправляемогоКорректировочногоДокумента		= Основание.ДатаИсправляемогоКорректировочногоДокумента;
		ДатаИсходногоДокумента 							= Основание.ДатаИсходногоДокумента;
		ДатаТранспортнойНакладной 						= Основание.ДатаТранспортнойНакладной;
		ДатаЭД											= Основание.ДатаЭД;
		ДокументОснование 								= Основание.ДокументОснование;
		ИдентификаторГосКонтракта 						= Основание.ИдентификаторГосКонтракта;
		Комментарий 									= Основание.Комментарий;
		Контрагент 										= Основание.Контрагент;
		НомерИсправления 								= Основание.НомерИсправления;
		НомерИсправленияИсходногоДокумента			 	= Основание.НомерИсправленияИсходногоДокумента;
		НомерИсправляемогоКорректировочногоДокумента 	= Основание.НомерИсправляемогоКорректировочногоДокумента;
		НомерИсходногоДокумента 						= Основание.НомерИсходногоДокумента;
		НомерТранспортнойНакладной 						= Основание.НомерТранспортнойНакладной;
		НомерЭД 										= Основание.НомерЭД;
		ОблагаетсяНДСУПокупателя 						= Основание.ОблагаетсяНДСУПокупателя;
		Организация 									= Основание.Организация;
		Перевозчик 										= Основание.Перевозчик;
		ПредставлениеНомера 							= Основание.ПредставлениеНомера;
		СведенияОТранспортировкеИГрузе 					= Основание.СведенияОТранспортировкеИГрузе;
		СуммаДокумента 									= Основание.СуммаДокумента;
		ЭтоГосЗакупка 									= Основание.ЭтоГосЗакупка;
		ГосЗакупкаКодЗакупки 							= Основание.ГосЗакупкаКодЗакупки;
		ГосЗакупкаНомерЛицевогоСчета 					= Основание.ГосЗакупкаНомерЛицевогоСчета;
		ГосЗакупкаФинансовыйОрган 						= Основание.ГосЗакупкаФинансовыйОрган;
		ГосЗакупкаНомерРеестровойЗаписи 				= Основание.ГосЗакупкаНомерРеестровойЗаписи;
		ГосЗакупкаНомерБюджетногоОбязательства 			= Основание.ГосЗакупкаНомерБюджетногоОбязательства;
		ГосЗакупкаКазначействоКод 						= Основание.ГосЗакупкаКазначействоКод;
		ГосЗакупкаКазначействоНаименование 				= Основание.ГосЗакупкаКазначействоНаименование;
		ГосЗакупкаОКТМОПокупателя 						= Основание.ГосЗакупкаОКТМОПокупателя;
		ГосЗакупкаОКТМОМестаПоставки 					= Основание.ГосЗакупкаОКТМОМестаПоставки;
		ГосЗакупкаПредельнаяДатаОплаты 					= Основание.ГосЗакупкаПредельнаяДатаОплаты;
		ГосЗакупкаНомерДенежногоОбязательства 			= Основание.ГосЗакупкаНомерДенежногоОбязательства;
		ГосЗакупкаОчередностьПлатежа 					= Основание.ГосЗакупкаОчередностьПлатежа;
		ГосЗакупкаВидПлатежа 							= Основание.ГосЗакупкаВидПлатежа;

		Для Каждого МетаданныеТЧ Из Метаданные().ТабличныеЧасти Цикл
			
			ИмяТЧ = МетаданныеТЧ.Имя;
			ТабличнаяЧастьИсточник = Основание[ИмяТЧ];
			ТабличнаяЧастьПриемника = ЭтотОбъект[ИмяТЧ];
			ТабличнаяЧастьПриемника.Очистить();
			
			Для Каждого СтрокаИсточника Из ТабличнаяЧастьИсточник Цикл
				НоваяСтрокаПриемника = ТабличнаяЧастьПриемника.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаПриемника, СтрокаИсточника);
			КонецЦикла;
			
		КонецЦикла;
				
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	УстановитьПредставлениеНомера();
	КлиентЭДО.ИдентификаторыСтрокПередЗаписьюОбъекта(ЭтотОбъект);
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СуммаДокумента = Товары.Итог("СуммаСНДС");
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьПредставлениеНомера()
	
	Если ЗначениеЗаполнено(НомерИсправления) Тогда
		ПредставлениеНомера = СтрШаблон(НСтр("ru = '%1 (испр. %2)'"),
			НомерЭД, НомерИсправления);
	Иначе
		ПредставлениеНомера = НомерЭД;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

