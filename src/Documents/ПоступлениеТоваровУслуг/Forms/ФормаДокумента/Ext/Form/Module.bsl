Процедура ТоварыКодТНВЭДНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	НастройкиРежима = Новый Структура;
	НастройкиРежима.Вставить("РежимВыбораЭлемента", Истина);
	НастройкиРежима.Вставить("ОбработчикЗавершения", Новый ОписаниеОповещения("ЗаполнитьКодТНВЭДПослеВыбораИзСервиса", ЭтотОбъект));
	ОблачныеКлассификаторыКлиент.ПодобратьИзСервисаЭлементыТНВЭД(НастройкиРежима);
	
