&НаКлиенте
Процедура ЗаполнитьСпециальноеОбстоятельствоФНС(Результат, ДополнительныеПараметры) Экспорт
	Если ЗначениеЗаполнено(Результат) Тогда
		Объект.СпециальноеОбстоятельствоФНС = Результат.Код;
		Модифицированность = Истина;
		ПредставлениеСпециальноеОбстоятельствоФНС = СтрШаблон("%1 %2", Результат.Код, Результат.Наименование);
	Иначе
		ЗаполнитьПредставлениеСпециальногоОбстоятельстваНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПоПредставлениюСпециальногоОбстоятельстваНаСервере()
	КодОбстоятельства = СокрЛП(ПредставлениеСпециальноеОбстоятельствоФНС);
	Результат = ОбменСКонтрагентами.ОписаниеСпециальногоОбстоятельстваФНС(КодОбстоятельства);
	Если ЗначениеЗаполнено(Результат.Код) Тогда
		Объект.СпециальноеОбстоятельствоФНС = Результат.Код;
		Модифицированность = Истина;
		ПредставлениеСпециальноеОбстоятельствоФНС = СтрШаблон("%1 %2", Результат.Код, Результат.Наименование);
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура ПредставлениеСпециальноеОбстоятельствоФНСПриИзмененииИВыборе()
ДлинаКодаСпецОбстоятельств = 5;
	Если СтрДлина(СокрЛП(ПредставлениеСпециальноеОбстоятельствоФНС)) = ДлинаКодаСпецОбстоятельств
		И ЗаполнитьПоПредставлениюСпециальногоОбстоятельстваНаСервере() Тогда
		Возврат;
	КонецЕсли;
	ПараметрОткрытия = Новый Структура;
	Если ЗначениеЗаполнено(Объект.СпециальноеОбстоятельствоФНС) Тогда
		ПараметрОткрытия.Вставить("Код", Объект.СпециальноеОбстоятельствоФНС);
	КонецЕсли;
	Если СтрДлина(СокрЛП(ПредставлениеСпециальноеОбстоятельствоФНС)) < ДлинаКодаСпецОбстоятельств Тогда
		ОтборСписка = Новый Соответствие;
		УсловияОтбора = Новый Структура("ВидСравнения, ЗначениеОтбора",
			ВидСравненияКомпоновкиДанных.Содержит, ПредставлениеСпециальноеОбстоятельствоФНС);
		ОтборСписка.Вставить("Код", УсловияОтбора);
		ПараметрОткрытия.Вставить("ОтборСписка", ОтборСписка);
	КонецЕсли;
	ОповещениеПослеВыбора = Новый ОписаниеОповещения("ЗаполнитьСпециальноеОбстоятельствоФНС", ЭтотОбъект);
	ОбменСКонтрагентамиКлиент.ОткрытьФормуВыбораСпециальныхОбстоятельствФНС(ПараметрОткрытия, 
		ЭтотОбъект, ОповещениеПослеВыбора);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеСпециальногоОбстоятельстваНаСервере()
	Если ЗначениеЗаполнено(Объект.СпециальноеОбстоятельствоФНС) Тогда
		Результат = ОбменСКонтрагентами.ОписаниеСпециальногоОбстоятельстваФНС(Объект.СпециальноеОбстоятельствоФНС);
		ПредставлениеСпециальноеОбстоятельствоФНС = СтрШаблон("%1 %2", Результат.Код, Результат.Наименование);
	КонецЕсли;
КонецПроцедуры

