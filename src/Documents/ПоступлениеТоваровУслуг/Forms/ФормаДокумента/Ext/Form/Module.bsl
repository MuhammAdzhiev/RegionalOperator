&НаСервере
Процедура НастроитьДоступностьТаблицыТовары()
	
	Элементы.Товары.ИзменятьПорядокСтрок = Истина;
	Элементы.Товары.ИзменятьСоставСтрок = Истина;
	
	// Команда
	
	НоваяКомандаФормы = ЭтотОбъект.Команды.Добавить("Демо_ДобавитьСтрокуВТаблицуТовары");
	
	НоваяКомандаФормы.Заголовок = НСтр("ru = 'Добавить'");
	НоваяКомандаФормы.Действие  = "Подключаемый_ДобавитьСтрокуВТаблицуТовары";
	
	// КоманднаяПанель
	
	НовыйЭлемент = ЭтотОбъект.Элементы.Вставить(
		"Демо_КоманднаяПанель", 
		Тип("ГруппаФормы"), 
		Элементы.СтраницаТовары, 
		Элементы.Товары);
	
	НовыйЭлемент.Вид = ВидГруппыФормы.КоманднаяПанель;	
	
	// Элемент кнопка
	
	НовыйЭлемент = ЭтотОбъект.Элементы.Добавить("Демо_ДобавитьСтрокуВТаблицуТовары", Тип("КнопкаФормы"), НовыйЭлемент);
	
	НовыйЭлемент.Вид         = ВидКнопкиФормы.КнопкаКоманднойПанели;
	НовыйЭлемент.ИмяКоманды  = "Демо_ДобавитьСтрокуВТаблицуТовары";
	НовыйЭлемент.Отображение = ОтображениеКнопки.Текст;
	
	Элементы.ТоварыЦена.УстановитьДействие("ПриИзменении",       "Подключаемый_ПриИзмененииЦеныКоличестваТаблицыТовары");
	Элементы.ТоварыКоличество.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииЦеныКоличестваТаблицыТовары");
	Элементы.ТоварыСумма.УстановитьДействие("ПриИзменении",      "Подключаемый_ПриИзмененииСуммыТаблицыТовара");
	Элементы.ТоварыСтавкаНДС.УстановитьДействие("ПриИзменении",  "Подключаемый_ПриИзмененииСтавкиНДСТаблицыТовара");
	
	УстановитьВозможностьРедактированияРеквизитов(ЭтотОбъект, Истина);
	
КонецПроцедуры

