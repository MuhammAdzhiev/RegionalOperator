&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыКоличество");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыЦена");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСумма");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСтавкаНДС");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		"Объект.Товары.КоличествоУпаковокДоКорректировки", ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	КлиентЭДО.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект);
	КлиентЭДО.УстановитьУсловноеОформлениеКоличестваИЕдиницыИзмерения(ЭтотОбъект);
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ДенежныеОбязательстваГосЗакупкиВидСредств");
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	Если Объект.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная
		ИЛИ Объект.ВидДокумента = Перечисления.ВидыДокументов.СведенияКомиссионера Тогда
		ПодготовитьФормуТоварнаяНакладная();
		
	ИначеЕсли Объект.ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот Тогда
		ПодготовитьФормуАктВыполненныхРабот();
		
	ИначеЕсли Объект.ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав Тогда
		ПодготовитьФормуАктНаПередачуПрав();
		
	ИначеЕсли Объект.ВидДокумента = Перечисления.ВидыДокументов.НакладнаяНаВозврат Тогда
		ПодготовитьФормуНакладнаяНаВозврат();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуТоварнаяНакладная()
	
	ПодготовитьФормуДокумента();
	
	КлиентЭДО.ЗаполнитьПредставленияРНПТ(Объект.Товары, Объект.СведенияПрослеживаемости);	
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуАктВыполненныхРабот()
	
	ПодготовитьФормуДокумента();
	
	Элементы.СтраницаТовары.Заголовок = НСтр("ru = 'Услуги'");
	Элементы.ТоварыГруппаСуммаАкциза.Видимость    = Ложь;
	Элементы.ТоварыНомерГТД.Видимость             = Ложь;
	Элементы.ТоварыСтранаПроисхождения.Видимость  = Ложь;
	Элементы.СтраницаСведенияОПолучении.Видимость = Ложь;
	Элементы.ОблагаетсяНДСУПокупателя.Видимость   = Ложь;
	Элементы.ТоварыМаркируемыеУпаковки.Видимость  = Ложь;
	Элементы.ТоварыМаркируемыеУпаковкиДоКорректировки.Видимость  = Ложь;
	Элементы.ТоварыРНПТ.Видимость = Ложь;
	Элементы.ТоварыКомитент.Видимость = Ложь;
	Элементы.ТоварыДоговорСКомитентом.Видимость = Ложь;
	Элементы.ТоварыГруппаДанныеАмортизации.Видимость = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуАктНаПередачуПрав()
	
	ПодготовитьФормуАктВыполненныхРабот();
	
КонецПроцедуры

