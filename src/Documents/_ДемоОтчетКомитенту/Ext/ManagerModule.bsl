#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Получение данных для формирования электронного документа.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка.РеализацияТоваровУслуг - ссылка на документ.
// 
// Возвращаемое значение:
//  Структура - структура данных для печати.
//
Функция ПолучитьДанныеДляЭД(СсылкаНаОбъект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Товары.НомерСтроки КАК НомерСтроки,
		|	Товары.Ссылка.Контрагент КАК Владелец,
		|	Товары.НоменклатураКонтрагента КАК НоменклатураКонтрагента,
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Характеристика КАК Характеристика,
		|	Товары.ЕдиницаИзмерения КАК Упаковка
		|ИЗ
		|	Документ._ДемоОтчетКомитенту.Товары КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	ТаблицаОтбора = Запрос.Выполнить().Выгрузить();
	
	МенеджерТаблиц = Новый МенеджерВременныхТаблиц;
	СопоставлениеНоменклатурыКонтрагентов.СоздатьВременнуюТаблицуНоменклатурыКонтрагентовПоТаблицеОтборов(ТаблицаОтбора,
		"втНоменклатураКонтрагента", МенеджерТаблиц);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОтчетКомитенту.Ссылка КАК Ссылка,
		|	ОтчетКомитенту.НомерЭД КАК Номер,
		|	ОтчетКомитенту.Дата КАК Дата,
		|	ОтчетКомитенту.ВидДокумента КАК ВидДокумента,
		|	ОтчетКомитенту.Организация КАК Организация,
		|	ОтчетКомитенту.Контрагент КАК Контрагент,
		|	ОтчетКомитенту.Контрагент.ОсновнойБанковскийСчет КАК БанковскийСчетКонтрагента,
		|	ОтчетКомитенту.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	ОтчетКомитенту.ДоговорКонтрагента.Наименование КАК ДоговорНаименование,
		|	ОтчетКомитенту.ДоговорКонтрагента.НомерДоговора КАК ДоговорНомер,
		|	ОтчетКомитенту.ДоговорКонтрагента.ДатаДоговора КАК ДоговорДата,
		|	ОтчетКомитенту.СуммаДокумента КАК СуммаДокумента,
		|	ОтчетКомитенту.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
		|	ОтчетКомитенту.Валюта КАК Валюта,
		|	ОтчетКомитенту.Валюта.Код КАК ВалютаКод,
		|	ОтчетКомитенту.УслугаПоВознаграждению КАК УслугаПоВознаграждению,
		|	ОтчетКомитенту.СпособРасчетаВознаграждения КАК СпособРасчетаВознаграждения,
		|	ОтчетКомитенту.ПроцентВознаграждения КАК ПроцентВознаграждения,
		|	ОтчетКомитенту.СуммаВознаграждения КАК СуммаВознаграждения,
		|	ОтчетКомитенту.СтавкаНДСВознаграждения КАК СтавкаНДСВознаграждения,
		|	ОтчетКомитенту.СуммаНДСВознаграждения КАК СуммаНДСВознаграждения,
		|	ОтчетКомитенту.УдержатьВознаграждение КАК УдержатьВознаграждение
		|ИЗ
		|	Документ._ДемоОтчетКомитенту КАК ОтчетКомитенту
		|ГДЕ
		|	ОтчетКомитенту.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.Ссылка КАК Ссылка,
		|	Товары.НомерСтроки КАК НомерСтроки,
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Характеристика КАК Характеристика,
		|	ЕСТЬNULL(Товары.Характеристика.Наименование, """") КАК ХарактеристикаНаименование,
		|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
		|	Товары.ДатаРеализации КАК ДатаРеализации, 
		|	СправочникНоменклатура.НаименованиеПолное КАК НоменклатураНаименование,
		|	СправочникНоменклатура.Код КАК НоменклатураКод,
		|	СправочникНоменклатура.Артикул КАК НоменклатураАртикул,
		|	СправочникНоменклатура.СтавкаНДС КАК НоменклатураСтавкаНДС,
		|	СправочникНоменклатура.ВидНоменклатуры.ТипНоменклатуры КАК ТипНоменклатуры,
		|	СправочникНоменклатура.ЕдиницаИзмерения КАК БазоваяЕдиницаСсылка,
		|	&ДанныеБазовойЕдиницы,
		|	&ДанныеУпаковки,
		|	ВЫБОР
		|		КОГДА Товары.Количество = 0
		|			ТОГДА Товары.КоличествоУпаковок
		|		ИНАЧЕ Товары.Количество
		|	КОНЕЦ КАК Количество,
		|	Товары.Цена КАК Цена,
		|	Товары.Сумма КАК Сумма,
		|	Товары.СтавкаНДС КАК СтавкаНДС,
		|	Товары.СуммаНДС КАК СуммаНДС,
		|	Товары.СуммаСНДС КАК СуммаСНДС,
		|	Товары.ЦенаПоступления КАК ЦенаПоступления,
		|	Товары.СуммаПоступления КАК СуммаПоступления,
		|	Товары.СуммаВознаграждения КАК СуммаВознаграждения,
		|	Товары.Покупатель КАК Покупатель,
		|	Товары.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	втНоменклатураКонтрагента.Идентификатор КАК ИдентификаторНоменклатурыКонтрагента,
		|	втНоменклатураКонтрагента.Артикул КАК АртикулНоменклатурыКонтрагента,
		|	втНоменклатураКонтрагента.Наименование КАК НаименованиеНоменклатурыКонтрагента,
		|	втНоменклатураКонтрагента.НаименованиеХарактеристики КАК НаименованиеХарактеристикиКонтрагента,
		|	втНоменклатураКонтрагента.ЕдиницаИзмерения КАК ЕдиницаИзмеренияКонтрагента,
		|	втНоменклатураКонтрагента.ЕдиницаИзмеренияКод КАК ЕдиницаИзмеренияКодКонтрагента,
		|	втНоменклатураКонтрагента.СтавкаНДС КАК СтавкаНДСКонтрагента,
		|	втНоменклатураКонтрагента.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатурыКонтрагента,
		|	втНоменклатураКонтрагента.ШтрихкодКомбинации КАК ШтрихкодКомбинацииКонтрагента
		|ИЗ
		|	Документ._ДемоОтчетКомитенту.Товары КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|			ПО СправочникНоменклатура.Ссылка = Товары.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ втНоменклатураКонтрагента КАК втНоменклатураКонтрагента
		|			ПО Товары.НоменклатураКонтрагента = втНоменклатураКонтрагента.НоменклатураКонтрагента
		|			И Товары.НомерСтроки = втНоменклатураКонтрагента.НомерСтроки
		|			И Товары.НоменклатураКонтрагента <> ЗНАЧЕНИЕ(Справочник.НоменклатураКонтрагентов.ПустаяСсылка)
		|ГДЕ
		|	Товары.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СведенияПрослеживаемости.РНПТ КАК РНПТ,
		|	СведенияПрослеживаемости.КоличествоУпаковок КАК КоличествоУпаковок,
		|	СведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
		|	СведенияПрослеживаемости.ЕдиницаИзмеренияПрослеживаемости.Код КАК ЕдиницаИзмеренияКод,
		|	СведенияПрослеживаемости.ЕдиницаИзмеренияПрослеживаемости.Наименование КАК ЕдиницаИзмеренияНаименование,
		|	СведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки
		|ИЗ
		|	Документ._ДемоОтчетКомитенту.СведенияПрослеживаемости КАК СведенияПрослеживаемости
		|ГДЕ
		|	СведенияПрослеживаемости.Ссылка = &Ссылка";
	
	ОбменСКонтрагентамиКЭДО.ИнициализацияТекстаЗапросаПоискаШтрихкодовПоВременнойТаблицеТоваров(Запрос.Текст,
		Метаданные.Документы._ДемоОтчетКомитенту.Имя, Истина);
	
	Справочники.ЕдиницыИзмерения.ДополнитьЗапросДаннымиЕдиницыИзмеренияУпаковки(
		Запрос.Текст, "&ДанныеБазовойЕдиницы", "СправочникНоменклатура.ЕдиницаИзмерения", "БазоваяЕдиница", Истина);
	
	Справочники.ЕдиницыИзмерения.ДополнитьЗапросДаннымиЕдиницыИзмеренияУпаковки(
		Запрос.Текст, "&ДанныеУпаковки", "Товары.ЕдиницаИзмерения", "ЕдиницаИзмерения");
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаШапки = МассивРезультатов[0].Выбрать();
	
	ВыборкаТоваров = МассивРезультатов[1].Выбрать();
	
	СведенияПрослеживаемости = МассивРезультатов[2].Выгрузить();
	СведенияПрослеживаемости.Индексы.Добавить("ИдентификаторСтроки");
	
	ШтрихкодыКомбинаций = МассивРезультатов[МассивРезультатов.ВГраница()-1].Выгрузить();
	ШтрихкодыКомбинаций.Индексы.Добавить("Номенклатура, Характеристика, ЕдиницаИзмерения");

	ШтрихкодыНоменклатуры = МассивРезультатов[МассивРезультатов.ВГраница()].Выгрузить();
	ШтрихкодыНоменклатуры.Индексы.Добавить("Номенклатура");
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ВыборкаШапки", ВыборкаШапки);
	СтруктураДанных.Вставить("ВыборкаТоваров", ВыборкаТоваров);
	СтруктураДанных.Вставить("СведенияПрослеживаемости", СведенияПрослеживаемости);
	СтруктураДанных.Вставить("ШтрихкодыКомбинаций", ШтрихкодыКомбинаций);
	СтруктураДанных.Вставить("ШтрихкодыНоменклатуры", ШтрихкодыНоменклатуры);
	
	Возврат СтруктураДанных;
	
КонецФункции

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// СтандартныеПодсистемы.ГрупповоеИзменениеОбъектов

// Возвращает реквизиты объекта, которые не разрешается редактировать
// с помощью обработки группового изменения реквизитов.
//
// Возвращаемое значение:
//  Массив - список имен реквизитов объекта.
Функция РеквизитыНеРедактируемыеВГрупповойОбработке() Экспорт
	
	НеРедактируемыеРеквизиты = Новый Массив;
	НеРедактируемыеРеквизиты.Добавить("ВидДокумента");
	Возврат НеРедактируемыеРеквизиты;
	
КонецФункции

// Конец СтандартныеПодсистемы.ГрупповоеИзменениеОбъектов

#КонецЕсли

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("ВидДокумента");
	Поля.Добавить("НомерЭД");
	Поля.Добавить("Дата");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Представление = КлиентЭДОКлиентСервер.ПредставлениеИсходящегоДокументаПоВиду(Данные);
	
КонецПроцедуры

#КонецОбласти
