#КонецОбласти

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "УслугаПоВознаграждению");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		"Объект.УслугаПоВознаграждению", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Комиссионное вознаграждение'"));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);
	
	КлиентЭДО.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииЧтенииНаСервере()
	
	УстановитьЗаголовокФормы();
	
	УстановитьСтатусДокумента();
	
	КлиентЭДО.ЗаполнитьПризнакИспользованияХарактеристик(Объект.Товары);
	
	КлиентЭДО.ЗаполнитьПредставленияРНПТ(Объект.Товары, Объект.СведенияПрослеживаемости);
	
	ВалютаДоИзменения = Объект.Валюта;
	
	Элементы.ТоварыСуммаСНДС.Видимость = НЕ Объект.ЦенаВключаетНДС;
	
	Если Объект.ВидДокумента = Перечисления.ВидыДокументов.ОтчетОПродажахКомиссионногоТовара Тогда
		СчетФактура = Документы.СчетФактураВыданный.СчетФактураДокумента(Объект.Ссылка);
		УстановитьПредставлениеСчетаФактуры(ЭтотОбъект);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ИтогиВознаграждение", "Видимость", Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ГруппаВознаграждение", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ТоварыСуммаВознаграждения", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ТоварыДатаРеализации", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ТоварыПокупатель", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ГруппаСтраницы", "ОтображениеСтраниц", ОтображениеСтраницФормы.Нет);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ЭтотОбъект.Заголовок = КлиентЭДОКлиентСервер.ПредставлениеИсходящегоДокументаПоВиду(Объект, Объект.Ссылка.Пустая());
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтатусДокумента()
	
	СтатусДокумента = КлиентЭДО.СтатусДокумента(Объект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСчетаФактуры(Форма)
	
	Форма.СчетФактураПредставление = КлиентЭДОКлиентСервер.ПредставлениеСчетаФактуры(Форма.СчетФактура);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВариантаРасчетаНДС();
	
	КлиентЭДОКлиентСервер.ПриИзмененииВариантаРасчетаНДС(ЭтотОбъект);
	УстановитьВидимостьПолейНДС();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолейНДС()
	
	ВидимостьНДС = НЕ Объект.ОблагаетсяНДСУПокупателя;
	Элементы.ТоварыСтавкаНДС.Видимость = ВидимостьНДС;
	Элементы.ТоварыСуммаНДС.Видимость = ВидимостьНДС;
	Элементы.ТоварыСуммаСНДС.Видимость = НЕ Объект.ЦенаВключаетНДС;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВалюты()
	
	КурсИсходнойВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДоИзменения, Объект.Дата);
	КурсНовойВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.Валюта, Объект.Дата);
	
	КлиентЭДО.ПересчитатьСтоимостьТоваровВВалютуПоКурсу(Объект.Товары, КурсИсходнойВалюты, КурсНовойВалюты,
		Объект.ЦенаВключаетНДС);
	
	РассчитатьВознаграждениеПоТоварам();
	
	КлиентЭДОКлиентСервер.ПриИзмененииВалюты(ЭтотОбъект);
	
	ВалютаДоИзменения = Объект.Валюта;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииНоменклатуры()
	
	СтрокаТаблицы = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	
	КлиентЭДОКлиентСервер.ПриИзмененииНоменклатуры(СтрокаТаблицы,
		"ЕдиницаИзмерения, СтавкаНДС", Объект.ЦенаВключаетНДС);
	
	НоменклатураИБ = СопоставлениеНоменклатурыКонтрагентовКлиентСервер.НоваяНоменклатураКонтрагентаИнформационнойБазы();
	НоменклатураИБ.Номенклатура            = СтрокаТаблицы.Номенклатура;
	НоменклатураИБ.Характеристика          = СтрокаТаблицы.Характеристика;
	НоменклатураИБ.Упаковка                = СтрокаТаблицы.ЕдиницаИзмерения;
	НоменклатураИБ.НоменклатураКонтрагента = СтрокаТаблицы.НоменклатураКонтрагента;
	
	СтрокаТаблицы.НоменклатураКонтрагента = 
		СопоставлениеНоменклатурыКонтрагентов.НоменклатураКонтрагентаПоНоменклатуреВСтрокеТаблицы(
			Объект.Контрагент, НоменклатураИБ);
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьВознаграждениеПоТоварам()
	
	Для Каждого СтрокаТаблицы Из Объект.Товары Цикл
		РассчитатьВознаграждениеВСтроке(СтрокаТаблицы, Объект.СпособРасчетаВознаграждения, Объект.ПроцентВознаграждения);
	КонецЦикла;
	
	УстановитьСуммуВознаграждения();
	
	РассчитатьСуммуНДСВознаграждения(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьВознаграждениеВСтроке(СтрокаТаблицы, СпособРасчета, ПроцентВознаграждения)
	
	Если СпособРасчета = ПредопределенноеЗначение(
		"Перечисление.СпособыРасчетаКомиссионногоВознаграждения.ПроцентОтРазницыСуммПродажиИПоступления") Тогда
		
		СтрокаТаблицы.СуммаВознаграждения = ПроцентВознаграждения
			/ 100 * (СтрокаТаблицы.СуммаСНДС - СтрокаТаблицы.СуммаПоступления);
		
	ИначеЕсли СпособРасчета = ПредопределенноеЗначение(
		"Перечисление.СпособыРасчетаКомиссионногоВознаграждения.ПроцентОтСуммыПродажи") Тогда
		
		СтрокаТаблицы.СуммаВознаграждения = ПроцентВознаграждения / 100 * СтрокаТаблицы.СуммаСНДС;
		
	Иначе
		
		СтрокаТаблицы.СуммаВознаграждения = 0;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСуммуВознаграждения()
	
	Объект.СуммаВознаграждения = Объект.Товары.Итог("СуммаВознаграждения");
	
	РассчитатьСуммуНДСВознаграждения(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммуНДСВознаграждения(Форма)
	
	Объект = Форма.Объект;
	ЗначениеСтавки = КлиентЭДОКлиентСервер.ПолучитьСтавкуНДСЧислом(Объект.СтавкаНДСВознаграждения);
	Если Объект.ЦенаВключаетНДС Тогда
		Объект.СуммаНДСВознаграждения  = Объект.СуммаВознаграждения - Объект.СуммаВознаграждения / (1 + ЗначениеСтавки);
	Иначе
		Объект.СуммаНДСВознаграждения  = Объект.СуммаВознаграждения * ЗначениеСтавки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьВознаграждениеПриИзмененииДанныхСтроки(СтрокаТаблицы)
	
	Если Объект.СпособРасчетаВознаграждения = ПредопределенноеЗначение(
		"Перечисление.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается") Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьВознаграждениеВСтроке(СтрокаТаблицы, Объект.СпособРасчетаВознаграждения, Объект.ПроцентВознаграждения);
	
	УстановитьСуммуВознаграждения();
	
КонецПроцедуры

#КонецОбласти