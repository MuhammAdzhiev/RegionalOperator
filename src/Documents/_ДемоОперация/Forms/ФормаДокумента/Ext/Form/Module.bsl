// ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
&НаКлиенте
Процедура ТоварыНоменклатураКонтрагентаПриИзменении(Элемент)
	
	ИзмененныеРеквизиты = Новый Массив;
	
	СопоставлениеНоменклатурыКонтрагентовКЭДОКлиент.ПриИзмененииНоменклатурыКонтрагента(Элементы.Товары.ТекущиеДанные, ИзмененныеРеквизиты);
	
	Если Не ИзмененныеРеквизиты.Найти("Номенклатура") = Неопределено Тогда
		ПриИзмененииНоменклатуры(Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураКонтрагентаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ЭлементФормы" , Элемент);
	ДополнительныеПараметры.Вставить("ТекущаяСтрока", ТекущаяСтрока);
	
	ОповещениеОЗакрытие = Новый ОписаниеОповещения("ОбработатьРезультатВыбораНоменклатурыКонтрагента", ЭтотОбъект, ДополнительныеПараметры);
	
	СопоставлениеНоменклатурыКонтрагентовКЭДОКлиент.ОткрытьФормуВыбораНоменклатурыКонтрагента(ЭтотОбъект, Объект.Контрагент,
		ТекущаяСтрока, Элемент.Заголовок, ОповещениеОЗакрытие);
	
КонецПроцедуры
// Конец ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуЭДО(Команда)
	
	ЭлектронноеВзаимодействиеКлиент.ВыполнитьПодключаемуюКомандуЭДО(Команда, ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработчикОжиданияЭДО()
	
	ОбменСКонтрагентамиКлиент.ОбработчикОжиданияЭДО(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыПокупатель.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ВидЭД");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.ТипыДокументовЭДО.ОтчетОПродажахКомиссионногоТовара;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	КлиентЭДО.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтметкуНеЗаполненныхРеквизитов()
	
	Если Объект.ВидЭД = Перечисления.ТипыДокументовЭДО.ПрайсЛист Тогда
		
		Если Объект.НаправлениеЭД = Перечисления.НаправленияЭДО.Входящий Тогда
			
			Элементы.Контрагент.ОтметкаНезаполненного		= ?(ЗначениеЗаполнено(Объект.Контрагент), Ложь, Истина);
			Элементы.Организация.ОтметкаНезаполненного		= Ложь;
			Элементы.Организация.АвтоОтметкаНезаполненного	= Ложь;
			
		КонецЕсли;
		
	Иначе
		
		Элементы.Контрагент.АвтоОтметкаНезаполненного	= Истина;
		Элементы.Организация.АвтоОтметкаНезаполненного	= Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементовСчета()
	
	Если Объект.Ссылка.Пустая() Тогда
		Если Объект.ВидЭД = ПредопределенноеЗначение("Перечисление.ТипыДокументовЭДО.СчетНаОплату") Тогда
			
			Если Объект.НаправлениеЭД = ПредопределенноеЗначение("Перечисление.НаправленияЭДО.Входящий") Тогда
				Элементы.БанковскийСчетКонтрагента.Видимость = Истина;
				Элементы.БанковскийСчетОрганизации.Видимость = Ложь;
				
			Иначе
				
				Элементы.БанковскийСчетКонтрагента.Видимость = Ложь;
				Элементы.БанковскийСчетОрганизации.Видимость = Истина;
				
			КонецЕсли;
			
		Иначе
			Элементы.БанковскийСчетКонтрагента.Видимость = Ложь;
			Элементы.БанковскийСчетОрганизации.Видимость = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УправлениеФормой()
	
	УстановитьВидимостьРеквизитовДокумента();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьРеквизитовДокумента()
	
	Если Объект.ВидЭД = Перечисления.ТипыДокументовЭДО.СчетНаОплату Тогда
		
			Элементы.ТоварыДокументОснование.Видимость = Истина;
			
		Если Объект.НаправлениеЭД = Перечисления.НаправленияЭДО.Входящий Тогда  
			Элементы.БанковскийСчетКонтрагента.Видимость = Истина;
			Элементы.БанковскийСчетОрганизации.Видимость = Ложь;
			
		Иначе
			
			Элементы.БанковскийСчетКонтрагента.Видимость = Ложь;
			Элементы.БанковскийСчетОрганизации.Видимость = Истина;
		КонецЕсли;
		
	Иначе
		
		Элементы.БанковскийСчетКонтрагента.Видимость = Ложь;
		Элементы.БанковскийСчетОрганизации.Видимость = Ложь;
		Элементы.ТоварыДокументОснование.Видимость = Ложь;
		
	КонецЕсли;
	
	ЭтоПрайс = (Объект.ВидЭД = Перечисления.ТипыДокументовЭДО.ПрайсЛист);
	ЭтоСчет = (Объект.ВидЭД = Перечисления.ТипыДокументовЭДО.СчетНаОплату);
	
	Элементы.Основание.Видимость = Не ЭтоПрайс;
	Элементы.ТоварыСумма.Видимость = Не ЭтоПрайс;
	
	ВидимостьНДС = ЭтоСчет И Не Объект.ОблагаетсяНДСУПокупателя;
	
	Элементы.ТоварыСуммаНДС.Видимость = ВидимостьНДС;
	Элементы.ТоварыСуммаСНДС.Видимость = ВидимостьНДС;
	Элементы.ТоварыСтавкаНДС.Видимость = ВидимостьНДС;
	
	Если Объект.ВидЭД = Перечисления.ТипыДокументовЭДО.ОтчетОПродажахКомиссионногоТовара
		ИЛИ Объект.ВидЭД = Перечисления.ТипыДокументовЭДО.ОтчетОСписанииКомиссионногоТовара Тогда
		Элементы.ОблагаетсяНДСУПокупателя.Видимость = Истина;
		Элементы.ФормаКоманднаяПанельКомандыЭДО.Видимость = Ложь; 
		Элементы.ГруппаСостояниеЭДО.Видимость = Ложь;
	Иначе
		Элементы.ОблагаетсяНДСУПокупателя.Видимость = Ложь;
		Элементы.ФормаКоманднаяПанельКомандыЭДО.Видимость = Истина;
		Элементы.ГруппаСостояниеЭДО.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовокФормы()
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если Объект.НаправлениеЭД = Перечисления.НаправленияЭДО.Исходящий Тогда
			ТекстЗаголовка = НСтр("ru = 'Исходящий Демо: Операция %1 от %2'");
		Иначе
			ТекстЗаголовка = НСтр("ru = 'Входящий Демо: Операция %1 от %2'");
		КонецЕсли;
		Заголовок = СтрШаблон(ТекстЗаголовка, Объект.Номер, Объект.Дата);
	Иначе
		Заголовок = НСтр("ru = 'Исходящий Демо: Операция (создание)'");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВидаЭД()
	
	УстановитьОтметкуНеЗаполненныхРеквизитов();
	
	УстановитьВидимостьРеквизитовДокумента();
	
	УстановитьВидимостьНоменклатуры();

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКонтрагента()
	
	ПриИзмененииКлючевыхРеквизитовСостояниеЭДО();
	
	// ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ПриИзмененииВладельцаНоменклатурыКонтрагентов(Объект.Контрагент, Объект.Товары);
	// Конец ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКлючевыхРеквизитовСостояниеЭДО()
	
	ПараметрыПриИзменении = ОбменСКонтрагентами.ПараметрыПриИзмененииКлючевыхРеквизитовЭДО();
	
	ПараметрыПриИзменении.Форма                 = ЭтотОбъект;
	ПараметрыПриИзменении.ДокументСсылка        = Объект.Ссылка;
	ПараметрыПриИзменении.ДокументОбъект        = РеквизитФормыВЗначение("Объект");
	ПараметрыПриИзменении.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПриИзменении.ГруппаСостояниеЭДО    = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриИзмененииКлючевыхРеквизитовЭДО(ПараметрыПриИзменении);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииНоменклатуры(ТребуетсяПодобратьНоменклатуруКонтрагента)
	
	ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	
	// ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	Если ТребуетсяПодобратьНоменклатуруКонтрагента Тогда
		СопоставлениеНоменклатурыКонтрагентовКЭДОКлиент.ПодобратьНоменклатуруКонтрагента(Объект.Контрагент, ТекущаяСтрока);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	
	ТекущаяСтрокаСтруктурой = Новый Структура;
	ТекущаяСтрокаСтруктурой.Вставить("Номенклатура");
	ТекущаяСтрокаСтруктурой.Вставить("ЕдиницаИзмерения");
	
	ТекущаяСтрокаСтруктурой.Вставить("Цена");
	ТекущаяСтрокаСтруктурой.Вставить("Количество");
	ТекущаяСтрокаСтруктурой.Вставить("Сумма");
	ТекущаяСтрокаСтруктурой.Вставить("СтавкаНДС");
	ТекущаяСтрокаСтруктурой.Вставить("СуммаНДС");
	ТекущаяСтрокаСтруктурой.Вставить("СуммаСНДС");
	
	ЗаполнитьЗначенияСвойств(ТекущаяСтрокаСтруктурой, ТекущаяСтрока);
	ОбработатьСтрокуТЧ(ТекущаяСтрокаСтруктурой);
	ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ТекущаяСтрокаСтруктурой);
	
	ЗначенияРеквизитов = РеквизитыНоменклатуры(ТекущаяСтрока.Номенклатура);
	ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ЗначенияРеквизитов);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьСтрокуТЧ(ТекущаяСтрока)
	
	Если ТекущаяСтрока.Свойство("Номенклатура") Тогда
		
		ТекущаяСтрока.ЕдиницаИзмерения = ТекущаяСтрока.Номенклатура.ЕдиницаИзмерения;
		ТекущаяСтрока.СтавкаНДС = ТекущаяСтрока.Номенклатура.СтавкаНДС;
		
		Если ТекущаяСтрока.Свойство("Содержание") Тогда
			ТекущаяСтрока.Содержание = ТекущаяСтрока.Номенклатура.НаименованиеПолное;
		КонецЕсли;
		
	КонецЕсли;
	
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Цена * ТекущаяСтрока.Количество;
	Если ТекущаяСтрока.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС Тогда
		ЗначениеСтавки = ОбменСКонтрагентамиИнтеграция.ЗначениеСтавкиНДСИзПеречисления(ТекущаяСтрока.СтавкаНДС);
	Иначе
		ЗначениеСтавки = 0;
	КонецЕсли;
	ТекущаяСтрока.СуммаНДС = ТекущаяСтрока.Сумма * ЗначениеСтавки / (1 + ЗначениеСтавки);
	ТекущаяСтрока.СуммаСНДС = ТекущаяСтрока.Сумма;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыНоменклатуры(Знач СсылкаНаОбъект, Знач Реквизиты = "");
	
	Возврат КлиентЭДО.РеквизитыНоменклатурыПриИзменении(СсылкаНаОбъект, Реквизиты);
	
КонецФункции

&НаСервере
Процедура ОблагаетсяНДСУПокупателяПриИзмененииНаСервере()
	
	УправлениеФормой();
	
	Для каждого СтрокаТовара Из Объект.Товары Цикл
		
		Если Объект.ОблагаетсяНДСУПокупателя Тогда
			СтрокаТовара.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		Иначе
			СтрокаТовара.СтавкаНДС = СтрокаТовара.Номенклатура.СтавкаНДС;
		КонецЕсли;
		
		ТекущаяСтрокаСтруктурой = Новый Структура;
		ТекущаяСтрокаСтруктурой.Вставить("Цена");
		ТекущаяСтрокаСтруктурой.Вставить("Количество");
		ТекущаяСтрокаСтруктурой.Вставить("Сумма");
		ТекущаяСтрокаСтруктурой.Вставить("СтавкаНДС");
		ТекущаяСтрокаСтруктурой.Вставить("СуммаНДС");
		ТекущаяСтрокаСтруктурой.Вставить("СуммаСНДС");
		
		ЗаполнитьЗначенияСвойств(ТекущаяСтрокаСтруктурой, СтрокаТовара);
		ОбработатьСтрокуТЧ(ТекущаяСтрокаСтруктурой);
		ЗаполнитьЗначенияСвойств(СтрокаТовара, ТекущаяСтрокаСтруктурой);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьНоменклатуры()
	
	Элементы.ТоварыНоменклатура.Видимость = Истина;
	Элементы.ТоварыХарактеристика.Видимость = Истина;
	Элементы.ТоварыНоменклатураКонтрагента.Видимость = Истина;
	
	Если Объект.НаправлениеЭД = Перечисления.НаправленияЭДО.Входящий Тогда
		Если Не ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры") Тогда
			Элементы.ТоварыНоменклатура.Видимость = Ложь;
			Элементы.ТоварыХарактеристика.Видимость = Ложь;
		КонецЕсли;
	ИначеЕсли Объект.ВидЭД <> Перечисления.ТипыДокументовЭДО.ОтчетОПродажахКомиссионногоТовара
		И Объект.ВидЭД <> Перечисления.ТипыДокументовЭДО.ОтчетОСписанииКомиссионногоТовара Тогда
		Элементы.ТоварыНоменклатураКонтрагента.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

// ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
&НаКлиенте
Процедура ОбработатьРезультатВыбораНоменклатурыКонтрагента(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.ТекущаяСтрока.НоменклатураКонтрагента = ВыбранноеЗначение;
	
	ТоварыНоменклатураКонтрагентаПриИзменении(ДополнительныеПараметры.ЭлементФормы);
	
КонецПроцедуры
// Конец ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов

#КонецОбласти