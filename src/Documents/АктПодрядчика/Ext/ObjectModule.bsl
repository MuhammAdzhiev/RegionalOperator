// Назначение модуля: Проведение акта подрядчика с проверкой сверки объемов и записью заявленных подрядчиком объемов.
// Перед сохранением пересчитывает статусы и расхождения по каждой строке акта.
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Для Каждого ТекСтрока Из Строки Цикл
		РОТКО_Подрядчики.ПересчитатьСверкуСтроки(ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры
// Проверяет акт и уникальность ключей строк, наличие обоих объемов и формирует движения заявленного объема.
Процедура ОбработкаПроведения(Отказ, Режим)
	
	ТекстОшибки = РОТКО_ПроверкиПроведения.ПроверитьАктПодрядчика(ЭтотОбъект);
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		Отказ = Истина;
		Сообщить(ТекстОшибки);
		Возврат;
	КонецЕсли;
	// Ключ строки акта состоит из рейса, ТС и объекта приема; повторный ключ при проведении недопустим.
	ПроверенныеКлючи = Новый Соответствие;
	НомерСтроки = 0;
	
	Для Каждого ТекСтрока Из Строки Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.Рейс) Или НЕ ЗначениеЗаполнено(ТекСтрока.ТС) 
			Или НЕ ЗначениеЗаполнено(ТекСтрока.ОбъектПриема) Тогда
			
			Отказ = Истина;
			Сообщить("Строка " + Строка(НомерСтроки) + ": должны быть заполнены рейс, ТС и объект приема.");
			Возврат;
			
		КонецЕсли;
		
		Ключ = РОТКО_Подрядчики.КлючСтрокиАкта(
		ТекСтрока.Рейс, ТекСтрока.ТС, ТекСтрока.ОбъектПриема);
		
		Если ПроверенныеКлючи.Получить(Ключ) <> Неопределено Тогда
			Отказ = Истина;
			Сообщить("Строка " + Строка(НомерСтроки) + ": повторяется сочетание рейс / ТС / объект приема.");
			Возврат;
		КонецЕсли;
		
		ПроверенныеКлючи.Вставить(Ключ, Истина);
		// Проводим только строки, для которых определены оба источника.
		Если НЕ ТекСтрока.НашиДанныеПолучены
			Или НЕ ТекСтрока.ДанныеПодрядчикаПолучены Тогда
			
			Отказ = Истина;
			Сообщить("Строка " + Строка(НомерСтроки) + ": для проведения нужны оба объема (наш и подрядчика).");
			Возврат;
		КонецЕсли;
		
		Если ТекСтрока.ОбъемПоНашимДаннымМ3 < 0 Или ТекСтрока.ОбъемПоДаннымПодрядчикаМ3 < 0 Тогда
			Отказ = Истина;
			Сообщить("Строка " + Строка(НомерСтроки) + ": объемы не могут быть отрицательными.");
			Возврат;
		КонецЕсли;
		
		РОТКО_Подрядчики.ПересчитатьСверкуСтроки(ТекСтрока);
		
	КонецЦикла;
	
	Движения.Подрядчик_ЗаявленоМ3.Записывать = Истина;
	Движения.Подрядчик_ЗаявленоМ3.Очистить();
	
	Для Каждого ТекСтрока Из Строки Цикл
		
		Движение = Движения.Подрядчик_ЗаявленоМ3.Добавить();
		Движение.Период = Дата;
		Движение.Подрядчик = Подрядчик;
		Движение.Рейс = ТекСтрока.Рейс;
		Движение.ТС = ТекСтрока.ТС;
		Движение.ОбъектПриема = ТекСтрока.ОбъектПриема;  
		// Это регистр ЗАЯВЛЕННЫХ подрядчиком объемов, а не согласованных или разницы с нашими данными.
		Движение.ОбъемМ3 = ТекСтрока.ОбъемПоДаннымПодрядчикаМ3;
		
	КонецЦикла;
	
КонецПроцедуры
