&НаСервере
Процедура ЗаполнитьТаблицуУпаковокПоВыборке(ТаблицаУпаковок, Выборка)
	
	ТаблицаУпаковок.Очистить();
	НомерСтроки = 1;
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

КонецПроцедуры

