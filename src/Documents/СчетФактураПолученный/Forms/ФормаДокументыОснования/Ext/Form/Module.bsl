
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("СписокОснований") Тогда
		Для Каждого Основание Из Параметры.СписокОснований Цикл
			СписокОснований.Добавить(Основание.Значение);
		КонецЦикла;
	КонецЕсли;
	
	УстановитьСвойстваПоляОснования();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокОснований

&НаКлиенте
Процедура СписокОснованийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПоказатьЗначение(,Элемент.ТекущиеДанные.Значение);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	ПеренестиДанные();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	
	Закрыть();

КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьСвойстваПоляОснования() 
	
	ФиксированныеНастройки = Новый НастройкиКомпоновкиДанных;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ФиксированныеНастройки.Отбор, "ВидОперации",
		Параметры.ВидОперации, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ФиксированныеНастройки.Отбор, "Организация",
		Параметры.Организация, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ФиксированныеНастройки.Отбор, "Контрагент",
		Параметры.Контрагент, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	
	МассивПараметров = Новый Массив;
	
	ПараметрВыбора = Новый ПараметрВыбора("ФиксированныеНастройки", ФиксированныеНастройки);
	МассивПараметров.Добавить(ПараметрВыбора);
	
	ПараметрВыбора = Новый ПараметрВыбора("ВидОперации", Параметры.ВидОперации);
	МассивПараметров.Добавить(ПараметрВыбора);
	
	ПараметрВыбора = Новый ПараметрВыбора("Организация", Параметры.Организация);
	МассивПараметров.Добавить(ПараметрВыбора);
	
	ПараметрВыбора = Новый ПараметрВыбора("Контрагент", Параметры.Контрагент);
	МассивПараметров.Добавить(ПараметрВыбора);
	
	Элементы.СписокОснованийЗначение.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
	Элементы.СписокОснованийЗначение.КнопкаВыбора = Истина;
	Элементы.СписокОснованийЗначение.КнопкаВыпадающегоСписка = Ложь;
	Элементы.СписокОснованийЗначение.КнопкаСоздания = Ложь;
	Элементы.СписокОснованийЗначение.КнопкаОчистки = Истина;
	Элементы.СписокОснованийЗначение.РедактированиеТекста = Ложь;
	Элементы.СписокОснованийЗначение.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиДанные()
	
	Закрыть(СписокОснований.ВыгрузитьЗначения());
	
КонецПроцедуры

#КонецОбласти

