#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

// Получение данных для формирования электронного документа.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка.РеализацияТоваровУслуг - ссылка на документ.
// 
// Возвращаемое значение:
//  Структура - структура данных для печати.
//
Функция ПолучитьДанныеДляЭД(СсылкаНаОбъект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Ссылка.Контрагент КАК Владелец,
	|	Товары.НоменклатураКонтрагента КАК НоменклатураКонтрагента,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.ЕдиницаИзмерения КАК Упаковка
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	ТаблицаОтбора = Запрос.Выполнить().Выгрузить();
	
	МенеджерТаблиц = Новый МенеджерВременныхТаблиц;
	СопоставлениеНоменклатурыКонтрагентов.СоздатьВременнуюТаблицуНоменклатурыКонтрагентовПоТаблицеОтборов(
		ТаблицаОтбора, "втНоменклатураКонтрагента", МенеджерТаблиц);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказПокупателяТовары.НомерСтроки КАК НомерСтроки,
	|	ЗаказПокупателяТовары.Номенклатура КАК Номенклатура,
	|	СправочникНоменклатура.Артикул КАК НоменклатураАртикул,
	|	СправочникНоменклатура.СтавкаНДС КАК НоменклатураСтавкаНДС,
	|	СправочникНоменклатура.ЕдиницаИзмерения КАК БазоваяЕдиницаСсылка,
	|	&ДанныеБазовойЕдиницы,
	|	ЗаказПокупателяТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	&ДанныеУпаковки,
	|	ЗаказПокупателяТовары.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(ЗаказПокупателяТовары.Характеристика.Наименование, """") КАК ХарактеристикаНаименование,
	|	ВЫБОР
	|		КОГДА ЗаказПокупателяТовары.Количество = 0
	|			ТОГДА ЗаказПокупателяТовары.КоличествоУпаковок
	|		ИНАЧЕ ЗаказПокупателяТовары.Количество
	|	КОНЕЦ КАК Количество,
	|	ЗаказПокупателяТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ЗаказПокупателяТовары.Цена КАК Цена,
	|	ЗаказПокупателяТовары.Сумма КАК Сумма,
	|	ЗаказПокупателяТовары.СуммаСкидки КАК СуммаСкидки,
	|	ВЫБОР
	|		КОГДА ЗаказПокупателяТовары.Сумма <> 0
	|			ТОГДА ВЫРАЗИТЬ(ЕСТЬNULL(ЗаказПокупателяТовары.СуммаСкидки, 0) * 100 / ЗаказПокупателяТовары.Сумма КАК ЧИСЛО(15, 3))
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПроцентСкидки,
	|	ВЫБОР
	|		КОГДА ЗаказПокупателяТовары.Ссылка.ОблагаетсяНДСУПокупателя
	|			ТОГДА ""НДС исчисляется налоговым агентом""
	|		ИНАЧЕ ЗаказПокупателяТовары.СтавкаНДС
	|	КОНЕЦ КАК СтавкаНДС,
	|	ЗаказПокупателяТовары.Ссылка.ЦенаВключаетНДС КАК НДСУчтеноВСумме,
	|	ЗаказПокупателяТовары.СуммаНДС КАК СуммаНДС,
	|	ЗаказПокупателяТовары.СуммаСНДС КАК СуммаСНДС,
	|	ЗаказПокупателяТовары.ДокументОснование КАК ДокументОснование,
	|	СправочникНоменклатура.Код КАК Артикул,
	|	СправочникНоменклатура.НаименованиеПолное КАК НаименованиеПолное,
	|	ЕСТЬNULL(втНоменклатураКонтрагента.Артикул, """") КАК АртикулКонтрагента,
	|	ЕСТЬNULL(втНоменклатураКонтрагента.Наименование, """") КАК НаименованиеКонтрагента,
	|	ЕСТЬNULL(втНоменклатураКонтрагента.НаименованиеХарактеристики, """") КАК ХарактеристикаКонтрагента,
	|	ЕСТЬNULL(втНоменклатураКонтрагента.ЕдиницаИзмерения, """") КАК ЕдиницаИзмеренияКонтрагента,
	|	ЕСТЬNULL(втНоменклатураКонтрагента.ЕдиницаИзмеренияКод, """") КАК ЕдиницаИзмеренияКодКонтрагента,
	|	ЕСТЬNULL(втНоменклатураКонтрагента.СтавкаНДС, """") КАК СтавкаНДСКонтрагента,
	|	ЕСТЬNULL(втНоменклатураКонтрагента.ШтрихкодыНоменклатуры, """") КАК ШтрихкодыНоменклатурыКонтрагента,
	|	ЕСТЬNULL(втНоменклатураКонтрагента.ШтрихкодКомбинации, """") КАК ШтрихкодКомбинацииКонтрагента,
	|	ЕСТЬNULL(втНоменклатураКонтрагента.Идентификатор, """") КАК ИдентификаторКонтрагента
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО (СправочникНоменклатура.Ссылка = ЗаказПокупателяТовары.Номенклатура)
	|	ЛЕВОЕ СОЕДИНЕНИЕ втНоменклатураКонтрагента КАК втНоменклатураКонтрагента
	|		ПО ЗаказПокупателяТовары.НоменклатураКонтрагента = втНоменклатураКонтрагента.НоменклатураКонтрагента
	|		И ЗаказПокупателяТовары.НомерСтроки = втНоменклатураКонтрагента.НомерСтроки
	|		И ВЫРАЗИТЬ(ЗаказПокупателяТовары.НоменклатураКонтрагента КАК Справочник.НоменклатураКонтрагентов) <> ЗНАЧЕНИЕ(Справочник.НоменклатураКонтрагентов.ПустаяСсылка)
	|ГДЕ
	|	ЗаказПокупателяТовары.Ссылка В(&Ссылка)
	|	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказПокупателя.Номер КАК Номер,
	|	ЗаказПокупателя.Дата КАК Дата,
	|	ЗаказПокупателя.Организация КАК Организация,
	|	ЗаказПокупателя.Контрагент КАК Контрагент,
	|	ЗаказПокупателя.Контрагент КАК Грузополучатель,
	|	ЗаказПокупателя.СуммаДокумента КАК СуммаДокумента,
	|	&ХозОперация КАК ХозОперация,
	|	ЗаказПокупателя.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	ЗаказПокупателя.Валюта КАК Валюта,
	|	ЗаказПокупателя.Валюта.Код КАК ВалютаКод,
	|	ЗаказПокупателя.Основание КАК ДокументОснование,
	|	ЗаказПокупателя.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЗаказПокупателя.ДоговорКонтрагента.НомерДоговора КАК ДоговорНомер,
	|	ЗаказПокупателя.ДоговорКонтрагента.ДатаДоговора КАК ДоговорДата,
	|	ЗаказПокупателя.ДоговорКонтрагента.Наименование КАК ДоговорНаименование,
	|	ЗаказПокупателя.БанковскийСчет КАК БанковскийСчет,
	|	ЕСТЬNULL(ЗаказПокупателя.БанковскийСчет.НомерСчета, """") КАК НомерСчета,
	|	ЗаказПокупателя.БанковскийСчет.Банк КАК Банк,
	|	ЕСТЬNULL(ЗаказПокупателя.БанковскийСчет.Банк.Наименование, """") КАК БанкНаименование,
	|	ЕСТЬNULL(ЗаказПокупателя.БанковскийСчет.Банк.КоррСчет, """") КАК БанкСчетКорр,
	|	ЕСТЬNULL(ЗаказПокупателя.БанковскийСчет.Банк.Код, """") КАК БанкБИК,
	|	ЗаказПокупателя.БанковскийСчет.БанкДляРасчетов КАК БанкДляРасчетов,
	|	ЕСТЬNULL(ЗаказПокупателя.БанковскийСчет.БанкДляРасчетов.Наименование, """") КАК БанкКоррНаименование,
	|	ЕСТЬNULL(ЗаказПокупателя.БанковскийСчет.БанкДляРасчетов.КоррСчет, """") КАК БанкКоррСчетКорр,
	|	ЕСТЬNULL(ЗаказПокупателя.БанковскийСчет.БанкДляРасчетов.Код, """") КАК БанкКоррБИК,
	|	ЗаказПокупателя.АдресДоставки КАК АдресДоставки,
	|	ЗаказПокупателя.АдресДоставкиЗначение КАК АдресДоставкиЗначение,
	|	ЗаказПокупателя.АдресДоставкиЗначенияПолей КАК АдресДоставкиЗначенияПолей,
	|	ЗаказПокупателя.СпособДоставки КАК СпособДоставки,
	|	ЗаказПокупателя.ДатаЭД КАК ДатаПоДаннымКлиента,
	|	ЗаказПокупателя.НомерЭД КАК НомерПоДаннымКлиента,
	|	ЗаказПокупателя.Комментарий КАК ДополнительнаяИнформация,
	|	""КоммерческаяИнформация"" КАК type,
	|	ЗаказПокупателя.ОблагаетсяНДСУПокупателя КАК ОблагаетсяНДСУПокупателя
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.Ссылка В(&Ссылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭтапыГрафикаОплаты.ВариантОплаты КАК ВидОплаты,
	|	ЭтапыГрафикаОплаты.ДатаПлатежа КАК ДатаПлатежа,
	|	ЭтапыГрафикаОплаты.ПроцентПлатежа КАК ПроцентПлатежа,
	|	ЭтапыГрафикаОплаты.СуммаПлатежа КАК СуммаПлатежа
	|ИЗ
	|	Документ.ЗаказПокупателя.ЭтапыГрафикаОплаты КАК ЭтапыГрафикаОплаты
	|ГДЕ
	|	ЭтапыГрафикаОплаты.Ссылка = &Ссылка";
	
	ОбменСКонтрагентамиКЭДО.ИнициализацияТекстаЗапросаПоискаШтрихкодовПоВременнойТаблицеТоваров(Запрос.Текст, Метаданные.Документы.ЗаказПокупателя.Имя, Истина);
	
	Справочники.ЕдиницыИзмерения.ДополнитьЗапросДаннымиЕдиницыИзмеренияУпаковки(
		Запрос.Текст, "&ДанныеБазовойЕдиницы", "СправочникНоменклатура.ЕдиницаИзмерения", "БазоваяЕдиница", Истина);
		
	Справочники.ЕдиницыИзмерения.ДополнитьЗапросДаннымиЕдиницыИзмеренияУпаковки(
		Запрос.Текст, "&ДанныеУпаковки", "ЗаказПокупателяТовары.ЕдиницаИзмерения", "ЕдиницаИзмерения");
		
	Запрос.УстановитьПараметр("Ссылка",      СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ХозОперация", НСтр("ru = 'Заказ товара'"));
		
	МассивРезультатов = Запрос.ВыполнитьПакет();
	РезультатПоТабличнойЧасти = МассивРезультатов[0];
	РезультатПоШапке = МассивРезультатов[1];
	РезультатПоЭтапамГрафикаОплат = МассивРезультатов[2].Выгрузить();
	
	СтруктураДанныхДляПечати = Новый Структура("РезультатПоШапке, РезультатПоТабличнойЧасти, РезультатПоЭтапамГрафикаОплат",
		РезультатПоШапке, РезультатПоТабличнойЧасти, РезультатПоЭтапамГрафикаОплат);
	
	ШтрихкодыКомбинаций = МассивРезультатов[МассивРезультатов.ВГраница()-1].Выгрузить();
	ШтрихкодыКомбинаций.Индексы.Добавить("Номенклатура, Характеристика, ЕдиницаИзмерения");
	СтруктураДанныхДляПечати.Вставить("ШтрихкодыКомбинаций", ШтрихкодыКомбинаций);

	ШтрихкодыНоменклатуры = МассивРезультатов[МассивРезультатов.ВГраница()].Выгрузить();
	ШтрихкодыНоменклатуры.Индексы.Добавить("Номенклатура");
	СтруктураДанныхДляПечати.Вставить("ШтрихкодыНоменклатуры", ШтрихкодыНоменклатуры);

	Возврат СтруктураДанныхДляПечати;
	
КонецФункции

// Возвращает данные заказа покупателя по ссылке.
//
// Параметры:
//  ЗаказПокупателя - ДокументСсылка.ЗаказПокупателя - ссылка на заказ, по которому нужно получить данные.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - данные заказа:
//   * Шапка - Структура - данные шапки заказа.
//   * Товары - ТаблицаЗначений - данные табличной части Товары заказа.
//
Функция ДанныеЗаказаПокупателя(Знач ЗаказПокупателя) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Шапка.Ссылка КАК Ссылка,
	|	Шапка.ПометкаУдаления КАК ПометкаУдаления,
	|	Шапка.Проведен КАК Проведен,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Дата КАК Дата,
	|	Шапка.НомерЭД КАК НомерЭД,
	|	Шапка.ДатаЭД КАК ДатаЭД,
	|	Шапка.ВидДокумента КАК ВидДокумента,
	|	Шапка.Статус КАК Статус,
	|	Шапка.Основание КАК Основание,
	|	Шапка.Организация КАК Организация,
	|	Шапка.Контрагент КАК Контрагент,
	|	Шапка.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Шапка.БанковскийСчет КАК БанковскийСчет,
	|	Шапка.Валюта КАК Валюта,
	|	Шапка.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	Шапка.ВидЦены КАК ВидЦены,
	|	Шапка.СуммаДокумента КАК СуммаДокумента,
	|	Шапка.СпособДоставки КАК СпособДоставки,
	|	Шапка.АдресДоставки КАК АдресДоставки,
	|	Шапка.АдресДоставкиЗначение КАК АдресДоставкиЗначение,
	|	Шапка.АдресДоставкиЗначенияПолей КАК АдресДоставкиЗначенияПолей,
	|	Шапка.Комментарий КАК Комментарий,
	|	Шапка.Ответственный КАК Ответственный,
	|	Шапка.ПредставлениеНомера КАК ПредставлениеНомера
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Товары.КоличествоУпаковок * &КоэффициентУпаковки КАК Количество,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СуммаСкидки КАК СуммаСкидки,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.СуммаСНДС КАК СуммаСНДС,
	|	Товары.ДокументОснование КАК ДокументОснование
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &ЗаказПокупателя
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КоэффициентУпаковки",
		Справочники.ЕдиницыИзмерения.ТекстЗапросаКоэффициентУпаковки("Товары.ЕдиницаИзмерения"));
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаШапка = РезультатыЗапроса[0].Выгрузить();
	ТаблицаТовары = РезультатыЗапроса[1].Выгрузить();
	
	СтрокаШапки = Неопределено;
	Если ЗначениеЗаполнено(ТаблицаШапка) Тогда
		СтрокаШапки = ТаблицаШапка[0];
	Иначе
		СтрокаШапки = ТаблицаШапка.Добавить();
	КонецЕсли;
	
	ДанныеЗаказа = Новый Структура;
	ДанныеЗаказа.Вставить("Шапка", ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаШапки));
	ДанныеЗаказа.Вставить("Товары", ТаблицаТовары);
	
	Возврат Новый ФиксированнаяСтруктура(ДанныеЗаказа);
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// СтандартныеПодсистемы.ГрупповоеИзменениеОбъектов

// Возвращает реквизиты объекта, которые не разрешается редактировать
// с помощью обработки группового изменения реквизитов.
//
// Возвращаемое значение:
//  Массив - список имен реквизитов объекта.
Функция РеквизитыНеРедактируемыеВГрупповойОбработке() Экспорт
	
	НеРедактируемыеРеквизиты = Новый Массив;
	НеРедактируемыеРеквизиты.Добавить("ВидДокумента");
	Возврат НеРедактируемыеРеквизиты;
	
КонецФункции

// Конец СтандартныеПодсистемы.ГрупповоеИзменениеОбъектов

// СтандартныеПодсистемы.ОбновлениеВерсииИБ

// Регистрирует данные для обработчика обновления
// 
// Параметры:
//  Параметры - Структура - параметры.
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	
	Данные = Новый Массив;
	
	Данные_ЗаполнитьРеквизитПоДаннымКонтрагента = ДанныеКОбработкеДляПереходаНаНовуюВерсию_ЗаполнитьРеквизитПоДаннымКонтрагента();
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Данные, Данные_ЗаполнитьРеквизитПоДаннымКонтрагента, Истина);
	
	Данные_НоменклатураКонтрагента = СопоставлениеНоменклатурыКонтрагентовКЭДО.ДанныеКОбработкеДляПереходаНаНовуюВерсию(
		Метаданные.Документы.ЗаказПокупателя);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Данные, Данные_НоменклатураКонтрагента, Истина);
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные, ДополнительныеПараметры);
	
КонецПроцедуры

// Обработчик обновления.
// 
// Параметры:
//  Параметры - Структура - параметры.
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	МетаданныеОбъекта = Метаданные.Документы.ЗаказПокупателя;
	ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
	ПараметрыОтметкиВыполнения = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ОбработанныхОбъектов = 0;
	ПроблемныхОбъектов = 0;
	
	Если ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, "Документ.ЭлектронныйДокументВходящийЭДО")
		Или ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, "РегистрСведений.СостоянияПоОбъектамУчетаЭДО")
		Или ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, "Справочник.СообщениеЭДОПрисоединенныеФайлы")
		Или ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, "РегистрСведений.ХранилищеФайлов")
		Или ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, "РегистрСведений.НоменклатураКонтрагентовБЭД") Тогда
		Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(
			Параметры.Очередь, ПолноеИмяОбъекта);
		Возврат;
	КонецЕсли;
	
	ПараметрыВыборки = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта, ПараметрыВыборки);
	Если Параметры.ПрогрессВыполнения.ВсегоОбъектов = 0 Тогда
		Параметры.ПрогрессВыполнения.ВсегоОбъектов = Выборка.Количество();
	КонецЕсли;
	
	НаборСсылок = Новый Массив;
	Пока Выборка.Следующий() Цикл
		НаборСсылок.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Для каждого СсылкаНаОбъект Из НаборСсылок Цикл
		
		НачатьТранзакцию();
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", СсылкаНаОбъект);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
			Записать = Ложь;
			
			Объект = СсылкаНаОбъект.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				ОбработатьДанные_ЗаполнитьРеквизитПоДаннымКонтрагента(Объект, Записать);
				СопоставлениеНоменклатурыКонтрагентовКЭДО.ОбработатьДанныеДляПереходаНаНовуюВерсию(Объект, Записать);
			КонецЕсли;
			
			Если Записать Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(СсылкаНаОбъект, ПараметрыОтметкиВыполнения);
			КонецЕсли;
			
			ОбработанныхОбъектов = ОбработанныхОбъектов + 1;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			ШаблонСообщения = НСтр("ru = 'Не удалось обработать заказ покупателя: %1 по причине:'");
			ТекстСообщения = СтрШаблон(ШаблонСообщения, СсылкаНаОбъект) + Символы.ПС + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка,
				МетаданныеОбъекта, СсылкаНаОбъект, ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Если ОбработанныхОбъектов = 0 И ПроблемныхОбъектов <> 0 Тогда
		ШаблонСообщения = НСтр("ru = 'Не удалось обработать некоторые заказы покупателя (пропущены): %1'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ПроблемныхОбъектов);
		ВызватьИсключение ТекстСообщения;
	Иначе
		ШаблонСообщения = НСтр("ru = 'Обработана очередная порция заказов покупателя: %1'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ОбработанныхОбъектов);
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			МетаданныеОбъекта,, ТекстСообщения);
	КонецЕсли;
	
	Параметры.ПрогрессВыполнения.ОбработаноОбъектов =
		Параметры.ПрогрессВыполнения.ОбработаноОбъектов + ОбработанныхОбъектов;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(
		Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ОбновлениеВерсииИБ

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Параметры:
// Команды - См. ПодключаемыеКомандыПереопределяемый.ПриОпределенииКомандПодключенныхКОбъекту.Команды
Процедура ЗаполнитьКомандыВводаНаОсновании(Команды) Экспорт
	
	ОписаниеТипаТекущегоОбъекта = Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя");
	
	НоваяКоманда = Команды.Добавить();
	НоваяКоманда.Порядок = 1;
	НоваяКоманда.Идентификатор = "СоздатьНаОснованииРеализациюТоваровУслуг";
	НоваяКоманда.Представление = НСтр("ru = 'Реализация (акт, накладная)'");
	НоваяКоманда.Обработчик = "КлиентЭДОКлиент.СоздатьНаОснованииРеализациюТоваровУслугКоманда";
	НоваяКоманда.ТипПараметра = ОписаниеТипаТекущегоОбъекта;
	
	НоваяКоманда = Команды.Добавить();
	НоваяКоманда.Порядок = 2;
	НоваяКоманда.Идентификатор = "СоздатьНаОснованииСчетНаОплатуПокупателю";
	НоваяКоманда.Представление = НСтр("ru = 'Счет покупателю'");
	НоваяКоманда.Обработчик = "КлиентЭДОКлиент.СоздатьНаОснованииСчетНаОплатуПокупателюКоманда";
	НоваяКоманда.ТипПараметра = ОписаниеТипаТекущегоОбъекта;
	
КонецПроцедуры

#КонецОбласти // СлужебныйПрограммныйИнтерфейс

#КонецЕсли

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("НомерЭД");
	Поля.Добавить("Дата");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Представление = СтрШаблон(НСтр("ru = 'Заказ покупателя %1 от %2'"),
		Данные.НомерЭД, Формат(Данные.Дата, "ДЛФ=D"));
	
КонецПроцедуры

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Параметры:
//  ВидФормы - Строка
//  Параметры - Структура
