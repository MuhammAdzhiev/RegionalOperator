	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ДатаОтгрузки = Макс(ТекущиеДанные.ДатаОтгрузки, Объект.ДатаОтгрузки);
	
