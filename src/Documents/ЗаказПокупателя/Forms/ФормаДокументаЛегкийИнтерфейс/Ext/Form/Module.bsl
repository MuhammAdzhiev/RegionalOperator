&НаКлиенте
Процедура ДобавитьИзВнешнегоФайла(Команда)
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ЗагружатьЦену"				, Истина);
	ПараметрыФормы.Вставить("ЗагружатьКоличество"		, Истина);
	ПараметрыФормы.Вставить("ЗагружатьЕдиницыИзмерения"	, Истина);
	
	Описание = Новый ОписаниеОповещения("ЗагрузитьИзВнешнегоФайла_Завершение", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.ЗагрузкаДанныхИзВнешнихФайлов.Форма.Форма",
		ПараметрыФормы,,,,, Описание);
	
КонецПроцедуры

#Область ДатаОтгрузки

&НаКлиенте
Процедура ЗаполнитьДатуОтгрузки(Команда)
	
	ВыделенныеСтроки = Элементы.Товары.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьДатуОтгрузкиЗавершение", ЭтотОбъект,
			Новый Структура("ВыделенныеСтроки", ВыделенныеСтроки));
		
		ПоказатьВводДаты(Оповещение, Объект.ДатаОтгрузки, НСтр("ru='Введите дату отгрузки'"), ЧастиДаты.Дата);
	Иначе
		ТекстПредупреждения = 
			НСтр("ru='В документе не выбраны строки для заполнения. Дата отгрузки не будет заполнена.'");
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения);
	КонецЕсли;

КонецПроцедуры

