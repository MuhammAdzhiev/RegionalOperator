&НаКлиенте
Процедура ПриИзмененииНоменклатуры(ТребуетсяПодобратьНоменклатуруКонтрагента)
	
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	
	// ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	Если ТребуетсяПодобратьНоменклатуруКонтрагента Тогда
		СопоставлениеНоменклатурыКонтрагентовКЭДОКлиент.ПодобратьНоменклатуруКонтрагента(Объект.Контрагент,
			СтрокаТаблицы);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	
	КлиентЭДОКлиентСервер.ПриИзмененииНоменклатуры(СтрокаТаблицы,
		"ЕдиницаИзмерения,СтавкаНДС", Объект.ЦенаВключаетНДС);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	КлиентЭДО.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект, "ТоварыХарактеристика");
	КлиентЭДО.УстановитьУсловноеОформлениеКоличестваИЕдиницыИзмерения(ЭтотОбъект);
	КлиентЭДО.УстановитьУсловноеОформлениеГрафикаОплат(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	КлиентЭДО.ЗаполнитьПризнакИспользованияХарактеристик(Объект.Товары);
	КлиентЭДО.ЗаполнитьТипНоменклатуры(Объект.Товары);
	КлиентЭДО.ЗаполнитьВариантыРасчетаНДС(ЭтотОбъект);
	ОбновитьЭлементАдресДоставки(Элементы.АдресДоставки, Объект.СпособДоставки);
	УстановитьВидимостьПолейНДС(ЭтотОбъект);
	УстановитьВидимостьНоменклатуры();
	
	УстановитьВидимостьДатыОтгрузки(ЭтотОбъект);
	
	КлиентЭДО.НастроитьВидимостьОрганизацииВФорме(ЭтотОбъект, "Организация");
	
	// Заполнение страниц этапов графика оплат
	КлиентЭДО.ПриЧтенииНаСервереГрафикаОплат(ЭтотОбъект, Объект.ДатаОтгрузки);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКлючевыхРеквизитов()
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ИнтерфейсКлиентЭДО.ЗаполнитьДанныеПоФорматамЭлектронныхДокументовВФормеДокумента(
		ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	ИнтерфейсКлиентЭДОКлиентСервер.НастроитьПоляФорматаЭлектронногоДокументаНаФормеДокумента(ЭтотОбъект);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзВнешнегоФайла_Завершение(Результат, Параметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		Для Каждого СтрокаРезультата Из Результат Цикл
			
			НоваяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультата);
			
			СтруктураРеквизитов = КлиентЭДОВызовСервера.РеквизитыНоменклатуры(
				НоваяСтрока.Номенклатура, "СтавкаНДС");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураРеквизитов);
			
			КлиентЭДОКлиентСервер.ПриИзмененииКоличествоЦена(НоваяСтрока, Объект.ЦенаВключаетНДС);
			
		КонецЦикла;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуКонтактнойИнформацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		// Перенос данных в форму.
		Модифицированность = Истина;
		Объект.АдресДоставкиЗначенияПолей = Результат.КонтактнаяИнформация;
		Объект.АдресДоставки = Результат.Представление;
		Объект.АдресДоставкиЗначение = Результат.Значение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЭлементАдресДоставки(Элемент, СпособДоставки)
	
	Если СпособДоставки = ПредопределенноеЗначение("Перечисление.СпособыДоставки.Доставка") Тогда
		Элемент.Заголовок = НСтр("ru = 'Адрес доставки'");
		Элемент.АвтоОтметкаНезаполненного = Истина;
	Иначе
		Элемент.Заголовок = НСтр("ru = 'Адрес самовывоза'");
		Элемент.АвтоОтметкаНезаполненного = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция КонтактнаяИнформацияПоПредставлению(Текст, ВидКонтактнойИнформации)
	
	ИнформацияJSON = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияПоПредставлению(Текст,
		ВидКонтактнойИнформации);
	ИнформацияXML = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияВXML(ИнформацияJSON, Текст,
		ВидКонтактнойИнформации);
	Возврат Новый Структура("ИнформацияJSON, ИнформацияXML", ИнформацияJSON, ИнформацияXML);
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииВариантаРасчетаНДС()
	
	КлиентЭДОКлиентСервер.ПриИзмененииВариантаРасчетаНДС(ЭтотОбъект);
	УстановитьВидимостьПолейНДС(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПолейНДС(Форма)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	ВидимостьНДС = НЕ Объект.ОблагаетсяНДСУПокупателя;
	Элементы.ТоварыСтавкаНДС.Видимость  = ВидимостьНДС;
	Элементы.ТоварыСуммаНДС.Видимость   = ВидимостьНДС;
	Элементы.ТоварыСуммаСНДС.Видимость  = ВидимостьНДС;
	Элементы.ИтогиВсегоНДС.Видимость    = ВидимостьНДС;
	
	Элементы.ТоварыСуммаСНДС.Видимость = НЕ Объект.ЦенаВключаетНДС;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьНоменклатуры()
	
	Если Объект.ПоДаннымКонтрагента Тогда
		Если Не ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры") Тогда
			Элементы.ТоварыНоменклатура.Видимость = Ложь;
			Элементы.ТоварыХарактеристика.Видимость = Ложь;
		КонецЕсли;
		
		Элементы.ТоварыНоменклатураКонтрагента.ТолькоПросмотр = Истина;
	Иначе
		Элементы.ТоварыНоменклатураКонтрагента.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДатуОтгрузкиЗавершение(ВыбраннаяДата, ДополнительныеПараметры) Экспорт
	
	Если ВыбраннаяДата <> Неопределено И ЗначениеЗаполнено(ВыбраннаяДата) Тогда
		Объект.ДатаОтгрузки = ВыбраннаяДата;

		КлиентЭДОКлиентСервер.ПриИзмененииДатыПоступленияОтгрузки(ЭтотОбъект, "ДатаОтгрузки",
			Объект.ОтгрузкаОднойДатой, ДополнительныеПараметры.ВыделенныеСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьДатыОтгрузки(Форма)

	ОтгрузкаОднойДатой = Форма.Объект.ОтгрузкаОднойДатой;
	
	Форма.Элементы.ТоварыДатаОтгрузки.Видимость = Не ОтгрузкаОднойДатой;
	Форма.Элементы.ДатаОтгрузки.Видимость = ОтгрузкаОднойДатой;
	Форма.Элементы.ТоварыЗаполнитьДатуОтгрузки.Видимость = Не ОтгрузкаОднойДатой;
	Форма.Элементы.ТоварыКонтекстноеМенюЗаполнитьДатуОтгрузки.Видимость = Не ОтгрузкаОднойДатой;

КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	
	ПриИзмененииКлючевыхРеквизитов();
	
	// ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ПриИзмененииВладельцаНоменклатурыКонтрагентов(Объект.Контрагент,
		Объект.Товары);
	// Конец ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	
КонецПроцедуры

// ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов

&НаКлиенте
Процедура ОбработатьРезультатВыбораНоменклатурыКонтрагента(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.ТекущаяСтрока.НоменклатураКонтрагента = ВыбранноеЗначение;
	
	ТоварыНоменклатураКонтрагентаПриИзменении(ДополнительныеПараметры.ЭлементФормы);
	
КонецПроцедуры

