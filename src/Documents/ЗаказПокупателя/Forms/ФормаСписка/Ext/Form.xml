			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
    ЗаказПокупателя.Ссылка КАК Ссылка,
    ЗаказПокупателя.ПометкаУдаления КАК ПометкаУдаления,
    ЗаказПокупателя.Проведен КАК Проведен,
    ЗаказПокупателя.Дата КАК Дата,
    ЗаказПокупателя.Номер КАК Номер,
    ЗаказПокупателя.ВидДокумента КАК ВидДокумента,
    ЗаказПокупателя.Контрагент КАК Контрагент,
    ЗаказПокупателя.Организация КАК Организация,
    ЗаказПокупателя.МоментВремени КАК МоментВремени,
    ЗаказПокупателя.СуммаДокумента КАК СуммаДокумента,
    ВЫРАЗИТЬ(ЗаказПокупателя.Комментарий КАК СТРОКА(100)) КАК Комментарий,
    ЗаказПокупателя.ПредставлениеНомера КАК ПредставлениеНомера,
    СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО КАК СостояниеЭДО,
    СостоянияПоОбъектамУчетаЭДО.ПредставлениеСостояния КАК ПредставлениеСостояния,
    ВЫБОР
        КОГДА ДокументыСОшибкамиПроверкиКонтрагентов.Документ ЕСТЬ NULL
            ТОГДА ЛОЖЬ
        ИНАЧЕ ИСТИНА
    КОНЕЦ КАК СодержитНекорректныхКонтрагентов,
    &amp;ДополнительныеПоляСостояниеEDI КАК ДополнительныеПоляСостояниеEDI
ИЗ
    Документ.ЗаказПокупателя КАК ЗаказПокупателя
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияПоОбъектамУчетаЭДО
        ПО (СостоянияПоОбъектамУчетаЭДО.СсылкаНаОбъект = ЗаказПокупателя.Ссылка)
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыСОшибкамиПроверкиКонтрагентов КАК ДокументыСОшибкамиПроверкиКонтрагентов
        ПО ЗаказПокупателя.Ссылка = ДокументыСОшибкамиПроверкиКонтрагентов.Документ
            И (&amp;ИспользованиеПроверкиВозможно)</QueryText>
				<MainTable>Document.ЗаказПокупателя</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
