#Область РаботаСОснованиемИсправлением

&НаСервере
Процедура УстановитьВидимостьИсправления()
	
	ЭтоИсправление = ЗначениеЗаполнено(Объект.НомерИсправления);
	
	Элементы.ИсправляемыйДокумент.Видимость = ЭтоИсправление;
	Элементы.НомерЭД.ТолькоПросмотр = ЭтоИсправление;
	Элементы.ГруппаНомерИсправления.Видимость = ЭтоИсправление;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеОснования()
	
	ЧастиПредставления = Новый Массив;
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		
		ЧастиПредставления.Добавить(Новый ФорматированнаяСтрока(
			Строка(Объект.ДокументОснование),,,,ПолучитьНавигационнуюСсылку(Объект.ДокументОснование)));
			
		ЧастиПредставления.Добавить("   ");
		
		ЧастиПредставления.Добавить(Новый ФорматированнаяСтрока(
			НСтр("ru = 'Изменить'"),,,,"ИзменитьДокументОснование"));
		
	Иначе
		
		ЧастиПредставления.Добавить(Новый ФорматированнаяСтрока(
			НСтр("ru='<Подбор>'"),,,,"ИзменитьДокументОснование"));
		
	КонецЕсли;
	
	ДокументОснованиеПредставление = Новый ФорматированнаяСтрока(ЧастиПредставления);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьДокументОснование()
	
	// Открываем форму выбора основания.
	// См. ПоказатьВыборДокументаОснования.
	// См. ОбработатьВыборДокументаОснования.
	
	ПоказатьВыборДокументаОснования();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВыборДокументаОснования()
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ОбработатьВыборДокументаОснования", ЭтотОбъект);
	
	ОткрытьФорму("Документ.РеализацияТоваровУслуг.ФормаВыбора"
		,,,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборДокументаОснования(Знач ДокументОснование, Знач ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		
		ЗаполнитьПоДокументуОснованию(ДокументОснование);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументуОснованию(Знач ДокументОснование)
	
	Объект.ДокументОснование = ДокументОснование;
	
	Модифицированность = Истина;
	
	ЗаполнитьПредставлениеОснования();
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСФормой

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// Запрещаем менять данные товаров, заполненных по основанию.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыНоменклатура");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыХарактеристика");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыЕдиницаИзмерения");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыКоличествоПоДокументу");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыЦенаПоДокументу");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСуммаПоДокументу");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСтавкаНДСПоДокументу");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСуммаНДСПоДокументу");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСуммаСНДСПоДокументу");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		"Объект.Товары.ЗаполненоПоОснованию", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Условное оформление характеристик.
	КлиентЭДО.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект);
	
	// Условное оформление полей-надписей.
	КлиентЭДО.УстановитьУсловноеОформлениеНадписейАктаОРасхождениях(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФорму()
	
	УстановитьВозможностьРедактированияРеквизитов(ЭтотОбъект, Ложь);
	
	УстановитьВидимостьИсправления();
	ЗаполнитьПризнакИспользованияХарактеристик();
	ПересчитатьРасхождения();
	ПересчитатьИтоги(ЭтотОбъект);
	
	УстановитьСтатусДокумента();
	ЗаполнитьПредставлениеОснования();
	УстановитьВидимостьПолейНДС();
	УстановитьВидимостьНоменклатуры();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтатусДокумента()
	
	СтатусДокумента = КлиентЭДО.СтатусДокумента(Объект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПризнакИспользованияХарактеристик()
	
	КлиентЭДО.ЗаполнитьПризнакИспользованияХарактеристик(Объект.Товары);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПризнакИспользованияХарактеристикВСтрокеТовара()
	
	СтрокаТовара = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	Если СтрокаТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияРеквизитов = РеквизитыНоменклатуры(СтрокаТовара.Номенклатура, "");
	Если ЗначенияРеквизитов.Свойство("ХарактеристикиИспользуются") Тогда
		СтрокаТовара.ХарактеристикиИспользуются = ЗначенияРеквизитов.ХарактеристикиИспользуются;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьРасхождения()
	
	Для каждого СтрокаТовара Из Объект.Товары Цикл
		
		ПересчитатьРасхожденияВСтрокеТоваров(СтрокаТовара);
		
	КонецЦикла;
	
	Для каждого СтрокаСведений Из Объект.СведенияОГрузе Цикл
		
		ПересчитатьРасхожденияВСтрокеСведенийОГрузе(СтрокаСведений);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста 
Процедура ПересчитатьРасхожденияВСтрокеТоваров(СтрокаТовара)
	
	НаборПолей = СтрРазделить("Количество,Цена,Сумма,СуммаНДС,СуммаСНДС",",");
	Для каждого Поле Из НаборПолей Цикл
		СтрокаТовара[Поле + "Расхождение"] = СтрокаТовара[Поле] - СтрокаТовара[Поле + "ПоДокументу"];
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста 
Процедура ПересчитатьРасхожденияВСтрокеСведенийОГрузе(СтрокаСведений)
	
	НаборПолей = СтрРазделить("МассаБрутто,МассаНетто",",");
	Для каждого Поле Из НаборПолей Цикл
		СтрокаСведений[Поле + "Расхождение"] = СтрокаСведений[Поле] - СтрокаСведений[Поле + "ПоДокументу"];
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста 
Процедура ПересчитатьИтоги(Форма)
	
	Расхождения = 0;
	Излишки = 0;
	Недостачи = 0;
	
	Для каждого СтрокаТовара Из Форма.Объект.Товары Цикл
		
		Расхождения = Расхождения + СтрокаТовара.СуммаСНДСРасхождение;
		Если СтрокаТовара.СуммаСНДСРасхождение > 0 Тогда
			Излишки = Излишки + СтрокаТовара.СуммаСНДСРасхождение;
		Иначе
			Недостачи = Недостачи + (-1) * СтрокаТовара.СуммаСНДСРасхождение;
		КонецЕсли;
		
	КонецЦикла;
	
	Форма.Расхождения = Расхождения;
	Форма.Излишки = Излишки;
	Форма.Недостачи = Недостачи;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВопросОРазрешенииРедактированияРеквизитовОбъекта(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		УстановитьВозможностьРедактированияРеквизитов(ЭтотОбъект);
		Элементы.КомандаРазрешитьРедактированиеРеквизитовОбъекта.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВозможностьРедактированияРеквизитов(Форма, Значение = Истина)
	
	Заблокировать = НЕ Значение;
	
	Элементы = Форма.Элементы;
	
	Элементы.ОбстоятельстваСоставления.ТолькоПросмотр = Заблокировать;
	Элементы.ОбстоятельстваИспользования.ТолькоПросмотр = Заблокировать;
	Элементы.Контрагент.ТолькоПросмотр = Заблокировать;
	Элементы.Организация.ТолькоПросмотр = Заблокировать;
	
	Элементы.Товары.ТолькоПросмотр = Заблокировать;
	Элементы.ТоварыПояснение.ТолькоПросмотр = Заблокировать;
	Элементы.ГруппаБойБрак.ТолькоПросмотр = Заблокировать;
	
	Элементы.СведенияОГрузе.ТолькоПросмотр = Заблокировать;
	
	Элементы.Грузоотправитель.ТолькоПросмотр = Заблокировать;
	Элементы.ДатаОтправленияТоваров.ТолькоПросмотр = Заблокировать;
	Элементы.СтраховаяКомпания.ТолькоПросмотр = Заблокировать;
	Элементы.СопроводительныйДокументНаименование.ТолькоПросмотр = Заблокировать;
	Элементы.СопроводительныйДокументНомер.ТолькоПросмотр = Заблокировать;
