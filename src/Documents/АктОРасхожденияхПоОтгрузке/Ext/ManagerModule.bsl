////////////////////////////////////////////////////////////////////////////////
// Модуль менеджера Документ.АктОРасхожденияхПоОтгрузке
//  
////////////////////////////////////////////////////////////////////////////////

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Получение данных для формирования электронного документа.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка.АктОРасхожденияхПоОтгрузке - ссылка на документ.
// 
// Возвращаемое значение:
//  Структура - данные документа.
//
Функция ПолучитьДанныеДляЭД(СсылкаНаОбъект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КодыМаркировки.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ КодыМаркировки
		|ИЗ
		|	(ВЫБРАТЬ
		|		КодыМаркировкиПоДокументу.Ссылка КАК Ссылка
		|	ИЗ
		|		Документ.АктОРасхожденияхПоОтгрузке.КодыМаркировкиПоДокументу КАК КодыМаркировкиПоДокументу
		|	ГДЕ
		|		КодыМаркировкиПоДокументу.Ссылка = &Ссылка
		|		И КодыМаркировкиПоДокументу.НомерУпаковки <> """"
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		КодыМаркировкиПоФакту.Ссылка
		|	ИЗ
		|		Документ.АктОРасхожденияхПоОтгрузке.КодыМаркировкиПоФакту КАК КодыМаркировкиПоФакту
		|	ГДЕ
		|		КодыМаркировкиПоФакту.Ссылка = &Ссылка
		|		И КодыМаркировкиПоФакту.НомерУпаковки <> """"
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		КодыМаркировкиНедостачи.Ссылка
		|	ИЗ
		|		Документ.АктОРасхожденияхПоОтгрузке.КодыМаркировкиНедостачи КАК КодыМаркировкиНедостачи
		|	ГДЕ
		|		КодыМаркировкиНедостачи.Ссылка = &Ссылка
		|		И КодыМаркировкиНедостачи.НомерУпаковки <> """"
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		КодыМаркировкиИзлишки.Ссылка
		|	ИЗ
		|		Документ.АктОРасхожденияхПоОтгрузке.КодыМаркировкиИзлишки КАК КодыМаркировкиИзлишки
		|	ГДЕ
		|		КодыМаркировкиИзлишки.Ссылка = &Ссылка
		|		И КодыМаркировкиИзлишки.НомерУпаковки <> """"
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		КодыМаркировкиБрак.Ссылка
		|	ИЗ
		|		Документ.АктОРасхожденияхПоОтгрузке.КодыМаркировкиБрак КАК КодыМаркировкиБрак
		|	ГДЕ
		|		КодыМаркировкиБрак.Ссылка = &Ссылка
		|		И КодыМаркировкиБрак.НомерУпаковки <> """"
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		КодыМаркировкиБой.Ссылка
		|	ИЗ
		|		Документ.АктОРасхожденияхПоОтгрузке.КодыМаркировкиБой КАК КодыМаркировкиБой
		|	ГДЕ
		|		КодыМаркировкиБой.Ссылка = &Ссылка
		|		И КодыМаркировкиБой.НомерУпаковки <> """") КАК КодыМаркировки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	АктОРасхожденияхПоОтгрузке.Ссылка КАК Ссылка,
		|	АктОРасхожденияхПоОтгрузке.Организация КАК Организация, 
		|	ВЫБОР
		|		КОГДА АктОРасхожденияхПоОтгрузке.ФормированиеДополнительныхСведений =
		|			ЗНАЧЕНИЕ(Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПокупателемФормируютсяДопСведенияОбОприходованииИмЦенностей)
		|			ТОГДА &ПокупателемФормируютсяДопСведенияОбОприходованииИмЦенностей
		|		КОГДА АктОРасхожденияхПоОтгрузке.ФормированиеДополнительныхСведений =
		|			ЗНАЧЕНИЕ(Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПокупателемФормируютсяДопСведенияОУтвержденииДокумента)
		|			ТОГДА &ПокупателемФормируютсяДопСведенияОУтвержденииДокумента
		|		КОГДА АктОРасхожденияхПоОтгрузке.ФормированиеДополнительныхСведений =
		|			ЗНАЧЕНИЕ(Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПокупателемФормируютсяДопСведенияИные)
		|			ТОГДА &ПокупателемФормируютсяДопСведенияИные
		|		КОГДА АктОРасхожденияхПоОтгрузке.ФормированиеДополнительныхСведений =
		|			ЗНАЧЕНИЕ(Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПродавцомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки)
		|			ТОГДА &ПродавцомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки
		|		КОГДА АктОРасхожденияхПоОтгрузке.ФормированиеДополнительныхСведений =
		|			ЗНАЧЕНИЕ(Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПродавцомФормируютсяДопСведенияИные)
		|			ТОГДА &ПродавцомФормируютсяДопСведенияИные
		|		КОГДА АктОРасхожденияхПоОтгрузке.ФормированиеДополнительныхСведений =
		|			ЗНАЧЕНИЕ(Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПеревозчикомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки)
		|			ТОГДА &ПеревозчикомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки
		|		КОГДА АктОРасхожденияхПоОтгрузке.ФормированиеДополнительныхСведений =
		|			ЗНАЧЕНИЕ(Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПеревозчикомФормируютсяДопСведенияИные)
		|			ТОГДА &ПеревозчикомФормируютсяДопСведенияИные
		|		ИНАЧЕ &НеФормируются
		|	КОНЕЦ КАК ФормированиеДополнительныхСведений,
		|	АктОРасхожденияхПоОтгрузке.СодержаниеДополнительныхСведений КАК СодержаниеДополнительныхСведений,
		|	НЕ КодыМаркировки.Ссылка ЕСТЬ NULL КАК ЕстьМаркировка
		|ИЗ
		|	Документ.АктОРасхожденияхПоОтгрузке КАК АктОРасхожденияхПоОтгрузке
		|		ЛЕВОЕ СОЕДИНЕНИЕ КодыМаркировки КАК КодыМаркировки
		|		ПО АктОРасхожденияхПоОтгрузке.Ссылка = КодыМаркировки.Ссылка
		|ГДЕ
		|	АктОРасхожденияхПоОтгрузке.Ссылка = &Ссылка";
	
	ВариантыФормирования = ФорматыЭДО.ВариантыФормированияИтоговПриемки();
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("НеФормируются",
		ВариантыФормирования.НеФормируются);
	Запрос.УстановитьПараметр("ПокупателемФормируютсяДопСведенияОбОприходованииИмЦенностей",
		ВариантыФормирования.ПокупателемФормируютсяДопСведенияОбОприходованииИмЦенностей);
	Запрос.УстановитьПараметр("ПокупателемФормируютсяДопСведенияОУтвержденииДокумента",
		ВариантыФормирования.ПокупателемФормируютсяДопСведенияОУтвержденииДокумента);
	Запрос.УстановитьПараметр("ПокупателемФормируютсяДопСведенияИные",
		ВариантыФормирования.ПокупателемФормируютсяДопСведенияИные);
	Запрос.УстановитьПараметр("ПродавцомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки",
		ВариантыФормирования.ПродавцомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки);
	Запрос.УстановитьПараметр("ПродавцомФормируютсяДопСведенияИные",
		ВариантыФормирования.ПродавцомФормируютсяДопСведенияИные);
	Запрос.УстановитьПараметр("ПеревозчикомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки",
		ВариантыФормирования.ПеревозчикомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки);
	Запрос.УстановитьПараметр("ПеревозчикомФормируютсяДопСведенияИные",
		ВариантыФормирования.ПеревозчикомФормируютсяДопСведенияИные);	
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	ВыборкаШапки = Запрос.Выполнить().Выбрать();
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ВыборкаШапка", ВыборкаШапки);
		
	Возврат СтруктураДанных;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// СтандартныеПодсистемы.ОбновлениеВерсииИБ

// Регистрирует данные для обработчика обновления
// 
// Параметры:
//  Параметры - Структура - параметры.
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	
	Данные = Новый Массив;
	
	Данные_ЗаполнитьВидДокумента = ДанныеКОбработке_ЗаполнитьВидДокумента();
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Данные, Данные_ЗаполнитьВидДокумента, Истина);
	
	Данные_ЗаполнитьСведенияОГрузе = ДанныеКОбработке_ЗаполнитьСведенияОГрузе();
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Данные, Данные_ЗаполнитьСведенияОГрузе, Истина);
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные, ДополнительныеПараметры);
	
КонецПроцедуры

// Обработчик обновления.
// 
// Параметры:
//  Параметры - Структура - параметры.
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	МетаданныеОбъекта = Метаданные.Документы.АктОРасхожденияхПоОтгрузке;
	ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
	ПараметрыОтметкиВыполнения = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ОбработанныхОбъектов = 0;
	ПроблемныхОбъектов = 0;
	
	Если ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, "Документ.ЭлектронныйДокументВходящийЭДО")
		Или ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, "РегистрСведений.СостоянияПоОбъектамУчетаЭДО")
		Или ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, "Справочник.СообщениеЭДОПрисоединенныеФайлы")
		Или ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, "РегистрСведений.ХранилищеФайлов")
		Или ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, "РегистрСведений.НоменклатураКонтрагентовБЭД") Тогда
		Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(
			Параметры.Очередь, ПолноеИмяОбъекта);
		Возврат;
	КонецЕсли;
	
	ПараметрыВыборки = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта, ПараметрыВыборки);
	Если Параметры.ПрогрессВыполнения.ВсегоОбъектов = 0 Тогда
		Параметры.ПрогрессВыполнения.ВсегоОбъектов = Выборка.Количество();
	КонецЕсли;
	
	НаборСсылок = Новый Массив;
	Пока Выборка.Следующий() Цикл
		НаборСсылок.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Для каждого СсылкаНаОбъект Из НаборСсылок Цикл
		
		НачатьТранзакцию();
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", СсылкаНаОбъект);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
			Записать = Ложь;
			
			Объект = СсылкаНаОбъект.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				ОбработатьДанные_ЗаполнитьВидДокумента(Объект, Записать);
				ОбработатьДанные_ЗаполнитьСведенияОГрузе(СсылкаНаОбъект, Объект, Записать);
			КонецЕсли;
			
			Если Записать Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(СсылкаНаОбъект, ПараметрыОтметкиВыполнения);
			КонецЕсли;
			
			ОбработанныхОбъектов = ОбработанныхОбъектов + 1;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			ШаблонСообщения = НСтр("ru = 'Не удалось обработать акты о расхождениях по отгрузке: %1 по причине:'");
			ТекстСообщения = СтрШаблон(ШаблонСообщения, СсылкаНаОбъект) + Символы.ПС + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка,
				МетаданныеОбъекта, СсылкаНаОбъект, ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Если ОбработанныхОбъектов = 0 И ПроблемныхОбъектов <> 0 Тогда
		ШаблонСообщения = НСтр("ru = 'Не удалось обработать некоторые акты о расхождениях по отгрузке (пропущены): %1'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ПроблемныхОбъектов);
		ВызватьИсключение ТекстСообщения;
	Иначе
		ШаблонСообщения = НСтр("ru = 'Обработана очередная порция актов о расхождениях по отгрузке: %1'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ОбработанныхОбъектов);
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			МетаданныеОбъекта,, ТекстСообщения);
	КонецЕсли;
	
	Параметры.ПрогрессВыполнения.ОбработаноОбъектов =
		Параметры.ПрогрессВыполнения.ОбработаноОбъектов + ОбработанныхОбъектов;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(
		Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ОбновлениеВерсииИБ

#КонецОбласти

#КонецОбласти

#КонецЕсли

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("ПредставлениеНомера");
	Поля.Добавить("Дата");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Данные.Вставить("ВидОперации", Перечисления.ВидыОпераций.Реализация);
	Данные.Вставить("ВидДокумента", Метаданные.Документы.АктОРасхожденияхПоОтгрузке.Синоним);
	Представление = КлиентЭДОКлиентСервер.ПредставлениеВходящегоДокумента(Данные);
	
КонецПроцедуры

#КонецОбласти

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

Функция ДанныеКОбработке_ЗаполнитьВидДокумента() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АктОРасхожденияхПоОтгрузке.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.АктОРасхожденияхПоОтгрузке КАК АктОРасхожденияхПоОтгрузке
	|ГДЕ
	|	АктОРасхожденияхПоОтгрузке.ВидДокумента <> &ВидАктОРасхождениях";
	Запрос.Параметры.Вставить("ВидАктОРасхождениях", ВидАктОРасхождениях());
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеКОбработке_ЗаполнитьСведенияОГрузе() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АктОРасхождениях.Ссылка КАК Ссылка,
	|	ВЫБОР АктОРасхождениях.Номенклатура
	|		КОГДА &НоменклатураПустаяСсылка
	|			ТОГДА АктОРасхождениях.НоменклатураКонтрагента.Наименование
	|		ИНАЧЕ АктОРасхождениях.Номенклатура
	|	КОНЕЦ КАК Номенклатура,
	|	АктОРасхождениях.УдалитьВидУпаковки КАК УдалитьВидУпаковки,
	|	СУММА(АктОРасхождениях.УдалитьКоличествоУпаковок) КАК УдалитьКоличествоУпаковок,
	|	СУММА(АктОРасхождениях.УдалитьМассаБруттоПоДокументу) КАК УдалитьМассаБруттоПоДокументу,
	|	СУММА(АктОРасхождениях.УдалитьМассаБрутто) КАК УдалитьМассаБрутто,
	|	СУММА(АктОРасхождениях.УдалитьМассаНеттоПоДокументу) КАК УдалитьМассаНеттоПоДокументу,
	|	СУММА(АктОРасхождениях.УдалитьМассаНетто) КАК УдалитьМассаНетто
	|ПОМЕСТИТЬ СведенияОГрузеВТоварах
	|ИЗ
	|	Документ.АктОРасхожденияхПоОтгрузке.Товары КАК АктОРасхождениях
	|ГДЕ
	|	(АктОРасхождениях.УдалитьВидУпаковки <> """"
	|			ИЛИ АктОРасхождениях.УдалитьКоличествоУпаковок > 0
	|			ИЛИ АктОРасхождениях.УдалитьМассаБруттоПоДокументу > 0
	|			ИЛИ АктОРасхождениях.УдалитьМассаБрутто > 0
	|			ИЛИ АктОРасхождениях.УдалитьМассаНеттоПоДокументу > 0
	|			ИЛИ АктОРасхождениях.УдалитьМассаНетто > 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	АктОРасхождениях.Ссылка,
	|	ВЫБОР АктОРасхождениях.Номенклатура
	|		КОГДА &НоменклатураПустаяСсылка
	|			ТОГДА АктОРасхождениях.НоменклатураКонтрагента.Наименование
	|		ИНАЧЕ АктОРасхождениях.Номенклатура
	|	КОНЕЦ,
	|	АктОРасхождениях.УдалитьВидУпаковки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СведенияОГрузеВТоварах.Ссылка КАК Ссылка
	|ИЗ
	|	СведенияОГрузеВТоварах КАК СведенияОГрузеВТоварах
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктОРасхожденияхПоОтгрузке.СведенияОГрузе КАК АктОРасхожденияхПоОтгрузкеСведенияОГрузе
	|		ПО СведенияОГрузеВТоварах.Ссылка = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.Ссылка
	|			И СведенияОГрузеВТоварах.Номенклатура = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.Номенклатура
	|			И СведенияОГрузеВТоварах.УдалитьВидУпаковки = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.ВидУпаковки
	|			И СведенияОГрузеВТоварах.УдалитьКоличествоУпаковок = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.КоличествоУпаковок
	|			И СведенияОГрузеВТоварах.УдалитьМассаБруттоПоДокументу = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.МассаБруттоПоДокументу
	|			И СведенияОГрузеВТоварах.УдалитьМассаБрутто = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.МассаБрутто
	|			И СведенияОГрузеВТоварах.УдалитьМассаНеттоПоДокументу = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.МассаНетто
	|			И СведенияОГрузеВТоварах.УдалитьМассаНетто = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.МассаНетто
	|ГДЕ
	|	АктОРасхожденияхПоОтгрузкеСведенияОГрузе.Номенклатура ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("НоменклатураПустаяСсылка", Справочники.Номенклатура.ПустаяСсылка());
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьДанные_ЗаполнитьВидДокумента(Объект, Записать) 
	
	ТребуемыйВидДокумента = ВидАктОРасхождениях();
	Если Объект.ВидДокумента <> ТребуемыйВидДокумента Тогда
		Объект.ВидДокумента = ТребуемыйВидДокумента;
		Записать = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДанные_ЗаполнитьСведенияОГрузе(СсылкаНаОбъект, Объект, Записать) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АктОРасхождениях.Ссылка КАК Ссылка,
	|	ВЫБОР АктОРасхождениях.Номенклатура
	|		КОГДА &НоменклатураПустаяСсылка
	|			ТОГДА АктОРасхождениях.НоменклатураКонтрагента.Наименование
	|		ИНАЧЕ АктОРасхождениях.Номенклатура
	|	КОНЕЦ КАК Номенклатура,
	|	АктОРасхождениях.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	АктОРасхождениях.УдалитьВидУпаковки КАК УдалитьВидУпаковки,
	|	СУММА(АктОРасхождениях.УдалитьКоличествоУпаковок) КАК УдалитьКоличествоУпаковок,
	|	СУММА(АктОРасхождениях.УдалитьМассаБруттоПоДокументу) КАК УдалитьМассаБруттоПоДокументу,
	|	СУММА(АктОРасхождениях.УдалитьМассаБрутто) КАК УдалитьМассаБрутто,
	|	СУММА(АктОРасхождениях.УдалитьМассаНеттоПоДокументу) КАК УдалитьМассаНеттоПоДокументу,
	|	СУММА(АктОРасхождениях.УдалитьМассаНетто) КАК УдалитьМассаНетто
	|ПОМЕСТИТЬ СведенияОГрузеВТоварах
	|ИЗ
	|	Документ.АктОРасхожденияхПоОтгрузке.Товары КАК АктОРасхождениях
	|ГДЕ
	|	АктОРасхождениях.Ссылка = &Ссылка
	|	И (АктОРасхождениях.УдалитьВидУпаковки <> """"
	|			ИЛИ АктОРасхождениях.УдалитьКоличествоУпаковок > 0
	|			ИЛИ АктОРасхождениях.УдалитьМассаБруттоПоДокументу > 0
	|			ИЛИ АктОРасхождениях.УдалитьМассаБрутто > 0
	|			ИЛИ АктОРасхождениях.УдалитьМассаНеттоПоДокументу > 0
	|			ИЛИ АктОРасхождениях.УдалитьМассаНетто > 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	АктОРасхождениях.Ссылка,
	|	ВЫБОР АктОРасхождениях.Номенклатура
	|		КОГДА &НоменклатураПустаяСсылка
	|			ТОГДА АктОРасхождениях.НоменклатураКонтрагента.Наименование
	|		ИНАЧЕ АктОРасхождениях.Номенклатура
	|	КОНЕЦ,
	|	АктОРасхождениях.УдалитьВидУпаковки,
	|	АктОРасхождениях.ЕдиницаИзмерения
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	УдалитьВидУпаковки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СведенияОГрузеВТоварах.Номенклатура КАК Номенклатура,
	|	СведенияОГрузеВТоварах.УдалитьВидУпаковки КАК ВидУпаковки,
	|	СведенияОГрузеВТоварах.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СведенияОГрузеВТоварах.УдалитьКоличествоУпаковок КАК КоличествоУпаковок,
	|	СведенияОГрузеВТоварах.УдалитьМассаБруттоПоДокументу КАК МассаБруттоПоДокументу,
	|	СведенияОГрузеВТоварах.УдалитьМассаБрутто КАК МассаБрутто,
	|	СведенияОГрузеВТоварах.УдалитьМассаНеттоПоДокументу КАК МассаНеттоПоДокументу,
	|	СведенияОГрузеВТоварах.УдалитьМассаНетто КАК МассаНетто
	|ИЗ
	|	СведенияОГрузеВТоварах КАК СведенияОГрузеВТоварах
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктОРасхожденияхПоОтгрузке.СведенияОГрузе КАК АктОРасхожденияхПоОтгрузкеСведенияОГрузе
	|		ПО СведенияОГрузеВТоварах.Ссылка = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.Ссылка
	|			И СведенияОГрузеВТоварах.Номенклатура = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.Номенклатура
	|			И СведенияОГрузеВТоварах.УдалитьВидУпаковки = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.ВидУпаковки
	|			И СведенияОГрузеВТоварах.ЕдиницаИзмерения = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.ЕдиницаИзмерения
	|			И СведенияОГрузеВТоварах.УдалитьКоличествоУпаковок = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.КоличествоУпаковок
	|			И СведенияОГрузеВТоварах.УдалитьМассаБруттоПоДокументу = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.МассаБруттоПоДокументу
	|			И СведенияОГрузеВТоварах.УдалитьМассаБрутто = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.МассаБрутто
	|			И СведенияОГрузеВТоварах.УдалитьМассаНеттоПоДокументу = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.МассаНетто
	|			И СведенияОГрузеВТоварах.УдалитьМассаНетто = АктОРасхожденияхПоОтгрузкеСведенияОГрузе.МассаНетто
	|ГДЕ
	|	АктОРасхожденияхПоОтгрузкеСведенияОГрузе.Номенклатура ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("НоменклатураПустаяСсылка", Справочники.Номенклатура.ПустаяСсылка());
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Записать = Истина;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока = Объект.СведенияОГрузе.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);
		
		ПредыдущаяОтметкаОбОпломбировании = "";
		ПредыдущиеОтметкиОтправителя = "";
		
		СтрокиОтметок = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура", НоваяСтрока.Номенклатура));
		Для Каждого Строка Из СтрокиОтметок Цикл
			ТекущаяОтметкаОбОпломбировании = СокрЛП(Строка.УдалитьОтметкаОбОпломбировании);
			Если Не ПустаяСтрока(ТекущаяОтметкаОбОпломбировании)
				И ТекущаяОтметкаОбОпломбировании <> ПредыдущаяОтметкаОбОпломбировании Тогда
				
				Если ПустаяСтрока(ПредыдущаяОтметкаОбОпломбировании) Тогда
					НоваяСтрока.ОтметкаОбОпломбировании = ТекущаяОтметкаОбОпломбировании;
					ПредыдущаяОтметкаОбОпломбировании = ТекущаяОтметкаОбОпломбировании;
				
				Иначе
					НоваяСтрока.ОтметкаОбОпломбировании = СтрШаблон("%1; %2", НоваяСтрока.ОтметкаОбОпломбировании, ТекущаяОтметкаОбОпломбировании);
					
				КонецЕсли;
			КонецЕсли;
			
			ТекущиеОтметкиОтправителя = СокрЛП(Строка.УдалитьОтметкиОтправителя);
			Если Не ПустаяСтрока(ТекущиеОтметкиОтправителя)
				И ТекущиеОтметкиОтправителя <> ПредыдущиеОтметкиОтправителя Тогда
				
				Если ПустаяСтрока(ПредыдущиеОтметкиОтправителя) Тогда
					НоваяСтрока.ОтметкиОтправителя = ТекущиеОтметкиОтправителя;
					ПредыдущиеОтметкиОтправителя = ТекущиеОтметкиОтправителя;
					
				Иначе
					НоваяСтрока.ОтметкиОтправителя = СтрШаблон("%1; %2", НоваяСтрока.ОтметкиОтправителя, ТекущиеОтметкиОтправителя);
					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция ВидАктОРасхождениях()
	
	Возврат Перечисления.ВидыДокументов.АктОРасхождениях;
	
КонецФункции

#КонецОбласти

#КонецЕсли
