#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// СтандартныеПодсистемы.ОбновлениеВерсииИБ

// Регистрирует данные к обновлению в плане обмена ОбновлениеИнформационнойБазы
//  см. Стандарты и методики разработки прикладных решений: Параллельный режим отложенного обновления.
//
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолныеИменаОбъектов = Новый Массив;

	МетаданныеОбъекта = Метаданные.Документы.АктСверкиВзаиморасчетов;
	ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
	ПолныеИменаОбъектов.Добавить(ПолноеИмяОбъекта);
	
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиСсылки();
	ПараметрыВыборки.ПолныеИменаОбъектов = СтрСоединить(ПолныеИменаОбъектов, ",");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	АктСверкиВзаиморасчетов.Ссылка
	|ИЗ
	|	Документ.АктСверкиВзаиморасчетов КАК АктСверкиВзаиморасчетов
	|ГДЕ
	|	АктСверкиВзаиморасчетов.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.ПустаяСсылка)
	|	И АктСверкиВзаиморасчетов.Ссылка > &АктСверкиВзаиморасчетов
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";
	
	АктСверкиВзаиморасчетов = ПустаяСсылка();
	ОтработаныВсеДанныеАктСверкиВзаиморасчетов = Ложь;
	Пока Не ОтработаныВсеДанныеАктСверкиВзаиморасчетов Цикл
		
		Запрос.УстановитьПараметр("АктСверкиВзаиморасчетов", АктСверкиВзаиморасчетов);
		//@skip-check query-in-loop
		ДанныеАктСверкиВзаиморасчетов = Запрос.Выполнить().Выгрузить();
		
		КоличествоСтрокАктСверкиВзаиморасчетов = ДанныеАктСверкиВзаиморасчетов.Количество();
		
		Если КоличествоСтрокАктСверкиВзаиморасчетов < 1000 Тогда
			ОтработаныВсеДанныеАктСверкиВзаиморасчетов = Истина;
		КонецЕсли;
		
		Если КоличествоСтрокАктСверкиВзаиморасчетов > 0 Тогда
			АктСверкиВзаиморасчетов = ДанныеАктСверкиВзаиморасчетов[КоличествоСтрокАктСверкиВзаиморасчетов - 1].Ссылка;
		КонецЕсли;
		
		ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры,
			ДанныеАктСверкиВзаиморасчетов.ВыгрузитьКолонку("Ссылка"));
		
	КонецЦикла;
	
КонецПроцедуры

// Обрабатывает данные, зарегистрированные в плане обмена ОбновлениеИнформационнойБазы
//  см. Стандарты и методики разработки прикладных решений: Параллельный режим отложенного обновления.
//
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	МетаданныеОбъекта = Метаданные.Документы.АктСверкиВзаиморасчетов;
	ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
	
	ИменаМетаданных = Новый Массив;
	ИменаМетаданных.Добавить(ПолноеИмяОбъекта);
	
	Если ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(Параметры.Очередь, 
		"Документ.АктСверкиВзаиморасчетов") Тогда
		Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(
			Параметры.Очередь, ИменаМетаданных);
		Возврат;
	КонецЕсли;
	
	ПараметрыОтметкиВыполнения = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	
	ВыбранныеДанные = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);
	
	Если Не ЗначениеЗаполнено(ВыбранныеДанные) Тогда
		Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(
			Параметры.Очередь, ИменаМетаданных);
		Возврат;
	КонецЕсли;
	
	ОбъектовОбработано = 0;
	ПроблемныхОбъектов = 0;
	
	НаборСсылок = ВыбранныеДанные.ВыгрузитьКолонку("Ссылка");
	
	Для Каждого СсылкаНаОбъект Из НаборСсылок Цикл
		
		НачатьТранзакцию();
		Попытка
			
			ОбщегоНазначенияБЭД.УстановитьУправляемуюБлокировкуПоСсылке(СсылкаНаОбъект);
			Записать = Ложь;
			
			Объект = СсылкаНаОбъект.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				ОбработатьДанные_ЗаполнитьНовыеРеквизиты(Объект, Записать);
				ОбработатьДанные_ЗаполнитьТаблицыСверкиПоНовойСтруктуре(Объект, Записать);
			КонецЕсли;
			
			Если Записать Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(СсылкаНаОбъект, ПараметрыОтметкиВыполнения);
			КонецЕсли;
			
			ОбъектовОбработано = ОбъектовОбработано + 1;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			ШаблонСообщения = НСтр("ru = 'Не удалось обработать документ Акт сверки взаиморасчетов: %1 по причине:'");
			ТекстСообщения = СтрШаблон(ШаблонСообщения, СсылкаНаОбъект) + Символы.ПС
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Ошибка,, СсылкаНаОбъект, ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Если ОбъектовОбработано = 0 И ПроблемныхОбъектов <> 0 Тогда
		ШаблонСообщения = 
			НСтр("ru = 'Не удалось обработать некоторые документы Акт сверки взаиморасчетов (пропущены): %1'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ПроблемныхОбъектов);
		ВызватьИсключение ТекстСообщения;
	Иначе
		ШаблонСообщения = НСтр("ru = 'Обработана очередная порция документов Акт сверки взаиморасчетов: %1'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ОбъектовОбработано);
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
	КонецЕсли;
	
	Параметры.ПрогрессВыполнения.ОбработаноОбъектов = Параметры.ПрогрессВыполнения.ОбработаноОбъектов
		+ ОбъектовОбработано;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(
		Параметры.Очередь, ИменаМетаданных);
	
КонецПроцедуры
	
// Конец СтандартныеПодсистемы.ОбновлениеВерсииИБ

// Получение данных для формирования электронного документа.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка.АктСверкиВзаиморасчетов - ссылка на документ.
// 
// Возвращаемое значение:
//  Структура:
//  * ВыборкаШапкаОтправителя - ВыборкаИзРезультатаЗапроса:
//  ** НомерЭД - Строка
//  ** ДатаЭД - Дата
//  ** Организация - СправочникСсылка.Организации
//  ** Контрагент - СправочникСсылка.Контрагенты
//  ** ДатаНачала - Дата
//  ** ДатаОкончания - Дата
//  ** СальдоНаНачалоПериодаДебет - Число
//  ** СальдоНаНачалоПериодаКредит - Число
//  ** ВалютаКод - Строка
//  ** ОборотПоДебету - Число
//  ** ОборотПоКредиту - Число
//  ** СальдоНаКонецПериодаДебет - Число
//  ** СальдоНаКонецПериодаКредит - Число
//	* ВыборкаШапкаПолучателя - ВыборкаИзРезультатаЗапроса:
//  ** НомерЭД - Строка
//  ** ДатаЭД - Дата
//  ** Организация - СправочникСсылка.Организации
//  ** Контрагент - СправочникСсылка.Контрагенты
//  ** ДатаНачала - Дата
//  ** ДатаОкончания - Дата
//  ** СальдоНаНачалоПериодаДебет - Число
//  ** СальдоНаНачалоПериодаКредит - Число
//  ** ВалютаКод - Строка
//  ** ОборотПоДебету - Число
//  ** ОборотПоКредиту - Число
//  ** СальдоНаКонецПериодаДебет - Число
//  ** СальдоНаКонецПериодаКредит - Число
//	* ДанныеОтправителя - ТаблицаЗначений:
//	** НомерСтроки - Число
//	** НомерДоговора - Строка
//	** ДатаДоговора - Дата
//	** НаименованиеДоговора - Строка
//	** НомерДокумента - Строка
//	** ДатаДокумента - Дата
//	** НаименованиеДокумента - Строка
//	** ПорядковыйНомерОперации - Число
//	** ДатаОперации - Дата
//	** НаименованиеОперации - Строка
//	** Дебет - Число
//	** Кредит - Число
//	* ДанныеПолучателя - ТаблицаЗначений:
//	** НомерСтроки - Число
//	** НомерДоговора - Строка
//	** ДатаДоговора - Дата
//	** НаименованиеДоговора - Строка
//	** НомерДокумента - Строка
//	** ДатаДокумента - Дата
//	** НаименованиеДокумента - Строка
//	** ПорядковыйНомерОперации - Число
//	** ДатаОперации - Дата
//	** НаименованиеОперации - Строка
//	** Дебет - Число
//	** Кредит - Число
//
Функция ПолучитьДанныеДляЭД(СсылкаНаОбъект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АктСверкиВзаиморасчетов.НомерЭД КАК НомерЭД,
		|	АктСверкиВзаиморасчетов.ДатаЭД КАК ДатаЭД,
		|	АктСверкиВзаиморасчетов.Организация КАК Организация,
		|	АктСверкиВзаиморасчетов.Контрагент КАК Контрагент,
		|	АктСверкиВзаиморасчетов.ДатаНачала КАК ДатаНачала,
		|	АктСверкиВзаиморасчетов.ДатаОкончания КАК ДатаОкончания,
		|	ВЫБОР
		|		КОГДА АктСверкиВзаиморасчетов.ОстатокНаНачало >= 0
		|			ТОГДА АктСверкиВзаиморасчетов.ОстатокНаНачало
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СальдоНаНачалоПериодаДебет,
		|	ВЫБОР
		|		КОГДА АктСверкиВзаиморасчетов.ОстатокНаНачало < 0
		|			ТОГДА -АктСверкиВзаиморасчетов.ОстатокНаНачало
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СальдоНаНачалоПериодаКредит,
		|	АктСверкиВзаиморасчетов.Валюта.Код КАК ВалютаКод,
		|	ОборотыОтправителя.Дебет КАК ОборотПоДебету,
		|	ОборотыОтправителя.Кредит КАК ОборотПоКредиту,
		|	ВЫБОР
		|		КОГДА АктСверкиВзаиморасчетов.ОстатокНаНачало + ОборотыОтправителя.Дебет > ОборотыОтправителя.Кредит
		|			ТОГДА АктСверкиВзаиморасчетов.ОстатокНаНачало + ОборотыОтправителя.Дебет - ОборотыОтправителя.Кредит
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СальдоНаКонецПериодаДебет,
		|	ВЫБОР
		|		КОГДА ОборотыОтправителя.Кредит > ОборотыОтправителя.Дебет + АктСверкиВзаиморасчетов.ОстатокНаНачало
		|			ТОГДА ОборотыОтправителя.Кредит - (ОборотыОтправителя.Дебет + АктСверкиВзаиморасчетов.ОстатокНаНачало)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СальдоНаКонецПериодаКредит
		|ИЗ
		|	Документ.АктСверкиВзаиморасчетов КАК АктСверкиВзаиморасчетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ДанныеОтправителя.Ссылка КАК Ссылка,
		|			СУММА(ДанныеОтправителя.Дебет) КАК Дебет,
		|			СУММА(ДанныеОтправителя.Кредит) КАК Кредит
		|		ИЗ
		|			Документ.АктСверкиВзаиморасчетов.ДанныеОтправителя КАК ДанныеОтправителя
		|		ГДЕ
		|			ДанныеОтправителя.Ссылка = &Ссылка
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ДанныеОтправителя.Ссылка) КАК ОборотыОтправителя
		|		ПО АктСверкиВзаиморасчетов.Ссылка = ОборотыОтправителя.Ссылка
		|ГДЕ
		|	АктСверкиВзаиморасчетов.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	АктСверкиВзаиморасчетов.НомерЭД КАК НомерЭД,
		|	АктСверкиВзаиморасчетов.ДатаЭД КАК ДатаЭД,
		|	АктСверкиВзаиморасчетов.Организация КАК Организация,
		|	АктСверкиВзаиморасчетов.Контрагент КАК Контрагент,
		|	АктСверкиВзаиморасчетов.ДатаНачала КАК ДатаНачала,
		|	АктСверкиВзаиморасчетов.ДатаОкончания КАК ДатаОкончания,
		|	НЕ (ОборотыПолучателя.Ссылка ЕСТЬ NULL) КАК ЕстьРасхождения,
		|	ВЫБОР
		|		КОГДА АктСверкиВзаиморасчетов.ОстатокНаНачалоПоДаннымПолучателя >= 0
		|			ТОГДА АктСверкиВзаиморасчетов.ОстатокНаНачалоПоДаннымПолучателя
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СальдоНаНачалоПериодаДебет,
		|	ВЫБОР
		|		КОГДА АктСверкиВзаиморасчетов.ОстатокНаНачалоПоДаннымПолучателя < 0
		|			ТОГДА -АктСверкиВзаиморасчетов.ОстатокНаНачалоПоДаннымПолучателя
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СальдоНаНачалоПериодаКредит,
		|	АктСверкиВзаиморасчетов.Валюта.Код КАК ВалютаКод,
		|	ОборотыПолучателя.Дебет КАК ОборотПоДебету,
		|	ОборотыПолучателя.Кредит КАК ОборотПоКредиту,
		|	ВЫБОР
		|		КОГДА АктСверкиВзаиморасчетов.ОстатокНаНачалоПоДаннымПолучателя + ОборотыПолучателя.Дебет > ОборотыПолучателя.Кредит
		|			ТОГДА АктСверкиВзаиморасчетов.ОстатокНаНачалоПоДаннымПолучателя + ОборотыПолучателя.Дебет -
		|				ОборотыПолучателя.Кредит
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СальдоНаКонецПериодаДебет,
		|	ВЫБОР
		|		КОГДА ОборотыПолучателя.Кредит > ОборотыПолучателя.Дебет + АктСверкиВзаиморасчетов.ОстатокНаНачалоПоДаннымПолучателя
		|			ТОГДА ОборотыПолучателя.Кредит - (ОборотыПолучателя.Дебет +
		|				АктСверкиВзаиморасчетов.ОстатокНаНачалоПоДаннымПолучателя)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СальдоНаКонецПериодаКредит
		|ИЗ
		|	Документ.АктСверкиВзаиморасчетов КАК АктСверкиВзаиморасчетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ДанныеПолучателя.Ссылка КАК Ссылка,
		|			СУММА(ДанныеПолучателя.Дебет) КАК Дебет,
		|			СУММА(ДанныеПолучателя.Кредит) КАК Кредит
		|		ИЗ
		|			Документ.АктСверкиВзаиморасчетов.ДанныеПолучателя КАК ДанныеПолучателя
		|		ГДЕ
		|			ДанныеПолучателя.Ссылка = &Ссылка
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ДанныеПолучателя.Ссылка) КАК ОборотыПолучателя
		|		ПО АктСверкиВзаиморасчетов.Ссылка = ОборотыПолучателя.Ссылка
		|ГДЕ
		|	АктСверкиВзаиморасчетов.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеОтправителя.НомерСтроки КАК НомерСтроки,
		|	ДанныеОтправителя.НомерДоговора КАК НомерДоговора,
		|	ДанныеОтправителя.ДатаДоговора КАК ДатаДоговора,
		|	ДанныеОтправителя.НаименованиеДоговора КАК НаименованиеДоговора,
		|	ДанныеОтправителя.НомерДокумента КАК НомерДокумента,
		|	ДанныеОтправителя.ДатаДокумента КАК ДатаДокумента,
		|	ДанныеОтправителя.НаименованиеДокумента КАК НаименованиеДокумента,
		|	ДанныеОтправителя.ПорядковыйНомерОперации КАК ПорядковыйНомерОперации,
		|	ДанныеОтправителя.ДатаОперации КАК ДатаОперации,
		|	ДанныеОтправителя.НаименованиеОперации КАК НаименованиеОперации,
		|	ДанныеОтправителя.Дебет КАК Дебет,
		|	ДанныеОтправителя.Кредит КАК Кредит
		|ИЗ
		|	Документ.АктСверкиВзаиморасчетов.ДанныеОтправителя КАК ДанныеОтправителя
		|ГДЕ
		|	ДанныеОтправителя.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеПолучателя.НомерСтроки КАК НомерСтроки,
		|	ДанныеПолучателя.НомерДоговора КАК НомерДоговора,
		|	ДанныеПолучателя.ДатаДоговора КАК ДатаДоговора,
		|	ДанныеПолучателя.НаименованиеДоговора КАК НаименованиеДоговора,
		|	ДанныеПолучателя.НомерДокумента КАК НомерДокумента,
		|	ДанныеПолучателя.ДатаДокумента КАК ДатаДокумента,
		|	ДанныеПолучателя.НаименованиеДокумента КАК НаименованиеДокумента,
		|	ДанныеПолучателя.ПорядковыйНомерОперации КАК ПорядковыйНомерОперации,
		|	ДанныеПолучателя.ДатаОперации КАК ДатаОперации,
		|	ДанныеПолучателя.НаименованиеОперации КАК НаименованиеОперации,
		|	ДанныеПолучателя.Дебет КАК Дебет,
		|	ДанныеПолучателя.Кредит КАК Кредит
		|ИЗ
		|	Документ.АктСверкиВзаиморасчетов.ДанныеПолучателя КАК ДанныеПолучателя
		|ГДЕ
		|	ДанныеПолучателя.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаШапкаОтправителя = МассивРезультатов[0].Выбрать();
	ВыборкаШапкаПолучателя = МассивРезультатов[1].Выбрать();
	ДанныеОтправителя = МассивРезультатов[2].Выгрузить();
	ДанныеПолучателя = МассивРезультатов[3].Выгрузить();
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ВыборкаШапкаОтправителя", ВыборкаШапкаОтправителя);
	СтруктураДанных.Вставить("ВыборкаШапкаПолучателя", ВыборкаШапкаПолучателя);
	СтруктураДанных.Вставить("ДанныеОтправителя", ДанныеОтправителя);
	СтруктураДанных.Вставить("ДанныеПолучателя", ДанныеПолучателя);
	
	Возврат СтруктураДанных;
	
КонецФункции

