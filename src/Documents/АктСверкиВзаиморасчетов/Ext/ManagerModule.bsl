Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("Дата");
	Поля.Добавить("НомерЭД");
	Поля.Добавить("ВидДокумента");
	Поля.Добавить("ЭтоДокументКонтрагента");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеДляФормированияПредставления = КлиентЭДОКлиентСервер.НовыеДанныеДляПолученияПредставленияДокумента();
	ЗаполнитьЗначенияСвойств(ДанныеДляФормированияПредставления, Данные);
	ДанныеДляФормированияПредставления.ВидОперации = Перечисления.ВидыОпераций.Реализация;
	ДанныеДляФормированияПредставления.ПредставлениеНомера = Данные.НомерЭД;
	
	Если Данные.ЭтоДокументКонтрагента Тогда
		Представление = КлиентЭДОКлиентСервер.ПредставлениеВходящегоДокумента(ДанныеДляФормированияПредставления);
	Иначе
		Представление = КлиентЭДОКлиентСервер.ПредставлениеИсходящегоДокумента(ДанныеДляФормированияПредставления);
	КонецЕсли;
	
КонецПроцедуры

