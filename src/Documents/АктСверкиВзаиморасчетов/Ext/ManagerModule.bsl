// Заполнить данные документа по новой структуре по обработчику обновления.
//
// Параметры:
//  ОбъектАктСверки - ДокументОбъект.АктСверкиВзаиморасчетов
//  Записать - Булево
Процедура ОбработатьДанные_ЗаполнитьНовыеРеквизиты(ОбъектАктСверки, Записать)
		
	Записать = Истина;
		
	ЭлектронныеДокументыАктаСверки = ИнтеграцияЭДО.АктуальныеЭлектронныеДокументы(ОбъектАктСверки.Ссылка);
	
	ОбъектАктСверки.ВидДокумента = Перечисления.ВидыДокументов.АктСверкиВзаиморасчетов;
	
	ОбъектАктСверки.ЕстьРасхождения = ЗначениеЗаполнено(ОбъектАктСверки.ДанныеОтправителя)
		И ЗначениеЗаполнено(ОбъектАктСверки.ДанныеПолучателя);
		
	Если Не ЭлектронныеДокументыАктаСверки.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ЭлектронныйДокумент = ЭлектронныеДокументыАктаСверки[0].ЭлектронныйДокумент;

	ОбъектАктСверки.ЭтоДокументКонтрагента = ЭлектронныеДокументыАктаСверки.Количество()
		И ТипЗнч(ЭлектронныйДокумент) = Тип("ДокументСсылка.ЭлектронныйДокументВходящийЭДО");
		
	ДанныеДокумента = ОбменСКонтрагентами.ДанныеЭлектронногоДокумента(ЭлектронныйДокумент);
	
	Если Не ЗначениеЗаполнено(ДанныеДокумента.ДанныеПолучателя) Тогда
		Возврат;
	КонецЕсли;
		
	СведенияПолучателя = ДеревоЭлектронногоДокументаБЭД.ДанныеЭлементаДереваЭлектронногоДокумента(
		ДанныеДокумента.ДанныеПолучателя.Содержание, "СведенияПолучателя");
		
	ОбъектАктСверки.ОстатокНаНачалоПоДаннымПолучателя = 
		СведенияПолучателя.СальдоНаНачалоПериодаДебет - СведенияПолучателя.СальдоНаНачалоПериодаКредит;
		
КонецПроцедуры

// Заполнить данные документа по новой структуре по обработчику обновления.
//
// Параметры:
//  ОбъектАктСверки - ДокументОбъект.АктСверкиВзаиморасчетов
//  Записать - Булево
Процедура ОбработатьДанные_ЗаполнитьТаблицыСверкиПоНовойСтруктуре(ОбъектАктСверки, Записать)

	Записать = Истина;
	
	ЗаполнитьТаблицуСверки(ОбъектАктСверки.ДанныеОтправителя);
	ЗаполнитьТаблицуСверки(ОбъектАктСверки.ДанныеПолучателя);

КонецПроцедуры

// Параметры:
//  ДанныеОтправителяПолучателя - ДокументТабличнаяЧасть.АктСверкиВзаиморасчетов.ДанныеОтправителя
//                              - ДокументТабличнаяЧасть.АктСверкиВзаиморасчетов.ДанныеПолучателя
Процедура ЗаполнитьТаблицуСверки(ДанныеОтправителяПолучателя)
	
	ТаблицаСверки = ДанныеОтправителяПолучателя.Выгрузить();
	
	ДанныеОтправителяПолучателя.Очистить();
	
	ДанныеПоДоговорам = ТаблицаСверки.Скопировать(Новый Структура("УдалитьКлючСвязи", 0));
		
	Для Каждого ДанныеДоговора Из ДанныеПоДоговорам Цикл
		
		ДанныеПоДокументам = ТаблицаСверки.Скопировать(
			Новый Структура("УдалитьКлючСвязи", ДанныеДоговора.НомерСтроки));
		
		Для Каждого ДанныеДокумента Из ДанныеПоДокументам Цикл
			
			ДанныеПоОперациям = ТаблицаСверки.Скопировать(
				Новый Структура("УдалитьКлючСвязи", ДанныеДокумента.НомерСтроки));
		
			Для Каждого ДанныеОперации Из ДанныеПоОперациям Цикл
				
				НоваяСтрока = ДанныеОтправителяПолучателя.Добавить();
				
				НоваяСтрока.НомерДоговора = ДанныеДоговора.НомерДоговора;
				НоваяСтрока.ДатаДоговора = ДанныеДоговора.ДатаДоговора;
				НоваяСтрока.НаименованиеДоговора = ДанныеДоговора.НаименованиеДоговора;
				
				НоваяСтрока.НомерДокумента = ДанныеДокумента.НомерДокумента;
				НоваяСтрока.ДатаДокумента = ДанныеДокумента.ДатаДокумента;
				НоваяСтрока.НаименованиеДокумента = ДанныеДокумента.НаименованиеДокумента;
			
				НоваяСтрока.ПорядковыйНомерОперации = ДанныеОперации.ПорядковыйНомерОперации;
				НоваяСтрока.ДатаОперации = ДанныеОперации.ДатаОперации;
				НоваяСтрока.НаименованиеОперации = ДанныеОперации.НаименованиеОперации;
				
				НоваяСтрока.Дебет = ДанныеОперации.Дебет;
				НоваяСтрока.Кредит = ДанныеОперации.Кредит;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти // СлужебныеПроцедурыИФункции

#КонецЕсли