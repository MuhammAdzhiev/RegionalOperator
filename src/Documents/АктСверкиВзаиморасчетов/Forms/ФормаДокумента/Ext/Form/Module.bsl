#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	СформироватьЗаголовокФормы();
	
	УстановитьЗаголовкиДанныхОтправителяИПолучателя();
	
	УстановитьСтатусДокумента();
	
	НастроитьСтраницыДанныхОтправителяИПолучателя(ЭтотОбъект, Объект.ЕстьРасхождения,
		Объект.ЭтоДокументКонтрагента);
		
	УстановитьДоступностьПризнакаНаличияРазногласий();
	
	НастроитьДоступностьШапки();
	
	ПериодСверки.ДатаНачала    = Объект.ДатаНачала;
	ПериодСверки.ДатаОкончания = Объект.ДатаОкончания;
	
	ПересчитатьОстатки(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтатусДокумента()
	
	СтатусДокумента = КлиентЭДО.СтатусДокумента(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодСверкиПослеВыбора(Период, ДополнительныеПараметры) Экспорт
	
	Если Период = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПериодСверки = Период;
	Объект.ДатаНачала    = Период.ДатаНачала;
	Объект.ДатаОкончания = Период.ДатаОкончания;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьНаименование(Префикс, Номер, Дата)
		
	ПредставлениеНомера = НСтр("ru = 'б/н'");	
	Если Не ПустаяСтрока(Номер) Тогда
		ПредставлениеНомера = Номер;
	КонецЕсли;	
	
	ПредставлениеДаты = "";	
	Если Дата <> '00010101' Тогда
		ПредставлениеДаты = " " + НСтр("ru = 'от'") + " " + Формат(Дата, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Возврат 
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"%1 №%2%3", Префикс, ПредставлениеНомера, ПредставлениеДаты);
	
КонецФункции

&НаСервере
Процедура СформироватьЗаголовокФормы()
	
	ДанныеДляФормированияПредставления = КлиентЭДОКлиентСервер.НовыеДанныеДляПолученияПредставленияДокумента();
	ЗаполнитьЗначенияСвойств(ДанныеДляФормированияПредставления, Объект);
	ДанныеДляФормированияПредставления.ВидДокумента = Перечисления.ВидыДокументов.АктСверкиВзаиморасчетов;
	ДанныеДляФормированияПредставления.ВидОперации = Перечисления.ВидыОпераций.Реализация;
	ДанныеДляФормированияПредставления.ПредставлениеНомера = Объект.НомерЭД;
	
	Если Объект.ЭтоДокументКонтрагента Тогда
		Заголовок = КлиентЭДОКлиентСервер.ПредставлениеВходящегоДокумента(ДанныеДляФормированияПредставления,
			Объект.Ссылка.Пустая())
	Иначе
		Заголовок = КлиентЭДОКлиентСервер.ПредставлениеИсходящегоДокумента(ДанныеДляФормированияПредставления,
			Объект.Ссылка.Пустая());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовкиДанныхОтправителяИПолучателя()
	
	ЗаголовокДанныеОрганизации = НСтр("ru='По данным организации'", "ru");
	ЗаголовокДанныеКонтрагента = НСтр("ru='По данным контрагента'", "ru");
	ЗаголовокРасхождениеСОрганизацией = НСтр("ru='Расхождение с организацией'", "ru");
	ЗаголовокРасхождениеСКонтрагентом = НСтр("ru='Расхождение с контрагентом'", "ru");
	
	Если Объект.ЭтоДокументКонтрагента Тогда
		Элементы.ГруппаДанныеОтправителя.Заголовок = ЗаголовокДанныеКонтрагента;
		Элементы.ГруппаДанныеПолучателя.Заголовок = ЗаголовокДанныеОрганизации;
		
		Элементы.Расхождение.Заголовок = ЗаголовокРасхождениеСОрганизацией;
		Элементы.РасхождениеПолучатель.Заголовок = ЗаголовокРасхождениеСКонтрагентом;
	Иначе
		Элементы.ГруппаДанныеОтправителя.Заголовок = ЗаголовокДанныеОрганизации;
		Элементы.ГруппаДанныеПолучателя.Заголовок = ЗаголовокДанныеКонтрагента;
		
		Элементы.Расхождение.Заголовок = ЗаголовокРасхождениеСКонтрагентом;
		Элементы.РасхождениеПолучатель.Заголовок = ЗаголовокРасхождениеСОрганизацией;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьПризнакаНаличияРазногласий()
	
	Элементы.ЕстьРасхождения.ТолькоПросмотр = Не Объект.ЭтоДокументКонтрагента;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьСтраницыДанныхОтправителяИПолучателя(Форма, ЕстьРасхождения, ЭтоДокументКонтрагента)
	
	Форма.Элементы.ГруппаДанныеОтправителя.ТолькоПросмотр = ЭтоДокументКонтрагента;
	Форма.Элементы.ГруппаДанныеПолучателя.ТолькоПросмотр = Не ЕстьРасхождения Или Не ЭтоДокументКонтрагента;
	Форма.Элементы.ДанныеПолучателяЗаполнитьДанныеПолучателяПоДаннымОтправителя.Видимость = ЭтоДокументКонтрагента;
	Форма.Элементы.ДанныеПолучателяЗаполнитьДанныеПолучателяПоДаннымОтправителя.Доступность = ЕстьРасхождения 
		И ЭтоДокументКонтрагента;
	Форма.Элементы.ГруппаДанныеПолучателя.Видимость = ЕстьРасхождения Или Не ЭтоДокументКонтрагента;
	Форма.Элементы.ОстатокНаНачало.Видимость = Не ЭтоДокументКонтрагента;
	Форма.Элементы.ОстатокНаНачалоПоДаннымПолучателя.Видимость = ЭтоДокументКонтрагента;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПолучателяПоДаннымОтправителяНаСервере()
	
	Объект.ДанныеПолучателя.Очистить();
	
	Для Каждого СтрокаДанныхОтправителя Из Объект.ДанныеОтправителя Цикл
		СтрокаДанныхПолучателя = Объект.ДанныеПолучателя.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДанныхПолучателя, СтрокаДанныхОтправителя,, "Дебет, Кредит");
		СтрокаДанныхПолучателя.Дебет = СтрокаДанныхОтправителя.Кредит;
		СтрокаДанныхПолучателя.Кредит = СтрокаДанныхОтправителя.Дебет;
	КонецЦикла;

	ПересчитатьОстатки(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьДопустимуюСуммуОборотовВДанныхОтправителяПолучателя(Элемент)
	
	ЭтоДанныеОтправителя = Элемент = Элементы.ДанныеОтправителя;
	
	РезультатПроверки = ПроверитьДопустимуюСуммуОборотов(ЭтоДанныеОтправителя);
	Если Не РезультатПроверки.ОграничениеПревышено Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если РезультатПроверки.ПревышениеПоДебету Тогда
		ТекущиеДанные.Дебет = 0;
	КонецЕсли;
	
	Если РезультатПроверки.ПревышениеПоКредиту Тогда
		ТекущиеДанные.Кредит = 0;
	КонецЕсли;
	
	ПоказатьПредупреждение(, РезультатПроверки.ТекстСообщения);
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ПроверитьДопустимуюСуммуОборотов(ЭтоДанныеОтправителя = Истина)
	
	Результат = Новый Структура;
	Результат.Вставить("ОграничениеПревышено", Ложь);
	Результат.Вставить("ПревышениеПоДебету", Ложь);
	Результат.Вставить("ПревышениеПоКредиту", Ложь);
	Результат.Вставить("ТекстСообщения", "");
	
	ТекстСообщения = Новый Массив;
	ДопустимоеЗначение = Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 2));
	
	Если ЭтоДанныеОтправителя Тогда
		ТекущийОборотДебет = Объект.ДанныеОтправителя.Итог("Дебет") + Объект.ОстатокНаНачало;
		ТекущийОборотКредит = Объект.ДанныеОтправителя.Итог("Кредит") - Объект.ОстатокНаНачало;
	Иначе
		ТекущийОборотДебет = Объект.ДанныеПолучателя.Итог("Дебет") + Объект.ОстатокНаНачалоПоДаннымПолучателя;
		ТекущийОборотКредит = Объект.ДанныеПолучателя.Итог("Кредит") - Объект.ОстатокНаНачалоПоДаннымПолучателя;
	КонецЕсли;
	
	Если ДопустимоеЗначение.ПривестиЗначение(ТекущийОборотДебет) <> ТекущийОборотДебет Тогда
		Результат.ОграничениеПревышено = Истина;
		Результат.ПревышениеПоДебету = Истина;
		ТекстСообщения.Добавить(
			НСтр("ru = 'Сумма оборотов по дебету в данном документе не должна превышать ""9 999 999 999 999,99""'"));
	КонецЕсли;
	
	Если ДопустимоеЗначение.ПривестиЗначение(ТекущийОборотКредит) <> ТекущийОборотКредит Тогда
		Результат.ОграничениеПревышено = Истина;
		Результат.ПревышениеПоКредиту = Истина;
		ТекстСообщения.Добавить(
			НСтр("ru = 'Сумма оборотов по кредиту в данном документе не должна превышать ""9 999 999 999 999,99""'"));
	КонецЕсли;
	
	Результат.ТекстСообщения = СтрСоединить(ТекстСообщения, Символы.ПС);
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьОстатки(Форма)

	Объект = Форма.Объект;

	Форма.ОстатокНаКонец = Объект.ОстатокНаНачало
		+ Объект.ДанныеОтправителя.Итог("Дебет")
		- Объект.ДанныеОтправителя.Итог("Кредит");
		
	ПояснениеДолгОтправителя = ?(Объект.ЭтоДокументКонтрагента, НСтр("ru='(долг организации)'"),
		НСтр("ru='(долг контрагента)'"));
	ПояснениеДолгПолучателя = ?(Объект.ЭтоДокументКонтрагента, НСтр("ru='(долг контрагента)'"),
		НСтр("ru='(долг организации)'"));
		
	Если Объект.ОстатокНаНачало > 0 Тогда
		Форма.ОстатокНаНачалоПояснение = ПояснениеДолгОтправителя;
	ИначеЕсли Объект.ОстатокНаНачало < 0 Тогда 
		Форма.ОстатокНаНачалоПояснение = ПояснениеДолгПолучателя;
	КонецЕсли;
		
	Если Форма.ОстатокНаКонец > 0 Тогда
		Форма.ОстатокНаКонецПояснение = ПояснениеДолгОтправителя;
	ИначеЕсли Форма.ОстатокНаКонец < 0 Тогда 
		Форма.ОстатокНаКонецПояснение = ПояснениеДолгПолучателя;
	КонецЕсли;
	
	Форма.ОстатокНаКонецПолучатель = Объект.ОстатокНаНачалоПоДаннымПолучателя
		+ Объект.ДанныеПолучателя.Итог("Дебет")
		- Объект.ДанныеПолучателя.Итог("Кредит");
		
	Если Объект.ОстатокНаНачалоПоДаннымПолучателя < 0 Тогда
		Форма.ОстатокНаНачалоПолучательПояснение = ПояснениеДолгОтправителя;
	ИначеЕсли Объект.ОстатокНаНачалоПоДаннымПолучателя > 0 Тогда 
		Форма.ОстатокНаНачалоПолучательПояснение = ПояснениеДолгПолучателя;
	КонецЕсли;
		
	Если Форма.ОстатокНаКонецПолучатель < 0 Тогда
		Форма.ОстатокНаКонецПолучательПояснение = ПояснениеДолгОтправителя;
	ИначеЕсли Форма.ОстатокНаКонецПолучатель > 0 Тогда 
		Форма.ОстатокНаКонецПолучательПояснение = ПояснениеДолгПолучателя;
	КонецЕсли;
	
	Расхождение = Форма.ОстатокНаКонец + Форма.ОстатокНаКонецПолучатель;
	Форма.Расхождение = ?(Объект.ЭтоДокументКонтрагента, - Расхождение, Расхождение);
	Форма.РасхождениеПолучатель = - Форма.Расхождение;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНаименованиеДоговора()
	ТекущиеДанные = ТекущийЭлемент.ТекущиеДанные;
	ТекущиеДанные.НаименованиеДоговора = 
		ПолучитьНаименование(НСтр("ru = 'Договор'"), ТекущиеДанные.НомерДоговора, ТекущиеДанные.ДатаДоговора);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНаименованиеДокумента()
	ТекущиеДанные = ТекущийЭлемент.ТекущиеДанные;
	ТекущиеДанные.НаименованиеДокумента = 
		ПолучитьНаименование(НСтр("ru = 'Документ'"), ТекущиеДанные.НомерДокумента, ТекущиеДанные.ДатаДокумента);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНаименованиеОперации()
	ТекущиеДанные = ТекущийЭлемент.ТекущиеДанные;
	ТекущиеДанные.НаименованиеОперации = 
		ПолучитьНаименование(НСтр("ru = 'Операция'"), ТекущиеДанные.ПорядковыйНомерОперации, ТекущиеДанные.ДатаОперации);
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииКлючевыхРеквизитов()
	
	Если Объект.ЭтоДокументКонтрагента Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ЕстьРасхождения = Ложь;
	Объект.ОстатокНаНачалоПоДаннымПолучателя = 0;
	Объект.ДанныеПолучателя.Очистить();
	
	НастроитьСтраницыДанныхОтправителяИПолучателя(ЭтотОбъект, Объект.ЕстьРасхождения,
		Объект.ЭтоДокументКонтрагента);
		
	УстановитьДоступностьПризнакаНаличияРазногласий();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьДоступностьШапки()
	
	Если Не Объект.ЭтоДокументКонтрагента Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаНомерДатаСистемный.ТолькоПросмотр = Истина;
	Элементы.ГруппаКонтрагент.ТолькоПросмотр = Истина;
	Элементы.ГруппаПериодСверки.ТолькоПросмотр = Истина;
	Элементы.ГруппаНомерДатаЭД.ТолькоПросмотр = Истина;
	Элементы.ВыбратьПериод.Доступность = Ложь;
	Элементы.Организация.ТолькоПросмотр = Истина;
	Элементы.ОстатокНаНачало.ТолькоПросмотр = Истина;
	Элементы.Валюта.ТолькоПросмотр = Истина;
	
КонецПроцедуры

#КонецОбласти