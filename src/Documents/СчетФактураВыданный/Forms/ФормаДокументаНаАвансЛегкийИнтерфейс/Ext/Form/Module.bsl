#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() Тогда
		ПодготовитьФормуНаСервере();
	КонецЕсли;
	
	Если Объект.ПлатежноРасчетныеДокументы.Количество() = 0 Тогда
		Объект.ПлатежноРасчетныеДокументы.Добавить();
	КонецЕсли;
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = 
		ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента_ЛегкийКлиентЭДО();
	ПараметрыКомандЭДО = ПараметрыЭДОПриСоздании.ПараметрыКомандЭДО;
	ПараметрыКомандЭДО.Форма = ЭтотОбъект;
	ПараметрыКомандЭДО.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента_ЛегкийКлиентЭДО(ПараметрыЭДОПриСоздании);

	Если Объект.Ссылка.Пустая() Тогда
		ИнтерфейсКлиентЭДО.ЗаполнитьДанныеПоФорматамЭлектронныхДокументовВФормеДокумента(
			ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
		ИнтерфейсКлиентЭДОКлиентСервер.НастроитьПоляФорматаЭлектронногоДокументаНаФормеДокумента(ЭтотОбъект);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ИнтерфейсКлиентЭДО.ЗаполнитьДанныеПоФорматамЭлектронныхДокументовВФормеДокумента(
		ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	ИнтерфейсКлиентЭДОКлиентСервер.НастроитьПоляФорматаЭлектронногоДокументаНаФормеДокумента(ЭтотОбъект);
	ИнтерфейсКлиентЭДО.НастроитьДоступностьФормыДокументаПоСвязанномуЭлектронномуДокументу(ЭтотОбъект);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьДокументИБПослеЗаполнения" 
		И Параметр.Найти(Объект.Ссылка) <> Неопределено Тогда
		Прочитать();
	КонецЕсли;
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента_ЛегкийКлиентЭДО();
	ПараметрыОповещения.Форма = ЭтотОбъект;
	ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
	ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента_ЛегкийКлиентЭДО(ИмяСобытия, Параметр,
		Источник, ПараметрыОповещения);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	Если ИмяСобытия = ИнтерфейсКлиентЭДОКлиент.ИмяСобытияИзменениеОбщегоСостоянияДокумента()
		И (Параметр = Объект.Ссылка Или Параметр = ЭтотОбъект) Тогда
	
		ОбновитьДанныеПослеИзмененияОбщегоСостояния();
	
	ИначеЕсли ИмяСобытия = ИнтерфейсКлиентЭДОКлиент.ИмяСобытияИзменениеСвязанныхДокументов()
		И (Параметр = Объект.Ссылка Или Параметр = ЭтотОбъект
		Или СвязанныеДокументы.НайтиПоЗначению(Параметр) <> Неопределено) Тогда
	
		ОбновитьПанельСвязанныхДокументов();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.Выставлен И Не ЗначениеЗаполнено(Объект.ДатаВыставления) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ОбщегоНазначенияБЭДКлиентСервер.ТекстСообщения(
			"Поле", "Заполнение", НСтр("ru = 'Дата выставления'")),
			Объект, "ДатаВыставления", , Отказ);
	ИначеЕсли Не Объект.Выставлен Тогда
		Объект.ДатаВыставления = '00010101';
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ФорматИзменен = ОбменСКонтрагентами.ИзменитьФорматВНастройкахОтправкиЭлектронныхДокументов(ТекущийОбъект,
		ФорматЭлектронногоДокумента);
	Если ФорматИзменен Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ИзменилисьКлючевыеРеквизиты", Истина);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	КлиентЭДО.КэшироватьПризнакИспользованияХарактеристик(Объект.Товары, ПараметрыЗаписи);
	КлиентЭДО.КэшироватьПредставленияСодержаний(Объект.Товары, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ПараметрыЗаписи.Вставить("Ссылка", Объект.Ссылка);
	ПараметрыЗаписи.Вставить("ДокументыОснования", Новый Массив);
	
	Оповестить("Запись_СчетФактураВыданный", ПараметрыЗаписи);
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ИнтерфейсКлиентЭДОКлиент.ОповеститьОбИзмененииСвязанныхДокументов(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	СформироватьЗаголовокФормы();
	
	КлиентЭДО.ВосстановитьПризнакИспользованияХарактеристик(Объект.Товары, ПараметрыЗаписи);
	КлиентЭДО.ВосстановитьПредставленияСодержаний(Объект.Товары, ПараметрыЗаписи);
	
	ОбновитьДанныеПослеИзмененияОбщегоСостоянияНаСервере();
	ОбновитьПанельСвязанныхДокументовНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры

