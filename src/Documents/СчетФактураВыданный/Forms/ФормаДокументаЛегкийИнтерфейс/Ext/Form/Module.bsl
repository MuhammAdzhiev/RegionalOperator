&НаКлиенте
Процедура СформироватьПредставлениеСодержанияСтроки(СтрокаТаблицы)
	
	ПредставлениеСодержания  = КлиентЭДОКлиентСервер.ПолучитьПредставлениеСодержания(СтрокаТаблицы.Номенклатура,
		СтрокаТаблицы.Характеристика);
	СтрокаТаблицы.ПредставлениеСодержания = ПредставлениеСодержания;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКлючевыхРеквизитов()
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ИнтерфейсКлиентЭДО.ЗаполнитьДанныеПоФорматамЭлектронныхДокументовВФормеДокумента(
		ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	ИнтерфейсКлиентЭДОКлиентСервер.НастроитьПоляФорматаЭлектронногоДокументаНаФормеДокумента(ЭтотОбъект);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыНоменклатура");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыХарактеристика");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСодержание");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыЕдиницаИзмерения");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		"Объект.Товары.КоличествоУпаковокДоКорректировки", ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыКоличество");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыЦена");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСумма");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСтавкаНДС");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		"Объект.Товары.КоличествоУпаковокДоКорректировки", ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	КлиентЭДО.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект);
	КлиентЭДО.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект,
		"ТоварыОснованияХарактеристика", "ТоварыОснования.ХарактеристикиИспользуются");
	
	КлиентЭДО.УстановитьУсловноеОформлениеКоличестваИЕдиницыИзмерения(ЭтотОбъект);
	
	КлиентЭДО.УстановитьУсловноеОформлениеПредставленияСодержания(ЭтотОбъект, "ТоварыСодержание",
		"Объект.Товары.ПредставлениеСодержания", "Объект.Товары.Содержание", "Объект.Товары.Номенклатура");
	
	КлиентЭДО.УстановитьУсловноеОформлениеПредставленияСодержания(ЭтотОбъект, "ТоварыОснованияСодержание",
		"ТоварыОснования.ПредставлениеСодержания", "ТоварыОснования.Содержание", "ТоварыОснования.Номенклатура"); 

КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьИспользованиеОснований();
	
	СформироватьЗаголовокФормы();
	УстановитьВидимостьПолейНДС();
	
	КлиентЭДО.ЗаполнитьВариантыРасчетаНДС(ЭтотОбъект);
	
	Если Объект.ВидОперации = Перечисления.ВидыОпераций.Реализация Тогда
		Элементы.ГруппаНомерИсправления.Видимость = Ложь;
		Элементы.ГруппаНомерДатаИсходногоДокумента.Видимость = Ложь;
		Элементы.ГруппаНомерДатаИсправленияИсходногоДокумента.Видимость = Ложь;
		Элементы.ГруппаНомерДатаИсправляемогоКорректировочногоДокумента.Видимость = Ложь;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		Элементы.НомерЭД.ТолькоПросмотр = Истина;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОпераций.Корректировка Тогда
		Элементы.ГруппаНомерИсправления.Видимость = Ложь;
		Элементы.ГруппаНомерДатаИсправляемогоКорректировочногоДокумента.Видимость = Ложь;
		
	КонецЕсли;
	
	ЕстьДокументыОснования = Объект.ДокументыОснования.Количество() > 0;
	
	Элементы.Организация.ТолькоПросмотр        = ЕстьДокументыОснования;
	Элементы.Контрагент.ТолькоПросмотр         = ЕстьДокументыОснования;
	Элементы.ДоговорКонтрагента.ТолькоПросмотр = ЕстьДокументыОснования;
	
	Элементы.СтраницаТовары.Видимость = НЕ ЕстьДокументыОснования;
	Элементы.ГруппаИтоги.Видимость = НЕ ЕстьДокументыОснования;
	
	Элементы.СтраницаТоварыОснования.Видимость = ЕстьДокументыОснования;
	Элементы.ГруппаИтогиОснования.Видимость = ЕстьДокументыОснования;
	
	Элементы.ТоварыГруппаСуммаСНДС.Видимость = НЕ Объект.ЦенаВключаетНДС;
	Элементы.ТоварыОснованияГруппаСуммаСНДС.Видимость = НЕ Объект.ЦенаВключаетНДС;
	
	Если ЕстьДокументыОснования Тогда
		Элементы.ГруппаВалютаВариантРасчетаНДС.ТолькоПросмотр = Истина;
		
		ЗаполнитьТоварыОснования();
		Товары = ТоварыОснования;
		
		ВладелецТаблицыТоваров = ЭтотОбъект;
		ИмяТаблицыТоваров = "ТоварыОснования";
	Иначе
		Товары = Объект.Товары;
		
		ВладелецТаблицыТоваров = Объект;
		ИмяТаблицыТоваров = "Товары";
		
		КлиентЭДО.ЗаполнитьПредставленияРНПТ(Объект.Товары, Объект.СведенияПрослеживаемости);
	КонецЕсли;
	
	КлиентЭДО.ЗаполнитьПризнакИспользованияХарактеристик(Товары);
	КлиентЭДО.ЗаполнитьПредставленияСодержаний(Товары);
	КлиентЭДО.ЗаполнитьРеквизитыМаркировки(ВладелецТаблицыТоваров, ИмяТаблицыТоваров);
	КлиентЭДО.ЗаполнитьТипНоменклатуры(Объект.Товары);
	
	КлиентЭДО.НастроитьВидимостьОрганизацииВФорме(ЭтотОбъект, "Организация");
	
	УстановитьВидимостьПолейДоКорректировки(Товары);
	
	ИнтерфейсКлиентЭДО.ПодготовитьПанельДополнительногоСостояния(ЭтотОбъект);
	
	ИнтерфейсКлиентЭДО.ПодготовитьПанельСвязанныхДокументов(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьИспользованиеОснований()
	
	ЕстьДокументыОснованияУСчетаФактурыОснование = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.СчетФактураОснование) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СчетФактураВыданныйДокументыОснования.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ПО СчетФактураВыданныйДокументыОснования.ДокументОснование = РеализацияТоваровУслуг.Ссылка
		|			И (РеализацияТоваровУслуг.Проведен)
		|ГДЕ
		|	СчетФактураВыданныйДокументыОснования.Ссылка = &СчетФактураОснование";
	
	Запрос.УстановитьПараметр("СчетФактураОснование", Объект.СчетФактураОснование);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьДокументыОснованияУСчетаФактурыОснование = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыОснования();
	
	МассивОснований = Новый Массив;
	Для Каждого СтрокаТаблицы Из Объект.ДокументыОснования Цикл
		МассивОснований.Добавить(СтрокаТаблицы.ДокументОснование);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Товары.КоличествоУпаковокДоКорректировки КАК КоличествоУпаковокДоКорректировки,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.КоличествоУпаковок * &КоэффициентУпаковки КАК Количество,
	|	Товары.ЦенаДоКорректировки КАК ЦенаДоКорректировки,
	|	Товары.Цена КАК Цена,
	|	Товары.СуммаДоКорректировки КАК СуммаДоКорректировки,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДСДоКорректировки КАК СтавкаНДСДоКорректировки,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДСДоКорректировки КАК СуммаНДСДоКорректировки,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.СуммаСНДСДоКорректировки КАК СуммаСНДСДоКорректировки,
	|	Товары.СуммаСНДС КАК СуммаСНДС,
	|	Товары.СуммаАкцизаДоКорректировки КАК СуммаАкцизаДоКорректировки,
	|	Товары.СуммаАкциза КАК СуммаАкциза,
	|	Товары.НомерГТД КАК НомерГТД,
	|	Товары.СтранаПроисхождения КАК СтранаПроисхождения,
	|	Товары.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Товары.Содержание КАК Содержание
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка В(&Основания)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеализацияТоваровУслугКодыИндивидуальныхУпаковокМаркируемойПродукции.НомерУпаковки КАК НомерУпаковки,
	|	РеализацияТоваровУслугКодыИндивидуальныхУпаковокМаркируемойПродукции.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.КодыУпаковокМаркируемойПродукции КАК РеализацияТоваровУслугКодыИндивидуальныхУпаковокМаркируемойПродукции
	|ГДЕ
	|	РеализацияТоваровУслугКодыИндивидуальныхУпаковокМаркируемойПродукции.Ссылка В(&Основания)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КодыУпаковокМаркируемойПродукцииДоКорректировки.НомерУпаковки КАК НомерУпаковки,
	|	КодыУпаковокМаркируемойПродукцииДоКорректировки.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.КодыУпаковокМаркируемойПродукцииДоКорректировки КАК КодыУпаковокМаркируемойПродукцииДоКорректировки
	|ГДЕ
	|	КодыУпаковокМаркируемойПродукцииДоКорректировки.Ссылка В(&Основания)";
	
	Запрос.УстановитьПараметр("Основания", МассивОснований);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КоэффициентУпаковки",
		Справочники.ЕдиницыИзмерения.ТекстЗапросаКоэффициентУпаковки("Товары.ЕдиницаИзмерения"));
	
	ТоварыОснования.Очистить();
	НомерСтроки = 1;
	РезультатыЗапросов = Запрос.ВыполнитьПакет();
	
	ВыборкаТоваров = РезультатыЗапросов[0].Выбрать();
	Пока ВыборкаТоваров.Следующий() Цикл
		НоваяСтрока = ТоварыОснования.Добавить();
		НоваяСтрока.НомерСтроки = НомерСтроки;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаТоваров);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	ЗаполнитьТаблицуУпаковокПоВыборке(КодыУпаковокМаркируемойПродукции, РезультатыЗапросов[1].Выбрать());
	ЗаполнитьТаблицуУпаковокПоВыборке(КодыУпаковокМаркируемойПродукцииДоКорректировки, РезультатыЗапросов[2].Выбрать());
	
	Элементы.СтраницаТоварыОснования.Заголовок = СтрШаблон(НСтр("ru = 'Товары и услуги (%1)'"),
		ТоварыОснования.Количество());
	
	СуммаНДСДокумента = ТоварыОснования.Итог("СуммаНДС");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуУпаковокПоВыборке(ТаблицаУпаковок, Выборка)
	
	ТаблицаУпаковок.Очистить();
	НомерСтроки = 1;
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СформироватьЗаголовокФормы()
	
	Заголовок = КлиентЭДОКлиентСервер.ПредставлениеДокументаЛегкийКлиентЭДО(Объект, Объект.Ссылка.Пустая());
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолейДоКорректировки(ТаблицаТовары);
	
	ВидимостьДоКорректировки = Объект.ВидОперации = Перечисления.ВидыОпераций.Корректировка
		Или (ЗначениеЗаполнено(Объект.НомерИсправляемогоКорректировочногоДокумента)
			И ЗначениеЗаполнено(Объект.ДатаИсправляемогоКорректировочногоДокумента));
	
	Элементы.ТоварыГруппаЗаголовкиСтрок.Видимость       = ВидимостьДоКорректировки;
	Элементы.ТоварыКоличествоДоКорректировки.Видимость  = ВидимостьДоКорректировки;
	Элементы.ТоварыЦенаДоКорректировки.Видимость        = ВидимостьДоКорректировки;
	Элементы.ТоварыСтавкаНДСДоКорректировки.Видимость   = ВидимостьДоКорректировки;
	Элементы.ТоварыСуммаДоКорректировки.Видимость       = ВидимостьДоКорректировки;
	Элементы.ТоварыСуммаНДСДоКорректировки.Видимость    = ВидимостьДоКорректировки;
	Элементы.ТоварыСуммаСНДСДоКорректировки.Видимость   = ВидимостьДоКорректировки
		И Не Объект.ЦенаВключаетНДС;
	Элементы.ТоварыСуммаАкцизаДоКорректировки.Видимость = ВидимостьДоКорректировки;
	
	Элементы.ТоварыОснованияГруппаЗаголовкиСтрок.Видимость       = ВидимостьДоКорректировки;
	Элементы.ТоварыОснованияКоличествоДоКорректировки.Видимость  = ВидимостьДоКорректировки;
	Элементы.ТоварыОснованияЦенаДоКорректировки.Видимость        = ВидимостьДоКорректировки;
	Элементы.ТоварыОснованияСтавкаНДСДоКорректировки.Видимость   = ВидимостьДоКорректировки;
	Элементы.ТоварыОснованияСуммаДоКорректировки.Видимость       = ВидимостьДоКорректировки;
	Элементы.ТоварыОснованияСуммаНДСДоКорректировки.Видимость    = ВидимостьДоКорректировки;
	Элементы.ТоварыОснованияСуммаСНДСДоКорректировки.Видимость   = ВидимостьДоКорректировки
		И Не Объект.ЦенаВключаетНДС;
	Элементы.ТоварыОснованияСуммаАкцизаДоКорректировки.Видимость = ВидимостьДоКорректировки;
	Элементы.ТоварыОснованияМаркируемыеУпаковкиДоКорректировки.Видимость = ВидимостьДоКорректировки;
	
	Элементы.ПлатежноРасчетныеДокументы.ТолькоПросмотр = ВидимостьДоКорректировки;
	
	Если ВидимостьДоКорректировки Тогда
		Для Каждого СтрокаТаблицы Из ТаблицаТовары Цикл
			ЗаполнитьЗаголовкиСтрок(СтрокаТаблицы);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьЗаголовкиСтрок(СтрокаТаблицы)
	
	СтрокаТаблицы.НадписьДоКорректировки    = НСтр("ru = 'До корректировки:'");
	СтрокаТаблицы.НадписьПослеКорректировки = НСтр("ru = 'После корректировки:'");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолейНДС()
	
	ВидимостьНДС = Не Объект.ОблагаетсяНДСУПокупателя;
	
	Элементы.ТоварыГруппаСтавкаНДС.Видимость = ВидимостьНДС;
	Элементы.ТоварыГруппаСуммаНДС.Видимость  = ВидимостьНДС;
	Элементы.ТоварыГруппаСуммаСНДС.Видимость = ВидимостьНДС;
	Элементы.ИтогиВсегоНДС.Видимость = ВидимостьНДС;
	
	Элементы.ТоварыОснованияГруппаСтавкаНДС.Видимость = ВидимостьНДС;
	Элементы.ТоварыОснованияГруппаСуммаНДС.Видимость  = ВидимостьНДС;
	Элементы.ТоварыОснованияГруппаСуммаСНДС.Видимость = ВидимостьНДС;
	Элементы.ИтогиОснованияВсегоНДС.Видимость = ВидимостьНДС;
	
	Элементы.ТоварыСуммаСНДС.Видимость = Не Объект.ЦенаВключаетНДС;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВариантаРасчетаНДС();
	
	КлиентЭДОКлиентСервер.ПриИзмененииВариантаРасчетаНДС(ЭтотОбъект);
	УстановитьВидимостьПолейНДС();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзВнешнегоФайлаЗавершение(Результат, Контекст) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементКоллекции Из Результат Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементКоллекции);
		КлиентЭДОКлиентСервер.ПриИзмененииКоличествоЦена(НоваяСтрока, Объект.ЦенаВключаетНДС);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьЗаполнениеДокументовОснований(Отказ = Ложь)
	
	Если Не ЗначениеЗаполнено(Объект.СчетФактураОснование) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЕстьДокументыОснованияУСчетаФактурыОснование
		И Не ЗначениеЗаполнено(Объект.ДокументыОснования) Тогда
		
		ТекстСообщения = НСтр("ru = 'Не выбран документ-основание'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,"ДокументыОснованияПредставление", Отказ);
		
	ИначеЕсли Не ЕстьДокументыОснованияУСчетаФактурыОснование
		И ЗначениеЗаполнено(Объект.ДокументыОснования) Тогда
		
		Если Объект.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
			ТекстСообщения = НСтр("ru = 'Исправляемая счет-фактура не содержит документов-оснований'");
		Иначе
			ТекстСообщения = НСтр("ru = 'Корректируемая счет-фактура не содержит документов-оснований'");
		КонецЕсли;
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,, "ДокументыОснованияПредставление", Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКодТНВЭДПослеВыбораИзСервиса(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
		СтрокаТаблицы.КодТНВЭД = СтрЗаменить(Результат.Код, " ", "");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеПослеИзмененияОбщегоСостояния()
	
	ОбновитьДанныеПослеИзмененияОбщегоСостоянияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПанельСвязанныхДокументов()
	
	ОбновитьПанельСвязанныхДокументовНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеПослеИзмененияОбщегоСостоянияНаСервере()

	ИнтерфейсКлиентЭДО.ПодготовитьПанельДополнительногоСостояния(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПанельСвязанныхДокументовНаСервере()

	ИнтерфейсКлиентЭДО.ПодготовитьПанельСвязанныхДокументов(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти