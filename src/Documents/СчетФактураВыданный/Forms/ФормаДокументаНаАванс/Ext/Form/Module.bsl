&НаКлиенте
Процедура СформироватьПредставлениеСодержанияСтроки(СтрокаТаблицы)
	ПредставлениеСодержания  = КлиентЭДОКлиентСервер.ПолучитьПредставлениеСодержания(СтрокаТаблицы.Номенклатура, СтрокаТаблицы.Характеристика);
	СтрокаТаблицы.ПредставлениеСодержания = ПредставлениеСодержания;
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКлючевыхРеквизитовСостояниеЭДО()
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ПараметрыПриИзменении = ОбменСКонтрагентами.ПараметрыПриИзмененииКлючевыхРеквизитовЭДО();
	
	ПараметрыПриИзменении.Форма                 = ЭтотОбъект;
	ПараметрыПриИзменении.ДокументСсылка        = Объект.Ссылка;
	ПараметрыПриИзменении.ДокументОбъект        = РеквизитФормыВЗначение("Объект");
	ПараметрыПриИзменении.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПриИзменении.ГруппаСостояниеЭДО    = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриИзмененииКлючевыхРеквизитовЭДО(ПараметрыПриИзменении);
	
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "АвансыСуммаНДС");
	ГруппаОтбора1 = КлиентЭДОКлиентСервер.ДобавитьГруппуОтбора(ЭлементОформления.Отбор.Элементы,
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбора1,
		"Объект.Товары.СтавкаНДС", ВидСравненияКомпоновкиДанных.Равно, Перечисления.СтавкиНДС.НДС0);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбора1,
		"Объект.Товары.СтавкаНДС", ВидСравненияКомпоновкиДанных.Равно, Перечисления.СтавкиНДС.БезНДС);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();  
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "АвансыНоменклатура");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		"Объект.Товары.Номенклатура", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Предварительная оплата'"));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);
	
	КлиентЭДО.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект, "АвансыХарактеристика");
	
	КлиентЭДО.УстановитьУсловноеОформлениеПредставленияСодержания(ЭтотОбъект, "АвансыСодержание", "Объект.Товары.ПредставлениеСодержания", 
																"Объект.Товары.Содержание",	"Объект.Товары.Номенклатура", 
																НСтр("ru = 'Предварительная оплата'"));  
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	СформироватьЗаголовокФормы();
	УстановитьСтатусДокумента();
	УстановитьВидимостьПолейНДС(ЭтотОбъект);
	КлиентЭДО.ЗаполнитьПризнакИспользованияХарактеристик(Объект.Товары);
	КлиентЭДО.ЗаполнитьПредставленияСодержаний(Объект.Товары);
	КлиентЭДО.ЗаполнитьВариантыРасчетаНДС(ЭтотОбъект);
	ЗаполнитьСтавкуНДСПоУмолчанию();
	
	Если Объект.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		Элементы.НомерЭД.ТолькоПросмотр = Истина;
	Иначе
		Элементы.ГруппаНомерИсправления.Видимость = Ложь;;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтавкуНДСПоУмолчанию()
	Если Перечисления.СтавкиНДС.ДействуетСтавкаНДС22(ТекущаяДатаСеанса()) Тогда
		СтавкаНДСПоУмолчанию = Перечисления.СтавкиНДС.НДС22;
	Иначе
		СтавкаНДСПоУмолчанию = Перечисления.СтавкиНДС.НДС20;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СформироватьЗаголовокФормы()
	
	ЭтотОбъект.Заголовок = КлиентЭДОКлиентСервер.ПредставлениеИсходящегоДокумента(Объект, Объект.Ссылка.Пустая());
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтатусДокумента()
	
	СтатусДокумента = КлиентЭДО.СтатусДокумента(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииВариантаРасчетаНДС()
	
	КлиентЭДОКлиентСервер.ПриИзмененииВариантаРасчетаНДС(ЭтотОбъект);
	УстановитьВидимостьПолейНДС(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПолейНДС(Форма)
	
	Элементы = Форма.Элементы;
	
	ВидимостьНДС = НЕ Форма.Объект.ОблагаетсяНДСУПокупателя;
	Элементы.АвансыСтавкаНДС.Видимость = ВидимостьНДС;
	Элементы.АвансыСуммаНДС.Видимость  = ВидимостьНДС;
	Элементы.ИтогиВсегоНДС.Видимость   = ВидимостьНДС;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыНоменклатуры(Знач СсылкаНаОбъект);
	
	Возврат КлиентЭДО.РеквизитыНоменклатурыПриИзменении(СсылкаНаОбъект, "ЕдиницаИзмерения,СтавкаНДС");
	
КонецФункции

