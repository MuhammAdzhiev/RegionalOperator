#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	
	Если ТипДанныхЗаполнения = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		ЗаполнитьДокументНаОснованииРеализацииТоваровУслуг(ДанныеЗаполнения);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		ЗаполнитьДокументНаОснованииСчетаФактуры(ДанныеЗаполнения);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("Структура")
		И ДанныеЗаполнения.Свойство("Основание")
		И ДанныеЗаполнения.Свойство("ВидОперации", ВидОперации) Тогда
		
		ЗаполнитьДокументНаОснованииСчетаФактуры(ДанныеЗаполнения.Основание);
		
	КонецЕсли;
	
	ИнициализироватьДокумент();
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	УстановитьПредставлениеНомера();
	КлиентЭДО.ИдентификаторыСтрокПередЗаписьюОбъекта(ЭтотОбъект);
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс
		ИЛИ ДокументыОснования.Количество() = 0 Тогда
		
		СуммаДокумента = Товары.Итог("Сумма");
		
		Если ОблагаетсяНДСУПокупателя Тогда
			Для Каждого СтрокаТаблицы Из Товары Цикл
				СтрокаТаблицы.СтавкаНДС = Неопределено;
				СтрокаТаблицы.СуммаНДС  = 0;
			КонецЦикла;
		КонецЕсли;
		
	Иначе
		
		Если НЕ ПометкаУдаления Тогда
			ПроверитьДублиСчетФактуры(Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	ЭлектронноеВзаимодействиеКЭДО.ПередЗаписьюОснованияЭлектронногоДокумента(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ПредставлениеНомера = "";
	
	НомерЭД = "";
	СчетФактураОснование = Неопределено;
	ДатаВыставления = Дата(1,1,1);
	Выставлен = Ложь;
	
	НомерИсправления = 0;
	НомерИсправленияИсходногоДокумента = 0;
	НомерИсправляемогоКорректировочногоДокумента = "";
	НомерИсходногоДокумента = "";
	ДатаИсправленияИсходногоДокумента = Дата(1,1,1);
	ДатаИсправляемогоКорректировочногоДокумента = Дата(1,1,1);
	ДатаИсходногоДокумента = Дата(1,1,1);
	Ответственный = Пользователи.ТекущийПользователь();
	СведенияОВыданныхСчетахФактурахНаАванс.Очистить();
	
	Если ДокументыОснования.Количество() Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Характеристика КАК Характеристика,
		|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Товары.КоличествоУпаковокДоКорректировки КАК КоличествоУпаковокДоКорректировки,
		|	Товары.КоличествоУпаковок * &КоэффициентУпаковки КАК Количество,
		|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
		|	Товары.ЦенаДоКорректировки КАК ЦенаДоКорректировки,
		|	Товары.Цена КАК Цена,
		|	Товары.СуммаДоКорректировки КАК СуммаДоКорректировки,
		|	Товары.Сумма КАК Сумма,
		|	Товары.СтавкаНДСДоКорректировки КАК СтавкаНДСДоКорректировки,
		|	Товары.СтавкаНДС КАК СтавкаНДС,
		|	Товары.СуммаНДСДоКорректировки КАК СуммаНДСДоКорректировки,
		|	Товары.СуммаНДС КАК СуммаНДС,
		|	Товары.СуммаСНДСДоКорректировки КАК СуммаСНДСДоКорректировки,
		|	Товары.СуммаСНДС КАК СуммаСНДС,
		|	Товары.СуммаАкцизаДоКорректировки КАК СуммаАкцизаДоКорректировки,
		|	Товары.СуммаАкциза КАК СуммаАкциза,
		|	Товары.НомерГТД КАК НомерГТД,
		|	Товары.СтранаПроисхождения КАК СтранаПроисхождения
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК Товары
		|ГДЕ
		|	Товары.Ссылка В(&Основания)";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КоэффициентУпаковки",
			Справочники.ЕдиницыИзмерения.ТекстЗапросаКоэффициентУпаковки("Товары.ЕдиницаИзмерения"));
		
		Запрос.УстановитьПараметр("Основания", ДокументыОснования.ВыгрузитьКолонку("ДокументОснование"));
		
		Товары.Загрузить(Запрос.Выполнить().Выгрузить());
		
		ДокументыОснования.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	Если ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		Префикс = "И";
	Иначе
		Префикс = "0";
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Не ЗначениеЗаполнено(СчетФактураОснование)
		И (ВидОперации = Перечисления.ВидыОпераций.Исправление
		ИЛИ ВидОперации = Перечисления.ВидыОпераций.Корректировка) Тогда
		
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Не выбран счет-фактура к %1.'"),
			?(ВидОперации = Перечисления.ВидыОпераций.Исправление,
				НСтр("ru = 'исправлению'"), НСтр("ru = 'корректировке'")));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ,
			"СчетФактураОснованиеПредставление", Отказ);
		
	КонецЕсли;
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	ПроверитьКоличествоЕдиницуЦену = Истина;
	
	Если ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс Тогда
		ПроверяемыеРеквизиты.Добавить("ПлатежноРасчетныеДокументы");
		МассивНепроверяемыхРеквизитов.Добавить("ДокументыОснования.ДокументОснование");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Номенклатура");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Характеристика");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.ЕдиницаИзмерения");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Количество");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.КоличествоУпаковок");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Цена");
		ПроверитьКоличествоЕдиницуЦену = Ложь;
		
	ИначеЕсли ДокументыОснования.Количество() Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Товары");
		ПроверитьКоличествоЕдиницуЦену = Ложь;
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОпераций.Корректировка
		ИЛИ (ВидОперации = Перечисления.ВидыОпераций.Исправление
			И ЗначениеЗаполнено(НомерИсправляемогоКорректировочногоДокумента)) Тогда
		ПараметрыПроверки = Новый Структура;
		ПараметрыПроверки.Вставить("Объект", ЭтотОбъект);
		ПараметрыПроверки.Вставить("МассивНепроверяемыхРеквизитов", МассивНепроверяемыхРеквизитов);
		КлиентЭДО.ПроверитьЗаполнениеЗначенийПриКорректировке(ПараметрыПроверки, Отказ);
		ПроверитьКоличествоЕдиницуЦену = Ложь;
	КонецЕсли;
	
	Если Товары.Количество() Тогда
		ПараметрыПроверки = КлиентЭДО.ПараметрыПроверкиЗаполненияКоличестваИЕдиницыИзмерения();
		ПараметрыПроверки.Вставить("Объект", ЭтотОбъект);
		ПараметрыПроверки.Вставить("МассивНепроверяемыхРеквизитов", МассивНепроверяемыхРеквизитов);
		КлиентЭДО.ПроверитьЗаполнениеХарактеристик(ПараметрыПроверки, Отказ);
		КлиентЭДО.ПроверитьЗаполнениеДанныхАмортизации(ПараметрыПроверки, Отказ);
		Если ПроверитьКоличествоЕдиницуЦену Тогда
			КлиентЭДО.ПроверитьЗаполнениеКоличестваИЕдиницыИзмерения(ПараметрыПроверки, Отказ);
		Иначе
			МассивНепроверяемыхРеквизитов.Добавить("Товары.ЕдиницаИзмерения");
			МассивНепроверяемыхРеквизитов.Добавить("Товары.Количество");
			МассивНепроверяемыхРеквизитов.Добавить("Товары.КоличествоУпаковок");
			МассивНепроверяемыхРеквизитов.Добавить("Товары.Цена");
		КонецЕсли;
	КонецЕсли;
	
	Если ОблагаетсяНДСУПокупателя Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Товары.СтавкаНДСДоКорректировки");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.СтавкаНДС");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МассивНепроверяемыхРеквизитов) Тогда
		ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Устанавливает номер документа, заполняет реквизиты НомерЭД и ПредставлениеНомера
Процедура УстановитьПредставлениеНомера() Экспорт
	
	Если ПустаяСтрока(Номер) Тогда
		УстановитьНовыйНомер();
	КонецЕсли;
	
	Если ПустаяСтрока(НомерЭД) Тогда
		НомерЭД = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Номер, Истина, Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерИсправления) Тогда
		ПредставлениеНомера = СтрШаблон(НСтр("ru = '%1 (испр. %2)'"),
			НомерЭД, НомерИсправления);
	Иначе
		ПредставлениеНомера = НомерЭД;
	КонецЕсли;
	
КонецПроцедуры

Процедура ИнициализироватьДокумент()
	
	Если Не ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
	Если Не Справочники.Организации.ИспользуетсяНесколькоОрганизаций()
		И Не ЗначениеЗаполнено(Организация) Тогда
		Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	КонецЕсли;
	
	Ответственный = Пользователи.ТекущийПользователь();
	
КонецПроцедуры

Процедура ПроверитьДублиСчетФактуры(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокументыОснования.ДокументОснование КАК Ссылка
	|ПОМЕСТИТЬ Основания
	|ИЗ
	|	&ДокументыОснования КАК ДокументыОснования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	Основания.Ссылка КАК ДокументОснование
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК ДанныеДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Основания КАК Основания
	|		ПО ДанныеДокумента.ДокументОснование = Основания.Ссылка
	|ГДЕ
	|	ДанныеДокумента.Ссылка <> &Ссылка
	|	И НЕ ДанныеДокумента.Ссылка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ДокументыОснования", ДокументыОснования);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Для документа %1 по организации %2 уже введен счет-фактура %3'"),
			Выборка.ДокументОснование, Организация, Выборка.Ссылка);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			ЭтотОбъект, "ДокументыОснования",, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДокументНаОснованииРеализацииТоваровУслуг(ДанныеЗаполнения)
	
	СуществующийСФ = Документы.СчетФактураВыданный.СчетФактураДокумента(ДанныеЗаполнения);
	Если ЗначениеЗаполнено(СуществующийСФ)
		И СуществующийСФ <> Ссылка Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru='На основании документа %1 был введен %2'"),
			ДанныеЗаполнения, СуществующийСФ);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваровУслуг.ВидОперации КАК ВидОперации,
		|	РеализацияТоваровУслуг.Организация КАК Организация,
		|	РеализацияТоваровУслуг.Контрагент КАК Контрагент,
		|	РеализацияТоваровУслуг.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	РеализацияТоваровУслуг.Валюта КАК Валюта,
		|	РеализацияТоваровУслуг.СуммаДокумента КАК СуммаДокумента,
		|	РеализацияТоваровУслуг.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
		|	РеализацияТоваровУслуг.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
		|	РеализацияТоваровУслуг.ОблагаетсяНДСУПокупателя КАК ОблагаетсяНДСУПокупателя,
		|	РеализацияТоваровУслуг.Фактор КАК Фактор,
		|	РеализацияТоваровУслуг.ОснованиеУступкиНаименование КАК ОснованиеУступкиНаименование,
		|	РеализацияТоваровУслуг.ОснованиеУступкиНомер КАК ОснованиеУступкиНомер,
		|	РеализацияТоваровУслуг.ОснованиеУступкиДата КАК ОснованиеУступкиДата,
		|	РеализацияТоваровУслуг.ОснованиеУступкиСведения КАК ОснованиеУступкиСведения,
		|	РеализацияТоваровУслуг.ГосЗакупкаДатаКонтракта КАК ГосЗакупкаДатаКонтракта,
		|	РеализацияТоваровУслуг.ГосЗакупкаНомерКонтракта КАК ГосЗакупкаНомерКонтракта,
		|	РеализацияТоваровУслуг.ГосЗакупкаНомерЛицевогоСчета КАК ГосЗакупкаНомерЛицевогоСчета,
		|	РеализацияТоваровУслуг.ГосЗакупкаКодБюджетнойКлассификации КАК ГосЗакупкаКодБюджетнойКлассификации,
		|	РеализацияТоваровУслуг.ГосЗакупкаКодЦели КАК ГосЗакупкаКодЦели,
		|	РеализацияТоваровУслуг.ГосЗакупкаКазначействоКод КАК ГосЗакупкаКазначействоКод,
		|	РеализацияТоваровУслуг.ГосЗакупкаКазначействоНаименование КАК ГосЗакупкаКазначействоНаименование,
		|	РеализацияТоваровУслуг.ДатаНачалаПоставки КАК ДатаНачалаПоставки,
		|	РеализацияТоваровУслуг.ДатаОкончанияПоставки КАК ДатаОкончанияПоставки,
		|	РеализацияТоваровУслуг.ДатаОтгрузки КАК ДатаОтгрузки,
		|	РеализацияТоваровУслуг.ДокументыПодтвержденияОтгрузки.(
		|		НомерСтроки КАК НомерСтроки,
		|		Наименование КАК Наименование,
		|		Номер КАК Номер,
		|		Дата КАК Дата
		|	) КАК ДокументыПодтвержденияОтгрузки
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДокументыОснования.Очистить();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
		ИспользуемУПД = ОбменСКонтрагентами.ИспользованиеУниверсальногоПередаточногоДокумента(
				Организация, Контрагент, ДоговорКонтрагента);
		Если Не ИспользуемУПД Тогда
			ДокументыПодтвержденияОтгрузки.Загрузить(Выборка.ДокументыПодтвержденияОтгрузки.Выгрузить());
			Если ДокументыПодтвержденияОтгрузки.Количество() = 0 Тогда
				
				НоваяСтрока = ДокументыПодтвержденияОтгрузки.Добавить();
				КоличествоТоваровОснования = ДанныеЗаполнения.Товары.Количество();
				Если КоличествоТоваровОснования = 1 Тогда
					НоваяСтрока.НомераСтрок = "1";
				Иначе
					НоваяСтрока.НомераСтрок = СтрШаблон("1 - %1", КоличествоТоваровОснования);
				КонецЕсли;
				НоваяСтрока.Номер = ДанныеЗаполнения.ПредставлениеНомера;
				НоваяСтрока.Дата = НачалоДня(ДанныеЗаполнения.Дата);
				НоваяСтрока.Наименование = Строка(ДанныеЗаполнения.ВидДокумента);
			КонецЕсли;
		КонецЕсли;
		НоваяСтрока = ДокументыОснования.Добавить();
		НоваяСтрока.ДокументОснование = ДанныеЗаполнения;
	КонецЕсли;
	
	Если ВидОперации = Перечисления.ВидыОпераций.Исправление
		ИЛИ ВидОперации = Перечисления.ВидыОпераций.Корректировка Тогда
		
		СчетФактураОснование = Неопределено;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	СчетФактураВыданныйДокументыОснования.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
			|ГДЕ
			|	СчетФактураВыданныйДокументыОснования.ДокументОснование = &ДокументОснование
			|	И НЕ СчетФактураВыданныйДокументыОснования.Ссылка.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("ДокументОснование", ДанныеЗаполнения.ДокументОснование);
		ВыборкаСФ = Запрос.Выполнить().Выбрать();
		Если ВыборкаСФ.Следующий() Тогда
			СчетФактураОснование = ВыборкаСФ.Ссылка;
		Иначе
			Возврат;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	СчетФактураВыданный.Ссылка КАК Ссылка,
			|	СчетФактураВыданный.ВидОперации КАК ВидОперации,
			|	СчетФактураВыданный.НомерЭД КАК НомерЭД,
			|	СчетФактураВыданный.НомерИсправления КАК НомерИсправления,
			|	СчетФактураВыданный.Дата КАК Дата,
			|	СчетФактураВыданный.НомерИсходногоДокумента КАК НомерИсходногоДокумента,
			|	СчетФактураВыданный.ДатаИсходногоДокумента КАК ДатаИсходногоДокумента,
			|	СчетФактураВыданный.НомерИсправленияИсходногоДокумента КАК НомерИсправленияИсходногоДокумента,
			|	СчетФактураВыданный.ДатаИсправленияИсходногоДокумента КАК ДатаИсправленияИсходногоДокумента,
			|	СчетФактураВыданный.НомерИсправляемогоКорректировочногоДокумента КАК НомерИсправляемогоКорректировочногоДокумента,
			|	СчетФактураВыданный.ДатаИсправляемогоКорректировочногоДокумента КАК ДатаИсправляемогоКорректировочногоДокумента
			|ИЗ
			|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
			|
			|ГДЕ
			|	СчетФактураВыданный.Ссылка = &СчетФактураОснование";
			
		Запрос.УстановитьПараметр("СчетФактураОснование", СчетФактураОснование);
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			ВыборкаСчетФактураОснование = РезультатЗапроса.Выбрать();
			Если ВыборкаСчетФактураОснование.Следующий() Тогда
				
				СчетФактураОснование = ВыборкаСчетФактураОснование.Ссылка;
				КлиентЭДО.ЗаполнитьНомерДатуИсходногоДокумента(ЭтотОбъект, ВыборкаСчетФактураОснование);
				
			КонецЕсли;
		КонецЕсли;
		
		Если ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
			ЗаполнитьДанныеПоАСЧФИзОснования(СчетФактураОснование);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДокументНаОснованииСчетаФактуры(СчетФактура)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетФактураВыданный.ВидДокумента КАК ВидДокумента,
		|	СчетФактураВыданный.ВидОперации КАК ВидОперации,
		|	СчетФактураВыданный.НомерЭД КАК НомерЭД,
		|	СчетФактураВыданный.НомерИсправления КАК НомерИсправления,
		|	СчетФактураВыданный.Дата КАК Дата,
		|	СчетФактураВыданный.Валюта КАК Валюта,
		|	СчетФактураВыданный.Организация КАК Организация,
		|	СчетФактураВыданный.Контрагент КАК Контрагент,
		|	СчетФактураВыданный.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	СчетФактураВыданный.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
		|	СчетФактураВыданный.СуммаДокумента КАК СуммаДокумента,
		|	СчетФактураВыданный.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
		|	СчетФактураВыданный.ОблагаетсяНДСУПокупателя КАК ОблагаетсяНДСУПокупателя,
		|	СчетФактураВыданный.НомерИсходногоДокумента КАК НомерИсходногоДокумента,
		|	СчетФактураВыданный.ДатаИсходногоДокумента КАК ДатаИсходногоДокумента,
		|	СчетФактураВыданный.НомерИсправленияИсходногоДокумента КАК НомерИсправленияИсходногоДокумента,
		|	СчетФактураВыданный.ДатаИсправленияИсходногоДокумента КАК ДатаИсправленияИсходногоДокумента,
		|	СчетФактураВыданный.НомерИсправляемогоКорректировочногоДокумента КАК НомерИсправляемогоКорректировочногоДокумента,
		|	СчетФактураВыданный.ДатаИсправляемогоКорректировочногоДокумента КАК ДатаИсправляемогоКорректировочногоДокумента,
		|	СчетФактураВыданный.ГосЗакупкаДатаКонтракта КАК ГосЗакупкаДатаКонтракта,
		|	СчетФактураВыданный.ГосЗакупкаНомерКонтракта КАК ГосЗакупкаНомерКонтракта,
		|	СчетФактураВыданный.ГосЗакупкаНомерЛицевогоСчета КАК ГосЗакупкаНомерЛицевогоСчета,
		|	СчетФактураВыданный.ГосЗакупкаКодБюджетнойКлассификации КАК ГосЗакупкаКодБюджетнойКлассификации,
		|	СчетФактураВыданный.ГосЗакупкаКодЦели КАК ГосЗакупкаКодЦели,
		|	СчетФактураВыданный.ГосЗакупкаКазначействоКод КАК ГосЗакупкаКазначействоКод,
		|	СчетФактураВыданный.ГосЗакупкаКазначействоНаименование КАК ГосЗакупкаКазначействоНаименование,
		|	СчетФактураВыданный.ОснованиеУступкиНаименование КАК ОснованиеУступкиНаименование,
		|	СчетФактураВыданный.ОснованиеУступкиНомер КАК ОснованиеУступкиНомер,
		|	СчетФактураВыданный.ОснованиеУступкиДата КАК ОснованиеУступкиДата,
		|	СчетФактураВыданный.ОснованиеУступкиСведения КАК ОснованиеУступкиСведения,
		|	СчетФактураВыданный.ДатаНачалаПоставки КАК ДатаНачалаПоставки,
		|	СчетФактураВыданный.ДатаОкончанияПоставки КАК ДатаОкончанияПоставки,
		|	СчетФактураВыданный.Фактор КАК Фактор,
		|	СчетФактураВыданный.ДокументыПодтвержденияОтгрузки.(
		|		НомерСтроки КАК НомерСтроки,
		|		Наименование КАК Наименование,
		|		Номер КАК Номер,
		|		Дата КАК Дата) КАК ДокументыПодтвержденияОтгрузки
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|ГДЕ
		|	СчетФактураВыданный.Ссылка = &СчетФактураОснование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Характеристика КАК Характеристика,
		|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Товары.КоличествоУпаковокДоКорректировки КАК КоличествоУпаковокДоКорректировки,
		|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
		|	Товары.КоличествоУпаковок * &КоэффициентУпаковки КАК Количество,
		|	Товары.ЦенаДоКорректировки КАК ЦенаДоКорректировки,
		|	Товары.Цена КАК Цена,
		|	Товары.СуммаДоКорректировки КАК СуммаДоКорректировки,
		|	Товары.Сумма КАК Сумма,
		|	Товары.СтавкаНДСДоКорректировки КАК СтавкаНДСДоКорректировки,
		|	Товары.СтавкаНДС КАК СтавкаНДС,
		|	Товары.СуммаНДСДоКорректировки КАК СуммаНДСДоКорректировки,
		|	Товары.СуммаНДС КАК СуммаНДС,
		|	Товары.СуммаСНДСДоКорректировки КАК СуммаСНДСДоКорректировки,
		|	Товары.СуммаСНДС КАК СуммаСНДС,
		|	Товары.СуммаАкцизаДоКорректировки КАК СуммаАкцизаДоКорректировки,
		|	Товары.СуммаАкциза КАК СуммаАкциза,
		|	Товары.НомерГТД КАК НомерГТД,
		|	Товары.СтранаПроисхождения КАК СтранаПроисхождения,
		|	Товары.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	Товары.Содержание КАК Содержание,
		|	Товары.ОснованиеОсвобожденияОтНДС,
		|	Товары.АмортизационнаяГруппа КАК АмортизационнаяГруппа,
		|	Товары.КодОКОФ КАК КодОКОФ,
		|	Товары.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
		|	Товары.ФактСрокПолезногоИспользования КАК ФактСрокПолезногоИспользования
		|ИЗ
		|	Документ.СчетФактураВыданный.Товары КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &СчетФактураОснование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка КАК Ссылка,
		|	РеализацияТоваровУслуг.ВидОперации КАК ВидОперации,
		|	РеализацияТоваровУслуг.СуммаДокумента КАК СуммаДокумента
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
		|		ПО РеализацияТоваровУслуг.ДокументОснование = СчетФактураВыданныйДокументыОснования.ДокументОснование
		|		И (СчетФактураВыданныйДокументыОснования.Ссылка = &СчетФактураОснование)
		|		И (НЕ РеализацияТоваровУслуг.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК ОснованияСчетаФактуры
		|		ПО РеализацияТоваровУслуг.Ссылка = ОснованияСчетаФактуры.ДокументОснование
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|		ПО (ОснованияСчетаФактуры.Ссылка = СчетФактураВыданный.Ссылка)
		|		И (НЕ (СчетФактураВыданный.ПометкаУдаления
		|		ИЛИ СчетФактураВыданный.Ссылка = &СчетФактура))
		|ГДЕ
		|	СчетФактураВыданный.Ссылка ЕСТЬ NULL
		|	И &УсловиеНаВидОперации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СчетФактураВыданныйКодыИндивидуальныхУпаковокМаркируемойПродукции.НомерУпаковки КАК НомерУпаковки,
		|	СчетФактураВыданныйКодыИндивидуальныхУпаковокМаркируемойПродукции.ИдентификаторСтроки КАК ИдентификаторСтроки
		|ИЗ
		|	Документ.СчетФактураВыданный.КодыУпаковокМаркируемойПродукции КАК
		|		СчетФактураВыданныйКодыИндивидуальныхУпаковокМаркируемойПродукции
		|ГДЕ
		|	СчетФактураВыданныйКодыИндивидуальныхУпаковокМаркируемойПродукции.Ссылка = &СчетФактураОснование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СведенияПрослеживаемости.РНПТ КАК РНПТ,
		|	СведенияПрослеживаемости.КоличествоУпаковок КАК КоличествоУпаковок,
		|	СведенияПрослеживаемости.КоличествоУпаковокДоКорректировки КАК КоличествоУпаковокДоКорректировки,
		|	СведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
		|	СведенияПрослеживаемости.КоличествоПрослеживаемостиДоКорректировки КАК КоличествоПрослеживаемостиДоКорректировки,
		|	СведенияПрослеживаемости.ЕдиницаИзмеренияПрослеживаемости КАК ЕдиницаИзмеренияПрослеживаемости,
		|	СведенияПрослеживаемости.СтоимостьБезНДС,
		|	СведенияПрослеживаемости.СтоимостьБезНДСДоКорректировки,
		|	СведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки
		|ИЗ
		|	Документ.СчетФактураВыданный.СведенияПрослеживаемости КАК СведенияПрослеживаемости
		|ГДЕ
		|	СведенияПрослеживаемости.Ссылка = &СчетФактураОснование";
	
	Запрос.УстановитьПараметр("СчетФактура", Ссылка);
	Запрос.УстановитьПараметр("СчетФактураОснование", СчетФактура);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КоэффициентУпаковки",
		Справочники.ЕдиницыИзмерения.ТекстЗапросаКоэффициентУпаковки("Товары.ЕдиницаИзмерения"));
		
	Если ЗначениеЗаполнено(ВидОперации) Тогда
		УсловиеНаВидОперации = "
			|	РеализацияТоваровУслуг.ВидОперации = &ВидОперации";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНаВидОперации", УсловиеНаВидОперации);
		Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	Иначе
		Запрос.УстановитьПараметр("УсловиеНаВидОперации", Истина);
	КонецЕсли;
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	СчетФактураОснование = СчетФактура;
	ДокументыОснования.Очистить();
	
	Если НЕ РезультатыЗапроса[0].Пустой() Тогда
		
		ВыборкаСчетФактураОснование = РезультатыЗапроса[0].Выбрать();
		ВыборкаСчетФактураОснование.Следующий();
		
		Если ЭтоНовый() Тогда
			ВидДокумента = ВыборкаСчетФактураОснование.ВидДокумента;
		КонецЕсли;
		
		Если ВидДокумента = Перечисления.ВидыДокументов.СчетФактураНаАванс
			И ВидОперации = Перечисления.ВидыОпераций.Корректировка Тогда
			ТекстСообщения = НСтр("ru='Для счета-фактуры с видом ""На аванс"" возможность корректировки не предусмотрена'");
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
		Валюта                    = ВыборкаСчетФактураОснование.Валюта;
		Организация               = ВыборкаСчетФактураОснование.Организация;
		Контрагент                = ВыборкаСчетФактураОснование.Контрагент;
		ДоговорКонтрагента        = ВыборкаСчетФактураОснование.ДоговорКонтрагента;
		ИдентификаторГосКонтракта = ВыборкаСчетФактураОснование.ИдентификаторГосКонтракта;
		ЦенаВключаетНДС           = ВыборкаСчетФактураОснование.ЦенаВключаетНДС;
		ОблагаетсяНДСУПокупателя  = ВыборкаСчетФактураОснование.ОблагаетсяНДСУПокупателя;
		
		ГосЗакупкаДатаКонтракта  = ВыборкаСчетФактураОснование.ГосЗакупкаДатаКонтракта;
		ГосЗакупкаНомерКонтракта  = ВыборкаСчетФактураОснование.ГосЗакупкаНомерКонтракта;
		ГосЗакупкаНомерЛицевогоСчета  = ВыборкаСчетФактураОснование.ГосЗакупкаНомерЛицевогоСчета;
		ГосЗакупкаКодБюджетнойКлассификации  = ВыборкаСчетФактураОснование.ГосЗакупкаКодБюджетнойКлассификации;
		ГосЗакупкаКодЦели  = ВыборкаСчетФактураОснование.ГосЗакупкаКодЦели;
		ГосЗакупкаКазначействоКод  = ВыборкаСчетФактураОснование.ГосЗакупкаКазначействоКод;
		ГосЗакупкаКазначействоНаименование  = ВыборкаСчетФактураОснование.ГосЗакупкаКазначействоНаименование;
		
		ОснованиеУступкиНаименование  = ВыборкаСчетФактураОснование.ОснованиеУступкиНаименование;
		ОснованиеУступкиНомер  = ВыборкаСчетФактураОснование.ОснованиеУступкиНомер;
		ОснованиеУступкиДата  = ВыборкаСчетФактураОснование.ОснованиеУступкиДата;
		ОснованиеУступкиСведения  = ВыборкаСчетФактураОснование.ОснованиеУступкиСведения;
		ДатаНачалаПоставки  = ВыборкаСчетФактураОснование.ДатаНачалаПоставки;
		ДатаОкончанияПоставки  = ВыборкаСчетФактураОснование.ДатаОкончанияПоставки;
		Фактор  = ВыборкаСчетФактураОснование.Фактор;
		
		ДокументыПодтвержденияОтгрузки.Загрузить(ВыборкаСчетФактураОснование.ДокументыПодтвержденияОтгрузки.Выгрузить());
		
		КлиентЭДО.ЗаполнитьНомерДатуИсходногоДокумента(ЭтотОбъект, ВыборкаСчетФактураОснование);
		
	КонецЕсли;
	
	Если НЕ РезультатыЗапроса[1].Пустой() Тогда
		Товары.Загрузить(РезультатыЗапроса[1].Выгрузить());
		
		Если ВидОперации = Перечисления.ВидыОпераций.Корректировка Тогда
			
			Для Каждого СтрокаТаблицы Из Товары Цикл
				СтрокаТаблицы.КоличествоУпаковокДоКорректировки = СтрокаТаблицы.Количество;
				СтрокаТаблицы.ЦенаДоКорректировки               = СтрокаТаблицы.Цена;
				СтрокаТаблицы.СтавкаНДСДоКорректировки          = СтрокаТаблицы.СтавкаНДС;
				СтрокаТаблицы.СуммаДоКорректировки              = СтрокаТаблицы.Сумма;
				СтрокаТаблицы.СуммаНДСДоКорректировки           = СтрокаТаблицы.СуммаНДС;
				СтрокаТаблицы.СуммаСНДСДоКорректировки          = СтрокаТаблицы.СуммаСНДС;
				СтрокаТаблицы.СуммаАкцизаДоКорректировки        = СтрокаТаблицы.СуммаАкциза;
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли НЕ РезультатыЗапроса[2].Пустой() Тогда
		
		ВыборкаОснование = РезультатыЗапроса[2].Выбрать();
		Пока ВыборкаОснование.Следующий() Цикл
			
			Если НЕ ЗначениеЗаполнено(ВидОперации) Тогда
				ВидОперации = ВыборкаОснование.ВидОперации;
			ИначеЕсли ВидОперации <> ВыборкаОснование.ВидОперации Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументыОснования.Добавить();
			НоваяСтрока.ДокументОснование = ВыборкаОснование.Ссылка;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не РезультатыЗапроса[3].Пустой() Тогда
		КодыУпаковокМаркируемойПродукции.Загрузить(РезультатыЗапроса[3].Выгрузить());
	КонецЕсли;
	
	Корректировка = ВидОперации = Перечисления.ВидыОпераций.Корректировка;
	
	ИсправлениеКорректировки = ЗначениеЗаполнено(НомерИсправляемогоКорректировочногоДокумента)
		И ЗначениеЗаполнено(ДатаИсправляемогоКорректировочногоДокумента);
	
	Если Не РезультатыЗапроса[4].Пустой() Тогда
		
		СведенияРНПТ = РезультатыЗапроса[4].Выбрать();
		
		Пока СведенияРНПТ.Следующий() Цикл
			
			НоваяСтрока = СведенияПрослеживаемости.Добавить();
			НоваяСтрока.ИдентификаторСтроки = СведенияРНПТ.ИдентификаторСтроки;
			НоваяСтрока.РНПТ = СведенияРНПТ.РНПТ;
			НоваяСтрока.ЕдиницаИзмеренияПрослеживаемости = СведенияРНПТ.ЕдиницаИзмеренияПрослеживаемости;
			
			НоваяСтрока.КоличествоУпаковок = СведенияРНПТ.КоличествоУпаковок;
			НоваяСтрока.КоличествоПрослеживаемости = СведенияРНПТ.КоличествоПрослеживаемости;
			
			НоваяСтрока.СтоимостьБезНДС = СведенияРНПТ.СтоимостьБезНДС;
			
			Если Корректировка Тогда
				
				НоваяСтрока.КоличествоУпаковокДоКорректировки = СведенияРНПТ.КоличествоУпаковок;
				НоваяСтрока.КоличествоПрослеживаемостиДоКорректировки = СведенияРНПТ.КоличествоПрослеживаемости;
				НоваяСтрока.СтоимостьБезНДСДоКорректировки = СведенияРНПТ.СтоимостьБезНДС;
				
			ИначеЕсли ИсправлениеКорректировки Тогда
				
				НоваяСтрока.КоличествоУпаковокДоКорректировки = СведенияРНПТ.КоличествоУпаковокДоКорректировки;
				НоваяСтрока.КоличествоПрослеживаемостиДоКорректировки = СведенияРНПТ.КоличествоПрослеживаемостиДоКорректировки;
				НоваяСтрока.СтоимостьБезНДСДоКорректировки = СведенияРНПТ.СтоимостьБезНДСДоКорректировки;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;	
	
	Если ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		ЗаполнитьДанныеПоАСЧФИзОснования(СчетФактураОснование);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПоАСЧФИзОснования(СчетФактураОснование)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СведенияОВыданныхСчетахФактурахНаАванс.НомерАвансовойСчетФактуры КАК НомерАвансовойСчетФактуры,
		|	СведенияОВыданныхСчетахФактурахНаАванс.ДатаАвансовойСчетФактуры КАК ДатаАвансовойСчетФактуры,
		|	СведенияОВыданныхСчетахФактурахНаАванс.НомерИсправительногоДокумента КАК НомерИсправительногоДокумента,
		|	СведенияОВыданныхСчетахФактурахНаАванс.ДатаИсправительногоДокумента КАК ДатаИсправительногоДокумента
		|ИЗ
		|	Документ.СчетФактураВыданный.СведенияОВыданныхСчетахФактурахНаАванс КАК СведенияОВыданныхСчетахФактурахНаАванс
		|ГДЕ
		|	СведенияОВыданныхСчетахФактурахНаАванс.Ссылка = &СчетФактураОснование";
	
	Запрос.УстановитьПараметр("СчетФактураОснование", СчетФактураОснование);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		СведенияОВыданныхСчетахФактурахНаАванс.Загрузить(РезультатЗапроса.Выгрузить());
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли