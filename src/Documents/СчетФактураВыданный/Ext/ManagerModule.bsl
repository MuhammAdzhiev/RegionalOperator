// Параметры:
// Команды - См. ПодключаемыеКомандыПереопределяемый.ПриОпределенииКомандПодключенныхКОбъекту.Команды
Процедура ЗаполнитьКомандыВводаНаОсновании(Команды) Экспорт
	
	ОписаниеТипаТекущегоОбъекта = Новый ОписаниеТипов("ДокументСсылка.СчетФактураВыданный");
	
	НоваяКоманда = Команды.Добавить();
	НоваяКоманда.Порядок = 1;
	НоваяКоманда.Идентификатор = "СоздатьНаОснованииИсправление";
	НоваяКоманда.Представление = НСтр("ru = 'Исправление'");
	НоваяКоманда.Обработчик = "КлиентЭДОКлиент.СоздатьНаОснованииИсправлениеКоманда";
	НоваяКоманда.ТипПараметра = ОписаниеТипаТекущегоОбъекта;
	
	НоваяКоманда = Команды.Добавить();
	НоваяКоманда.Порядок = 2;
	НоваяКоманда.Идентификатор = "СоздатьНаОснованииКорректировку";
	НоваяКоманда.Представление = НСтр("ru = 'Корректировка'");
	НоваяКоманда.Обработчик = "КлиентЭДОКлиент.СоздатьНаОснованииКорректировкуКоманда";
	НоваяКоманда.ТипПараметра = ОписаниеТипаТекущегоОбъекта;
	
КонецПроцедуры

// Параметры:
//  ДокументОснование - ДокументСсылка.РеализацияТоваровУслуг,ДокументСсылка.СчетФактураВыданный
// 
// Возвращаемое значение:
//  ДокументСсылка.СчетФактураВыданный
Функция СоздатьСчетФактуруПоДокументуОснования(ДокументОснование) Экспорт
	
	ДокументОбъект = СоздатьДокумент();
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.Заполнить(ДокументОснование);
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат ДокументОбъект.Ссылка;
	
КонецФункции

// Параметры:
//  СчетФактура - ДокументСсылка.СчетФактураВыданный
//  ДокументОснование - ДокументСсылка.РеализацияТоваровУслуг,ДокументСсылка.СчетФактураВыданный
Процедура ОбновитьСчетФактуруПоДокументуОснования(СчетФактура, ДокументОснование) Экспорт
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Документ.СчетФактураВыданный");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", СчетФактура);
	
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();

		ДокументОбъект = СчетФактура.ПолучитьОбъект();
		ДокументОбъект.Заполнить(ДокументОснование);
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти // СлужебныйПрограммныйИнтерфейс

