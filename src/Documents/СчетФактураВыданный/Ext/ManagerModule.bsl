Функция ДанныеКОбработкеДляПереходаНаНовуюВерсию_ЗаполнитьИдентификаторСтроки() 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СчетФактураВыданныйТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный.Товары КАК СчетФактураВыданныйТовары
	|ГДЕ
	|	(СчетФактураВыданныйТовары.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ИЛИ СчетФактураВыданныйТовары.ИдентификаторСтроки = """")
	|
	|СГРУППИРОВАТЬ ПО
	|	СчетФактураВыданныйТовары.Ссылка
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(СчетФактураВыданныйТовары.ИдентификаторСтроки) = """"";
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьДанные_ЗаполнитьИдентификаторСтроки(Объект, Записать) 
	
	НужноЗаполнитьИдентификатор = Истина;
	Для Каждого СтрокаТоваров Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТоваров.ИдентификаторСтроки) Тогда
			НужноЗаполнитьИдентификатор = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НужноЗаполнитьИдентификатор Тогда
		Записать = Истина;
		Для Каждого СтрокаТоваров Из Объект.Товары Цикл
			Если Не ЗначениеЗаполнено(СтрокаТоваров.ИдентификаторСтроки) Тогда
				КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(СтрокаТоваров);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


Функция ДанныеКОбработкеДляПереходаНаНовуюВерсию_ЗаполнитьСтавкуНДСДоКорректировки() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный.Товары КАК Товары
	|ГДЕ
	|	Товары.КоличествоУпаковокДоКорректировки <> 0
	|	И Товары.СтавкаНДСДоКорректировки = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)
	|	И Товары.СтавкаНДС <> ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)";
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьДанные_ЗаполнитьСтавкуНДСДоКорректировки(Объект, Записать) 
	
	Для каждого СтрокаТовара Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТовара.КоличествоУпаковокДоКорректировки)
			И ЗначениеЗаполнено(СтрокаТовара.СтавкаНДС)
			И Не ЗначениеЗаполнено(СтрокаТовара.СтавкаНДСДоКорректировки) Тогда
			СтрокаТовара.СтавкаНДСДоКорректировки = СтрокаТовара.СтавкаНДС;
			Записать = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#Область Маркировка

Функция ТекстЗапросаДанныхМаркировки(ЗаполнитьДанныеШтрихкодовДляУКДДо = Ложь)

	ТекстЗапроса = "ВЫБРАТЬ
	|	СчетФактураВыданныйДокументыОснования.ДокументОснование КАК ДокументОснование,
	|	СчетФактураВыданныйДокументыОснования.Ссылка            КАК Ссылка
	|ПОМЕСТИТЬ ТаблицаОснований
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|ГДЕ
	|	СчетФактураВыданныйДокументыОснования.Ссылка В (&Ссылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаШтрихкодыУпаковок.ШтрихкодУпаковки КАК Штрихкод,
	|	ТаблицаОснований.Ссылка              КАК Ссылка
	|ИЗ 
	|	ТаблицаОснований КАК ТаблицаОснований
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ШтрихкодыУпаковок КАК ТаблицаШтрихкодыУпаковок
	|		ПО ТаблицаОснований.ДокументОснование = ТаблицаШтрихкодыУпаковок.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтгрузкаТоваровИСМП КАК ДокументыПрямогоОбмена
	|		ПО ТаблицаШтрихкодыУпаковок.Ссылка = ДокументыПрямогоОбмена.ДокументОснование
	|		И НЕ ДокументыПрямогоОбмена.ПометкаУдаления
	|ГДЕ
	|	ДокументыПрямогоОбмена.Ссылка ЕСТЬ NULL
	|	И %ВидОперации
	|";
	
	Если ЗаполнитьДанныеШтрихкодовДляУКДДо Тогда
		
		ТекстЗапроса = ТекстЗапроса
			+ ОбщегоНазначения.РазделительПакетаЗапросов()
			+ "ВЫБРАТЬ
			|	ТаблицаШтрихкодыУпаковокДо.ШтрихкодУпаковки КАК Штрихкод,
			|	ТаблицаОснований.Ссылка             КАК Ссылка
			|ИЗ
			|	ТаблицаОснований КАК ТаблицаОснований
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК ТаблицаРеализаций
			|		ПО ТаблицаОснований.ДокументОснование = ТаблицаРеализаций.Ссылка
			|		И %ВидОперации
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ШтрихкодыУпаковок КАК ТаблицаШтрихкодыУпаковокДо
			|		ПО ТаблицаРеализаций.ДокументОснование = ТаблицаШтрихкодыУпаковокДо.Ссылка
			|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтгрузкаТоваровИСМП КАК ДокументыПрямогоОбмена
			|		ПО ТаблицаШтрихкодыУпаковокДо.Ссылка = ДокументыПрямогоОбмена.ДокументОснование
			|ГДЕ
			|	ДокументыПрямогоОбмена.Ссылка ЕСТЬ NULL
			|";
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

// Возвращает сумму НДС документа по документу основанию.
// 
// Параметры:
//  Ссылка - ДокументСсылка.СчетФактураВыданный
// 
// Возвращаемое значение:
//  Число
Функция ПолучитьСуммуНДСДокумента(Ссылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(РТУТовары.СуммаНДС), 0) КАК СуммаНДС
		|ИЗ
		|	Документ.СчетФактураВыданный.ДокументыОснования КАК СЧФОснования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РТУТовары
		|		ПО СЧФОснования.ДокументОснование = РТУТовары.Ссылка
		|			И (СЧФОснования.ДокументОснование ССЫЛКА Документ.РеализацияТоваровУслуг)
		|ГДЕ
		|	СЧФОснования.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();
	
	Результат = ВыборкаДетальныеЗаписи.СуммаНДС;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли