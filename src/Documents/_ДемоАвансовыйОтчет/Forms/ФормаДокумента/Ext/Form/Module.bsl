#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПересчитатьТовары(Знач ИзмененноеПоле)
	
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИзмененноеПоле = "Количество" Или ИзмененноеПоле = "Цена" Тогда
		СтрокаТаблицы.Сумма = СтрокаТаблицы.Количество * СтрокаТаблицы.Цена;
		
		ПересчитатьСуммуСУчетомНДС(СтрокаТаблицы);
	ИначеЕсли ИзмененноеПоле = "Сумма" Тогда
		Если СтрокаТаблицы.Количество <> 0 Тогда
			СтрокаТаблицы.Цена = СтрокаТаблицы.Сумма / СтрокаТаблицы.Количество;
		КонецЕсли;
		
		ПересчитатьСуммуСУчетомНДС(СтрокаТаблицы);
	ИначеЕсли ИзмененноеПоле = "СтавкаНДС" Тогда
		ПересчитатьСуммуСУчетомНДС(СтрокаТаблицы);
	ИначеЕсли ИзмененноеПоле = "СуммаНДС" Тогда
		СтрокаТаблицы.СуммаСНДС = СтрокаТаблицы.Сумма + СтрокаТаблицы.СуммаНДС;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуСУчетомНДС(СтрокаТаблицы)
	
	ЗначениеСтавки = КлиентЭДОКлиентСервер.ПолучитьСтавкуНДСЧислом(СтрокаТаблицы.СтавкаНДС);
	
	Если Объект.ЦенаВключаетНДС Тогда
		СтрокаТаблицы.СуммаНДС  = СтрокаТаблицы.Сумма - СтрокаТаблицы.Сумма / (1 + ЗначениеСтавки);
		СтрокаТаблицы.СуммаСНДС = СтрокаТаблицы.Сумма;
	Иначе
		СтрокаТаблицы.СуммаНДС  = СтрокаТаблицы.Сумма * ЗначениеСтавки;
		СтрокаТаблицы.СуммаСНДС = СтрокаТаблицы.Сумма + СтрокаТаблицы.СуммаНДС;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
