#Область СлужебныеПроцедурыИФункции

Функция ДанныеАвансовогоОтчета(Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	_ДемоАвансовыйОтчетВыданныеАвансы.ДокументАванса КАК ДокументАванса,
		|	_ДемоАвансовыйОтчетВыданныеАвансы.Сумма КАК Сумма
		|ИЗ
		|	Документ._ДемоАвансовыйОтчет.ВыданныеАвансы КАК _ДемоАвансовыйОтчетВыданныеАвансы
		|ГДЕ
		|	_ДемоАвансовыйОтчетВыданныеАвансы.Ссылка = &Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_ДемоАвансовыйОтчетТовары.НомерВходящегоДокумента КАК ДокументНомер,
		|	_ДемоАвансовыйОтчетТовары.ДатаВходящегоДокумента КАК ДокументДата,
		|	_ДемоАвансовыйОтчетТовары.СуммаСНДС КАК ПоОтчету,
		|	_ДемоАвансовыйОтчетТовары.СуммаСНДС КАК ПоУчету,
		|	_ДемоАвансовыйОтчетТовары.ПодтверждающийДокумент КАК НаименованиеРасхода
		|ИЗ
		|	Документ._ДемоАвансовыйОтчет.Товары КАК _ДемоАвансовыйОтчетТовары
		|ГДЕ
		|	_ДемоАвансовыйОтчетТовары.Ссылка = &Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_ДемоАвансовыйОтчет.Номер КАК НомерДокумента,
		|	_ДемоАвансовыйОтчет.Дата КАК ДатаДокумента,
		|	ПРЕДСТАВЛЕНИЕ(_ДемоАвансовыйОтчет.Организация) КАК ПредставлениеОрганизации,
		|	ПРЕДСТАВЛЕНИЕ(_ДемоАвансовыйОтчет.ПодотчетноеЛицо) КАК ПредставлениеПодотчетногоЛица,
		|	ПРЕДСТАВЛЕНИЕ(_ДемоАвансовыйОтчет.Ответственный) КАК Кассир
		|ИЗ
		|	Документ._ДемоАвансовыйОтчет КАК _ДемоАвансовыйОтчет
		|ГДЕ
		|	_ДемоАвансовыйОтчет.Ссылка = &Документ";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	
	Возврат Запрос.ВыполнитьПакет();

КонецФункции

Функция ДанныеМ4(Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	_ДемоАвансовыйОтчетТовары.НомерВходящегоДокумента КАК ДокументНомер,
		|	_ДемоАвансовыйОтчетТовары.ДатаВходящегоДокумента КАК ДокументДата,
		|	_ДемоАвансовыйОтчетТовары.Количество КАК Количество,
		|	_ДемоАвансовыйОтчетТовары.Цена КАК Цена,
		|	_ДемоАвансовыйОтчетТовары.Сумма КАК Сумма,
		|	_ДемоАвансовыйОтчетТовары.СуммаНДС КАК СуммаНДС,
		|	_ДемоАвансовыйОтчетТовары.СуммаСНДС - _ДемоАвансовыйОтчетТовары.СуммаНДС КАК СуммаБезНДС,
		|	_ДемоАвансовыйОтчетТовары.СуммаСНДС КАК СуммаСНДС,
		|	_ДемоАвансовыйОтчетТовары.ПодтверждающийДокумент КАК НаименованиеРасхода,
		|	_ДемоАвансовыйОтчетТовары.Товар КАК ТоварНаименование,
		|	_ДемоАвансовыйОтчетТовары.ЕдиницаИзмерения.Код КАК ЕдиницаИзмеренияКод,
		|	_ДемоАвансовыйОтчетТовары.ЕдиницаИзмерения.Наименование КАК ЕдиницаИзмеренияНаименование
		|ИЗ
		|	Документ._ДемоАвансовыйОтчет.Товары КАК _ДемоАвансовыйОтчетТовары
		|ГДЕ
		|	_ДемоАвансовыйОтчетТовары.Ссылка = &Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_ДемоАвансовыйОтчет.Номер КАК НомерДокумента,
		|	_ДемоАвансовыйОтчет.Дата КАК ДатаДокумента,
		|	ПРЕДСТАВЛЕНИЕ(_ДемоАвансовыйОтчет.Организация) КАК ПредставлениеОрганизации,
		|	ПРЕДСТАВЛЕНИЕ(_ДемоАвансовыйОтчет.ПодотчетноеЛицо) КАК ПредставлениеПодотчетногоЛица,
		|	ПРЕДСТАВЛЕНИЕ(_ДемоАвансовыйОтчет.Ответственный) КАК Ответственный
		|ИЗ
		|	Документ._ДемоАвансовыйОтчет КАК _ДемоАвансовыйОтчет
		|ГДЕ
		|	_ДемоАвансовыйОтчет.Ссылка = &Документ";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	
	Возврат Запрос.ВыполнитьПакет();

КонецФункции

// Функция формирует табличный документ с печатной. 
//
// Возвращаемое значение:
//  Табличный документ - печатная форма накладной.
//
Функция ПечатьАвансовогоОтчета(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ._ДемоАвансовыйОтчет.ПФ_MXL_АвансовыйОтчет");
	
	ПервыйДокумент = Истина;
	
	Для Каждого Документ Из МассивОбъектов Цикл
		
		Если НЕ ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ДанныеДокумента = ДанныеАвансовогоОтчета(Документ);
		
		СредстваВыданные = ДанныеДокумента[0].Выгрузить();
		СредстваИзрасходованные = ДанныеДокумента[1].Выгрузить();
		ШапкаДокумента = ДанныеДокумента[2].Выгрузить()[0];
		
		ОбластьМакета = Макет.ПолучитьОбласть("Титул");
		
		ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ШапкаДокумента);
		ОбластьМакета.Параметры.Израсходовано = СредстваИзрасходованные.Итог("ПоОтчету");
		ОбластьМакета.Параметры.ИтогоПолучено = СредстваВыданные.Итог("Сумма");
		
		Остаток = СредстваВыданные.Итог("Сумма") - СредстваИзрасходованные.Итог("ПоОтчету");
		
		Если Остаток > 0 Тогда
			ОбластьМакета.Параметры.КонечныйОстаток = Остаток;
		ИначеЕсли Остаток < 0 Тогда
			ОбластьМакета.Параметры.КонечныйОстаток = -Остаток; 
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьМакета);
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		// Выводим табличные части
		ОбластьМакета = Макет.ПолучитьОбласть("Строка");
		НомерСтроки   = 1;
		
		Для Каждого СтрокаРасхода Из СредстваИзрасходованные Цикл
			
			ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, СтрокаРасхода);
			ОбластьМакета.Параметры.НомерСтроки = НомерСтроки;
			
			
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла;
		
		ИтогоПоОтчету = СредстваИзрасходованные.Итог("ПоОтчету");;
		
		// Выводим подвал авансового отчета
		ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
		
		ОбластьМакета.Параметры.ИтогоПоОтчету = ИтогоПоОтчету;
		ОбластьМакета.Параметры.ИтогоПоУчету  = ИтогоПоОтчету;
		
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Документ);

	КонецЦикла;

	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьМ4(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ._ДемоАвансовыйОтчет.ПФ_MXL_М4");
	
	ПервыйДокумент = Истина;
	
	Для Каждого Документ Из МассивОбъектов Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ДанныеДокумента = ДанныеМ4(Документ);
		
		СредстваИзрасходованные = ДанныеДокумента[0].Выгрузить();
		ШапкаДокумента = ДанныеДокумента[1].Выгрузить()[0];
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, ШапкаДокумента);	
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		// Выводим табличные части
		ОбластьМакета = Макет.ПолучитьОбласть("Строка");
		
		Для Каждого СтрокаРасхода Из СредстваИзрасходованные Цикл
			
			ОбластьМакета.Параметры.ТоварНаименование = СтрокаРасхода.ТоварНаименование;
			ОбластьМакета.Параметры.ЕдиницаИзмеренияКод = СтрокаРасхода.ЕдиницаИзмеренияКод;
			ОбластьМакета.Параметры.ЕдиницаИзмеренияНаименование = СтрокаРасхода.ЕдиницаИзмеренияНаименование; 
			ОбластьМакета.Параметры.КоличествоПоДокументу = СтрокаРасхода.Количество;
			ОбластьМакета.Параметры.КоличествоПринято = СтрокаРасхода.Количество;
			ОбластьМакета.Параметры.Цена = СтрокаРасхода.Цена;
			ОбластьМакета.Параметры.СуммаБезНДС  = СтрокаРасхода.СуммаБезНДС;
			ОбластьМакета.Параметры.СуммаНДС = СтрокаРасхода.СуммаНДС;
			ОбластьМакета.Параметры.ВсегоСНДС = СтрокаРасхода.СуммаСНДС;
			ТабличныйДокумент.Вывести(ОбластьМакета);
			
		КонецЦикла;
		

		ОбластьМакета = Макет.ПолучитьОбласть("Итого");

		ОбластьМакета.Параметры.ИтогоКоличествоПринято = СредстваИзрасходованные.Итог("Количество");
		ОбластьМакета.Параметры.ИтогоСуммаБезНДС = СредстваИзрасходованные.Итог("СуммаБезНДС");	
		ОбластьМакета.Параметры.ИтогоСуммаНДС = СредстваИзрасходованные.Итог("СуммаНДС");
		ОбластьМакета.Параметры.ИтогоВсегоСНДС =СредстваИзрасходованные.Итог("СуммаСНДС");

		ТабличныйДокумент.Вывести(ОбластьМакета);
		

		ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
		ОбластьМакета.Параметры.ПринялФИО = ШапкаДокумента.Ответственный;
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
			НомерСтрокиНачало, ОбъектыПечати, Документ);

	КонецЦикла;

	Возврат ТабличныйДокумент;
	
КонецФункции


#КонецОбласти

#КонецЕсли
