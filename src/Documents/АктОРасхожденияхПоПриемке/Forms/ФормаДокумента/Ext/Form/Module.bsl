КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТоварыПоДокументу(Знач ИзмененноеПоле)
	
	СтрокаТовара = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоэффициентСтавкиНДС = КлиентЭДОКлиентСервер.ПолучитьСтавкуНДСЧислом(СтрокаТовара.СтавкаНДСПоДокументу);
	Если Объект.ОблагаетсяНДСУПокупателя Тогда
		КоэффициентСтавкиНДС = 0;
	КонецЕсли;
	
	Если ИзмененноеПоле = "Количество" ИЛИ ИзмененноеПоле = "Цена" Тогда
		
		СтрокаТовара.СуммаПоДокументу = СтрокаТовара.КоличествоПоДокументу * СтрокаТовара.ЦенаПоДокументу;
		СтрокаТовара.СуммаНДСПоДокументу = СтрокаТовара.СуммаПоДокументу * КоэффициентСтавкиНДС;
		СтрокаТовара.СуммаСНДСПоДокументу = СтрокаТовара.СуммаПоДокументу + СтрокаТовара.СуммаНДСПоДокументу;
		
		Если ИзмененноеПоле = "Цена" Тогда
			
			СтрокаТовара.Сумма = СтрокаТовара.Количество * СтрокаТовара.ЦенаПоДокументу;
			СтрокаТовара.СуммаНДС = СтрокаТовара.Сумма * КоэффициентСтавкиНДС;
			СтрокаТовара.СуммаСНДС = СтрокаТовара.Сумма + СтрокаТовара.СуммаНДС;
			
		КонецЕсли;
		
	ИначеЕсли ИзмененноеПоле = "СтавкаНДС" Тогда
		
		СтрокаТовара.СуммаНДСПоДокументу = СтрокаТовара.СуммаПоДокументу * КоэффициентСтавкиНДС;
		СтрокаТовара.СуммаСНДСПоДокументу = СтрокаТовара.СуммаПоДокументу + СтрокаТовара.СуммаНДСПоДокументу;
		
		СтрокаТовара.СуммаНДС = СтрокаТовара.Сумма * КоэффициентСтавкиНДС;
		СтрокаТовара.СуммаСНДС = СтрокаТовара.Сумма + СтрокаТовара.СуммаНДС;
		
	ИначеЕсли ИзмененноеПоле = "Сумма" Тогда
		
		Если СтрокаТовара.КоличествоПоДокументу = 0 Тогда
			СтрокаТовара.ЦенаПоДокументу = 0;
		Иначе
			СтрокаТовара.ЦенаПоДокументу = СтрокаТовара.СуммаПоДокументу / СтрокаТовара.КоличествоПоДокументу;
		КонецЕсли;
		
		СтрокаТовара.СуммаНДСПоДокументу = СтрокаТовара.СуммаПоДокументу * КоэффициентСтавкиНДС;
		СтрокаТовара.СуммаСНДСПоДокументу = СтрокаТовара.СуммаПоДокументу + СтрокаТовара.СуммаНДСПоДокументу;
		
		СтрокаТовара.Сумма = СтрокаТовара.Количество * СтрокаТовара.ЦенаПоДокументу;
		СтрокаТовара.СуммаНДС = СтрокаТовара.Сумма * КоэффициентСтавкиНДС;
		СтрокаТовара.СуммаСНДС = СтрокаТовара.Сумма + СтрокаТовара.СуммаНДС;
		
	ИначеЕсли ИзмененноеПоле = "СуммаНДС" Тогда
		
		СтрокаТовара.СуммаСНДСПоДокументу = СтрокаТовара.СуммаПоДокументу + СтрокаТовара.СуммаНДСПоДокументу;
		
	КонецЕсли;
	
	ПересчитатьТоварыПоДоговору(ИзмененноеПоле);
	
	ПересчитатьРасхожденияВСтрокеТоваров(СтрокаТовара);
		
	ПересчитатьИтоги(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТоварыПоФакту(Знач ИзмененноеПоле)
	
	СтрокаТовара = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Суммовые показатели факта считаются по цене и ставке НДС документа.
	
	КоэффициентСтавкиНДС = КлиентЭДОКлиентСервер.ПолучитьСтавкуНДСЧислом(СтрокаТовара.СтавкаНДС);
	
	Если ИзмененноеПоле = "Количество" Или ИзмененноеПоле = "Цена" Тогда
		
		СтрокаТовара.Сумма = СтрокаТовара.Количество * СтрокаТовара.Цена;
		СтрокаТовара.СуммаНДС = СтрокаТовара.Сумма * КоэффициентСтавкиНДС;
		СтрокаТовара.СуммаСНДС = СтрокаТовара.Сумма + СтрокаТовара.СуммаНДС;
		
	ИначеЕсли ИзмененноеПоле = "Сумма" Или ИзмененноеПоле = "СтавкаНДС" Тогда
		
		СтрокаТовара.СуммаНДС = СтрокаТовара.Сумма * КоэффициентСтавкиНДС;
		СтрокаТовара.СуммаСНДС = СтрокаТовара.Сумма + СтрокаТовара.СуммаНДС;
		
	ИначеЕсли ИзмененноеПоле = "СуммаНДС" Тогда
		
		СтрокаТовара.СуммаСНДС = СтрокаТовара.Сумма + СтрокаТовара.СуммаНДС;
		
	КонецЕсли;
	
	ПересчитатьТоварыПоДоговору(ИзмененноеПоле);
	
	ПересчитатьРасхожденияВСтрокеТоваров(СтрокаТовара);
		
	ПересчитатьИтоги(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТоварыПоДоговору(Знач ИзмененноеПоле)
	
	СтрокаТовара = Элементы.Товары.ТекущиеДанные;
	Если СтрокаТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Ценовые отклонения по договору считаются по ставке НДС документа.
	
	КоэффициентСтавкиНДС = КлиентЭДОКлиентСервер.ПолучитьСтавкуНДСЧислом(СтрокаТовара.СтавкаНДСПоДокументу);
	
	Если ИзмененноеПоле = "Количество" 
		Или ИзмененноеПоле = "Цена"
		Или ИзмененноеПоле = "СтавкаНДС" Тогда
		
		Сумма = СтрокаТовара.Количество * СтрокаТовара.ЦенаПоДоговору;
		СтрокаТовара.СуммаНДСПоДоговору = Сумма * КоэффициентСтавкиНДС;
		СтрокаТовара.СуммаСНДСПоДоговору = Сумма + СтрокаТовара.СуммаНДСПоДоговору;
				
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыНоменклатуры(Знач СсылкаНаОбъект, Знач Реквизиты);
	
	Возврат КлиентЭДО.РеквизитыНоменклатурыПриИзменении(СсылкаНаОбъект, Реквизиты);
	
КонецФункции

&НаСервере
Процедура ОблагаетсяНДСУПокупателяПриИзмененииНаСервере()
	
	УстановитьВидимостьПолейНДС();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСведенияОГрузеИзТабличнойЧастиТоварыЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Объект.СведенияОГрузе.Очистить();
	Для Каждого Строка Из Объект.Товары Цикл
		НоваяСтрока = Объект.СведенияОГрузе.Добавить();
		НоваяСтрока.Номенклатура = ?(ЗначениеЗаполнено(Строка.Номенклатура), Строка.Номенклатура, 
			ПредставлениеНоменклатурыПоставщика(Строка.НоменклатураКонтрагента));
		НоваяСтрока.ЕдиницаИзмерения = Строка.ЕдиницаИзмерения;
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииНоменклатуры(ТребуетсяПодобратьНоменклатуруКонтрагента)
	
	ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	
	// ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	Если ТребуетсяПодобратьНоменклатуруКонтрагента Тогда
		СопоставлениеНоменклатурыКонтрагентовКЭДОКлиент.ПодобратьНоменклатуруКонтрагента(Объект.Контрагент, ТекущаяСтрока);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	
	ТоварыНоменклатураПриИзмененииНаСервере();
	
КонецПроцедуры

#КонецОбласти

