&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ДанныеСтроки = Объект.Товары.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КолонкиОснования = "Номенклатура,Характеристика,ЕдиницаИзмерения";
	ИмяКолонки = Сред(Поле.Имя, 7); // Отбрасываем префикс "Товары" в имени элемента.
	
	Если ДанныеСтроки.ЗаполненоПоОснованию И СтрНайти(КолонкиОснования, ИмяКолонки) <> 0 Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(,ДанныеСтроки[ИмяКолонки]);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Копирование И ТекущиеДанные.ЗаполненоПоОснованию Тогда
		
		Отказ = Истина;
		НоваяСтрока = Объект.Товары.Добавить();
		НеКопируемыеДанные = "КоличествоПоДокументу,СуммаПоДокументу,СуммаНДСПоДокументу,СуммаСНДСПоДокументу,ИдентификаторСтроки";
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные,, НеКопируемыеДанные);
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		НоваяСтрока.ЗаполненоПоОснованию = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

