&НаСервере
Процедура ЗаполнитьПредставлениеОснования()
	
	ЧастиПредставления = Новый Массив;
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		
		ЧастиПредставления.Добавить(Новый ФорматированнаяСтрока(
			Строка(Объект.ДокументОснование),,,,ПолучитьНавигационнуюСсылку(Объект.ДокументОснование)));
			
		ЧастиПредставления.Добавить("   ");
		
		ЧастиПредставления.Добавить(Новый ФорматированнаяСтрока(
			НСтр("ru = 'Изменить'"),,,,"ИзменитьДокументОснование"));
		
	Иначе
		
		ЧастиПредставления.Добавить(Новый ФорматированнаяСтрока(
			НСтр("ru='<Подбор>'"),,,,"ИзменитьДокументОснование"));
		
	КонецЕсли;
	
	ДокументОснованиеПредставление = Новый ФорматированнаяСтрока(ЧастиПредставления);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьДокументОснование()
	
	// 1. Показываем вопрос о заполнении по основанию.
	// См. ПоказатьВопросОЗаполненииПоОснованию.
	// См. ОбработатьВопросОЗаполненииПоОснованию.
	
	// 2. Открываем форму выбора основания.
	// См. ПоказатьВыборДокументаОснования.
	// См. ОбработатьВыборДокументаОснования.
	
	// 3. Заполняем документ по основанию.
	// См. ЗаполнитьПоДокументуОснованию.
	
	ПоказатьВопросОЗаполненииПоОснованию();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросОЗаполненииПоОснованию()
	
	ОбработкаОтвета = Новый ОписаниеОповещения("ОбработатьВопросОЗаполненииПоОснованию", ЭтотОбъект);
	
	ТекстВопроса = НСтр("ru = 'Документ будет перезаполнен данными документа основания. Продолжить?'");
	
	ПоказатьВопрос(ОбработкаОтвета, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВопросОЗаполненииПоОснованию(Знач Ответ, Знач ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		ПоказатьВыборДокументаОснования();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВыборДокументаОснования()
	
	ОбработкаВыбора = Новый ОписаниеОповещения("ОбработатьВыборДокументаОснования", ЭтотОбъект);
	
	ОткрытьФорму("Документ.ПоступлениеТоваровУслуг.ФормаВыбора"
		,,,,,, ОбработкаВыбора, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборДокументаОснования(Знач ДокументОснование, Знач ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		
		ЗаполнитьПоДокументуОснованию(ДокументОснование);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументуОснованию(Знач ДокументОснование)
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Заполнить(ДокументОснование);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	Модифицированность = Истина;
	
	ЗаполнитьПредставлениеОснования();
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСФормой

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// Запрещаем менять данные товаров, заполненных по основанию.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыНоменклатура");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыХарактеристика");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыЕдиницаИзмерения");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыНоменклатураКонтрагента");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыКоличествоПоДокументу");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыЦенаПоДокументу");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСуммаПоДокументу");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСтавкаНДСПоДокументу");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСуммаНДСПоДокументу");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСуммаСНДСПоДокументу");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		"Объект.Товары.ЗаполненоПоОснованию", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Запрещаем менять данные по документу для строк, добавленных не из основания.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыКоличествоПоДокументу");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыЦенаПоДокументу");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСуммаПоДокументу");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСтавкаНДСПоДокументу");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСуммаНДСПоДокументу");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСуммаСНДСПоДокументу");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		"Объект.ДокументОснование", ВидСравненияКомпоновкиДанных.Заполнено);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		"Объект.Товары.ЗаполненоПоОснованию", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Условное оформление характеристик.
	КлиентЭДО.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект);
	
	// Условное оформление полей-надписей.
	КлиентЭДО.УстановитьУсловноеОформлениеНадписейАктаОРасхождениях(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФорму()
	
	КлиентЭДО.ЗаполнитьРеквизитыМаркировкиАктаОРасхождении(Объект);
	УстановитьВидимостьИсправления();
	ЗаполнитьПризнакИспользованияХарактеристик();
	ПересчитатьРасхождения();
	ПересчитатьРасхожденияСведенийОГрузе();
	ПересчитатьИтоги(ЭтотОбъект);
	
