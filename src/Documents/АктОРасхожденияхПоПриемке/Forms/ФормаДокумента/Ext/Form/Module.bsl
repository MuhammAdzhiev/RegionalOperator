Процедура УстановитьВидимостьИсправления()
	
	ЭтоИсправление = ЗначениеЗаполнено(Объект.НомерИсправления);
	
	Элементы.ИсправляемыйДокумент.Видимость = ЭтоИсправление;
	Элементы.НомерЭД.ТолькоПросмотр = ЭтоИсправление;
	Элементы.ГруппаНомерИсправления.Видимость = ЭтоИсправление;
	
