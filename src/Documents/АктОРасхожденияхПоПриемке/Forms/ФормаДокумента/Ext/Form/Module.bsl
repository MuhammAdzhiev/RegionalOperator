КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПризнакИспользованияХарактеристикВСтрокеТовара()
	
	СтрокаТовара = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	Если СтрокаТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияРеквизитов = РеквизитыНоменклатуры(СтрокаТовара.Номенклатура, "");
	Если ЗначенияРеквизитов.Свойство("ХарактеристикиИспользуются") Тогда
		СтрокаТовара.ХарактеристикиИспользуются = ЗначенияРеквизитов.ХарактеристикиИспользуются;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьРасхождения()
	
	Для каждого СтрокаТовара Из Объект.Товары Цикл
		
		ПересчитатьРасхожденияВСтрокеТоваров(СтрокаТовара);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста 
Процедура ПересчитатьРасхожденияВСтрокеТоваров(СтрокаТовара)
	
	НаборПолей = СтрРазделить("Количество,Цена,Сумма,СуммаНДС,СуммаСНДС",",");
	Для каждого Поле Из НаборПолей Цикл
		СтрокаТовара[Поле + "Расхождение"] = СтрокаТовара[Поле] - СтрокаТовара[Поле + "ПоДокументу"];
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьРасхожденияСведенийОГрузе()
	
	Для каждого СтрокаСведений Из Объект.СведенияОГрузе Цикл
		
		ПересчитатьРасхожденияВСтрокеСведенийОГрузе(СтрокаСведений, "МассаБрутто");
		ПересчитатьРасхожденияВСтрокеСведенийОГрузе(СтрокаСведений, "МассаНетто");
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста 
Процедура ПересчитатьРасхожденияВСтрокеСведенийОГрузе(СтрокаСведений, Поле)
	
	СтрокаСведений[Поле + "Расхождение"] = СтрокаСведений[Поле] - СтрокаСведений[Поле + "ПоДокументу"];
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста 
Процедура ПересчитатьИтоги(Форма)
	
	Расхождения = 0;
	Излишки = 0;
	Недостачи = 0;
	
	Для каждого СтрокаТовара Из Форма.Объект.Товары Цикл
		
		Расхождения = Расхождения + СтрокаТовара.СуммаСНДСРасхождение;
		Если СтрокаТовара.СуммаСНДСРасхождение > 0 Тогда
			Излишки = Излишки + СтрокаТовара.СуммаСНДСРасхождение;
		Иначе
			Недостачи = Недостачи + (-1) * СтрокаТовара.СуммаСНДСРасхождение;
		КонецЕсли;
		
	КонецЦикла;
	
	Форма.Расхождения = Расхождения;
	Форма.Излишки = Излишки;
	Форма.Недостачи = Недостачи;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолейНДС()
	
	ВидимостьНДС = НЕ Объект.ОблагаетсяНДСУПокупателя;
	Элементы.ТоварыСтавкаНДСПоДокументу.Видимость = ВидимостьНДС;
	
	Элементы.ТоварыСуммаНДСПоДокументу.Видимость = ВидимостьНДС;
	Элементы.ТоварыСуммаНДС.Видимость  = ВидимостьНДС;
	Элементы.ТоварыСуммаНДСРасхождение.Видимость = ВидимостьНДС;
	
	Элементы.ТоварыСуммаСНДСПоДокументу.Видимость = ВидимостьНДС;
	Элементы.ТоварыСуммаСНДС.Видимость  = ВидимостьНДС;
	Элементы.ТоварыСуммаСНДСРасхождение.Видимость = ВидимостьНДС;
	
	Элементы.ТоварыСуммаНДСПоДоговору.Видимость = ВидимостьНДС;
	Элементы.ТоварыСуммаСНДСПоДоговору.Заголовок = ?(ВидимостьНДС,
		НСтр("ru = 'Сумма с НДС'"), НСтр("ru = 'Сумма'"));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьДоступностьСодержанияДополнительныхСведений(СодержаниеДопСведений, ФормированиеДопСведений)
	
	ВидимостьСодержанияДопСведений =
		(ФормированиеДопСведений <>
			 ПредопределенноеЗначение("Перечисление.ДополнительныеСведенияАктаОРасхождениях.НеФормируются"));
	СодержаниеДопСведений.Видимость	= ВидимостьСодержанияДопСведений;
	
	Если ВидимостьСодержанияДопСведений Тогда
		
		ДопСведенияЗаполняемыеПокупателем = Новый Массив;
		ДопСведенияЗаполняемыеПокупателем.Добавить(ПредопределенноеЗначение(
			"Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПокупателемФормируютсяДопСведенияОбОприходованииИмЦенностей"));
		ДопСведенияЗаполняемыеПокупателем.Добавить(ПредопределенноеЗначение(
			"Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПокупателемФормируютсяДопСведенияОУтвержденииДокумента"));
		ДопСведенияЗаполняемыеПокупателем.Добавить(ПредопределенноеЗначение(
			"Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПокупателемФормируютсяДопСведенияИные"));
		
		НайденноеЗначение = ДопСведенияЗаполняемыеПокупателем.Найти(ФормированиеДопСведений);
		СодержаниеДопСведений.АвтоОтметкаНезаполненного = (НайденноеЗначение <> Неопределено);
		СодержаниеДопСведений.Доступность = (НайденноеЗначение <> Неопределено);		
		
	КонецЕсли;	

КонецПроцедуры	

#КонецОбласти

