//  
////////////////////////////////////////////////////////////////////////////////

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

#Область СтандартныеПодсистемы

#Область УправлениеДоступом

// СтандартныеПодсистемы.УправлениеДоступом
// 
// Параметры:
//  Таблица - см. УправлениеДоступом.ТаблицаНаборыЗначенийДоступа
//
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	Если ЗначениеЗаполнено(Организация) Тогда
		Строка = Таблица.Добавить();
		Строка.ЗначениеДоступа = Организация;
	Иначе
		Строка = Таблица.Добавить();
		Строка.ЗначениеДоступа = Перечисления.ДополнительныеЗначенияДоступа.ДоступРазрешен;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(ФормированиеДополнительныхСведений)
		И ФормированиеДополнительныхСведений <> Перечисления.ДополнительныеСведенияАктаОРасхождениях.НеФормируются Тогда
		
		ДопСведенияЗаполняемыеПокупателем = Новый Массив;
		ДопСведенияЗаполняемыеПокупателем.Добавить(ПредопределенноеЗначение(
			"Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПокупателемФормируютсяДопСведенияОбОприходованииИмЦенностей"));
		ДопСведенияЗаполняемыеПокупателем.Добавить(ПредопределенноеЗначение(
			"Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПокупателемФормируютсяДопСведенияОУтвержденииДокумента"));
		ДопСведенияЗаполняемыеПокупателем.Добавить(ПредопределенноеЗначение(
			"Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПокупателемФормируютсяДопСведенияИные"));
	
		НайденноеЗначение = ДопСведенияЗаполняемыеПокупателем.Найти(ФормированиеДополнительныхСведений);
		
		Если НайденноеЗначение <> Неопределено Тогда
			
			ПроверяемыеРеквизиты.Добавить("СодержаниеДополнительныхСведений");
		
		КонецЕсли;
		
	КонецЕсли;
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("Объект", ЭтотОбъект);
	ПараметрыПроверки.Вставить("МассивНепроверяемыхРеквизитов", МассивНепроверяемыхРеквизитов);
	КлиентЭДО.ПроверитьЗаполнениеХарактеристик(ПараметрыПроверки, Отказ);
	
	Если ЗначениеЗаполнено(МассивНепроверяемыхРеквизитов) Тогда
		ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	УстановитьПредставлениеНомера();
	УстановитьДатуЭД();
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ЭлектронноеВзаимодействиеКЭДО.ПередЗаписьюОснованияЭлектронногоДокумента(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	
	УстановитьВидДокумента();
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("Основание") И ДанныеЗаполнения.Свойство("ВидОперации") Тогда
		
		Если ДанныеЗаполнения.ВидОперации = Перечисления.ВидыОпераций.Исправление 
			И ТипЗнч(ДанныеЗаполнения.Основание) = Тип("ДокументСсылка.АктОРасхожденияхПоПриемке") Тогда
			
			ЗаполнитьИсправление(ДанныеЗаполнения.Основание);
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.АктОРасхожденияхПоПриемке") Тогда
		
		ЗаполнитьИсправление(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		
		ЗаполнитьПоПоступлению(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйДокументВходящийЭДО") Тогда
		
		ЗаполнитьПоЭД(ДанныеЗаполнения);
		
	КонецЕсли;
	
	ИнициализироватьДокумент();
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	НомерЭД = "";
	ПредставлениеНомера = "";
	
	ИнициализироватьДокумент();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьИсправление(Знач Основание)
	
	КопияОснования = Основание.Скопировать();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, КопияОснования);
	Товары.Загрузить(КопияОснования.Товары.Выгрузить());
	СертификатыСоответствия.Загрузить(КопияОснования.СертификатыСоответствия.Выгрузить());
	ПрилагаемыеДокументы.Загрузить(КопияОснования.ПрилагаемыеДокументы.Выгрузить());
	СведенияОГрузе.Загрузить(КопияОснования.СведенияОГрузе.Выгрузить());
	
	ДанныеОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание, "ДатаЭД,НомерЭД,НомерИсправления,ДокументОснование");
	
	ИсправляемыйДокумент = Основание;
	ДокументОснование = ДанныеОснования.ДокументОснование;
	НомерЭД = ДанныеОснования.НомерЭД;
	ДатаЭД = ДанныеОснования.ДатаЭД;
	НомерИсправления = ДанныеОснования.НомерИсправления + 1;
	
КонецПроцедуры

Процедура ЗаполнитьПоПоступлению(Знач Основание)
	
	ДокументОснование = Основание;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Основание.Ссылка КАК ДокументОснование,
	|	Основание.Организация КАК Организация,
	|	Основание.Контрагент КАК Контрагент,
	|	Основание.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Основание.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
	|	Основание.Грузоотправитель КАК Грузоотправитель,
	|	Основание.Грузополучатель КАК Грузополучатель,
	|	Основание.Перевозчик КАК Перевозчик,
	|	Основание.Валюта КАК Валюта,
	|	""Накладная"" КАК СопроводительныйДокументНаименование,
	|	Основание.НомерЭД КАК СопроводительныйДокументНомер,
	|	Основание.ДатаЭД КАК СопроводительныйДокументДата,
	|	Основание.НомерТранспортнойНакладной КАК ТранспортныйДокументНомер,
	|	Основание.ДатаТранспортнойНакладной КАК ТранспортныйДокументДата,
	|	Основание.ОблагаетсяНДСУПокупателя КАК ОблагаетсяНДСУПокупателя
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Основание
	|ГДЕ
	|	Основание.Ссылка = &ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОснованиеТовары.Номенклатура КАК Номенклатура,
	|	ОснованиеТовары.Характеристика КАК Характеристика,
	|	ОснованиеТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ОснованиеТовары.Количество КАК Количество,
	|	ОснованиеТовары.Количество КАК КоличествоПоДокументу,
	|	ОснованиеТовары.Цена КАК ЦенаПоДокументу,
	|	ОснованиеТовары.Сумма КАК Сумма,
	|	ОснованиеТовары.Сумма КАК СуммаПоДокументу,
	|	ОснованиеТовары.СтавкаНДС КАК СтавкаНДСПоДокументу,
	|	ОснованиеТовары.СуммаНДС КАК СуммаНДС,
	|	ОснованиеТовары.СуммаНДС КАК СуммаНДСПоДокументу,
	|	ОснованиеТовары.СуммаСНДС КАК СуммаСНДС,
	|	ОснованиеТовары.СуммаСНДС КАК СуммаСНДСПоДокументу,
	|	ОснованиеТовары.НоменклатураКонтрагента КАК НоменклатураКонтрагента,
	|	ИСТИНА КАК ЗаполненоПоОснованию
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК ОснованиеТовары
	|ГДЕ
	|	ОснованиеТовары.Ссылка = &ДокументОснование";
	Запрос.УстановитьПараметр("ДокументОснование", Основание);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаШапка = РезультатыЗапроса[0].Выбрать();
	Если ВыборкаШапка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаШапка);
	КонецЕсли;
	
	ВыборкаТовары = РезультатыЗапроса[1].Выбрать();
	Пока ВыборкаТовары.Следующий() Цикл
		
		СтрокаТовара = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТовара, ВыборкаТовары);
		СтрокаТовара.Цена = ВыборкаТовары.ЦенаПоДокументу;
		СтрокаТовара.СтавкаНДС = ВыборкаТовары.СтавкаНДСПоДокументу;
		
	КонецЦикла;
	
	ОбстоятельстваИспользования = Перечисления.ОбстоятельстваИспользованияАктаОРасхождениях.ПриемкаСРасхождениями;
	
КонецПроцедуры

Процедура ЗаполнитьПоЭД(Знач Основание)
	
	ДокументОснование = Основание;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Основание.Ссылка КАК ДокументОснование,
	|	Основание.Организация КАК Организация,
	|	Основание.Контрагент КАК Контрагент,
	|	Основание.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	""Накладная"" КАК СопроводительныйДокументНаименование,
	|	Основание.НомерДокумента КАК СопроводительныйДокументНомер,
	|	Основание.ДатаДокумента КАК СопроводительныйДокументДата
	|ИЗ
	|	Документ.ЭлектронныйДокументВходящийЭДО КАК Основание
	|ГДЕ
	|	Основание.Ссылка = &ДокументОснование
	|";
	Запрос.УстановитьПараметр("ДокументОснование", Основание);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаШапка = РезультатыЗапроса[0].Выбрать();
	Если ВыборкаШапка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаШапка);
	КонецЕсли;
	
	ОбстоятельстваИспользования = Перечисления.ОбстоятельстваИспользованияАктаОРасхождениях.ПриемкаСРасхождениями;
	
КонецПроцедуры

Процедура УстановитьПредставлениеНомера()
	
	Если ПустаяСтрока(Номер) Тогда
		УстановитьНовыйНомер();
	КонецЕсли;
	
	Если ПустаяСтрока(НомерЭД) Тогда
		НомерЭД = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Номер, Истина, Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерИсправления) Тогда
		ПредставлениеНомера = СтрШаблон(НСтр("ru = '%1 (испр. %2)'"),
			НомерЭД, НомерИсправления);
	Иначе
		ПредставлениеНомера = НомерЭД;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьДатуЭД()
	
	Если ЗначениеЗаполнено(ИсправляемыйДокумент) И ЗначениеЗаполнено(ДатаЭД) Тогда
		Возврат;
	КонецЕсли;
	
	ДатаЭД = НачалоДня(Дата);
	
КонецПроцедуры

Процедура ИнициализироватьДокумент()
	
	Если Не ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	Если Не Справочники.Организации.ИспользуетсяНесколькоОрганизаций() Тогда
		Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ОбстоятельстваСоставления) Тогда
		ОбстоятельстваСоставления = Перечисления.ОбстоятельстваСоставленияАктаОРасхождениях.ПриПриемке;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ОбстоятельстваИспользования) Тогда
		ОбстоятельстваИспользования = Перечисления.ОбстоятельстваИспользованияАктаОРасхождениях.Расхождения;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ФормированиеДополнительныхСведений) Тогда
		ФормированиеДополнительныхСведений = Перечисления.ДополнительныеСведенияАктаОРасхождениях.НеФормируются;
	КонецЕсли;
	Если ФормированиеДополнительныхСведений
			= Перечисления.ДополнительныеСведенияАктаОРасхождениях.ПродавцомФормируютсяДопСведенияИные
		Или ФормированиеДополнительныхСведений
			= Перечисления.ДополнительныеСведенияАктаОРасхождениях.ПродавцомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки
		Тогда
		СодержаниеДополнительныхСведений = "";
	КонецЕсли;
		
	Ответственный = Пользователи.ТекущийПользователь();
	
КонецПроцедуры

Процедура УстановитьВидДокумента()
	
	Если ВидДокумента <> Перечисления.ВидыДокументов.АктОРасхождениях Тогда
		ВидДокумента = Перечисления.ВидыДокументов.АктОРасхождениях;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли