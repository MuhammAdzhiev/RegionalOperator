////////////////////////////////////////////////////////////////////////////////
// Модуль менеджера Документ.АктОРасхожденияхПоПриемке
//  
////////////////////////////////////////////////////////////////////////////////

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Получение данных для формирования электронного документа.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка.АктОРасхожденияхПоПриемке - ссылка на документ.
// 
// Возвращаемое значение:
//  Структура - данные документа.
//
Функция ПолучитьДанныеДляЭД(СсылкаНаОбъект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.Ссылка.Контрагент КАК Владелец,
	|	Товары.НоменклатураКонтрагента КАК НоменклатураКонтрагента,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.ЕдиницаИзмерения КАК Упаковка,
	|	Товары.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.АктОРасхожденияхПоПриемке.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	ТаблицаОтбора = Запрос.Выполнить().Выгрузить();
	
	МенеджерТаблиц = Новый МенеджерВременныхТаблиц;
	СопоставлениеНоменклатурыКонтрагентов.СоздатьВременнуюТаблицуНоменклатурыКонтрагентовПоТаблицеОтборов(ТаблицаОтбора, "втНоменклатураКонтрагента", МенеджерТаблиц);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Шапка.Ссылка КАК Ссылка,
	|	Шапка.Дата КАК Дата,
	|	Шапка.ДатаЭД КАК ДатаЭД,
	|	Шапка.НомерЭД КАК НомерЭД,
	|	Шапка.Организация КАК Организация,
	|	Шапка.Контрагент КАК Контрагент,
	|	Шапка.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Шапка.ДокументОснование КАК ДокументОснование,
	|	Шапка.ИсправляемыйДокумент КАК ИсправляемыйДокумент,
	|	Шапка.НомерИсправления КАК НомерИсправления,
	|	Шапка.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
	|	Шапка.Грузоотправитель КАК Грузоотправитель,
	|	Шапка.Грузополучатель КАК Грузополучатель,
	|	Шапка.СтраховаяКомпания КАК СтраховаяКомпания,
	|	Шапка.МестоСоставления КАК МестоСоставления,
	|	Шапка.ДатаОсмотраГруза КАК ДатаОсмотраГруза,
	|	Шапка.ВремяНачалаПриемки КАК ВремяНачалаПриемки,
	|	Шапка.ВремяОкончанияПриемки КАК ВремяОкончанияПриемки,
	|	Шапка.ДатаОтправленияТоваров КАК ДатаОтправленияТоваров,
	|	Шапка.ДатаПрибытияВПунктНазначения КАК ДатаПрибытияВПунктНазначения,
	|	Шапка.ДатаВыдачиОрганизациейТранспорта КАК ДатаВыдачиОрганизациейТранспорта,
	|	Шапка.ДатаВскрытияТранспортныхСредств КАК ДатаВскрытияТранспортныхСредств,
	|	Шапка.ДатаДоставкиНаСкладПолучателя КАК ДатаДоставкиНаСкладПолучателя,
	|	Шапка.УсловияХраненияТовараДоВскрытия КАК УсловияХраненияТовараДоВскрытия,
	|	Шапка.СостояниеТарыИУпаковки КАК СостояниеТарыИУпаковки,
	|	Шапка.СпособОпределенияКоличества КАК СпособОпределенияКоличества,
	|	Шапка.ДополнительныеСведения КАК ДополнительныеСведения,
	|	Шапка.Перевозчик КАК Перевозчик,
	|	Шапка.ЛицоПринявшееГрузФИО КАК ЛицоПринявшееГрузФИО,
	|	Шапка.ЛицоПринявшееГрузДолжность КАК ЛицоПринявшееГрузДолжность,
	|	Шапка.НомерПриказа КАК НомерПриказа,
	|	Шапка.ДатаПриказа КАК ДатаПриказа,
	|	Шапка.ЗаключениеКомиссии КАК ЗаключениеКомиссии,
	|	Шапка.Валюта КАК Валюта,
	|	Шапка.СопроводительныйДокументНаименование КАК СопроводительныйДокументНаименование,
	|	Шапка.СопроводительныйДокументНомер КАК СопроводительныйДокументНомер,
	|	Шапка.СопроводительныйДокументДата КАК СопроводительныйДокументДата,
	|	Шапка.ТранспортныйДокументНаименование КАК ТранспортныйДокументНаименование,
	|	Шапка.ТранспортныйДокументНомер КАК ТранспортныйДокументНомер,
	|	Шапка.ТранспортныйДокументДата КАК ТранспортныйДокументДата,
	|	Шапка.ОбстоятельстваСоставления КАК ОбстоятельстваСоставления,
	|	Шапка.ОбстоятельстваИспользования КАК ОбстоятельстваИспользования,
	|	ВЫБОР
	|		КОГДА Шапка.ФормированиеДополнительныхСведений =
	|			ЗНАЧЕНИЕ(Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПокупателемФормируютсяДопСведенияОбОприходованииИмЦенностей)
	|			ТОГДА &ПокупателемФормируютсяДопСведенияОбОприходованииИмЦенностей
	|		КОГДА Шапка.ФормированиеДополнительныхСведений =
	|			ЗНАЧЕНИЕ(Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПокупателемФормируютсяДопСведенияОУтвержденииДокумента)
	|			ТОГДА &ПокупателемФормируютсяДопСведенияОУтвержденииДокумента
	|		КОГДА Шапка.ФормированиеДополнительныхСведений =
	|			ЗНАЧЕНИЕ(Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПокупателемФормируютсяДопСведенияИные)
	|			ТОГДА &ПокупателемФормируютсяДопСведенияИные
	|		КОГДА Шапка.ФормированиеДополнительныхСведений =
	|			ЗНАЧЕНИЕ(Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПродавцомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки)
	|			ТОГДА &ПродавцомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки
	|		КОГДА Шапка.ФормированиеДополнительныхСведений =
	|			ЗНАЧЕНИЕ(Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПродавцомФормируютсяДопСведенияИные)
	|			ТОГДА &ПродавцомФормируютсяДопСведенияИные
	|		КОГДА Шапка.ФормированиеДополнительныхСведений =
	|			ЗНАЧЕНИЕ(Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПеревозчикомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки)
	|			ТОГДА &ПеревозчикомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки
	|		КОГДА Шапка.ФормированиеДополнительныхСведений =
	|			ЗНАЧЕНИЕ(Перечисление.ДополнительныеСведенияАктаОРасхождениях.ПеревозчикомФормируютсяДопСведенияИные)
	|			ТОГДА &ПеревозчикомФормируютсяДопСведенияИные
	|		ИНАЧЕ &НеФормируются
	|	КОНЕЦ КАК ФормированиеДополнительныхСведений,
	|	Шапка.СодержаниеДополнительныхСведений КАК СодержаниеДополнительныхСведений
	|ИЗ
	|	Документ.АктОРасхожденияхПоПриемке КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(втНоменклатураКонтрагента.НаименованиеХарактеристики, Товары.Характеристика.Наименование) КАК
	|		ХарактеристикаНаименование,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	&ДанныеУпаковки,
	|	ЕСТЬNULL(втНоменклатураКонтрагента.Наименование, Товары.Номенклатура.Наименование) КАК Наименование,
	|	ЕСТЬNULL(втНоменклатураКонтрагента.Наименование, Товары.Номенклатура.НаименованиеПолное) КАК НаименованиеПолное,
	|	ЕСТЬNULL(втНоменклатураКонтрагента.Артикул, Товары.Номенклатура.Артикул) КАК НоменклатураАртикул,
	|	ВЫБОР
	|		КОГДА втНоменклатураКонтрагента.Идентификатор ЕСТЬ NULL
	|			ТОГДА Товары.Номенклатура.Код
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НоменклатураКод,
	|	Товары.НомерПаспорта КАК НомерПаспорта,
	|	Товары.НомерСтрокиСопроводительногоДокумента КАК НомерСтрокиСопроводительногоДокумента,
	|	Товары.КоличествоПоДокументу КАК КоличествоПоДокументу,
	|	Товары.ЦенаПоДокументу КАК ЦенаПоДокументу,
	|	Товары.СуммаПоДокументу КАК СуммаПоДокументу,
	|	ВЫБОР
	|		КОГДА Товары.Ссылка.ОблагаетсяНДСУПокупателя
	|			ТОГДА ""НДС исчисляется налоговым агентом""
	|		ИНАЧЕ Товары.СтавкаНДСПоДокументу
	|	КОНЕЦ КАК СтавкаНДСПоДокументу,
	|	Товары.СуммаНДСПоДокументу КАК СуммаНДСПоДокументу,
	|	Товары.СуммаСНДСПоДокументу КАК СуммаСНДСПоДокументу,
	|	Товары.Пояснение КАК Пояснение,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	ВЫБОР
	|		КОГДА Товары.Ссылка.ОблагаетсяНДСУПокупателя
	|			ТОГДА ""НДС исчисляется налоговым агентом""
	|		ИНАЧЕ Товары.СтавкаНДС
	|	КОНЕЦ КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.СуммаСНДС КАК СуммаСНДС,
	|	Товары.КоличествоБой КАК КоличествоБой,
	|	Товары.КоличествоБрак КАК КоличествоБрак,
	|	ЕСТЬNULL(втНоменклатураКонтрагента.Идентификатор, """") КАК ИдентификаторКонтрагента,
	|	Товары.ЗаполненоПоОснованию КАК ЗаполненоПоОснованию,
	|	Товары.ЦенаПоДоговору КАК ЦенаПоДоговору,
	|	Товары.СуммаНДСПоДоговору КАК СуммаНДСПоДоговору,
	|	Товары.СуммаСНДСПоДоговору КАК СуммаСНДСПоДоговору,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	Документ.АктОРасхожденияхПоПриемке.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ втНоменклатураКонтрагента КАК втНоменклатураКонтрагента
	|		ПО Товары.НомерСтроки = втНоменклатураКонтрагента.НомерСтроки
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СертификатыСоответствия.Номер КАК Номер
	|ИЗ
	|	Документ.АктОРасхожденияхПоПриемке.СертификатыСоответствия КАК СертификатыСоответствия
	|ГДЕ
	|	СертификатыСоответствия.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрилагаемыеДокументы.Наименование КАК Наименование,
	|	ПрилагаемыеДокументы.Номер КАК Номер,
	|	ПрилагаемыеДокументы.Дата КАК Дата
	|ИЗ
	|	Документ.АктОРасхожденияхПоПриемке.ПрилагаемыеДокументы КАК ПрилагаемыеДокументы
	|ГДЕ
	|	ПрилагаемыеДокументы.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(АктОРасхожденияхПоПриемкеСведенияОГрузе.Номенклатура) КАК НаименованиеГруза,
	|	АктОРасхожденияхПоПриемкеСведенияОГрузе.ОтметкаОбОпломбировании КАК ОтметкаОбОпломбировании,
	|	АктОРасхожденияхПоПриемкеСведенияОГрузе.ВидУпаковки КАК ВидУпаковки,
	|	АктОРасхожденияхПоПриемкеСведенияОГрузе.КоличествоУпаковок КАК Количество,
	|	АктОРасхожденияхПоПриемкеСведенияОГрузе.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	&СведенияОГрузеДанныеУпаковки,
	|	АктОРасхожденияхПоПриемкеСведенияОГрузе.МассаБруттоПоДокументу КАК МассаОтправленияБрутто,
	|	АктОРасхожденияхПоПриемкеСведенияОГрузе.МассаНеттоПоДокументу КАК МассаОтправленияНетто,
	|	АктОРасхожденияхПоПриемкеСведенияОГрузе.МассаБрутто КАК МассаПрибытияБрутто,
	|	АктОРасхожденияхПоПриемкеСведенияОГрузе.МассаНетто КАК МассаПрибытияНетто,
	|	АктОРасхожденияхПоПриемкеСведенияОГрузе.ОтметкиОтправителя КАК ОтметкиОтправителя
	|ИЗ
	|	Документ.АктОРасхожденияхПоПриемке.СведенияОГрузе КАК АктОРасхожденияхПоПриемкеСведенияОГрузе
	|ГДЕ
	|	АктОРасхожденияхПоПриемкеСведенияОГрузе.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиПоДокументу.ИдентификаторСтроки,
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиПоДокументу.НомерУпаковки
	|ИЗ
	|	Документ.АктОРасхожденияхПоПриемке.КодыМаркировкиПоДокументу КАК АктОРасхожденияхПоПриемкеКодыМаркировкиПоДокументу
	|ГДЕ
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиПоДокументу.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиПоФакту.ИдентификаторСтроки,
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиПоФакту.НомерУпаковки
	|ИЗ
	|	Документ.АктОРасхожденияхПоПриемке.КодыМаркировкиПоФакту КАК АктОРасхожденияхПоПриемкеКодыМаркировкиПоФакту
	|ГДЕ
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиПоФакту.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиНедостачи.ИдентификаторСтроки,
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиНедостачи.НомерУпаковки
	|ИЗ
	|	Документ.АктОРасхожденияхПоПриемке.КодыМаркировкиНедостачи КАК АктОРасхожденияхПоПриемкеКодыМаркировкиНедостачи
	|ГДЕ
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиНедостачи.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиИзлишки.ИдентификаторСтроки,
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиИзлишки.НомерУпаковки
	|ИЗ
	|	Документ.АктОРасхожденияхПоПриемке.КодыМаркировкиИзлишки КАК АктОРасхожденияхПоПриемкеКодыМаркировкиИзлишки
	|ГДЕ
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиИзлишки.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиБрак.ИдентификаторСтроки,
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиБрак.НомерУпаковки
	|ИЗ
	|	Документ.АктОРасхожденияхПоПриемке.КодыМаркировкиБрак КАК АктОРасхожденияхПоПриемкеКодыМаркировкиБрак
	|ГДЕ
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиБрак.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиБой.ИдентификаторСтроки,
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиБой.НомерУпаковки
	|ИЗ
	|	Документ.АктОРасхожденияхПоПриемке.КодыМаркировкиБой КАК АктОРасхожденияхПоПриемкеКодыМаркировкиБой
	|ГДЕ
	|	АктОРасхожденияхПоПриемкеКодыМаркировкиБой.Ссылка = &Ссылка";
	
	ОбменСКонтрагентамиКЭДО.ИнициализацияТекстаЗапросаПоискаШтрихкодовПоВременнойТаблицеТоваров(Запрос.Текст, Метаданные.Документы.АктОРасхожденияхПоПриемке.Имя, Истина);
	
	Справочники.ЕдиницыИзмерения.ДополнитьЗапросДаннымиЕдиницыИзмеренияУпаковки(Запрос.Текст,
		"&ДанныеУпаковки", "Товары.ЕдиницаИзмерения", "ЕдиницаИзмерения");
	Справочники.ЕдиницыИзмерения.ДополнитьЗапросДаннымиЕдиницыИзмеренияУпаковки(Запрос.Текст,
		"&СведенияОГрузеДанныеУпаковки", "АктОРасхожденияхПоПриемкеСведенияОГрузе.ЕдиницаИзмерения", "ЕдиницаИзмерения");
	
	ВариантыФормирования = ФорматыЭДО.ВариантыФормированияИтоговПриемки();
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("НеФормируются",
		ВариантыФормирования.НеФормируются);
	Запрос.УстановитьПараметр("ПокупателемФормируютсяДопСведенияОбОприходованииИмЦенностей",
		ВариантыФормирования.ПокупателемФормируютсяДопСведенияОбОприходованииИмЦенностей);
	Запрос.УстановитьПараметр("ПокупателемФормируютсяДопСведенияОУтвержденииДокумента",
		ВариантыФормирования.ПокупателемФормируютсяДопСведенияОУтвержденииДокумента);
	Запрос.УстановитьПараметр("ПокупателемФормируютсяДопСведенияИные",
		ВариантыФормирования.ПокупателемФормируютсяДопСведенияИные);
	Запрос.УстановитьПараметр("ПродавцомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки",
		ВариантыФормирования.ПродавцомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки);
	Запрос.УстановитьПараметр("ПродавцомФормируютсяДопСведенияИные",
		ВариантыФормирования.ПродавцомФормируютсяДопСведенияИные);
	Запрос.УстановитьПараметр("ПеревозчикомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки",
		ВариантыФормирования.ПеревозчикомФормируютсяДопСведенияОСогласииНесогласииСРезультатамиПриемки);
	Запрос.УстановитьПараметр("ПеревозчикомФормируютсяДопСведенияИные",
		ВариантыФормирования.ПеревозчикомФормируютсяДопСведенияИные);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаШапка = МассивРезультатов[0].Выбрать();
	Товары = МассивРезультатов[1];
	ВыборкаТовары = Товары.Выбрать();
	ВыборкаСертификатыСоответствия = МассивРезультатов[2].Выбрать();
	ВыборкаПрилагаемыеДокументы = МассивРезультатов[3].Выбрать();
	ВыборкаСведенияОГрузе = МассивРезультатов[4].Выбрать();
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ВыборкаШапка", ВыборкаШапка);
	СтруктураДанных.Вставить("Товары", Товары);
	СтруктураДанных.Вставить("ВыборкаТовары", ВыборкаТовары);
	СтруктураДанных.Вставить("ВыборкаСертификатыСоответствия", ВыборкаСертификатыСоответствия);
	СтруктураДанных.Вставить("ВыборкаПрилагаемыеДокументы", ВыборкаПрилагаемыеДокументы);
	СтруктураДанных.Вставить("ВыборкаСведенияОГрузе", ВыборкаСведенияОГрузе);

	СтруктураДанных.Вставить("КодыМаркировкиПоДокументу", МассивРезультатов[5].Выгрузить());
	СтруктураДанных.Вставить("КодыМаркировкиПоФакту", МассивРезультатов[6].Выгрузить());
	СтруктураДанных.Вставить("КодыМаркировкиНедостачи", МассивРезультатов[7].Выгрузить());
	СтруктураДанных.Вставить("КодыМаркировкиИзлишки", МассивРезультатов[8].Выгрузить());
	СтруктураДанных.Вставить("КодыМаркировкиБрак", МассивРезультатов[9].Выгрузить());
	СтруктураДанных.Вставить("КодыМаркировкиБой", МассивРезультатов[10].Выгрузить());
	
	ШтрихкодыКомбинаций = МассивРезультатов[14].Выгрузить();
	ШтрихкодыКомбинаций.Индексы.Добавить("Номенклатура, Характеристика, ЕдиницаИзмерения");
	СтруктураДанных.Вставить("ШтрихкодыКомбинаций", ШтрихкодыКомбинаций);

	ШтрихкодыНоменклатуры = МассивРезультатов[15].Выгрузить();
	ШтрихкодыНоменклатуры.Индексы.Добавить("Номенклатура");
	СтруктураДанных.Вставить("ШтрихкодыНоменклатуры", ШтрихкодыНоменклатуры);

	Возврат СтруктураДанных;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

