&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	КлиентЭДО.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьСтатусДокумента();
	
	КлиентЭДО.ЗаполнитьПризнакИспользованияХарактеристик(Объект.Товары);
	
	КлиентЭДО.ЗаполнитьВариантыРасчетаНДС(ЭтотОбъект);
	
	УстановитьВозможностьРедактированияРеквизитов(ЭтотОбъект, Ложь);
	
	Элементы.ТоварыСуммаСНДС.Видимость = НЕ Объект.ЦенаВключаетНДС;
	
	УстановитьВидимостьПолейНДС(ЭтотОбъект);
	
	УстановитьВидимостьНоменклатуры();
	
	УстановитьОграничениеТипаОснования();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтатусДокумента()
	
	СтатусДокумента = КлиентЭДО.СтатусДокумента(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура РазрешитьРедактированиеРеквизитовОбъектаПослеВопроса(Ответ, Параметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		УстановитьВозможностьРедактированияРеквизитов(ЭтотОбъект);
		Элементы.РазрешитьРедактированиеРеквизитовОбъекта.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВозможностьРедактированияРеквизитов(Форма, Значение = Истина)
	
	Заблокировать = НЕ Значение;
	
	Элементы = Форма.Элементы;
	
	Элементы.Контрагент.ТолькоПросмотр = Заблокировать;
	Элементы.Организация.ТолькоПросмотр = Заблокировать;
	
	Элементы.ДоговорКонтрагента.ТолькоПросмотр = Заблокировать;
	Элементы.БанковскийСчетКонтрагента.ТолькоПросмотр = Заблокировать;
	Элементы.БанковскийСчетКомментарий.ТолькоПросмотр = Заблокировать;
	Элементы.Валюта.ТолькоПросмотр = Заблокировать;
	Элементы.ВариантРасчетаНДС.ТолькоПросмотр = Заблокировать;
	Элементы.ДокументОснование.ТолькоПросмотр = Заблокировать;
	Элементы.ИдентификаторПлатежа.ТолькоПросмотр = Заблокировать;
	
	Элементы.ТоварыНоменклатура.ТолькоПросмотр = Заблокировать;
	Элементы.ТоварыХарактеристика.ТолькоПросмотр = Заблокировать;
	Элементы.ТоварыЕдиницаИзмерения.ТолькоПросмотр = Заблокировать;
	Элементы.ТоварыКоличество.ТолькоПросмотр = Заблокировать;
	Элементы.ТоварыЦена.ТолькоПросмотр = Заблокировать;
	Элементы.ТоварыСумма.ТолькоПросмотр = Заблокировать;
	Элементы.ТоварыСтавкаНДС.ТолькоПросмотр = Заблокировать;
	Элементы.ТоварыСуммаНДС.ТолькоПросмотр = Заблокировать;
	Элементы.ТоварыСуммаСНДС.ТолькоПросмотр = Заблокировать;
	
	Элементы.ЭтапыГрафикаОплатыДатаПлатежа.ТолькоПросмотр = Заблокировать;
	Элементы.ЭтапыГрафикаОплатыПроцентПлатежа.ТолькоПросмотр = Заблокировать;
	Элементы.ЭтапыГрафикаОплатыСуммаПлатежа.ТолькоПросмотр = Заблокировать;
	
КонецПроцедуры

&НаКлиенте 
Процедура ПриИзмененииНоменклатуры(ТребуетсяПодобратьНоменклатуруКонтрагента)
	
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	
	// ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	Если ТребуетсяПодобратьНоменклатуруКонтрагента Тогда
		СопоставлениеНоменклатурыКонтрагентовКЭДОКлиент.ПодобратьНоменклатуруКонтрагента(Объект.Контрагент, СтрокаТаблицы);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	
	ПриИзмененииНоменклатурыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииНоменклатурыНаСервере()
	
	СтрокаТовара = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	Если СтрокаТовара = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КлиентЭДОКлиентСервер.ПриИзмененииНоменклатуры(СтрокаТовара,
		"ЕдиницаИзмерения,СтавкаНДС", Объект.ЦенаВключаетНДС);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКлючевыхРеквизитовСостояниеЭДО()
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ПараметрыПриИзменении = ОбменСКонтрагентами.ПараметрыПриИзмененииКлючевыхРеквизитовЭДО();
	
	ПараметрыПриИзменении.Форма                 = ЭтотОбъект;
	ПараметрыПриИзменении.ДокументСсылка        = Объект.Ссылка;
	ПараметрыПриИзменении.ДокументОбъект        = РеквизитФормыВЗначение("Объект");
	ПараметрыПриИзменении.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПриИзменении.ГруппаСостояниеЭДО    = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриИзмененииКлючевыхРеквизитовЭДО(ПараметрыПриИзменении);
	
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииВариантаРасчетаНДС();
	
	КлиентЭДОКлиентСервер.ПриИзмененииВариантаРасчетаНДС(ЭтотОбъект);
	УстановитьВидимостьПолейНДС(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПолейНДС(Форма)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	ВидимостьНДС = НЕ Объект.ОблагаетсяНДСУПокупателя;
	Элементы.ТоварыСтавкаНДС.Видимость = ВидимостьНДС;
	Элементы.ТоварыСуммаНДС.Видимость  = ВидимостьНДС;
	Элементы.ТоварыСуммаСНДС.Видимость = ВидимостьНДС;
	Элементы.ИтогиВсегоНДС.Видимость   = ВидимостьНДС;
	
	Элементы.ТоварыСуммаСНДС.Видимость = НЕ Объект.ЦенаВключаетНДС;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьНоменклатуры()
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры") Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ТоварыНоменклатура.Видимость = Ложь;
	Элементы.ТоварыХарактеристика.Видимость = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКонтрагента()
	
	ПриИзмененииКлючевыхРеквизитовСостояниеЭДО();
	
	// ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ПриИзмененииВладельцаНоменклатурыКонтрагентов(Объект.Контрагент, Объект.Товары);
	// Конец ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОграничениеТипаОснования()
	
	Элементы.ДокументОснование.ОграничениеТипа = Новый ОписаниеТипов(
		"ДокументСсылка.ПоступлениеТоваровУслуг, ДокументСсылка.ЗаказПоставщику");
	
КонецПроцедуры

