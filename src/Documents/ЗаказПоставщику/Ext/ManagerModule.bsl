Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)

	ИнтерфейсКлиентЭДОВызовСервера.ОбработкаПолученияФормыУчетногоДокумента(
		ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка);

КонецПроцедуры

#КонецЕсли

#КонецОбласти

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

Функция ДанныеКОбработкеДляПереходаНаНовуюВерсию_ЗаполнитьРеквизитПоДаннымКонтрагента()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПоставщику.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
	|ГДЕ
	|	НЕ ЗаказПоставщику.ПоДаннымКонтрагента";
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьДанные_ЗаполнитьРеквизитПоДаннымКонтрагента(Объект, Записать)
	
	Если Объект.ПоДаннымКонтрагента Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ОбменСКонтрагентами.СтатусДокументооборота(Объект.Ссылка);
	Если Результат.ЭлектронныйДокумент <> Неопределено
		И ТипЗнч(Результат.ЭлектронныйДокумент) = Тип("ДокументСсылка.ЭлектронныйДокументВходящийЭДО") Тогда
		Объект.ПоДаннымКонтрагента = Истина;
		Записать = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли