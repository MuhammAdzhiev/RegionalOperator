// СтандартныеПодсистемы.УправлениеДоступом
// 
// Параметры:
//  Таблица - см. УправлениеДоступом.ТаблицаНаборыЗначенийДоступа
//
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	Если ЗначениеЗаполнено(Организация) Тогда
		Строка = Таблица.Добавить();
		Строка.ЗначениеДоступа = Организация;
	Иначе
		Строка = Таблица.Добавить();
		Строка.ЗначениеДоступа = Перечисления.ДополнительныеЗначенияДоступа.ДоступРазрешен;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КоммерческоеПредложениеПоставщика") Тогда
		ЗаполнитьНаОснованииКоммерческогоПредложенияПоставщика(ДанныеЗаполнения);
	КонецЕсли;
	
	ИнициализироватьДокумент();
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	УстановитьПредставлениеНомера();

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ЗаполнитьСуммуДокумента();
	
	Если Не ЗначениеЗаполнено(ВидДокумента) Тогда 
		ВидДокумента = Перечисления.ВидыДокументов.ЗаказТовара;
	КонецЕсли;
	
	ЭлектронноеВзаимодействиеКЭДО.ПередЗаписьюОснованияЭлектронногоДокумента(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	
	// Заполнение даты поступления
	ЗаполнитьДатуПоступления();
	
	// ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ПередЗаписьюУчетногоДокумента(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	// Конец ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов
	
	// Пересчет графика оплат
	КлиентЭДО.ЗаполнитьГрафикОплатПередЗаписью(ЭтотОбъект, ДатаПоступления, СуммаДокумента);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	Если СпособДоставки = Перечисления.СпособыДоставки.Самовывоз Тогда
		МассивНепроверяемыхРеквизитов.Добавить("АдресДоставки");
	КонецЕсли;
	
	Если ПоступлениеОднойДатой Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Товары.ДатаПоступления");
	Иначе
		МассивНепроверяемыхРеквизитов.Добавить("ДатаПоступления");
	КонецЕсли; 
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры") Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Номенклатура");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Характеристика");
	КонецЕсли;
	
	ПараметрыПроверки = КлиентЭДО.ПараметрыПроверкиЗаполненияКоличестваИЕдиницыИзмерения();
	ПараметрыПроверки.Вставить("Объект", ЭтотОбъект);
	ПараметрыПроверки.Вставить("МассивНепроверяемыхРеквизитов", МассивНепроверяемыхРеквизитов);
	КлиентЭДО.ПроверитьЗаполнениеХарактеристик(ПараметрыПроверки, Отказ);
	КлиентЭДО.ПроверитьЗаполнениеКоличестваИЕдиницыИзмерения(ПараметрыПроверки, Отказ);
	
	Если ЗначениеЗаполнено(МассивНепроверяемыхРеквизитов) Тогда
		ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	КонецЕсли;
	
	КлиентЭДО.ОбработкаПроверкиЗаполнения(ЭтотОбъект, ПроверяемыеРеквизиты, Отказ);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ПредставлениеНомера = "";
	
	НомерЭД = "";
	ДатаЭД = "";

	Ответственный = Пользователи.ТекущийПользователь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьСуммуДокумента() Экспорт
	
	СуммаДокумента = Товары.Итог("СуммаСНДС");
	
КонецПроцедуры

Процедура УстановитьПредставлениеНомера()
	
	Если ПустаяСтрока(Номер) Тогда
		УстановитьНовыйНомер();
	КонецЕсли;
	
	Если ПустаяСтрока(НомерЭД) Тогда
		НомерЭД = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Номер, Истина, Истина);
	КонецЕсли;
	
		ПредставлениеНомера = НомерЭД;
	
КонецПроцедуры

Процедура ИнициализироватьДокумент()
	
	Если Не ЭтоНовый() Или ПоДаннымКонтрагента Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Организация)
		И Не Справочники.Организации.ИспользуетсяНесколькоОрганизаций() Тогда
		Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	КонецЕсли;
	
	Ответственный = Пользователи.ТекущийПользователь();
	
КонецПроцедуры

Процедура ЗаполнитьНаОснованииКоммерческогоПредложенияПоставщика(КоммерческоеПредложениеПоставщика)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	КоммерческоеПредложениеПоставщика.Ссылка                КАК Ссылка,
	|	КоммерческоеПредложениеПоставщика.Проведен              КАК Проведен,
	|	КоммерческоеПредложениеПоставщика.Организация           КАК Организация,
	|	КоммерческоеПредложениеПоставщика.Поставщик             КАК Поставщик,
	|	КоммерческоеПредложениеПоставщика.Контрагент            КАК Контрагент,
	|	КоммерческоеПредложениеПоставщика.КонтактноеЛицо        КАК КонтактноеЛицо,
	|	КоммерческоеПредложениеПоставщика.Валюта                КАК Валюта,
	|	КоммерческоеПредложениеПоставщика.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	КоммерческоеПредложениеПоставщика.Налогообложение       КАК Налогообложение,
	|	КоммерческоеПредложениеПоставщика.ЦенаВключаетНДС       КАК ЦенаВключаетНДС,
	|	КоммерческоеПредложениеПоставщика.СрокДействия          КАК СрокДействия,
	|	КоммерческоеПредложениеПоставщика.Менеджер              КАК Менеджер
	|ИЗ
	|	Документ.КоммерческоеПредложениеПоставщика КАК КоммерческоеПредложениеПоставщика
	|ГДЕ
	|	КоммерческоеПредложениеПоставщика.Ссылка = &КоммерческоеПредложениеПоставщика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////1
	|ВЫБРАТЬ
	|	КоммерческоеПредложениеПоставщикаТовары.Номенклатура                        КАК Номенклатура,
	|	КоммерческоеПредложениеПоставщикаТовары.НоменклатураПоставщикаИдентификатор КАК НоменклатураПоставщикаИдентификатор,
	|	КоммерческоеПредложениеПоставщикаТовары.НоменклатураПоставщикаПредставление КАК НоменклатураПоставщикаПредставление,
	|	КоммерческоеПредложениеПоставщикаТовары.Характеристика                      КАК Характеристика,
	|	КоммерческоеПредложениеПоставщикаТовары.Количество                          КАК Количество,
	|	КоммерческоеПредложениеПоставщикаТовары.Количество                          КАК КоличествоУпаковок,
	|	КоммерческоеПредложениеПоставщикаТовары.ЕдиницаИзмерения                    КАК ЕдиницаИзмерения,
	|	КоммерческоеПредложениеПоставщикаТовары.Цена                                КАК Цена,
	|	КоммерческоеПредложениеПоставщикаТовары.Сумма                               КАК Сумма,
	|	КоммерческоеПредложениеПоставщикаТовары.СтавкаНДС                           КАК СтавкаНДС,
	|	КоммерческоеПредложениеПоставщикаТовары.СуммаНДС                            КАК СуммаНДС,
	|	КоммерческоеПредложениеПоставщикаТовары.СуммаСНДС                           КАК СуммаСНДС,
	|	КоммерческоеПредложениеПоставщикаТовары.СуммаСкидки                         КАК СуммаСкидки,
	|	КоммерческоеПредложениеПоставщикаТовары.СрокПоставки                        КАК СрокПоставки
	|ИЗ
	|	Документ.КоммерческоеПредложениеПоставщика.Товары КАК КоммерческоеПредложениеПоставщикаТовары
	|ГДЕ
	|	НЕ КоммерческоеПредложениеПоставщикаТовары.СнятСРассмотрения
	|	И КоммерческоеПредложениеПоставщикаТовары.Ссылка = &КоммерческоеПредложениеПоставщика";
	
	Запрос.УстановитьПараметр("КоммерческоеПредложениеПоставщика", КоммерческоеПредложениеПоставщика);
	
	Результат = Запрос.ВыполнитьПакет();
	ВыборкаШапка = Результат[0].Выбрать();
	
	Если ВыборкаШапка.Следующий() Тогда
		
		Если Не ВыборкаШапка.Проведен Тогда
			
			ТекстОшибки = СтрШаблон(НСтр("ru='Документ %1 не проведен. Ввод на основании непроведенного документа запрещен.'"), ВыборкаШапка.Ссылка);
			
			ВызватьИсключение ТекстОшибки;
			
		КонецЕсли;
		
		Валюта          = ВыборкаШапка.Валюта;
		Контрагент      = ВыборкаШапка.Контрагент;
		Организация     = ВыборкаШапка.Организация;
		Основание       = ВыборкаШапка.Ссылка;
		ЦенаВключаетНДС = ВыборкаШапка.ЦенаВключаетНДС;
		Ответственный   = ВыборкаШапка.Менеджер;
		ВидДокумента    = Перечисления.ВидыДокументов.ЗаказТовара;
		Статус          = Перечисления.СтатусыЗаказов.Открыт;
		ДатаПоступления = ТекущаяДатаСеанса();
		ПоступлениеОднойДатой = Истина;
	КонецЕсли;
	
	ТаблицаТовары = Товары.ВыгрузитьКолонки();
	
	СопоставлениеНоменклатурыКонтрагентовКЭДО.ДополнитьТаблицуТоваровКолонкамиПоискаПоИдентификатору(ТаблицаТовары);
	
	Сопоставление = СоответствиеСНоменклатуройКонтрагента(Контрагент, Результат[1]);
	
	ВыборкаТовары = Результат[1].Выбрать();
	Пока ВыборкаТовары.Следующий() Цикл
		
		НоваяСтрока = ТаблицаТовары.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаТовары);

		НоваяСтрока.ИдентификаторКонтрагента = ВыборкаТовары.НоменклатураПоставщикаИдентификатор;
		
		Представление = ВыборкаТовары.НоменклатураПоставщикаПредставление;
		Для Каждого ЭлементСопоставления Из Сопоставление Цикл
			Если ВыборкаТовары.НоменклатураПоставщикаИдентификатор = 
				ЭлементСопоставления.НоменклатураКонтрагента.Идентификатор Тогда
				
				Представление = ОбменСКонтрагентамиКЭДОКлиентСервер.ПредставлениеНоменклатурыКонтрагента(
					ЭлементСопоставления.НоменклатураКонтрагента);
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
			
		НоваяСтрока.НаименованиеКонтрагента  = Представление;
	КонецЦикла;
	
	СопоставлениеНоменклатурыКонтрагентовКЭДО.СопоставитьНоменклатуруКонтрагентовПоИдентификатору(ТаблицаТовары, Контрагент);
	
	Товары.Загрузить(ТаблицаТовары);
	
КонецПроцедуры

Функция СоответствиеСНоменклатуройКонтрагента(КонтрагентДокумента, ДанныеТабличнойЧасти)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВладелецНоменклатуры = КонтрагентДокумента;
	СопоставлениеНоменклатурыКонтрагентовПереопределяемый.ПриОпределенииВладельцаНоменклатурыКонтрагента(ВладелецНоменклатуры, ВладелецНоменклатуры);
	
	НаборНоменклатурыКонтрагентов = Новый Массив;
	Выборка = ДанныеТабличнойЧасти.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.НоменклатураПоставщикаИдентификатор) Тогда
			Продолжить;
		КонецЕсли;
		
		НоменклатураКонтрагента = СопоставлениеНоменклатурыКонтрагентовКлиентСервер.НоваяНоменклатураКонтрагента(
			ВладелецНоменклатуры, Выборка.НоменклатураПоставщикаИдентификатор);
			
		НаборНоменклатурыКонтрагентов.Добавить(НоменклатураКонтрагента);
	КонецЦикла;
	
	Результат = СопоставлениеНоменклатурыКонтрагентов.НайтиСоответствиеНоменклатуры(
		Новый Структура("НоменклатураКонтрагента", НаборНоменклатурыКонтрагентов));
		
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьДатуПоступления()

	Если ПоступлениеОднойДатой Тогда
		КлиентЭДОКлиентСервер.ЗаполнитьРеквизитВКоллекции(Товары, "ДатаПоступления", ДатаПоступления);
	Иначе
		ДатаПоступления= КлиентЭДОКлиентСервер.МаксимальноеЗначениеВКоллекции(Товары, "ДатаПоступления", Дата);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
