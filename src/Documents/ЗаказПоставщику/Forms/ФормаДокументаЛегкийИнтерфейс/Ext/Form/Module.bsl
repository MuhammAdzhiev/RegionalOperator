&НаКлиенте
Процедура АдресДоставкиПриИзменении(Элемент)
	
	// При изменении текста в поле, перезаполнение служебных полей адреса.
	КонтактнаяИнформация =	КонтактнаяИнформацияПоПредставлению(
		Объект.АдресДоставки, ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес"));
	Объект.АдресДоставкиЗначение = КонтактнаяИнформация.ИнформацияJSON;
	Объект.АдресДоставкиЗначенияПолей = КонтактнаяИнформация.ИнформацияXML;
	
КонецПроцедуры

&НаКлиенте
Процедура АдресДоставкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ВидКонтактнойИнформации", ПредопределенноеЗначение(
		"Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента"));
	ПараметрыОткрытия.Вставить("ЗначенияПолей",           Объект.АдресДоставкиЗначенияПолей);
	ПараметрыОткрытия.Вставить("Значение",                Объект.АдресДоставкиЗначение);
	ПараметрыОткрытия.Вставить("Представление",           Объект.АдресДоставки);
	
	Оповещение = Новый ОписаниеОповещения("ОткрытьФормуКонтактнойИнформацииЗавершение", ЭтотОбъект);
		
	УправлениеКонтактнойИнформациейКлиент.ОткрытьФормуКонтактнойИнформации(ПараметрыОткрытия,,Оповещение);
	
КонецПроцедуры

