// Назначение модуля: Прием ТКО на объекте с проверкой соответствия исходному рейсу и формированием движений приема.
// Проверяет прием по исходному рейсу и отражает фактически принятый объем в регистре.
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ТекстОшибки = РОТКО_ПроверкиПроведения.ПроверитьПриемОтходов(ЭтотОбъект);
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		Отказ = Истина;
		Сообщить(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Движения.ПриемОтходовМ3.Записывать = Истина;
	Движения.ПриемОтходовМ3.Очистить();
	
	РейсОбъект = Рейс.ПолучитьОбъект();
	
	Движение = Движения.ПриемОтходовМ3.Добавить();
	Движение.Период = Дата;
	Движение.ОбъектПриемаТКО = ОбъектПриемаТКО;
	Движение.Рейс = Рейс;
	Движение.Город = РейсОбъект.Город;
	Движение.Зона = РейсОбъект.Зона;
	Движение.ТипИсполнителя = РейсОбъект.ТипИсполнителя;
	Движение.Подрядчик = РейсОбъект.Подрядчик;
	Движение.ТС = РейсОбъект.ТС;
	Движение.ОбъемМ3 = ОбъемМ3;
	
КонецПроцедуры
