// Назначение модуля: Заполнение документа приема отходов реквизитами исходного рейса.
// Вызывает серверное заполнение документа приема по выбранному рейсу.
&НаКлиенте
Процедура ЗаполнитьИзРейса(Команда)
	ЗаполнитьИзРейсаНаСервере();
КонецПроцедуры
// Копирует из исходного рейса сведения об исполнителе, ТС, подрядчике и объекте приема.
&НаСервере
Процедура ЗаполнитьИзРейсаНаСервере()
	
	Если НЕ ЗначениеЗаполнено(Объект.Рейс) Тогда
		ВызватьИсключение "Выберите рейс.";
	КонецЕсли;
	
	РейсОбъект = Объект.Рейс.ПолучитьОбъект();
	// Автозаполнение шапки
	Объект.ТипИсполнителя = РейсОбъект.ТипИсполнителя;
	Объект.Подрядчик = РейсОбъект.Подрядчик;
	Объект.ТС = РейсОбъект.ТС; 
	Объект.ОбъектПриемаТКО = РейсОбъект.ОбъектПриема;
	// Считаем общий факт по выполненным точкам
	ОбщийОбъемМ3 = 0;
	
	Для Каждого Стр Из РейсОбъект.ТочкиМаршрута Цикл
		
		Если Стр.СтатусТочки <> Перечисления.СтатусТочкиМаршрута.Выполнен Тогда
			Продолжить;
		КонецЕсли;
		
		Если Стр.ФактОбъемМ3 <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОбщийОбъемМ3 = ОбщийОбъемМ3 + Стр.ФактОбъемМ3;
		
	КонецЦикла;
	
	Объект.ОбъемМ3 = ОбщийОбъемМ3;
	
КонецПроцедуры

