#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Получение данных для формирования электронного документа (ЭД).
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка.СчетНаОплатуПокупателю - ссылка на документ.
// 
// Возвращаемое значение:
//  Структура - структура данных для формирования электронного документа:
//   * ВыборкаШапки - ВыборкаИзРезультатаЗапроса - выборка с данными шапки документа
//   * ВыборкаТоваров - ВыборкаИзРезультатаЗапроса - выборка с данными табличной части Товары
//   * ТаблицаЭтаповГрафикаОплаты - ТаблицаЗначений - таблица этапов графика оплаты (если заполнен):
//     ** ДатаПлатежа - Дата - дата платежа по этапу
//     ** ПроцентПлатежа - Число - процент платежа от суммы документа
//     ** СуммаПлатежа - Число - сумма платежа по этапу
//   * ШтрихкодыКомбинаций - ТаблицаЗначений - штрихкоды по комбинации номенклатуры, характеристики и упаковки:
//     ** Штрихкод - Строка - штрихкод товара (уникальный для данной комбинации)
//     ** Номенклатура - СправочникСсылка.Номенклатура - ссылка на номенклатуру
//     ** Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - ссылка на характеристику
//     ** ЕдиницаИзмерения - СправочникСсылка.ЕдиницыИзмерения - ссылка на единицу измерения/упаковку
//   * ШтрихкодыНоменклатуры - ТаблицаЗначений         - все уникальные штрихкоды номенклатуры (без учета характеристики и упаковки):
//     ** Штрихкод - Строка - штрихкод товара
//     ** Номенклатура - СправочникСсылка.Номенклатура - ссылка на номенклатуру
//
Функция ПолучитьДанныеДляЭД(СсылкаНаОбъект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СчетНаОплатуПокупателю.Ссылка КАК Ссылка,
	|	СчетНаОплатуПокупателю.НомерЭД КАК Номер,
	|	СчетНаОплатуПокупателю.Дата КАК Дата,
	|	СчетНаОплатуПокупателю.Организация КАК Организация,
	|	СчетНаОплатуПокупателю.Контрагент КАК Контрагент,
	|	СчетНаОплатуПокупателю.БанковскийСчетОрганизации КАК БанковскийСчет,
	|	СчетНаОплатуПокупателю.БанковскийСчетОрганизации.НомерСчета КАК НомерСчета,
	|	СчетНаОплатуПокупателю.БанковскийСчетОрганизации.Банк КАК Банк,
	|	СчетНаОплатуПокупателю.БанковскийСчетОрганизации.БанкДляРасчетов КАК БанкДляРасчетов,
	|	СчетНаОплатуПокупателю.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	СчетНаОплатуПокупателю.ДоговорКонтрагента.Наименование КАК ДоговорНаименование,
	|	СчетНаОплатуПокупателю.ДоговорКонтрагента.НомерДоговора КАК ДоговорНомер,
	|	СчетНаОплатуПокупателю.ДоговорКонтрагента.ДатаДоговора КАК ДоговорДата,
	|	СчетНаОплатуПокупателю.СуммаДокумента КАК СуммаДокумента,
	|	СчетНаОплатуПокупателю.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	СчетНаОплатуПокупателю.Валюта КАК Валюта,
	|	СчетНаОплатуПокупателю.Валюта.Код КАК ВалютаКод,
	|	СчетНаОплатуПокупателю.Валюта.Наименование КАК ВалютаНаименование,
	|	СчетНаОплатуПокупателю.Валюта.НаименованиеПолное КАК ВалютаНаименованиеПолное,
	|	СчетНаОплатуПокупателю.ДокументОснование КАК ДокументОснование,
	|	СчетНаОплатуПокупателю.ИдентификаторПлатежа КАК ИдентификаторПлатежа,
	|	СчетНаОплатуПокупателю.ОблагаетсяНДСУПокупателя КАК ОблагаетсяНДСУПокупателя,
	|	СчетНаОплатуПокупателю.БанковскийСчетКомментарий КАК БанковскийСчетКомментарий,
	|	ВЫБОР
	|		КОГДА СчетНаОплатуПокупателю.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.СчетОферта)
	|			ТОГДА ""1""
	|		ИНАЧЕ ""0""
	|	КОНЕЦ КАК Функция,
	|	ЕСТЬNULL(СчетНаОплатуПокупателю.ДокументОснование, НЕОПРЕДЕЛЕНО) <> НЕОПРЕДЕЛЕНО КАК ЕстьОснованиеСчета,
	|	ПРЕДСТАВЛЕНИЕ(СчетНаОплатуПокупателю.ДокументОснование) КАК ОснованиеСчета,
	|	ЕСТЬNULL(СчетНаОплатуПокупателю.ДокументОснование.ПредставлениеНомера, """") КАК НомерОснованияСчета,
	|	ЕСТЬNULL(СчетНаОплатуПокупателю.ДокументОснование.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОснованияСчета,
	|	СчетНаОплатуПокупателю.ПолучательДенежныхСредств КАК ПолучательДенежныхСредств,
	|	СчетНаОплатуПокупателю.Плательщик КАК Плательщик,
	|	СчетНаОплатуПокупателю.Грузоотправитель КАК Грузоотправитель,
	|	СчетНаОплатуПокупателю.Грузополучатель КАК Грузополучатель,
	|	СчетНаОплатуПокупателю.ВидДокумента КАК ВидДокумента
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
	|ГДЕ
	|	СчетНаОплатуПокупателю.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
	|	Товары.Номенклатура.Артикул КАК НоменклатураАртикул,
	|	Товары.Номенклатура.СтавкаНДС КАК НоменклатураСтавкаНДС,
	|	Товары.Номенклатура.ВидНоменклатуры.ТипНоменклатуры КАК ТипНоменклатуры,
	|	Товары.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(Товары.Характеристика.Наименование, """") КАК ХарактеристикаНаименование,
	|	СправочникНоменклатура.ЕдиницаИзмерения КАК БазоваяЕдиницаСсылка,
	|	&ДанныеБазовойЕдиницы,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	&ДанныеУпаковки,
	|	ВЫБОР
	|		КОГДА Товары.Количество = 0
	|			ТОГДА Товары.КоличествоУпаковок
	|		ИНАЧЕ Товары.Количество
	|	КОНЕЦ КАК Количество,
	|	Товары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Товары.Цена КАК Цена,
	|	Товары.СуммаСкидки КАК СуммаСкидки,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.СуммаСНДС КАК СуммаСНДС,
	|	Товары.СуммаСНДС - Товары.СуммаНДС КАК СуммаБезНДС,
	|	Товары.Содержание КАК Содержание,
	|	ЕСТЬNULL(Товары.СтранаПроисхождения.Код, """") КАК СтранаПроисхожденияКод,
	|	ЕСТЬNULL(Товары.СтранаПроисхождения.Наименование, """") КАК СтранаПроисхожденияНаименование,
	|	Товары.Номенклатура.Код КАК НоменклатураКод,
	|	Товары.КодТНВЭД КАК КодТНВЭД
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО (СправочникНоменклатура.Ссылка = Товары.Номенклатура)
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГрафикОплаты.ДатаПлатежа КАК ДатаПлатежа,
	|	ГрафикОплаты.ПроцентПлатежа КАК ПроцентПлатежа,
	|	ГрафикОплаты.СуммаПлатежа КАК СуммаПлатежа
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю.ЭтапыГрафикаОплаты КАК ГрафикОплаты
	|ГДЕ
	|	ГрафикОплаты.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ГрафикОплаты.ДатаПлатежа";
	
	ОбменСКонтрагентамиКЭДО.ИнициализацияТекстаЗапросаПоискаШтрихкодовПоВременнойТаблицеТоваров(Запрос.Текст, Метаданные.Документы.СчетНаОплатуПокупателю.Имя);
	
	Справочники.ЕдиницыИзмерения.ДополнитьЗапросДаннымиЕдиницыИзмеренияУпаковки(
		Запрос.Текст, "&ДанныеБазовойЕдиницы", "СправочникНоменклатура.ЕдиницаИзмерения", "БазоваяЕдиница", Истина);
		
	Справочники.ЕдиницыИзмерения.ДополнитьЗапросДаннымиЕдиницыИзмеренияУпаковки(
		Запрос.Текст, "&ДанныеУпаковки", "Товары.ЕдиницаИзмерения", "ЕдиницаИзмерения");
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ВыборкаШапки",   МассивРезультатов[0].Выбрать());
	СтруктураДанных.Вставить("ВыборкаТоваров", МассивРезультатов[1].Выбрать());
	Если НЕ МассивРезультатов[2].Пустой() Тогда
		СтруктураДанных.Вставить("ТаблицаЭтаповГрафикаОплаты", МассивРезультатов[2].Выгрузить());
	КонецЕсли;
	
	ШтрихкодыКомбинаций = МассивРезультатов[6].Выгрузить();
	ШтрихкодыКомбинаций.Индексы.Добавить("Номенклатура, Характеристика, ЕдиницаИзмерения");
	СтруктураДанных.Вставить("ШтрихкодыКомбинаций", ШтрихкодыКомбинаций);

	ШтрихкодыНоменклатуры = МассивРезультатов[7].Выгрузить();
	ШтрихкодыНоменклатуры.Индексы.Добавить("Номенклатура");
	СтруктураДанных.Вставить("ШтрихкодыНоменклатуры", ШтрихкодыНоменклатуры);

	//@skip-check constructor-function-return-section
	Возврат СтруктураДанных;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом
//	Параметры:
//  Ограничение - см. УправлениеДоступомПереопределяемый.ПриЗаполненииОграниченияДоступа.Ограничение.
//
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// СтандартныеПодсистемы.ГрупповоеИзменениеОбъектов

// Возвращает реквизиты объекта, которые не разрешается редактировать
// с помощью обработки группового изменения реквизитов.
//
// Возвращаемое значение:
//  Массив из Строка - список имен реквизитов объекта.
Функция РеквизитыНеРедактируемыеВГрупповойОбработке() Экспорт
	
	НеРедактируемыеРеквизиты = Новый Массив;
	НеРедактируемыеРеквизиты.Добавить("ВидДокумента");
	Возврат НеРедактируемыеРеквизиты;
	
КонецФункции

// Конец СтандартныеПодсистемы.ГрупповоеИзменениеОбъектов

#КонецОбласти

#КонецОбласти

#КонецЕсли

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("НомерЭД");
	Поля.Добавить("Дата");
	Поля.Добавить("ВидДокумента");
	Поля.Добавить("Ссылка");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Представление = КлиентЭДОКлиентСервер.ПредставлениеИсходящегоДокументаПоВиду(Данные);
	
КонецПроцедуры

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Параметры:
//  ВидФормы - Строка
//  Параметры - Структура
//  ВыбраннаяФорма - Строка
//  ДополнительнаяИнформация - Структура
//  СтандартнаяОбработка - Булево
Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	ИнтерфейсКлиентЭДОВызовСервера.ОбработкаПолученияФормыУчетногоДокумента(
		ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецЕсли

#КонецОбласти
