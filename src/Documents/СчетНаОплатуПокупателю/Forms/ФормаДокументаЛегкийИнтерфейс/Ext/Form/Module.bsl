	СформироватьПредставлениеСодержанияСтроки(СтрокаТаблицы);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЭтапыГрафикаОплаты

&НаКлиенте
Процедура ЭтапыГрафикаОплатыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ИтогСуммаСНДС = Объект.Товары.Итог("СуммаСНДС");
	ТекущиеДанные.СуммаПлатежа = ИтогСуммаСНДС - Объект.ЭтапыГрафикаОплаты.Итог("СуммаПлатежа");
	ТекущиеДанные.ПроцентПлатежа = ?(ИтогСуммаСНДС = 0, 0, 100 * ТекущиеДанные.СуммаПлатежа / ИтогСуммаСНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыГрафикаОплатыПроцентПлатежаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЭтапыГрафикаОплаты.ТекущиеДанные;
	ТекущиеДанные.СуммаПлатежа = Объект.Товары.Итог("СуммаСНДС") * ТекущиеДанные.ПроцентПлатежа / 100;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыГрафикаОплатыСуммаПлатежаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЭтапыГрафикаОплаты.ТекущиеДанные;
	ИтогСуммаСНДС = Объект.Товары.Итог("СуммаСНДС");
	ТекущиеДанные.ПроцентПлатежа = ?(ИтогСуммаСНДС = 0, 0, 100 * ТекущиеДанные.СуммаПлатежа / ИтогСуммаСНДС);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьИзВнешнегоФайла(Команда)
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ЗагружатьЦену", Истина);
	ПараметрыФормы.Вставить("ЗагружатьКоличество", Истина);
	ПараметрыФормы.Вставить("ЗагружатьЕдиницыИзмерения", Истина);
	
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьИзВнешнегоФайлаЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.ЗагрузкаДанныхИзВнешнихФайлов.Форма.Форма",
		ПараметрыФормы,,,,,Оповещение);
	
КонецПроцедуры

#Область ОбменСКонтрагентами
// ЭлектронноеВзаимодействие.ОбменСКонтрагентами

&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуЭДО(Команда)
	ЭлектронноеВзаимодействиеКлиент.ВыполнитьПодключаемуюКомандуЭДО_ЛегкийКлиентЭДО(Команда, ЭтотОбъект, Объект);
КонецПроцедуры

// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
#КонецОбласти // ОбменСКонтрагентами

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СформироватьПредставлениеСодержанияСтроки(СтрокаТаблицы)
	
	ПредставлениеСодержания  = КлиентЭДОКлиентСервер.ПолучитьПредставлениеСодержания(СтрокаТаблицы.Номенклатура,
		СтрокаТаблицы.Характеристика);
	СтрокаТаблицы.ПредставлениеСодержания = ПредставлениеСодержания;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	КлиентЭДО.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект);
	КлиентЭДО.УстановитьУсловноеОформлениеКоличестваИЕдиницыИзмерения(ЭтотОбъект);
	
	КлиентЭДО.УстановитьУсловноеОформлениеПредставленияСодержания(ЭтотОбъект, 
		"ТоварыСодержание", "Объект.Товары.ПредставлениеСодержания",
		"Объект.Товары.Содержание",	"Объект.Товары.Номенклатура");

КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьЗаголовокФормы();
	
	КлиентЭДО.НастроитьВидимостьОрганизацииВФорме(ЭтотОбъект, "Организация");
	
	КлиентЭДО.ЗаполнитьПризнакИспользованияХарактеристик(Объект.Товары);
	
	КлиентЭДО.ЗаполнитьПредставленияСодержаний(Объект.Товары);
	
	КлиентЭДО.ЗаполнитьВариантыРасчетаНДС(ЭтотОбъект);
	
	КлиентЭДО.ЗаполнитьТипНоменклатуры(Объект.Товары);
	
	Элементы.ТоварыСуммаСНДС.Видимость = Не Объект.ЦенаВключаетНДС;
	
	УстановитьВидимостьПолейНДС(ЭтотОбъект);
	
	УстановитьВидимостьКомментарияКБанковскомуСчету();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ПредставлениеВидаДокумента = НСтр("ru = 'Счет покупателю'");
	Если Объект.ВидДокумента = Перечисления.ВидыДокументов.СчетОферта Тогда
		ПредставлениеВидаДокумента = НСтр("ru = 'Счет-оферта'");
	КонецЕсли;
	
	Представление = "";
	Если Объект.Ссылка.Пустая() Тогда
		Представление = СтрШаблон(НСтр("ru = '%1 (создание)'"), ПредставлениеВидаДокумента);
	Иначе
		Представление = СтрШаблон(НСтр("ru = '%1 %2 от %3'"), ПредставлениеВидаДокумента,
			Объект.НомерЭД, Формат(Объект.Дата, "ДЛФ=D"));
	КонецЕсли;
	
	ЭтотОбъект.Заголовок = Представление;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОсновнойБанковскийСчет(Знач Организация)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ОсновнойБанковскийСчет", Истина);
КонецФункции

&НаКлиенте
Процедура ЗагрузитьИзВнешнегоФайлаЗавершение(Результат, Контекст) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементКоллекции Из Результат Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементКоллекции);
		КлиентЭДОКлиентСервер.ПриИзмененииКоличествоЦена(НоваяСтрока, Объект.ЦенаВключаетНДС);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКлючевыхРеквизитов()
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ИнтерфейсКлиентЭДО.ЗаполнитьДанныеПоФорматамЭлектронныхДокументовВФормеДокумента(
		ЭтотОбъект, РеквизитФормыВЗначение("Объект"));
	ИнтерфейсКлиентЭДОКлиентСервер.НастроитьПоляФорматаЭлектронногоДокументаНаФормеДокумента(ЭтотОбъект);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииВариантаРасчетаНДС()
	
	КлиентЭДОКлиентСервер.ПриИзмененииВариантаРасчетаНДС(ЭтотОбъект);
	УстановитьВидимостьПолейНДС(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПолейНДС(Форма)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	ВидимостьНДС = Не Объект.ОблагаетсяНДСУПокупателя;
	Элементы.ТоварыСтавкаНДС.Видимость = ВидимостьНДС;
	Элементы.ТоварыСуммаНДС.Видимость  = ВидимостьНДС;
	Элементы.ТоварыСуммаСНДС.Видимость = ВидимостьНДС;
	Элементы.ИтогиВсегоНДС.Видимость   = ВидимостьНДС;
	
	Элементы.ТоварыСуммаСНДС.Видимость = Не Объект.ЦенаВключаетНДС;
	
КонецПроцедуры

&НаСервере
Процедура БанковскийСчетОрганизацииПриИзмененииНаСервере()
	УстановитьВидимостьКомментарияКБанковскомуСчету();
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьКомментарияКБанковскомуСчету()
	
	БанковскийСчетЗаполнен = ЗначениеЗаполнено(Объект.БанковскийСчетОрганизации);
	Элементы.БанковскийСчетКомментарий.Доступность = БанковскийСчетЗаполнен;
	Элементы.БанковскийСчетКомментарий.ПодсказкаВвода = ?(БанковскийСчетЗаполнен, "", НСтр("ru = 'Для заполнения выберите банковский счет.'"));
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	Объект.БанковскийСчетОрганизации = ОсновнойБанковскийСчет(Объект.Организация);
	БанковскийСчетОрганизацииПриИзмененииНаСервере();
	
КонецПроцедуры

#КонецОбласти
