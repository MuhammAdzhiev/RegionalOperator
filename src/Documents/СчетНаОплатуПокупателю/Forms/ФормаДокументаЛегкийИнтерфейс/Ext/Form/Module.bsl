&НаКлиенте
Процедура ТоварыСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	ТекущиеДанные.СуммаСкидки = 0;
	КлиентЭДОКлиентСервер.ПриИзмененииСумма(ТекущиеДанные, Объект.ЦенаВключаетНДС);
	
