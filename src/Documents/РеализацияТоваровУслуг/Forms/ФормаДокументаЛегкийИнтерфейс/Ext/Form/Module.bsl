&НаКлиенте
Процедура ТоварыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		СтрокаТабличнойЧасти = Элемент.ТекущиеДанные;
		СтрокаТабличнойЧасти.КоличествоУпаковокДоКорректировки  = 0;
		СтрокаТабличнойЧасти.ЦенаДоКорректировки        = 0;
		СтрокаТабличнойЧасти.СуммаДоКорректировки       = 0;
		СтрокаТабличнойЧасти.СуммаНДСДоКорректировки    = 0;
		СтрокаТабличнойЧасти.СуммаСНДСДоКорректировки   = 0;
		СтрокаТабличнойЧасти.СуммаАкцизаДоКорректировки = 0;
		СтрокаТабличнойЧасти.МаркируемыеУпаковки = "";	
		СтрокаТабличнойЧасти.КодыУпаковокМаркируемойПродукции.Очистить();
		СтрокаТабличнойЧасти.МаркируемыеУпаковкиДоКорректировки = "";	
		СтрокаТабличнойЧасти.КодыУпаковокМаркируемойПродукцииДоКорректировки.Очистить();
		СтрокаТабличнойЧасти.РНПТ = "";
		СтрокаТабличнойЧасти.ДанныеАмортизации = "";
		ЗаполнитьЗаголовкиСтрок(СтрокаТабличнойЧасти);
	КонецЕсли;
	
	КлиентЭДОКлиент.ИдентификаторыСтрокПриНачалеРедактированияТаблицы(Элемент, НоваяСтрока, Копирование);
	КлиентЭДОКлиент.КэшироватьТекущуюСтроку(Элементы.Товары, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные.КоличествоУпаковокДоКорректировки > 0 Тогда
		ТекстСообщения = 
			НСтр("ru = 'Вместо удаления строки исходного документа очистите суммовые и количественные показатели.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, ,
			"Товары[" + Формат(ТекущиеДанные.НомерСтроки - 1, "ЧН=0") + "].Количество", "Объект", Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные;
	ЗначенияРеквизитов = КлиентЭДОВызовСервера.РеквизитыНоменклатуры(
		СтрокаТаблицы.Номенклатура, "ЕдиницаИзмерения,СтавкаНДС,КодТНВЭД,ЦенаОптовая");
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЗначенияРеквизитов,, "КодТНВЭД");
	СтрокаТаблицы.СтавкаНДСДоКорректировки = ЗначенияРеквизитов.СтавкаНДС;
	СтрокаТаблицы.Цена = ЗначенияРеквизитов.ЦенаОптовая;
	
	КлиентЭДОКлиентСервер.ПриИзмененииСтавкаНДС(СтрокаТаблицы, Объект.ЦенаВключаетНДС);
	
	ЗаполнитьПредставлениеСодержанияСтроки(СтрокаТаблицы, Истина);
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
		СтрокаТаблицы.КодТНВЭД = ?(ЗначениеЗаполнено(ЗначенияРеквизитов.КодТНВЭД), ЗначенияРеквизитов.КодТНВЭД, СтрокаТаблицы.КодТНВЭД);
		
	Иначе
		СтрокаТаблицы.КодТНВЭД = "";
		
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, "ПараметрыИнтеграцииГосИС") Тогда
		ТоварыНоменклатураПриИзмененииНаСервере(Элементы.Товары.ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыХарактеристикаПриИзменении(Элемент)

	СтрокаТаблицы = Элементы.Товары.ТекущиеДанные; 	
	ЗаполнитьПредставлениеСодержанияСтроки(СтрокаТаблицы, Истина);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, "ПараметрыИнтеграцииГосИС") Тогда
		ТоварыХарактеристикаПриИзмененииНаСервере(Элементы.Товары.ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;
	
