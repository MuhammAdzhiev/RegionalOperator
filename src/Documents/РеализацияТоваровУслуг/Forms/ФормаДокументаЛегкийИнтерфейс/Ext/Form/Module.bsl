		Объект.Телефон = СтрЗаменить(УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Объект.Контрагент, Перечисления.ТипыКонтактнойИнформации.Телефон), " ", "");
	КонецЕсли;
	
