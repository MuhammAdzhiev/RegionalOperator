&НаКлиенте
Процедура ТоварыКодТНВЭДНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.Товары.ТекущаяСтрока;
	ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(ТекущаяСтрока);
	
	Если КлиентЭДОКлиентСервер.ИспользоватьМаркировкуВДокументеРеализацияТоваровУслуг(Объект)
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "МаркируемаяПродукция")
		И ТекущиеДанные.МаркируемаяПродукция Тогда
		
		СтандартнаяОбработка = Ложь;
			
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТекущаяСтрока",                           ТекущиеДанные.КодТНВЭД);
		ПараметрыФормы.Вставить("ВидПродукции",                            ТекущиеДанные.ВидПродукцииИС);
		ПараметрыФормы.Вставить("РежимВыбора",                             Истина);
		ПараметрыФормы.Вставить("ВозвращатьСсылкуНаЭлементКлассификатора", Ложь);
		
		ОткрытьФорму(
			"РегистрСведений.КодыТНВЭДИСМП.Форма.ФормаСписка", ПараметрыФормы, Элемент,,,,,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		НастройкиРежима = Новый Структура;
		НастройкиРежима.Вставить("РежимВыбораЭлемента", Истина);
		НастройкиРежима.Вставить("ОбработчикЗавершения",
			Новый ОписаниеОповещения("ЗаполнитьКодТНВЭДПослеВыбораИзСервиса", ЭтотОбъект));
		ОблачныеКлассификаторыКлиент.ПодобратьИзСервисаЭлементыТНВЭД(НастройкиРежима);
	
	КонецЕсли;
	
КонецПроцедуры

