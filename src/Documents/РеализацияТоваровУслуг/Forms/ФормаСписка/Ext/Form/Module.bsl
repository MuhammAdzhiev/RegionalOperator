// _Демо начало примера

&НаСервере
Процедура _ДемоДобавитьКомандыФормы()
	
	ГруппаКнопок           = Элементы.Добавить("ПодобратьНоменклатуруИзСервиса", Тип("ГруппаФормы"), КоманднаяПанель);
	ГруппаКнопок.Вид       = ВидГруппыФормы.Подменю;
	ГруппаКнопок.Заголовок = НСтр("ru = 'Демо: Загрузка маркетплейса'");
		
	Действие = "_ДемоСкачатьОтчетМаркетплейса";
	
	КомандаФормы = Команды.Добавить(Действие);
	КомандаФормы.Действие  = Действие;
	КомандаФормы.Заголовок = НСтр("ru = 'Демо: Скачать отчет маркетплейса'");
	
	НовыйЭлемент = Элементы.Добавить(Действие, Тип("КнопкаФормы"), ГруппаКнопок);
	НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	НовыйЭлемент.ИмяКоманды = Действие;
//	НовыйЭлемент.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанели;
	
	Действие = "_ДемоЗагрузитьОтчетМаркетплейса";
	
	КомандаФормы = Команды.Добавить(Действие);
	КомандаФормы.Действие  = Действие;
	КомандаФормы.Заголовок = НСтр("ru = 'Демо: Загрузить отчет маркетплейса'");
	
	НовыйЭлемент = Элементы.Добавить(Действие, Тип("КнопкаФормы"), ГруппаКнопок);
	НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	НовыйЭлемент.ИмяКоманды = Действие;
//	НовыйЭлемент.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанели;
	
КонецПроцедуры

