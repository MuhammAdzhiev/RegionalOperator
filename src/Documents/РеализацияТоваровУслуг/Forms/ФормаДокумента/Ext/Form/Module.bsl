	НастройкиРежима = Новый Структура;
	НастройкиРежима.Вставить("РежимВыбораЭлемента", Истина);
	НастройкиРежима.Вставить("ОбработчикЗавершения", Новый ОписаниеОповещения("ЗаполнитьКодТНВЭДПослеВыбораИзСервиса", ЭтотОбъект));
	ОблачныеКлассификаторыКлиент.ПодобратьИзСервисаЭлементыТНВЭД(НастройкиРежима);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРНПТНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	РежимКорректировки = Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОпераций.Корректировка");
	КлиентЭДОКлиент.ВвестиРНПТ(Элементы.Товары.ТекущиеДанные, Объект.СведенияПрослеживаемости, РежимКорректировки);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРНПТОчистка(Элемент, СтандартнаяОбработка)

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	КлиентЭДОКлиент.ОчиститьТаблицуПоИдентификаторуСтроки(
		Объект.СведенияПрослеживаемости, ТекущиеДанные.ИдентификаторСтроки);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПредставлениеДляАктированияЕИСОткрытие(Элемент, СтандартнаяОбработка)
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Контракт = ЭлектронноеАктированиеЕИСВызовСервера.ГосударственныйКонтрактДоговора(
		Объект.ДоговорКонтрагента);
	ЭлектронноеАктированиеЕИСКлиент.ОткрытьФормуСтрокиКонтракта(
		Контракт,
		ТекущиеДанные.ИдентификаторДляАктированияЕИС,
		ЭтотОбъект,
		Истина);
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПредставлениеДляАктированияЕИСПриИзменении(Элемент)
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	СписокВыбора = Элемент.СписокВыбора;
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	ЭлектронноеАктированиеЕИСКлиент.ПриИзмененииИдентификатораДляАктированияЕИС(
		СписокВыбора, "Товары", ТекущиеДанные);
	ДанныеСтроки = ЭлектронноеАктированиеЕИСВызовСервера.ДанныеСтрокиКонтрактаПоИдентификатору(
		Объект.ДоговорКонтрагента,
		ТекущиеДанные.ИдентификаторДляАктированияЕИС);
	ТекущиеДанные.Цена = ДанныеСтроки.Цена;
	КлиентЭДОКлиентСервер.ПриИзмененииКоличествоЦена(ТекущиеДанные, Объект.ЦенаВключаетНДС);
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
КонецПроцедуры
