&НаСервере
Процедура ЗаполнитьПоКонтрактуНаСервере()

	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	ДанныеДляЗаполнения =
		ЭлектронноеАктированиеЕИС.ДанныеДляЗаполненияТабличнойЧастиДокумента(Объект.ДоговорКонтрагента);
	
	Если ДанныеДляЗаполнения = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='В договоре не указан государственный контракт.'"));
		Возврат;
	КонецЕсли;
	
	Если ДанныеДляЗаполнения.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Номенклатура контракта не сопоставлена с данными БД.'"));
		Возврат;
	КонецЕсли;
	
	Объект.Товары.Очистить();
	Для Каждого ОбъектЗакупки Из ДанныеДляЗаполнения Цикл
		
		Если НЕ ЗначениеЗаполнено(ОбъектЗакупки.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		Строка = Объект.Товары.Добавить();
		
		// Дополнительные колонки для эл.актирования.
		Строка.ИдентификаторДляАктированияЕИС = ОбъектЗакупки.Идентификатор;
		Строка.СтранаПроизводителя = ОбъектЗакупки.СтранаПроизводителя;
		
		Строка.ЕдиницаИзмерения = КлиентЭлАктЕИС.НайтиСоздатьЕдиницуИзмерения(
			ОбъектЗакупки.ЕдиницаИзмеренияКод,
			ОбъектЗакупки.ЕдиницаИзмеренияНаименование);
		Строка.СтранаПроисхождения = ОбъектЗакупки.СтранаПроисхождения;
		
		Строка.Номенклатура = ОбъектЗакупки.Номенклатура;
		Строка.Содержание = ОбъектЗакупки.Наименование;
		Если Строка.Количество = 0 Тогда
			Количество = 1;
		Иначе
			Количество = Строка.Количество;
		КонецЕсли;
		Строка.Количество = Количество;
		Строка.КоличествоУпаковок = Количество;
		Строка.Цена = ОбъектЗакупки.Цена;
		Строка.СтавкаНДС = ОбъектЗакупки.СтавкаНДС;
		
		КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(Строка);
		КлиентЭДОКлиентСервер.ПриИзмененииКоличествоЦена(Строка, Объект.ЦенаВключаетНДС);
		
	КонецЦикла;
	
	КлиентЭлАктЕИС.ЗаполнитьПредставленияСтрокКонтракта(ЭтотОбъект, "Товары");
	
	ГосКонтракт = ЭлектронноеАктированиеЕИС.ГосударственныйКонтрактДоговора(Объект.ДоговорКонтрагента);
	Объект.ГосЗакупкаДатаКонтракта = ГосКонтракт.ДатаЗаключенияКонтракта;
	// Для ЕИС в УПД выгружается номер госконтракта.
	Если ЗначениеЗаполнено(ГосКонтракт.Номер) Тогда
		Объект.ГосЗакупкаНомерКонтракта = ГосКонтракт.Номер;
	Иначе
		Объект.ГосЗакупкаНомерКонтракта = "б/н";
	КонецЕсли;
	
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоКонтрактуПослеВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоКонтрактуНаСервере();
		ОбновитьВидимостьКомандПечати();
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьПредставлениеСодержанияСтроки(СтрокаТаблицы, Заменять = Ложь)
	Если ПустаяСтрока(СтрокаТаблицы.Содержание) ИЛИ Заменять Тогда
		СтрокаТаблицы.Содержание = "";
		ПредставлениеСодержания  = КлиентЭДОКлиентСервер.ПолучитьПредставлениеСодержания(СтрокаТаблицы.Номенклатура, СтрокаТаблицы.Характеристика);
		СтрокаТаблицы.ПредставлениеСодержания = ПредставлениеСодержания;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыНоменклатура");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыХарактеристика");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыЕдиницаИзмерения");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСодержание");
	ГруппаОтбора1 = КлиентЭДОКлиентСервер.ДобавитьГруппуОтбора(ЭлементОформления.Отбор.Элементы,
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбора1,
		"РазрешитьРедактирование", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбора1,
		"Объект.Товары.КоличествоУпаковокДоКорректировки", ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыКоличество");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыЦена");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСумма");
	КлиентЭДОКлиентСервер.ДобавитьОформляемоеПоле(ЭлементОформления.Поля, "ТоварыСтавкаНДС");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,
		"Объект.Товары.КоличествоУпаковокДоКорректировки", ВидСравненияКомпоновкиДанных.Заполнено);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	КлиентЭДО.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект);
	КлиентЭДО.УстановитьУсловноеОформлениеКоличестваИЕдиницыИзмерения(ЭтотОбъект);
	
	КлиентЭДО.УстановитьУсловноеОформлениеПредставленияСодержания(ЭтотОбъект, "ТоварыСодержание", "Объект.Товары.ПредставлениеСодержания", 
		"Объект.Товары.Содержание", "Объект.Товары.Номенклатура");
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	Если Объект.ВидДокумента = Перечисления.ВидыДокументов.ТоварнаяНакладная Тогда
		ПодготовитьФормуТоварнаяНакладная();

	ИначеЕсли Объект.ВидДокумента = Перечисления.ВидыДокументов.АктВыполненныхРабот Тогда
		ПодготовитьФормуАктВыполненныхРабот();
		
	ИначеЕсли Объект.ВидДокумента = Перечисления.ВидыДокументов.АктНаПередачуПрав Тогда
		ПодготовитьФормуАктНаПередачуПрав();
		
	ИначеЕсли Объект.ВидДокумента = Перечисления.ВидыДокументов.СведенияКомиссионера Тогда
		ПодготовитьФормуСведенияКомиссионера();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуТоварнаяНакладная()
	
	ПодготовитьФормуДокумента();
	
	КлиентЭДО.ЗаполнитьВариантыРасчетаНДС(ЭтотОбъект);
	КлиентЭДО.ЗаполнитьТипНоменклатуры(Объект.Товары);
	КлиентЭДО.ЗаполнитьПредставленияРНПТ(Объект.Товары, Объект.СведенияПрослеживаемости);	
	
	ЗаполнитьСписокАдресовДоставки();
	
	УстановитьВидимостьПолейНДС();
	
	Элементы.СведенияОВыбытииМаркированнойПродукции.Видимость = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуАктВыполненныхРабот()
	
	ПодготовитьФормуДокумента();
	
	КлиентЭДО.ЗаполнитьВариантыРасчетаНДС(ЭтотОбъект, Ложь);
	КлиентЭДО.ЗаполнитьТипНоменклатуры(Объект.Товары);
	
	Элементы.СтраницаТовары.Заголовок = НСтр("ru = 'Услуги'");
	Элементы.ТоварыГруппаСуммаАкциза.Видимость    = Ложь;
	Элементы.ТоварыНомерГТД.Видимость             = Ложь;
	Элементы.ТоварыСтранаПроисхождения.Видимость  = Ложь;
	Элементы.ТоварыДобавитьПоШтрихкоду.Видимость  = Ложь;
	Элементы.ТоварыМаркируемыеУпаковки.Видимость  = Ложь;
	Элементы.ТоварыМаркируемыеУпаковкиДоКорректировки.Видимость = Ложь;
	Элементы.ТоварыРНПТ.Видимость = Ложь;
	Элементы.ТоварыКомитент.Видимость = Ложь;
	Элементы.ТоварыДоговорСКомитентом.Видимость = Ложь;
	Элементы.ТоварыГруппаДанныеАмортизации.Видимость = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуАктНаПередачуПрав()
	
	ПодготовитьФормуДокумента();
	
	КлиентЭДО.ЗаполнитьВариантыРасчетаНДС(ЭтотОбъект, Ложь);
	КлиентЭДО.ЗаполнитьТипНоменклатуры(Объект.Товары);
	
	Элементы.ТоварыГруппаСуммаАкциза.Видимость    = Ложь;
	Элементы.ТоварыНомерГТД.Видимость             = Ложь;
	Элементы.ТоварыСтранаПроисхождения.Видимость  = Ложь;
	Элементы.ТоварыМаркируемыеУпаковки.Видимость  = Ложь;
	Элементы.ТоварыМаркируемыеУпаковкиДоКорректировки.Видимость = Ложь;
	Элементы.ТоварыСодержание.Видимость = Ложь;
	Элементы.ТоварыРНПТ.Видимость = Ложь;
	Элементы.ТоварыКомитент.Видимость = Ложь;
	Элементы.ТоварыДоговорСКомитентом.Видимость = Ложь;
	Элементы.ТоварыГруппаДанныеАмортизации.Видимость = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуСведенияКомиссионера()
	
	ПодготовитьФормуТоварнаяНакладная();
	
	Элементы.НомерЭД.Заголовок = НСтр("ru = 'Входящий №'");
	
	Элементы.ТоварыКомитент.Видимость = Ложь;
	Элементы.ТоварыДоговорСКомитентом.Видимость = Ложь;
	
	ИспользоватьСопоставлениеНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры");
	Элементы.ТоварыНоменклатура.Видимость = ИспользоватьСопоставлениеНоменклатуры;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуДокумента()
	
	УстановитьЗаголовокФормы();
	
	УстановитьСтатусДокумента();
	
	КлиентЭДО.ЗаполнитьПризнакИспользованияХарактеристик(Объект.Товары);
	
	КлиентЭДО.ЗаполнитьПредставленияСодержаний(Объект.Товары);
	
	КлиентЭДО.ЗаполнитьРеквизитыМаркировки(Объект);
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	КлиентЭлАктЕИС.ЗаполнитьРеквизитыЭлектронногоАктирования(Объект);
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	Элементы.ТоварыСуммаСНДС.Видимость = НЕ Объект.ЦенаВключаетНДС;
	
	УстановитьПредставлениеДокументаОснования();
	
	УстановитьВидимостьПолейДоКорректировки();
	
	СчетФактура = Документы.СчетФактураВыданный.СчетФактураДокумента(Объект.Ссылка);
	УстановитьПредставлениеСчетаФактуры(ЭтотОбъект);
	
	Если Объект.ВидОперации = Перечисления.ВидыОпераций.Реализация Тогда
		Элементы.ГруппаНомерИсправления.Видимость = Ложь;
		Элементы.ГруппаНомерДатаИсходногоДокумента.Видимость = Ложь;
		Элементы.ГруппаНомерДатаИсправленияИсходногоДокумента.Видимость = Ложь;
		Элементы.ГруппаНомерДатаИсправляемогоКорректировочногоДокумента.Видимость = Ложь;
		Элементы.РазрешитьРедактированиеРеквизитовОбъекта.Видимость = Ложь;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		Элементы.НомерЭД.ТолькоПросмотр = Истина;
		Элементы.РазрешитьРедактированиеРеквизитовОбъекта.Видимость = Ложь;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОпераций.Корректировка Тогда		
		Элементы.ГруппаНомерИсправления.Видимость = Ложь;
		Элементы.СтраницаСведенияОбОтгрузке.Видимость = Ложь;
		Элементы.ГруппаНомерДатаИсправляемогоКорректировочногоДокумента.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ЭтотОбъект.Заголовок = КлиентЭДОКлиентСервер.ПредставлениеИсходящегоДокумента(Объект, Объект.Ссылка.Пустая());
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтатусДокумента()
	
	СтатусДокумента = КлиентЭДО.СтатусДокумента(Объект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСчетаФактуры(Форма)
	
	Форма.СчетФактураПредставление = КлиентЭДОКлиентСервер.ПредставлениеСчетаФактуры(Форма.СчетФактура);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеДокументаОснования()
	
	МассивСтрок = Новый Массив;
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(
			Строка(Объект.ДокументОснование), ,
			ЦветаСтиля.ГиперссылкаЦвет, ,
			ПолучитьНавигационнуюСсылку(Объект.ДокументОснование)));
		
		МассивСтрок.Добавить("   ");
		
		Если Объект.ВидОперации = Перечисления.ВидыОпераций.Реализация Тогда
			
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(
				НСтр("ru = 'Очистить'"), ,
				ЦветаСтиля.ГиперссылкаЦвет, ,
				"ОчиститьДокументОснования"));
			
		Иначе
			
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(
				НСтр("ru = 'Изменить'"), ,
				ЦветаСтиля.ГиперссылкаЦвет, ,
				"ИзменитьДокументОснования"));
			
		КонецЕсли;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОпераций.Реализация Тогда
		
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(
			НСтр("ru='<Выбрать>'"), ,
			ЦветаСтиля.ГиперссылкаЦвет, ,
			"ВыбратьДокументОснования"));
		
	Иначе
		
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(
			СтрШаблон(НСтр("ru='%1 <не выбран>'"), Объект.ВидДокумента), ,
			WebЦвета.Кирпичный, ,
			"ИзменитьДокументОснования"));
		
	КонецЕсли;
	
	ДокументОснованиеПредставление = Новый ФорматированнаяСтрока(МассивСтрок);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьДокументОснования()
	
	ВыбратьЗаказПокупателя();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьДокументОснования()
	
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	ТипДокумента = ТипЗнч(Объект.ДокументОснование);
	
	Если ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		ВыбратьДокументРеализации();
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ВыбратьЗаказПокупателя();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьДокументРеализации();
	
	ЗначениеОтбора = Новый Структура;
	ЗначениеОтбора.Вставить("ВидДокумента", Объект.ВидДокумента);
	ЗначениеОтбора.Вставить("Проведен", Истина);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИсключитьДокумент", Объект.Ссылка);
	ПараметрыФормы.Вставить("Отбор", ЗначениеОтбора);
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьПослеВыбораДокументаРеализации", ЭтотОбъект);
	ОткрытьФорму("Документ.РеализацияТоваровУслуг.ФормаВыбора",
		ПараметрыФормы, ЭтотОбъект,,,,Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЗаказПокупателя();
	
	ЗначениеОтбора = Новый Структура;
	ЗначениеОтбора.Вставить("Проведен", Истина);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", ЗначениеОтбора);
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьПослеВыбораЗаказаПокупателя", ЭтотОбъект);
	ОткрытьФорму("Документ.ЗаказПокупателя.ФормаВыбора",
		ПараметрыФормы, ЭтотОбъект,,,,Оповещение);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьДокументОснования();
	
	Объект.ДокументОснование = Неопределено;
	УстановитьПредставлениеДокументаОснования();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПослеВыбораДокументаРеализации(Результат, Контекст) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		ЗаполнитьПослеВыбораДокументаРеализацииНаСервере(Результат);
		
		Если ЗначениеЗаполнено(ПоследнийКорректирующийДокумент) Тогда
			ТекстВопроса = НСтр("ru = 'Для указанного документа существуют более поздние исправления.
				|Использовать последнее введенное исправление?'");
				
			Оповещение = Новый ОписаниеОповещения("ВопросИспользоватьПоследнееИсправление", ЭтотОбъект);
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПослеВыбораДокументаРеализацииНаСервере(ВыбранноеЗначение)
	
	Модифицированность = Истина;
	ДанныеЗаполнения = Новый Структура("Основание, ВидОперации", ВыбранноеЗначение, Объект.ВидОперации);
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Заполнить(ДанныеЗаполнения);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	УстановитьПредставлениеДокументаОснования();
	УстановитьВидимостьПолейДоКорректировки();
	
	ЗаполнитьПоследнийКорректирующийДокумент();
	
	Для Каждого СтрокаТаблицы Из Объект.Товары Цикл
		ЗаполнитьПредставлениеСодержанияСтроки(СтрокаТаблицы);
	КонецЦикла;
	
	КлиентЭДО.ЗаполнитьПризнакИспользованияХарактеристик(Объект.Товары);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросИспользоватьПоследнееИсправление(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПослеВыбораДокументаРеализацииНаСервере(ПоследнийКорректирующийДокумент);
		ПоследнийКорректирующийДокумент = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПослеВыбораЗаказаПокупателя(Результат, Контекст) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		ЗаполнитьПослеВыбораЗаказаПокупателяНаСервере(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПослеВыбораЗаказаПокупателяНаСервере(ВыбранноеЗначение)
	
	Модифицированность = Истина;
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Заполнить(ВыбранноеЗначение);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	УстановитьПредставлениеДокументаОснования();
	
	Для Каждого СтрокаТаблицы Из Объект.Товары Цикл
		ЗаполнитьПредставлениеСодержанияСтроки(СтрокаТаблицы);
	КонецЦикла;
	
	КлиентЭДО.ЗаполнитьПризнакИспользованияХарактеристик(Объект.Товары);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолейДоКорректировки();
	
	ВидимостьДоКорректировки = Объект.ВидОперации = Перечисления.ВидыОпераций.Корректировка
		ИЛИ (ЗначениеЗаполнено(Объект.НомерИсправляемогоКорректировочногоДокумента)
			И ЗначениеЗаполнено(Объект.ДатаИсправляемогоКорректировочногоДокумента));
	
	Элементы.ТоварыГруппаЗаголовкиСтрок.Видимость       = ВидимостьДоКорректировки;
	Элементы.ТоварыКоличествоДоКорректировки.Видимость  = ВидимостьДоКорректировки;
	Элементы.ТоварыЦенаДоКорректировки.Видимость        = ВидимостьДоКорректировки;
	Элементы.ТоварыСтавкаНДСДоКорректировки.Видимость   = ВидимостьДоКорректировки;
	Элементы.ТоварыСуммаДоКорректировки.Видимость       = ВидимостьДоКорректировки;
	Элементы.ТоварыСуммаНДСДоКорректировки.Видимость    = ВидимостьДоКорректировки;
	Элементы.ТоварыСуммаСНДСДоКорректировки.Видимость   = ВидимостьДоКорректировки
		И НЕ Объект.ЦенаВключаетНДС;
	Элементы.ТоварыСуммаАкцизаДоКорректировки.Видимость = ВидимостьДоКорректировки;
	Элементы.ТоварыМаркируемыеУпаковкиДоКорректировки.Видимость = ВидимостьДоКорректировки;
	Элементы.ТоварыОбъемВТекстовомВыраженииДоКорректировки.Видимость = ВидимостьДоКорректировки;
	
	Если ВидимостьДоКорректировки Тогда
		Для Каждого СтрокаТаблицы Из Объект.Товары Цикл
			ЗаполнитьЗаголовкиСтрок(СтрокаТаблицы);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьЗаголовкиСтрок(СтрокаТаблицы)
	
	СтрокаТаблицы.НадписьДоКорректировки    = НСтр("ru = 'До корректировки:'");
	СтрокаТаблицы.НадписьПослеКорректировки = НСтр("ru = 'После корректировки:'");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолейНДС()
	
	ВидимостьНДС = НЕ Объект.ОблагаетсяНДСУПокупателя;
	Элементы.ТоварыГруппаСтавкаНДС.Видимость = ВидимостьНДС;
	Элементы.ТоварыГруппаСуммаНДС.Видимость = ВидимостьНДС;
	Элементы.ТоварыГруппаСуммаСНДС.Видимость = ВидимостьНДС;
	Элементы.ИтогиВсегоНДС.Видимость = ВидимостьНДС;
	
	Элементы.ТоварыСуммаСНДС.Видимость = НЕ Объект.ЦенаВключаетНДС;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииОрганизации();
	
	ПриИзмененииКлючевыхРеквизитовСостояниеЭДО();
	
	Объект.БанковскийСчетОрганизации = ОсновнойБанковскийСчет(Объект.Организация);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКонтрагента()
	
	ПриИзмененииКлючевыхРеквизитовСостояниеЭДО();
	
	Если НЕ ЗначениеЗаполнено(Объект.Грузополучатель) Тогда
		ЗаполнитьСписокАдресовДоставки();
		Объект.АдресДоставкиЗначенияПолей = "";
		Объект.АдресДоставки = "";
		Объект.АдресДоставкиЗначение = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииГрузополучателя()
	
	ЗаполнитьСписокАдресовДоставки();
	
	Объект.АдресДоставкиЗначенияПолей = "";
	Объект.АдресДоставки = "";
	Объект.АдресДоставкиЗначение = "";
	
КонецПроцедуры

&НаКлиенте
Процедура АдресДоставкиПослеИзменения(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Модифицированность = Истина;
		Объект.АдресДоставкиЗначенияПолей = Результат.КонтактнаяИнформация;
		Объект.АдресДоставки = Результат.Представление;
		Объект.АдресДоставкиЗначение = Результат.Значение;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВариантаРасчетаНДС();
	
	КлиентЭДОКлиентСервер.ПриИзмененииВариантаРасчетаНДС(ЭтотОбъект);
	УстановитьВидимостьПолейНДС();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОсновнойБанковскийСчет(Знач Организация)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ОсновнойБанковскийСчет", Истина);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПоследнийКорректирующийДокумент()
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		КорректирующийДокумент = Документы.РеализацияТоваровУслуг.ПоследнийКорректирующийДокумент(
			Объект.ДокументОснование);
		
		Если КорректирующийДокумент <> Объект.ДокументОснование
			И КорректирующийДокумент <> Объект.Ссылка Тогда
			ПоследнийКорректирующийДокумент = КорректирующийДокумент;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокАдресовДоставки()
	
	СписокАдресов = Элементы.АдресДоставки.СписокВыбора;
	СписокАдресов.Очистить();
	
	Если ЗначениеЗаполнено(Объект.Грузополучатель) Тогда
		Грузополучатель = Объект.Грузополучатель;
	ИначеЕсли ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Грузополучатель = Объект.Контрагент
	Иначе
		Объект.АдресДоставки = "";
		Возврат;
	КонецЕсли;
	
	ТаблицаКИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Грузополучатель,,, Ложь);
	
	Для Каждого СтрокаТаблицыКИ Из ТаблицаКИ Цикл
		
		Если СтрокаТаблицыКИ.Тип <> Перечисления.ТипыКонтактнойИнформации.Адрес Тогда
			Продолжить;
		КонецЕсли;
		
		СведенияОбАдресе = Новый Структура("ЗначенияПолей, Представление, ЗначениеJSON",
			СтрокаТаблицыКИ.ЗначенияПолей, СтрокаТаблицыКИ.Представление, СтрокаТаблицыКИ.Значение);
		
		СписокАдресов.Добавить(СведенияОбАдресе,
			СтрШаблон(НСтр("ru = '%1:  %2'"), СтрокаТаблицыКИ.Вид, СтрокаТаблицыКИ.Представление));
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьКомандПечати()
	
	Если ПодменюПечать <> Неопределено Тогда
		ПодменюПечать.Доступность = Объект.Товары.Количество() > 0;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПоШтрихкодуПослеПоиска(Результат, Контекст) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		Штрихкоды = Результат;
	Иначе
		Штрихкоды = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Результат);
	КонецЕсли;

	Для каждого ТекущийШтрихкод Из Штрихкоды Цикл
		
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущийШтрихкод);
		
		ЗначенияРеквизитов = КлиентЭДОВызовСервера.РеквизитыНоменклатуры(
			НоваяСтрока.Номенклатура, "СтавкаНДС, ЕдиницаИзмерения");
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЗначенияРеквизитов);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзВнешнегоФайлаЗавершение(Результат, Контекст) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементКоллекции Из Результат Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементКоллекции);
		КлиентЭДОКлиентСервер.ПриИзмененииКоличествоЦена(НоваяСтрока, Объект.ЦенаВключаетНДС);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РазрешитьРедактированиеРеквизитовОбъектаПослеВопроса(Ответ, Параметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Элементы.ТоварыКоличествоДоКорректировки.ТолькоПросмотр  = Ложь;
		Элементы.ТоварыЦенаДоКорректировки.ТолькоПросмотр        = Ложь;
		Элементы.ТоварыСтавкаНДСДоКорректировки.ТолькоПросмотр   = Ложь;
		Элементы.ТоварыСуммаДоКорректировки.ТолькоПросмотр       = Ложь;
		Элементы.ТоварыСуммаНДСДоКорректировки.ТолькоПросмотр    = Ложь;
		Элементы.ТоварыСуммаСНДСДоКорректировки.ТолькоПросмотр   = Ложь;
		Элементы.ТоварыСуммаАкцизаДоКорректировки.ТолькоПросмотр = Ложь;
		
		РазрешитьРедактирование = Истина;
		Элементы.РазрешитьРедактированиеРеквизитовОбъекта.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииКлючевыхРеквизитовСостояниеЭДО()
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ПараметрыПриИзменении = ОбменСКонтрагентами.ПараметрыПриИзмененииКлючевыхРеквизитовЭДО();
	
	ПараметрыПриИзменении.Форма                 = ЭтотОбъект;
	ПараметрыПриИзменении.ДокументСсылка        = Объект.Ссылка;
	ПараметрыПриИзменении.ДокументОбъект        = РеквизитФормыВЗначение("Объект");
	ПараметрыПриИзменении.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПриИзменении.ГруппаСостояниеЭДО    = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриИзмененииКлючевыхРеквизитовЭДО(ПараметрыПриИзменении);
	
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры

