&НаКлиенте
Процедура ЗаполнитьПоКонтракту(Команда)
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	Если Объект.Товары.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьПоКонтрактуПослеВопроса", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
			НСтр("ru='Перед заполнением табличная часть будет очищена. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет, ,
			КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьПоКонтрактуПослеВопроса(КодВозвратаДиалога.Да, Неопределено);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПоШтрихкоду(Команда)
	
	Контекст = Новый Структура("Штрихкод");
	Оповещение = Новый ОписаниеОповещения("ДобавитьПоШтрихкодуПослеПоиска", ЭтотОбъект, Контекст);
	КлиентЭДОКлиент.ПоискНоменклатурыПоШтрихкоду(Оповещение, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзВнешнегоФайла(Команда)
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ЗагружатьЦену", Истина);
	ПараметрыФормы.Вставить("ЗагружатьКоличество", Истина);
	ПараметрыФормы.Вставить("ЗагружатьЕдиницыИзмерения", Истина);
	
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьИзВнешнегоФайлаЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.ЗагрузкаДанныхИзВнешнихФайлов.Форма.Форма",
		ПараметрыФормы,,,,,Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура РазрешитьРедактированиеРеквизитовОбъекта(Команда)
	
	Оповещение = Новый ОписаниеОповещения("РазрешитьРедактированиеРеквизитовОбъектаПослеВопроса", ЭтотОбъект);
	
	ТекстВопроса = НСтр("ru = 'Не рекомендуется разрешать редактирование из-за риска рассогласования данных.'");
	
	ЗаголовокДиалога = НСтр("ru = 'Разрешение редактирования реквизитов'");
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Разрешить редактирование'"));
	Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Отмена'"));
	ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки,, КодВозвратаДиалога.Нет, ЗаголовокДиалога);
	
КонецПроцедуры

