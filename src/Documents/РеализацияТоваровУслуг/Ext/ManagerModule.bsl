Процедура ВывестиОбластьДанныхQRКодаВТабличныйДокумент(ТабличныйДокумент, ОбластьМакетаДанныеQRКода, Знач СсылкаНаОбъект, Знач ДанныеQRКодовПоДокументам)
	
	ВыводитьQRКодВПечатныхФормах = Ложь;
	Если ОбщегоНазначения.ПодсистемаСуществует("ЭлектронноеВзаимодействие.БизнесСеть") Тогда
		МодульБизнесСеть = ОбщегоНазначения.ОбщийМодуль("БизнесСеть");
		ИспользоватьБизнесСеть = МодульБизнесСеть.ИспользоватьОбменБизнесСеть();
		ИспользоватьQRКод = МодульБизнесСеть.ВыводитьQRКодНаПечатныхФормахДокументов();
		ВыводитьQRКодВПечатныхФормах = ИспользоватьБизнесСеть И ИспользоватьQRКод;
	КонецЕсли;

	Если ВыводитьQRКодВПечатныхФормах И ДанныеQRКодовПоДокументам <> Неопределено Тогда
		
		ДанныеQRКода = ДанныеQRКодовПоДокументам.Получить(СсылкаНаОбъект);
		
		Если ДанныеQRКода <> Неопределено Тогда
			ОбластьМакетаДанныеQRКода.Рисунки.КартинкаQRКода.Картинка = Новый Картинка(ДанныеQRКода.ИзображениеQRКода);
			ОбластьМакетаДанныеQRКода.Параметры.ПодсказкаQRКода = НСтр("ru = 'Скачать документ'");
			ОбластьМакетаДанныеQRКода.Параметры.ПубличнаяСсылкаQRКода = ДанныеQRКода.ПубличнаяСсылкаQRКода;
			ВывестиОбластьВТабличныйДокумент(ТабличныйДокумент, ОбластьМакетаДанныеQRКода, "ОбластьДанныеQRКода");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеКОбработкеДляПереходаНаНовуюВерсию_ЗаполнитьИдентификаторСтроки() 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|ГДЕ
	|	РеализацияТоваровУслугТовары.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТоваровУслугТовары.Ссылка
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(РеализацияТоваровУслугТовары.ИдентификаторСтроки) = """"";
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьДанные_ЗаполнитьИдентификаторСтроки(Объект, Записать) 
	
	НужноЗаполнитьИдентификатор = Истина;
	Для Каждого СтрокаТоваров Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТоваров.ИдентификаторСтроки) Тогда
			НужноЗаполнитьИдентификатор = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НужноЗаполнитьИдентификатор Тогда
		Записать = Истина;
		Для Каждого СтрокаТоваров Из Объект.Товары Цикл
			Если Не ЗначениеЗаполнено(СтрокаТоваров.ИдентификаторСтроки) Тогда
				КлиентЭДОКлиентСервер.ЗаполнитьИдентификаторСтроки(СтрокаТоваров);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеКОбработкеДляПереходаНаНовуюВерсию_ЗаполнитьСтавкуНДСДоКорректировки() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|ГДЕ
	|	Товары.КоличествоУпаковокДоКорректировки <> 0
	|	И Товары.СтавкаНДСДоКорректировки = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)
	|	И Товары.СтавкаНДС <> ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)";
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьДанные_ЗаполнитьСтавкуНДСДоКорректировки(Объект, Записать) 
	
	Для каждого СтрокаТовара Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТовара.КоличествоУпаковокДоКорректировки)
			И ЗначениеЗаполнено(СтрокаТовара.СтавкаНДС)
			И Не ЗначениеЗаполнено(СтрокаТовара.СтавкаНДСДоКорректировки) Тогда
			СтрокаТовара.СтавкаНДСДоКорректировки = СтрокаТовара.СтавкаНДС;
			Записать = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

