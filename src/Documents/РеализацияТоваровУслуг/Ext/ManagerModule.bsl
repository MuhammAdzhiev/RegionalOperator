Функция ПодготовитьДанныеДляПробитияЧека(ДокументРеализации) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОбщиеПараметры = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОперацииФискализацииЧека();
	
	РеквизитыОрганизация = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументРеализации.Организация, "НаименованиеПолное,ИНН,КПП,СистемаНалогообложения");
	
	ОбщиеПараметры.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
	
	ОбщиеПараметры.Электронно = Истина;
	
	Если ЗначениеЗаполнено(ДокументРеализации.Телефон) Тогда
		ОбщиеПараметры.ПокупательНомер = "+7" + УбратьРазделителиВНомереТелефона(ДокументРеализации.Телефон);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументРеализации.АдресЭП) Тогда
		ОбщиеПараметры.ПокупательEmail = ДокументРеализации.АдресЭП;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументРеализации.Контрагент) Тогда
		СведенияОКонтрагенте = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументРеализации.Контрагент, "НаименованиеПолное,ИНН,ЮрФизЛицо");
		Если СведенияОКонтрагенте.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо
			ИЛИ ЗначениеЗаполнено(СведенияОКонтрагенте.ИНН) Тогда
			ОбщиеПараметры.Получатель    = СведенияОКонтрагенте.НаименованиеПолное;
			ОбщиеПараметры.ПолучательИНН = СведенияОКонтрагенте.ИНН;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОбщиеПараметры.ПокупательНомер) И НЕ ЗначениеЗаполнено(ОбщиеПараметры.ПокупательEmail) Тогда
			EmailКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ДокументРеализации.Контрагент, Справочники.ВидыКонтактнойИнформации.EmailКонтрагента);
			ТелефонКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ДокументРеализации.Контрагент, Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);
			Если ЗначениеЗаполнено(EmailКонтрагента) Тогда
				ОбщиеПараметры.ПокупательEmail = EmailКонтрагента;
			КонецЕсли;
			Если ЗначениеЗаполнено(ТелефонКонтрагента) Тогда
				ОбщиеПараметры.ПокупательНомер = ТелефонКонтрагента;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ОбщиеПараметры.Кассир          = "Продавец";
	ОбщиеПараметры.Организация = ДокументРеализации.Организация;
	ОбщиеПараметры.ОрганизацияНазвание = РеквизитыОрганизация.НаименованиеПолное;
	ОбщиеПараметры.ОрганизацияИНН = РеквизитыОрганизация.ИНН;
	ОбщиеПараметры.ОрганизацияКПП = РеквизитыОрганизация.КПП;
	ОбщиеПараметры.ОблачнаяККТ = Истина;
	ОбщиеПараметры.ДокументОснование = ДокументРеализации; 
	Если ЗначениеЗаполнено(ДокументРеализации.СистемаНалогообложения) Тогда
		ОбщиеПараметры.СистемаНалогообложения = ДокументРеализации.СистемаНалогообложения;
	Иначе
		ОбщиеПараметры.СистемаНалогообложения = РеквизитыОрганизация.СистемаНалогообложения;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбщиеПараметры.СистемаНалогообложения) Тогда
		ОбщиеПараметры.СистемаНалогообложения = Перечисления.ТипыСистемНалогообложенияККТ.ОСН;
	КонецЕсли;
	
	СтрокаОплаты = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыСтрокиОплаты();
	СтрокаОплаты.Сумма = ДокументРеализации.СуммаДокумента;
	ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
	
	ДанныеДляИСМП = ДанныеДляИСМП(ДокументРеализации, ОбщиеПараметры);
	Для Каждого Товар Из ДокументРеализации.Товары Цикл
		
		МассивСтрокДляДобавленияВЧек = Новый Массив;
		МассивСтрокДляДобавленияВЧек.Добавить(Товар);
		
		Если ДанныеДляИСМП.Количество() > 0 Тогда
			СтрокиИСМП = ДанныеДляИСМП.НайтиСтроки(Новый Структура("ИдентификаторСтроки", Товар.ИдентификаторСтроки));
			Если СтрокиИСМП.Количество() > 0 Тогда
				МассивСтрокДляДобавленияВЧек = СтрокиИСМП;
			КонецЕсли;
		КонецЕсли;
		
		Для Каждого СтрокаДляДобавленияВЧек Из МассивСтрокДляДобавленияВЧек Цикл
			
			СтрокаПозицииЧека = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыФискальнойСтрокиЧека();
			РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Товар.Номенклатура, "НаименованиеПолное, ПризнакПредметаРасчета");
			СтрокаПозицииЧека.Наименование = РеквизитыНоменклатуры.НаименованиеПолное;
			СтрокаПозицииЧека.Количество   = СтрокаДляДобавленияВЧек.Количество;
			СтрокаПозицииЧека.Цена         = СтрокаДляДобавленияВЧек.Цена;
			СтрокаПозицииЧека.Сумма        = СтрокаДляДобавленияВЧек.СуммаСНДС;
			СтрокаПозицииЧека.СуммаНДС     = СтрокаДляДобавленияВЧек.СуммаНДС;
			Если СтрокаДляДобавленияВЧек.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
				СтрокаПозицииЧека.СтавкаНДС    = Неопределено;
			ИначеЕсли СтрокаДляДобавленияВЧек.СтавкаНДС = Перечисления.СтавкиНДС.НДС0 Тогда
				СтрокаПозицииЧека.СтавкаНДС    = 0;
			ИначеЕсли СтрокаДляДобавленияВЧек.СтавкаНДС = Перечисления.СтавкиНДС.НДС10 Тогда
				СтрокаПозицииЧека.СтавкаНДС    = 10;
			ИначеЕсли СтрокаДляДобавленияВЧек.СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
				СтрокаПозицииЧека.СтавкаНДС    = 110;
			ИначеЕсли СтрокаДляДобавленияВЧек.СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
				СтрокаПозицииЧека.СтавкаНДС    = 20;
			ИначеЕсли СтрокаДляДобавленияВЧек.СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
				СтрокаПозицииЧека.СтавкаНДС    = 120;
			ИначеЕсли СтрокаДляДобавленияВЧек.СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда
				СтрокаПозицииЧека.СтавкаНДС    = 22;
			ИначеЕсли СтрокаДляДобавленияВЧек.СтавкаНДС = Перечисления.СтавкиНДС.НДС22_122 Тогда
				СтрокаПозицииЧека.СтавкаНДС    = 122;
			ИначеЕсли СтрокаДляДобавленияВЧек.СтавкаНДС = Перечисления.СтавкиНДС.НДС18 Тогда
				СтрокаПозицииЧека.СтавкаНДС    = 18;
			ИначеЕсли СтрокаДляДобавленияВЧек.СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
				СтрокаПозицииЧека.СтавкаНДС    = 118;
			КонецЕсли;
			Если ЗначениеЗаполнено(РеквизитыНоменклатуры.ПризнакПредметаРасчета) Тогда
				СтрокаПозицииЧека.ПризнакПредметаРасчета = РеквизитыНоменклатуры.ПризнакПредметаРасчета;
			Иначе
				СтрокаПозицииЧека.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.Товар;
			КонецЕсли;
			КодЕдиницыИзмеренияПозицииЧека = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Товар.ЕдиницаИзмерения, "Код");
			СтрокаПозицииЧека.КодЕдиницыИзмерения = КодЕдиницыИзмеренияПозицииЧека; 
			
			СтрокаПозицииЧека.Вставить("РезультатРаспределенияШтрихкодов");
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаДляДобавленияВЧек, "РезультатРаспределенияШтрихкодов")
				И ЗначениеЗаполнено(СтрокаДляДобавленияВЧек.РезультатРаспределенияШтрихкодов) Тогда
				
				РезультатРаспределенияШтрихкодов = СтрокаДляДобавленияВЧек.РезультатРаспределенияШтрихкодов;
				
				СтрокаПозицииЧека.РезультатРаспределенияШтрихкодов = РезультатРаспределенияШтрихкодов;
				
				ПолныйКодМаркировки = РезультатРаспределенияШтрихкодов.ПолныйКодМаркировки;
				Если ЗначениеЗаполнено(ПолныйКодМаркировки) Тогда
					СтрокаПозицииЧека.ШтрихкодBase64 = ПолныйКодМаркировки;
					СтрокаПозицииЧека.КонтрольнаяМарка = ПолныйКодМаркировки;
				КонецЕсли;
				
				Если РезультатРаспределенияШтрихкодов.ЧастичноеВыбытие Тогда
						СтрокаПозицииЧека.ДробноеКоличество.Числитель   = РезультатРаспределенияШтрихкодов.Количество;
						СтрокаПозицииЧека.ДробноеКоличество.Знаменатель = РезультатРаспределенияШтрихкодов.ЕмкостьПотребительскойУпаковки;
						
						Если РезультатРаспределенияШтрихкодов.Количество > 1 Тогда
							
							Упаковка = СтрокаДляДобавленияВЧек.ЕдиницаИзмерения;
							Если НЕ ЗначениеЗаполнено(Упаковка) Тогда
								Упаковка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДляДобавленияВЧек.Номенклатура, "ЕдиницаИзмерения");
							КонецЕсли;
							
							УпаковкаНаименование = "ед";
							Если ЗначениеЗаполнено(Упаковка) Тогда
								УпаковкаНаименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Упаковка, "Наименование");
							КонецЕсли;
							УпаковкаНаименование = УпаковкаНаименование + ".";
							
							Валюта = ДокументРеализации.ВалютаДокумента;
							ЦенаЕдиницы = Окр(СтрокаДляДобавленияВЧек.Цена / РезультатРаспределенияШтрихкодов.Количество, 2);
							
							ОписаниеЧастичногоВыбытия = СтрШаблон(
							НСтр("ru = ' (%1 %2, цена: %3 %4/%5)'"),
							РезультатРаспределенияШтрихкодов.Количество,
							УпаковкаНаименование,
							ЦенаЕдиницы,
							Валюта,
							УпаковкаНаименование);
							
							СтрокаПозицииЧека.Наименование = СтрокаПозицииЧека.Наименование
							+ ОписаниеЧастичногоВыбытия;
						КонецЕсли;
					
				КонецЕсли;
				
				Если ЗначениеЗаполнено(РезультатРаспределенияШтрихкодов.РазрешительныйРежимИдентификаторЗапросаГИСМТ) Тогда
					СтрокаПозицииЧека.ЗапросПроверкиКода.ИдентификаторЗапроса
					= РезультатРаспределенияШтрихкодов.РазрешительныйРежимИдентификаторЗапросаГИСМТ;
					СтрокаПозицииЧека.ЗапросПроверкиКода.ВременнаяМетка
					= РезультатРаспределенияШтрихкодов.РазрешительныйРежимДатаЗапросаГИСМТ;
				КонецЕсли;
				
				КонецЕсли;
				
				
				
				ОбщиеПараметры.ПозицииЧека.Добавить(СтрокаПозицииЧека);
			КонецЦикла;
			
		КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ОбщиеПараметры;
	
КонецФункции // ПодготовитьДанныеДляПробитияЧека() 

#КонецОбласти

