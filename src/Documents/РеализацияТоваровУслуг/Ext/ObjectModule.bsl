#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("Основание") И ДанныеЗаполнения.Свойство("ВидОперации") Тогда
	
		ДокументОснование = ДанныеЗаполнения.Основание;
		ВидОперации       = ДанныеЗаполнения.ВидОперации;
		
		ВидДокумента                   = ДокументОснование.ВидДокумента;
		БанковскийСчетОрганизации      = ДокументОснование.БанковскийСчетОрганизации;
		Валюта                         = ДокументОснование.Валюта;
		Грузоотправитель               = ДокументОснование.Грузоотправитель;
		Грузополучатель                = ДокументОснование.Грузополучатель;
		ДатаОтгрузки                   = ДокументОснование.ДатаОтгрузки;
		ДатаТранспортнойНакладной      = ДокументОснование.ДатаТранспортнойНакладной;
		ДоговорКонтрагента             = ДокументОснование.ДоговорКонтрагента;
		ИдентификаторГосКонтракта      = ДокументОснование.ИдентификаторГосКонтракта;
		Контрагент                     = ДокументОснование.Контрагент;
		НомерТранспортнойНакладной     = ДокументОснование.НомерТранспортнойНакладной;
		Организация                    = ДокументОснование.Организация;
		Перевозчик                     = ДокументОснование.Перевозчик;
		СведенияОТранспортировкеИГрузе = ДокументОснование.СведенияОТранспортировкеИГрузе;
		ИныеСведенияОбОтгрузке         = ДокументОснование.ИныеСведенияОбОтгрузке;
		ОблагаетсяНДСУПокупателя       = ДокументОснование.ОблагаетсяНДСУПокупателя;
		ЦенаВключаетНДС                = ДокументОснование.ЦенаВключаетНДС;
		СуммаДокумента                 = ДокументОснование.СуммаДокумента;
		СведенияОВыбытииМаркированныхТоваров = ДокументОснование.СведенияОВыбытииМаркированныхТоваров;
		
		Фактор = ДокументОснование.Фактор;
		ОснованиеУступкиНаименование = ДокументОснование.ОснованиеУступкиНаименование;
		ОснованиеУступкиНомер = ДокументОснование.ОснованиеУступкиНомер;
		ОснованиеУступкиДата = ДокументОснование.ОснованиеУступкиДата;
		ОснованиеУступкиСведения = ДокументОснование.ОснованиеУступкиСведения;
		ГосЗакупкаДатаКонтракта = ДокументОснование.ГосЗакупкаДатаКонтракта;
		ГосЗакупкаНомерКонтракта = ДокументОснование.ГосЗакупкаНомерКонтракта;
		ГосЗакупкаНомерЛицевогоСчета = ДокументОснование.ГосЗакупкаНомерЛицевогоСчета;
		ГосЗакупкаКодБюджетнойКлассификации = ДокументОснование.ГосЗакупкаКодБюджетнойКлассификации;
		ГосЗакупкаКодЦели = ДокументОснование.ГосЗакупкаКодЦели;
		ГосЗакупкаКазначействоКод = ДокументОснование.ГосЗакупкаКазначействоКод;
		ГосЗакупкаКазначействоНаименование = ДокументОснование.ГосЗакупкаКазначействоНаименование;
		ДатаНачалаПоставки = ДокументОснование.ДатаНачалаПоставки;
		ДатаОкончанияПоставки = ДокументОснование.ДатаОкончанияПоставки;
		
		АдресДоставки = ДокументОснование.АдресДоставки;
		АдресДоставкиЗначенияПолей = ДокументОснование.АдресДоставкиЗначенияПолей;
		АдресДоставкиЗначение = ДокументОснование.АдресДоставкиЗначение;
		
		ДокументыПодтвержденияОтгрузки.Очистить();
		Для каждого СтрокаДокумента Из ДокументОснование.ДокументыПодтвержденияОтгрузки Цикл
			НоваяСтрока = ДокументыПодтвержденияОтгрузки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
		КонецЦикла;
		
		КлиентЭДО.ЗаполнитьНомерДатуИсходногоДокумента(ЭтотОбъект, ДокументОснование);
		
		ИсправлениеКорректировки = ЗначениеЗаполнено(НомерИсправляемогоКорректировочногоДокумента)
			И ЗначениеЗаполнено(ДатаИсправляемогоКорректировочногоДокумента);
		Корректировка = ВидОперации = Перечисления.ВидыОпераций.Корректировка;
		
		Товары.Очистить();
		
		Для Каждого ТекСтрокаТовары Из ДокументОснование.Товары Цикл
			
			НоваяСтрока = Товары.Добавить();
			
			НоваяСтрока.Номенклатура        = ТекСтрокаТовары.Номенклатура;
			НоваяСтрока.Характеристика      = ТекСтрокаТовары.Характеристика;
			НоваяСтрока.ЕдиницаИзмерения    = ТекСтрокаТовары.ЕдиницаИзмерения;
			НоваяСтрока.НомерГТД            = ТекСтрокаТовары.НомерГТД;
			НоваяСтрока.СтранаПроисхождения = ТекСтрокаТовары.СтранаПроисхождения;
			НоваяСтрока.Содержание          = ТекСтрокаТовары.Содержание;
			НоваяСтрока.КодТНВЭД            = ТекСтрокаТовары.КодТНВЭД;
			
			НоваяСтрока.Количество         = ТекСтрокаТовары.Количество;
			НоваяСтрока.КоличествоУпаковок = ТекСтрокаТовары.КоличествоУпаковок;
			НоваяСтрока.Цена               = ТекСтрокаТовары.Цена;
			НоваяСтрока.Сумма              = ТекСтрокаТовары.Сумма;
			НоваяСтрока.СтавкаНДС          = ТекСтрокаТовары.СтавкаНДС;
			НоваяСтрока.СуммаНДС           = ТекСтрокаТовары.СуммаНДС;
			НоваяСтрока.СуммаСНДС          = ТекСтрокаТовары.СуммаСНДС;
			НоваяСтрока.СуммаАкциза        = ТекСтрокаТовары.СуммаАкциза;

			НоваяСтрока.Комитент           = ТекСтрокаТовары.Комитент;
			НоваяСтрока.ДоговорСКомитентом = ТекСтрокаТовары.ДоговорСКомитентом;
		
			НоваяСтрока.ИдентификаторСтроки = ТекСтрокаТовары.ИдентификаторСтроки;
			
			НоваяСтрока.ОснованиеОсвобожденияОтНДС = ТекСтрокаТовары.ОснованиеОсвобожденияОтНДС;
			
			НоваяСтрока.АмортизационнаяГруппа          = ТекСтрокаТовары.АмортизационнаяГруппа;
			НоваяСтрока.КодОКОФ                        = ТекСтрокаТовары.КодОКОФ;
			НоваяСтрока.ФактСрокПолезногоИспользования = ТекСтрокаТовары.ФактСрокПолезногоИспользования;
			НоваяСтрока.СрокПолезногоИспользования     = ТекСтрокаТовары.СрокПолезногоИспользования;
			
			Если Корректировка Тогда
				
				НоваяСтрока.КоличествоУпаковокДоКорректировки = ТекСтрокаТовары.КоличествоУпаковок;
				НоваяСтрока.ЦенаДоКорректировки               = ТекСтрокаТовары.Цена;
				НоваяСтрока.СтавкаНДСДоКорректировки          = ТекСтрокаТовары.СтавкаНДС;
				НоваяСтрока.СуммаДоКорректировки              = ТекСтрокаТовары.Сумма;
				НоваяСтрока.СуммаНДСДоКорректировки           = ТекСтрокаТовары.СуммаНДС;
				НоваяСтрока.СуммаСНДСДоКорректировки          = ТекСтрокаТовары.СуммаСНДС;
				НоваяСтрока.СуммаАкцизаДоКорректировки        = ТекСтрокаТовары.СуммаАкциза;
			
			ИначеЕсли ИсправлениеКорректировки Тогда
				
				НоваяСтрока.КоличествоУпаковок = ТекСтрокаТовары.КоличествоУпаковок;
				НоваяСтрока.Количество  = ТекСтрокаТовары.Количество;
				НоваяСтрока.Цена        = ТекСтрокаТовары.Цена;
				НоваяСтрока.СтавкаНДС   = ТекСтрокаТовары.СтавкаНДС;
				НоваяСтрока.Сумма       = ТекСтрокаТовары.Сумма;
				НоваяСтрока.СуммаНДС    = ТекСтрокаТовары.СуммаНДС;
				НоваяСтрока.СуммаСНДС   = ТекСтрокаТовары.СуммаСНДС;
				НоваяСтрока.СуммаАкциза = ТекСтрокаТовары.СуммаАкциза;
				
				НоваяСтрока.КоличествоУпаковокДоКорректировки  = ТекСтрокаТовары.КоличествоУпаковокДоКорректировки;
				НоваяСтрока.ЦенаДоКорректировки                = ТекСтрокаТовары.ЦенаДоКорректировки;
				НоваяСтрока.СтавкаНДСДоКорректировки           = ТекСтрокаТовары.СтавкаНДСДоКорректировки;
				НоваяСтрока.СуммаДоКорректировки               = ТекСтрокаТовары.СуммаДоКорректировки;
				НоваяСтрока.СуммаНДСДоКорректировки            = ТекСтрокаТовары.СуммаНДСДоКорректировки;
				НоваяСтрока.СуммаСНДСДоКорректировки           = ТекСтрокаТовары.СуммаСНДСДоКорректировки;
				НоваяСтрока.СуммаАкцизаДоКорректировки         = ТекСтрокаТовары.СуммаАкцизаДоКорректировки;
				
				НоваяСтрока.ОснованиеОсвобожденияОтНДС = ТекСтрокаТовары.ОснованиеОсвобожденияОтНДС;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого СтрокаУпаковки Из ДокументОснование.КодыУпаковокМаркируемойПродукции Цикл
			НоваяСтрока = КодыУпаковокМаркируемойПродукции.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаУпаковки);
			
			Если Корректировка Тогда
				НоваяСтрока = КодыУпаковокМаркируемойПродукцииДоКорректировки.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаУпаковки);
				
			КонецЕсли;
		КонецЦикла;
		
		Если ОбщегоНазначения.
			ПодсистемаСуществует("ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС") Тогда
			Для Каждого СтрокаАктирования Из ДокументОснование.ДанныеДляАктированияЕИС Цикл
				НоваяСтрока = ДанныеДляАктированияЕИС.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАктирования);
			КонецЦикла;
		КонецЕсли;
		
		Для Каждого СведенияРНПТ Из ДокументОснование.СведенияПрослеживаемости Цикл
			
			НоваяСтрока = СведенияПрослеживаемости.Добавить();
			НоваяСтрока.ИдентификаторСтроки = СведенияРНПТ.ИдентификаторСтроки;
			НоваяСтрока.РНПТ = СведенияРНПТ.РНПТ;
			НоваяСтрока.ЕдиницаИзмеренияПрослеживаемости = СведенияРНПТ.ЕдиницаИзмеренияПрослеживаемости;
			
			НоваяСтрока.КоличествоУпаковок = СведенияРНПТ.КоличествоУпаковок;
			НоваяСтрока.КоличествоПрослеживаемости = СведенияРНПТ.КоличествоПрослеживаемости;
			
			НоваяСтрока.СтоимостьБезНДС = СведенияРНПТ.СтоимостьБезНДС;
			
			Если Корректировка Тогда
				
				НоваяСтрока.КоличествоУпаковокДоКорректировки = СведенияРНПТ.КоличествоУпаковок;
				НоваяСтрока.КоличествоПрослеживаемостиДоКорректировки = СведенияРНПТ.КоличествоПрослеживаемости;
				НоваяСтрока.СтоимостьБезНДСДоКорректировки = СведенияРНПТ.СтоимостьБезНДС;
				
			ИначеЕсли ИсправлениеКорректировки Тогда
				
				НоваяСтрока.КоличествоУпаковокДоКорректировки = СведенияРНПТ.КоличествоУпаковокДоКорректировки;
				НоваяСтрока.КоличествоПрослеживаемостиДоКорректировки = СведенияРНПТ.КоличествоПрослеживаемостиДоКорректировки;
				НоваяСтрока.СтоимостьБезНДСДоКорректировки = СведенияРНПТ.СтоимостьБезНДСДоКорректировки;
				
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		
		ЗаполнитьПоЗаказуПокупателя(ДанныеЗаполнения);
		
	КонецЕсли;
	
	ИнициализироватьДокумент();
	
	ВводНаОснованииКЭДО.ОбработкаЗаполненияДокумента(ЭтотОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	УстановитьПредставлениеНомера();
	КлиентЭДО.ИдентификаторыСтрокПередЗаписьюОбъекта(ЭтотОбъект);
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ДополнительныеСвойства.Вставить("ЭтоНовый", ЭтоНовый());
	
	СуммаДокумента = Товары.Итог("СуммаСНДС");
	
	Если ОблагаетсяНДСУПокупателя Тогда
		Для Каждого СтрокаТаблицы Из Товары Цикл
			СтрокаТаблицы.СтавкаНДС = Неопределено;
			СтрокаТаблицы.СуммаНДС  = 0;
		КонецЦикла;
	КонецЕсли;
	
	ЭлектронноеВзаимодействиеКЭДО.ПередЗаписьюОснованияЭлектронногоДокумента(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	
	Если КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		ИнтеграцияИСМП.ПередЗаписьюДокумента(ЭтотОбъект, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Документы.СчетФактураВыданный.ПроверитьСоответствиеРеквизитовСчетаФактуры(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ПредставлениеНомера = "";
	
	НомерЭД = "";
	Если ВидОперации = Перечисления.ВидыОпераций.Исправление Тогда
		НомерИсправления = 1;
	Иначе
		НомерИсправления = 0;
	КонецЕсли;
	Ответственный = Пользователи.ТекущийПользователь();
	
	Если КлиентЭДОВызовСервера.ИспользуетсяГосИС() Тогда
		СтатусФискализацииДокумента = Перечисления.СтатусФискализацииДокумента.Новый;
		ШтрихкодыУпаковок.Очистить();
	КонецЕсли;
	
	ДатаОтгрузки = Дата(1, 1, 1);
	ДатаНачалаПоставки =  Дата(1, 1, 1);
	ДатаОкончанияПоставки =  Дата(1, 1, 1);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если НЕ ЗначениеЗаполнено(ДокументОснование)
		И (ВидОперации = Перечисления.ВидыОпераций.Исправление
		ИЛИ ВидОперации = Перечисления.ВидыОпераций.Корректировка) Тогда
		
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Не выбран документ-основание к %1.'"),
			?(ВидОперации = Перечисления.ВидыОпераций.Исправление,
				НСтр("ru = 'исправлению'"), НСтр("ru = 'корректировке'")));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ,
			"ДокументОснованиеПредставление", Отказ);
		
	КонецЕсли;
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	ПроверитьКоличествоЕдиницуЦену = Истина;
	
	ПараметрыПроверки = КлиентЭДО.ПараметрыПроверкиЗаполненияКоличестваИЕдиницыИзмерения();
	ПараметрыПроверки.Вставить("Объект", ЭтотОбъект);
	ПараметрыПроверки.Вставить("МассивНепроверяемыхРеквизитов", МассивНепроверяемыхРеквизитов);
	КлиентЭДО.ПроверитьЗаполнениеХарактеристик(ПараметрыПроверки, Отказ);
	КлиентЭДО.ПроверитьЗаполнениеДанныхАмортизации(ПараметрыПроверки, Отказ);
	
	Если ВидОперации = Перечисления.ВидыОпераций.Корректировка
		ИЛИ (ВидОперации = Перечисления.ВидыОпераций.Исправление
			И ЗначениеЗаполнено(НомерИсправляемогоКорректировочногоДокумента)) Тогда
		КлиентЭДО.ПроверитьЗаполнениеЗначенийПриКорректировке(ПараметрыПроверки, Отказ);
		ПроверитьКоличествоЕдиницуЦену = Ложь;
	КонецЕсли;
	
	Если ПроверитьКоличествоЕдиницуЦену Тогда
		КлиентЭДО.ПроверитьЗаполнениеКоличестваИЕдиницыИзмерения(ПараметрыПроверки, Отказ);
	Иначе
		МассивНепроверяемыхРеквизитов.Добавить("Товары.ЕдиницаИзмерения");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.КоличествоУпаковок");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Количество");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Цена");
	КонецЕсли;
	
	Если ОблагаетсяНДСУПокупателя
		И МассивНепроверяемыхРеквизитов.Найти("Товары.СтавкаНДС") = Неопределено Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Товары.СтавкаНДС");
	КонецЕсли;
	Если ОблагаетсяНДСУПокупателя
		И МассивНепроверяемыхРеквизитов.Найти("Товары.СтавкаНДСДоКорректировки") = Неопределено Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Товары.СтавкаНДСДоКорректировки");
	КонецЕсли;
	
	Если ВидДокумента = Перечисления.ВидыДокументов.СведенияКомиссионера
		И Не ПолучитьФункциональнуюОпцию("ИспользоватьСопоставлениеНоменклатуры") Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Номенклатура");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МассивНепроверяемыхРеквизитов) Тогда
		ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	КонецЕсли;
	
	ПроверитьМинимальныеЦеныПодакцизныхТоваров(Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьПредставлениеНомера()
	
	Если ПустаяСтрока(Номер) Тогда
		УстановитьНовыйНомер();
	КонецЕсли;
	
	Если ПустаяСтрока(НомерЭД) Тогда
		НомерЭД = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Номер, Истина, Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерИсправления) Тогда
		ПредставлениеНомера = СтрШаблон(НСтр("ru = '%1 (испр. %2)'"),
			НомерЭД, НомерИсправления);
	Иначе
		ПредставлениеНомера = НомерЭД;
	КонецЕсли;
	
КонецПроцедуры

Процедура ИнициализироватьДокумент()
	
	Если Не ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
	Если Не Справочники.Организации.ИспользуетсяНесколькоОрганизаций() Тогда
		
		Если Не ЗначениеЗаполнено(Организация) Тогда
			Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(БанковскийСчетОрганизации) Тогда
			БанковскийСчетОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				Организация, "ОсновнойБанковскийСчет", Истина);
		КонецЕсли;
		
	КонецЕсли;
	
	Ответственный = Пользователи.ТекущийПользователь();
	
КонецПроцедуры

Процедура ЗаполнитьПоЗаказуПокупателя(Знач ЗаказПокупателя)
	
	ДанныеЗаказа = Документы.ЗаказПокупателя.ДанныеЗаказаПокупателя(ЗаказПокупателя);
	
	ДокументОснование = ДанныеЗаказа.Шапка.Ссылка;
	Организация = ДанныеЗаказа.Шапка.Организация;
	Контрагент = ДанныеЗаказа.Шапка.Контрагент;
	ДоговорКонтрагента = ДанныеЗаказа.Шапка.ДоговорКонтрагента;
	БанковскийСчетОрганизации = ДанныеЗаказа.Шапка.БанковскийСчет;
	Валюта = ДанныеЗаказа.Шапка.Валюта;
	ЦенаВключаетНДС = ДанныеЗаказа.Шапка.ЦенаВключаетНДС;
	СуммаДокумента = ДанныеЗаказа.Шапка.СуммаДокумента;
	АдресДоставки = ДанныеЗаказа.Шапка.АдресДоставки;
	АдресДоставкиЗначенияПолей = ДанныеЗаказа.Шапка.АдресДоставкиЗначенияПолей;
	АдресДоставкиЗначение = ДанныеЗаказа.Шапка.АдресДоставкиЗначение;
	
	Товары.Очистить();
	
	НаборНоменклатуры = Новый Массив;
	
	Для каждого СтрокаТовара Из ДанныеЗаказа.Товары Цикл
		
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура;
		НоваяСтрока.Характеристика = СтрокаТовара.Характеристика;
		НоваяСтрока.ЕдиницаИзмерения = СтрокаТовара.ЕдиницаИзмерения;
		НоваяСтрока.Количество = СтрокаТовара.Количество;
		НоваяСтрока.КоличествоУпаковок = СтрокаТовара.КоличествоУпаковок;
		НоваяСтрока.Цена = СтрокаТовара.Цена;
		НоваяСтрока.Сумма = СтрокаТовара.Сумма;
		НоваяСтрока.СтавкаНДС = СтрокаТовара.СтавкаНДС;
		НоваяСтрока.СуммаНДС = СтрокаТовара.СуммаНДС;
		НоваяСтрока.СуммаСНДС = СтрокаТовара.СуммаСНДС;
		
		НаборНоменклатуры.Добавить(НоваяСтрока.Номенклатура);
		
	КонецЦикла;
	
	ВидДокумента = ВидДокументаПоНоменклатуре(НаборНоменклатуры);
	
КонецПроцедуры

Функция ТипыНоменклатурыПоСсылкам(Знач Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Номенклатура.ВидНоменклатуры.ТипНоменклатуры КАК ТипНоменклатуры
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В(&Номенклатура)";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	ТипыНоменклатуры = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ТипНоменклатуры");
	
	Возврат ТипыНоменклатуры;
	
КонецФункции

Функция ВидДокументаПоНоменклатуре(Знач Номенклатура)
	
	ТипыНоменклатуры = ТипыНоменклатурыПоСсылкам(Номенклатура);
	
	Если ТипыНоменклатуры.Количество() = 1 Тогда
		
		Если ТипыНоменклатуры[0] = Перечисления.ТипыНоменклатуры.Право Тогда
			
			Возврат Перечисления.ВидыДокументов.АктНаПередачуПрав;
			
		ИначеЕсли ТипыНоменклатуры[0] = Перечисления.ТипыНоменклатуры.Работа
			ИЛИ ТипыНоменклатуры[0] = Перечисления.ТипыНоменклатуры.Услуга Тогда
			
			Возврат Перечисления.ВидыДокументов.АктВыполненныхРабот;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Перечисления.ВидыДокументов.ТоварнаяНакладная;
	
КонецФункции

Процедура ПроверитьМинимальныеЦеныПодакцизныхТоваров(Отказ)
	
	Если Не КлиентЭДОВызовСервера.ИспользуетсяГосИС()
		Или Не КлиентЭДОКлиентСервер.ИспользоватьМаркировкуВДокументеРеализацияТоваровУслуг(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьМинимальныеЦеныАлкогольнойПродукции(Отказ);
	ПроверитьМинимальныеЦеныТабачнойПродукции(Отказ);
	
КонецПроцедуры

Процедура ПроверитьМинимальныеЦеныАлкогольнойПродукции(Отказ)
	
	ТаблицаТовары = Товары.Выгрузить(,"Номенклатура, Характеристика");
	ТаблицаТовары.Колонки.Добавить("Серия", Метаданные.ОпределяемыеТипы.СерияНоменклатуры.Тип);
	ТаблицаПроверки = ТаблицаТовары.СкопироватьКолонки();
	
	ОписанияНоменклатуры = ОбщегоНазначенияИС.ОписаниеНоменклатуры(ТаблицаТовары.ВыгрузитьКолонку("Номенклатура"));
	
	Для Каждого СтрокаТаблицы Из ТаблицаТовары Цикл
		ОписаниеНоменклатуры = ОписанияНоменклатуры[СтрокаТаблицы.Номенклатура];
		Если Не КонструкторИСОбщегоНазначенияКлиентСервер.ЭтоМаркируемаяПродукцияЕГАИС(
			ОписаниеНоменклатуры.КлючВидовПродукции) Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТаблицаПроверки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
	Если Не ТаблицаПроверки.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("Грузоотправитель", Организация);
	ПараметрыПроверки.Вставить("Грузополучатель",  Контрагент);
	ПараметрыПроверки.Вставить("ВидДокумента",     Перечисления.ВидыДокументовЕГАИС.ТТН);
	ПараметрыПроверки.Вставить("ЭтоРеализация",    Истина); 
	
	РезультатыПроверкиЦен = ОбщегоНазначенияИС.МинимальныеЦеныПодакцизныхТоваров(ПараметрыПроверки, ТаблицаПроверки);
	
	РезультатыПроверкиПоАлкогольнойПродукции = РезультатыПроверкиЦен.РезультатыПроверкиПоАлкогольнойПродукции;
	
	Если РезультатыПроверкиПоАлкогольнойПродукции.ОтсутствуютДанные Тогда
		Для каждого СтрокаОшибки Из РезультатыПроверкиПоАлкогольнойПродукции.ПроблемыПоискаЦен Цикл
			ОбщегоНазначения.СообщитьПользователю(СтрокаОшибки);
		КонецЦикла;
		Отказ = Истина;
	КонецЕсли;
	
	ТаблицаСЦенами = РезультатыПроверкиПоАлкогольнойПродукции.ПровереннаяПродукция;
	Для каждого СтрокаЦены Из ТаблицаСЦенами Цикл
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Номенклатура", "");
		ПараметрыОтбора.Вставить("Характеристика", "");
		
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаЦены);
		
		СтрокиНоменклатуры = Товары.НайтиСтроки(ПараметрыОтбора);
		
		Для каждого СтрокаНоменклатуры Из СтрокиНоменклатуры Цикл
			Если ТипЗнч(СтрокаЦены.МинимальнаяЦена) <> Тип("Число")  Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаНоменклатуры.Цена < СтрокаЦены.МинимальнаяЦена Тогда
				СтрокаОшибки = СтрШаблон(НСтр("ru = 'Для номенклатуры ""%1"" минимальная цена, согласно Приказу Министерства финансов Российской Федерации №235н от 07 октября 2020 г. равна %2 руб.'"),
					СтрокаЦены.Номенклатура, Формат(СтрокаЦены.МинимальнаяЦена, "ЧДЦ=2"));
					
				ОбщегоНазначения.СообщитьПользователю(СтрокаОшибки,
					Ссылка,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Товары", СтрокаНоменклатуры.НомерСтроки, "Цена"),,);
					
				Отказ = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьМинимальныеЦеныТабачнойПродукции(Отказ)
	
	ШтрихкодыТабачнойПродукции = Новый Массив;
	Для Каждого СтрокаШтрихкода из ШтрихкодыУпаковок Цикл
		ШтрихкодыТабачнойПродукции.Добавить(СтрокаШтрихкода.ШтрихкодУпаковки);
	КонецЦикла;
	
	ИнтеграцияИСКЭДО.ШтрихкодыСодержащиеВидыПродукции(
		ШтрихкодыТабачнойПродукции,
		КонструкторИСОбщегоНазначенияКлиентСервер.ВидыПродукцииМОТП());
	
	Если ШтрихкодыТабачнойПродукции.Количество() Тогда
		ПараметрыПроверки = Новый Структура;
		
		ТаблицаШтрихкодов = Новый ТаблицаЗначений;
		ТаблицаШтрихкодов.Колонки.Добавить("Штрихкод");
		
		Для каждого ШтрихкодТабака Из ШтрихкодыТабачнойПродукции Цикл
			СтрокаНаПроверку = ТаблицаШтрихкодов.Добавить();
			СтрокаНаПроверку.Штрихкод = ШтрихкодТабака;
		КонецЦикла;
		
		РезультатыПроверкиЦен = ОбщегоНазначенияИС.МинимальныеЦеныПодакцизныхТоваров(ПараметрыПроверки,, ТаблицаШтрихкодов);
		ТаблицаПроверки       = РезультатыПроверкиЦен.РезультатыПроверкиПоТабачнойПродукции;
		
		Для каждого СтрокаПроверки Из ТаблицаПроверки Цикл
			Если СтрокаПроверки.НарушениеМРЦ Тогда
				ТекстОшибки = НСтр("ru = 'Максимальная розничная цена, указанная в коде маркировки %1 номенклатуры ""%2"" меньше минимальной розничной цены'");
				ОписаниеОшибки = СтрШаблон(ТекстОшибки, СтрокаПроверки.КодМаркировки, СтрокаПроверки.Номенклатура);
				
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				
				Отказ = Истина;
				
			КонецЕсли;
			
			Если СтрокаПроверки.МРЦ = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Номенклатура", "");
			ПараметрыОтбора.Вставить("Характеристика", "");
			ПараметрыОтбора.Вставить("Серия", "");
			
			ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаПроверки);
			
			СтрокиНоменклатуры = Товары.НайтиСтроки(ПараметрыОтбора);
			
			Для каждого СтрокаНоменклатуры Из СтрокиНоменклатуры Цикл
				Если СтрокаНоменклатуры.Цена <> СтрокаПроверки.МРЦ Тогда
					ТекстОшибки    = НСтр("ru = 'Для номенклатуры ""%1"" указана цена отличная от максимальной розничной цены, указанной в коде маркировки %2'");
					ОписаниеОшибки = СтрШаблон(ТекстОшибки, СтрокаНоменклатуры.Номенклатура, СтрокаПроверки.КодМаркировки);
					
					ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки,
						ЭтотОбъект,
						ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Товары", СтрокаНоменклатуры.НомерСтроки, "Цена"));
					
					Отказ = Истина;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#КонецЕсли
