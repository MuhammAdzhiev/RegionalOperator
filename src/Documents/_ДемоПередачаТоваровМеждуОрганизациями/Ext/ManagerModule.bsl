
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс 

// Получение данных для формирования электронного документа.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка._ДемоПередачаТоваровМеждуОрганизациями - ссылка на документ, 
//  																			предназначенный для передачи товаров
//  																			между организациями внутри одной 
//  																			базы данных.
// 
// Возвращаемое значение:
//  Структура - структура данных для печати.
//
Функция ПолучитьДанныеДляЭД(СсылкаНаОбъект) Экспорт
	
	ЕстьЭлектронноеАктирование = Ложь;
	Если ОбщегоНазначения.ПодсистемаСуществует(
		"ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС") Тогда
		МодульЭлектронноеАктированиеЕИС = ОбщегоНазначения.ОбщийМодуль("ЭлектронноеАктированиеЕИС");
		МодульКлиентЭлАктЕИС = ОбщегоНазначения.ОбщийМодуль("КлиентЭлАктЕИС");
		ЕстьГосКонтракты = МодульКлиентЭлАктЕИС.ВДокументахЕстьДоговорыСГосконтрактами(СсылкаНаОбъект);
		Если МодульЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеВЕИС()
			И ЕстьГосКонтракты Тогда
			ЕстьЭлектронноеАктирование = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	_ДемоПередачаТоваровМеждуОрганизациями.Ссылка КАК Ссылка,
	|	_ДемоПередачаТоваровМеждуОрганизациями.НомерЭД КАК Номер,
	|	_ДемоПередачаТоваровМеждуОрганизациями.Дата КАК Дата,
	|	_ДемоПередачаТоваровМеждуОрганизациями.НомерИсправления КАК НомерИсправления,
	|	_ДемоПередачаТоваровМеждуОрганизациями.Дата КАК ДатаИсправления,
	|	_ДемоПередачаТоваровМеждуОрганизациями.НомерИсходногоДокумента КАК НомерИсходногоДокумента,
	|	_ДемоПередачаТоваровМеждуОрганизациями.ДатаИсходногоДокумента КАК ДатаИсходногоДокумента,
	|	_ДемоПередачаТоваровМеждуОрганизациями.НомерИсправленияИсходногоДокумента КАК НомерИсправленияИсходногоДокумента,
	|	_ДемоПередачаТоваровМеждуОрганизациями.ДатаИсправленияИсходногоДокумента КАК ДатаИсправленияИсходногоДокумента,
	|	_ДемоПередачаТоваровМеждуОрганизациями.НомерИсправляемогоКорректировочногоДокумента КАК НомерИсправляемогоКорректировочногоДокумента,
	|	_ДемоПередачаТоваровМеждуОрганизациями.ДатаИсправляемогоКорректировочногоДокумента КАК ДатаИсправляемогоКорректировочногоДокумента,
	|	_ДемоПередачаТоваровМеждуОрганизациями.ВидОперации КАК ВидОперации,
	|	_ДемоПередачаТоваровМеждуОрганизациями.Организация КАК Организация,
	|	_ДемоПередачаТоваровМеждуОрганизациями.БанковскийСчетОрганизации КАК БанковскийСчетОрганизации,
	|	_ДемоПередачаТоваровМеждуОрганизациями.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	_ДемоПередачаТоваровМеждуОрганизациями.ДоговорКонтрагента.Наименование КАК НаименованиеДоговора,
	|	_ДемоПередачаТоваровМеждуОрганизациями.ДоговорКонтрагента.НомерДоговора КАК НомерДоговора,
	|	_ДемоПередачаТоваровМеждуОрганизациями.ДоговорКонтрагента.ДатаДоговора КАК ДатаДоговора,
	|	_ДемоПередачаТоваровМеждуОрганизациями.Грузоотправитель КАК Грузоотправитель,
	|	_ДемоПередачаТоваровМеждуОрганизациями.Грузополучатель КАК Грузополучатель,
	|	_ДемоПередачаТоваровМеждуОрганизациями.АдресДоставки КАК АдресДоставки,
	|	_ДемоПередачаТоваровМеждуОрганизациями.АдресДоставкиЗначенияПолей КАК АдресДоставкиЗначенияПолей,
	|	_ДемоПередачаТоваровМеждуОрганизациями.Перевозчик КАК Перевозчик,
	|	_ДемоПередачаТоваровМеждуОрганизациями.НомерТранспортнойНакладной КАК НомерТранспортнойНакладной,
	|	_ДемоПередачаТоваровМеждуОрганизациями.ДатаТранспортнойНакладной КАК ДатаТранспортнойНакладной,
	|	_ДемоПередачаТоваровМеждуОрганизациями.СведенияОТранспортировкеИГрузе КАК СведенияОТранспортировкеИГрузе,
	|	_ДемоПередачаТоваровМеждуОрганизациями.СуммаДокумента КАК СуммаДокумента,
	|	_ДемоПередачаТоваровМеждуОрганизациями.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	_ДемоПередачаТоваровМеждуОрганизациями.Валюта КАК Валюта,
