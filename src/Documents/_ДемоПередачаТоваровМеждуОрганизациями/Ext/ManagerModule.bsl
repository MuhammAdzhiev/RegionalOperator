	|ГДЕ
	|	_ДемоПередачаТоваровМеждуОрганизациямиСведенияПрослеживаемости.Ссылка В(&Ссылка)";
	
	ОбменСКонтрагентамиКЭДО.ИнициализацияТекстаЗапросаПоискаШтрихкодовПоВременнойТаблицеТоваров(
		Запрос.Текст, Метаданные.Документы._ДемоПередачаТоваровМеждуОрганизациями.Имя, Истина);
	
	Справочники.ЕдиницыИзмерения.ДополнитьЗапросДаннымиЕдиницыИзмеренияУпаковки(
		Запрос.Текст, "&ДанныеБазовойЕдиницы", "СправочникНоменклатура.ЕдиницаИзмерения", "БазоваяЕдиница", Истина);
		
	Справочники.ЕдиницыИзмерения.ДополнитьЗапросДаннымиЕдиницыИзмеренияУпаковки(
		Запрос.Текст, "&ДанныеУпаковки", "Товары.ЕдиницаИзмерения", "ЕдиницаИзмерения");
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	Если ЕстьЭлектронноеАктирование Тогда
		КлиентЭлАктЕИС.ДополнитьЗапросДаннымиДляЭлектронногоАктированияЕИС(Запрос.Текст,
			Метаданные.Документы._ДемоПередачаТоваровМеждуОрганизациями.Имя, Истина);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаШапки = МассивРезультатов[0].Выбрать();
	
	ВыборкаТоваров = МассивРезультатов[1].Выбрать();
	
	ТаблицаКодов = МассивРезультатов[2].Выгрузить();
	ТаблицаКодов.Индексы.Добавить("НомерУпаковки, ИдентификаторСтроки");
	
	ТаблицаКодовДоКорректировки = МассивРезультатов[3].Выгрузить();
	ТаблицаКодовДоКорректировки.Индексы.Добавить("НомерУпаковки, ИдентификаторСтроки");
	
	ВыборкаДокументовПодтвержденияОтгрузки = МассивРезультатов[4].Выбрать();
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ВыборкаШапки",   ВыборкаШапки);
	СтруктураДанных.Вставить("ВыборкаТоваров", ВыборкаТоваров);
	
	СтруктураДанных.Вставить("КодыУпаковокМаркируемойПродукции", ТаблицаКодов);
	СтруктураДанных.Вставить("КодыУпаковокМаркируемойПродукцииДоКорректировки", ТаблицаКодовДоКорректировки);
	
	СтруктураДанных.Вставить("ВыборкаДокументовПодтвержденияОтгрузки", ВыборкаДокументовПодтвержденияОтгрузки);
	
	ШтрихкодыКомбинаций = МассивРезультатов[9].Выгрузить();
	ШтрихкодыКомбинаций.Индексы.Добавить("Номенклатура, Характеристика, ЕдиницаИзмерения");
	СтруктураДанных.Вставить("ШтрихкодыКомбинаций", ШтрихкодыКомбинаций);

	ШтрихкодыНоменклатуры = МассивРезультатов[10].Выгрузить();
	ШтрихкодыНоменклатуры.Индексы.Добавить("Номенклатура");
	СтруктураДанных.Вставить("ШтрихкодыНоменклатуры", ШтрихкодыНоменклатуры);
	
	СтруктураДанных.Вставить("СведенияПрослеживаемости", МассивРезультатов[5].Выгрузить());
	
	Если ЕстьЭлектронноеАктирование Тогда
		
		ДанныеЭлектронногоАктированияЕИС = Новый Структура;
		
		СтрокиДокумента = МассивРезультатов[11].Выгрузить();
		ДанныеЭлектронногоАктированияЕИС.Вставить("СтрокиДокумента", СтрокиДокумента);

		ТаблицаИдентификаторовЕИС = СтрокиДокумента.Скопировать();
		ТаблицаИдентификаторовЕИС.Свернуть(
			"ИдентификаторДляАктированияЕИС", "КоличествоСтрок");
		// Соответствие между идентификатором для ЕИС и структурой с количеством строк и данными родителя.
		ДанныеПоДетализации = Новый Соответствие();
		Для Каждого Строка Из ТаблицаИдентификаторовЕИС Цикл
			ДанныеСтрок = Новый Структура("КоличествоСтрок, ДанныеРодителя",
				Строка.КоличествоСтрок, Неопределено);
			ДанныеПоДетализации.Вставить(
				Строка.ИдентификаторДляАктированияЕИС, ДанныеСтрок);
		КонецЦикла;
		ДанныеЭлектронногоАктированияЕИС.Вставить("ДанныеПоДетализации", ДанныеПоДетализации);
	
		ПодписантыДокументовЕИС = МассивРезультатов[12].Выгрузить();
		ДанныеЭлектронногоАктированияЕИС.Вставить("ПодписантыДокументовЕИС", ПодписантыДокументовЕИС);
	
		МестаПоставкиДокументовДляЕИС = МассивРезультатов[13].Выгрузить();
		ДанныеЭлектронногоАктированияЕИС.Вставить("МестаПоставкиДокументовДляЕИС", МестаПоставкиДокументовДляЕИС);
	
		ПриложенныеФайлыДляЭлектронногоАктированияЕИС = МассивРезультатов[14].Выгрузить();
		ДанныеЭлектронногоАктированияЕИС.Вставить("ПриложенныеФайлыДляЭлектронногоАктированияЕИС", 
			ПриложенныеФайлыДляЭлектронногоАктированияЕИС);

		ДанныеГосконтракта = МассивРезультатов[15].Выгрузить();
		ДанныеЭлектронногоАктированияЕИС.Вставить("ДанныеГосконтракта", ДанныеГосконтракта);
		
		СтруктураДанных.Вставить("ДанныеЭлектронногоАктированияЕИС", ДанныеЭлектронногоАктированияЕИС);
		
	Иначе
		
		СтруктураДанных.Вставить("ДанныеЭлектронногоАктированияЕИС", Неопределено);
		
	КонецЕсли;
	
	Возврат СтруктураДанных;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

