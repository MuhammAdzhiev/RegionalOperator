// Назначение модуля: Отражение разницы перерасчета ТКО в регистре взаиморасчетов.
// Формирует движение суммы перерасчета по выбранному лицевому счету.
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ВзаиморасчетыТКО.Записывать = Истина;
	Движение = Движения.ВзаиморасчетыТКО.ДобавитьПриход();
	Движение.Период = Дата;
	Движение.ЛицевойСчет = ЛицевойСчет;
	Движение.Начислено = Сумма;
	Движение.Оплачено = 0;

КонецПроцедуры
