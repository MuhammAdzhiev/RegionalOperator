#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	РаботаСФайлами.УстановитьПометкуУдаленияПрисоединенныхФайловДокументов(ЭтотОбъект, Отказ, Ложь, Ложь);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	НаборОбъектов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументОснование);
	ТаблицаЭД = ИнтеграцияЭДО.АктуальныеЭлектронныеДокументы(ДокументОснование);
	Если ТаблицаЭД.Количество() > 0 Тогда

		Если ТаблицаЭД.Найти(Ссылка, "ЭлектронныйДокумент") = Неопределено Тогда
			ЭлектронныйДокумент = ТаблицаЭД[0].ЭлектронныйДокумент;
			НаборОбъектов.Добавить(Ссылка);
			ИнтеграцияЭДО.УстановитьАктуальныйЭлектронныйДокумент(НаборОбъектов, ЭлектронныйДокумент);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.АктПриемкиВходящийЕИС") Тогда
	
		ЗаполнитьПоАктуПриемки(ДанныеЗаполнения);
			
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоАктуПриемки(АктПриемкиВходящийЕИС)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	АктПриемкиВходящийЕИС.Ссылка КАК ДокументОснование,
	|	АктПриемкиВходящийЕИС.Организация КАК Организация,
	|	АктПриемкиВходящийЕИС.Контрагент КАК Контрагент,
	|	АктПриемкиВходящийЕИС.ЭтоКорректировка КАК ЭтоКорректировка
	|ИЗ
	|	Документ.АктПриемкиВходящийЕИС КАК АктПриемкиВходящийЕИС
	|ГДЕ
	|	АктПриемкиВходящийЕИС.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТРУОбъектовЗакупки.Идентификатор КАК Идентификатор,
	|	ТРУОбъектовЗакупки.ВнешнийИдентификатор КАК ВнешнийИдентификатор,
	|	ТРУОбъектовЗакупки.ВнутреннийИдентификаторЕИС КАК ВнутреннийИдентификаторЕИС,
	|	ТРУОбъектовЗакупки.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТРУОбъектовЗакупки.ЕдиницаИзмеренияНаименование КАК ЕдиницаИзмеренияНаименование,
	|	ТРУОбъектовЗакупки.КодТовараДляЕИС КАК КодТовараДляЕИС,
	|	ТРУОбъектовЗакупки.Наименование КАК Наименование,
	|	ТРУОбъектовЗакупки.Количество КАК Количество,
	|	ТРУОбъектовЗакупки.Количество КАК КоличествоПринято,
	|	ТРУОбъектовЗакупки.Всего КАК Всего,
	|	ТРУОбъектовЗакупки.ОбъемРаботыУслуги КАК ПринятыйОбъемРаботыУслуги
	|ИЗ
	|	Документ.АктПриемкиВходящийЕИС.ТРУОбъектовЗакупки КАК ТРУОбъектовЗакупки
	|ГДЕ
	|	ТРУОбъектовЗакупки.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", АктПриемкиВходящийЕИС);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ИтогПриемки = 1;
	СодержаниеОперации = НСтр("ru = 'Товары (работы, услуги, права) приняты без расхождений (претензий)'");
	
	// Заполнение шапки
	Дата = ТекущаяДатаСеанса();
	Ответственный = Пользователи.ТекущийПользователь();
	
	ВыборкаДанных = МассивРезультатов[0].Выбрать();
	ВыборкаДанных.Следующий();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаДанных);
	
	// Заполнение строк
	ВыборкаДанных = МассивРезультатов[1].Выбрать();
	Пока ВыборкаДанных.Следующий() Цикл
		НоваяСтрокаРасхождения = РасхожденияДляОбъектовЗакупки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРасхождения, ВыборкаДанных);	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти 

#КонецЕсли