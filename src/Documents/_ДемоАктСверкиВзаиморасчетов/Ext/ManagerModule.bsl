#Область ПрограммныйИнтерфейс

// Получение данных для формирования электронного документа.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка.РеализацияТоваровУслуг - ссылка на документ.
// 
// Возвращаемое значение:
//  Структура - структура данных для печати.
//
Функция ПолучитьДанныеДляЭД(СсылкаНаОбъект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	_ДемоАктСверкиВзаиморасчетов.НомерЭД КАК НомерЭД,
		|	_ДемоАктСверкиВзаиморасчетов.Организация КАК Организация,
		|	_ДемоАктСверкиВзаиморасчетов.Контрагент КАК Контрагент,
		|	_ДемоАктСверкиВзаиморасчетов.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	_ДемоАктСверкиВзаиморасчетов.ДоговорКонтрагента.Наименование КАК ДоговорНаименование,
		|	_ДемоАктСверкиВзаиморасчетов.ДоговорКонтрагента.НомерДоговора КАК ДоговорНомер,
		|	_ДемоАктСверкиВзаиморасчетов.ДоговорКонтрагента.ДатаДоговора КАК ДоговорДата,
		|	_ДемоАктСверкиВзаиморасчетов.ДатаНачала КАК ДатаНачала,
		|	_ДемоАктСверкиВзаиморасчетов.ДатаОкончания КАК ДатаОкончания,
		|	_ДемоАктСверкиВзаиморасчетов.ОстатокНаНачало КАК ОстатокНаНачало,
		|	_ДемоАктСверкиВзаиморасчетов.Валюта КАК Валюта
		|ИЗ
		|	Документ._ДемоАктСверкиВзаиморасчетов КАК _ДемоАктСверкиВзаиморасчетов
		|ГДЕ
		|	_ДемоАктСверкиВзаиморасчетов.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_ДемоАктСверкиВзаиморасчетовРасшифровка.Номер КАК Номер,
		|	_ДемоАктСверкиВзаиморасчетовРасшифровка.Дата КАК Дата,
		|	_ДемоАктСверкиВзаиморасчетовРасшифровка.НаименованиеДокумента КАК НаименованиеДокумента,
		|	_ДемоАктСверкиВзаиморасчетовРасшифровка.Примечание КАК Примечание,
		|	_ДемоАктСверкиВзаиморасчетовРасшифровка.Дебет КАК Дебет,
		|	_ДемоАктСверкиВзаиморасчетовРасшифровка.Кредит КАК Кредит
		|ИЗ
		|	Документ._ДемоАктСверкиВзаиморасчетов.Расшифровка КАК _ДемоАктСверкиВзаиморасчетовРасшифровка
		|ГДЕ
		|	_ДемоАктСверкиВзаиморасчетовРасшифровка.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаШапки = МассивРезультатов[0].Выбрать();
	
	ТаблицаРасшифровки = МассивРезультатов[1].Выгрузить();
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ВыборкаШапки", ВыборкаШапки);
	СтруктураДанных.Вставить("ТаблицаРасшифровки", ТаблицаРасшифровки);
	
	Возврат СтруктураДанных;
	
КонецФункции

