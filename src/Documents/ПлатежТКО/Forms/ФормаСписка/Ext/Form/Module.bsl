// Назначение модуля: Импорт платежей из Excel через временное хранилище и отображение протокола загрузки.
// Открывает асинхронный диалог выбора файла платежей.
&НаКлиенте
Процедура ЗагрузитьПлатежи(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите Excel-файл";
	Диалог.Фильтр = "Excel (*.xlsx;*.xls)|*.xlsx;*.xls";
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект, Диалог);
	Диалог.Показать(Оповещение);
	
КонецПроцедуры
// Передает Excel-файл в серверный импорт и сообщает об итогах с детализацией ошибок.  
// Параметры:
//   РезультатВыбора - результат диалога выбора файла.
//   Диалог - диалог выбора файла, переданный в обработчик оповещения.
&НаКлиенте
Процедура ПослеВыбораФайла(РезультатВыбора, Диалог) Экспорт
	
	Если НЕ ЗначениеЗаполнено(РезультатВыбора) Тогда
		Возврат;
	КонецЕсли;
	
	Путь = Диалог.ПолноеИмяФайла;
	Если ПустаяСтрока(Путь) Тогда
		Возврат;
	КонецЕсли;
	// Используем корректное расширение серверного временного файла.
	Если НРег(Прав(Путь, 5)) = ".xlsx" Тогда
		Расширение = "xlsx";
	ИначеЕсли НРег(Прав(Путь, 4)) = ".xls" Тогда
		Расширение = "xls"; 
	Иначе
		Сообщить("Выберите Excel-файл .xlsx или .xls.");
		Возврат;
	КонецЕсли;
	
	Двоичные = Новый ДвоичныеДанные(Путь);
	Адрес = ПоместитьВоВременноеХранилище(Двоичные);
	Результат = ЗагрузитьПлатежиНаСервере(Адрес, Расширение);
	
	Сообщить("Импорт платежей: создано " + Строка(Результат.Создано) + ", дубли " + Строка(Результат.Дубли) + ", ошибки " 
	+ Строка(Результат.Ошибки) + ", пустые строки " + Строка(Результат.Пустые) + ".");
	
	Для Каждого ЗаписьПротокола Из Результат.Протокол Цикл
		Если ЗаписьПротокола.Статус <> "Создан" Тогда
			Сообщить("Excel, строка " + Строка(ЗаписьПротокола.НомерСтроки) + ", ID=" + ЗаписьПротокола.Идентификатор + ", " 
			+ ЗаписьПротокола.Статус + ": " + ЗаписьПротокола.Текст);
		КонецЕсли;
	КонецЦикла;
	
	Если Результат.ЧтениеПрервано Тогда
		Сообщить("Чтение файла прервано. Посмотрите протокол: часть платежей уже сохранена.");
	КонецЕсли;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры
// Получает временный Excel-файл на сервере, выполняет импорт и очищает ресурсы.
&НаСервере
Функция ЗагрузитьПлатежиНаСервере(Адрес, Расширение)
	
	Если Расширение <> "xlsx" И Расширение <> "xls" Тогда
		ВызватьИсключение "Недопустимый формат файла платежей.";
	КонецЕсли;
	
	Двоичные = ПолучитьИзВременногоХранилища(Адрес);
	Если Двоичные = Неопределено Тогда
		ВызватьИсключение "Не удалось получить Excel из временного хранилища.";
	КонецЕсли;
	
	ИмяВремФайла = ПолучитьИмяВременногоФайла(Расширение);
	Результат = Неопределено;
	ТекстОшибки = "";
	
	Попытка
		Двоичные.Записать(ИмяВремФайла);
		Результат = РОТКО_Excel.ПрочитатьПлатежиИзExcel(ИмяВремФайла);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	// Удаляем и при ошибке записи, и при ошибке чтения, и при успехе.
	ФайлУдален = РОТКО_Excel.УдалитьВременныйФайлExcel(ИмяВремФайла);
	
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		Попытка
			ЗаписьЖурналаРегистрации(НСтр("ru = 'РОТКО.Excel.Импорт'"), УровеньЖурналаРегистрации.Ошибка, , , "Импорт платежей: " 
			+ ТекстОшибки);
		Исключение
		КонецПопытки;
		
		ВызватьИсключение "Ошибка импорта платежей: " + ТекстОшибки;
	КонецЕсли;
	
	Если НЕ ФайлУдален Тогда
		Результат.Протокол.Добавить(Новый Структура("НомерСтроки,Идентификатор,Статус,Текст", 0, "", "Предупреждение",
		"Не удалось удалить временный файл на сервере; подробности — в журнале регистрации."));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
