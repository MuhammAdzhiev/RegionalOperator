// Назначение модуля: Проведение платежей и защита от дублей по внешнему идентификатору.
// Отражает оплату в регистре взаиморасчетов только для разнесенных платежей.
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если Статус <> Перечисления.СтатусПлатежа.Разнесен Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
		Отказ = Истина;
		Сообщить("Для разнесенного платежа должен быть указан лицевой счет.");
		Возврат;
	КонецЕсли;
	
	Движения.ВзаиморасчетыТКО.Записывать = Истина;
	Движение = Движения.ВзаиморасчетыТКО.ДобавитьПриход();
	Движение.Период = Дата;
	Движение.ЛицевойСчет = ЛицевойСчет;  
	Движение.Начислено = 0;
	Движение.Оплачено = Сумма;
	
КонецПроцедуры
// Проверяет счет разнесенного платежа и уникальность внешнего ID под управляемой блокировкой.
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Статус = Перечисления.СтатусПлатежа.Разнесен И НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
		Отказ = Истина;
		Сообщить("Нельзя установить статус 'Разнесен' без лицевого счета.");
		Возврат;
	КонецЕсли;
	// Для ручных платежей без внешнего ID оставляем прежнее поведение.
	// Импорт Excel НЕ допускает пустого ID.
	ИдентификаторПлатежа = СокрЛП(ИдентификаторПлатежа);
	Если ПустаяСтрока(ИдентификаторПлатежа) Тогда
		Возврат;
	КонецЕсли;
	// Общая блокировка пространства документов. Не задаем поле Ссылка: это намеренно сериализует проверку ID для всех ПлатежТКО.
	// В обработчике ПередЗаписью документа работает транзакция записи.
	// Проверка внешнего ID и запись выполняются под общей блокировкой во избежание конкурентных дублей.
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Документ.ПлатежТКО");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	
	// Проверяем и при создании, и при редактировании документа.
	Если РОТКО_Платежи.ЕстьПлатежПоИдентификатору(ИдентификаторПлатежа, Ссылка) Тогда
		
		Отказ = Истина;
		Сообщить("Платеж с идентификатором '" + ИдентификаторПлатежа + "' уже существует.");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

