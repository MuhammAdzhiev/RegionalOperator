// Назначение модуля: Корректировка фактического вывоза по рейсу с контролем актуального объема и защитой от конкурентных изменений.
// Проверяет рейс, точки и старый факт под блокировкой; записывает в регистр разницу нового и старого объемов.
Процедура ОбработкаПроведения(Отказ, Режим)
	// 1. Проверяем заполнение документа
	Если НЕ ЗначениеЗаполнено(Рейс) Тогда
		Отказ = Истина;
		Сообщить("Не указан рейс для корректировки.");
		Возврат;
	КонецЕсли;
	
	Если Корректировки.Количество() = 0 Тогда
		Отказ = Истина;
		Сообщить("Табличная часть корректировок пуста.");
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = РОТКО_ПроверкиПроведения.ПроверитьКорректировкуФактаРейса(ЭтотОбъект);
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		Отказ = Истина;
		Сообщить(ТекстОшибки);
		Возврат;
	КонецЕсли;
	// 2. Блокируем рейс и его фактические объемы.
	// Проведение документа уже выполняется в транзакции. 
	// Блокировка защищает чтение старого факта и запись корректировки от параллельных изменений.
	БлокировкаРейса = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаРейса.Добавить("Документ.Рейс");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Рейс);
	БлокировкаРейса.Заблокировать();
	
	БлокировкаОбъемов = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаОбъемов.Добавить("РегистрНакопления.ВывозОтходовМЗ");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Рейс", Рейс);
	БлокировкаОбъемов.Заблокировать();
	// 3. Проверяем исходный рейс
	РейсОбъект = Рейс.ПолучитьОбъект();
	
	Если НЕ РейсОбъект.Проведен Тогда
		Отказ = Истина;
		Сообщить("Нельзя корректировать непроведенный рейс.");
		Возврат;
	КонецЕсли;
	
	Если НЕ (РейсОбъект.Статус = Перечисления.СтатусРейса.Выполнен 
		ИЛИ РейсОбъект.Статус = Перечисления.СтатусРейса.ЧастичноВыполнен) Тогда
		
		Отказ = Истина;
		Сообщить("Корректировка разрешена только для " + "выполненного или частично выполненного рейса.");
		Возврат;
		
	КонецЕсли;
	// 4. Проверяем все корректировки до создания движений
	ПроверенныеПлощадки = Новый Массив;
	
	Для Каждого СтрокаКорр Из Корректировки Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаКорр.Площадка) Тогда
			Отказ = Истина;
			Сообщить("В корректировке не заполнена площадка.");
			Возврат;
		КонецЕсли;
		// Запрещаем дубли в табличной части
		Если ПроверенныеПлощадки.Найти(СтрокаКорр.Площадка) <> Неопределено Тогда
			
			Отказ = Истина;
			Сообщить("Площадка повторяется в корректировке: " + Строка(СтрокаКорр.Площадка));
			Возврат;
			
		КонецЕсли;
		
		ПроверенныеПлощадки.Добавить(СтрокаКорр.Площадка);
		// Факт выполненной точки должен оставаться > 0
		Если СтрокаКорр.НовыйФактМ3 <= 0 Тогда
			Отказ = Истина;
			Сообщить("Новый фактический объем должен быть " + "больше нуля: " + Строка(СтрокаКорр.Площадка));
			Возврат;
		КонецЕсли;
		
		Если СтрокаКорр.СтарыйФактМ3 = СтрокаКорр.НовыйФактМ3 Тогда
			
			Отказ = Истина;
			Сообщить("Старый и новый объемы совпадают: " + Строка(СтрокаКорр.Площадка));
			Возврат;
			
		КонецЕсли;
		// Проверяем наличие площадки в рейсе
		КоличествоТочек = 0;
		ТочкаВыполнена = Ложь;
		
		Для Каждого ТочкаРейса Из РейсОбъект.ТочкиМаршрута Цикл
			Если ТочкаРейса.Площадка = СтрокаКорр.Площадка Тогда
				КоличествоТочек = КоличествоТочек + 1;
				Если ТочкаРейса.СтатусТочки = Перечисления.СтатусТочкиМаршрута.Выполнен Тогда
					ТочкаВыполнена = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если КоличествоТочек <> 1 Тогда
			Отказ = Истина;
			Сообщить("Площадка должна встречаться в рейсе " + "ровно один раз: " + Строка(СтрокаКорр.Площадка));
			Возврат;
		КонецЕсли;
		
		Если НЕ ТочкаВыполнена Тогда
			Отказ = Истина;
			Сообщить("Нельзя корректировать невыполненную "+ "точку: " + Строка(СтрокаКорр.Площадка));
			Возврат;
		КонецЕсли;
		// 5. Проверяем актуальное значение по регистру
		ТекущийФакт = ПолучитьТекущийФактМ3(Рейс, СтрокаКорр.Площадка);
		
		Если ТекущийФакт <> СтрокаКорр.СтарыйФактМ3 Тогда
			
			Отказ = Истина;
			
			Сообщить("Фактический объем по площадке " + Строка(СтрокаКорр.Площадка) + " изменился. Указано: " 
			+ Строка(СтрокаКорр.СтарыйФактМ3) + " м³, актуально: " + Строка(ТекущийФакт) + " м³. Обновите старый факт.");
			
			Возврат;
		КонецЕсли;
	КонецЦикла;
	// 6. Все проверки прошли. Создаем движения.
	Движения.ВывозОтходовМЗ.Очистить();
	Движения.ВывозОтходовМЗ.Записывать = Истина;
	
	Для Каждого СтрокаКорр Из Корректировки Цикл
		
		Движение = Движения.ВывозОтходовМЗ.Добавить();
		
		Движение.Период = Дата;
		Движение.Город = РейсОбъект.Город;
		Движение.Зона = РейсОбъект.Зона;
		Движение.Площадка = СтрокаКорр.Площадка;
		Движение.ТипИсполнителя =РейсОбъект.ТипИсполнителя;
		Движение.Подрядчик = РейсОбъект.Подрядчик;
		Движение.ТС = РейсОбъект.ТС;
		Движение.Рейс = Рейс;
		
		Движение.ОбъемМ3 = СтрокаКорр.НовыйФактМ3 - СтрокаКорр.СтарыйФактМ3;
		
	КонецЦикла;
	
КонецПроцедуры
// Возвращает актуальный суммарный объем по рейсу и площадке с учетом проведенных корректировок.
// Параметры:
//   РейсСсылка - ссылка на рейс.
//   ПлощадкаСсылка - ссылка на контейнерную площадку.
// Возвращаемое значение:
//   Число — сумма оборотов регистра по рейсу и площадке.
Функция ПолучитьТекущийФактМ3(РейсСсылка, ПлощадкаСсылка)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Обороты.ОбъемМ3Оборот), 0) КАК ТекущийФактМ3
	|ИЗ
	|	РегистрНакопления.ВывозОтходовМЗ.Обороты(
	|			,
	|			,
	|			,
	|			Рейс = &Рейс
	|				И Площадка = &Площадка) КАК Обороты";
	
	Запрос.УстановитьПараметр("Рейс", РейсСсылка);
	Запрос.УстановитьПараметр("Площадка", ПлощадкаСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ТекущийФактМ3;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции        
// Запрещает редактирование уже проведенного документа корректировки.
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	СтарыйОбъект = Ссылка.ПолучитьОбъект();
	
	Если СтарыйОбъект.Проведен Тогда
		
		Отказ = Истина;
		
		Сообщить("Проведенную корректировку изменять нельзя. " + "Для изменения факта создайте новую корректировку.");
		
	КонецЕсли;
	
КонецПроцедуры
// Запрещает отмену проведения корректировки; возврат объема оформляется новой корректировкой.
// Параметры:
//   Отказ - флаг отказа от действия платформы; устанавливается при ошибке проверки.
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Отказ = Истина;
	
	Сообщить("Отмена проведения корректировки запрещена. " + "Для возврата прежнего объема создайте новую "
	+ "корректировку с обратным изменением.");
	
КонецПроцедуры

