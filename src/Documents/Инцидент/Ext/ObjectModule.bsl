// Назначение модуля: Жизненный цикл инцидента, фиксация устранения и защита исходных сведений от изменения.
// Проверяет допустимые переходы статусов и неизменность исходных данных после устранения инцидента.
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	// Новый инцидент создается только в статусе "Создан".
	Если ЭтоНовый() Тогда
		
		Если Статус <> Перечисления.СтатусИнцидента.Создан Тогда
			Отказ = Истина;
			Сообщить("Новый инцидент должен иметь статус «Создан».");
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	// Получаем сохраненную версию документа.
	Старый = Ссылка.ПолучитьОбъект();
	// 1. Закрытый инцидент изменять нельзя.
	Если Старый.Статус = Перечисления.СтатусИнцидента.Закрыт Тогда
		
		Отказ = Истина;
		Сообщить("Закрытый инцидент доступен только для просмотра.");
		Возврат;
		
	КонецЕсли;
	// 2. Контролируем переходы между статусами.
	Если Статус <> Старый.Статус Тогда
		
		Если НЕ ДопустимыйПереходСтатуса(Старый.Статус, Статус) Тогда
			
			Отказ = Истина;
			Сообщить("Недопустимый переход статуса инцидента: " + Строка(Старый.Статус) + " → " + Строка(Статус));
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	// 3. Если инцидент уже устранен, защищаем первоначальные данные от изменений.
	Если Старый.Статус =
		Перечисления.СтатусИнцидента.Устранен Тогда
		
		Если Номер <> Старый.Номер Или Дата <> Старый.Дата Или ПометкаУдаления <> Старый.ПометкаУдаления
			Или Площадка <> Старый.Площадка Или ТипИнцидента <> Старый.ТипИнцидента Или Описание <> Старый.Описание
			Или Ответственный <> Старый.Ответственный Или Рейс <> Старый.Рейс Или ДатаУстранения <> Старый.ДатаУстранения Тогда
			
			Отказ = Истина;
			Сообщить("Инцидент устранен. Разрешено изменять " + "только комментарий и фото после устранения.");
			Возврат;
			
		КонецЕсли;
		
		Если ФотоДо <> Старый.ФотоДо Тогда
			
			Отказ = Истина;
			
			Сообщить("Нельзя изменять первоначальное фото " + "после устранения инцидента.");
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// 4. При первом переходе в "Устранен" автоматически фиксируем дату устранения.
	Если Статус = Перечисления.СтатусИнцидента.Устранен И Старый.Статус <> Перечисления.СтатусИнцидента.Устранен Тогда
		ДатаУстранения = ТекущаяДата();
	КонецЕсли;
	
	// 5. Для устраненного или закрываемого инцидента комментарий о выполненных работах обязателен.
	Если Статус = Перечисления.СтатусИнцидента.Устранен Или Статус = Перечисления.СтатусИнцидента.Закрыт Тогда
		
		Если ПустаяСтрока(СокрЛП(КомментарийПосле)) Тогда
			
			Отказ = Истина;
			Сообщить("Укажите, каким образом был устранен инцидент.");
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
// Определяет, разрешен ли последовательный переход от старого статуса к новому.
// Параметры:
//   СтарыйСтатус - статус инцидента до изменения.
//   НовыйСтатус - статус, который устанавливается пользователем.
// Возвращаемое значение:
//   Булево — допустим ли переход между статусами.
Функция ДопустимыйПереходСтатуса(СтарыйСтатус, НовыйСтатус)
	
	Если СтарыйСтатус = Перечисления.СтатусИнцидента.Создан Тогда
		
		Возврат НовыйСтатус = Перечисления.СтатусИнцидента.Назначен;
		
	ИначеЕсли СтарыйСтатус = Перечисления.СтатусИнцидента.Назначен Тогда
		
		Возврат НовыйСтатус = Перечисления.СтатусИнцидента.ВРаботе;
		
	ИначеЕсли СтарыйСтатус = Перечисления.СтатусИнцидента.ВРаботе Тогда
		
		Возврат НовыйСтатус = Перечисления.СтатусИнцидента.Устранен;
		
	ИначеЕсли СтарыйСтатус = Перечисления.СтатусИнцидента.Устранен Тогда
		
		Возврат НовыйСтатус = Перечисления.СтатусИнцидента.Закрыт;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции
// Сравнивает содержимое двух хранилищ значений (сохраненный совместимый вспомогательный метод).
// Параметры:
//   Первое - первое сравниваемое хранилище значения.
//   Второе - второе сравниваемое хранилище значения.
// Возвращаемое значение:
//   Булево — равны ли сравниваемые хранилища.
Функция ХранилищаСовпадают(Первое, Второе)
	
	Если Первое = Неопределено Тогда
		Возврат Второе = Неопределено;
	КонецЕсли;
	
	Если Второе = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат XMLСтрока(Первое) = XMLСтрока(Второе);
	
КонецФункции
