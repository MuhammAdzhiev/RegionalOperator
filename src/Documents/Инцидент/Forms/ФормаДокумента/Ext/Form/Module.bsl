// Устанавливает начальный статус и ограничения редактирования согласно жизненному циклу инцидента.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Устанавливаем начальный статус, если он не заполнен.
	Если НЕ ЗначениеЗаполнено(Объект.Статус) Тогда
		Объект.Статус = Перечисления.СтатусИнцидента.Создан;
	КонецЕсли;
	// Закрытый документ только для просмотра.
	Если Объект.Статус = Перечисления.СтатусИнцидента.Закрыт Тогда
		
		ТолькоПросмотр = Истина;
		Возврат;
		
	КонецЕсли;
	// После устранения запрещаем менять исходные данные.
	Если Объект.Статус = Перечисления.СтатусИнцидента.Устранен Тогда
		
		Элементы.Номер.Доступность = Ложь;
		Элементы.Дата.Доступность = Ложь;
		Элементы.Площадка.Доступность = Ложь;
		Элементы.ТипИнцидента.Доступность = Ложь;
		Элементы.Описание.Доступность = Ложь;
		Элементы.Ответственный.Доступность = Ложь;
		Элементы.Рейс.Доступность = Ложь;
		// Статус оставляем доступным для закрытия.
		Элементы.Статус.Доступность = Истина;
		// Дата устанавливается автоматически.
		Элементы.ДатаУстранения.Доступность = Ложь;
		// Комментарий после устранения можно редактировать.
		Элементы.КомментарийПосле.Доступность = Истина;
		
	КонецЕсли;  
	
	ПодключитьФотографииБСП();
	
КонецПроцедуры
// Создает на форме два поля присоединенных файлов: фото до и фото после устранения.
&НаСервере
Процедура ПодключитьФотографииБСП()
	
	НастройкиПолей = Новый Массив;
	
	СтатусУстранен = Перечисления.СтатусИнцидента.Устранен;
	
	СтатусЗакрыт = Перечисления.СтатусИнцидента.Закрыт;
	
	МожноИзменятьФотоДо = Объект.Статус <> СтатусУстранен И Объект.Статус <> СтатусЗакрыт;
	
	МожноИзменятьФотоПосле = Объект.Статус <> СтатусЗакрыт;
	// Фотография первоначального состояния
	ФотоДо = РаботаСФайлами.ПолеФайла();
	
	ФотоДо.Размещение = "ГруппаФотоДо";
	ФотоДо.ПутьКДанным = "Объект.ФотоДо";
	ФотоДо.Заголовок = "Фото до устранения";
	ФотоДо.ТолькоОдинФайл = Истина;
	ФотоДо.ПоказыватьПредпросмотр = Истина;
	ФотоДо.МаксимальныйРазмер = 10;
	ФотоДо.ДобавлятьФайлы = МожноИзменятьФотоДо;
	ФотоДо.ВыбиратьФайл = МожноИзменятьФотоДо;
	ФотоДо.ОчищатьФайл = МожноИзменятьФотоДо;
	ФотоДо.РедактироватьФайл = "НеРедактировать";
	ФотоДо.ФильтрДиалогаВыбора = "Изображения (*.jpg;*.jpeg;*.png)|*.jpg;*.jpeg;*.png";
	
	НастройкиПолей.Добавить(ФотоДо);
	// Фотография результата устранения
	ФотоПосле = РаботаСФайлами.ПолеФайла();
	
	ФотоПосле.Размещение = "ГруппаФотоПосле";
	ФотоПосле.ПутьКДанным = "Объект.ФотоПосле";
	ФотоПосле.Заголовок = "Фото после устранения";
	ФотоПосле.ТолькоОдинФайл = Истина;
	ФотоПосле.ПоказыватьПредпросмотр = Истина;
	ФотоПосле.МаксимальныйРазмер = 10;
	ФотоПосле.ДобавлятьФайлы = МожноИзменятьФотоПосле;
	ФотоПосле.ВыбиратьФайл = МожноИзменятьФотоПосле;
	ФотоПосле.ОчищатьФайл = МожноИзменятьФотоПосле;
	ФотоПосле.РедактироватьФайл = "НеРедактировать";
	ФотоПосле.ФильтрДиалогаВыбора = "Изображения (*.jpg;*.jpeg;*.png)|*.jpg;*.jpeg;*.png";
	
	НастройкиПолей.Добавить(ФотоПосле);
	// БСП самостоятельно создает элементы управления
	РаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, НастройкиПолей);
	
КонецПроцедуры
// Передает подсистеме файлов БСП событие открытия формы.
