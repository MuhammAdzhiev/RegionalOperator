// Назначение модуля: Заполнение требования по задолженности лицевого счета и печать из актуальных данных формы.
// Запускает серверное заполнение данных требования по выбранному лицевому счету.
&НаКлиенте
Процедура ЗаполнитьПоЛицевомуСчету(Команда)
	ЗаполнитьПоЛицевомуСчетуНаСервере();
КонецПроцедуры
// Подставляет потребителя, недвижимость и задолженность на конец выбранного периода.
&НаСервере
Процедура ЗаполнитьПоЛицевомуСчетуНаСервере()
	
	Если НЕ ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		ВызватьИсключение "Выберите лицевой счет.";
	КонецЕсли;
	
	ЛС = Объект.ЛицевойСчет;
	
	Объект.Потребитель = ЛС.Потребитель;
	Объект.ОбъектНедвижимости = ЛС.ОбъектНедвижимости;
	
	Объект.СуммаДолга = РОТКО_Биллинг.ПолучитьЗадолженностьПоЛС(ЛС, Объект.ДатаОкончания);
	
КонецПроцедуры
// Показывает сформированную сервером печатную форму требования.
// Возвращаемое значение:
//   ТабличныйДокумент — печатная форма требования.
&НаКлиенте
Процедура Печать(Команда)
	
	ТабДок = ПечатьНаСервере();
	ТабДок.Показать();
	
КонецПроцедуры
// Формирует печатную форму из текущих данных формы, включая еще не записанные изменения.
&НаСервере
Функция ПечатьНаСервере()
	// Получаем объект документа из актуальных данных формы, включая несохраненные изменения.
	ОбъектДок = РеквизитФормыВЗначение("Объект");
	// Формируем печатную форму без записи документа в БД.
	Возврат ОбъектДок.Печать();
	
КонецФункции
