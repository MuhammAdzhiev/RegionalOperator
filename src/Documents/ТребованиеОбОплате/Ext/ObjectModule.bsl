// Назначение модуля: Формирование печатной формы требования об оплате по реквизитам документа.
// Формирует табличный документ требования на основании текущих реквизитов объекта.
// Возвращаемое значение:
//   ТабличныйДокумент — печатная форма требования.
 Функция Печать() Экспорт

	Макет = ПолучитьМакет("ПФ_ТребованиеОбОплате");
	ТабДок = Новый ТабличныйДокумент;
    	ТабДок.ОтображатьСетку = Ложь;
    
	Область = Макет.ПолучитьОбласть("Область");  

	Область.Параметры.ЛС = ЛицевойСчет;
	Область.Параметры.Потребитель = Потребитель;
	Область.Параметры.Адрес = ОбъектНедвижимости;
	Область.Параметры.ПериодС = Формат(ДатаНачала, "ДФ='dd ММММ yyyy'");
	Область.Параметры.ПериодПо = Формат(ДатаОкончания, "ДФ='dd ММММ yyyy'");
	Область.Параметры.Сумма = СуммаДолга; 
	Область.Параметры.Дата = Формат(Дата, "ДФ='dd ММММ yyyy'");
        	
	ТабДок.Вывести(Область);

	Возврат ТабДок;

КонецФункции