
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ШтрихКод = Неопределено;
	Если Параметры.Свойство("ШтрихКод", ШтрихКод) Тогда
		Заголовок = Заголовок + " " + Штрихкод;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыбратьТекущиеДанные();
	
КонецПроцедуры
	
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	ВыбратьТекущиеДанные();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыбратьТекущиеДанные();
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		СтруктураДанных = Новый Структура("Номенклатура,Характеристика,ЕдиницаИзмерения");
		ЗаполнитьЗначенияСвойств(СтруктураДанных, ТекущиеДанные);
		Закрыть(СтруктураДанных);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти