
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьДанныеФормы();
	
	НастроитьОтображениеФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриИзменении(Элемент)
	
	КоличествоВведено = Список.Итог("КоличествоУпаковок");
	УстановитьНадписьВведеноРНПТ(ЭтотОбъект);
	СтоимостьБезНДСВведено = Список.Итог("СтоимостьБезНДС");
	УстановитьНадписьУказанаСтоимость(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элемент.ТекущиеДанные;
		ЗаполнитьЗаголовкиСтрок(ТекущиеДанные);
		Если Не Копирование Тогда
			КоличествоСтрок = Список.Количество();
			ТекущиеДанные.ЕдиницаИзмеренияПрослеживаемости = ?(РазныеЕдиницыИзмерения И КоличествоСтрок > 1,
				Список[КоличествоСтрок - 2].ЕдиницаИзмеренияПрослеживаемости, ЕдиницаИзмерения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные.ЕдиницаИзмеренияПрослеживаемости = ЕдиницаИзмерения Тогда
		ТекущиеДанные.КоличествоПрослеживаемости = ТекущиеДанные.КоличествоУпаковок;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКоличествоПрослеживаемостиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные.ЕдиницаИзмеренияПрослеживаемости = ЕдиницаИзмерения Тогда
		ТекущиеДанные.КоличествоУпаковок = ТекущиеДанные.КоличествоПрослеживаемости;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	СведенияПрослеживаемостиТовара = Новый Массив;
	Для Каждого СтрокаСведений Из Список Цикл
		СведенияПартииТовара = КлиентЭДОКлиентСервер.НовыеСведенияПрослеживаемостиПартииТовара();
		ЗаполнитьЗначенияСвойств(СведенияПартииТовара, СтрокаСведений);
		СведенияПрослеживаемостиТовара.Добавить(СведенияПартииТовара);
	КонецЦикла;
	
	Закрыть(СведенияПрослеживаемостиТовара);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРазныеЕдиницыИзмерения(Команда)
	
	Если Не РазныеЕдиницыИзмерения Тогда
		УстановитьПризнакРазныхЕдиницИзмерения();
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("УстановитьРазныеЕдиницыИзмеренияПослеВопроса", ЭтотОбъект);
	ТекстВопроса = НСтр("ru = 'Количество прослеживаемости будет преведено к учетному. Продолжить?'");
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДанныеФормы()
	
	РежимКорректировки = Параметры.РежимКорректировки;
	
	Номенклатура = Параметры.Номенклатура;
	Характеристика = Параметры.Характеристика;
	ЕдиницаИзмерения = Параметры.ЕдиницаИзмерения;
	КоличествоУпаковок = Параметры.КоличествоУпаковок;
	СтоимостьБезНДС = Параметры.СтоимостьБезНДС;
	
	Для Каждого СведенияПартииТовара Из Параметры.СведенияПрослеживаемостиТовара Цикл
		ЗаполнитьЗначенияСвойств(Список.Добавить(), СведенияПартииТовара);
		Если ЕдиницаИзмерения <> СведенияПартииТовара.ЕдиницаИзмеренияПрослеживаемости Тогда
			РазныеЕдиницыИзмерения = Истина;
		КонецЕсли;
	КонецЦикла;
	
	КоличествоВведено = Список.Итог("КоличествоУпаковок");
	СтоимостьБезНДСВведено = Список.Итог("СтоимостьБезНДС");
	
КонецПроцедуры

&НаСервере
Процедура НастроитьОтображениеФормы()
	
	УстановитьЗаголовокФормы();
	
	УстановитьНадписьВведеноРНПТ(ЭтотОбъект);
	
	УстановитьНадписьУказанаСтоимость(ЭтотОбъект);
	
	УстановитьВидимостьПолейДоКорректировки();
	
	НастроитьОтображениеКоличестваПрослеживаемости(ЭтотОбъект);
	
	Элементы.СписокКоличество.Заголовок = СтрШаблон(НСтр("ru = 'Количество (%1)'"), ЕдиницаИзмерения);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	Если ЗначениеЗаполнено(Характеристика) Тогда
		Заголовок = СтрШаблон(НСтр("ru = 'РНПТ: %1 (%2)'"), Номенклатура, Характеристика);
	Иначе
		Заголовок = СтрШаблон(НСтр("ru = 'РНПТ: %1'"), Номенклатура);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьОтображениеКоличестваПрослеживаемости(Форма)
	
	Элементы = Форма.Элементы;
	
	Элементы.УстановитьРазныеЕдиницыИзмерения.Пометка = Форма.РазныеЕдиницыИзмерения;
	Элементы.СписокКоличествоПрослеживаемости.Видимость = Форма.РазныеЕдиницыИзмерения;
	Элементы.СписокЕдиницаИзмеренияПрослеживаемости.Видимость = Форма.РазныеЕдиницыИзмерения;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьНадписьВведеноРНПТ(Форма)
	
	Форма.НадписьВведеноРНПТ = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Введено %1 РНПТ из %2'"), Форма.КоличествоВведено, Форма.КоличествоУпаковок);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьНадписьУказанаСтоимость(Форма)
	
	Форма.НадписьУказанаСтоимость = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Указана стоимость товаров %1 из %2:'"), Форма.СтоимостьБезНДСВведено, Форма.СтоимостьБезНДС);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолейДоКорректировки();
	
	Элементы.СписокНадписьДоКорректировки.Видимость = РежимКорректировки;
	Элементы.СписокНадписьПослеКорректировки.Видимость = РежимКорректировки;
	Элементы.СписокКоличествоДоКорректировки.Видимость = РежимКорректировки;
	Элементы.СписокКоличествоПрослеживаемостиДоКорректировки.Видимость = РежимКорректировки И РазныеЕдиницыИзмерения;
	Элементы.СписокСтоимостьБезНДСДоКорректировки.Видимость = РежимКорректировки;
	
	Если РежимКорректировки Тогда
		Для Каждого СтрокаТаблицы Из Список Цикл
			ЗаполнитьЗаголовкиСтрок(СтрокаТаблицы);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьЗаголовкиСтрок(СтрокаТаблицы)
	
	СтрокаТаблицы.НадписьДоКорректировки    = НСтр("ru = 'До корректировки:'");
	СтрокаТаблицы.НадписьПослеКорректировки = НСтр("ru = 'После корректировки:'");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРазныеЕдиницыИзмеренияПослеВопроса(Ответ, Контекст) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		УстановитьПризнакРазныхЕдиницИзмерения();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПризнакРазныхЕдиницИзмерения()
	
	РазныеЕдиницыИзмерения = Не РазныеЕдиницыИзмерения;
	
	Если Не РазныеЕдиницыИзмерения Тогда
		Для Каждого СведенияПартииТовара Из Список Цикл
			СведенияПартииТовара.ЕдиницаИзмеренияПрослеживаемости = ЕдиницаИзмерения;
			СведенияПартииТовара.КоличествоПрослеживаемости = СведенияПартииТовара.КоличествоУпаковок;
			СведенияПартииТовара.КоличествоПрослеживаемостиДоКорректировки =
				СведенияПартииТовара.КоличествоУпаковокДоКорректировки;
		КонецЦикла;
	КонецЕсли;
	
	НастроитьОтображениеКоличестваПрослеживаемости(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти