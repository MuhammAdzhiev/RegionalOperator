

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Проверить(Команда)
	
	ПроверитьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПроверитьНаСервере()
	
	РезультатыПроверки.Очистить();
	
	Организация = ОрганизацияДляПроверки();
	
	// Проверка метода ТребуетсяПодключениеЭДО
	НоваяСтрока = РезультатыПроверки.Добавить();
	НоваяСтрока.Метод = НСтр("ru = 'ТребуетсяПодключениеЭДО'");
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		НоваяСтрока.Метод = НСтр("ru = 'Организацию не удалось определить. Метод нельзя проверить.'");
	Иначе
		ТекстСообщения = НСтр("ru = 'Метод работает корректно.'");
		Попытка
			ТребуетсяПодключение = Неопределено;
			ОбменСКонтрагентами.ТребуетсяПодключениеЭДО(Организация, ТребуетсяПодключение);
		Исключение
			ОбщегоНазначенияБЭД.ЗаписатьВЖурналРегистрации(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
				ОбщегоНазначенияБЭДКлиентСервер.ПодсистемыБЭД().ОбменСКонтрагентами);
			ТекстСообщения = НСтр("ru = 'В работе метода возникли ошибки.'");
		КонецПопытки;
		НоваяСтрока.Результат = ТекстСообщения;
	КонецЕсли;
	
	ДанныеУчетнойЗаписи = ДанныеУчетнойЗаписи();
	
	// Проверка метода ТребуетсяПереизданиеСертификатаЭДО
	НоваяСтрока = РезультатыПроверки.Добавить();
	НоваяСтрока.Метод = НСтр("ru = 'ТребуетсяПереизданиеСертификатаЭДО'");
	
	Если Не ЗначениеЗаполнено(ДанныеУчетнойЗаписи) Тогда
		НоваяСтрока.Метод = НСтр("ru = 'Учетную запись не удалось определить. Метод нельзя проверить.'");
	Иначе
		ТекстСообщения = НСтр("ru = 'Метод работает корректно.'");
		Попытка
			ТребуетсяПереиздание = Неопределено;
			ОбменСКонтрагентами.ТребуетсяПереизданиеСертификатаЭДО(ДанныеУчетнойЗаписи.Организация,
				ДанныеУчетнойЗаписи.СертификатКриптографии, ТребуетсяПереиздание);
		Исключение
			ОбщегоНазначенияБЭД.ЗаписатьВЖурналРегистрации(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
				ОбщегоНазначенияБЭДКлиентСервер.ПодсистемыБЭД().ОбменСКонтрагентами);
			ТекстСообщения = НСтр("ru = 'В работе метода возникли ошибки.'");
		КонецПопытки;
		
		НоваяСтрока.Результат = ТекстСообщения;
		
	КонецЕсли;
	
	// Проверка метода ИнициализироватьНастройкиПодключенияЭДО
	НоваяСтрока = РезультатыПроверки.Добавить();
	НоваяСтрока.Метод = НСтр("ru = 'ИнициализироватьНастройкиПодключенияЭДО'");
	
	Если Не ЗначениеЗаполнено(ДанныеУчетнойЗаписи) Тогда
		НоваяСтрока.Метод = НСтр("ru = 'Учетную запись не удалось определить. Метод нельзя проверить.'");
	Иначе
		ТекстСообщения = НСтр("ru = 'Метод работает корректно.'");
		Попытка
			НастройкиПодключения = Неопределено;
			ОбменСКонтрагентами.ИнициализироватьНастройкиПодключенияЭДО(ДанныеУчетнойЗаписи.Организация,
				ДанныеУчетнойЗаписи.КодНалоговогоОргана, НастройкиПодключения);
		Исключение
			ОбщегоНазначенияБЭД.ЗаписатьВЖурналРегистрации(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
				ОбщегоНазначенияБЭДКлиентСервер.ПодсистемыБЭД().ОбменСКонтрагентами);
			ТекстСообщения = НСтр("ru = 'В работе метода возникли ошибки.'");
		КонецПопытки;
		
		НоваяСтрока.Результат = ТекстСообщения;
		
	КонецЕсли;
	
	// Проверка метода ИнициализироватьНастройкиПереизданияСертификатаЭДО
	НоваяСтрока = РезультатыПроверки.Добавить();
	НоваяСтрока.Метод = НСтр("ru = 'ИнициализироватьНастройкиПереизданияСертификатаЭДО'");
	
	Если Не ЗначениеЗаполнено(ДанныеУчетнойЗаписи) Тогда
		НоваяСтрока.Метод = НСтр("ru = 'Учетную запись не удалось определить. Метод нельзя проверить.'");
	Иначе
		ТекстСообщения = НСтр("ru = 'Метод работает корректно.'");
		Попытка
			НастройкиПереиздания = Неопределено;
			ОбменСКонтрагентами.ИнициализироватьНастройкиПереизданияСертификатаЭДО(ДанныеУчетнойЗаписи.Организация,
				ДанныеУчетнойЗаписи.КодНалоговогоОргана, ДанныеУчетнойЗаписи.СертификатКриптографии,
				НастройкиПереиздания);
		Исключение
			ОбщегоНазначенияБЭД.ЗаписатьВЖурналРегистрации(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
				ОбщегоНазначенияБЭДКлиентСервер.ПодсистемыБЭД().ОбменСКонтрагентами);
			ТекстСообщения = НСтр("ru = 'В работе метода возникли ошибки.'");
		КонецПопытки;
		
		НоваяСтрока.Результат = ТекстСообщения;
		
	КонецЕсли;
	
	// Проверка метода ПроверитьНастройкиРегистрацииЭДО
	НоваяСтрока = РезультатыПроверки.Добавить();
	НоваяСтрока.Метод = НСтр("ru = 'ПроверитьНастройкиРегистрацииЭДО'");
	
	Если Не ЗначениеЗаполнено(НастройкиПодключения) Тогда
		НоваяСтрока.Метод = НСтр("ru = 'Настройки подключения не удалось определить. Метод нельзя проверить.'");
	Иначе
		ТекстСообщения = НСтр("ru = 'Метод работает корректно.'");
		Попытка
			НастройкиКорректны = Неопределено;
			ОбменСКонтрагентами.ПроверитьНастройкиРегистрацииЭДО(НастройкиПодключения, НастройкиКорректны);
		Исключение
			ОбщегоНазначенияБЭД.ЗаписатьВЖурналРегистрации(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
				ОбщегоНазначенияБЭДКлиентСервер.ПодсистемыБЭД().ОбменСКонтрагентами);
			ТекстСообщения = НСтр("ru = 'В работе метода возникли ошибки.'");
		КонецПопытки;
		
		НоваяСтрока.Результат = ТекстСообщения;
		
	КонецЕсли;
	
	// Проверка метода АдресСтраницыСУсловиямиПодключения
	НоваяСтрока = РезультатыПроверки.Добавить();
	НоваяСтрока.Метод = НСтр("ru = 'АдресСтраницыСУсловиямиПодключения'");
	
	ТекстСообщения = НСтр("ru = 'Метод работает корректно.'");
	Попытка
		Адрес = Неопределено;
		ОбменСКонтрагентами.АдресСтраницыСУсловиямиПодключения(Адрес);
	Исключение
		ОбщегоНазначенияБЭД.ЗаписатьВЖурналРегистрации(
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			ОбщегоНазначенияБЭДКлиентСервер.ПодсистемыБЭД().ОбменСКонтрагентами);
		ТекстСообщения = НСтр("ru = 'В работе метода возникли ошибки.'");
	КонецПопытки;
	
	НоваяСтрока.Результат = ТекстСообщения;
	
	// Проверка метода ВыгрузкаДокументовДляПередачиВФНС
	НоваяСтрока = РезультатыПроверки.Добавить();
	НоваяСтрока.Метод = НСтр("ru = 'ВыгрузкаДокументовДляПередачиВФНС'");
	
	УчетныеДокументы = УчетныеДокументыДляПередачиВФНС();
	
	Если Не ЗначениеЗаполнено(УчетныеДокументы) Тогда
		ТекстСообщения = НСтр("ru = 'Учетные документы не удалось определить. Метод нельзя проверить.'");
	Иначе
		
		ТекстСообщения = НСтр("ru = 'Метод работает корректно.'");
		Попытка
				
			УникальныйИдентификаторФормы = Новый УникальныйИдентификатор;
			СоответствиеДокументамИБКомплектыЭД = ОбменСКонтрагентами.ВыгрузкаДокументовДляПередачиВФНС(
				УчетныеДокументы, УникальныйИдентификаторФормы);
			
			Если Не ЗначениеЗаполнено(СоответствиеДокументамИБКомплектыЭД) Тогда
				ТекстСообщения = НСтр("ru = 'В работе метода возникли ошибки.'");
			КонецЕсли;
		Исключение
			ОбщегоНазначенияБЭД.ЗаписатьВЖурналРегистрации(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
				ОбщегоНазначенияБЭДКлиентСервер.ПодсистемыБЭД().ОбменСКонтрагентами);
			ТекстСообщения = НСтр("ru = 'В работе метода возникли ошибки.'");
		КонецПопытки;
		
	КонецЕсли;
	НоваяСтрока.Результат = ТекстСообщения;
	
	// Проверка метода ВыгрузкаНеформализованныхДокументовPDFДляПередачиВФНС
	НоваяСтрока = РезультатыПроверки.Добавить();
	НоваяСтрока.Метод = НСтр("ru = 'ВыгрузкаНеформализованныхДокументовPDFДляПередачиВФНС'");
	
	УчетныйДокумент = ОбъектУчетаНеформализованногоДокументаPDFДляПередачиВФНС();
	
	Если Не ЗначениеЗаполнено(УчетныйДокумент) Тогда
		ТекстСообщения = НСтр("ru = 'Учетный документ не удалось определить. Метод нельзя проверить.'");
	Иначе
		
		ТекстСообщения = НСтр("ru = 'Метод работает корректно.'");
		Попытка
			ДанныеФайловПоОбъектамУчета = Новый Соответствие;
			ДанныеФайловПоОбъектамУчета.Вставить(УчетныйДокумент, Новый Массив);
				
			УникальныйИдентификаторФормы = Новый УникальныйИдентификатор;
			ОбменСКонтрагентами.ВыгрузкаНеформализованныхДокументовPDFДляПередачиВФНС(ДанныеФайловПоОбъектамУчета,
				УникальныйИдентификаторФормы);
				
			ДанныеФайловПоОбъектуУчета = ДанныеФайловПоОбъектамУчета[УчетныйДокумент];
			ЕстьЗаполненныеДанные = ДанныеФайловПоОбъектуУчета.Количество();
			
			Если Не ЕстьЗаполненныеДанные Тогда
				ТекстСообщения = НСтр("ru = 'В работе метода возникли ошибки. 
					|Возможно в базе не найдены неформализованные документы в формате PDF'");
			КонецЕсли;
		Исключение
			ОбщегоНазначенияБЭД.ЗаписатьВЖурналРегистрации(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
				ОбщегоНазначенияБЭДКлиентСервер.ПодсистемыБЭД().ОбменСКонтрагентами);
			ТекстСообщения = НСтр("ru = 'В работе метода возникли ошибки.'");
		КонецПопытки;
		
	КонецЕсли;
	НоваяСтрока.Результат = ТекстСообщения;
	
	// Проверка метода СведенияОбЭлектронномДокументе
	НоваяСтрока = РезультатыПроверки.Добавить();
	НоваяСтрока.Метод = НСтр("ru = 'СведенияОбЭлектронномДокументе'");
	
	ЭлектронныйДокументИОбъектыУчета = СоответствиеЭлектронныхДокументовИОбъектовУчета();
	
	Если Не ЗначениеЗаполнено(ЭлектронныйДокументИОбъектыУчета) Тогда
		ТекстСообщения = НСтр("ru = 'Электронный документ не удалось определить. Метод нельзя проверить.'");
	Иначе
		
		ТекстСообщения = НСтр("ru = 'Метод работает корректно.'");
		Попытка
			СведенияОбЭлектронномДокументе = ОбменСКонтрагентами.СведенияОбЭлектронномДокументе(
				ЭлектронныйДокументИОбъектыУчета.ЭлектронныйДокумент);
			
			КоличествоОбъектовУчетаОригинал = СведенияОбЭлектронномДокументе.ОбъектыУчета.Количество();
			КоличествоОбъектовУчетаДляПроверки = ЭлектронныйДокументИОбъектыУчета.ОбъектыУчета.Количество();
			Если КоличествоОбъектовУчетаОригинал <> КоличествоОбъектовУчетаДляПроверки
				Или ОбщегоНазначенияКлиентСервер.РазностьМассивов(СведенияОбЭлектронномДокументе.ОбъектыУчета,
					ЭлектронныйДокументИОбъектыУчета.ОбъектыУчета).Количество() <> 0 Тогда
				ТекстСообщения = НСтр("ru = 'В работе метода возникли ошибки.'");
			КонецЕсли;
		Исключение
			ОбщегоНазначенияБЭД.ЗаписатьВЖурналРегистрации(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
				ОбщегоНазначенияБЭДКлиентСервер.ПодсистемыБЭД().ОбменСКонтрагентами);
			ТекстСообщения = НСтр("ru = 'В работе метода возникли ошибки.'");
		КонецПопытки;
		
	КонецЕсли;
	НоваяСтрока.Результат = ТекстСообщения;
	
	// Проверка метода СвойстваОбъектовУчетаЭлектронныхДокументовДляВыгрузкиВФНС
	НоваяСтрока = РезультатыПроверки.Добавить();
	НоваяСтрока.Метод = НСтр("ru = 'СвойстваОбъектовУчетаЭлектронныхДокументовДляВыгрузкиВФНС'");
	
	Если Не ЗначениеЗаполнено(ЭлектронныйДокументИОбъектыУчета) Тогда
		ТекстСообщения = НСтр("ru = 'Электронный документ не удалось определить. Метод нельзя проверить.'");
	Иначе
		ТекстСообщения = НСтр("ru = 'Метод работает корректно.'");
		Попытка
			СвойстваОбъектовУчета = ОбменСКонтрагентами.СвойстваОбъектовУчетаЭлектронныхДокументовДляВыгрузкиВФНС(
				ЭлектронныйДокументИОбъектыУчета.ОбъектыУчета);
			
			Если Не ЗначениеЗаполнено(СвойстваОбъектовУчета) Тогда
				ТекстСообщения = НСтр("ru = 'В работе метода возникли ошибки.'");
			КонецЕсли;
		Исключение
			ОбщегоНазначенияБЭД.ЗаписатьВЖурналРегистрации(
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
				ОбщегоНазначенияБЭДКлиентСервер.ПодсистемыБЭД().ОбменСКонтрагентами);
			ТекстСообщения = НСтр("ru = 'В работе метода возникли ошибки.'");
		КонецПопытки;
	КонецЕсли;
	
	НоваяСтрока.Результат = ТекстСообщения;
	
КонецПроцедуры

&НаСервере
Функция УчетныеДокументыДляПередачиВФНС()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	РеализацияТоваровУслуг.Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.АктВыполненныхРабот)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	РеализацияТоваровУслуг.Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.ТоварнаяНакладная)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	СчетФактураВыданный.Ссылка
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|ГДЕ
		|	СчетФактураВыданный.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.СчетФактура)
		|	И СчетФактураВыданный.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.Реализация)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	СчетФактураВыданный.Ссылка
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|ГДЕ
		|	СчетФактураВыданный.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.СчетФактура)
		|	И СчетФактураВыданный.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОпераций.Корректировка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	УчетныеДокументы = Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		УчетныеДокументы.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
		
	КонецЦикла;
	
	Возврат УчетныеДокументы;
	
КонецФункции

&НаСервере
Функция ОбъектУчетаНеформализованногоДокументаPDFДляПередачиВФНС()
	
	ОбъектУчета = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВидыДокументовЭДО.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ВидыДокументов
		|ИЗ
		|	Справочник.ВидыДокументовЭДО КАК ВидыДокументовЭДО
		|ГДЕ
		|	ВидыДокументовЭДО.ТипДокумента В (&ТипыДокументовДляВыгрузкиВФНС)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СообщениеЭДОПрисоединенныеФайлы.ВладелецФайла.ЭлектронныйДокумент КАК ВладелецФайлаЭлектронныйДокумент
		|ПОМЕСТИТЬ ВТ_ЭлектронныеДокументы
		|ИЗ
		|	Справочник.СообщениеЭДОПрисоединенныеФайлы КАК СообщениеЭДОПрисоединенныеФайлы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВидыДокументов КАК ВидыДокументов
		|		ПО СообщениеЭДОПрисоединенныеФайлы.ВладелецФайла.ВидСообщения = ВидыДокументов.Ссылка
		|		И СообщениеЭДОПрисоединенныеФайлы.Расширение = ""pdf""
		|		И ВЫРАЗИТЬ(СообщениеЭДОПрисоединенныеФайлы.ВладелецФайла.ЭлектронныйДокумент КАК
		|			Документ.ЭлектронныйДокументИсходящийЭДО).ТипРегламента = ЗНАЧЕНИЕ(Перечисление.ТипыРегламентовЭДО.Неформализованный)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОбъектыУчетаДокументовЭДО.ОбъектУчета КАК ОбъектУчета
		|ИЗ
		|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК ОбъектыУчетаДокументовЭДО
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ЭлектронныеДокументы КАК ВТ_ЭлектронныеДокументы
		|		ПО (ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент = ВТ_ЭлектронныеДокументы.ВладелецФайлаЭлектронныйДокумент)
		|		И (ОбъектыУчетаДокументовЭДО.Актуальный)";
	
	ТипыДокументовЭДО = ЭлектронныеДокументыЭДО.ТипыДокументовЭДОВыгрузкиДляФНС();
	Запрос.УстановитьПараметр("ТипыДокументовДляВыгрузкиВФНС", ТипыДокументовЭДО);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ОбъектУчета = Выборка.ОбъектУчета;
	КонецЕсли;
	
	Возврат ОбъектУчета;
	
КонецФункции

&НаСервере
Функция ОрганизацияДляПроверки()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Организация
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления
	|	И НЕ Организации.Предопределенный";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Организация;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ДанныеУчетнойЗаписи()
	
	Запросы = Новый Массив;
	ЗапросУчетныхЗаписей = СинхронизацияЭДО.ЗапросУчетныхЗаписей("УчетныеЗаписи");
	Запросы.Добавить(ЗапросУчетныхЗаписей);
	ЗапросСертификатовУчетныхЗаписей = СинхронизацияЭДО.ЗапросСертификатовУчетныхЗаписей("СертификатыУчетныхЗаписей");
	Запросы.Добавить(ЗапросСертификатовУчетныхЗаписей);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УчетныеЗаписи.ИдентификаторЭДО КАК ИдентификаторЭДО,
		|	УчетныеЗаписи.Организация КАК Организация,
		|	УчетныеЗаписи.КодНалоговогоОргана КАК КодНалоговогоОргана,
		|	СертификатыУчетныхЗаписей.Сертификат КАК Сертификат
		|ИЗ
		|	УчетныеЗаписи КАК УчетныеЗаписи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СертификатыУчетныхЗаписей КАК СертификатыУчетныхЗаписей
		|		ПО УчетныеЗаписи.ИдентификаторЭДО = СертификатыУчетныхЗаписей.ИдентификаторЭДО";
	
	ИтоговыйЗапрос = ОбщегоНазначенияБЭД.СоединитьЗапросы(Запрос, Запросы);
	
	РезультатЗапроса = ИтоговыйЗапрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Сертификаты = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Выборка.Сертификат);
		СвойстваСертификатов = КриптографияБЭД.СвойстваСертификатов(Сертификаты);
		ДанныеСертификата = СвойстваСертификатов[Выборка.Сертификат].ДанныеСертификата;
		СертификатКриптографии = Новый СертификатКриптографии(ДанныеСертификата);
		АдресСертификата = ПоместитьВоВременноеХранилище(ДанныеСертификата, УникальныйИдентификатор);
		
		ДанныеУчетнойЗаписи = Новый Структура;
		ДанныеУчетнойЗаписи.Вставить("ИдентификаторЭДО");
		ДанныеУчетнойЗаписи.Вставить("Организация");
		ДанныеУчетнойЗаписи.Вставить("КодНалоговогоОргана");
		ДанныеУчетнойЗаписи.Вставить("Сертификат");
		ДанныеУчетнойЗаписи.Вставить("СертификатКриптографии");
		ЗаполнитьЗначенияСвойств(ДанныеУчетнойЗаписи, Выборка);
		ДанныеУчетнойЗаписи.СертификатКриптографии = СертификатКриптографии;
		Возврат ДанныеУчетнойЗаписи;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СоответствиеЭлектронныхДокументовИОбъектовУчета()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент КАК Ссылка
		|ПОМЕСТИТЬ ЭлектронныйДокумент
		|ИЗ
		|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК ОбъектыУчетаДокументовЭДО
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияДокументовЭДО КАК СостоянияДокументовЭДО
		|		ПО (ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент = СостоянияДокументовЭДО.ЭлектронныйДокумент
		|			И СостоянияДокументовЭДО.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументовЭДО.ОбменЗавершен))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент,
		|	ОбъектыУчетаДокументовЭДО.ОбъектУчета
		|ИЗ
		|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК ОбъектыУчетаДокументовЭДО
		|ГДЕ
		|	ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент В
		|	(ВЫБРАТЬ
		|		ЭлектронныйДокумент.Ссылка КАК Ссылка
		|	ИЗ
		|		ЭлектронныйДокумент КАК ЭлектронныйДокумент)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Результат = Новый Структура;
		Результат.Вставить("ОбъектыУчета", Новый Массив);
		Результат.Вставить("ЭлектронныйДокумент", Неопределено);
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Результат.ЭлектронныйДокумент = ВыборкаДетальныеЗаписи.ЭлектронныйДокумент;
			Результат.ОбъектыУчета.Добавить(ВыборкаДетальныеЗаписи.ОбъектУчета);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
