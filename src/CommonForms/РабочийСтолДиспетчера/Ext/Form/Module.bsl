// Назначение модуля: Клиентская логика рабочего стола: фильтрация сегодняшних рейсов и инцидентов. 
// При открытии обновляет списки рейсов и инцидентов по текущим отборам.
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьФильтр();
	ОбновитьФильтрИнцидентов();
	
КонецПроцедуры
// Передает текущие значения отбора в динамический список рейсов и обновляет его.
&НаКлиенте
Процедура ОбновитьФильтр()
	
	РейсыСегодня.Параметры.УстановитьЗначениеПараметра("Город", Город);
	РейсыСегодня.Параметры.УстановитьЗначениеПараметра("Зона", Зона);
	РейсыСегодня.Параметры.УстановитьЗначениеПараметра("Статус", Статус);
	РейсыСегодня.Параметры.УстановитьЗначениеПараметра("ТипИсполнителя", ТипИсполнителя);
	РейсыСегодня.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	
	Элементы.РейсыСегодня.Обновить();
	
КонецПроцедуры
// Обновляет список инцидентов по текущей дате.
&НаКлиенте
Процедура ОбновитьФильтрИнцидентов() 
	
	ИнцидентыСегодня.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	
	Элементы.ИнцидентыСегодня.Обновить();
	
КонецПроцедуры
// Перестраивает список рейсов после изменения города.
&НаКлиенте
Процедура ГородПриИзменении(Элемент) 	
	ОбновитьФильтр();
КонецПроцедуры
// Перестраивает список рейсов после изменения зоны обслуживания.
&НаКлиенте
Процедура ЗонаПриИзменении(Элемент)
	ОбновитьФильтр();
КонецПроцедуры
// Перестраивает список рейсов после изменения фильтра по статусу.
&НаКлиенте
Процедура СтатусПриИзменении(Элемент)
	ОбновитьФильтр();
КонецПроцедуры
// Перестраивает список рейсов после изменения типа исполнителя.
&НаКлиенте
Процедура ТипИсполнителяПриИзменении(Элемент)
	ОбновитьФильтр();
КонецПроцедуры
