
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Параметры.Свойство("Номенклатура", Номенклатура);
	Параметры.Свойство("Количество",   Количество);
	
	ЭтоАктОРасхождениях = Параметры.Свойство("ЭтоАктОРасхождениях");
	Если ЭтоАктОРасхождениях Тогда
		Элементы.ГруппаВидыУчетныхДокументов.ТекущаяСтраница = Элементы.АктОРасхождениях;
		
		ИменаТаблицМаркировки = КлиентЭДОКлиентСервер.ИменаТаблицМаркировкиАктаОРасхождениях();
		Для Каждого ИмяТаблицы Из ИменаТаблицМаркировки Цикл
			ЭтаФорма[ИмяТаблицы].ЗагрузитьЗначения(Параметры[ИмяТаблицы]);
		КонецЦикла;
	Иначе
		Элементы.ГруппаВидыУчетныхДокументов.ТекущаяСтраница = Элементы.Прочие;
		Если Параметры.Свойство("КодыУпаковокМаркируемойПродукции") Тогда
			ЗагрузитьНомераУпаковокВТаблицу(Параметры.КодыУпаковокМаркируемойПродукции,
				КодыУпаковокМаркируемойПродукции);
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.ТолькоПросмотр = Истина Тогда		
		Элементы.ФормаОК.Видимость     = Ложь;
		Элементы.ФормаОтмена.Заголовок = НСтр("ru = 'Закрыть'");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	Успешно = Истина;
	
	РезультатВыбора = Новый Структура;
	Если ЭтоАктОРасхождениях Тогда
		РезультатВыбора.Вставить("ЭтоАктОРасхождениях");
		
		ИменаТаблицМаркировки = КлиентЭДОКлиентСервер.ИменаТаблицМаркировкиАктаОРасхождениях();
		Для Каждого ИмяТаблицы Из ИменаТаблицМаркировки Цикл
			Если ПроверкаЗаполненияВыполнена(ИмяТаблицы) Тогда
				РезультатВыбора.Вставить(ИмяТаблицы, ЭтаФорма[ИмяТаблицы].ВыгрузитьЗначения());
			Иначе
				Успешно = Ложь;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ИмяТаблицы = "КодыУпаковокМаркируемойПродукции";
		Если ПроверкаЗаполненияВыполнена(ИмяТаблицы) Тогда
			РезультатВыбора.Вставить(ИмяТаблицы,
				НомераУпаковокИзТаблицы(КодыУпаковокМаркируемойПродукции));
		Иначе
			Успешно = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Успешно Тогда
		Закрыть(РезультатВыбора);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьНомераУпаковокВТаблицу(СписокУпаковок, Таблица)
	
	Для Каждого КодУпаковки Из СписокУпаковок Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.НомерУпаковки = КодУпаковки;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция НомераУпаковокИзТаблицы(Таблица)

	Результат = Новый Массив;
	Для каждого СтрокаТаблицы Из Таблица Цикл
		Результат.Добавить(СтрокаТаблицы.НомерУпаковки);
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПроверкаЗаполненияВыполнена(ИмяТаблицыКодовМаркировки)

	Результат = Истина;
	Если Не ЗначениеЗаполнено(ЭтаФорма[ИмяТаблицыКодовМаркировки]) Тогда
		Возврат Результат;
	КонецЕсли;

	// Проверяем формат потребительских упаковок.
	ИндексСтроки = 0;
	Для Каждого Строка Из ЭтаФорма[ИмяТаблицыКодовМаркировки] Цикл
		Если ЭтоАктОРасхождениях Тогда
			ИмяКолонкиКодаМаркировки = "Значение";
		Иначе
			ИмяКолонкиКодаМаркировки = "НомерУпаковки";
		КонецЕсли;
		Если Не КодМаркируемойУпаковкиСоответствуетТребованиям(Строка[ИмяКолонкиКодаМаркировки], ИндексСтроки) Тогда
			Результат = Ложь;
		КонецЕсли;
		
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
	// Если предыдущие проверки пройдены успешно, проверяем, что упаковки не задублированы.
	Если Результат Тогда
		Если ЭтоАктОРасхождениях Тогда
				ШаблонИмениПоля = "%1[%2].Значение";
				ОбщаяТаблицаУпаковок = Новый ТаблицаЗначений();
			ОбщаяТаблицаУпаковок.Колонки.Добавить("НомерУпаковки");
			Для Каждого СтрокаКодаМаркировки Из ЭтаФорма[ИмяТаблицыКодовМаркировки] Цикл
				НоваяСтрока = ОбщаяТаблицаУпаковок.Добавить();
				НоваяСтрока.НомерУпаковки = СтрокаКодаМаркировки.Значение;
			КонецЦикла;
		Иначе
				ШаблонИмениПоля = "%1[%2].НомерУпаковки";
				ОбщаяТаблицаУпаковок = ЭтаФорма[ИмяТаблицыКодовМаркировки].Выгрузить();
		КонецЕсли;
				
		ОбщаяТаблицаУпаковок.Колонки.Добавить("Количество");
		ОбщаяТаблицаУпаковок.ЗаполнитьЗначения(1, "Количество");
		ОбщаяТаблицаУпаковок.Свернуть("НомерУпаковки", "Количество");
		
		Для Каждого СтрокаТаблицыУпаковок Из ОбщаяТаблицаУпаковок Цикл
			Если СтрокаТаблицыУпаковок.Количество > 1 Тогда
				ТекстОшибки = НСтр("ru = 'Упаковка %1 введена несколько раз'");
				ТекстОшибки = СтрШаблон(ТекстОшибки, СтрокаТаблицыУпаковок.НомерУпаковки);
				
				Если ЭтоАктОРасхождениях Тогда
					ИдентификаторСтроки = ЭтаФорма[ИмяТаблицыКодовМаркировки].НайтиПоЗначению(СтрокаТаблицыУпаковок.НомерУпаковки).ПолучитьИдентификатор();	
					ИмяПоля = СтрШаблон(ШаблонИмениПоля, ИмяТаблицыКодовМаркировки, ИдентификаторСтроки);
				Иначе
					ПараметрыПоискаСтрок = Новый Структура("НомерУпаковки", СтрокаТаблицыУпаковок.НомерУпаковки);
					СтрокиУпаковки = ЭтаФорма[ИмяТаблицыКодовМаркировки].НайтиСтроки(ПараметрыПоискаСтрок);
					ИмяПоля = СтрШаблон(ШаблонИмениПоля, ИмяТаблицыКодовМаркировки, СтрокиУпаковки[0].ПолучитьИдентификатор());
				КонецЕсли;
				
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,, ИмяПоля);
				Результат = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаСервере
Функция КодМаркируемойУпаковкиСоответствуетТребованиям(Знач КодУпаковки, ИндексСтрокиДляВывода = Неопределено)

	Отказ = Ложь;
	КодУпаковки = СокрЛП(КодУпаковки);
	ИмяПоля = "КодыУпаковокМаркируемойПродукции" + СтрШаблон("[%1].НомерУпаковки", ИндексСтрокиДляВывода);
	
	Если Не ЗначениеЗаполнено(КодУпаковки) Тогда
		Отказ = Истина;
		ТекстОшибки = НСтр("ru = 'В строке %1 не заполнен код упаковки'");
	КонецЕсли;
	
	Если Отказ Тогда
		ТекстОшибки = СтрШаблон(ТекстОшибки, ИндексСтрокиДляВывода + 1);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,, ИмяПоля,, Отказ); 	
	КонецЕсли;
	
	Возврат Не Отказ;

КонецФункции

#КонецОбласти
